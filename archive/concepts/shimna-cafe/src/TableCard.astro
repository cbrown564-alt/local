---
interface Props {
  phone: string;
  phoneHref: string;
}

const { phone, phoneHref } = Astro.props;
---

<svg
  class="sh-plate"
  viewBox="0 0 420 520"
  role="img"
  aria-label="A folded table card on a check cloth, with Walk in and the café number"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <pattern id="sh-check" width="22" height="22" patternUnits="userSpaceOnUse">
      <rect width="22" height="22" fill="#efe6d4"/>
      <rect width="11" height="11" fill="#e4c9a4"/>
      <rect x="11" y="11" width="11" height="11" fill="#e4c9a4"/>
    </pattern>
    <linearGradient id="sh-card-front" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fbf7ee"/>
      <stop offset="1" stop-color="#efe4d2"/>
    </linearGradient>
    <linearGradient id="sh-card-back" x1="1" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#d7c4a8"/>
      <stop offset="1" stop-color="#c4ad8d"/>
    </linearGradient>
  </defs>

  <rect width="420" height="520" fill="#d8e4e8"/>
  <rect x="0" y="300" width="420" height="220" fill="url(#sh-check)"/>
  <ellipse cx="210" cy="430" rx="150" ry="28" fill="#c9b48f" opacity=".45"/>

  <polygon points="210,78 348,168 348,390 210,318" fill="url(#sh-card-back)"/>
  <polygon points="210,78 72,168 72,390 210,318" fill="url(#sh-card-front)" stroke="#8a3b1c" stroke-width="1.2"/>

  <text x="141" y="200" text-anchor="middle" fill="#243840" font-size="15" font-family="Fraunces, Georgia, serif">Shimna</text>
  <text x="141" y="222" text-anchor="middle" fill="#243840" font-size="15" font-family="Fraunces, Georgia, serif">Café</text>
  <line x1="108" y1="236" x2="174" y2="236" stroke="#b4532a" stroke-width="1"/>
  <text x="141" y="262" text-anchor="middle" fill="#3d5c66" font-size="11" font-family="Figtree, sans-serif" letter-spacing="1.4">WALK IN</text>
  <text x="141" y="286" text-anchor="middle" fill="#1c2428" font-size="11" font-family="Figtree, sans-serif">{phone}</text>
</svg>
<p class="sh-card-links">
  <a class="sh-walk sh-walk--solid" href="#find">Walk in</a>
  <a class="sh-ring" href={phoneHref}>{phone}</a>
</p>
