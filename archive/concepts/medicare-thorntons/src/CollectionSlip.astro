---
/* Drawn collection slip for 49 Central Promenade.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
interface Props {
  headingId?: string;
}
const { headingId = "mt-slip-title" } = Astro.props;
---

<figure class="mt-slip" aria-labelledby={headingId}>
  <svg
    class="mt-slip-svg"
    viewBox="0 0 380 500"
    role="img"
    aria-label="Drawn pharmacy collection slip for MediCare Thorntons at 49 Central Promenade, Newcastle"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern id="mt-grain" width="6" height="6" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="0.6" fill="#c5d0cc" opacity="0.5"/>
      </pattern>
      <filter id="mt-soft" x="-8%" y="-8%" width="116%" height="116%">
        <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#2f4a52" flood-opacity="0.16"/>
      </filter>
    </defs>

    <rect width="380" height="500" fill="#e8eeeb"/>
    <rect width="380" height="500" fill="url(#mt-grain)"/>

    <g filter="url(#mt-soft)">
      <rect x="36" y="40" width="308" height="420" rx="6" fill="#f7faf8" stroke="#2f4a52" stroke-width="1.5"/>
    </g>

    <!-- Cross mark -->
    <g transform="translate(190 88)">
      <circle r="28" fill="none" stroke="#2f6a62" stroke-width="1.6"/>
      <path d="M0 -14v28M-14 0h28" stroke="#2f6a62" stroke-width="3" stroke-linecap="round"/>
    </g>

    <text x="190" y="150" text-anchor="middle" fill="#2f4a52" font-family="Literata, Georgia, serif" font-size="22" font-weight="600">Thorntons</text>
    <text x="190" y="172" text-anchor="middle" fill="#5a726c" font-family="Public Sans, Segoe UI, sans-serif" font-size="10" font-weight="700" letter-spacing="2.2">COLLECTION SLIP · 49</text>

    <line x1="64" y1="196" x2="316" y2="196" stroke="#c5d0cc" stroke-width="1"/>

    <text x="64" y="228" fill="#5a726c" font-family="Public Sans, Segoe UI, sans-serif" font-size="11" font-weight="700" letter-spacing="1.5">BRANCH</text>
    <text x="64" y="252" fill="#2f4a52" font-family="Literata, Georgia, serif" font-size="16">MediCare Thorntons</text>
    <text x="64" y="274" fill="#2f4a52" font-family="Public Sans, Segoe UI, sans-serif" font-size="13">49 Central Promenade</text>
    <text x="64" y="294" fill="#2f4a52" font-family="Public Sans, Segoe UI, sans-serif" font-size="13">Newcastle BT33 0HH</text>

    <text x="64" y="334" fill="#5a726c" font-family="Public Sans, Segoe UI, sans-serif" font-size="11" font-weight="700" letter-spacing="1.5">TELEPHONE</text>
    <text x="64" y="360" fill="#2f6a62" font-family="Public Sans, Segoe UI, sans-serif" font-size="20" font-weight="700">028 4372 3248</text>

    <text x="64" y="400" fill="#5a726c" font-family="Public Sans, Segoe UI, sans-serif" font-size="11" font-weight="700" letter-spacing="1.5">NOTE</text>
    <text x="64" y="424" fill="#2f4a52" font-family="Literata, Georgia, serif" font-size="14" font-style="italic">Ring to join collection</text>
    <text x="64" y="444" fill="#2f4a52" font-family="Literata, Georgia, serif" font-size="14" font-style="italic">&amp; delivery.</text>
  </svg>
</figure>
