---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

/* Shimna Taxis — ride: ring to book from 18 Railway Street.
   Site brand: Shimna Travel Taxis. Distinct from Shimna Café (2 Main Street).
   First-party contact 14 Sep 2026: both phones, email, 24/365, services.
   No form. Handoff shimnatravel.co.uk. */
const phoneA = "028 437 24100";
const phoneAHref = "tel:+442843724100";
const phoneB = "028 4372 3030";
const phoneBHref = "tel:+442843723030";
const email = "info@shimnatravel.co.uk";
const mailto = `mailto:${email}`;
const site = "https://shimnatravel.co.uk/";
const maps =
  "https://www.google.com/maps/search/?api=1&query=18+Railway+Street+Newcastle+BT33+0AL";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500&family=Source+Serif+4:ital,opsz,wght@0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,500;1,8..60,600&display=swap";

const board = [
  {
    code: "APT",
    title: "Airport transfers",
    desc: "To and from the terminals — short notice or planned.",
  },
  {
    code: "DAY",
    title: "Day & coastal trips",
    desc: "Coastal runs, shopping days, theatre nights, and longer tours.",
  },
  {
    code: "VIP",
    title: "Executive & VIP",
    desc: "Gold service for corporate, VIP, and special occasions.",
  },
  {
    code: "GLF",
    title: "Golf trips & tours",
    desc: "Course to course, hotel to tee — clubs in the boot.",
  },
  {
    code: "DRV",
    title: "Female driver on request",
    desc: "Ask when you ring. We will match you where we can.",
  },
  {
    code: "PAY",
    title: "Pay by card",
    desc: "Credit cards welcome as well as cash.",
  },
];
---

<ConceptLayout
  title={"Shimna Taxis — local taxis on Railway Street, Newcastle"}
  slug="shimna-taxis"
  bodyClass="concept-page concept-shimna-taxis"
  lang="en-GB"
  businessName="Shimna Taxis"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="AI-generated illustrations imagine the setting, spaces and fleet; they are not photographs of the business."
>
  <div class="st-strip">
    <span>18 Railway Street, Newcastle · BT33 0AL · 24 hrs / 365</span>
    <span class="st-strip-r">
      <a href={phoneAHref}>{phoneA}</a>
      <span class="st-strip-sep" aria-hidden="true">·</span>
      <a href={phoneBHref}>{phoneB}</a>
    </span>
  </div>

  <header class="st-header">
    <div class="st-header-inner">
      <a class="st-brand" href="/concepts/shimna-taxis/">
        <span class="st-brand-name">Shimna Taxis</span>
        <span class="st-brand-sub">18 Railway Street · Newcastle</span>
      </a>
      <nav class="st-nav" aria-label="Concept navigation">
        <a href="#board">The board</a>
        <a href="#desk">The desk</a>
        <a href="#ride">The ride</a>
        <a href="#dispatch">Dispatch</a>
      </nav>
      <a class="st-ring-nav" href={phoneAHref}>Ring: {phoneA}</a>
    </div>
  </header>

  <main class="st-main">
    <section class="st-hero" aria-labelledby="st-hero-title">
      <div class="st-hero-copy">
        <p class="st-kicker">Taxi · Railway Street · Newcastle</p>
        <h1 id="st-hero-title">Shimna Taxis</h1>
        <p class="st-number">18 Railway Street · Newcastle</p>
        <p class="st-say">Ring. We come.</p>
        <p class="st-lede">
          Local taxis for Newcastle and visitors — airport runs, day trips,
          executive cars, golf, and a female driver if you prefer. Cards welcome.
        </p>
        <div class="st-hero-actions">
          <a class="st-btn-primary" href={phoneAHref}>Ring {phoneA}</a>
          <a class="st-btn-secondary" href={phoneBHref}>Ring {phoneB}</a>
        </div>
      </div>

      <figure class="st-theatre">
        <img
          src="/media/concepts/shimna-taxis/shimna-taxis-hero-railway-street.jpg"
          alt="Shimna Taxis local dispatch office at 18 Railway Street Newcastle at evening dusk"
          width="1200"
          height="675"
          loading="eager"
        />
        <figcaption>18 Railway Street · Local 24-hour dispatch in Newcastle</figcaption>
      </figure>
    </section>

    <section class="st-board" id="board" aria-labelledby="st-board-title">
      <div class="st-section-head">
        <p class="st-kicker st-kicker--amber">The board</p>
        <h2 id="st-board-title">What we run.</h2>
        <p class="st-section-lead">
          Modern saloons, people carriers and estates. Ring either line and say where.
        </p>
      </div>

      <div class="st-board-grid">
        {board.map((row) => (
          <article class="st-board-card">
            <span class="st-board-code">{row.code}</span>
            <h3 class="st-board-title">{row.title}</h3>
            <p class="st-board-desc">{row.desc}</p>
            <a class="st-board-link" href={phoneAHref}>Ring to book →</a>
          </article>
        ))}
      </div>
    </section>

    <section class="st-section" id="desk" aria-labelledby="st-desk-title">
      <div class="st-section-copy">
        <p class="st-kicker st-kicker--amber">The desk</p>
        <h2 id="st-desk-title">On the desk every hour.</h2>
        <p class="st-lead">
          We take locals and visitors from A to B — business or leisure. Hospital runs, ferry terminals, school runs, theatre nights, sporting events — ring and say where.
        </p>
        <blockquote class="st-pull">
          <p>24 hours a day, 365 days a year.</p>
          <cite>18 Railway Street dispatch</cite>
        </blockquote>
      </div>

      <figure class="st-photo-card">
        <img
          src="/media/concepts/shimna-taxis/shimna-taxis-dispatch-desk.jpg"
          alt="Local taxi dispatch desk with landline receiver, booking logs, and radio equipment at 18 Railway Street"
          width="1200"
          height="800"
          loading="lazy"
        />
        <figcaption>The Dispatch Desk · 18 Railway Street, Newcastle</figcaption>
      </figure>
    </section>

    <section class="st-section st-section--alt" id="ride" aria-labelledby="st-ride-title">
      <figure class="st-photo-card">
        <img
          src="/media/concepts/shimna-taxis/shimna-taxis-coastal-run.jpg"
          alt="Shimna Taxis silver estate car on a scenic Mourne coastal drive"
          width="1200"
          height="800"
          loading="lazy"
        />
        <figcaption>Coastal &amp; Golf Trips · Airport runs, day trips and tours</figcaption>
      </figure>

      <div class="st-section-copy">
        <p class="st-kicker st-kicker--amber">The ride</p>
        <h2 id="st-ride-title">Coastal runs &amp; airport transfers.</h2>
        <p class="st-lead">
          Whether it is Belfast International, Dublin Airport, a scenic tour around the Mourne mountains, or a local run back from the harbour — we have the boot space and comfortable cars ready.
        </p>
        <div class="st-inline-action">
          <a class="st-btn-primary" href={phoneAHref}>Book your run: {phoneA}</a>
        </div>
      </div>
    </section>

    <section class="st-door-section" id="dispatch" aria-labelledby="st-dispatch-title">
      <div class="st-door-card">
        <p class="st-kicker st-kicker--amber">Dispatch</p>
        <h2 id="st-dispatch-title">18 Railway Street.</h2>
        <p class="st-door-desc">
          Two direct telephone lines that answer 24 hours a day. No complex apps, no surge pricing — ring directly to our office on Railway Street.
        </p>

        <div class="st-door-actions">
          <a class="st-door-btn st-door-btn--tel" href={phoneAHref}>
            <span class="st-door-label">Primary Line</span>
            <span class="st-door-val">{phoneA}</span>
          </a>
          <a class="st-door-btn st-door-btn--tel" href={phoneBHref}>
            <span class="st-door-label">Secondary Line</span>
            <span class="st-door-val">{phoneB}</span>
          </a>
          <a class="st-door-btn" href={site} rel="noopener noreferrer">
            <span class="st-door-label">Official Website</span>
            <span class="st-door-val">shimnatravel.co.uk →</span>
          </a>
        </div>

        <address class="st-address">
          <strong>Shimna Taxis</strong>
          <span>18 Railway Street</span>
          <span>Newcastle, Co. Down · BT33 0AL</span>
          <span>24 Hours · 365 Days</span>
        </address>
      </div>
    </section>
  </main>
</ConceptLayout>
