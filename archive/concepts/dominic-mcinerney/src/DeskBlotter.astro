---
/* Drawn desk blotter at 123A Main Street.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
---

<svg
  class="dm-blotter"
  viewBox="0 0 1000 620"
  role="img"
  aria-label="Drawn desk at 123A Main Street: a cream blotter with oxblood corners, letterhead, a fountain pen, and a brass plate reading 123A"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="dm-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e7eef1"/>
      <stop offset="1" stop-color="#f3ead4"/>
    </linearGradient>
    <linearGradient id="dm-plaster" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#efe6d4"/>
      <stop offset="1" stop-color="#e4d8c0"/>
    </linearGradient>
    <linearGradient id="dm-wood" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9a7454"/>
      <stop offset="1" stop-color="#7a573e"/>
    </linearGradient>
    <linearGradient id="dm-pad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f7f1e4"/>
      <stop offset="1" stop-color="#ead9bb"/>
    </linearGradient>
    <linearGradient id="dm-sheet" x1="0" y1="0" x2=".2" y2="1">
      <stop offset="0" stop-color="#fffcf6"/>
      <stop offset="1" stop-color="#f4ead6"/>
    </linearGradient>
    <linearGradient id="dm-glass" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f7fbfc" stop-opacity="0.28"/>
      <stop offset="1" stop-color="#d7dde0" stop-opacity="0.12"/>
    </linearGradient>
    <pattern id="dm-grain" width="48" height="12" patternUnits="userSpaceOnUse">
      <path d="M0 7h48" stroke="#6a4630" stroke-width=".6" opacity=".18"/>
      <path d="M8 3h22" stroke="#c4a078" stroke-width=".5" opacity=".2"/>
    </pattern>
  </defs>

  <rect width="1000" height="620" fill="url(#dm-plaster)"/>

  <!-- Sash window, quiet Main Street daylight -->
  <rect x="70" y="28" width="860" height="248" fill="#4a2d28"/>
  <rect x="84" y="42" width="832" height="220" fill="url(#dm-sky)"/>

  <!-- Opposite roofs — a street, not a portrait -->
  <path d="M84 168h832v94H84Z" fill="#cfc6b6"/>
  <path d="M84 168l70-36h120l54 36H84Z" fill="#8d7a68"/>
  <path d="M328 168l88-42h150l62 42H328Z" fill="#7a6758"/>
  <path d="M628 168l64-30h140l84 30H628Z" fill="#918274"/>
  <g fill="#efe6d4" stroke="#6a5848" stroke-width="1.2">
    <rect x="118" y="178" width="36" height="48"/>
    <rect x="168" y="178" width="36" height="48"/>
    <rect x="392" y="176" width="40" height="52"/>
    <rect x="448" y="176" width="40" height="52"/>
    <rect x="504" y="176" width="40" height="52"/>
    <rect x="692" y="178" width="34" height="46"/>
    <rect x="738" y="178" width="34" height="46"/>
    <rect x="784" y="178" width="34" height="46"/>
  </g>
  <rect x="250" y="132" width="14" height="36" fill="#6b3034"/>
  <rect x="560" y="118" width="16" height="48" fill="#5a534a"/>

  <rect x="84" y="42" width="832" height="220" fill="url(#dm-glass)"/>
  <line x1="500" y1="42" x2="500" y2="262" stroke="#4a2d28" stroke-width="8"/>
  <line x1="84" y1="152" x2="916" y2="152" stroke="#4a2d28" stroke-width="6"/>
  <rect x="84" y="42" width="832" height="220" fill="none" stroke="#3a241f" stroke-width="3"/>
  <rect x="70" y="268" width="860" height="14" fill="#c4a078"/>

  <!-- Desk -->
  <rect x="0" y="318" width="1000" height="302" fill="url(#dm-wood)"/>
  <rect x="0" y="318" width="1000" height="302" fill="url(#dm-grain)"/>
  <rect x="0" y="318" width="1000" height="10" fill="#5a3a28"/>

  <!-- Brass plate 123A -->
  <g transform="translate(48 392)">
    <rect x="0" y="0" width="92" height="58" rx="3" fill="#b08a4a"/>
    <rect x="4" y="4" width="84" height="50" rx="2" fill="none" stroke="#6a4e28" stroke-width="1.2"/>
    <text
      x="46"
      y="38"
      text-anchor="middle"
      fill="#2a1c10"
      font-family="Libre Baskerville, Georgia, serif"
      font-size="22"
      font-weight="700"
    >123A</text>
  </g>

  <!-- Leather blotter -->
  <rect x="168" y="352" width="620" height="232" rx="4" fill="#4a2d28"/>
  <rect x="180" y="364" width="596" height="208" fill="url(#dm-pad)"/>
  <polygon points="180,364 214,364 180,398" fill="#6b3034"/>
  <polygon points="776,364 776,398 742,364" fill="#6b3034"/>
  <polygon points="180,572 214,572 180,538" fill="#6b3034"/>
  <polygon points="776,572 776,538 742,572" fill="#6b3034"/>

  <!-- Letterhead -->
  <g transform="translate(214 392)">
    <rect x="4" y="4" width="328" height="148" fill="#d8cbb3"/>
    <rect x="0" y="0" width="328" height="148" fill="url(#dm-sheet)" stroke="#c9c3b8" stroke-width="1"/>
    <line x1="22" y1="18" x2="306" y2="18" stroke="#6b3034" stroke-width="1.2"/>
    <text
      x="164"
      y="44"
      text-anchor="middle"
      fill="#1e1914"
      font-family="Libre Baskerville, Georgia, serif"
      font-size="18"
      font-weight="700"
    >Dominic McInerney</text>
    <text
      x="164"
      y="64"
      text-anchor="middle"
      fill="#6b3034"
      font-family="Source Sans 3, Segoe UI, sans-serif"
      font-size="9"
      font-weight="700"
      letter-spacing="2.4"
    >SOLICITORS — Established 1998</text>
    <line x1="86" y1="74" x2="242" y2="74" stroke="#c9c3b8" stroke-width="1"/>
    <text
      x="164"
      y="96"
      text-anchor="middle"
      fill="#5a534a"
      font-family="Libre Baskerville, Georgia, serif"
      font-size="11"
    >123A Main Street, Newcastle</text>
    <text
      x="164"
      y="114"
      text-anchor="middle"
      fill="#5a534a"
      font-family="Source Sans 3, Segoe UI, sans-serif"
      font-size="10"
    >BT33 0AE · 028 4372 5238</text>
    <text
      x="164"
      y="132"
      text-anchor="middle"
      fill="#5a534a"
      font-family="Source Sans 3, Segoe UI, sans-serif"
      font-size="9"
    >dmcinerney@btconnect.com</text>
  </g>

  <!-- Fountain pen -->
  <g transform="translate(548 470) rotate(-18)">
    <rect x="0" y="0" width="168" height="9" rx="4" fill="#1e1914"/>
    <rect x="118" y="0" width="28" height="9" fill="#6b3034"/>
    <polygon points="168,0 186,4.5 168,9" fill="#c9c3b8"/>
    <rect x="22" y="1.5" width="18" height="6" fill="#a48452"/>
  </g>

  <!-- Ink bottle -->
  <g transform="translate(820 404)">
    <rect x="18" y="0" width="28" height="14" rx="2" fill="#3a241f"/>
    <rect x="8" y="14" width="48" height="52" rx="4" fill="#1e1914"/>
    <rect x="14" y="22" width="36" height="28" fill="#6b3034" opacity=".55"/>
    <ellipse cx="32" cy="28" rx="10" ry="5" fill="#f7f1e4" opacity=".18"/>
  </g>

  <!-- Envelope -->
  <g transform="translate(818 492)">
    <rect x="0" y="12" width="130" height="78" fill="#f7f2e8" stroke="#c9c3b8" stroke-width="1.2"/>
    <path d="M0 12l65 38 65-38" fill="#efe6d4" stroke="#c9c3b8" stroke-width="1.2"/>
    <text
      x="65"
      y="64"
      text-anchor="middle"
      fill="#5a534a"
      font-family="Libre Baskerville, Georgia, serif"
      font-size="9"
    >123A Main Street</text>
  </g>
</svg>
