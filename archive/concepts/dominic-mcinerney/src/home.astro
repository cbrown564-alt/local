---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import DeskBlotter from "./DeskBlotter.astro";

/* Dominic McInerney Solicitors — elevated private legal counsel chamber concept.
   123A Main Street, Newcastle · BT33 0AE.
   Established 1998. All cases handled personally by Dominic McInerney.
   Sourced from dominicmcinerney.co.uk, LSNI records, and Google Business. */

const phone = "028 4372 5238";
const phoneHref = "tel:+442843725238";
const email = "dmcinerney@btconnect.com";
const mailto = `mailto:${email}`;
const site = "https://www.dominicmcinerney.co.uk";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap";

const areas = [
  {
    code: "PROP-01",
    title: "Property & Conveyancing",
    desc: "Residential house sales, purchases, remortgages, and commercial property transfers across Newcastle and the Mourne region.",
  },
  {
    code: "WILL-02",
    title: "Wills, Probate & Estates",
    desc: "Will drafting, Enduring Powers of Attorney, estate administration, and protecting family assets with complete confidentiality.",
  },
  {
    code: "INJ-03",
    title: "Personal Injury & Medical Negligence",
    desc: "Experienced representation for road traffic accidents, workplace injuries, and clinical negligence claims.",
  },
  {
    code: "FAM-04",
    title: "Family Law & Civil Litigation",
    desc: "Discreet guidance on matrimonial separation, divorce, financial arrangements, debt recovery, and court dispute litigation.",
  },
];
---

<ConceptLayout
  title={"Dominic McInerney Solicitors — 123A Main Street, Newcastle"}
  slug="dominic-mcinerney"
  bodyClass="concept-page concept-dominic"
  lang="en-GB"
  businessName="Dominic McInerney Solicitors"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="Chamber photography and consultation desk scenes are AI-generated illustrative visualisations of 123A Main Street."
>
  <div class="dm-strip">
    <span>123A Main Street, Newcastle · County Down · BT33 0AE · Established 1998</span>
    <span class="dm-strip-r">Personal Legal Counsel · <a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="dm-header">
    <a class="dm-brand" href="/concepts/dominic-mcinerney/">
      <span class="dm-brand-mark" aria-hidden="true">
        <DeskBlotter compact />
      </span>
      <span class="dm-brand-text">
        <span class="dm-brand-name">Dominic McInerney</span>
        <span class="dm-brand-sub">SOLICITORS · Established 1998</span>
      </span>
    </a>
    <nav class="dm-nav" aria-label="Concept navigation">
      <a href="#covenant">Personal counsel</a>
      <a href="#areas">Practice areas</a>
      <a href="#consultation">Consultation</a>
      <a href="#chamber">Contact 123A</a>
    </nav>
    <a class="dm-call-nav" href={phoneHref}>Call: {phone}</a>
  </header>

  <main class="dm-main">
    <!-- Hero with atmospheric private legal chamber photography plate -->
    <section class="dm-hero" aria-labelledby="dm-hero-title">
      <figure class="dm-hero-plate">
        <picture>
          <img
            src="/media/concepts/dominic-mcinerney/dominic-mcinerney-hero-chamber.jpg"
            alt="AI-generated illustrative photograph of private legal consultation chamber on Newcastle Main Street overlooking the Mournes"
            width="1920"
            height="1080"
            loading="eager"
          />
        </picture>
        <figcaption>The consultation chamber at 123A Main Street. AI-generated illustrative visualisation.</figcaption>
      </figure>

      <div class="dm-hero-veil" aria-hidden="true"></div>

      <div class="dm-hero-stage">
        <p class="dm-kicker">123A Main Street · Newcastle · Est. 1998</p>
        <h1 id="dm-hero-title">Dominic McInerney</h1>
        <p class="dm-hero-say">All cases handled personally.</p>
        <p class="dm-hero-lede">
          A private firm of solicitors based on Newcastle Main Street serving County Down. Over 28 years of trusted legal counsel, where your matter is handled directly by Dominic McInerney.
        </p>
        <div class="dm-hero-actions">
          <a class="dm-btn dm-btn--primary" href={phoneHref}>Speak with Dominic McInerney: {phone}</a>
          <a class="dm-btn dm-btn--ghost" href="#areas">Our practice areas ↓</a>
        </div>
      </div>
    </section>

    <!-- Sole Practitioner Dedication & Desk Detail Feature Split -->
    <section class="dm-covenant-section" id="covenant" aria-labelledby="dm-cov-title">
      <div class="dm-cov-grid">
        <div class="dm-cov-copy">
          <p class="dm-kicker dm-kicker--oxblood">Personal legal representation</p>
          <h2 id="dm-cov-title">Direct counsel from start to finish.</h2>
          <blockquote class="dm-quote">
            “We offer our clients a personal service, where all cases are handled personally by Dominic McInerney.”
          </blockquote>
          <p class="dm-cov-body">
            When you entrust your legal affairs to 123A Main Street, your case is not passed down to junior paralegals or anonymous case managers. Dominic McInerney advises, drafts, negotiates, and represents you directly at every stage.
          </p>
          <p class="dm-cov-body">
            Established in 1998, our practice provides the discretion, depth of local knowledge, and steadfast legal precision that complex life transitions require.
          </p>
        </div>

        <figure class="dm-cov-figure">
          <img
            src="/media/concepts/dominic-mcinerney/dominic-mcinerney-desk-detail.jpg"
            alt="AI-generated illustrative close-up of a solicitor consultation desk with parchment document and wax seal"
            width="1200"
            height="900"
            loading="lazy"
          />
          <figcaption>Confidential legal consultation. AI-generated illustrative visualisation.</figcaption>
        </figure>
      </div>
    </section>

    <!-- Practice Areas Grid -->
    <section class="dm-areas-section" id="areas" aria-labelledby="dm-areas-title">
      <div class="dm-section-header">
        <p class="dm-kicker dm-kicker--oxblood">Legal practice areas</p>
        <h2 id="dm-areas-title">Comprehensive legal counsel for County Down.</h2>
        <p class="dm-section-lead">Verified practice areas advised directly from our Newcastle office.</p>
      </div>

      <div class="dm-areas-grid">
        {areas.map((a) => (
          <article class="dm-area-card">
            <span class="dm-area-code">{a.code}</span>
            <h3 class="dm-area-title">{a.title}</h3>
            <p class="dm-area-desc">{a.desc}</p>
            <a class="dm-area-link" href={phoneHref}>Inquire regarding this matter →</a>
          </article>
        ))}
      </div>
    </section>

    <!-- Confidential Consultation Protocol & Desk Blotter -->
    <section class="dm-consultation-section" id="consultation" aria-labelledby="dm-con-title">
      <div class="dm-con-wrap">
        <div class="dm-con-copy">
          <p class="dm-kicker dm-kicker--oxblood">Confidential consultation</p>
          <h2 id="dm-con-title">Arrange a private consultation.</h2>
          <p class="dm-con-lead">
            Contact our office to discuss your legal requirements in complete confidence. Telephone lines are attended during business hours.
          </p>
          <div class="dm-con-card">
            <span class="dm-con-seal">PRIVILEGED &amp; CONFIDENTIAL</span>
            <strong>Direct Communication Channels:</strong>
            <p>Telephone: <strong>028 4372 5238</strong><br />Email: <strong>dmcinerney@btconnect.com</strong></p>
            <div class="dm-con-actions">
              <a class="dm-btn dm-btn--primary" href={phoneHref}>Call 028 4372 5238</a>
              <a class="dm-btn dm-btn--outline" href={mailto}>Email dmcinerney@btconnect.com</a>
            </div>
          </div>
        </div>

        <figure class="dm-blotter-figure" id="chamber">
          <DeskBlotter />
          <figcaption>The Desk at 123A Main Street · Newcastle.</figcaption>
        </figure>
      </div>
    </section>

    <!-- Footer -->
    <footer class="dm-footer">
      <div class="dm-footer-inner">
        <div class="dm-footer-brand">
          <DeskBlotter compact />
          <strong class="dm-footer-name">Dominic McInerney Solicitors</strong>
          <span>123A Main Street · Newcastle · County Down · BT33 0AE</span>
        </div>
        <div class="dm-footer-hours">
          <strong>Practice Established 1998</strong>
          <span>Sole Practitioner: Dominic McInerney · <a href={phoneHref}>{phone}</a></span>
        </div>
        <div class="dm-footer-links">
          <a href={site} rel="noopener noreferrer">dominicmcinerney.co.uk</a>
          <a href={mailto}>Direct Email: {email}</a>
        </div>
      </div>
    </footer>
  </main>
</ConceptLayout>
