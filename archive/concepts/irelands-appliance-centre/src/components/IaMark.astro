---
/**
 * Ireland's Appliance Centre — bespoke precision repair dial & harbour mark.
 * Reflects 40+ years of electrical engineering, refrigeration, and harbour trade.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className = "" } = Astro.props;
---

<svg
  class:list={["ia-mark", className]}
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  aria-hidden="true"
>
  <!-- Outer calibrated service dial -->
  <circle cx="20" cy="20" r="16.5" stroke="currentColor" stroke-width="1.8" />
  
  <!-- Dial ticks at cardinal points -->
  <line x1="20" y1="3.5" x2="20" y2="6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
  <line x1="20" y1="33.5" x2="20" y2="36.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
  <line x1="3.5" y1="20" x2="6.5" y2="20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
  <line x1="33.5" y1="20" x2="36.5" y2="20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />

  <!-- Inner electrical element / appliance coil arcs -->
  <path
    d="M13 25C11 22 11 18 13 15C15 12 18 10.5 20 10.5C22 10.5 25 12 27 15C29 18 29 22 27 25"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
  />
  
  <!-- Central precision indicator / needle -->
  <circle cx="20" cy="20" r="2.2" fill="currentColor" />
  <path
    d="M20 20L25 13"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
  />
  <path
    d="M12 27.5L28 27.5"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
  />
</svg>

<style>
  .ia-mark {
    display: inline-block;
    vertical-align: middle;
    color: currentColor;
    flex-shrink: 0;
  }
</style>
