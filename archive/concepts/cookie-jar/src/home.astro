---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import CjMark from "./components/CjMark.astro";
import CjWheatenPlate from "./components/CjWheatenPlate.astro";

/* Cookie Jar / Mourne and Bread — 121 Main Street, Newcastle · BT33 0AE.
   Morning stone-deck bakery counter & nationwide mail-order bread mix kits.
   Bakery telephone: 028 4372 2427. Mail-order shop: mourneandbread.co.uk. */

const phone = "028 4372 2427";
const phoneHref = "tel:+442843722427";
const email = "James@mourneandbread.co.uk";
const mixesShop = "https://mourneandbread.co.uk/";
const instagram = "https://www.instagram.com/cookiejardude80/";
const facebook = "https://www.facebook.com/CookiejarBakeryNewcastle";
const maps = "https://maps.google.com/?q=121+Main+Street+Newcastle+BT33+0AE";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap";

const mixes = [
  {
    name: "Award-Winning Wheaten Bread Mix",
    badge: "Signature Kit",
    note: "Stoneground wholemeal flour blended to our master bakery formula. Produces a moist, dense loaf with golden crumb.",
    yield: "Makes 1 standard loaf tin",
  },
  {
    name: "Traditional Soda Bread Mix",
    badge: "Heritage Kit",
    note: "The authentic Irish soda bread formula. Baked crisp on the outside and soft inside — perfect for griddling farls.",
    yield: "Makes 1 full soda round or 4 farls",
  },
  {
    name: "Buttermilk Scone Mix",
    badge: "Afternoon Tea",
    note: "Fluffy, golden country scones. Just add fresh buttermilk, gently roll, and bake for the afternoon tea table.",
    yield: "Makes 8–10 generous scones",
  },
];
---

<ConceptLayout
  title={"Cookie Jar — Traditional Irish Home Bakery & Bread Mixes, Newcastle"}
  slug="cookie-jar"
  bodyClass="concept-page concept-cookie-jar"
  lang="en-GB"
  businessName="Cookie Jar"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="Artisan baking scenes and wheaten bread details are AI-generated illustrative visualisations of Cookie Jar / Mourne and Bread."
>
  <div class="cj-strip">
    <span>121 Main Street, Newcastle · BT33 0AE · Stone-Deck Bakery & Mourne and Bread Mail-Order</span>
    <span class="cj-strip-r">
      <a href={phoneHref}>{phone}</a>
      <span aria-hidden="true"> · </span>
      <a href={mixesShop} target="_blank" rel="noopener noreferrer">Mourne and Bread Shop</a>
      <span aria-hidden="true"> · </span>
      <a href={facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
    </span>
  </div>

  <header class="cj-header">
    <a class="cj-brand" href="/concepts/cookie-jar/">
      <span class="cj-brand-mark">
        <CjMark size={38} />
      </span>
      <span class="cj-brand-text">
        <span class="cj-brand-name">Cookie Jar</span>
        <span class="cj-brand-sub">121 Main Street · Newcastle</span>
      </span>
    </a>
    <nav class="cj-nav" aria-label="Concept navigation">
      <a href="#hearth">The Bakery</a>
      <a href="#dual-deck">Dual-Deck System</a>
      <a href="#mixes">Mail-Order Mixes</a>
      <a href="#bake-guide">Bake at Home</a>
      <a href="#find">Find Us</a>
    </nav>
    <a class="cj-mix-btn" href={mixesShop} target="_blank" rel="noopener noreferrer">Order Bread Kits</a>
  </header>

  <main class="cj-main">
    <!-- Hero Bakery Section -->
    <section class="cj-hero" id="hearth" aria-labelledby="cj-hero-title">
      <div class="cj-hero-grid">
        <div class="cj-hero-copy">
          <p class="cj-eyebrow">Home Bakery · 121 Main Street</p>
          <h1 id="cj-hero-title">Stone ovens on Main Street. Fresh mixes in the post.</h1>
          <p class="cj-say">On Main Street, at the foot of the Mournes. The counter is the shop; mixes are the parcel.</p>
          <p class="cj-lede">
            For generations, Newcastle mornings begin at 121 Main Street with warm loaves
            of traditional Irish wheaten bread and hot soda farls. Today, through
            <strong>Mourne and Bread</strong>, our award-winning dry bread mixes are dispatched
            nationwide to homes across the UK and Ireland.
          </p>
          <div class="cj-hero-actions">
            <a class="cj-btn-primary" href={mixesShop} target="_blank" rel="noopener noreferrer">Get a Bread Mix Kit →</a>
            <a class="cj-btn-secondary" href="#dual-deck">Explore the Bakery</a>
          </div>
          <div class="cj-hero-badges">
            <span>Daily Morning Ovens</span>
            <span>Award-Winning Wheaten</span>
            <span>Nationwide Mail-Order</span>
          </div>
        </div>

        <div class="cj-hero-visual">
          <figure class="cj-figure">
            <picture>
              <source
                type="image/webp"
                srcset="/media/concepts/cookie-jar/cookie-jar-hero-bakery-640.webp 640w, /media/concepts/cookie-jar/cookie-jar-hero-bakery-1265.webp 1265w"
                sizes="(max-width: 800px) 100vw, 50vw"
              />
              <img
                src="/media/concepts/cookie-jar/cookie-jar-hero-bakery.jpg"
                alt="Traditional Irish home bakery counter at 121 Main Street with golden wheaten loaves and country butter"
                width="1600"
                height="900"
                loading="eager"
              />
            </picture>
            <figcaption>Fresh morning bake on the counter at 121 Main Street.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- The Dual-Deck System -->
    <section class="cj-dual" id="dual-deck" aria-labelledby="cj-dual-title">
      <div class="cj-section-head">
        <p class="cj-eyebrow">Two Ways to Enjoy</p>
        <h2 id="cj-dual-title">The Dual-Deck Bakery System</h2>
        <p class="cj-section-intro">
          Whether you walk through our Main Street door in Newcastle or bake our mixes in your own kitchen.
        </p>
      </div>

      <div class="cj-decks-grid">
        <!-- Deck 1: Main Street Counter -->
        <article class="cj-deck-card">
          <span class="cj-deck-badge">Deck 01 · In Newcastle</span>
          <h3>The 121 Main Street Counter</h3>
          <p class="cj-deck-summary">
            Fresh stone-deck bakes straight from the morning ovens, warm and ready for collection.
          </p>
          <ul class="cj-deck-list">
            <li><strong>Signature Wheaten Loaves:</strong> Wholesome, textured brown bread baked fresh every morning.</li>
            <li><strong>Griddled Soda Farls:</strong> Traditional buttermilk sodas, potato farls, and pancakes.</li>
            <li><strong>Celebration Cakes:</strong> Bespoke custom cakes for birthdays, anniversaries, and family events.</li>
            <li><strong>Daily Bakery Shelf:</strong> Apple tarts, custard slices, pastries, and buttery tea scones.</li>
          </ul>
          <div class="cj-deck-cta">
            <a class="cj-btn-outline" href={phoneHref}>Ring {phone} to Reserve Bakes</a>
          </div>
        </article>

        <!-- Deck 2: Mourne and Bread Mixes -->
        <article class="cj-deck-card cj-deck-card--highlight">
          <span class="cj-deck-badge cj-deck-badge--gold">Deck 02 · Dispatched Nationwide</span>
          <h3>Mourne and Bread Mix Parcels</h3>
          <p class="cj-deck-summary">
            Our secret dry blend packed in kraft parcels and posted directly to your kitchen door.
          </p>
          <ul class="cj-deck-list">
            <li><strong>Award-Winning Wheaten Mix:</strong> The famous Cookie Jar recipe in an easy-to-bake kit.</li>
            <li><strong>Traditional Soda Bread Mix:</strong> Pure Irish flour blend for stovetop or oven farls.</li>
            <li><strong>Country Scone Mix:</strong> The foolproof secret to golden, fluffy afternoon scones.</li>
            <li><strong>Just Add Buttermilk:</strong> Simple 3-step home baking with no kneading required.</li>
          </ul>
          <div class="cj-deck-cta">
            <a class="cj-btn-primary" href={mixesShop} target="_blank" rel="noopener noreferrer">Order Online at mourneandbread.co.uk →</a>
          </div>
        </article>
      </div>
    </section>

    <!-- Mail-Order Mixes & Signature Wheaten Showcase -->
    <section class="cj-mixes" id="mixes" aria-labelledby="cj-mixes-title">
      <div class="cj-mixes-layout">
        <div class="cj-mixes-content">
          <p class="cj-eyebrow">Mourne and Bread Collection</p>
          <h2 id="cj-mixes-title">Award-Winning Irish Bread Kits</h2>
          <p class="cj-mixes-intro">
            We spent years perfecting our dry mix formulas so anyone, anywhere can bake
            authentic Newcastle bread at home with guaranteed bakery-grade results.
          </p>
          <div class="cj-mix-items">
            {mixes.map((m) => (
              <div class="cj-mix-item">
                <div class="cj-item-head">
                  <h4>{m.name}</h4>
                  <span class="cj-item-badge">{m.badge}</span>
                </div>
                <p>{m.note}</p>
                <span class="cj-item-yield">{m.yield}</span>
              </div>
            ))}
          </div>
          <div class="cj-mix-actions">
            <a class="cj-btn-primary" href={mixesShop} target="_blank" rel="noopener noreferrer">Buy Bread Mix Kits Online →</a>
            <a class="cj-btn-outline" href={`mailto:${email}`}>Wholesale & Enquiries: {email}</a>
          </div>
        </div>

        <div class="cj-mixes-gallery">
          <figure class="cj-figure">
            <picture>
              <source
                type="image/webp"
                srcset="/media/concepts/cookie-jar/cookie-jar-wheaten-slice-640.webp 640w, /media/concepts/cookie-jar/cookie-jar-wheaten-slice-1265.webp 1265w"
                sizes="(max-width: 800px) 100vw, 40vw"
              />
              <img
                src="/media/concepts/cookie-jar/cookie-jar-wheaten-slice.jpg"
                alt="Thick slice of warm traditional wheaten bread with melting country butter on a plate"
                width="1200"
                height="900"
                loading="lazy"
              />
            </picture>
            <figcaption>The signature wheaten slice with churned country butter.</figcaption>
          </figure>

          <figure class="cj-figure">
            <picture>
              <source
                type="image/webp"
                srcset="/media/concepts/cookie-jar/cookie-jar-bread-mix-pack-640.webp 640w, /media/concepts/cookie-jar/cookie-jar-bread-mix-pack-1265.webp 1265w"
                sizes="(max-width: 800px) 100vw, 40vw"
              />
              <img
                src="/media/concepts/cookie-jar/cookie-jar-bread-mix-pack.jpg"
                alt="Kraft paper Mourne and Bread mail-order baking kits with wholesome ingredients and buttermilk"
                width="1200"
                height="800"
                loading="lazy"
              />
            </picture>
            <figcaption>Mourne and Bread mail-order baking kit packaging.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 3-Step Bake Guide -->
    <section class="cj-guide" id="bake-guide" aria-labelledby="cj-guide-title">
      <div class="cj-guide-wrap">
        <div class="cj-guide-copy">
          <p class="cj-eyebrow">Foolproof Method</p>
          <h2 id="cj-guide-title">How to Bake at Home</h2>
          <p>
            No proofing, no yeast waiting times, no special equipment needed.
            Just simple, wholesome baking in three steps.
          </p>
          <div class="cj-guide-steps">
            <div class="cj-step">
              <span class="cj-step-num">01</span>
              <h4>Add Buttermilk</h4>
              <p>Empty the mix into a bowl and pour in fresh buttermilk. Stir gently with a wooden spoon.</p>
            </div>
            <div class="cj-step">
              <span class="cj-step-num">02</span>
              <h4>Shape into Tin</h4>
              <p>Spoon the thick dough into a greased 2lb loaf tin or shape onto a floured baking sheet.</p>
            </div>
            <div class="cj-step">
              <span class="cj-step-num">03</span>
              <h4>Bake 35 Mins</h4>
              <p>Bake in a preheated oven at 180°C until the crust is deep golden and sounds hollow when tapped.</p>
            </div>
          </div>
        </div>

        <div class="cj-guide-artefact">
          <CjWheatenPlate />
        </div>
      </div>
    </section>

    <!-- Find Us / Door Block -->
    <section class="cj-find" id="find" aria-labelledby="cj-find-title">
      <div class="cj-find-head">
        <p class="cj-eyebrow">Bakery & Mix Dispatches</p>
        <h2 id="cj-find-title">121 Main Street, Newcastle</h2>
      </div>
      <div class="cj-find-grid">
        <div class="cj-find-col">
          <h3>The Bakery Door</h3>
          <p>
            Cookie Jar Home Bakery<br />
            121 Main Street<br />
            Newcastle, County Down<br />
            BT33 0AE
          </p>
          <a class="cj-link" href={maps} target="_blank" rel="noopener noreferrer">Open in Google Maps →</a>
        </div>
        <div class="cj-find-col">
          <h3>Counter Bakes & Orders</h3>
          <p>Fresh bakes on the counter daily from early morning.</p>
          <p>Celebration cakes & counter reservations: <a href={phoneHref}><strong>{phone}</strong></a></p>
          <p>Facebook: <a href={facebook} target="_blank" rel="noopener noreferrer">Cookie Jar Bakery Newcastle</a></p>
        </div>
        <div class="cj-find-col">
          <h3>Mourne and Bread Mixes</h3>
          <p>Order bread kits online: <a href={mixesShop} target="_blank" rel="noopener noreferrer"><strong>mourneandbread.co.uk</strong></a></p>
          <p>Mix inquiries: <a href={`mailto:${email}`}><strong>{email}</strong></a></p>
          <p>Instagram: <a href={instagram} target="_blank" rel="noopener noreferrer">@cookiejardude80</a></p>
        </div>
      </div>
    </section>
  </main>
</ConceptLayout>
