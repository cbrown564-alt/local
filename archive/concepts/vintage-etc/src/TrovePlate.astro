---
/* Drawn Main Street window: teak fascia, brass lamp, mid-century sideboard.
   Not a photograph. Not a charity rail. Honesty lives in bannerNote. */
---

<svg
  class="ve-plate"
  viewBox="0 0 640 800"
  role="img"
  aria-label="Drawn shop window on Main Street: teak fascia reading Vintage etc., a mid-century sideboard and a brass lamp behind the glass"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="ve-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e8dfcf"/>
      <stop offset="1" stop-color="#d7cbb6"/>
    </linearGradient>
    <linearGradient id="ve-glass" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f7f3ea" stop-opacity="0.22"/>
      <stop offset="0.45" stop-color="#d9cfc0" stop-opacity="0.08"/>
      <stop offset="1" stop-color="#cbbba4" stop-opacity="0.28"/>
    </linearGradient>
    <linearGradient id="ve-teak-fill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#8a5532"/>
      <stop offset="1" stop-color="#5c341c"/>
    </linearGradient>
    <linearGradient id="ve-room" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f4ead8"/>
      <stop offset="1" stop-color="#e2d2b6"/>
    </linearGradient>
    <radialGradient id="ve-lamp-glow" cx="50%" cy="38%" r="42%">
      <stop offset="0" stop-color="#f6e3b0" stop-opacity="0.7"/>
      <stop offset="1" stop-color="#f6e3b0" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <rect width="640" height="800" fill="url(#ve-sky)"/>

  <!-- Pavement -->
  <rect x="0" y="730" width="640" height="70" fill="#cbbc9f"/>
  <rect x="0" y="724" width="640" height="8" fill="#b9a888"/>

  <!-- Building mass -->
  <rect x="48" y="36" width="544" height="696" fill="#efe6d6" stroke="#b9a888" stroke-width="2"/>
  <rect x="48" y="36" width="18" height="696" fill="#d8cbb4"/>
  <rect x="574" y="36" width="18" height="696" fill="#d8cbb4"/>

  <!-- Fascia -->
  <rect x="66" y="52" width="508" height="92" fill="url(#ve-teak-fill)"/>
  <rect x="66" y="140" width="508" height="6" fill="#b5924a"/>
  <text
    x="320"
    y="98"
    text-anchor="middle"
    fill="#faf6ee"
    font-family="Libre Bodoni, Palatino, serif"
    font-size="42"
    font-weight="600"
  >Vintage etc.</text>
  <text
    x="320"
    y="128"
    text-anchor="middle"
    fill="#d4b56a"
    font-family="Manrope, Segoe UI, sans-serif"
    font-size="11"
    font-weight="700"
    letter-spacing="5.5"
  >4 MAIN STREET</text>

  <!-- Window frame -->
  <rect x="86" y="168" width="468" height="500" fill="url(#ve-room)" stroke="#4a2c18" stroke-width="10"/>
  <rect x="96" y="178" width="448" height="480" fill="none" stroke="#b5924a" stroke-width="2"/>

  <!-- Interior lamp glow -->
  <ellipse cx="320" cy="300" rx="160" ry="120" fill="url(#ve-lamp-glow)"/>

  <!-- Brass lamp -->
  <rect x="312" y="248" width="16" height="8" fill="#b5924a"/>
  <path d="M292 248 L348 248 L336 210 L304 210 Z" fill="#c4a45a"/>
  <rect x="318" y="256" width="8" height="86" fill="#8c6e32"/>
  <ellipse cx="322" cy="346" rx="22" ry="6" fill="#704326"/>

  <!-- Teak sideboard -->
  <rect x="168" y="430" width="304" height="92" fill="#704326"/>
  <rect x="168" y="430" width="304" height="22" fill="#8a5532"/>
  <path d="M269 452 v70 M371 452 v70" stroke="#4a2c18" stroke-width="1.4"/>
  <circle cx="218" cy="492" r="4" fill="#b5924a"/>
  <circle cx="320" cy="492" r="4" fill="#b5924a"/>
  <circle cx="422" cy="492" r="4" fill="#b5924a"/>
  <path d="M184 522 L172 572" stroke="#4a2c18" stroke-width="5" stroke-linecap="round"/>
  <path d="M456 522 L468 572" stroke="#4a2c18" stroke-width="5" stroke-linecap="round"/>
  <path d="M164 574 H476" stroke="#4a2c18" stroke-width="3"/>

  <!-- Record leaning — music vibes, not a SKU -->
  <rect x="198" y="372" width="54" height="54" transform="rotate(-8 225 399)" fill="#2a2118"/>
  <rect x="204" y="378" width="42" height="42" transform="rotate(-8 225 399)" fill="#9a4a32"/>
  <circle cx="225" cy="399" r="8" fill="#f2ece2" transform="rotate(-8 225 399)"/>

  <!-- Ceramic -->
  <ellipse cx="402" cy="422" rx="16" ry="7" fill="#c4b49a"/>
  <path d="M390 422 C390 398, 414 398, 414 422" fill="#d8cbb4" stroke="#8a7a62" stroke-width="1"/>

  <!-- Glass over interior -->
  <rect x="96" y="178" width="448" height="480" fill="url(#ve-glass)"/>
  <path d="M120 190 L210 190 L168 660 L96 660 Z" fill="#fff" opacity=".06"/>

  <!-- Transom lettering on glass -->
  <text
    x="320"
    y="214"
    text-anchor="middle"
    fill="#4a2c18"
    fill-opacity=".45"
    font-family="Manrope, Segoe UI, sans-serif"
    font-size="13"
    font-weight="700"
    letter-spacing="7"
  >MID CENTURY</text>

  <!-- Door -->
  <rect x="268" y="560" width="104" height="108" fill="#5c341c" stroke="#b5924a" stroke-width="2"/>
  <rect x="278" y="572" width="84" height="52" fill="#d9cfc0" opacity=".35"/>
  <circle cx="354" cy="630" r="4" fill="#b5924a"/>
</svg>
