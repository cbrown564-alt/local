---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

/* Morelli's @ Newcastle — jar: a scoop you take to the prom.
   Speak as the Newcastle door. Not Portrush HQ. Not Café Mauds.
   First-party door: 73 Central Promenade, BT33 0HH.
   No Newcastle till phone. Hours third-party only — omit. No fake order form.
   Brand handoff: morellisices.com. One heritage line max. */

const brand = "https://www.morellisices.com/";
const buy = "https://www.morellisices.com/buy.php";
const maps =
  "https://www.google.com/maps/search/?api=1&query=73+Central+Promenade+Newcastle+BT33+0HH";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,500;0,6..96,600;0,6..96,700;1,6..96,500;1,6..96,600&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap";

const ritual = [
  {
    kicker: "The Door",
    title: "Find 73.",
    body: "Central Promenade, Newcastle. Walk up to the awning — that is the parlour.",
  },
  {
    kicker: "The Scoop",
    title: "Choose at the counter.",
    body: "A cone or a cup. Fresh gelato made with traditional Italian craft.",
  },
  {
    kicker: "The Walk",
    title: "Take it to the prom.",
    body: "Irish Sea on one side, Mournes behind. The melt is the ritual.",
  },
];
---

<ConceptLayout
  title={"Morelli's @ Newcastle — independent concept"}
  slug="morellis"
  bodyClass="concept-page concept-morellis"
  lang="en-GB"
  businessName="Morelli's @ Newcastle"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="AI-generated illustrations imagine the setting, spaces and products; they are not photographs of the business."
>
  <div class="mo-strip">
    <span>73 Central Promenade, Newcastle · BT33 0HH</span>
    <span class="mo-strip-r">
      <a href={brand} rel="noopener noreferrer">morellisices.com</a>
    </span>
  </div>

  <header class="mo-header">
    <div class="mo-header-inner">
      <a class="mo-brand" href="/concepts/morellis/">
        <span class="mo-brand-name">Morelli's</span>
        <span class="mo-brand-sub">@ Newcastle · Central Promenade</span>
      </a>
      <nav class="mo-nav" aria-label="Concept navigation">
        <a href="#scoop">The Scoop</a>
        <a href="#walk">The Walk</a>
        <a href="#door">Find 73</a>
      </nav>
      <a class="mo-walk-btn" href="#door">Find 73</a>
    </div>
  </header>

  <main class="mo-main">
    <section class="mo-hero" aria-labelledby="mo-name">
      <div class="mo-mast">
        <p class="mo-kicker">Gelato &amp; Ice Cream · Central Promenade</p>
        <h1 id="mo-name">
          <span class="mo-name-brand">Morelli's</span>
          <span class="mo-name-door">@ Newcastle</span>
        </h1>
        <p class="mo-number">73 Central Promenade · BT33 0HH</p>
        <p class="mo-say">A scoop you take to the prom.</p>
        <p class="mo-lede">
          Walk in at 73. Choose a cone or a cup. Carry it along the Central
          Promenade — sea beside, Mournes behind.
        </p>
        <p class="mo-heritage">
          Morelli's ice cream — the family name since 1911.
          <a href={brand} rel="noopener noreferrer">Brand story on morellisices.com →</a>
        </p>
        <div class="mo-hero-actions">
          <a class="mo-btn-primary" href="#door">Find the Parlour</a>
          <a class="mo-btn-secondary" href={maps} rel="noopener noreferrer">Map · 73 Central Prom</a>
        </div>
      </div>

      <figure class="mo-theatre">
        <img
          src="/media/concepts/morellis/morellis-hero-promenade.jpg"
          alt="Morelli's ice cream parlour awning at 73 Central Promenade on the Newcastle seafront"
          width="1200"
          height="800"
          loading="eager"
        />
        <figcaption>73 Central Promenade · Right on Newcastle's seaside promenade</figcaption>
      </figure>
    </section>

    <section class="mo-section" id="scoop" aria-labelledby="mo-melt-title">
      <div class="mo-section-copy">
        <p class="mo-kicker">The Scoop</p>
        <h2 id="mo-melt-title">The product at the moment it is for.</h2>
        <p class="mo-lead">
          Not a table booking. Not a delivery widget. A scoop leaving the counter, already on its way to the promenade — soft sea breeze, coastal light, and the cold fresh melt.
        </p>
        <div class="mo-brand-handoff">
          <p>Flavours, awards, and regional stockists live on the official brand site.</p>
          <a href={buy} rel="noopener noreferrer">Where to buy · morellisices.com →</a>
        </div>
      </div>

      <figure class="mo-photo-card">
        <img
          src="/media/concepts/morellis/morellis-counter-gelato.jpg"
          alt="Fresh artisan gelato tubs behind the counter at 73 Central Promenade"
          width="1200"
          height="800"
          loading="lazy"
        />
        <figcaption>Gelato counter · Award-winning flavours served fresh daily</figcaption>
      </figure>
    </section>

    <section class="mo-section mo-section--walk" id="walk" aria-labelledby="mo-ritual-title">
      <figure class="mo-photo-card">
        <img
          src="/media/concepts/morellis/morellis-promenade-cone.jpg"
          alt="A delicious cone held against the promenade railings with the Mournes and sea in view"
          width="1200"
          height="800"
          loading="lazy"
        />
        <figcaption>The Newcastle Ritual · Take your cone along the promenade</figcaption>
      </figure>

      <div class="mo-section-copy">
        <p class="mo-kicker">The Walk</p>
        <h2 id="mo-ritual-title">Walk up. Scoop. Promenade.</h2>
        <p class="mo-lead">
          That is the visit. Come to the door, order your favourites, and step straight out onto the sea front.
        </p>

        <div class="mo-ritual-grid">
          {ritual.map((step) => (
            <div class="mo-ritual-cell">
              <p class="mo-ritual-kicker">{step.kicker}</p>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mo-door-section" id="door" aria-labelledby="mo-door-title">
      <div class="mo-door-card">
        <p class="mo-kicker">Location</p>
        <h2 id="mo-door-title">73 Central Promenade.</h2>
        <p class="mo-door-desc">
          Right on the seafront in Newcastle. Find the door, walk in, and take your scoop straight out onto the promenade.
        </p>

        <div class="mo-door-actions">
          <a class="mo-door-btn mo-door-btn--map" href={maps} rel="noopener noreferrer">
            <span class="mo-door-label">Directions</span>
            <span class="mo-door-val">Open in Google Maps →</span>
          </a>
          <a class="mo-door-btn" href={brand} rel="noopener noreferrer">
            <span class="mo-door-label">Official Website</span>
            <span class="mo-door-val">morellisices.com</span>
          </a>
        </div>

        <address class="mo-address">
          <strong>Morelli's @ Newcastle</strong>
          <span>73 Central Promenade</span>
          <span>Newcastle, Co. Down · BT33 0HH</span>
        </address>
      </div>
    </section>
  </main>
</ConceptLayout>

