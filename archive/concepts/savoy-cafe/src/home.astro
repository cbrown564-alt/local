---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

/* Savoy Cafe — meal. Speak as the café.
   First-party savoy.cafe live-read 13 Sep 2026 (Europe/London).
   Ethos, door, contact hours, Mallon revival. Contact hours override the
   Mourne Magazine Monday late-night colour on /about/ — do not assert it.
   Revival ≠ continuous trading since the 1930s. Not Seasalt, not Broadway,
   not Mauds, not Piccolo (contrast stays in research). No booking form. */
const phone = "028 4372 5757";
const phoneHref = "tel:+442843725757";
const site = "https://savoy.cafe/";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Sora:wght@400;500;600;700&display=swap";
---

<ConceptLayout
  title={"Savoy Cafe — independent concept"}
  slug="savoy-cafe"
  bodyClass="concept-page concept-savoy"
  lang="en-GB"
  businessName="Savoy Cafe"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="AI-generated illustrations imagine the setting, spaces and products; they are not photographs of the business."
>
  <div class="sv-strip">
    <span>22–24 Main Street, Newcastle · BT33 0AD · Good Food, not Fast Food</span>
    <span class="sv-strip-r">
      Mon–Sun 08:00–17:00 · <a href={phoneHref}>{phone}</a>
    </span>
  </div>

  <header class="sv-header">
    <div class="sv-header-inner">
      <a class="sv-brand" href="/concepts/savoy-cafe/">
        <span class="sv-brand-name">Savoy Cafe</span>
        <span class="sv-brand-sub">22–24 Main Street · Newcastle</span>
      </a>
      <nav class="sv-nav" aria-label="Concept navigation">
        <a href="#counter">The Counter</a>
        <a href="#lunch">Hot Lunch</a>
        <a href="#ethos">Ethos</a>
        <a href="#name">The Name</a>
        <a href="#door">Find Us</a>
      </nav>
      <a class="sv-walk" href="#door">Walk in</a>
    </div>
  </header>

  <main class="sv-main">
    <section class="sv-hero" aria-labelledby="sv-name">
      <div class="sv-mast">
        <p class="sv-kicker">Family-run · Main Street</p>
        <h1 id="sv-name">Savoy Cafe</h1>
        <p class="sv-number">22–24 Main Street · Newcastle · BT33 0AD</p>
        <p class="sv-say">Good Food, not Fast Food</p>
        <p class="sv-lede">
          Homemade seasonal food, freshly made to order — breakfast through
          lunch, Fairtrade tea and coffee, traybakes and scones. Walk in,
          ring, or visit our site. There is no table to book online.
        </p>
        <div class="sv-cta">
          <a class="sv-btn-primary" href="#door">Walk in</a>
          <a class="sv-btn-secondary" href={phoneHref}>Ring {phone}</a>
          <a class="sv-site-link" href={site} rel="noopener noreferrer">savoy.cafe →</a>
        </div>
      </div>

      <figure class="sv-theatre">
        <img
          src="/media/concepts/savoy-cafe/savoy-cafe-hero-main-street.jpg"
          alt="Savoy Cafe traditional shopfront on Newcastle Main Street with warm morning light"
          width="1200"
          height="800"
          loading="eager"
        />
        <figcaption>22–24 Main Street · Centre of Newcastle, County Down</figcaption>
      </figure>
    </section>

    <section class="sv-feature" id="counter" aria-labelledby="sv-counter-title">
      <figure class="sv-photo-card">
        <img
          src="/media/concepts/savoy-cafe/savoy-cafe-counter-bakes.jpg"
          alt="Savoy Cafe counter display with freshly baked scones and homemade traybakes"
          width="1200"
          height="800"
          loading="lazy"
        />
        <figcaption>Fresh Counter Bakes · Homemade scones, traybakes and Fairtrade coffee</figcaption>
      </figure>

      <div class="sv-feature-copy">
        <p class="sv-kicker">The Counter</p>
        <h2 id="sv-counter-title">Made to order on Main Street.</h2>
        <p class="sv-lead">
          We pride ourselves in making everything fresh to order. Food, drinks,
          and treats — not a fast-food board with prices invented for a screen.
        </p>
        <div class="sv-counter-highlights">
          <div class="sv-highlight">
            <h3>Morning</h3>
            <p>From 8am — full Irish fry, poached eggs, to toasted teacakes with Greek yogurt and cinnamon.</p>
          </div>
          <div class="sv-highlight">
            <h3>Anytime</h3>
            <p>Fairtrade roasted coffee, specialty teas, and our signature fresh fruit scones baked daily.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="sv-feature sv-feature--reverse" id="lunch" aria-labelledby="sv-lunch-title">
      <div class="sv-feature-copy">
        <p class="sv-kicker">Midday</p>
        <h2 id="sv-lunch-title">Hot lunch &amp; fresh soups.</h2>
        <p class="sv-lead">
          Seasonal hot mains, hearty chowders, and sandwiches with contemporary fillings prepared right when you ask for them.
        </p>
        <p>
          Generous plates made with local Ulster produce. Takeaway and sandwich orders welcome — ring ahead on <a href={phoneHref}>{phone}</a> if you like.
        </p>
      </div>

      <figure class="sv-photo-card">
        <img
          src="/media/concepts/savoy-cafe/savoy-cafe-hot-lunch.jpg"
          alt="Freshly prepared hot lunch with hearty soup and artisan sandwich served at table"
          width="1200"
          height="800"
          loading="lazy"
        />
        <figcaption>Hot Lunch Specials · Homemade soup and toasted sandwiches made to order</figcaption>
      </figure>
    </section>

    <section class="sv-ethos" id="ethos" aria-labelledby="sv-ethos-title">
      <p class="sv-kicker sv-kicker--on-dark">Our Ethos</p>
      <h2 id="sv-ethos-title">Good Food, not Fast Food</h2>
      <p>
        Homemade seasonal food freshly made to order. That is our standard —
        family-run, in the heart of Newcastle, County Down.
      </p>
    </section>

    <section class="sv-name-arc" id="name" aria-labelledby="sv-arc-title">
      <div class="sv-paper">
        <p class="sv-kicker">The Name</p>
        <h2 id="sv-arc-title">A revived Savoy on Main Street.</h2>
        <p>
          Paddy &amp; Eileen Mallon revived the historic Savoy Cafe name and opened
          a modern, fresh café on the site adjacent to where the original café
          stood — over eighty years ago. A contemporary twist on a beloved Newcastle
          name, rooted in generous hospitality.
        </p>
      </div>
    </section>

    <section class="sv-door" id="door" aria-labelledby="sv-door-title">
      <div class="sv-door-copy">
        <p class="sv-kicker">The Door</p>
        <h2 id="sv-door-title">22–24 Main Street.</h2>
        <p class="sv-door-lede">
          Walk in seven days a week. Ring if you like. Or explore our website before coming to the counter.
        </p>
        <div class="sv-hours">
          <strong>Opening Hours</strong>
          <span>Monday to Sunday: 08:00 – 17:00</span>
          <span class="sv-hours-stamp">Verified first-party schedule</span>
        </div>
        <div class="sv-artefact-cta">
          <a class="sv-btn-primary" href="#door">Walk in</a>
          <a class="sv-btn-secondary" href={phoneHref}>Ring {phone}</a>
          <a class="sv-site-link" href={site} rel="noopener noreferrer">savoy.cafe →</a>
        </div>
      </div>

      <address class="sv-address">
        <strong>Savoy Cafe</strong>
        <span>22–24 Main Street</span>
        <span>Newcastle, County Down · BT33 0AD</span>
        <a href={phoneHref}>{phone}</a>
        <a href={site} rel="noopener noreferrer">Official site: savoy.cafe</a>
        <span>Open 7 Days: 08:00–17:00</span>
      </address>
    </section>
  </main>
</ConceptLayout>
