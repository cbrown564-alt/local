---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import CatchBoard from "./CatchBoard.astro";

/* Mourne Seafood Bar Dundrum — coastal village seafood dining at the head of Dundrum Bay.
   10 Main Street, Dundrum, BT33 0LU.
   Phone: 028 4375 1377 · Email: dundrum@mourneseafood.com.
   Local shellfish, day-boat landings, daily changing chalkboard menu. */

const phone = "028 4375 1377";
const phoneHref = "tel:+442843725770";
const email = "dundrum@mourneseafood.com";
const mailto = `mailto:${email}`;
const site = "https://www.mourneseafood.com/restaurants/dundrum/";
const menus = "https://www.mourneseafood.com/restaurants/dundrum/";
const maps =
  "https://www.google.com/maps/search/?api=1&query=10+Main+Street+Dundrum+BT33+0LU";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,500;0,7..72,600;0,7..72,700;1,7..72,500;1,7..72,600&family=Red+Hat+Text:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap";

const catchSpecialties = [
  {
    title: "Dundrum Bay Shellfish",
    origin: "Local Bay Beds",
    desc: "Plump mussels and native oysters grown in the pristine tidal waters of Dundrum Bay, steamed with cider, herbs, or served raw on ice.",
  },
  {
    title: "Day-Boat Whole Fish",
    origin: "Kilkeel & Ardglass Landings",
    desc: "Hake, lemon sole, John Dory, and monkfish delivered directly from South Down fishing ports each morning and pan-roasted with seaweed butter.",
  },
  {
    title: "Wednesday Night Lobster",
    origin: "June – September Season",
    desc: "Our annual summer celebration featuring whole and half Mourne lobsters, garlic butter, and hand-cut chips.",
  },
];

const weeklySittings = [
  {
    period: "Thursday – Saturday",
    hours: "Lunch & Evening Sittings",
    note: "Full à la carte and daily catch boards from 12:30pm.",
  },
  {
    period: "Sunday Afternoon",
    hours: "12:30 – 18:00",
    note: "Relaxed coastal Sunday dining for families and weekend visitors.",
  },
  {
    period: "Monday – Wednesday",
    hours: "Kitchen Resting",
    note: "Closed early week (excluding seasonal Wednesday Lobster Nights).",
  },
];
---

<ConceptLayout
  title={"Mourne Seafood Dundrum — independent concept"}
  slug="mourne-seafood-dundrum"
  bodyClass="concept-page concept-mourne-seafood-dundrum"
  lang="en-GB"
  businessName="Mourne Seafood Bar Dundrum"
  town="Dundrum"
  fontHref={fontHref}
  bannerNote="The catch board is a drawing."
>
  <div class="ms-strip">
    <span>10 Main Street, Dundrum · BT33 0LU · Head of Dundrum Bay</span>
    <span class="ms-strip-r">
      <a href={phoneHref}>{phone}</a>
    </span>
  </div>

  <header class="ms-header">
    <a class="ms-brand" href="/concepts/mourne-seafood-dundrum/">
      <span class="ms-brand-mark" aria-hidden="true">
        <CatchBoard compact />
      </span>
      <span class="ms-brand-text">
        <span class="ms-brand-name">Mourne Seafood</span>
        <span class="ms-brand-sub">Dundrum · Village Bar</span>
      </span>
    </a>
    <nav class="ms-nav" aria-label="Concept navigation">
      <a href="#catch">The Catch</a>
      <a href="#sittings">Opening Hours</a>
      <a href="#bay">The Bay</a>
      <a href="#booking">Reserve Table</a>
    </nav>
    <a class="ms-reserve-btn" href={phoneHref}>Call Dundrum</a>
  </header>

  <main class="ms-main">
    <section class="ms-hero" aria-labelledby="ms-name">
      <div class="ms-hero-copy">
        <span class="ms-kicker">Village Coastal Dining · Dundrum Bay</span>
        <h1 id="ms-name">Mourne Seafood Bar</h1>
        <p class="ms-place-tag">10 Main Street · Dundrum · BT33 0LU</p>
        <p class="ms-say">The morning tide and the boats decide our menu.</p>
        <p class="ms-lede">
          Located on Main Street where tidal Dundrum Bay meets the South Down coast.
          We cook fresh shellfish from our own local beds and day-boat catches landed at Kilkeel harbour,
          served in a relaxed, informal village dining room.
        </p>
        <div class="ms-hero-actions">
          <a class="ms-btn ms-btn--primary" href={phoneHref}>Call to Reserve {phone}</a>
          <a class="ms-btn ms-btn--outline" href={menus} rel="noopener noreferrer">View Current Menus</a>
        </div>
      </div>

      <div class="ms-hero-art">
        <CatchBoard />
      </div>
    </section>

    <section class="ms-catch-section" id="catch" aria-labelledby="ms-catch-title">
      <div class="ms-section-head">
        <span class="ms-kicker">Fresh Provenance</span>
        <h2 id="ms-catch-title">Daily Landings &amp; Local Shellfish</h2>
        <p class="ms-section-intro">
          Our blackboard is rewritten every day based on the catches brought into port by local fishing boats and shellfish farmers.
        </p>
      </div>

      <div class="ms-catch-grid">
        {catchSpecialties.map((item) => (
          <article class="ms-catch-card">
            <span class="ms-origin-tag">{item.origin}</span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ms-hours-section" id="sittings" aria-labelledby="ms-hours-title">
      <div class="ms-hours-wrapper">
        <div class="ms-section-head">
          <span class="ms-kicker ms-kicker--gold">Dining Times</span>
          <h2 id="ms-hours-title">When the Dundrum Doors Open</h2>
          <p class="ms-section-intro">
            We operate sittings Thursday through Sunday to align with boat landings and ensure peak freshness.
          </p>
        </div>

        <div class="ms-hours-grid">
          {weeklySittings.map((s) => (
            <div class="ms-hour-card">
              <span class="ms-hour-period">{s.period}</span>
              <h3>{s.hours}</h3>
              <p>{s.note}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="ms-bay-section" id="bay" aria-labelledby="ms-bay-title">
      <div class="ms-bay-card">
        <div class="ms-bay-info">
          <span class="ms-kicker">Coastal Terroir</span>
          <h2 id="ms-bay-title">At the Head of Dundrum Bay</h2>
          <p>
            Dundrum is the coastal home where our seafood journey began.
            Tucked between Murlough Nature Reserve and the Mournes, our village dining counter offers the pure flavour
            of South Down’s marine heritage.
          </p>
          <div class="ms-bay-actions" id="booking">
            <a class="ms-btn ms-btn--primary" href={phoneHref}>Call Dundrum {phone}</a>
            <a class="ms-btn ms-btn--outline" href={site} rel="noopener noreferrer">Visit mourneseafood.com</a>
          </div>
        </div>

        <address class="ms-address-box">
          <strong>Mourne Seafood Bar Dundrum</strong>
          <span>10 Main Street</span>
          <span>Dundrum, County Down</span>
          <span>BT33 0LU</span>
          <a class="ms-phone-link" href={phoneHref}>{phone}</a>
          <a class="ms-email-link" href={mailto}>{email}</a>
          <a class="ms-map-link" href={maps} rel="noopener noreferrer">View Location on Map</a>
        </address>
      </div>
    </section>
  </main>

  <footer class="ms-footer">
    <p class="ms-footer-name">Mourne Seafood Bar Dundrum</p>
    <p>10 Main Street, Dundrum · Village Coastal Dining &amp; Shellfish Counter</p>
  </footer>
</ConceptLayout>
