---
/** Bear Necessities — County Down as the route, with generated artwork as scenery. */
import GeneratedMapPlate from "../../_shell/GeneratedMapPlate.astro";

interface Props { headingId?: string; }
const { headingId } = Astro.props;
---

<GeneratedMapPlate
  id="bn-map"
  src="/media/maps/bear-necessities-circuit-generated.png"
  width={1536}
  height={1024}
  title="The summer circuit"
  desc="An indicative map of the Bear Necessities summer circuit in County Down: Newcastle as home, Downpatrick Racecourse inland to the north, Rathfriland to the north-west, Warrenpoint Town Square south on Carlingford Lough, the Mournes between Newcastle and Warrenpoint, and an unlocated private hall."
  headingId={headingId}
>
  <span class="bn-generated-map-label bn-generated-map-label--title">The summer circuit<small>the public days, then your hall</small><em>Wake the Giant · 1 August</em></span>
  <span class="bn-generated-map-label bn-generated-map-label--downpatrick">Downpatrick Racecourse<small>July</small></span>
  <span class="bn-generated-map-label bn-generated-map-label--rathfriland">Rathfriland<small>August</small></span>
  <span class="bn-generated-map-label bn-generated-map-label--warrenpoint">Warrenpoint Town Square<small>August</small></span>
  <span class="bn-generated-map-label bn-generated-map-label--newcastle">Newcastle<small>home</small></span>
  <span class="bn-generated-map-label bn-generated-map-label--hall">your hall</span>
  <span class="bn-generated-map-label bn-generated-map-label--mournes">the Mournes</span>
  <span class="bn-generated-map-label bn-generated-map-label--lough">CARLINGFORD LOUGH</span>

  <Fragment slot="caption">The public days from this summer's flyers — indicative, not a route planner. The private Saturdays come to you.</Fragment>
  <ul slot="key">
    <li><strong>Newcastle</strong><span>home</span></li>
    <li><strong>Downpatrick Racecourse</strong><span>July</span></li>
    <li><strong>Rathfriland</strong><span>August</span></li>
    <li><strong>Warrenpoint Town Square</strong><span>August</span></li>
    <li><strong>Your hall</strong><span>private Saturday · unlocated</span></li>
  </ul>
</GeneratedMapPlate>
