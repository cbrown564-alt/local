---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import SurveyClip from "./SurveyClip.astro";

/* Stile Glass — elevated architectural glazing & structural balustrade concept.
   108 Dundrum Road, Newcastle · BT33 0LN.
   Frameless balustrades, bespoke showers, BS 6180:2011 coastal glazing engineering.
   Sourced from stileglass.co.uk, Google Business, and architectural records. */

const phone = "028 4372 4944";
const phoneHref = "tel:+442843724944";
const email = "info@stileglass.co.uk";
const mailto = `mailto:${email}`;
const site = "http://www.stileglass.co.uk";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap";

const systems = [
  {
    code: "BAL-01",
    title: "Frameless Structural Balustrades",
    desc: "Recessed base channel and spigot-mounted structural glass balustrades for coastal balconies, rooftop terraces, and garden viewing decks.",
  },
  {
    code: "SHW-02",
    title: "Bespoke Frameless Shower Enclosures",
    desc: "Custom-cut 10mm toughened glass screens, walk-in wetroom panels, and minimal brushed stainless steel hinges tailored to exact room dimensions.",
  },
  {
    code: "PART-03",
    title: "Internal Glass Partitions & Doors",
    desc: "Acoustic glass dividers, architectural Crittall-style frames, and sliding glass door sets for modern open-plan residences.",
  },
  {
    code: "STR-04",
    title: "Walk-on Structural Glass & Rooflights",
    desc: "Multi-ply laminated toughened glass engineered for foot traffic, internal lightwells, and coastal rooflight installations.",
  },
];
---

<ConceptLayout
  title={"Stile Glass — Architectural Glazing & Frameless Balustrades, Newcastle"}
  slug="stile-glass"
  bodyClass="concept-page concept-stile"
  lang="en-GB"
  businessName="Stile Glass"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="Terrace photography and glass detail scenes are AI-generated illustrative visualisations of 108 Dundrum Road."
>
  <div class="sg-strip">
    <span>108 Dundrum Road, Newcastle · BT33 0LN · Architectural Glazing Specialists</span>
    <span class="sg-strip-r">BS 6180:2011 Compliant · <a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="sg-header">
    <a class="sg-brand" href="/concepts/stile-glass/">
      <span class="sg-brand-mark" aria-hidden="true">
        <SurveyClip compact />
      </span>
      <span class="sg-brand-text">
        <span class="sg-brand-name">Stile Glass</span>
        <span class="sg-brand-sub">108 Dundrum Road · Newcastle</span>
      </span>
    </a>
    <nav class="sg-nav" aria-label="Concept navigation">
      <a href="#systems">Glazing systems</a>
      <a href="#engineering">Coastal engineering</a>
      <a href="#standards">BS 6180 standards</a>
      <a href="#survey">Site survey</a>
    </nav>
    <a class="sg-call-nav" href={phoneHref}>Call: {phone}</a>
  </header>

  <main class="sg-main">
    <!-- Hero with atmospheric modern coastal architectural terrace photography plate -->
    <section class="sg-hero" aria-labelledby="sg-hero-title">
      <figure class="sg-hero-plate">
        <picture>
          <img
            src="/media/concepts/stile-glass/stile-glass-hero-terrace.jpg"
            alt="AI-generated illustrative view of modern coastal architectural terrace in Newcastle with frameless glass balustrades overlooking the sea"
            width="1920"
            height="1080"
            loading="eager"
          />
        </picture>
        <figcaption>Frameless structural balustrade overlooking the bay. AI-generated illustrative visualisation.</figcaption>
      </figure>

      <div class="sg-hero-veil" aria-hidden="true"></div>

      <div class="sg-hero-stage">
        <p class="sg-kicker">108 Dundrum Road · Newcastle, County Down</p>
        <h1 id="sg-hero-title">Stile Glass</h1>
        <p class="sg-hero-say">Frameless views over Newcastle Bay.</p>
        <p class="sg-hero-lede">
          Architectural glass balustrades, frameless shower enclosures, and bespoke structural glazing engineered for coastal wind-load and uninterrupted sightlines.
        </p>
        <div class="sg-hero-actions">
          <a class="sg-btn sg-btn--primary" href={phoneHref}>Book site survey: {phone}</a>
          <a class="sg-btn sg-btn--ghost" href="#systems">Architectural systems ↓</a>
        </div>
      </div>
    </section>

    <!-- Systems Grid -->
    <section class="sg-systems-section" id="systems" aria-labelledby="sg-sys-title">
      <div class="sg-section-header">
        <p class="sg-kicker sg-kicker--ice">Architectural systems</p>
        <h2 id="sg-sys-title">Engineered transparency for coastal living.</h2>
        <p class="sg-section-lead">Precision-manufactured glass systems tailored for high-end residential and commercial developments.</p>
      </div>

      <div class="sg-systems-grid">
        {systems.map((s) => (
          <article class="sg-system-card">
            <span class="sg-system-code">{s.code}</span>
            <h3 class="sg-system-title">{s.title}</h3>
            <p class="sg-system-desc">{s.desc}</p>
            <a class="sg-system-link" href={phoneHref}>Inquire regarding {s.title} →</a>
          </article>
        ))}
      </div>
    </section>

    <!-- Coastal Engineering & Marine Grade Fixings Feature Split -->
    <section class="sg-engineering-section" id="engineering" aria-labelledby="sg-eng-title">
      <div class="sg-eng-grid">
        <figure class="sg-eng-figure">
          <img
            src="/media/concepts/stile-glass/stile-glass-balustrade-spigot.jpg"
            alt="AI-generated illustrative macro detail of marine-grade stainless steel clamp fixing on granite coping holding laminated glass"
            width="1200"
            height="900"
            loading="lazy"
          />
          <figcaption>AISI 316 Marine-grade balustrade clamp. AI-generated illustrative visualisation.</figcaption>
        </figure>

        <div class="sg-eng-copy">
          <p class="sg-kicker sg-kicker--ice">Coastal durability</p>
          <h2 id="sg-eng-title">Engineered for Irish Sea exposure.</h2>
          <p class="sg-eng-lead">
            Coastal environments demand rigorous material standards. Marine salt spray and high Mourne wind loads require precision glass thicknesses and corrosion-resistant hardware.
          </p>
          <ul class="sg-eng-list" id="standards">
            <li>
              <strong>BS 6180:2011 Certified:</strong>
              <span>Full compliance with British Standards for barriers in and about buildings (0.74 kN/m to 1.5 kN/m line load).</span>
            </li>
            <li>
              <strong>AISI 316 Marine-Grade Stainless Steel:</strong>
              <span>Superior molybdenum content resisting pitting and crevice corrosion from coastal sea spray.</span>
            </li>
            <li>
              <strong>Toughened &amp; Laminated Safety Glass:</strong>
              <span>17.5mm and 21.5mm EVA/PVB interlayer laminates providing fail-safe structural integrity even under impact.</span>
            </li>
          </ul>
          <p class="sg-eng-cta">
            <a class="sg-btn sg-btn--primary" href={phoneHref}>Technical Consultation: {phone}</a>
          </p>
        </div>
      </div>
    </section>

    <!-- Specification Docket Section -->
    <section class="sg-docket-section" id="survey" aria-labelledby="sg-docket-title">
      <div class="sg-docket-wrap">
        <div class="sg-docket-copy">
          <p class="sg-kicker sg-kicker--ice">Architectural docket</p>
          <h2 id="sg-docket-title">Arrange a survey on Dundrum Road.</h2>
          <p class="sg-docket-lead">
            Bring your architectural plans or schedule an on-site structural measure across Newcastle and County Down.
          </p>
          <div class="sg-docket-card">
            <span class="sg-docket-seal">STRUCTURAL SPECIFICATION · 108 DUNDRUM ROAD</span>
            <strong>Direct Technical Line:</strong>
            <p>Telephone: <strong>028 4372 4944</strong><br />Email: <strong>info@stileglass.co.uk</strong></p>
            <div class="sg-docket-actions">
              <a class="sg-btn sg-btn--primary" href={phoneHref}>Call 028 4372 4944</a>
              <a class="sg-btn sg-btn--ghost" href={mailto}>Email info@stileglass.co.uk</a>
            </div>
          </div>
        </div>

        <figure class="sg-docket-figure">
          <SurveyClip />
          <figcaption>Stile Glass · 108 Dundrum Road, Newcastle.</figcaption>
        </figure>
      </div>
    </section>

    <!-- Footer -->
    <footer class="sg-footer">
      <div class="sg-footer-inner">
        <div class="sg-footer-brand">
          <SurveyClip compact />
          <strong class="sg-footer-name">Stile Glass</strong>
          <span>108 Dundrum Road · Newcastle · County Down · BT33 0LN</span>
        </div>
        <div class="sg-footer-hours">
          <strong>Architectural &amp; Structural Glazing</strong>
          <span>Technical Inquiries: <a href={phoneHref}>{phone}</a> · <a href={mailto}>{email}</a></span>
        </div>
        <div class="sg-footer-links">
          <a href={site} rel="noopener noreferrer">stileglass.co.uk</a>
          <a href={phoneHref}>Survey Booking: {phone}</a>
        </div>
      </div>
    </footer>
  </main>
</ConceptLayout>
