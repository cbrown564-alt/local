---
/* Drawn kiln ticket for 85 Central Promenade.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const ids = compact ? "cpm" : "cpt";
---

{compact ? (
  <svg
    class="cp-mark"
    width="46"
    height="46"
    viewBox="0 0 46 46"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="1.4" y="1.4" width="43.2" height="43.2" rx="3" fill="#f6ead8" stroke="#2a2624" stroke-width="1.6"/>
    <rect x="5" y="5" width="36" height="36" rx="1.4" fill="none" stroke="#c45c3e" stroke-width="0.7" opacity=".7"/>
    <circle cx="23" cy="9.6" r="2.1" fill="none" stroke="#2a2624" stroke-width="1.3"/>
    <text
      x="23"
      y="28"
      text-anchor="middle"
      fill="#2a2624"
      font-family="Bodoni Moda, Times New Roman, serif"
      font-size="16"
      font-weight="700"
    >85</text>
    <text
      x="23"
      y="37.5"
      text-anchor="middle"
      fill="#c45c3e"
      font-family="Figtree, Segoe UI, sans-serif"
      font-size="5.2"
      font-weight="700"
      letter-spacing="1.4"
    >KILN</text>
  </svg>
) : (
  <svg
    class="cp-ticket"
    viewBox="0 0 840 500"
    role="img"
    aria-label="Kiln ticket for The Clay Project at 85 Central Promenade, Newcastle: in-house porcelain"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id={`${ids}-sky`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#d9e8e6"/>
        <stop offset="0.42" stop-color="#e7f0ee"/>
        <stop offset="1" stop-color="#c5d6d3"/>
      </linearGradient>
      <linearGradient id={`${ids}-sea`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#7aa8a4"/>
        <stop offset="1" stop-color="#5d8a88"/>
      </linearGradient>
      <linearGradient id={`${ids}-paper`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fbf3e6"/>
        <stop offset="1" stop-color="#f0ddc4"/>
      </linearGradient>
      <linearGradient id={`${ids}-glaze`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#cfe4e0"/>
        <stop offset="1" stop-color="#7aa8a4"/>
      </linearGradient>
      <pattern id={`${ids}-perf`} width="14" height="14" patternUnits="userSpaceOnUse">
        <circle cx="7" cy="7" r="2.2" fill="#e4d2ba"/>
      </pattern>
    </defs>

    <rect width="840" height="500" fill={`url(#${ids}-sky)`}/>
    <rect x="0" y="318" width="840" height="182" fill={`url(#${ids}-sea)`}/>
    <rect x="0" y="312" width="840" height="8" fill="#cfe4e0" opacity=".55"/>
    <path d="M0 318c60-10 120-18 200-14 90 4 140 22 240 18 110-4 170-26 260-20 70 4 100 16 140 20v8H0Z" fill="#d7e8e4" opacity=".55"/>

    <!-- twine -->
    <path d="M420 18c0 18 0 36 0 54" stroke="#8a6a52" stroke-width="2.2" fill="none"/>
    <path d="M412 22c10 8 16 8 16 0" stroke="#8a6a52" stroke-width="1.6" fill="none"/>
    <circle cx="420" cy="18" r="5" fill="#c45c3e"/>
    <circle cx="420" cy="18" r="2.2" fill="#f6ead8"/>

    <!-- card -->
    <rect x="118" y="72" width="604" height="356" rx="10" fill="#c9b49a" opacity=".28"/>
    <rect x="110" y="64" width="604" height="356" rx="10" fill={`url(#${ids}-paper)`} stroke="#2a2624" stroke-width="1.8"/>

    <!-- stub -->
    <rect x="110" y="64" width="92" height="356" rx="10" fill="#f7ebdb"/>
    <rect x="186" y="64" width="16" height="356" fill={`url(#${ids}-perf)`}/>
    <rect x="194" y="64" width="8" height="356" fill={`url(#${ids}-paper)`}/>
    <text
      x="148"
      y="250"
      text-anchor="middle"
      fill="#c45c3e"
      font-family="Figtree, Segoe UI, sans-serif"
      font-size="18"
      font-weight="800"
      letter-spacing="6"
      transform="rotate(-90 148 250)"
    >KILN TICKET</text>

    <!-- punch -->
    <circle cx="420" cy="92" r="11" fill="#e7f0ee" stroke="#2a2624" stroke-width="1.6"/>
    <circle cx="420" cy="92" r="5.5" fill="none" stroke="#c45c3e" stroke-width="1"/>

    <text
      x="248"
      y="128"
      fill="#c45c3e"
      font-family="Figtree, Segoe UI, sans-serif"
      font-size="11"
      font-weight="700"
      letter-spacing="3.4"
    >THE CLAY PROJECT · NEWCASTLE</text>

    <text
      x="248"
      y="214"
      fill="#2a2624"
      font-family="Bodoni Moda, Times New Roman, serif"
      font-size="92"
      font-weight="700"
    >85</text>

    <text
      x="248"
      y="248"
      fill="#2a2624"
      font-family="Figtree, Segoe UI, sans-serif"
      font-size="16"
      font-weight="700"
      letter-spacing="2.2"
    >CENTRAL PROMENADE</text>

    <text
      x="248"
      y="274"
      fill="#5a534c"
      font-family="Figtree, Segoe UI, sans-serif"
      font-size="13"
      font-weight="500"
      letter-spacing="1.4"
    >NEWCASTLE · BT33 0HH</text>

    <!-- porcelain mug -->
    <g transform="translate(578 148)">
      <ellipse cx="46" cy="118" rx="38" ry="7" fill="#d8c4aa" opacity=".55"/>
      <path d="M18 28h56l-6 78c-2 18-18 28-22 28s-20-10-22-28Z" fill="#f6ead8" stroke="#2a2624" stroke-width="1.6"/>
      <ellipse cx="46" cy="28" rx="28" ry="8" fill={`url(#${ids}-glaze)`} stroke="#2a2624" stroke-width="1.4"/>
      <path d="M74 42c18 2 22 22 8 34-8 6-18 6-22 4" fill="none" stroke="#2a2624" stroke-width="1.6"/>
      <path d="M30 58h32" stroke="#7aa8a4" stroke-width="1.2" opacity=".7"/>
    </g>

    <!-- porcelain stamp -->
    <g transform="translate(248 304)">
      <circle cx="86" cy="40" r="36" fill="none" stroke="#c45c3e" stroke-width="1.5"/>
      <circle cx="86" cy="40" r="30" fill="none" stroke="#c45c3e" stroke-width="0.6" stroke-dasharray="2 3"/>
      <text
        x="86"
        y="36"
        text-anchor="middle"
        fill="#c45c3e"
        font-family="Figtree, Segoe UI, sans-serif"
        font-size="8"
        font-weight="800"
        letter-spacing="1.6"
      >IN-HOUSE</text>
      <text
        x="86"
        y="50"
        text-anchor="middle"
        fill="#c45c3e"
        font-family="Figtree, Segoe UI, sans-serif"
        font-size="8"
        font-weight="800"
        letter-spacing="1.2"
      >PORCELAIN</text>
    </g>

    <line x1="430" y1="318" x2="682" y2="318" stroke="#2a2624" stroke-width="0.7" opacity=".25"/>

    <text
      x="430"
      y="356"
      fill="#2a2624"
      font-family="Bodoni Moda, Times New Roman, serif"
      font-size="18"
      font-style="italic"
    >Overlooking the sea.</text>
    <text
      x="430"
      y="382"
      fill="#5a534c"
      font-family="Figtree, Segoe UI, sans-serif"
      font-size="12"
      font-weight="600"
      letter-spacing="0.8"
    >You leave with a piece.</text>
  </svg>
)}
