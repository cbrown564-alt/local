---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import KilnTicket from "./KilnTicket.astro";

/* The Clay Project — elevated seaside pottery studio & gallery concept.
   85 Central Promenade, Newcastle · County Down.
   In-house porcelain, artisan workshops, and seafront café shelf.
   Sourced from theclay-project.com, Google Business, and public records. */

const email = "hello@theclay-project.com";
const workshops = "https://www.theclay-project.com/workshops";
const site = "https://www.theclay-project.com";
const instagram = "https://www.instagram.com/theclay_project/";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;0,6..96,700;1,6..96,400;1,6..96,500&family=Figtree:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap";

const diary = [
  {
    date: "19 September",
    title: "Make a Mug",
    price: "£55",
    time: "10:00am – 12:30pm",
    detail: "Porcelain slab-building & handle sculpting. Glazed, fired, and ready to collect in 3 weeks.",
  },
  {
    date: "26 September",
    title: "Charcuterie Night (BYOB)",
    price: "£60",
    time: "6:30pm – 9:00pm",
    detail: "Evening session shaping and botanical underglazing a bespoke ceramic grazing board. Bring your own wine.",
  },
  {
    date: "13 October",
    title: "Pumpkin Patch Pottery",
    price: "£50",
    time: "Seasonal Studio Session",
    detail: "Hand-sculpting ceramic autumn pieces with textured clay and coastal glazes.",
  },
  {
    date: "07 November",
    title: "Autumn Flora Pressed Porcelain",
    price: "£55",
    time: "Seasonal Masterclass",
    detail: "Pressing wild local botanicals and Mourne flora directly into raw porcelain clay slabs.",
  },
];
---

<ConceptLayout
  title={"The Clay Project — Pottery Painting Café & Ceramics Studio, Newcastle"}
  slug="clay-project"
  bodyClass="concept-page concept-clay"
  lang="en-GB"
  businessName="The Clay Project"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="Studio photography and craft scenes are AI-generated illustrative visualisations of 85 Central Promenade."
>
  <div class="cp-strip">
    <span>85 Central Promenade, Newcastle · BT33 0HH · Overlooking the Irish Sea</span>
    <span class="cp-strip-r">Open Wednesday to Monday · <a href={`mailto:${email}`}>{email}</a></span>
  </div>

  <header class="cp-header">
    <a class="cp-brand" href="/concepts/clay-project/">
      <span class="cp-brand-mark" aria-hidden="true">
        <KilnTicket compact />
      </span>
      <span class="cp-brand-text">
        <span class="cp-brand-name">The Clay Project</span>
        <span class="cp-brand-sub">85 Central Promenade · Newcastle</span>
      </span>
    </a>
    <nav class="cp-nav" aria-label="Concept navigation">
      <a href="#workshops">Workshops</a>
      <a href="#porcelain">In-house porcelain</a>
      <a href="#spectrum">The kiln cycle</a>
      <a href="#studio">The studio</a>
    </nav>
    <a class="cp-book-nav" href={workshops} rel="noopener noreferrer">Reserve a seat</a>
  </header>

  <main class="cp-main">
    <!-- Hero with atmospheric seafront studio photographic plate -->
    <section class="cp-hero" aria-labelledby="cp-hero-title">
      <figure class="cp-hero-plate">
        <picture>
          <img
            src="/media/concepts/clay-project/clay-project-hero-studio.jpg"
            alt="AI-generated illustrative view inside The Clay Project studio overlooking the Irish Sea in Newcastle"
            width="1920"
            height="1080"
            loading="eager"
          />
        </picture>
        <figcaption>Morning sea-light at 85 Central Promenade. AI-generated illustrative visualisation.</figcaption>
      </figure>

      <div class="cp-hero-veil" aria-hidden="true"></div>

      <div class="cp-hero-stage">
        <p class="cp-kicker">85 Central Promenade · Newcastle, County Down</p>
        <h1 id="cp-hero-title">The Clay Project</h1>
        <p class="cp-hero-say">Overlooking the sea.</p>
        <p class="cp-hero-lede">
          A pottery painting café and ceramics studio on the promenade. We make the porcelain in-house. You leave with a piece.
        </p>
        <div class="cp-hero-actions">
          <a class="cp-btn cp-btn--primary" href="#workshops">Explore workshop diary</a>
          <a class="cp-btn cp-btn--ghost" href="#porcelain">Our porcelain craft ↓</a>
        </div>
      </div>
    </section>

    <!-- Essence & In-house Porcelain Section -->
    <section class="cp-provenance" id="porcelain" aria-labelledby="cp-prov-title">
      <div class="cp-prov-grid">
        <div class="cp-prov-copy">
          <p class="cp-kicker cp-kicker--terra">In-house porcelain</p>
          <h2 id="cp-prov-title">Made here on the promenade.</h2>
          <blockquote class="cp-quote">
            “We proudly make all our porcelain in-house and source everything as locally as possible.”
          </blockquote>
          <p class="cp-prov-body">
            Founded in late 2021 by local ceramicists <strong>Rebecca Killen &amp; Laureanne Kootstra</strong>, The Clay Project combines fine ceramic design with collaborative teaching.
          </p>
          <p class="cp-prov-body">
            We work alongside local potter <strong>Adrian McColgan</strong>, who throws and handcrafts the bespoke bisc ware for our painting workshops. No mass-produced blanks — every mug, platter, and bowl carries the tactile mark of County Down clay.
          </p>
        </div>

        <figure class="cp-prov-figure">
          <img
            src="/media/concepts/clay-project/clay-project-porcelain-wheel.jpg"
            alt="AI-generated close-up of ceramicist hands shaping porcelain on a potter's wheel"
            width="1200"
            height="900"
            loading="lazy"
          />
          <figcaption>Hand-throwing raw porcelain. AI-generated illustrative visualisation.</figcaption>
        </figure>
      </div>
    </section>

    <!-- The 4-Step Tactile Kiln Spectrum -->
    <section class="cp-spectrum-section" id="spectrum" aria-labelledby="cp-spec-title">
      <div class="cp-section-header">
        <p class="cp-kicker cp-kicker--terra">The craft cycle</p>
        <h2 id="cp-spec-title">From wet clay to 1200°C gloss.</h2>
        <p class="cp-section-lead">Every piece painted at 85 Central Promenade follows our traditional four-stage firing process.</p>
      </div>

      <ol class="cp-spectrum-grid">
        <li class="cp-step">
          <span class="cp-step-num">01</span>
          <h3 class="cp-step-title">Raw Clay &amp; Throwing</h3>
          <p class="cp-step-desc">High-grade porcelain and white stoneware clay shaped on the wheel or slab-rolled in our studio.</p>
        </li>
        <li class="cp-step">
          <span class="cp-step-num">02</span>
          <h3 class="cp-step-title">Adrian’s Bisc Ware</h3>
          <p class="cp-step-desc">First bisque firing to 1000°C. Porous, smooth, and ready on open timber shelves for your brush.</p>
        </li>
        <li class="cp-step">
          <span class="cp-step-num">03</span>
          <h3 class="cp-step-title">Painting &amp; Underglaze</h3>
          <p class="cp-step-desc">Paint with vibrant mineral pigments over coffee and bakes, or enjoy an evening BYOB session.</p>
        </li>
        <li class="cp-step">
          <span class="cp-step-num">04</span>
          <h3 class="cp-step-title">1200°C Kiln Firing</h3>
          <p class="cp-step-desc">Dipped in clear ceramic glaze and fired in our kiln. Dishwasher safe, food safe, ready in 3 weeks.</p>
        </li>
      </ol>
    </section>

    <!-- Workshop Diary & Evening Sessions -->
    <section class="cp-workshops-section" id="workshops" aria-labelledby="cp-workshops-title">
      <div class="cp-section-header">
        <p class="cp-kicker cp-kicker--terra">The 2026 diary</p>
        <h2 id="cp-workshops-title">Book a workshop seat.</h2>
        <p class="cp-section-lead">Direct booking via our official site. Spaces are limited per session to ensure hands-on tuition.</p>
      </div>

      <div class="cp-workshops-layout">
        <div class="cp-diary-list">
          {diary.map((item) => (
            <article class="cp-workshop-card">
              <div class="cp-card-meta">
                <time class="cp-card-date">{item.date}</time>
                <span class="cp-card-price">{item.price}</span>
              </div>
              <h3 class="cp-card-title">{item.title}</h3>
              <p class="cp-card-time">{item.time}</p>
              <p class="cp-card-detail">{item.detail}</p>
              <a class="cp-card-link" href={workshops} rel="noopener noreferrer">Reserve place on our site →</a>
            </article>
          ))}

          <div class="cp-walkin-banner">
            <div>
              <strong>Walk-in Pottery Painting &amp; Coffee</strong>
              <p>Open Wednesday to Monday. £5 studio fee plus your chosen ceramic piece. Coffee &amp; fresh bakes on the shelf.</p>
            </div>
          </div>
        </div>

        <figure class="cp-evening-figure">
          <img
            src="/media/concepts/clay-project/clay-project-evening-session.jpg"
            alt="AI-generated illustrative twilight ceramic workshop with guests painting platters by candlelight"
            width="1200"
            height="800"
            loading="lazy"
          />
          <figcaption>Evening Charcuterie &amp; BYOB sessions. AI-generated illustrative visualisation.</figcaption>
        </figure>
      </div>
    </section>

    <!-- The Kiln Ticket Signature Artefact -->
    <section class="cp-ticket-section" id="studio" aria-labelledby="cp-ticket-title">
      <div class="cp-ticket-wrap">
        <div class="cp-ticket-copy">
          <p class="cp-kicker cp-kicker--terra">Studio claim ticket</p>
          <h2 id="cp-ticket-title">The kiln ticket for 85.</h2>
          <p class="cp-ticket-lead">
            When you paint a piece with us, it receives an individual kiln firing docket. Three weeks later, collect your vitrified porcelain from the promenade.
          </p>
          <p>
            Planning a private hen party, birthday gathering, or team creative workshop? Write to us directly:
          </p>
          <p class="cp-ticket-cta">
            <a class="cp-btn cp-btn--primary" href={`mailto:${email}`}>Email {email}</a>
            <a class="cp-btn cp-btn--ghost" href={workshops} rel="noopener noreferrer">Live workshop diary →</a>
          </p>
        </div>

        <figure class="cp-ticket-figure">
          <KilnTicket />
          <figcaption>The Kiln Claim Ticket · 85 Central Promenade.</figcaption>
        </figure>
      </div>
    </section>

    <!-- Studio Address & Footer -->
    <footer class="cp-footer">
      <div class="cp-footer-inner">
        <div class="cp-footer-brand">
          <KilnTicket compact />
          <strong class="cp-footer-name">The Clay Project</strong>
          <span>85 Central Promenade · Newcastle · BT33 0HH</span>
        </div>
        <div class="cp-footer-hours">
          <strong>Open Wednesday to Monday</strong>
          <span>Studio &amp; Café hours · hello@theclay-project.com</span>
        </div>
        <div class="cp-footer-links">
          <a href={instagram} rel="noopener noreferrer">Instagram @theclay_project</a>
          <a href={workshops} rel="noopener noreferrer">Workshops</a>
          <a href={site} rel="noopener noreferrer">theclay-project.com</a>
        </div>
      </div>
    </footer>
  </main>
</ConceptLayout>
