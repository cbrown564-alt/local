---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

/* Speaks as the showroom at Unit 2, 63a Castlewellan Road.
   Distinct from 63. Ring, email, their contact page — no fake
   configurator, no second catalogue, no EssenceMedia.
   No Alan Kerr. No 2014 opening-year chrome. */
const phone = "028 4372 7676";
const phoneHref = "tel:+442843727676";
const email = "first4floorsni@gmail.com";
const mailto = `mailto:${email}`;
const site = "https://www.firstfloornewcastle.co.uk";
const contact = `${site}/contact`;
const caravanHref = `${site}/caravans-re-flooring`;
const fontHref =
  "https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Sora:wght@400;500;600;700&display=swap";
---

<ConceptLayout
  title={"First 4 Floors — independent concept"}
  slug="first-4-floors"
  bodyClass="concept-page concept-f4"
  lang="en-GB"
  businessName="First 4 Floors"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="Photography comprises illustrative visualisations of the trade showroom and fitting work for Unit 2, 63a Castlewellan Road."
>
  <div class="f4-top-strip">
    <div class="f4-top-inner">
      <span>Unit 2, 63a Castlewellan Road, Newcastle · BT33 0JX</span>
      <a class="f4-top-tel" href={phoneHref}>{phone}</a>
    </div>
  </div>

  <header class="f4-header">
    <div class="f4-header-inner">
      <a class="f4-brand" href="/concepts/first-4-floors/">
        <span class="f4-brand-name">First 4 Floors</span>
        <span class="f4-brand-sub">Showroom · Castlewellan Road</span>
      </a>
      <nav class="f4-nav" aria-label="Concept navigation">
        <a href="#showroom">Showroom</a>
        <a href="#ranges">Sample Ranges</a>
        <a href="#caravan">Caravan Fitting</a>
        <a href="#contact">Contact</a>
      </nav>
      <a class="f4-ring-btn" href={phoneHref}>Ring {phone}</a>
    </div>
  </header>

  <main class="f4-main">
    <section class="f4-hero" aria-labelledby="f4-title">
      <div class="f4-hero-intro">
        <p class="f4-kicker">Trade Showroom &amp; Installation · Newcastle</p>
        <h1 id="f4-title">Flooring specialists. Measured, supplied &amp; fitted.</h1>
        <p class="f4-hero-unit">Unit 2, 63a Castlewellan Road · BT33 0JX</p>
        <p class="f4-hero-lede">
          From full domestic installations to specialist touring caravan refits: carpet, vinyl,
          laminate and 100% waterproof LVT. Visit Unit 2 to inspect full rolls and sample boards in natural daylight.
        </p>
        <div class="f4-hero-actions">
          <a class="f4-btn-primary" href={phoneHref}>Ring {phone}</a>
          <a class="f4-btn-outline" href="#ranges">Explore sample book</a>
        </div>
      </div>

      <figure class="f4-hero-plate">
        <img
          src="/media/concepts/first-4-floors/first-4-floors-hero-showroom.jpg"
          alt="Illustrative view inside the First 4 Floors showroom at Unit 2, 63a Castlewellan Road: carpet rolls, tiered vinyl and laminate sample racks, and oak planks laid across the floor in morning daylight"
          width="1536"
          height="1024"
          loading="eager"
        />
        <figcaption>Showroom floor at Unit 2 · Display racks and full timber planks in morning light</figcaption>
      </figure>
    </section>

    <section class="f4-showroom-section" id="showroom" aria-labelledby="f4-showroom-title">
      <div class="f4-showroom-copy">
        <p class="f4-kicker">The Showroom</p>
        <h2 id="f4-showroom-title">Come and see what we have in store.</h2>
        <p class="f4-body-lead">
          If you are unsure about what to buy, our team can offer expert advice and make
          recommendations that will help you make an inspired choice.
        </p>
        <p>
          Visit the showroom at Unit 2 to see the samples in daylight — feel the pile, check the grain against the light,
          and compare underlay grades before installation.
        </p>

        <div class="f4-hours-card">
          <h3 class="f4-hours-title">Showroom Hours</h3>
          <p class="f4-hours-line">Monday–Friday 9:30–17:00 · Saturday 9:30–14:00 · Sunday closed</p>
        </div>
      </div>

      <figure class="f4-photo-card">
        <img
          src="/media/concepts/first-4-floors/first-4-floors-counter-samples.jpg"
          alt="Illustrative close-up of the First 4 Floors showroom counter with a fanned sample book of carpet, vinyl, laminate and LVT swatches beside a kraft docket pad"
          width="1200"
          height="900"
          loading="lazy"
        />
        <figcaption>The consultation counter at Unit 2 · Swatch books and trade measurement</figcaption>
      </figure>
    </section>

    <section class="f4-ranges-section" id="ranges" aria-labelledby="f4-ranges-title">
      <div class="f4-ranges-head">
        <p class="f4-kicker">Sample Book &amp; Materials</p>
        <h2 id="f4-ranges-title">SAMPLE BOOK: Vinyl, carpets, laminate, LVT waterproof.</h2>
        <p class="f4-ranges-sub">
          Supplied and professionally fitted from Unit 2. Ranges featured on our main catalogue at
          <a href={site} rel="noopener noreferrer">firstfloornewcastle.co.uk</a> include Cormar, Phloor, Lifestyle Floors, Regency, and Abingdon.
        </p>
      </div>

      <div class="f4-materials-grid">
        <article class="f4-mat-card">
          <div class="f4-mat-header">
            <span class="f4-mat-tag">Woven &amp; Tufted</span>
            <h3>Carpet</h3>
          </div>
          <p>Deep twist piles, stain-resistant polypropylene, and traditional wool blends suited for heavy domestic stairs and lounges.</p>
          <ul class="f4-mat-specs">
            <li>Heavy domestic wear</li>
            <li>Thermal acoustic underlays</li>
          </ul>
        </article>

        <article class="f4-mat-card">
          <div class="f4-mat-header">
            <span class="f4-mat-tag">Practical &amp; Resilient</span>
            <h3>Vinyl</h3>
          </div>
          <p>Cushioned sheet vinyl cut to room dimensions or contoured vehicle profiles. Seamless, slip-resistant, and hygienic.</p>
          <ul class="f4-mat-specs">
            <li>R10 slip rating</li>
            <li>Easy-clean surface</li>
          </ul>
        </article>

        <article class="f4-mat-card">
          <div class="f4-mat-header">
            <span class="f4-mat-tag">Precision Click</span>
            <h3>Laminate</h3>
          </div>
          <p>Realistic oak, ash and weathered timber finishes with scratch-resistant surface overlays and bevelled edges.</p>
          <ul class="f4-mat-specs">
            <li>AC4 commercial rating</li>
            <li>Click-lock installation</li>
          </ul>
        </article>

        <article class="f4-mat-card f4-mat-card--featured">
          <div class="f4-mat-header">
            <span class="f4-mat-tag f4-mat-tag--gold">Rigid Core</span>
            <h3>LVT WATERPROOF</h3>
          </div>
          <p>Luxury Vinyl Tile engineered with an impermeable limestone composite core for kitchens, bathrooms, and high-traffic hallways.</p>
          <ul class="f4-mat-specs">
            <li>100% waterproof guarantee</li>
            <li>Natural embossed texture</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="f4-caravan-section" id="caravan" aria-labelledby="f4-caravan-title">
      <figure class="f4-photo-card">
        <img
          src="/media/concepts/first-4-floors/first-4-floors-caravan-refloor.jpg"
          alt="Illustrative view inside a touring caravan mid re-floor: fresh neutral carpet and vinyl cut precisely around the curved interior and wheel-arch boxes, with a measuring tape and offcuts"
          width="1200"
          height="900"
          loading="lazy"
        />
        <figcaption>Precision caravan re-flooring · Fitted seamlessly to curved cabinetry and wheel arches</figcaption>
      </figure>

      <div class="f4-caravan-copy">
        <p class="f4-kicker">Specialist Trade Work</p>
        <h2 id="f4-caravan-title">All aspects of caravan flooring.</h2>
        <p class="f4-body-lead">
          Replacement in a van is awkward because the interior is a unique shape.
        </p>
        <p>
          We specialise in that work: durable carpets and vinyl cut specifically for the van, measured and templated from our showroom at Unit 2.
        </p>
        <p class="f4-handoff-line">
          Explore previous caravan refits on our site —
          <a href={caravanHref} rel="noopener noreferrer">firstfloornewcastle.co.uk/caravans-re-flooring</a>.
        </p>
      </div>
    </section>

    <section class="f4-docket" id="contact" aria-labelledby="f4-docket-title">
      <div class="f4-docket-content">
        <p class="f4-kicker">Measurement &amp; Quotation</p>
        <h2 id="f4-docket-title">Arrange a showroom consultation or on-site estimate.</h2>
        <p class="f4-docket-lede">
          Ring, write, or use the contact page. We measure, supply and fit — lounge, kitchen, or the caravan.
        </p>

        <div class="f4-contact-bar">
          <a class="f4-btn-primary" href={phoneHref}>Ring {phone}</a>
          <a class="f4-btn-outline" href={mailto}>{email}</a>
          <a class="f4-btn-text" href={contact} rel="noopener noreferrer">Online contact form →</a>
        </div>
      </div>

      <div class="f4-address-panel">
        <h3>First 4 Floors</h3>
        <p class="f4-address-lines">
          <span>Unit 2, 63a Castlewellan Road</span>
          <span>Newcastle, Co. Down</span>
          <span>BT33 0JX</span>
        </p>
        <p class="f4-address-links">
          <a href={phoneHref}>{phone}</a>
          <a href={mailto}>{email}</a>
          <a href={site} rel="noopener noreferrer">firstfloornewcastle.co.uk</a>
        </p>
      </div>
    </section>

    <footer class="f4-footer">
      <div class="f4-footer-inner">
        <p class="f4-footer-name">First 4 Floors · Newcastle</p>
        <p class="f4-footer-details">
          Unit 2, 63a Castlewellan Road, Newcastle · BT33 0JX ·
          <a href={phoneHref}>{phone}</a>
        </p>
      </div>
    </footer>
  </main>
</ConceptLayout>
