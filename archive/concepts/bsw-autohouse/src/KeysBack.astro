---
/* Drawn keys-back / job ticket for Unit 4 — road-ready moment.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

{compact ? (
  <svg
    class="bw-mark"
    width="44"
    height="44"
    viewBox="0 0 44 44"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <rect width="44" height="44" fill="#1a1f24"/>
    <circle cx="16" cy="22" r="7" stroke="#f0a030" stroke-width="2" fill="none"/>
    <circle cx="16" cy="22" r="2.5" fill="#f0a030"/>
    <path d="M22 22 H36 M36 22 V18 M36 22 V26 M30 22 V17" stroke="#f0a030" stroke-width="2"/>
  </svg>
) : (
  <svg
    class="bw-keysback"
    viewBox="0 0 960 560"
    role="img"
    aria-label="Drawn BSW Autohouse job ticket and keys for Unit 4 Castlewellan Road"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="bw-bench" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e8ecef"/>
        <stop offset="1" stop-color="#cfd6dc"/>
      </linearGradient>
    </defs>

    <rect width="960" height="560" fill="url(#bw-bench)"/>
    <rect x="0" y="420" width="960" height="140" fill="#3a424a"/>
    <rect x="0" y="420" width="960" height="8" fill="#f0a030"/>

    <!-- Job ticket -->
    <rect x="80" y="60" width="420" height="320" fill="#f7f5f0" stroke="#1a1f24" stroke-width="2"/>
    <rect x="80" y="60" width="420" height="56" fill="#1a1f24"/>
    <text x="290" y="96" text-anchor="middle" fill="#f7f5f0" font-family="Oswald, system-ui, sans-serif" font-size="26" font-weight="600" letter-spacing="3">BSW AUTOHOUSE</text>

    <text x="110" y="150" fill="#1a1f24" font-family="Source Sans 3, system-ui, sans-serif" font-size="14" font-weight="700" letter-spacing="1.5">JOB TICKET</text>
    <text x="110" y="185" fill="#3a424a" font-family="Source Sans 3, system-ui, sans-serif" font-size="16">Unit 4 · 63a Castlewellan Road</text>
    <text x="110" y="215" fill="#3a424a" font-family="Source Sans 3, system-ui, sans-serif" font-size="16">Newcastle · Co. Down</text>
    <line x1="110" y1="240" x2="460" y2="240" stroke="#d0d4d8" stroke-width="1.5"/>
    <text x="110" y="275" fill="#1a1f24" font-family="Source Sans 3, system-ui, sans-serif" font-size="15" font-weight="700">Service · MOT prep · Tyres</text>
    <text x="110" y="305" fill="#3a424a" font-family="Source Sans 3, system-ui, sans-serif" font-size="14">Half-hour billing · same-day where we can</text>
    <text x="110" y="345" fill="#1a1f24" font-family="Oswald, system-ui, sans-serif" font-size="20" letter-spacing="1">028 4372 7112</text>

    <!-- Keys -->
    <g transform="translate(620 160)">
      <circle cx="0" cy="40" r="48" fill="none" stroke="#1a1f24" stroke-width="6"/>
      <circle cx="0" cy="40" r="16" fill="#f0a030"/>
      <path d="M40 40 H160 M160 40 V18 M160 40 V62 M120 40 V12 M140 40 V68" stroke="#1a1f24" stroke-width="8" stroke-linecap="square"/>
      <text y="160" text-anchor="middle" fill="#1a1f24" font-family="Oswald, system-ui, sans-serif" font-size="18" letter-spacing="3">KEYS BACK</text>
      <text y="185" text-anchor="middle" fill="#5a626a" font-family="Source Sans 3, system-ui, sans-serif" font-size="13" font-weight="600">ROAD-READY</text>
    </g>
  </svg>
)}
