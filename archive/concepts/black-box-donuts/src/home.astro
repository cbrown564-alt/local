---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import OpenBlackBox from "./OpenBlackBox.astro";

/* Black Box Donuts — jar/product under the Mournes. Speak as the bakery.
   First-party blackboxdonuts.co.uk 15 Sep 2026. Product theatre (open box),
   not café counter. Email + Shopify handoff. No invented phone. No fake order
   widget beyond their ecom. Omit promenade retail (third-party only).
   Distinct Unit 18 from BSW Unit 4 on same estate. */
const email = "customercare@blackboxdonuts.co.uk";
const mailto = `mailto:${email}`;
const site = "https://blackboxdonuts.co.uk/";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Syne:wght@500;600;700;800&display=swap";

const moments = [
  {
    kicker: "The box",
    title: "Assurance in black.",
    body: "We took the black-box name for what it promises — open it and know what’s inside was made for you.",
  },
  {
    kicker: "Fresh",
    title: "Baked fresh daily.",
    body: "Made fresh, just for you — then packed for UK and Ireland delivery on the date you choose on our shop.",
  },
  {
    kicker: "Wholesale",
    title: "Boxes for your counter.",
    body: "Wholesale sits on our collections when you need stock for your own shelves — ask via customercare@.",
  },
];
---

<ConceptLayout
  title={"Black Box Donuts — independent concept"}
  slug="black-box-donuts"
  bodyClass="concept-page concept-black-box-donuts"
  lang="en-GB"
  businessName="Black Box Donuts"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The open black box is a drawing."
>
  <div class="bb-strip">
    <span>Unit 18, 63A Castlewellan Road, Newcastle · BT33 0JX</span>
    <span class="bb-strip-r">
      <a href={mailto}>{email}</a>
    </span>
  </div>

  <header class="bb-header">
    <a class="bb-brand" href="/concepts/black-box-donuts/">
      <span class="bb-brand-mark" aria-hidden="true">
        <OpenBlackBox compact />
      </span>
      <span class="bb-brand-text">
        <span class="bb-brand-name">Black Box Donuts</span>
        <span class="bb-brand-sub">Bakery · bottom of the Mournes</span>
      </span>
    </a>
    <nav class="bb-nav" aria-label="Concept navigation">
      <a href="#box">The box</a>
      <a href="#creed">Creed</a>
      <a href="#order">Order</a>
      <a href="#door">Bakery</a>
    </nav>
    <a class="bb-shop" href={site} rel="noopener noreferrer">Shop the box</a>
  </header>

  <main class="bb-main">
    <section class="bb-hero" id="box" aria-labelledby="bb-name">
      <div class="bb-mast">
        <p class="bb-kicker">Artisan · Boxed fresh</p>
        <h1 id="bb-name">Black Box Donuts</h1>
        <p class="bb-number">Unit 18 · 63A Castlewellan Road · Newcastle</p>
        <p class="bb-say">Open the black box — baked at the bottom of the Mournes.</p>
        <p class="bb-lede">
          Handcrafted donuts from Black Box Bakery Ltd under Slieve Donard’s
          shadow. Choose a delivery date on our shop, or write to customercare@
          — we do not invent a second till on this page.
        </p>
        <p class="bb-cta">
          <a class="bb-shop bb-shop--inline" href={site} rel="noopener noreferrer">blackboxdonuts.co.uk</a>
          <a class="bb-write" href={mailto}>Email customercare</a>
        </p>
      </div>

      <aside class="bb-unwrap" aria-label="Product creed">
        <p class="bb-unwrap-kicker">The unwrap</p>
        <p class="bb-unwrap-quote">
          “From the bottom of the Mournes.”
        </p>
        <p class="bb-unwrap-source">From our About page</p>
        <p class="bb-unwrap-note">
          Today’s flavours and partner boxes live on the shop — Celebrations,
          Nestlé, Kinder &amp; Biscoff and the rest as we list them.
        </p>
      </aside>
    </section>

    <section class="bb-creed" id="creed" aria-labelledby="bb-creed-title">
      <div class="bb-section-head">
        <p class="bb-kicker">Creed</p>
        <h2 id="bb-creed-title">Product theatre, not a café menu.</h2>
        <p class="bb-section-intro">
          The moment is the open box. Stock, delivery dates, and event pyramids
          stay on Shopify — this page holds the bakery creed and the Unit 18 door.
        </p>
      </div>
      <div class="bb-cards" role="list">
        {moments.map((item) => (
          <article class="bb-card" role="listitem">
            <p class="bb-card-kicker">{item.kicker}</p>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="bb-claim" aria-labelledby="bb-claim-title">
      <p class="bb-kicker bb-kicker--on-dark">Their claim</p>
      <h2 id="bb-claim-title">4.9 / 5 from 764 reviews — as printed on our home.</h2>
      <p>
        That score is our homepage claim, not an independent audit pasted here.
        Read the shop and the reviews where they live.
      </p>
    </section>

    <section class="bb-order" id="order" aria-labelledby="bb-order-title">
      <div class="bb-section-head">
        <p class="bb-kicker">Order</p>
        <h2 id="bb-order-title">Shop, then open.</h2>
        <p class="bb-section-intro">
          UK &amp; Ireland delivery with a date you pick on our site. Email us for
          wholesale or anything the cart cannot answer.
        </p>
      </div>
      <p class="bb-order-cta">
        <a class="bb-shop bb-shop--inline" href={site} rel="noopener noreferrer">Open the shop</a>
        <a class="bb-write" href={mailto}>{email}</a>
      </p>
    </section>

    <section class="bb-door" id="door" aria-labelledby="bb-door-title">
      <div class="bb-door-copy">
        <p class="bb-kicker">Bakery</p>
        <h2 id="bb-door-title">Unit 18, Castlewellan Road.</h2>
        <p class="bb-door-lede">
          Black Box Bakery Ltd at Unit 18, 63A Castlewellan Road, Newcastle
          BT33 0JX — same industrial estate as neighbours, different unit.
          We do not print a promenade retail door until our own site confirms one.
        </p>
        <p class="bb-artefact-cta">
          <a class="bb-shop bb-shop--inline" href={site} rel="noopener noreferrer">Shop</a>
          <a class="bb-write" href={mailto}>{email}</a>
        </p>
      </div>

      <figure class="bb-artefact">
        <OpenBlackBox />
        <figcaption>The open black box.</figcaption>
      </figure>

      <address class="bb-address">
        <strong>Black Box Donuts</strong>
        <span>Black Box Bakery Ltd</span>
        <span>Unit 18, 63A Castlewellan Road</span>
        <span>Newcastle</span>
        <span>County Down</span>
        <span>BT33 0JX</span>
        <a href={mailto}>{email}</a>
        <a href={site} rel="noopener noreferrer">blackboxdonuts.co.uk</a>
      </address>
    </section>
  </main>
</ConceptLayout>
