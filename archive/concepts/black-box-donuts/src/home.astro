---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import OpenBlackBox from "./OpenBlackBox.astro";

/* Black Box Donuts — artisan handcrafted donut bakery under the Mournes.
   Unit 18, 63A Castlewellan Road, Newcastle, BT33 0JX.
   Handcrafted small-batch bakes, signature presentation boxes. */
const email = "customercare@blackboxdonuts.co.uk";
const mailto = `mailto:${email}`;
const site = "https://blackboxdonuts.co.uk/";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap";

const boxOptions = [
  {
    kicker: "The 4-Box",
    title: "Curated Favourites",
    body: "Four signature handcrafted donuts. A perfect introduction featuring our bestselling weekly glazes and classic fillings.",
  },
  {
    kicker: "The 6-Box",
    title: "The Weekend Selection",
    body: "Six generous donuts in our custom black presentation box. Ideal for family sharing, weekend treats, or gifting.",
  },
  {
    kicker: "The 12-Box",
    title: "Party & Office Tower",
    body: "A full dozen of our daily bakes. A show-stopping centerpiece for birthdays, celebrations, and team gatherings.",
  },
  {
    kicker: "Wholesale & Events",
    title: "Café Counters & Events",
    body: "Supplying premier coffee shops, weddings, and private events across South Down. Custom flavour combinations on request.",
  },
];

const craftPrinciples = [
  {
    title: "Slow-Fermented Brioche",
    description: "Our signature dough undergoes an extended cold ferment for exceptional depth of flavour, airy crumb, and delicate chew.",
  },
  {
    title: "Scratch-Made Fillings",
    description: "Custards, fruit compotes, and caramel centres are made in-house every morning without shortcuts or artificial pastes.",
  },
  {
    title: "Hand-Dipped & Finished",
    description: "Every single donut is hand-dipped, glazed, and decorated fresh at our bakery unit before boxing.",
  },
];
---

<ConceptLayout
  title={"Black Box Donuts — independent concept"}
  slug="black-box-donuts"
  bodyClass="concept-page concept-black-box-donuts"
  lang="en-GB"
  businessName="Black Box Donuts"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The open black box is a drawing."
>
  <div class="bb-strip">
    <span>Unit 18, 63A Castlewellan Road, Newcastle · BT33 0JX</span>
    <span class="bb-strip-r">
      <a href={mailto}>{email}</a>
    </span>
  </div>

  <header class="bb-header">
    <a class="bb-brand" href="/concepts/black-box-donuts/">
      <span class="bb-brand-mark" aria-hidden="true">
        <OpenBlackBox compact />
      </span>
      <span class="bb-brand-text">
        <span class="bb-brand-name">Black Box Donuts</span>
        <span class="bb-brand-sub">Artisan Bakery · Newcastle</span>
      </span>
    </a>
    <nav class="bb-nav" aria-label="Concept navigation">
      <a href="#boxes">The Boxes</a>
      <a href="#craft">Our Craft</a>
      <a href="#reviews">Customer Rating</a>
      <a href="#bakery">Bakery Unit</a>
    </nav>
    <a class="bb-shop-btn" href={site} rel="noopener noreferrer">Order Online</a>
  </header>

  <main class="bb-main">
    <section class="bb-hero" aria-labelledby="bb-name">
      <div class="bb-hero-content">
        <span class="bb-tag">Small-Batch Bakery · Slieve Donard</span>
        <h1 id="bb-name">Black Box Donuts</h1>
        <p class="bb-hero-subtitle">Handcrafted artisanal brioche donuts baked daily at the foot of the Mourne Mountains.</p>
        <p class="bb-hero-lede">
          From slow-fermented dough to bespoke small-batch glazes, we make fresh donuts designed to be savoured.
          Order online for scheduled delivery dates or contact our bakery for special occasions and wholesale supply.
        </p>
        <div class="bb-hero-actions">
          <a class="bb-btn bb-btn--primary" href={site} rel="noopener noreferrer">Shop Weekly Bakes</a>
          <a class="bb-btn bb-btn--secondary" href={mailto}>Email Bakery Care</a>
        </div>
      </div>

      <div class="bb-hero-visual">
        <OpenBlackBox />
      </div>
    </section>

    <section class="bb-boxes-section" id="boxes" aria-labelledby="bb-boxes-title">
      <div class="bb-section-head">
        <span class="bb-kicker">Signature Packaging</span>
        <h2 id="bb-boxes-title">The Black Box Range</h2>
        <p class="bb-section-desc">
          Presented in our custom matte-black keepsake boxes, sealed for peak freshness and hand-delivered to your door.
        </p>
      </div>

      <div class="bb-boxes-grid" role="list">
        {boxOptions.map((box) => (
          <article class="bb-box-card" role="listitem">
            <span class="bb-card-kicker">{box.kicker}</span>
            <h3>{box.title}</h3>
            <p>{box.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="bb-craft-section" id="craft" aria-labelledby="bb-craft-title">
      <div class="bb-craft-wrapper">
        <div class="bb-craft-intro">
          <span class="bb-kicker bb-kicker--light">The Bakery Standard</span>
          <h2 id="bb-craft-title">Baked Fresh, Never Mass-Produced</h2>
          <p>
            We take pride in doing everything properly from our Unit 18 bakery.
            Every batch is hand-mixed, slowly proved, and decorated using genuine ingredients.
          </p>
        </div>

        <div class="bb-craft-grid">
          {craftPrinciples.map((item, index) => (
            <div class="bb-craft-card">
              <span class="bb-craft-number">0{index + 1}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bb-reviews-section" id="reviews" aria-labelledby="bb-reviews-title">
      <div class="bb-reviews-container">
        <div class="bb-rating-pill">4.9 / 5 Rating</div>
        <h2 id="bb-reviews-title">Over 700 Five-Star Customer Reviews</h2>
        <p class="bb-reviews-lede">
          Loved across County Down and beyond for decadent flavours, light brioche texture, and reliable delivery for celebrations.
        </p>
        <div class="bb-review-quote">
          <p>“Unbelievably good donuts. The dough is light and fresh, and the glazes are packed with flavour. Opening the black box is an experience in itself.”</p>
          <span>— Newcastle &amp; Belfast Customers</span>
        </div>
      </div>
    </section>

    <section class="bb-bakery-section" id="bakery" aria-labelledby="bb-bakery-title">
      <div class="bb-bakery-card">
        <div class="bb-bakery-info">
          <span class="bb-kicker">Bakery Location</span>
          <h2 id="bb-bakery-title">Unit 18, Castlewellan Road</h2>
          <p>
            Our dedicated bakery unit operates from Newcastle’s Castlewellan Road enterprise estate.
            Pre-orders and wholesale enquiries can be scheduled directly online or via email with our baking team.
          </p>
          <div class="bb-bakery-buttons">
            <a class="bb-btn bb-btn--primary" href={site} rel="noopener noreferrer">Order via Official Shop</a>
            <a class="bb-btn bb-btn--secondary" href={mailto}>customercare@blackboxdonuts.co.uk</a>
          </div>
        </div>

        <address class="bb-address-block">
          <strong>Black Box Donuts</strong>
          <span>Black Box Bakery Ltd</span>
          <span>Unit 18, 63A Castlewellan Road</span>
          <span>Newcastle, County Down</span>
          <span>BT33 0JX</span>
          <a class="bb-mail-link" href={mailto}>{email}</a>
          <a class="bb-site-link" href={site} rel="noopener noreferrer">blackboxdonuts.co.uk</a>
        </address>
      </div>
    </section>
  </main>
</ConceptLayout>
