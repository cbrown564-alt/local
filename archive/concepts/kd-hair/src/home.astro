---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import ChairCard from "./ChairCard.astro";

/* KD Hair Design — intimate neighbourhood salon at 16 Mourne Rise.
   Stylist: Kerry-Dawn.
   Phone: 07549 958 060 · Web: https://www.kdhair16.co.uk/
   Private one-on-one appointments, custom colouring, styling.
   No form elements. Ring or message to book. */
const phone = "07549 958 060";
const phoneHref = "tel:+447549958060";
const handoff = "https://www.kdhair16.co.uk/";
const maps = "https://www.google.com/maps/search/?api=1&query=16+Mourne+Rise+Newcastle+BT33+0HE";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap";

const salonServices = [
  {
    tag: "Cut & Finish",
    title: "Precision cuts & styling",
    body: "Tailored restyles, trims, texture work, and effortless finishes designed around your hair's natural movement and everyday routine.",
  },
  {
    tag: "Colour Artistry",
    title: "Bespoke balayage & gloss",
    body: "Custom lived-in blonde, multi-dimensional balayage, grey blending, and rich gloss treatments using gentle, nourishing salon formulas.",
  },
  {
    tag: "Highlights & Foils",
    title: "Full & half head illumination",
    body: "Fine baby-lights, face-framing brightness, and root melts blended seamlessly for a luminous, soft grow-out.",
  },
  {
    tag: "Care & Treatments",
    title: "Deep conditioning & blow dry",
    body: "Intensive restorative moisture masks, bond-building treatments, and bouncy styling for special occasions or weekend evenings.",
  },
];
---

<ConceptLayout
  title={"KD Hair Design — 16 Mourne Rise, Newcastle"}
  slug="kd-hair"
  bodyClass="concept-page concept-kd-hair"
  lang="en-GB"
  businessName="KD Hair Design"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="AI-generated illustrations imagine the salon and setting; they are not photographs of the business."
>
  <!-- Notice ribbon -->
  <div class="kd-notice-ribbon">
    <span class="kd-notice-geo">16 Mourne Rise, Newcastle · BT33 0HE</span>
    <a class="kd-notice-tel" href={phoneHref}>Appointments: {phone}</a>
  </div>

  <!-- Salon Header -->
  <header class="kd-salon-header">
    <div class="kd-header-inner">
      <a class="kd-brand" href="/concepts/kd-hair/">
        <span class="kd-brand-name">KD Hair Design</span>
        <span class="kd-brand-sub">16 Mourne Rise · Private Salon</span>
      </a>
      <nav class="kd-salon-nav" aria-label="Salon navigation">
        <a href="#services">Services</a>
        <a href="#consultation">The Chair</a>
        <a href="#studio">Studio Space</a>
        <a href="#book">Appointments</a>
      </nav>
      <a class="kd-header-call" href={phoneHref}>Ring {phone}</a>
    </div>
  </header>

  <main class="kd-studio-page">
    <!-- One-on-one Salon Hero -->
    <section class="kd-chair-hero" aria-labelledby="kd-salon-title">
      <div class="kd-hero-text">
        <p class="kd-kicker">Private Hair Studio · Mourne Rise</p>
        <h1 id="kd-salon-title" class="kd-hero-heading">Calm, personal hair styling in a quiet neighbourhood setting.</h1>
        <p class="kd-hero-lede">
          One-on-one appointments with Kerry-Dawn at 16 Mourne Rise. No noisy salon rush—just dedicated time,
          custom colour, and personal styling crafted around you.
        </p>
        <div class="kd-hero-actions">
          <a class="kd-btn-rose" href={phoneHref}>Ring or message: {phone}</a>
          <a class="kd-btn-soft" href="#book">Find 16 Mourne Rise</a>
        </div>
      </div>
      <figure class="kd-hero-frame">
        <img
          src="/media/concepts/kd-hair/kd-hair-hero-mourne-rise.jpg"
          alt="Quiet residential setting on Mourne Rise, Newcastle"
          width="1200"
          height="675"
          loading="eager"
        />
        <figcaption class="kd-frame-caption">16 Mourne Rise · Quiet residential salon in Newcastle</figcaption>
      </figure>
    </section>

    <!-- Services Grid -->
    <section class="kd-services-section" id="services" aria-labelledby="kd-services-heading">
      <div class="kd-services-header">
        <p class="kd-kicker">Salon Craft</p>
        <h2 id="kd-services-heading" class="kd-section-heading">Cuts, colour &amp; finishes.</h2>
        <p class="kd-services-lead">
          Individual consultations before every service to understand your hair type, lifestyle, and colour history.
        </p>
      </div>

      <div class="kd-services-grid">
        {salonServices.map((service) => (
          <article class="kd-service-card">
            <span class="kd-service-badge">{service.tag}</span>
            <h3 class="kd-service-title">{service.title}</h3>
            <p class="kd-service-desc">{service.body}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Consultation & ChairCard -->
    <section class="kd-consultation-section" id="consultation" aria-labelledby="kd-chair-title">
      <div class="kd-consultation-details">
        <p class="kd-kicker">The One-on-One Chair</p>
        <h2 id="kd-chair-title" class="kd-section-heading">Dedicated time for your hair.</h2>
        <p class="kd-consultation-lead">
          Without multiple clients competing for attention, every appointment gets full, uninterrupted care.
          From thorough root work to the final blow dry and home maintenance tips.
        </p>
        <div class="kd-perks-list">
          <div class="kd-perk-item">
            <span class="kd-perk-num">01</span>
            <div>
              <strong>In-Depth Colour Consultation</strong>
              <p>Tailored tone balancing and realistic maintenance advice.</p>
            </div>
          </div>
          <div class="kd-perk-item">
            <span class="kd-perk-num">02</span>
            <div>
              <strong>Calm Residential Setting</strong>
              <p>Peaceful surroundings at Mourne Rise with easy doorstep parking.</p>
            </div>
          </div>
          <div class="kd-perk-item">
            <span class="kd-perk-num">03</span>
            <div>
              <strong>Flexible Booking</strong>
              <p>Direct communication with Kerry-Dawn for morning and evening appointments.</p>
            </div>
          </div>
        </div>
        <div class="kd-consult-action">
          <a class="kd-btn-rose" href={phoneHref}>Ring to schedule: {phone}</a>
        </div>
      </div>
      <div class="kd-card-slot">
        <ChairCard headingId="kd-chair-title" />
      </div>
    </section>

    <!-- Studio Photography Showcase -->
    <section class="kd-studio-showcase" id="studio" aria-labelledby="kd-studio-heading">
      <div class="kd-studio-row">
        <figure class="kd-studio-photo">
          <img
            src="/media/concepts/kd-hair/kd-hair-salon-chair.jpg"
            alt="Private salon chair with styling mirror and gentle natural light"
            width="1200"
            height="800"
            loading="lazy"
          />
          <figcaption class="kd-frame-caption">The styling chair · Private, relaxed appointment space</figcaption>
        </figure>
        <div class="kd-studio-words">
          <p class="kd-kicker">Private Space</p>
          <h2 id="kd-studio-heading" class="kd-section-heading">Relaxed, unhurried styling.</h2>
          <p class="kd-studio-text">
            Designed to feel welcoming and serene. Enjoy a cup of tea while your colour develops in comfort,
            with good conversation and complete privacy.
          </p>
          <a class="kd-text-link" href={phoneHref}>Enquire about availability: {phone}</a>
        </div>
      </div>

      <div class="kd-studio-row kd-studio-row--reverse">
        <figure class="kd-studio-photo">
          <img
            src="/media/concepts/kd-hair/kd-hair-colour-swatches.jpg"
            alt="Salon colour charts and mixing bowls"
            width="1200"
            height="800"
            loading="lazy"
          />
          <figcaption class="kd-frame-caption">Colour palette · Rich tones and custom shades</figcaption>
        </figure>
        <div class="kd-studio-words">
          <p class="kd-kicker">Colour Range</p>
          <h3 class="kd-section-heading">Rich, lasting colour formulas.</h3>
          <p class="kd-studio-text">
            We use premium conditioning colours designed to protect hair texture while delivering brilliant shine
            and seamless grey coverage.
          </p>
          <a class="kd-text-link" href={handoff} rel="noopener noreferrer">
            Visit official site (kdhair16.co.uk) &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Booking & Contact Box -->
    <section class="kd-booking-section" id="book" aria-labelledby="kd-booking-heading">
      <div class="kd-booking-card">
        <div class="kd-booking-left">
          <p class="kd-kicker">Appointments</p>
          <h2 id="kd-booking-heading" class="kd-booking-title">Book your appointment.</h2>
          <p class="kd-booking-lead">
            Contact Kerry-Dawn directly by phone or text to check availability and arrange your visit.
          </p>
          <div class="kd-contact-buttons">
            <a class="kd-contact-button kd-contact-button--call" href={phoneHref}>
              <span class="kd-button-tag">Direct Line</span>
              <span class="kd-button-val">07549 958 060</span>
            </a>
            <a class="kd-contact-button" href={handoff} rel="noopener noreferrer">
              <span class="kd-button-tag">Salon Web</span>
              <span class="kd-button-val">kdhair16.co.uk &rarr;</span>
            </a>
            <a class="kd-contact-button" href={maps} rel="noopener noreferrer">
              <span class="kd-button-tag">Location</span>
              <span class="kd-button-val">Find on Google Maps &rarr;</span>
            </a>
          </div>
        </div>

        <address class="kd-salon-address">
          <span class="kd-addr-name">KD Hair Design</span>
          <span class="kd-addr-line">16 Mourne Rise</span>
          <span class="kd-addr-line">Newcastle, Co. Down</span>
          <span class="kd-addr-line">BT33 0HE</span>
          <span class="kd-addr-phone"><a href={phoneHref}>07549 958 060</a></span>
        </address>
      </div>
    </section>
  </main>
</ConceptLayout>
