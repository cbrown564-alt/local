---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

/* Thumbelina — jar: a toy you take home. Speak as the shop.
   Traditional toy shop on Railway Street. Not a party factory
   (Bear Necessities). Not the café at 2 (Railway Street).
   No standalone site. Instagram holds today. No form.
   Hours are Google-only — omit rather than date a clock; not re-confirmed 29 Aug 2026.
   Do not print a founding year. Duration counts disagree and move — Instagram keeps that line.
   Audrey named because Belfast Live (1 Apr 2023) and IG already do. */
const phone = "028 4372 7444";
const phoneHref = "tel:+442843727444";
const instagram = "https://www.instagram.com/thumbelinatoyshop/";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Lilita+One&family=Quicksand:wght@400;500;600;700&display=swap";
---

<ConceptLayout
  title={"Thumbelina — independent concept"}
  slug="thumbelina"
  bodyClass="concept-page concept-thumbelina"
  lang="en-GB"
  businessName="Thumbelina"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="AI-generated illustrations imagine the setting, spaces and products; they are not photographs of the business."
>
  <div class="tb-bunting">
    <span class="tb-bunting-geo">10A Railway Street, Newcastle · BT33 0AL</span>
    <a class="tb-bunting-ring" href={phoneHref}>{phone}</a>
  </div>

  <header class="tb-topbar">
    <div class="tb-topbar-in">
      <a class="tb-logo" href="/concepts/thumbelina/">
        <span class="tb-logo-word">Thumbelina</span>
        <span class="tb-logo-street">Toy shop · Railway Street</span>
      </a>
      <nav class="tb-links" aria-label="Concept navigation">
        <a href="#toys">On the Shelves</a>
        <a href="#audrey">Audrey</a>
        <a href="#visit">Find Us</a>
      </nav>
      <a class="tb-call-pill" href={phoneHref}>Ring the shop</a>
    </div>
  </header>

  <main class="tb-page">
    <section class="tb-window" aria-labelledby="tb-name">
      <div class="tb-window-copy">
        <p class="tb-hello">Traditional Toy Shop · Newcastle</p>
        <h1 id="tb-name">Thumbelina</h1>
        <p class="tb-tagline">A ballet dancer at the door.</p>
        <p class="tb-intro">
          Dolls, teddies, wooden toys, puzzles and dinosaurs. One-to-one
          advice at the counter. Walk in, or ring.
        </p>
        <div class="tb-window-links">
          <a class="tb-call" href={phoneHref}>Ring {phone}</a>
          <a class="tb-stroll" href="#visit">Come and visit</a>
        </div>
      </div>

      <figure class="tb-shopfront">
        <img
          src="/media/concepts/thumbelina/thumbelina-hero-shopfront.jpg"
          alt="Traditional toy shopfront at 10A Railway Street in Newcastle with warm window displays"
          width="1200"
          height="800"
          loading="eager"
        />
        <figcaption class="tb-shopfront-note">10A Railway Street · A traditional toy shop in Newcastle</figcaption>
      </figure>
    </section>

    <section class="tb-toys" id="toys" aria-labelledby="tb-toys-title">
      <figure class="tb-shelf">
        <img
          src="/media/concepts/thumbelina/thumbelina-counter-shelves.jpg"
          alt="Carefully curated shelves of traditional wooden toys, puzzles and soft teddies"
          width="1200"
          height="800"
          loading="lazy"
        />
        <figcaption class="tb-shelf-note">Shelves at the counter, chosen with care</figcaption>
      </figure>

      <div class="tb-toys-copy">
        <p class="tb-flag">On the shelves at 10A</p>
        <h2 id="tb-toys-title">A shop that is a wee bit different.</h2>
        <p class="tb-toys-text">
          Audrey behind the counter, and shelves full of proper toys —
          the kind you take home and keep.
        </p>
        <ul class="tb-toy-list">
          <li class="tb-toy">Dolls</li>
          <li class="tb-toy">Teddies</li>
          <li class="tb-toy">Wooden toys</li>
          <li class="tb-toy">Puzzles</li>
          <li class="tb-toy">Dinosaurs</li>
        </ul>
      </div>
    </section>

    <section class="tb-audrey" id="audrey" aria-labelledby="tb-audrey-title">
      <div class="tb-audrey-in">
        <p class="tb-flag">A wee bit different</p>
        <h2 id="tb-audrey-title">Audrey at the counter.</h2>
        <blockquote class="tb-bubble" cite="https://www.belfastlive.co.uk/news/meet-newcastle-shop-owners-adding-26608745">
          <p>
            “I wanted to have a shop that was a wee bit different, that I could talk and meet people and recommend toys to people and that’s exactly what I’ve done.”
          </p>
          <footer class="tb-bubble-from">— Audrey Byrne · April 2023</footer>
        </blockquote>
      </div>
    </section>

    <section class="tb-story" aria-labelledby="tb-story-title">
      <div class="tb-story-copy">
        <p class="tb-flag">One-to-one advice</p>
        <h2 id="tb-story-title">Tell Audrey the story.</h2>
        <p class="tb-story-text">
          You say who it is for, their age and what they love. We help you
          find the right toy to take home.
        </p>
      </div>

      <ol class="tb-steps">
        <li class="tb-step">
          <span class="tb-step-num">1</span>
          <div class="tb-step-body">
            <strong>You walk in</strong>
            <span class="tb-step-note">Warm greeting on Railway Street.</span>
          </div>
        </li>
        <li class="tb-step">
          <span class="tb-step-num">2</span>
          <div class="tb-step-body">
            <strong>Audrey finds the toy</strong>
            <span class="tb-step-note">Personal advice tailored to every child.</span>
          </div>
        </li>
        <li class="tb-step">
          <span class="tb-step-num">3</span>
          <div class="tb-step-body">
            <strong>You take it home</strong>
            <span class="tb-step-note">Something special to treasure.</span>
          </div>
        </li>
      </ol>
    </section>

    <section class="tb-today" aria-labelledby="tb-today-title">
      <div class="tb-today-copy">
        <p class="tb-flag">Fresh on the shelf</p>
        <h2 id="tb-today-title">What is in the window today.</h2>
        <p class="tb-today-text">
          New arrivals and old favourites are regularly shared on Instagram —
          have a look, then come and see them in person.
        </p>
        <a class="tb-ig" href={instagram} rel="noopener noreferrer">Follow @thumbelinatoyshop →</a>
      </div>

      <figure class="tb-peek">
        <img
          src="/media/concepts/thumbelina/thumbelina-window-display.jpg"
          alt="Entrance at 10A Railway Street with the beloved ballet dancer sign"
          width="1200"
          height="800"
          loading="lazy"
        />
        <figcaption class="tb-peek-note">The ballet dancer at 10A Railway Street</figcaption>
      </figure>
    </section>

    <section class="tb-visit" id="visit" aria-labelledby="tb-visit-title">
      <div class="tb-visit-in">
        <p class="tb-flag">The door</p>
        <h2 id="tb-visit-title">Come and find the dancer.</h2>
        <p class="tb-visit-text">
          The ballet dancer with flowers at her feet. Walk in whenever you
          are on Railway Street, or ring us ahead.
        </p>

        <a class="tb-ring" href={phoneHref}>
          <span class="tb-ring-label">Ring the shop</span>
          <span class="tb-ring-number">{phone}</span>
        </a>

        <address class="tb-where">
          <strong>Thumbelina</strong>
          <span>10A Railway Street</span>
          <span>Newcastle, Co. Down · BT33 0AL</span>
        </address>

        <a class="tb-visit-ig" href={instagram} rel="noopener noreferrer">Instagram · @thumbelinatoyshop</a>
      </div>
    </section>
  </main>
</ConceptLayout>
