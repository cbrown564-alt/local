---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

/* Thumbelina — jar: a toy you take home. Speak as the shop.
   Traditional toy shop on Railway Street. Not a party factory
   (Bear Necessities). Not the café at 2 (Railway Street).
   No standalone site. Instagram holds today. No form.
   Hours are Google-only — omit rather than date a clock; not re-confirmed 29 Aug 2026.
   Do not print a founding year. Duration counts disagree and move — Instagram keeps that line.
   Audrey named because Belfast Live (1 Apr 2023) and IG already do. */
const phone = "028 4372 7444";
const phoneHref = "tel:+442843727444";
const instagram = "https://www.instagram.com/thumbelinatoyshop/";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,500;0,6..96,700;0,6..96,800;1,6..96,500;1,6..96,600&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap";
---

<ConceptLayout
  title={"Thumbelina — independent concept"}
  slug="thumbelina"
  bodyClass="concept-page concept-thumbelina"
  lang="en-GB"
  businessName="Thumbelina"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="AI-generated illustrations imagine the setting, spaces and products; they are not photographs of the business."
>
  <div class="tb-strip">
    <span>10A Railway Street, Newcastle · BT33 0AL</span>
    <span class="tb-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="tb-header">
    <div class="tb-header-inner">
      <a class="tb-brand" href="/concepts/thumbelina/">
        <span class="tb-brand-name">Thumbelina</span>
        <span class="tb-brand-sub">10A Railway Street · Newcastle</span>
      </a>
      <nav class="tb-nav" aria-label="Concept navigation">
        <a href="#shop">The Shop</a>
        <a href="#counter">The Counter</a>
        <a href="#door">Visit Us</a>
      </nav>
      <a class="tb-walk-btn" href="#door">Walk in</a>
    </div>
  </header>

  <main class="tb-main">
    <section class="tb-hero" aria-labelledby="tb-name">
      <div class="tb-hero-copy">
        <p class="tb-kicker">Traditional Toy Shop · Railway Street</p>
        <h1 id="tb-name">Thumbelina</h1>
        <p class="tb-number">10A Railway Street · Newcastle</p>
        <p class="tb-say">A ballet dancer at the door.</p>
        <p class="tb-lede">
          Dolls, teddies, wooden toys, puzzles and dinosaurs. One-to-one
          advice at the counter. Walk in, or ring.
        </p>
        <div class="tb-hero-actions">
          <a class="tb-btn-primary" href="#door">Visit the Shop</a>
          <a class="tb-btn-secondary" href={phoneHref}>Ring {phone}</a>
        </div>
      </div>

      <figure class="tb-hero-theatre">
        <img
          src="/media/concepts/thumbelina/thumbelina-hero-shopfront.jpg"
          alt="Traditional toy shopfront at 10A Railway Street in Newcastle with warm window displays"
          width="1200"
          height="800"
          loading="eager"
        />
        <figcaption>10A Railway Street · A traditional toy shop in Newcastle</figcaption>
      </figure>
    </section>

    <section class="tb-section tb-section--shop" id="shop" aria-labelledby="tb-shop-title">
      <div class="tb-section-copy">
        <p class="tb-kicker">A Wee Bit Different</p>
        <h2 id="tb-shop-title">Traditional toys on Railway Street.</h2>
        <p class="tb-lead">
          Audrey behind the counter. Dolls, teddies, wooden toys, puzzles, dinosaurs and more.
        </p>
        <p>
          What is on the shelves today is regularly shared on Instagram.
        </p>
        <div class="tb-ig-box">
          <a href={instagram} rel="noopener noreferrer">Follow on Instagram · @thumbelinatoyshop →</a>
        </div>

        <blockquote class="tb-pull" cite="https://www.belfastlive.co.uk/news/meet-newcastle-shop-owners-adding-26608745">
          <p>
            "I wanted to have a shop that was a wee bit different, that I could talk and meet people and recommend toys to people and that’s exactly what I’ve done."
          </p>
          <footer>— Audrey Byrne</footer>
        </blockquote>
      </div>

      <figure class="tb-photo-card">
        <img
          src="/media/concepts/thumbelina/thumbelina-counter-shelves.jpg"
          alt="Carefully curated shelves of traditional wooden toys, puzzles and soft teddies"
          width="1200"
          height="800"
          loading="lazy"
        />
        <figcaption>Curated shelves · Quality toys chosen with care</figcaption>
      </figure>
    </section>

    <section class="tb-section tb-section--counter" id="counter" aria-labelledby="tb-counter-title">
      <figure class="tb-photo-card">
        <img
          src="/media/concepts/thumbelina/thumbelina-window-display.jpg"
          alt="Entrance at 10A Railway Street with the beloved ballet dancer sign"
          width="1200"
          height="800"
          loading="lazy"
        />
        <figcaption>The ballet dancer plaque at 10A Railway Street</figcaption>
      </figure>

      <div class="tb-section-copy">
        <p class="tb-kicker">One-to-One Advice</p>
        <h2 id="tb-counter-title">Tell Audrey the story.</h2>
        <p class="tb-lead">
          You say who it is for, their age and what they love. We help you find the right toy to take home.
        </p>
        <ol class="tb-beats">
          <li>
            <span class="tb-beat-num">01</span>
            <div class="tb-beat-body">
              <strong>You walk in</strong>
              <span>Warm greeting on Railway Street.</span>
            </div>
          </li>
          <li>
            <span class="tb-beat-num">02</span>
            <div class="tb-beat-body">
              <strong>Audrey finds the toy</strong>
              <span>Personal advice tailored to every child.</span>
            </div>
          </li>
          <li>
            <span class="tb-beat-num">03</span>
            <div class="tb-beat-body">
              <strong>You take it home</strong>
              <span>Something special to treasure.</span>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="tb-door-section" id="door" aria-labelledby="tb-door-title">
      <div class="tb-door-card">
        <p class="tb-kicker">The Door</p>
        <h2 id="tb-door-title">10A Railway Street.</h2>
        <p class="tb-door-desc">
          The ballet dancer with flowers at her feet. Walk in whenever you are on Railway Street, or ring us ahead.
        </p>

        <div class="tb-door-actions">
          <a class="tb-door-btn tb-door-btn--tel" href={phoneHref}>
            <span class="tb-door-label">Telephone</span>
            <span class="tb-door-val">{phone}</span>
          </a>
          <a class="tb-door-btn" href={instagram} rel="noopener noreferrer">
            <span class="tb-door-label">Instagram Updates</span>
            <span class="tb-door-val">@thumbelinatoyshop</span>
          </a>
        </div>

        <address class="tb-address">
          <strong>Thumbelina</strong>
          <span>10A Railway Street</span>
          <span>Newcastle, Co. Down · BT33 0AL</span>
        </address>
      </div>
    </section>
  </main>
</ConceptLayout>

