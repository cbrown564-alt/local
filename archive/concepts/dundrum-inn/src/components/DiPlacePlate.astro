---
import GeneratedMapPlate from "../../_shell/GeneratedMapPlate.astro";

interface Props { headingId?: string; }
const { headingId } = Astro.props;

const places = [
  { label: "The Dundrum Inn", note: "143–145 Main Street" },
  { label: "Dundrum Bay", note: "over the road" },
  { label: "Murlough Cottage", note: "down the lane · self-catering" },
] as const;
---

<GeneratedMapPlate
  id="di-place-map"
  src="/media/maps/dundrum-inn-place-generated.png"
  width={1672}
  height={941}
  title="The Dundrum Inn beside Dundrum Bay"
  desc="An indicative illustrated place relationship: the Dundrum Inn on Main Street, Dundrum Bay over the road and Murlough Cottage down the lane."
  headingId={headingId}
>
  <span class="mm-generated-map-label" style="--map-x:33%;--map-y:49%">The Dundrum Inn</span>
  <Fragment slot="caption">
    The bay is over the road and Murlough Cottage is down the lane. Indicative place artwork, not a route or survey.
  </Fragment>
  <ul slot="key">
    {places.map((place) => <li><strong>{place.label}</strong><span>{place.note}</span></li>)}
  </ul>
</GeneratedMapPlate>
