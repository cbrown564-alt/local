---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import DualBay from "./DualBay.astro";

/* Dacara Guesthouse — stay on South Promenade. Speak as the house.
   Victorian dual bays over Dundrum Bay; three ensuites incl. ground floor.
   Omit 2012 tariff. Not Conlyn / Arley / Hutt / Bonny's. Ring/email enquiry. */

const phone = "028 4372 6745";
const phoneHref = "tel:+442843726745";
const email = "info@dacaraguesthouse.com";
const mailto = `mailto:${email}`;
const site = "https://www.dacaraguesthouse.com/";
const maps =
  "https://www.google.com/maps/search/?api=1&query=47+South+Promenade+Newcastle+BT33+0EY";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Raleway:wght@400;500;600;700&display=swap";

const rooms = [
  {
    kicker: "Three ensuites",
    title: "Small house. Honest rooms.",
    body: "Three ensuite rooms — including a ground-floor option — with TV, Wi-Fi, hairdryer, trouser press, and tea and coffee.",
  },
  {
    kicker: "Breakfast",
    title: "Hearty Irish breakfasts.",
    body: "Start the day at the table before the bay — the creed of the house, not a menu PDF.",
  },
  {
    kicker: "Place",
    title: "Harbour light.",
    body: "Historic harbour area on South Promenade — about five minutes to the new promenade and town centre, with golf, Donard Park and Silent Valley named nearby.",
  },
];
---

<ConceptLayout
  title={"Dacara Guesthouse — independent concept"}
  slug="dacara"
  bodyClass="concept-page concept-dacara"
  lang="en-GB"
  businessName="Dacara Guesthouse"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The bay window is a drawing."
>
  <div class="dc-strip">
    <span>47 South Promenade, Newcastle · BT33 0EY · Harbour area</span>
    <span class="dc-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="dc-header">
    <a class="dc-brand" href="/concepts/dacara/">
      <span class="dc-brand-mark" aria-hidden="true">
        <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
          <rect width="44" height="44" fill="#1c2e3a"/>
          <path d="M4 30h36" stroke="#7aa0b4" stroke-width="1.2"/>
          <path d="M8 30 V16 Q14 10 22 10 Q30 10 36 16 V30" fill="none" stroke="#e8dcc8" stroke-width="1.6"/>
          <path d="M14 30 V18 Q18 14 22 14 Q26 14 30 18 V30" fill="#c9b8a0" opacity="0.35"/>
          <rect x="18" y="20" width="8" height="10" fill="#f0e6d6" stroke="#1c2e3a" stroke-width="0.8"/>
        </svg>
      </span>
      <span class="dc-brand-text">
        <span class="dc-brand-name">Dacara</span>
        <span class="dc-brand-sub">South Promenade · Guesthouse</span>
      </span>
    </a>
    <nav class="dc-nav" aria-label="Concept navigation">
      <a href="#bays">The bays</a>
      <a href="#rooms">Rooms</a>
      <a href="#enquire">Enquire</a>
      <a href="#door">Find us</a>
    </nav>
    <a class="dc-enquire" href={phoneHref}>Enquire</a>
  </header>

  <main class="dc-main">
    <section class="dc-hero" id="bays" aria-labelledby="dc-name">
      <div class="dc-hero-copy">
        <p class="dc-kicker">Victorian guesthouse · South Promenade</p>
        <h1 id="dc-name">Dacara</h1>
        <p class="dc-place">47 South Promenade · Harbour area · Dundrum Bay</p>
        <p class="dc-say">Wake to Dundrum Bay.</p>
        <p class="dc-lede">
          A striking Victorian building with dual bay windows offering
          undisturbed views across Dundrum Bay — three ensuites, including
          a ground-floor room, and a hearty Irish breakfast.
        </p>
        <p class="dc-cta">
          <a class="dc-enquire dc-enquire--inline" href={phoneHref}>Ring {phone}</a>
          <a class="dc-mail" href={mailto}>{email}</a>
        </p>
      </div>
      <div class="dc-hero-art">
        <DualBay headingId="dc-name" />
        <p class="dc-bay-cap">The dual bays on South Promenade.</p>
      </div>
    </section>

    <section class="dc-folio" id="rooms" aria-labelledby="dc-rooms-title">
      <p class="dc-folio-mark">Dacara · 47 South Promenade · Newcastle</p>
      <div class="dc-folio-head">
        <p class="dc-kicker">The house</p>
        <h2 id="dc-rooms-title">Sea light. Three rooms.</h2>
        <p>
          Small B&amp;B honesty — dual bays, harbour geography, breakfast as
          creed. Availability by phone or email, not a big-hotel engine.
        </p>
      </div>
      <div class="dc-columns">
        {rooms.map((item) => (
          <article class="dc-col">
            <p class="dc-mag-kicker">{item.kicker}</p>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="dc-ritual" id="enquire" aria-labelledby="dc-enquire-title">
      <div class="dc-ritual-copy">
        <p class="dc-kicker">Stay</p>
        <h2 id="dc-enquire-title">Ring or write for your dates.</h2>
        <p class="dc-ritual-lede">
          Tell us when you hope to wake to the bay. We answer on the phone
          and at info@ — then you arrive to the Victorian bays.
        </p>
        <ol class="dc-beats">
          <li>
            <span class="dc-beat-n">01</span>
            <span class="dc-beat-t">Ring or write</span>
          </li>
          <li>
            <span class="dc-beat-n">02</span>
            <span class="dc-beat-t">Share your dates</span>
          </li>
          <li>
            <span class="dc-beat-n">03</span>
            <span class="dc-beat-t">Arrive to the dual bays</span>
          </li>
        </ol>
        <p class="dc-cta">
          <a class="dc-enquire dc-enquire--inline" href={phoneHref}>{phone}</a>
          <a class="dc-mail" href={mailto}>{email}</a>
        </p>
      </div>
      <aside class="dc-peace">
        <p class="dc-peace-kicker">House note</p>
        <p>
          Peaceful and tranquil — superior service in a Victorian harbour
          house. Rates live with us on enquiry; we do not print an old tariff
          as current.
        </p>
      </aside>
    </section>

    <section class="dc-door" id="door" aria-labelledby="dc-door-title">
      <div class="dc-door-head">
        <p class="dc-kicker">Find us</p>
        <h2 id="dc-door-title">47 South Promenade.</h2>
        <p class="dc-door-lede">
          Harbour area, Newcastle — short walk to the new promenade and town.
          Near Royal County Down Golf, Donard Park and Silent Valley.
        </p>
      </div>
      <div class="dc-door-grid">
        <address class="dc-address">
          <strong>Dacara Guesthouse</strong>
          <span>47 South Promenade</span>
          <span>Newcastle, Co. Down</span>
          <span>BT33 0EY</span>
          <a href={phoneHref}>{phone}</a>
          <a href={mailto}>{email}</a>
          <a href={maps} rel="noopener noreferrer">Map</a>
        </address>
        <div class="dc-handoff">
          <h3>Guesthouse site</h3>
          <p>
            Rooms, location and the enquiry path live on dacaraguesthouse.com.
            Start there, or ring the house directly.
          </p>
          <a href={site} rel="noopener noreferrer">dacaraguesthouse.com</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="dc-footer">
    <p class="dc-footer-name">Dacara</p>
    <p>47 South Promenade, Newcastle · Victorian guesthouse · Dundrum Bay</p>
  </footer>
</ConceptLayout>
