---
/* Drawn street fascia and cup rail at 2 Railway Street.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
---

<svg
  class="rs-plate"
  viewBox="0 0 960 560"
  role="img"
  aria-label="Railway Street fascia over a shop window with cups hanging on a rail, number 2 on the door"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="rs-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e7efe8"/>
      <stop offset="1" stop-color="#d5e0d6"/>
    </linearGradient>
    <linearGradient id="rs-brick" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#c4a090"/>
      <stop offset="1" stop-color="#a98474"/>
    </linearGradient>
    <linearGradient id="rs-glass" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f7fbf8" stop-opacity="0.42"/>
      <stop offset="0.5" stop-color="#d7e4dc" stop-opacity="0.12"/>
      <stop offset="1" stop-color="#c5d4cc" stop-opacity="0.28"/>
    </linearGradient>
    <linearGradient id="rs-room" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f3e6d2"/>
      <stop offset="1" stop-color="#e4d0b4"/>
    </linearGradient>
    <pattern id="rs-bond" width="28" height="16" patternUnits="userSpaceOnUse">
      <rect width="28" height="16" fill="#b48b78"/>
      <rect y="7.4" width="28" height="1.2" fill="#9a7262"/>
      <rect x="13.4" width="1.2" height="16" fill="#9a7262"/>
    </pattern>
    <pattern id="rs-pave" width="48" height="18" patternUnits="userSpaceOnUse">
      <rect width="48" height="18" fill="#cfc3b0"/>
      <rect x="0" y="16" width="48" height="2" fill="#b9ad9a"/>
      <rect x="23" width="1" height="18" fill="#b9ad9a"/>
    </pattern>
  </defs>

  <rect width="960" height="560" fill="url(#rs-sky)"/>

  <!-- Upper storey -->
  <rect x="88" y="36" width="784" height="148" fill="url(#rs-brick)"/>
  <rect x="88" y="36" width="784" height="148" fill="url(#rs-bond)" opacity="0.55"/>
  <rect x="88" y="36" width="784" height="10" fill="#8f6d5e"/>

  <g fill="#efe4d2" stroke="#6d5348" stroke-width="2">
    <rect x="148" y="64" width="88" height="92"/>
    <rect x="292" y="64" width="88" height="92"/>
    <rect x="580" y="64" width="88" height="92"/>
    <rect x="724" y="64" width="88" height="92"/>
  </g>
  <g stroke="#6d5348" stroke-width="1.4">
    <path d="M192 64v92M148 110h88M336 64v92M292 110h88M624 64v92M580 110h88M768 64v92M724 110h88"/>
  </g>

  <!-- Enamel fascia -->
  <rect x="64" y="176" width="832" height="92" fill="#24362e"/>
  <rect x="64" y="176" width="832" height="6" fill="#c9a06a"/>
  <rect x="64" y="262" width="832" height="6" fill="#c9a06a"/>
  <text
    x="480"
    y="228"
    text-anchor="middle"
    fill="#f3ead8"
    font-family="Big Shoulders Display, Arial Narrow, sans-serif"
    font-size="52"
    font-weight="800"
    letter-spacing="10"
  >RAILWAY ST.</text>
  <text
    x="480"
    y="252"
    text-anchor="middle"
    fill="#c9a06a"
    font-family="Source Serif 4, Georgia, serif"
    font-size="13"
    font-weight="600"
    letter-spacing="5.5"
  >CAFÉ &amp; BREW BAR</text>

  <!-- Shop body -->
  <rect x="64" y="268" width="832" height="214" fill="#5c2e22"/>
  <rect x="80" y="284" width="628" height="182" fill="url(#rs-room)"/>

  <!-- Cup rail in the window -->
  <line x1="108" y1="318" x2="680" y2="318" stroke="#8a6a3c" stroke-width="5" stroke-linecap="round"/>
  <g fill="#8a6a3c">
    <circle cx="108" cy="318" r="4"/>
    <circle cx="680" cy="318" r="4"/>
  </g>

  <!-- Hanging cups -->
  <g fill="#f7f1e6" stroke="#5c2e22" stroke-width="1.6">
    <g transform="translate(148 326)">
      <path d="M8 8h22v6c0 12-4 22-11 22S8 26 8 14V8Z"/>
      <path d="M30 12c8 0 12 6 8 12-3 4-8 4-8 4" fill="none"/>
      <line x1="19" y1="0" x2="19" y2="8" stroke="#8a6a3c" stroke-width="1.8"/>
    </g>
    <g transform="translate(228 330)">
      <path d="M6 6h28v7c0 14-6 24-14 24S6 27 6 13V6Z"/>
      <path d="M34 11c9 1 13 8 8 14" fill="none"/>
      <line x1="20" y1="0" x2="20" y2="6" stroke="#8a6a3c" stroke-width="1.8"/>
    </g>
    <g transform="translate(318 324)">
      <path d="M8 8h20v5c0 11-4 20-10 20S8 24 8 13V8Z"/>
      <path d="M28 12c7 0 11 5 7 11" fill="none"/>
      <line x1="18" y1="0" x2="18" y2="8" stroke="#8a6a3c" stroke-width="1.8"/>
    </g>
    <g transform="translate(398 328)">
      <path d="M7 7h26v6c0 13-5 23-13 23S7 26 7 13V7Z"/>
      <path d="M33 12c9 0 12 7 7 13" fill="none"/>
      <line x1="20" y1="0" x2="20" y2="7" stroke="#8a6a3c" stroke-width="1.8"/>
    </g>
    <g transform="translate(488 326)">
      <path d="M8 8h22v6c0 12-4 21-11 21S8 26 8 14V8Z"/>
      <path d="M30 12c8 1 11 6 7 12" fill="none"/>
      <line x1="19" y1="0" x2="19" y2="8" stroke="#8a6a3c" stroke-width="1.8"/>
    </g>
    <g transform="translate(568 332)">
      <path d="M6 6h24v6c0 12-5 22-12 22S6 24 6 12V6Z"/>
      <path d="M30 11c8 0 11 6 7 12" fill="none"/>
      <line x1="18" y1="0" x2="18" y2="6" stroke="#8a6a3c" stroke-width="1.8"/>
    </g>
  </g>

  <!-- Counter hint -->
  <rect x="108" y="422" width="572" height="28" fill="#5c2e22"/>
  <rect x="108" y="422" width="572" height="6" fill="#c9a06a"/>

  <!-- Glass -->
  <rect x="80" y="284" width="628" height="182" fill="url(#rs-glass)"/>
  <path d="M96 292l54 168" stroke="#ffffff" stroke-opacity="0.32" stroke-width="10"/>
  <path d="M168 290l28 168" stroke="#ffffff" stroke-opacity="0.12" stroke-width="6"/>
  <rect x="80" y="284" width="628" height="182" fill="none" stroke="#1c1612" stroke-width="3"/>
  <line x1="394" y1="284" x2="394" y2="466" stroke="#1c1612" stroke-width="2"/>

  <!-- Door with 2 -->
  <rect x="728" y="284" width="148" height="198" fill="#efe4d2" stroke="#1c1612" stroke-width="3"/>
  <rect x="744" y="300" width="116" height="128" fill="#d7e4dc" stroke="#24362e" stroke-width="2"/>
  <text
    x="802"
    y="378"
    text-anchor="middle"
    fill="#24362e"
    font-family="Big Shoulders Display, Arial Narrow, sans-serif"
    font-size="64"
    font-weight="800"
  >2</text>
  <circle cx="860" cy="412" r="4" fill="#c9a06a"/>
  <rect x="744" y="436" width="116" height="30" fill="#5c2e22"/>

  <!-- Pavement -->
  <rect x="0" y="482" width="960" height="78" fill="url(#rs-pave)"/>
  <rect x="0" y="478" width="960" height="6" fill="#9a8e7a"/>
  <rect x="40" y="534" width="120" height="8" rx="1" fill="#8a6a3c" opacity="0.35"/>
</svg>
