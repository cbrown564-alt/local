---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

/* Bonny's Caravan Park — stay. Speak as the park.
   Kind: airy place-to-sleep (Hutt / Conlyn class), not brunch.
   Address: Tullybrannigan · Newcastle.
   Phones: cottage 07734 540500 via Visit Mourne.
   bonnys.net broken — do not link as shopfront.
   No Sunnyholme in the nameplate. No invented café. No fake booking calendar.
   Action: cottage phone / Visit Mourne / directory email. */
const cottagePhone = "07734 540500";
const cottagePhoneHref = "tel:+447734540500";
const cottageVisit =
  "https://www.visitmournegullionstrangford.com/accommodation/bonnys-cottage-p699161";
const email = "info@bonnys.net";
const mailto = `mailto:${email}`;
const fontHref =
  "https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,500;1,8..60,600&family=Nunito+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap";

const stock = [
  {
    name: "Static Pitches",
    line: "Holiday homes on the park body — ask for what is free this season.",
  },
  {
    name: "The Cottage",
    line: "Self-catering on the park. Visit Mourne lists 82 Tullybrannigan for the cottage.",
  },
  {
    name: "The Log Pod",
    line: "Alternative sleep on site. Ask for dates; directories say no pets in the pod.",
  },
];
---

<ConceptLayout
  title={"Bonny's Caravan Park — independent concept"}
  slug="bonnys"
  bodyClass="concept-page concept-bonnys"
  lang="en-GB"
  businessName="Bonny's Caravan Park"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="AI-generated illustrations imagine the setting, spaces and products; they are not photographs of the business."
>
  <div class="bn-strip">
    <span>Tullybrannigan · Newcastle · foot of the Mournes</span>
    <span class="bn-strip-r">
      <span>Cottage enquiry: </span>
      <a href={cottagePhoneHref}>{cottagePhone}</a>
    </span>
  </div>

  <header class="bn-header">
    <div class="bn-header-inner">
      <a class="bn-brand" href="/concepts/bonnys/">
        <span class="bn-brand-name">Bonny's</span>
        <span class="bn-brand-sub">Caravan Park · Newcastle</span>
      </a>
      <nav class="bn-nav" aria-label="Concept navigation">
        <a href="#park">The Park</a>
        <a href="#sleep">Accommodation</a>
        <a href="#dates">Ask for Dates</a>
      </nav>
      <a class="bn-ask-nav" href="#dates">Ask for dates</a>
    </div>
  </header>

  <main class="bn-main">
    <section class="bn-hero" aria-labelledby="bn-name">
      <div class="bn-hero-copy">
        <p class="bn-kicker">Caravan park · Newcastle</p>
        <h1 id="bn-name">Bonny's</h1>
        <p class="bn-number">Tullybrannigan · Newcastle</p>
        <p class="bn-say">Sleep under the Mournes.</p>
        <p class="bn-lede">
          A holiday home park at the foot of the mountains, with Dundrum Bay
          in the view. Static pitches, a cottage, and a log pod. Ask for dates.
        </p>
        <div class="bn-hero-actions">
          <a class="bn-btn-primary" href="#dates">Ask for Dates</a>
          <a class="bn-btn-secondary" href={cottagePhoneHref}>Cottage: {cottagePhone}</a>
        </div>
      </div>

      <figure class="bn-hero-theatre">
        <img
          src="/media/concepts/bonnys/bonnys-hero-tullybrannigan.jpg"
          alt="Bonny's Caravan Park at the foot of the Mournes looking out over Dundrum Bay"
          width="1200"
          height="800"
          loading="eager"
        />
        <figcaption>Tullybrannigan · Foot of the Mournes with Dundrum Bay in the view</figcaption>
      </figure>
    </section>

    <section class="bn-section" id="park" aria-labelledby="bn-park-title">
      <div class="bn-section-copy">
        <p class="bn-kicker">The Park</p>
        <h2 id="bn-park-title">A place to sleep, not a high street.</h2>
        <p class="bn-lead">
          Holiday homes on static pitches. Mountain paths right from the gate.
          Dundrum Bay resting below the ridge.
        </p>
        <p>
          We open with the season — directories usually say March into autumn.
          Shop and play areas run in holiday periods for guests on the park.
        </p>
        <blockquote class="bn-pull" cite="https://www.campingni.com/">
          <p>
            "I have been to many countries… but to me there is no place like the Mountains of Mourne."
          </p>
          <footer>— Geraldine Bonny</footer>
        </blockquote>
      </div>

      <figure class="bn-photo-card">
        <img
          src="/media/concepts/bonnys/bonnys-cottage-exterior.jpg"
          alt="Traditional self-catering cottage at Bonny's on Tullybrannigan Road"
          width="1200"
          height="800"
          loading="lazy"
        />
        <figcaption>Bonny's Cottage · Self-catering accommodation at 82 Tullybrannigan Road</figcaption>
      </figure>
    </section>

    <section class="bn-section bn-section--sleep" id="sleep" aria-labelledby="bn-stock-title">
      <figure class="bn-photo-card">
        <img
          src="/media/concepts/bonnys/bonnys-log-pod-meadow.jpg"
          alt="Cosy timber log pod situated in a peaceful meadow setting"
          width="1200"
          height="800"
          loading="lazy"
        />
        <figcaption>The Log Pod · Alternative comfortable shelter on the park grounds</figcaption>
      </figure>

      <div class="bn-section-copy">
        <p class="bn-kicker">What We Hold</p>
        <h2 id="bn-stock-title">Cottage, pod, and the park body.</h2>
        <p class="bn-lead">
          Named accommodation for nights away in the Mournes.
        </p>

        <ul class="bn-inventory">
          {stock.map((item) => (
            <li class="bn-inventory-item">
              <strong>{item.name}</strong>
              <span>{item.line}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="bn-dates-section" id="dates" aria-labelledby="bn-ask-title">
      <div class="bn-dates-card">
        <p class="bn-kicker">Plan Your Stay</p>
        <h2 id="bn-ask-title">Nights on Tullybrannigan.</h2>
        <p class="bn-dates-desc">
          Cottage nights, the log pod, or static pitches. Contact us directly to enquire about current season dates and availability.
        </p>

        <div class="bn-dates-actions">
          <a class="bn-dates-btn bn-dates-btn--tel" href={cottagePhoneHref}>
            <span class="bn-dates-label">Cottage Enquiry</span>
            <span class="bn-dates-val">{cottagePhone}</span>
          </a>
          <a class="bn-dates-btn" href={mailto}>
            <span class="bn-dates-label">Email Enquiries</span>
            <span class="bn-dates-val">{email}</span>
          </a>
          <a class="bn-dates-btn" href={cottageVisit} rel="noopener noreferrer">
            <span class="bn-dates-label">External Listing</span>
            <span class="bn-dates-val">Visit Mourne Guide →</span>
          </a>
        </div>

        <address class="bn-address">
          <strong>Bonny's Caravan Park</strong>
          <span>Tullybrannigan · Newcastle, Co. Down</span>
          <span>Foot of the Mournes · Overlooking Dundrum Bay</span>
        </address>
      </div>
    </section>
  </main>
</ConceptLayout>

