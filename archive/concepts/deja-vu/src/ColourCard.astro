---
/* Drawn colour / chair card for Deja Vu at 33 Central Promenade.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

{compact ? (
  <svg
    class="dv-mark"
    width="44"
    height="44"
    viewBox="0 0 44 44"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <rect width="44" height="44" rx="3" fill="#2a1f28"/>
    <rect x="8" y="10" width="28" height="24" rx="1.5" fill="#f6f0ea"/>
    <rect x="8" y="10" width="28" height="5" fill="#b8734a"/>
    <rect x="11" y="19" width="6" height="10" rx="0.5" fill="#c45c6a"/>
    <rect x="19" y="19" width="6" height="10" rx="0.5" fill="#8a6a4a"/>
    <rect x="27" y="19" width="6" height="10" rx="0.5" fill="#3d2a38"/>
  </svg>
) : (
  <svg
    class="dv-card-svg"
    viewBox="0 0 920 620"
    role="img"
    aria-label="Colour card for Deja Vu Hair Co. at 33 Central Promenade, Newcastle: cut, colour and care — ring 028 4372 2110"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="dv-desk" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ebe2d6"/>
        <stop offset="1" stop-color="#d8cbb8"/>
      </linearGradient>
      <linearGradient id="dv-sheet" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fffaf6"/>
        <stop offset="1" stop-color="#f3ebe3"/>
      </linearGradient>
      <linearGradient id="dv-band" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#b8734a"/>
        <stop offset="1" stop-color="#8a4a32"/>
      </linearGradient>
      <linearGradient id="dv-ink" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#3a2a34"/>
        <stop offset="1" stop-color="#2a1f28"/>
      </linearGradient>
    </defs>

    <!-- Salon desk -->
    <rect width="920" height="620" fill="url(#dv-desk)"/>
    <rect x="0" y="520" width="920" height="100" fill="#c4b4a0"/>
    <rect x="0" y="512" width="920" height="10" fill="#a89078"/>

    <!-- Soft window light -->
    <ellipse cx="760" cy="80" rx="180" ry="90" fill="#fff8f0" opacity="0.55"/>

    <!-- Colour card body -->
    <g transform="translate(110,48)">
      <rect x="8" y="12" width="680" height="460" rx="6" fill="#2a1f28" opacity="0.12"/>
      <rect width="680" height="460" rx="6" fill="url(#dv-sheet)" stroke="#c9b8a8" stroke-width="1.5"/>
      <rect width="680" height="58" rx="6" fill="url(#dv-band)"/>
      <rect y="48" width="680" height="12" fill="url(#dv-band)"/>

      <text
        x="340"
        y="38"
        text-anchor="middle"
        fill="#fffaf6"
        font-family="Instrument Serif, Georgia, serif"
        font-size="28"
        font-weight="600"
        letter-spacing="6"
      >DEJA VU</text>

      <text
        x="40"
        y="98"
        fill="#2a1f28"
        font-family="Outfit, Segoe UI, sans-serif"
        font-size="13"
        font-weight="700"
        letter-spacing="3.2"
      >COLOUR CARD · CHAIR AT 33</text>

      <text
        x="40"
        y="138"
        fill="#2a1f28"
        font-family="Instrument Serif, Georgia, serif"
        font-size="42"
        font-weight="600"
      >33 Central Promenade</text>

      <text
        x="40"
        y="168"
        fill="#6a5a58"
        font-family="Outfit, Segoe UI, sans-serif"
        font-size="16"
        font-weight="500"
        letter-spacing="1.5"
      >Newcastle · BT33 0AA · L’Oréal Professionnel</text>

      <!-- Swatches -->
      <g transform="translate(40,198)">
        <rect width="72" height="88" rx="3" fill="#c45c6a"/>
        <rect x="84" width="72" height="88" rx="3" fill="#8a6a4a"/>
        <rect x="168" width="72" height="88" rx="3" fill="#3d2a38"/>
        <rect x="252" width="72" height="88" rx="3" fill="#d4b896"/>
        <rect x="336" width="72" height="88" rx="3" fill="#5c4a42"/>
        <text x="0" y="112" fill="#6a5a58" font-family="Outfit, Segoe UI, sans-serif" font-size="11" letter-spacing="2">FORMULA SWATCHES</text>
      </g>

      <!-- Service chips -->
      <g transform="translate(40,340)">
        <rect width="120" height="36" rx="18" fill="url(#dv-ink)"/>
        <text x="60" y="23" text-anchor="middle" fill="#f6f0ea" font-family="Outfit, Segoe UI, sans-serif" font-size="13" font-weight="700" letter-spacing="1.5">CUT</text>
        <rect x="132" width="120" height="36" rx="18" fill="url(#dv-ink)"/>
        <text x="192" y="23" text-anchor="middle" fill="#f6f0ea" font-family="Outfit, Segoe UI, sans-serif" font-size="13" font-weight="700" letter-spacing="1.5">COLOUR</text>
        <rect x="264" width="120" height="36" rx="18" fill="url(#dv-ink)"/>
        <text x="324" y="23" text-anchor="middle" fill="#f6f0ea" font-family="Outfit, Segoe UI, sans-serif" font-size="13" font-weight="700" letter-spacing="1.5">CARE</text>
      </g>

      <text
        x="40"
        y="420"
        fill="#2a1f28"
        font-family="Outfit, Segoe UI, sans-serif"
        font-size="18"
        font-weight="700"
      >Ring to book · 028 4372 2110</text>

      <text
        x="40"
        y="448"
        fill="#6a5a58"
        font-family="Outfit, Segoe UI, sans-serif"
        font-size="13"
      >Deja Vu Hair Co. · Central Promenade, Newcastle</text>
    </g>

    <!-- Scissors rest -->
    <g transform="translate(780,420)" opacity="0.85">
      <ellipse cx="40" cy="70" rx="48" ry="12" fill="#2a1f28" opacity="0.12"/>
      <path d="M20 20 L60 55 M60 20 L20 55" stroke="#2a1f28" stroke-width="3.5" stroke-linecap="round"/>
      <circle cx="20" cy="16" r="10" fill="none" stroke="#b8734a" stroke-width="2.5"/>
      <circle cx="60" cy="16" r="10" fill="none" stroke="#b8734a" stroke-width="2.5"/>
    </g>
  </svg>
)}
