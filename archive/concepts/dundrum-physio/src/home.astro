---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import SessionCard from "./SessionCard.astro";

/* Dundrum Physiotherapy Clinic — relief practice.
   Owner: Marguerite Quinn, Chartered Physiotherapist.
   12 Parterre Crescent, Dundrum, Newcastle, BT33 0WJ.
   Phone: 028 4375 0848 · Handoff: https://www.dundrumphysio.co.uk/
   No contact forms. Ring to schedule. */
const phone = "028 4375 0848";
const phoneHref = "tel:+442843750848";
const handoff = "https://www.dundrumphysio.co.uk/";
const maps = "https://www.google.com/maps/search/?api=1&query=12+Parterre+Crescent+Dundrum+BT33+0WJ";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap";

const treatments = [
  {
    kicker: "Musculoskeletal & Spinal",
    title: "Back pain & sciatica",
    body: "Thorough assessment and evidence-based relief for lower back pain, sciatica, disc problems, neck tension, and postural strain.",
  },
  {
    kicker: "Sports Injuries",
    title: "Rehabilitation & return to sport",
    body: "From acute ligament tears and joint sprains to chronic tendon issues. Structured rehabilitation to restore stability, power, and movement.",
  },
  {
    kicker: "Post-Operative Recovery",
    title: "Joint replacement & surgery rehab",
    body: "Careful early mobilisation and progressive strengthening following hip, knee, or shoulder procedures.",
  },
  {
    kicker: "Specialist Techniques",
    title: "Manual therapy & Sarah Key method",
    body: "Hands-on joint mobilisation, acupuncture for pain relief, ultrasound therapy, and the Sarah Key spinal mobilisation technique.",
  },
];
---

<ConceptLayout
  title={"Dundrum Physio — Chartered Physiotherapy Clinic"}
  slug="dundrum-physio"
  bodyClass="concept-page concept-dundrum-physio"
  lang="en-GB"
  businessName="Dundrum Physio"
  town="Dundrum"
  fontHref={fontHref}
  bannerNote="AI-generated illustrations imagine the clinic and setting; they are not photographs of the business."
>
  <div class="dp-top-notice">
    <span class="dp-notice-loc">12 Parterre Crescent, Dundrum · BT33 0WJ</span>
    <a class="dp-notice-tel" href={phoneHref}>Appointments: {phone}</a>
  </div>

  <header class="dp-clinic-header">
    <div class="dp-header-frame">
      <a class="dp-practice-brand" href="/concepts/dundrum-physio/">
        <span class="dp-brand-title">Dundrum Physio</span>
        <span class="dp-brand-subtitle">Physiotherapy &amp; Sports Injury Clinic</span>
      </a>
      <nav class="dp-practice-nav" aria-label="Clinic navigation">
        <a href="#care">Treatments</a>
        <a href="#assessment">Initial Assessment</a>
        <a href="#clinic">The Clinic</a>
        <a href="#appointments">Contact</a>
      </nav>
      <a class="dp-header-cta" href={phoneHref}>Ring to book</a>
    </div>
  </header>

  <main class="dp-doc">
    <!-- Consultation Hero -->
    <section class="dp-hero-consult" aria-labelledby="dp-clinic-name">
      <div class="dp-hero-intro">
        <p class="dp-kicker-label">Chartered Physiotherapy · Dundrum</p>
        <h1 id="dp-clinic-name" class="dp-main-heading">Relief, recovery, and a clear treatment plan.</h1>
        <p class="dp-hero-lead">
          Chartered Physiotherapist Marguerite Quinn provides expert clinical assessment,
          hands-on treatment, and guided rehabilitation at 12 Parterre Crescent. No GP referral needed.
        </p>
        <div class="dp-hero-actions">
          <a class="dp-action-primary" href={phoneHref}>Ring {phone}</a>
          <a class="dp-action-secondary" href="#appointments">Clinic Location</a>
        </div>
      </div>
      <figure class="dp-hero-visual">
        <img
          src="/media/concepts/dundrum-physio/dundrum-physio-hero-parterre.jpg"
          alt="Clinic exterior on Parterre Crescent, Dundrum"
          width="1200"
          height="675"
          loading="eager"
        />
        <figcaption class="dp-visual-caption">12 Parterre Crescent, Dundrum · Ground floor clinic</figcaption>
      </figure>
    </section>

    <!-- Treatments Grid -->
    <section class="dp-treatment-section" id="care" aria-labelledby="dp-treatments-title">
      <div class="dp-section-intro">
        <p class="dp-kicker-label">Clinical Care</p>
        <h2 id="dp-treatments-title" class="dp-section-heading">Conditions we treat.</h2>
        <p class="dp-section-sub">
          Every session starts with listening, objective evaluation, and a transparent plan tailored to your goals.
        </p>
      </div>

      <div class="dp-treatment-grid">
        {treatments.map((t) => (
          <article class="dp-treatment-card">
            <p class="dp-treatment-tag">{t.kicker}</p>
            <h3 class="dp-treatment-heading">{t.title}</h3>
            <p class="dp-treatment-copy">{t.body}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Assessment Flow & Card -->
    <section class="dp-assessment-section" id="assessment" aria-labelledby="dp-assessment-heading">
      <div class="dp-assessment-summary">
        <p class="dp-kicker-label">First Appointment</p>
        <h2 id="dp-assessment-heading" class="dp-section-heading">Your initial hour.</h2>
        <p class="dp-assessment-lead">
          Your initial consultation is a full 60-minute session. We carry out an in-depth clinical history,
          biomechanical and joint examination, followed by immediate hands-on relief and your home exercise plan.
        </p>
        <ul class="dp-assessment-steps">
          <li>
            <strong class="dp-step-index">01</strong>
            <div>
              <h4 class="dp-step-title">Thorough Assessment</h4>
              <p class="dp-step-desc">Joint range, muscle testing, neural integrity, and functional movement.</p>
            </div>
          </li>
          <li>
            <strong class="dp-step-index">02</strong>
            <div>
              <h4 class="dp-step-title">Accurate Clinical Diagnosis</h4>
              <p class="dp-step-desc">Understanding the root mechanical cause, not just soothing symptoms.</p>
            </div>
          </li>
          <li>
            <strong class="dp-step-index">03</strong>
            <div>
              <h4 class="dp-step-title">Targeted Treatment</h4>
              <p class="dp-step-desc">Manual therapy, mobilisations, acupuncture or therapeutic ultrasound.</p>
            </div>
          </li>
        </ul>
        <div class="dp-assessment-cta">
          <a class="dp-action-primary" href={phoneHref}>Ring to schedule: {phone}</a>
        </div>
      </div>
      <div class="dp-assessment-artefact">
        <SessionCard headingId="dp-assessment-heading" />
      </div>
    </section>

    <!-- Clinic Environment & Practice Details -->
    <section class="dp-environment-section" id="clinic" aria-labelledby="dp-clinic-env-heading">
      <div class="dp-env-block">
        <figure class="dp-env-figure">
          <img
            src="/media/concepts/dundrum-physio/dundrum-physio-treatment-room.jpg"
            alt="Treatment room with clinical examination couch and quiet atmosphere"
            width="1200"
            height="800"
            loading="lazy"
          />
          <figcaption class="dp-visual-caption">Dedicated treatment room · Calm, private clinical space</figcaption>
        </figure>
        <div class="dp-env-text">
          <p class="dp-kicker-label">The Practice</p>
          <h2 id="dp-clinic-env-heading" class="dp-section-heading">A quiet, focused clinical setting.</h2>
          <p class="dp-env-copy">
            Private ground-floor premises in Dundrum designed for focused recovery. Ample quiet parking,
            accessible entry, and one-on-one attention with no rush between appointments.
          </p>
          <div class="dp-clinician-note">
            <strong>Marguerite Quinn</strong>
            <span>Chartered Physiotherapist (MCSP) with over 20 years clinical experience.</span>
          </div>
        </div>
      </div>

      <div class="dp-env-block dp-env-block--reverse">
        <figure class="dp-env-figure">
          <img
            src="/media/concepts/dundrum-physio/dundrum-physio-session-note.jpg"
            alt="Clinical clipboard and session note on desk"
            width="1200"
            height="800"
            loading="lazy"
          />
          <figcaption class="dp-visual-caption">Session notes · Individual recovery plans</figcaption>
        </figure>
        <div class="dp-env-text">
          <p class="dp-kicker-label">Continuity</p>
          <h3 class="dp-section-heading">Personalised rehabilitation.</h3>
          <p class="dp-env-copy">
            Progress is tracked at every step. You leave every appointment with clear understanding
            and straightforward exercises to accelerate healing between visits.
          </p>
          <a class="dp-portal-link" href={handoff} rel="noopener noreferrer">
            Visit official practice website (dundrumphysio.co.uk) &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Clinic Appointments & Location Card -->
    <section class="dp-booking-section" id="appointments" aria-labelledby="dp-booking-heading">
      <div class="dp-booking-box">
        <div class="dp-booking-details">
          <p class="dp-kicker-label">Appointments</p>
          <h2 id="dp-booking-heading" class="dp-booking-heading">Arrange your visit.</h2>
          <p class="dp-booking-lede">
            Appointments are scheduled by phone to discuss your symptoms and find a suitable time.
            Self-referrals and doctor referrals welcome.
          </p>
          <div class="dp-booking-contacts">
            <a class="dp-contact-row dp-contact-row--tel" href={phoneHref}>
              <span class="dp-contact-label">Telephone</span>
              <span class="dp-contact-val">028 4375 0848</span>
            </a>
            <a class="dp-contact-row" href={handoff} rel="noopener noreferrer">
              <span class="dp-contact-label">Online Information</span>
              <span class="dp-contact-val">dundrumphysio.co.uk &rarr;</span>
            </a>
            <a class="dp-contact-row" href={maps} rel="noopener noreferrer">
              <span class="dp-contact-label">Directions</span>
              <span class="dp-contact-val">View on Google Maps &rarr;</span>
            </a>
          </div>
        </div>
        <address class="dp-clinic-address">
          <span class="dp-addr-title">Dundrum Physiotherapy Clinic</span>
          <span class="dp-addr-line">12 Parterre Crescent</span>
          <span class="dp-addr-line">Dundrum, Newcastle</span>
          <span class="dp-addr-line">BT33 0WJ</span>
          <span class="dp-addr-tel"><a href={phoneHref}>028 4375 0848</a></span>
        </address>
      </div>
    </section>
  </main>
</ConceptLayout>
