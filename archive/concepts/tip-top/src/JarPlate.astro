---
/* Drawn plate: raspberry fascia, 131 on the glass, jars, scoop, bag.
   Honesty lives in bannerNote — caption stays guest voice. */
---

<svg
  class="tt-plate"
  viewBox="0 0 640 780"
  role="img"
  aria-label="Tip Top fascia over a window of jars at 131 Main Street, with a scoop and a paper bag on the counter"
  xmlns="http://www.google.com/2000/svg"
>
  <defs>
    <linearGradient id="tt-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f4ece4"/>
      <stop offset="1" stop-color="#e8ddd3"/>
    </linearGradient>
    <linearGradient id="tt-glass" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f7fcfb" stop-opacity="0.42"/>
      <stop offset="0.55" stop-color="#d5e8e4" stop-opacity="0.12"/>
      <stop offset="1" stop-color="#c5d9d4" stop-opacity="0.28"/>
    </linearGradient>
    <linearGradient id="tt-jar-glass" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.55"/>
      <stop offset="0.35" stop-color="#ffffff" stop-opacity="0.08"/>
      <stop offset="1" stop-color="#d7ece8" stop-opacity="0.22"/>
    </linearGradient>
    <linearGradient id="tt-wood" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#7a4a32"/>
      <stop offset="1" stop-color="#5a3222"/>
    </linearGradient>
  </defs>

  <rect width="640" height="780" fill="url(#tt-sky)"/>

  <!-- Pavement -->
  <rect x="0" y="708" width="640" height="72" fill="#d8cfc4"/>
  <rect x="0" y="708" width="640" height="8" fill="#c4b8aa"/>

  <!-- Shop body -->
  <rect x="48" y="86" width="544" height="622" fill="#f7f1ea" stroke="#8e1028" stroke-width="3"/>

  <!-- Fascia -->
  <rect x="48" y="86" width="544" height="118" fill="#c21d3a"/>
  <rect x="48" y="198" width="544" height="8" fill="#c4a046"/>
  <text
    x="320"
    y="142"
    text-anchor="middle"
    fill="#fbf6f1"
    font-family="Gloock, Georgia, serif"
    font-size="52"
    letter-spacing="2"
  >Tip Top</text>
  <text
    x="320"
    y="174"
    text-anchor="middle"
    fill="#f0d36a"
    font-family="Nunito Sans, Segoe UI, sans-serif"
    font-size="13"
    font-weight="800"
    letter-spacing="5.5"
  >EST 1937 · THE SWEET SHOP</text>

  <!-- Window recess -->
  <rect x="78" y="228" width="484" height="318" fill="#1c2a28"/>
  <rect x="90" y="240" width="460" height="294" fill="#f3f7f5"/>

  <!-- Shelves of jars -->
  <g>
    <rect x="104" y="338" width="432" height="8" fill="#7a4a32"/>
    <rect x="104" y="430" width="432" height="8" fill="#7a4a32"/>
    <!-- top row -->
    <ellipse cx="156" cy="312" rx="22" ry="28" fill="#c21d3a"/>
    <ellipse cx="214" cy="308" rx="20" ry="26" fill="#f0d36a"/>
    <ellipse cx="270" cy="314" rx="22" ry="28" fill="#7eb88a"/>
    <ellipse cx="328" cy="310" rx="21" ry="27" fill="#5c3a2e"/>
    <ellipse cx="384" cy="312" rx="20" ry="26" fill="#c21d3a"/>
    <ellipse cx="440" cy="308" rx="22" ry="28" fill="#e8a0b0"/>
    <ellipse cx="494" cy="314" rx="18" ry="24" fill="#f0d36a"/>
    <!-- lids -->
    <rect x="138" y="278" width="36" height="10" rx="2" fill="#c4a046"/>
    <rect x="198" y="276" width="32" height="10" rx="2" fill="#c4a046"/>
    <rect x="252" y="280" width="36" height="10" rx="2" fill="#c4a046"/>
    <rect x="310" y="277" width="36" height="10" rx="2" fill="#c4a046"/>
    <rect x="368" y="280" width="32" height="10" rx="2" fill="#c4a046"/>
    <rect x="422" y="274" width="36" height="10" rx="2" fill="#c4a046"/>
    <rect x="478" y="284" width="32" height="10" rx="2" fill="#c4a046"/>
    <!-- second row -->
    <ellipse cx="168" cy="404" rx="24" ry="30" fill="#f0d36a"/>
    <ellipse cx="232" cy="400" rx="22" ry="28" fill="#c21d3a"/>
    <ellipse cx="294" cy="406" rx="24" ry="30" fill="#7eb88a"/>
    <ellipse cx="360" cy="402" rx="22" ry="28" fill="#e8a0b0"/>
    <ellipse cx="424" cy="404" rx="24" ry="30" fill="#5c3a2e"/>
    <ellipse cx="488" cy="400" rx="20" ry="26" fill="#c21d3a"/>
    <rect x="148" y="368" width="40" height="10" rx="2" fill="#c4a046"/>
    <rect x="214" y="366" width="36" height="10" rx="2" fill="#c4a046"/>
    <rect x="274" y="370" width="40" height="10" rx="2" fill="#c4a046"/>
    <rect x="342" y="368" width="36" height="10" rx="2" fill="#c4a046"/>
    <rect x="404" y="368" width="40" height="10" rx="2" fill="#c4a046"/>
    <rect x="470" y="368" width="36" height="10" rx="2" fill="#c4a046"/>
  </g>

  <!-- Window glass -->
  <rect x="90" y="240" width="460" height="294" fill="url(#tt-glass)"/>
  <path d="M108 252l54 270" stroke="#ffffff" stroke-opacity="0.28" stroke-width="10"/>
  <path d="M178 248l28 274" stroke="#ffffff" stroke-opacity="0.12" stroke-width="5"/>

  <!-- Door with 131 -->
  <rect x="470" y="360" width="80" height="174" fill="#f7f1ea" stroke="#8e1028" stroke-width="2"/>
  <rect x="482" y="376" width="56" height="88" fill="#d7ece8" stroke="#8e1028" stroke-width="1.4"/>
  <text
    x="510"
    y="428"
    text-anchor="middle"
    fill="#8e1028"
    font-family="Gloock, Georgia, serif"
    font-size="22"
  >131</text>
  <circle cx="540" cy="500" r="4" fill="#c4a046"/>

  <!-- Counter -->
  <rect x="48" y="546" width="544" height="162" fill="url(#tt-wood)"/>
  <rect x="48" y="546" width="544" height="16" fill="#3f2418"/>
  <rect x="48" y="560" width="544" height="8" fill="#c4a046"/>

  <!-- Foreground jar -->
  <g transform="translate(168 572)">
    <ellipse cx="70" cy="118" rx="58" ry="12" fill="#3f2418" opacity="0.35"/>
    <path d="M24 48c0-6 8-12 46-12s46 6 46 12v52c0 18-16 28-46 28S24 118 24 100Z" fill="#c21d3a"/>
    <path d="M28 52c4 38 18 56 42 56s38-18 42-56" fill="none" stroke="#8e1028" stroke-width="2" opacity="0.35"/>
    <rect x="40" y="28" width="60" height="22" rx="4" fill="#c4a046"/>
    <rect x="46" y="22" width="48" height="10" rx="3" fill="#a88632"/>
    <rect x="30" y="48" width="80" height="86" fill="url(#tt-jar-glass)"/>
  </g>

  <!-- Scoop -->
  <g transform="translate(318 628)">
    <rect x="36" y="18" width="78" height="8" rx="3" fill="#b7b0a4"/>
    <ellipse cx="28" cy="22" rx="22" ry="14" fill="#cfc8bc" stroke="#8a8378" stroke-width="1.5"/>
    <ellipse cx="24" cy="20" rx="8" ry="5" fill="#c21d3a"/>
    <ellipse cx="34" cy="24" rx="6" ry="4" fill="#f0d36a"/>
  </g>

  <!-- Striped bag -->
  <g transform="translate(402 612)">
    <path d="M18 28l10-16h52l10 16v78H18Z" fill="#fbf6f1" stroke="#8e1028" stroke-width="2"/>
    <path d="M28 28v78M40 28v78M52 28v78M64 28v78M76 28v78" stroke="#c21d3a" stroke-width="3" opacity="0.55"/>
    <path d="M28 12c8 8 20 8 28 0" fill="none" stroke="#8e1028" stroke-width="2"/>
  </g>

  <!-- We Sweeten Life plate -->
  <g transform="translate(78 616)">
    <rect width="78" height="36" fill="#c4a046"/>
    <text
      x="39"
      y="15"
      text-anchor="middle"
      fill="#3f2418"
      font-family="Nunito Sans, Segoe UI, sans-serif"
      font-size="7"
      font-weight="800"
      letter-spacing="1.6"
    >WE SWEETEN</text>
    <text
      x="39"
      y="28"
      text-anchor="middle"
      fill="#3f2418"
      font-family="Nunito Sans, Segoe UI, sans-serif"
      font-size="11"
      font-weight="800"
      letter-spacing="1.4"
    >LIFE</text>
  </g>
</svg>
