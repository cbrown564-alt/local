---
/* Drawn fit ticket for 85 Main Street.
   Honesty lives in bannerNote — caption stays guest voice. */
interface Props {
  headingId?: string;
}
const { headingId = "mcf-ticket-title" } = Astro.props;
---

<figure class="mcf-ticket" aria-labelledby={headingId}>
  <svg
    class="mcf-ticket-svg"
    viewBox="0 0 420 560"
    role="img"
    aria-label="McCready's Footwear fit ticket for 85 Main Street, Newcastle, with lines for size, style, and polish"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern id="mcf-ticket-dots" width="8" height="8" patternUnits="userSpaceOnUse">
        <circle cx="1.2" cy="1.2" r="0.7" fill="#c4b8a8" opacity="0.45"/>
      </pattern>
      <filter id="mcf-ticket-soft" x="-8%" y="-8%" width="116%" height="116%">
        <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#3a2418" flood-opacity="0.16"/>
      </filter>
    </defs>

    <rect width="420" height="560" fill="#e8dfd2"/>
    <rect width="420" height="560" fill="url(#mcf-ticket-dots)"/>

    <!-- Brass clip -->
    <g transform="translate(188 18)">
      <rect x="8" y="0" width="28" height="52" rx="4" fill="#6e4420"/>
      <rect x="11" y="4" width="22" height="44" rx="3" fill="#c4a35a"/>
      <rect x="14" y="10" width="16" height="8" rx="1.5" fill="#e8d090" opacity="0.7"/>
      <circle cx="22" cy="40" r="3.5" fill="#5a3818"/>
    </g>

    <g filter="url(#mcf-ticket-soft)">
      <path
        d="M72 48h276c8 0 14 6 14 14v400c0 8-6 14-14 14H72c-8 0-14-6-14-14V62c0-8 6-14 14-14Z"
        fill="#faf6f0"
        stroke="#3a2418"
        stroke-width="1.6"
      />
      <path d="M70 118h280" stroke="#3a2418" stroke-width="1.2" stroke-dasharray="3 5" opacity="0.55"/>
      <circle cx="58" cy="200" r="10" fill="#e8dfd2"/>
      <circle cx="362" cy="200" r="10" fill="#e8dfd2"/>
      <circle cx="58" cy="320" r="10" fill="#e8dfd2"/>
      <circle cx="362" cy="320" r="10" fill="#e8dfd2"/>
    </g>

    <text x="210" y="78" text-anchor="middle" fill="#3a2418" font-family="Fraunces, Georgia, serif" font-size="22" font-weight="600">McCready's</text>
    <text x="210" y="100" text-anchor="middle" fill="#8a5a2b" font-family="DM Sans, Segoe UI, sans-serif" font-size="10" font-weight="700" letter-spacing="2.4">85 MAIN STREET · NEWCASTLE</text>

    <text x="92" y="148" fill="#8a5a2b" font-family="DM Sans, Segoe UI, sans-serif" font-size="9" font-weight="700" letter-spacing="1.8">FIT TICKET</text>
    <text x="328" y="148" text-anchor="end" fill="#3a2418" font-family="DM Sans, Segoe UI, sans-serif" font-size="12" font-weight="700">№ 85</text>

    <g font-family="DM Sans, Segoe UI, sans-serif" fill="#3a2418">
      <text x="92" y="188" font-size="11" font-weight="700" letter-spacing="1.2" fill="#8a5a2b">THE PAIR</text>
      <text x="92" y="214" font-size="15" font-weight="600">Size</text>
      <text x="328" y="214" text-anchor="end" font-size="13" fill="#6b5c52">fit</text>
      <line x1="92" y1="224" x2="328" y2="224" stroke="#d4c8b8" stroke-width="1"/>
      <text x="92" y="254" font-size="15" font-weight="600">Style</text>
      <text x="328" y="254" text-anchor="end" font-size="13" fill="#6b5c52">try on</text>
      <line x1="92" y1="264" x2="328" y2="264" stroke="#d4c8b8" stroke-width="1"/>
      <text x="92" y="294" font-size="15" font-weight="600">Leather</text>
      <text x="328" y="294" text-anchor="end" font-size="13" fill="#6b5c52">polish</text>
      <line x1="92" y1="304" x2="328" y2="304" stroke="#d4c8b8" stroke-width="1"/>
      <text x="92" y="338" font-size="11" font-weight="700" letter-spacing="1.2" fill="#8a5a2b">SINCE</text>
      <text x="92" y="364" font-size="15" font-weight="600">1936</text>
      <text x="328" y="364" text-anchor="end" font-size="13" fill="#6b5c52">Main St</text>
      <line x1="92" y1="374" x2="328" y2="374" stroke="#d4c8b8" stroke-width="1"/>
    </g>

    <g transform="translate(210 430)">
      <circle r="48" fill="none" stroke="#8a5a2b" stroke-width="1.4" opacity="0.85"/>
      <circle r="40" fill="none" stroke="#8a5a2b" stroke-width="0.8" stroke-dasharray="2 3" opacity="0.7"/>
      <!-- tiny shoe silhouette -->
      <path d="M-22 4c4-14 18-22 34-14 8 4 12 12 10 18-18 4-32 4-44-4Z" fill="none" stroke="#3a2418" stroke-width="1.8"/>
      <path d="M8 -6c6-2 12 2 14 8" fill="none" stroke="#3a2418" stroke-width="1.4"/>
      <text y="28" text-anchor="middle" fill="#3a2418" font-family="DM Sans, Segoe UI, sans-serif" font-size="7" font-weight="800" letter-spacing="1.6">BT33 0AE</text>
    </g>

    <text x="210" y="508" text-anchor="middle" fill="#6b5c52" font-family="DM Sans, Segoe UI, sans-serif" font-size="10" font-weight="600" letter-spacing="0.4">Walk in · Ring 028 4372 3491</text>
  </svg>
  <figcaption class="mcf-ticket-cap">The ticket at 85.</figcaption>
</figure>
