---
/* Kitchen table docket for 73 Main Street.
   Honesty lives in bannerNote — caption stays guest voice. */
interface Props {
  headingId?: string;
}
const { headingId = "gj-ticket-heading" } = Astro.props;
---

<figure class="gj-ticket-figure" aria-labelledby={headingId}>
  <svg
    class="gj-ticket-svg"
    viewBox="0 0 420 540"
    role="img"
    aria-label="Great Jones kitchen table ticket for 73 Main Street, Newcastle, showing small craft plates, seasonal mains, and bar pours"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern id="gj-grid" width="16" height="16" patternUnits="userSpaceOnUse">
        <line x1="0" y1="0" x2="16" y2="0" stroke="#d4a373" stroke-width="0.75" opacity="0.3"/>
        <line x1="0" y1="0" x2="0" y2="16" stroke="#d4a373" stroke-width="0.75" opacity="0.3"/>
      </pattern>
      <filter id="gj-shadow" x="-8%" y="-8%" width="116%" height="116%">
        <feDropShadow dx="0" dy="5" stdDeviation="7" flood-color="#2a1c14" flood-opacity="0.14"/>
      </filter>
    </defs>

    <rect width="420" height="540" fill="#f4ede2"/>
    <rect width="420" height="540" fill="url(#gj-grid)"/>

    <!-- Copper ticket clip -->
    <g transform="translate(182 16)">
      <rect x="0" y="0" width="56" height="40" rx="3" fill="#322016"/>
      <rect x="4" y="4" width="48" height="32" rx="2" fill="#c47a38"/>
      <circle cx="28" cy="18" r="4.5" fill="#f4ede2"/>
    </g>

    <!-- Table docket slip -->
    <g filter="url(#gj-shadow)">
      <rect x="54" y="42" width="312" height="458" rx="4" fill="#fffdf9" stroke="#322016" stroke-width="1.6"/>
      <line x1="54" y1="112" x2="366" y2="112" stroke="#e0cfbe" stroke-width="1.2"/>
    </g>

    <!-- Header info -->
    <text x="210" y="78" text-anchor="middle" fill="#2a1c14" font-family="'Literata', Georgia, serif" font-size="23" font-weight="700">Great Jones</text>
    <text x="210" y="98" text-anchor="middle" fill="#c47a38" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="9" font-weight="700" letter-spacing="2">73 MAIN STREET · CRAFT KITCHEN</text>

    <!-- Order items -->
    <g font-family="'Plus Jakarta Sans', system-ui, sans-serif" fill="#2a1c14">
      <text x="76" y="146" font-size="9.5" font-weight="700" letter-spacing="1.4" fill="#c47a38">SMALL PLATES</text>
      <text x="344" y="146" text-anchor="end" font-size="11" font-weight="600" fill="#7a6252">Table 07</text>

      <text x="76" y="174" font-size="14" font-weight="600">Salt &amp; Chilli Crispy Squid</text>
      <text x="344" y="174" text-anchor="end" font-size="12" fill="#7a6252">Lime aioli</text>
      <line x1="76" y1="186" x2="344" y2="186" stroke="#ebdccc" stroke-width="1"/>

      <text x="76" y="218" font-size="14" font-weight="600">Buttermilk Fried Chicken Wings</text>
      <text x="344" y="218" text-anchor="end" font-size="12" fill="#7a6252">Hot honey</text>
      <line x1="76" y1="230" x2="344" y2="230" stroke="#ebdccc" stroke-width="1"/>

      <text x="76" y="262" font-size="9.5" font-weight="700" letter-spacing="1.4" fill="#c47a38">KITCHEN MAINS</text>
      <text x="344" y="262" text-anchor="end" font-size="11" font-weight="600" fill="#7a6252">Fresh Catch</text>

      <text x="76" y="290" font-size="14" font-weight="600">Kilkeel Landed Fish &amp; Chips</text>
      <text x="344" y="290" text-anchor="end" font-size="12" fill="#7a6252">Crushed peas</text>
      <line x1="76" y1="302" x2="344" y2="302" stroke="#ebdccc" stroke-width="1"/>

      <text x="76" y="334" font-size="14" font-weight="600">Chargrilled Mourne Beef Burger</text>
      <text x="344" y="334" text-anchor="end" font-size="12" fill="#7a6252">Smoked cheddar</text>
      <line x1="76" y1="346" x2="344" y2="346" stroke="#ebdccc" stroke-width="1"/>

      <text x="76" y="378" font-size="14" font-weight="600">Warm Sticky Toffee Pudding</text>
      <text x="344" y="378" text-anchor="end" font-size="12" fill="#7a6252">Butterscotch</text>
      <line x1="76" y1="390" x2="344" y2="390" stroke="#ebdccc" stroke-width="1"/>
    </g>

    <!-- Table stamp -->
    <g transform="translate(210 435)">
      <circle r="36" fill="none" stroke="#c47a38" stroke-width="1.4" opacity="0.85"/>
      <circle r="30" fill="none" stroke="#322016" stroke-width="0.8" stroke-dasharray="2 2"/>
      <text y="-6" text-anchor="middle" fill="#2a1c14" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="7.5" font-weight="700" letter-spacing="1.2">MAIN STREET</text>
      <text y="8" text-anchor="middle" fill="#c47a38" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="8.5" font-weight="700">BT33 0AE</text>
      <text y="20" text-anchor="middle" fill="#7a6252" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="7" font-weight="600">NEWCASTLE</text>
    </g>

    <text x="210" y="488" text-anchor="middle" fill="#7a6252" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="10" font-weight="600">Walk in · Ring 028 4379 8275</text>
  </svg>
  <figcaption class="gj-ticket-caption">Kitchen table docket · 73 Main Street</figcaption>
</figure>
