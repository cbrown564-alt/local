---
interface Props {
  size?: number;
  class?: string;
}

const { size = 36, class: className = "" } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <!-- Outer classic roundel / seal with fine coastal border -->
  <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.8" stroke-dasharray="3 2" opacity="0.6" />
  <circle cx="24" cy="24" r="19" stroke="currentColor" stroke-width="1.2" />

  <!-- Mourne Mountain slope silhouette in upper half -->
  <path
    d="M8 29L17 19L24 26L33 15L40 29"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  />

  <!-- Mediterranean coastal wave lines below -->
  <path
    d="M11 33C14 31 17 31 20 33C23 35 26 35 29 33C32 31 35 31 38 33"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
  />
  <path
    d="M14 36C17 34.5 19 34.5 22 36C25 37.5 27 37.5 30 36C33 34.5 35 34.5 36 36"
    stroke="currentColor"
    stroke-width="1.1"
    stroke-linecap="round"
    opacity="0.7"
  />

  <!-- Warm sun over the mountain crest -->
  <circle cx="28" cy="12" r="3" fill="currentColor" />
  <path d="M28 6.5V8M33.5 12H32M22.5 12H24M31.9 8.1L30.8 9.2M24.1 8.1L25.2 9.2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />

  <!-- Elegant 'VV' Monogram in center hearth -->
  <path
    d="M18 21L21 28L24 21"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    d="M24 21L27 28L30 21"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
