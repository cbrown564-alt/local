---
/**
 * Villa Vinci — The Promenade Walk & Coastal Table Plate (Move 7).
 * "Promenade first, then the table. Since 2008, where the warmth of the Mediterranean
 * meets the charm of the Mourne Mountains."
 */

const walkSteps = [
  {
    num: "01",
    title: "The Coastal Stroll",
    line: "A walk along Newcastle's promenade or a day by the seaside, with Slieve Donard rising behind.",
    pin: "Central Promenade & South Beach",
  },
  {
    num: "02",
    title: "Step Off Main Street",
    line: "Turn into No. 31 — greeted by stone-baked aromas, garlic, and Mediterranean warmth.",
    pin: "31 Main Street Door",
  },
  {
    num: "03",
    title: "The Table",
    line: "Settle in for seaside lunch or dinner with family recipes and fresh local ingredients.",
    pin: "Dining Room & Terrace",
  },
  {
    num: "04",
    title: "Evening on the Water",
    line: "Finish with espresso or dessert, then step back onto the promenade for an evening stroll.",
    pin: "Dundrum Bay Shoreline",
  },
];
---

<div class="vv-plate-wrap">
  <div class="vv-plate-head">
    <span class="vv-plate-kicker">The Seaside Ritual · Since 2008</span>
    <h3 class="vv-plate-title">Promenade first, then the table.</h3>
    <p class="vv-plate-lead">
      Timed to a day at the seaside or an evening stroll along the Newcastle shore.
      From the promenade boards to the warmth of the room at 31 Main Street.
    </p>
  </div>

  <div class="vv-plate-layout">
    <!-- Visual schematic of the promenade approach -->
    <div class="vv-map-schematic" aria-hidden="true">
      <div class="vv-map-mountain">
        <span class="vv-map-mountain-tag">Slieve Donard · The Mournes</span>
      </div>
      <div class="vv-map-path">
        <span class="vv-path-step vv-path-step--1">1. Seaside Stroll</span>
        <span class="vv-path-connector"></span>
        <span class="vv-path-step vv-path-step--2">2. 31 Main Street Door</span>
        <span class="vv-path-connector"></span>
        <span class="vv-path-step vv-path-step--3">3. The Table</span>
        <span class="vv-path-connector"></span>
        <span class="vv-path-step vv-path-step--4">4. Dundrum Bay Shore</span>
      </div>
      <div class="vv-map-sea">
        <span class="vv-map-sea-tag">Irish Sea · Newcastle Shoreline</span>
      </div>
    </div>

    <!-- Walk steps sequence -->
    <div class="vv-walk-grid" role="list">
      {walkSteps.map((step) => (
        <article class="vv-walk-card" role="listitem">
          <div class="vv-walk-top">
            <span class="vv-walk-num">{step.num}</span>
            <span class="vv-walk-pin">{step.pin}</span>
          </div>
          <h4 class="vv-walk-title">{step.title}</h4>
          <p class="vv-walk-desc">{step.line}</p>
        </article>
      ))}
    </div>
  </div>
</div>
