---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

/* Chatterbox Day Nursery — none of the five. Nursery, not a café.
   Speak as the nursery. Organising principle (23 Aug 2026 brief): a place —
   phone / the form they already have. 75 Bryansford Road, Paul and Jane,
   the hours. Do not invent a nursery brand system or a fake tour app.
   Do not invent Instagram. No children’s photographs. Fees live on
   chatterboxkids.co.uk — do not scrape amounts onto this page.
   Re-read About + Contact 29 August 2026, Europe/London.
   Rebuilt 14 September 2026: nursery register — soft sky / leaf / butter,
   Quicksand + Lexend, day-path sessions and polaroid snaps, off the
   shared hospitality chassis. */
const phone = "028 4372 5805";
const phoneHref = "tel:+442843725805";
const email = "info@chatterboxkids.co.uk";
const mailto = `mailto:${email}`;
const contactPage = "https://chatterboxkids.co.uk/contact.php";
const feesPage = "https://chatterboxkids.co.uk/fees.html";
const site = "https://chatterboxkids.co.uk/";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Lexend:wght@400;500;600&display=swap";
---

<ConceptLayout
  title={"Chatterbox Day Nursery — independent concept"}
  slug="chatterbox"
  bodyClass="concept-page concept-chatterbox"
  lang="en-GB"
  businessName="Chatterbox Day Nursery"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="Photography comprises illustrative visualisations of 75 Bryansford Road."
>
  <header class="cbx-masthead">
    <a class="cbx-wordmark" href="/concepts/chatterbox/">
      <span class="cbx-wordmark-name">Chatterbox</span>
      <span class="cbx-wordmark-sub">Day Nursery · Newcastle</span>
    </a>
    <nav class="cbx-wayfinding" aria-label="Concept navigation">
      <a href="#day">The Day</a>
      <a href="#rooms">Rooms &amp; Garden</a>
      <a href="#paul-jane">Paul &amp; Jane</a>
      <a href="#say-hello">Say Hello</a>
    </nav>
    <a class="cbx-ring-bubble" href={phoneHref}>Ring {phone}</a>
  </header>

  <main class="cbx-page">
    <section class="cbx-doorstep" aria-labelledby="cbx-title">
      <p class="cbx-rubric">Day Nursery · Newcastle</p>
      <h1 id="cbx-title">Chatterbox</h1>
      <p class="cbx-doorstep-sub">Family-run since 2004.</p>
      <p class="cbx-doorstep-note">
        Care for children aged 0–12 years at 75 Bryansford Road, in the seaside town of
        Newcastle — close to the town library, primary schools, parks and the promenade.
      </p>
      <div class="cbx-doorstep-links">
        <a class="cbx-balloon" href={phoneHref}>Ring {phone}</a>
        <a class="cbx-balloon cbx-balloon--write" href={mailto}>{email}</a>
      </div>
    </section>

    <figure class="cbx-window">
      <img
        src="/media/concepts/chatterbox/chatterbox-hero-bryansford-road.jpg"
        alt="Illustrative photograph of 75 Bryansford Road in Newcastle County Down with a welcoming painted front door and garden path"
        width="1376"
        height="768"
        loading="eager"
      />
      <figcaption class="cbx-window-caption">
        The garden path up to our door at 75 Bryansford Road, Newcastle · BT33 0LE.
      </figcaption>
    </figure>

    <section class="cbx-daypath" id="day" aria-labelledby="cbx-day-title">
      <div class="cbx-daypath-intro">
        <p class="cbx-rubric">Sessions</p>
        <h2 id="cbx-day-title">A day at Chatterbox</h2>
        <span class="cbx-daypath-badge">MON–FRI</span>
      </div>
      <ol class="cbx-daysteps">
        <li class="cbx-daystone">
          <span class="cbx-stone-time">07.30</span>
          <span class="cbx-stone-label">Good morning — doors open, coats on pegs, settling in.</span>
        </li>
        <li class="cbx-daystone">
          <span class="cbx-stone-time">Through the day</span>
          <span class="cbx-stone-label">Play, stories, lunch and a run around the garden.</span>
        </li>
        <li class="cbx-daystone">
          <span class="cbx-stone-time">18:00</span>
          <span class="cbx-stone-label">Home time — with plenty to tell on the way.</span>
        </li>
      </ol>
      <p class="cbx-daynote">
        Monday to Friday, 07.30 – 18:00. We close on bank holidays and for one week at
        Christmas. Closures are subject to change.
      </p>
    </section>

    <section class="cbx-wander" id="rooms" aria-labelledby="cbx-wander-title">
      <div class="cbx-wander-copy">
        <p class="cbx-rubric">Rooms &amp; Garden</p>
        <h2 id="cbx-wander-title">Rooms to grow in, a garden to roam.</h2>
        <p>
          From first steps to the after-school years, children aged 0–12 are cared for in
          bright, calm rooms — and out in the discovery garden whenever the weather allows.
        </p>
        <blockquote class="cbx-wander-quote">
          <p>
            “At chatterbox we will provide a warm and welcoming environment for you and most
            importantly your child/ children.”
          </p>
        </blockquote>
      </div>
      <div class="cbx-wander-snaps">
        <figure class="cbx-snap cbx-snap--hall">
          <img
            src="/media/concepts/chatterbox/chatterbox-hall-entry.jpg"
            alt="Illustrative interior view of the calm entrance hall with wooden coat pegs and timber flooring"
            width="1200"
            height="896"
            loading="lazy"
          />
          <figcaption class="cbx-snap-caption">Coat pegs and cubbies in the entrance hall.</figcaption>
        </figure>
        <figure class="cbx-snap cbx-snap--garden">
          <img
            src="/media/concepts/chatterbox/chatterbox-garden-play.jpg"
            alt="Illustrative view of the outdoor play garden with timber balance beams, herb planters and the Mourne foothills"
            width="1200"
            height="896"
            loading="lazy"
          />
          <figcaption class="cbx-snap-caption">Balance beams and planters in the back garden.</figcaption>
        </figure>
      </div>
    </section>

    <section class="cbx-founders" id="paul-jane" aria-labelledby="cbx-founders-title">
      <p class="cbx-rubric">The family behind the door</p>
      <h2 id="cbx-founders-title">Paul &amp; Jane O'Connor</h2>
      <p class="cbx-founders-intro">
        Chatterbox has been run by husband and wife team Paul and Jane O'Connor since
        April 2010.
      </p>
      <div class="cbx-founders-pair">
        <article class="cbx-founder">
          <h3>Paul</h3>
          <p>
            A local building contractor, Paul has carried out an entire re-furbishment of
            the nursery to the highest possible standard.
          </p>
        </article>
        <article class="cbx-founder">
          <h3>Jane</h3>
          <p>
            A registered nurse and deputy ward manager in the Royal Group of hospitals,
            Jane has also lectured part-time in first aid for the Further Education colleges.
          </p>
        </article>
      </div>
      <p class="cbx-seal">Registered with the South Eastern Health and Social Care Trust.</p>
    </section>

    <section class="cbx-noticeboard" id="fees" aria-labelledby="cbx-noticeboard-title">
      <div class="cbx-pinned-note">
        <h2 id="cbx-noticeboard-title">Fees &amp; care rooms</h2>
        <p>
          Fee schedules and care room details live on our website.
        </p>
        <a class="cbx-note-link" href={feesPage} rel="noopener noreferrer">
          See fees at chatterboxkids.co.uk
        </a>
      </div>
    </section>

    <section class="cbx-hello" id="say-hello" aria-labelledby="cbx-hello-title">
      <p class="cbx-rubric">Say hello</p>
      <h2 id="cbx-hello-title" class="cbx-hello-heading">Come and talk to us.</h2>
      <a class="cbx-hello-number" href={phoneHref}>{phone}</a>
      <p class="cbx-hello-alt">
        Ring. Write. Or use the form on our
        <a href={contactPage} rel="noopener noreferrer">Contact page</a>.
      </p>
      <a class="cbx-hello-mail" href={mailto}>{email}</a>
    </section>
  </main>

  <footer class="cbx-signoff">
    <p class="cbx-signoff-mark">Chatterbox Day Nursery</p>
    <address class="cbx-signoff-address">
      75 Bryansford Road · Newcastle · BT33 0LE
    </address>
    <div class="cbx-signoff-links">
      <a href={phoneHref}>{phone}</a>
      <a href={mailto}>{email}</a>
      <a href={site} rel="noopener noreferrer">chatterboxkids.co.uk</a>
    </div>
  </footer>
</ConceptLayout>
