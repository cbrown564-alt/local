---
import MwMark from "./MwMark.astro";
import { booksy, facebook, phone, phoneHref } from "../content";
---

<div class="mw-strip">
  <span>Unit 13, 63A Castlewellan Road, Newcastle, BT33 0JX</span>
  <span class="mw-strip-links">
    <a href={phoneHref}>{phone}</a>
    <span aria-hidden="true"> · </span>
    <a href={booksy} rel="noopener noreferrer" target="_blank">Booksy Diary</a>
  </span>
</div>

<header class="mw-header">
  <a class="mw-brand" href="/concepts/marine-wellness/">
    <MwMark size={36} class="mw-brand-mark" />
    <span class="mw-brand-text">
      <span class="mw-brand-name">Marine Wellness</span>
      <span class="mw-brand-sub">Holistic Clinic · Newcastle</span>
    </span>
  </a>
  <nav class="mw-nav" aria-label="Concept navigation">
    <a href="#continuity">Continuity</a>
    <a href="#practice">The Practice</a>
    <a href="#hours">Hours</a>
    <a href="#booking">Book</a>
  </nav>
  <a class="mw-nav-cta" href={booksy}>Open Booksy</a>
</header>

<section class="mw-first" aria-labelledby="mw-name">
  <div class="mw-hero-content">
    <p class="mw-soon">Patricia McGrady · Unit 13, 63A Castlewellan Road</p>
    <h1 id="mw-name">Marine Wellness</h1>
    <p class="mw-reassure">
      Unit 13, 63A Castlewellan Road, Newcastle, BT33 0JX.
      Book on <a href={booksy}>Booksy</a>, or call <a href={phoneHref}>{phone}</a>.
    </p>

    <div class="mw-hero-actions">
      <a class="mw-btn-primary" href={booksy}>Open the Booksy Diary</a>
      <a class="mw-btn-tel" href={phoneHref}>{phone}</a>
    </div>

    <ul class="mw-two" role="list">
      <li>
        <span>Book</span>
        <strong>The diary on Booksy</strong>
        <a href={booksy}>Open Booksy</a>
      </li>
      <li>
        <span>Follow</span>
        <strong>Facebook</strong>
        <a href={facebook}>marinebeauty.haven</a>
      </li>
    </ul>
  </div>

  <figure class="mw-calm">
    <div class="mw-calm-frame">
      <img
        src="/media/concepts/marine-wellness/calm.jpg"
        alt="An empty treatment room with folded towels and a plant in soft daylight"
        width="940"
        height="627"
        loading="eager"
      />
      <div class="mw-calm-badge">
        <span class="mw-badge-dot"></span>
        <span>A quiet sanctuary room</span>
      </div>
    </div>
    <figcaption>A calm room.</figcaption>
  </figure>
</section>
