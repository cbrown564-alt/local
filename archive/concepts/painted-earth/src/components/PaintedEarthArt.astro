---
interface Props {
  theme: string;
  label?: string;
  compact?: boolean;
}

const {
  theme,
  label = "Placeholder — not the artist's work",
  compact = false,
} = Astro.props;
---

<figure class:list={["pe-art", `pe-art--${theme}`, compact && "pe-art--compact"]}>
  <span class="pe-art-shape pe-art-shape--one" aria-hidden="true"></span>
  <span class="pe-art-shape pe-art-shape--two" aria-hidden="true"></span>
  <span class="pe-art-shape pe-art-shape--three" aria-hidden="true"></span>
  <figcaption>{label}</figcaption>
</figure>
