---
/* Dated Facebook poster, staged as a chalkboard — not a live tariff.
   Honesty in bannerNote + research; caption stays guest-facing. */

const plates = [
  "Beef burger, bacon & cheese",
  "Battered haddock & mushy peas",
  "Homemade beef lasagne",
  "Crispy halloumi wrap",
  "Chicken tikka masala, rice & naan",
];
---

<figure class="nk-board">
  <svg
    class="nk-board-face"
    viewBox="0 0 420 560"
    role="img"
    aria-label="Weekday Wonders chalkboard: five hearty plates, all twelve pounds fifty"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern id="nk-chalk-dust" width="8" height="8" patternUnits="userSpaceOnUse">
        <circle cx="1.5" cy="2" r="0.4" fill="#d7e0c8" opacity="0.18" />
        <circle cx="6" cy="5.5" r="0.3" fill="#d7e0c8" opacity="0.12" />
      </pattern>
    </defs>

    <rect width="420" height="560" rx="10" fill="#6b4a2a" />
    <rect x="14" y="14" width="392" height="532" rx="6" fill="#1c2a22" />
    <rect x="14" y="14" width="392" height="532" rx="6" fill="url(#nk-chalk-dust)" />
    <rect x="26" y="26" width="368" height="508" fill="none" stroke="#c9d6b8" stroke-width="1.2" opacity="0.45" />

    <text
      x="210"
      y="64"
      text-anchor="middle"
      fill="#e8f0d8"
      font-family="Calistoga, Georgia, serif"
      font-size="22"
      letter-spacing="3"
    >WEEK DAY</text>
    <text
      x="210"
      y="96"
      text-anchor="middle"
      fill="#e8f0d8"
      font-family="Calistoga, Georgia, serif"
      font-size="34"
    >Wonders</text>
    <line x1="78" y1="112" x2="342" y2="112" stroke="#c9d6b8" stroke-width="1" opacity="0.5" />
    <text
      x="210"
      y="138"
      text-anchor="middle"
      fill="#c9d6b8"
      font-family="Nunito Sans, Segoe UI, sans-serif"
      font-size="12"
      font-weight="700"
      letter-spacing="2.4"
    >GREAT, HEARTY MEALS</text>

    {plates.map((plate, i) => (
      <g transform={`translate(0 ${168 + i * 52})`}>
        <text
          x="48"
          y="0"
          fill="#dfe8cc"
          font-family="Nunito Sans, Segoe UI, sans-serif"
          font-size="15"
          font-weight="600"
        >
          {plate}
        </text>
        <line
          x1="48"
          y1="10"
          x2="372"
          y2="10"
          stroke="#c9d6b8"
          stroke-width="0.8"
          stroke-dasharray="3 5"
          opacity="0.35"
        />
      </g>
    ))}

    <rect x="132" y="438" width="156" height="54" rx="4" fill="none" stroke="#e8c36a" stroke-width="2" />
    <text
      x="210"
      y="460"
      text-anchor="middle"
      fill="#e8c36a"
      font-family="Nunito Sans, Segoe UI, sans-serif"
      font-size="11"
      font-weight="800"
      letter-spacing="2"
    >ALL</text>
    <text
      x="210"
      y="484"
      text-anchor="middle"
      fill="#e8c36a"
      font-family="Calistoga, Georgia, serif"
      font-size="22"
    >£12.50 only</text>
    <text
      x="210"
      y="518"
      text-anchor="middle"
      fill="#c9d6b8"
      font-family="Nunito Sans, Segoe UI, sans-serif"
      font-size="11"
      letter-spacing="1.4"
    >Mid week · cheaper price</text>
  </svg>
  <figcaption>Weekday Wonders — Facebook, August 2026.</figcaption>
</figure>
