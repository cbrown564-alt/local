---
interface Props {
  size?: number;
  class?: string;
}

const { size = 36, class: className = "" } = Astro.props;
---

<svg
  class={`cm-brand-mark ${className}`}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <!-- Coffee Cup Base & Rim -->
  <path
    d="M10 22C10 32 17 38 24 38C31 38 38 32 38 22H10Z"
    fill="currentColor"
    fill-opacity="0.12"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linejoin="round"
  />
  <!-- Cup Handle -->
  <path
    d="M38 24C41.5 24 44 26.5 44 30C44 33.5 41.5 36 38 36"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
  />
  <!-- Saucer -->
  <path
    d="M6 41C12 43 36 43 42 41"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
  />
  <!-- Swirling Ice Cream Scoop / Steam Peak atop the cup -->
  <path
    d="M17 21C16 17 18 13 22 11C23 8 26 6 29 8C32 10 33 13 32 16C34 17 35 19 33 21"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <!-- Rising Aroma Swirl / Wave -->
  <path
    d="M24 6C23 4 25 3 26 2"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
  />
  <!-- Central Ice Cream Swirl Core -->
  <circle cx="24" cy="15" r="2" fill="currentColor" />
</svg>
