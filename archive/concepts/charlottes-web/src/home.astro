---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import Handtied from "./Handtied.astro";

/* Charlotte's Web Floristry — jar on Savoy Lane. Speak as the shop.
   Seasons, weddings, Diane's gift mix. Own site HTTP 500 — do NOT link
   dead shopfront as live. Directory/tel handoff. Hours omitted. */

const phone = "028 4372 5770";
const phoneHref = "tel:+442843725770";
const maps =
  "https://www.google.com/maps/search/?api=1&query=3+Savoy+Lane+Newcastle+BT33+0SJ";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Cormorant+Infant:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Red+Hat+Text:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap";

const mix = [
  {
    kicker: "Seasons",
    title: "What the week wants.",
    body: "Passionate about flowers and the changing seasons — each design cared for, not rushed past.",
  },
  {
    kicker: "Occasions",
    title: "Handtieds, weddings, plants.",
    body: "Arrangements and handtied bouquets, wedding flowers, and plants for the table or the sill.",
  },
  {
    kicker: "Diane’s mix",
    title: "Giftware beside the bucket.",
    body: "Diane selects the gift mix — Kelticandles, scarves, and more to sit beside the flowers.",
  },
];
---

<ConceptLayout
  title={"Charlotte's Web Floristry — independent concept"}
  slug="charlottes-web"
  bodyClass="concept-page concept-charlottes-web"
  lang="en-GB"
  businessName="Charlotte's Web Floristry"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The handtied is a drawing."
>
  <div class="cw-strip">
    <span>3 Savoy Lane, Newcastle · BT33 0SJ</span>
    <span class="cw-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="cw-header">
    <a class="cw-brand" href="/concepts/charlottes-web/">
      <span class="cw-brand-mark" aria-hidden="true">
        <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
          <rect width="44" height="44" fill="#3a1f2e"/>
          <path d="M22 8c-2 8-8 12-8 18a8 8 0 0 0 16 0c0-6-6-10-8-18Z" fill="#d4a0b8" opacity="0.9"/>
          <path d="M22 14c1 5 5 8 5 12a5 5 0 0 1-10 0c0-4 4-7 5-12Z" fill="#7a9a6a"/>
          <path d="M18 34h8" stroke="#e8d4c0" stroke-width="2" stroke-linecap="round"/>
          <circle cx="14" cy="20" r="2.2" fill="#c4843a"/>
          <circle cx="30" cy="18" r="1.8" fill="#e8d4c0"/>
        </svg>
      </span>
      <span class="cw-brand-text">
        <span class="cw-brand-name">Charlotte’s Web</span>
        <span class="cw-brand-sub">Savoy Lane · Florist &amp; giftware</span>
      </span>
    </a>
    <nav class="cw-nav" aria-label="Concept navigation">
      <a href="#seasons">Seasons</a>
      <a href="#handtied">The handtied</a>
      <a href="#ring">Ring</a>
      <a href="#door">The lane</a>
    </nav>
    <a class="cw-ring" href={phoneHref}>Ring the lane</a>
  </header>

  <main class="cw-main">
    <section class="cw-hero" aria-labelledby="cw-name">
      <div class="cw-hero-copy">
        <p class="cw-kicker">Florist &amp; giftware · Savoy Lane</p>
        <h1 id="cw-name">Charlotte’s Web</h1>
        <p class="cw-place">3 Savoy Lane · Newcastle · BT33 0SJ</p>
        <p class="cw-say">Seasons on Savoy Lane.</p>
        <p class="cw-lede">
          Flowers chosen with the season in mind, weddings and handtieds,
          plants and arrangements — and a gift mix Diane picks, from candles
          to scarves.
        </p>
        <p class="cw-cta">
          <a class="cw-ring cw-ring--inline" href={phoneHref}>Ring {phone}</a>
        </p>
      </div>
      <aside class="cw-season-rail" aria-label="Seasonal creed">
        <p class="cw-rail-label">This week’s creed</p>
        <p class="cw-rail-line">Follow the season.</p>
        <p class="cw-rail-line">Care for each design.</p>
        <p class="cw-rail-line">Wrap it for the lane.</p>
        <p class="cw-rail-note">Diane · Florist &amp; giftware</p>
      </aside>
    </section>

    <section class="cw-folio" id="seasons" aria-labelledby="cw-seasons-title">
      <p class="cw-folio-mark">Charlotte’s Web · 3 Savoy Lane</p>
      <div class="cw-folio-head">
        <p class="cw-kicker">The mix</p>
        <h2 id="cw-seasons-title">Flowers, then what Diane chose.</h2>
        <p>
          Jar register — when would you open this, give this, carry this down
          Savoy Lane? Not a generic Newcastle florist stock rose.
        </p>
      </div>
      <div class="cw-chips">
        {mix.map((item) => (
          <article class="cw-chip">
            <p class="cw-mag-kicker">{item.kicker}</p>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="cw-ritual" id="handtied" aria-labelledby="cw-handtied-title">
      <div class="cw-ritual-copy">
        <p class="cw-kicker">The handtied</p>
        <h2 id="cw-handtied-title">Point at the bucket. We wrap it.</h2>
        <p class="cw-ritual-lede">
          Occasions live on the phone — weddings, handtieds, plants,
          arrangements. Ring the lane; collect from Savoy Lane.
        </p>
        <ol class="cw-beats" id="ring">
          <li>
            <span class="cw-beat-n">01</span>
            <span class="cw-beat-t">Ring the lane</span>
          </li>
          <li>
            <span class="cw-beat-n">02</span>
            <span class="cw-beat-t">Tell us the occasion</span>
          </li>
          <li>
            <span class="cw-beat-n">03</span>
            <span class="cw-beat-t">Collect from Savoy Lane</span>
          </li>
        </ol>
        <p class="cw-cta">
          <a class="cw-ring cw-ring--inline" href={phoneHref}>{phone}</a>
        </p>
      </div>
      <div>
        <Handtied headingId="cw-handtied-title" />
        <p class="cw-hand-cap">The handtied for Savoy Lane.</p>
      </div>
    </section>

    <section class="cw-door" id="door" aria-labelledby="cw-door-title">
      <div class="cw-door-head">
        <p class="cw-kicker">The lane</p>
        <h2 id="cw-door-title">3 Savoy Lane.</h2>
        <p class="cw-door-lede">
          Charlotte’s Web Floristry — flowers and Diane’s gift mix. Ring the
          shop. When a first-party shopfront is healthy again, we will point
          there; for now the telephone is the door.
        </p>
      </div>
      <div class="cw-door-grid">
        <address class="cw-address">
          <strong>Charlotte’s Web</strong>
          <span>3 Savoy Lane</span>
          <span>Newcastle, Co. Down</span>
          <span>BT33 0SJ</span>
          <a href={phoneHref}>{phone}</a>
          <a href={maps} rel="noopener noreferrer">Map</a>
        </address>
        <div class="cw-handoff">
          <h3>Handoff</h3>
          <p>
            Directory listings carry the door and phone. Prefer a call to
            Savoy Lane over any shopfront that is not answering.
          </p>
          <a href={phoneHref}>Ring 028 4372 5770</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="cw-footer">
    <p class="cw-footer-name">Charlotte’s Web</p>
    <p>3 Savoy Lane, Newcastle · Florist &amp; giftware · Diane</p>
  </footer>
</ConceptLayout>
