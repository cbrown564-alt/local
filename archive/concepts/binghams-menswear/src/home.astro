---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import EssenceMedia from "../../site/components/EssenceMedia.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";
import BmMark from "./components/BmMark.astro";
import BmSchoolRoll from "./components/BmSchoolRoll.astro";

const phone = "028 4372 3521";
const phoneHref = "tel:+442843723521";
const email = "info@binghamsmenswear.com";
const facebook = "https://www.facebook.com/binghamsmenswear/";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap";

const intro =
  "Men's designer clothing, men's wedding and formal hire, boys' and girls' school uniforms, men's footwear.";

const range = [
  "Blue Elveley",
  "Blue Hadley",
  "Blue Tweed Run",
  "Green Tweed Run",
  "Grey Tweed Run",
  "Brown Tweed Run",
  "Navy Elveley",
  "White Gene",
  "Black Grissom",
  "Navy herringbone tailcoat",
];
---

<ConceptLayout
  title={"Binghams Menswear — independent concept"}
  slug="binghams-menswear"
  bodyClass="concept-page concept-binghams"
  businessName="Binghams Menswear"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="Tailoring scenes, two-days blazers and hire rail photography are generated visualisations."
>
  <div class="bm-strip">
    <span>82 Main Street, Newcastle, BT33 0AE</span>
    <span class="bm-strip-links">
      <a href={phoneHref}>{phone}</a>
      <span aria-hidden="true"> · </span>
      <a href={facebook} rel="noopener noreferrer" target="_blank">Facebook</a>
    </span>
  </div>

  <header class="bm-header">
    <a class="bm-brand" href="/concepts/binghams-menswear/">
      <BmMark size={34} class="bm-brand-mark" />
      <span class="bm-brand-text">
        <span class="bm-brand-name">Binghams Menswear</span>
        <span class="bm-brand-sub">82 Main Street · Newcastle</span>
      </span>
    </a>
    <nav class="bm-nav" aria-label="Concept navigation">
      <a href="#two-days">The two days</a>
      <a href="#book">The fitting</a>
      <a href="#schools">School roll</a>
      <a href="#hire">Hire &amp; tweeds</a>
    </nav>
    <a class="bm-nav-cta" href="#book">Book a fitting</a>
  </header>

  <main class="bm-page">
    <section class="bm-first" aria-labelledby="bm-name">
      <div class="bm-hero-content">
        <p class="bm-when">82 Main Street · Newcastle</p>
        <h1 id="bm-name">The two measured days of a life, through one door.</h1>
        <p class="bm-moment">
          From the first day of school to the wedding morning. Two days in a life need a proper fitting.
          Both come through the same door at 82 Main Street — the P1 blazer with room to grow, and the morning it all has to be right.
        </p>
        <p class="bm-intro-furniture">
          {intro}
        </p>
        <div class="bm-hero-actions">
          <a class="bm-btn-primary" href="#book">Arrange a fitting</a>
          <a class="bm-btn-tel" href={phoneHref}>{phone}</a>
        </div>
        <p class="bm-fb-line">
          Newcastle Primary quarter-zips, new arrivals and stock updates sit on{" "}
          <a href={facebook} rel="noopener noreferrer" target="_blank">Facebook</a>.
        </p>
      </div>

      <figure class="bm-stage">
        <div class="bm-stage-frame">
          <ResponsiveImage
            src="/media/concepts/binghams-menswear/fitting-session.jpg"
            alt="AI-generated scene of a bespoke herringbone tweed jacket on a tailoring bust with tailor's tape, shears and chalk on Main Street"
            width="1536"
            height="1024"
            loading="eager"
          />
          <div class="bm-stage-badge">
            <span class="bm-badge-dot"></span>
            <span>Half-hour fitting in store</span>
          </div>
        </div>
        <figcaption>The measuring takes half an hour in the shop — tape, chalk and mirror.</figcaption>
      </figure>
    </section>

    <!-- Move 2: The essence made visible — the two measured days -->
    <section class="bm-two-days" id="two-days" aria-labelledby="bm-two-days-title">
      <div class="bm-two-days-head">
        <p class="bm-kicker">The shop</p>
        <h2 id="bm-two-days-title">From the first day of school to the wedding morning.</h2>
        <p class="bm-two-days-lead">
          Two days in a life need a proper fitting. Both come through the same door at 82 Main Street — the P1 blazer with room to grow, and the morning it all has to be right.
        </p>
      </div>

      <div class="bm-poles-grid">
        <article class="bm-pole-card">
          <div class="bm-pole-icon" aria-hidden="true">01</div>
          <h3>The First Uniform</h3>
          <p>
            The P1 blazer bought with room to grow, school ties and quarter-zips.
            Sized properly at the counter so you aren't buying twice before Easter.
          </p>
          <span class="bm-pole-tag">Fourteen local schools stocked</span>
        </article>

        <article class="bm-pole-card">
          <div class="bm-pole-icon" aria-hidden="true">02</div>
          <h3>The Wedding Morning</h3>
          <p>
            Groomsmen, tailcoats, tweed three-pieces and formal hire.
            Measured shoulder to cuff in the shop so every detail sits true.
          </p>
          <span class="bm-pole-tag">Half-hour fitting appointment</span>
        </article>
      </div>

      <figure class="bm-two-days-visual">
        <div class="bm-visual-frame">
          <ResponsiveImage
            src="/media/concepts/binghams-menswear/two-blazers.jpg"
            alt="AI-generated scene of a junior school blazer with striped tie alongside an adult groom's tweed three-piece suit on a wooden rail"
            width="1536"
            height="1024"
            loading="lazy"
          />
        </div>
        <figcaption>Side by side: the junior school blazer with tie and the groom's tweed three-piece on the shop rail.</figcaption>
      </figure>

      <p class="bm-two-days-foot">
        The school uniforms are stocked here, the hire rail is in the shop, and the measuring takes half an hour.
        That part has never been on the internet.
      </p>
    </section>

    <!-- Move 3: The appointment is the fitting -->
    <section class="bm-invite" id="book" aria-labelledby="bm-invite-title">
      <div class="bm-invite-inner">
        <div class="bm-invite-head">
          <div>
            <p class="bm-kicker">The fitting</p>
            <h2 id="bm-invite-title">Name the day. Tell us the occasion.</h2>
          </div>
          <a class="bm-invite-phone" href={phoneHref}>{phone}</a>
        </div>
        <p class="bm-invite-lead">
          The measuring takes half an hour. Prepare your note below to draft an email directly to {email}.
          Nothing leaves this device until you press send. Or call the shop directly.
        </p>

        <div class="bm-desk-card">
          <div class="bm-desk-card-top">
            <BmMark size={22} class="bm-card-mark" />
            <span class="bm-card-heading">Fitting Appointment Request</span>
          </div>

          <form class="bm-rsvp" data-bm-request>
            <div class="bm-form-grid">
              <label class="bm-box" for="bm-who">
                <span>Your name</span>
                <input id="bm-who" name="name" type="text" autocomplete="name" placeholder="First and last name" required />
              </label>

              <label class="bm-box" for="bm-tel">
                <span>Best number to ring</span>
                <input id="bm-tel" name="tel" type="tel" autocomplete="tel" placeholder="Mobile or landline" required />
              </label>

              <label class="bm-box bm-box--full" for="bm-when">
                <span>When you would like to come in</span>
                <input id="bm-when" name="when" type="text" placeholder="e.g. Saturday afternoon or specific date" required />
              </label>
            </div>

            <fieldset class="bm-chips">
              <legend>Occasion for the fitting</legend>
              <div class="bm-chips-row">
                <label class="bm-chip"><input type="radio" name="bm-occasion" value="Wedding" checked /> <span>Wedding</span></label>
                <label class="bm-chip"><input type="radio" name="bm-occasion" value="Formal hire" /> <span>Formal hire</span></label>
                <label class="bm-chip"><input type="radio" name="bm-occasion" value="School uniform" /> <span>School uniform</span></label>
                <label class="bm-chip"><input type="radio" name="bm-occasion" value="Other fitting" /> <span>Other</span></label>
              </div>
            </fieldset>

            <button class="bm-submit" type="submit">
              <span>Prepare appointment draft</span>
              <span class="bm-submit-arrow" aria-hidden="true">→</span>
            </button>

            <div class="bm-sealed" data-bm-handoff role="status" hidden tabindex="-1">
              <div class="bm-sealed-head">
                <span class="bm-sealed-icon" aria-hidden="true">✓</span>
                <strong>Your appointment draft is ready</strong>
              </div>
              <p class="bm-sealed-text">Check the details, then open in your mail app to send:</p>
              <a class="bm-mail-btn" data-bm-mail href={`mailto:${email}`}>
                <span>Open email draft to {email}</span>
                <span aria-hidden="true">→</span>
              </a>
              <p class="bm-sealed-alt">Or ring the counter directly at <a href={phoneHref}>{phone}</a>.</p>
            </div>

            <p class="bm-stale" data-bm-stale role="status" hidden>
              Your details changed. Press <strong>Prepare appointment draft</strong> again so the draft matches what you typed.
            </p>
          </form>
        </div>
      </div>
    </section>

    <!-- Move 4: The School Roll — the keepable artifact -->
    <section class="bm-school-section" id="schools" aria-labelledby="bm-schools-title">
      <div class="bm-school-head">
        <p class="bm-kicker">The school roll</p>
        <h2 id="bm-schools-title">Fourteen schools. One counter.</h2>
        <p class="bm-school-lead">
          Newcastle, Dundrum, Clough, Kilkeel, Ballynahinch, Downpatrick and Castlewellan.
          The school list is the shop's patch, stocked directly at 82 Main Street.
        </p>
      </div>
      <BmSchoolRoll headingId="bm-schools-title" />
    </section>

    <!-- Move 6: Hire names without invented prices -->
    <section class="bm-how" id="hire" aria-labelledby="bm-how-title">
      <div class="bm-how-head">
        <p class="bm-kicker">Hire &amp; tailoring</p>
        <h2 id="bm-how-title">The hire rail and sale tweeds.</h2>
        <p class="bm-how-lead">
          Tweed Run, Elveley, Hadley and classic evening tailcoats. Come into the shop to see the cloth, feel the weight and try your size.
        </p>
      </div>

      <div class="bm-hire-layout">
        <ul class="bm-range" role="list">
          {range.map((name) => (
            <li>
              <span class="bm-range-bullet" aria-hidden="true">◆</span>
              <span class="bm-range-name">{name}</span>
            </li>
          ))}
        </ul>

        <figure class="bm-hire-visual">
          <div class="bm-visual-frame">
            <ResponsiveImage
              src="/media/concepts/binghams-menswear/hire-rail.jpg"
              alt="AI-generated scene of tailored formalwear and tweed hire suits hanging on an ornate brass and wood rail"
              width="1536"
              height="1024"
              loading="lazy"
            />
          </div>
          <figcaption>The hire collection — tweed three-pieces, formal dinner suits and tailored weaves.</figcaption>
        </figure>
      </div>

      <div class="bm-sale-callout">
        <p class="bm-sale-price">Sale tweeds from £159.00</p>
        <p class="bm-sale-sub">Visit in store at 82 Main Street for sale tweeds, suit hire and footwear.</p>
      </div>
    </section>

    <!-- Studio Transformation Essence Media Block -->
    <EssenceMedia slug="binghams-menswear" />

    <footer class="bm-footer">
      <BmMark size={40} class="bm-foot-mark" />
      <p class="bm-foot-name">Binghams Menswear</p>
      <p class="bm-foot-desc">The two measured days — wedding, formal hire &amp; school uniforms</p>
      <p class="bm-foot-addr">82 Main Street, Newcastle, Co. Down, BT33 0AE</p>
      <p class="bm-foot-contact">
        <a href={phoneHref}>{phone}</a>
        <span aria-hidden="true"> · </span>
        <a href={`mailto:${email}`}>{email}</a>
        <span aria-hidden="true"> · </span>
        <a href={facebook} rel="noopener noreferrer" target="_blank">Facebook</a>
      </p>
    </footer>
  </main>

  <script is:inline>
    (function () {
      var recipient = "info@binghamsmenswear.com";
      var form = document.querySelector("[data-bm-request]");
      if (!form) return;

      var handoff = form.querySelector("[data-bm-handoff]");
      var stale = form.querySelector("[data-bm-stale]");
      var link = form.querySelector("[data-bm-mail]");
      if (!handoff || !link) return;

      form.addEventListener("input", function () {
        if (handoff.hidden) return;
        handoff.hidden = true;
        if (stale) stale.hidden = false;
      });

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        if (!form.reportValidity()) return;

        var name = document.getElementById("bm-who").value.trim();
        var tel = document.getElementById("bm-tel").value.trim();
        var when = document.getElementById("bm-when").value.trim();
        var occasionEl = form.querySelector('input[name="bm-occasion"]:checked');
        var occasion = occasionEl ? occasionEl.value : "Fitting";

        var query = new URLSearchParams({
          subject: "Fitting appointment request — " + occasion,
          body: [
            "Hello Binghams Menswear,",
            "",
            "I would like to arrange a fitting appointment.",
            "Name: " + name,
            "Best number: " + tel,
            "Occasion: " + occasion,
            "When I can come in: " + when,
            "",
            "Please let me know if this time works for you.",
          ].join("\n"),
        });

        link.href = "mailto:" + recipient + "?" + query;
        handoff.hidden = false;
        if (stale) stale.hidden = true;
        handoff.focus();
      });
    })();
  </script>
</ConceptLayout>
