{
  "name": "mourne-made",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-prose-counts.mjs && node scripts/check-concept-publication.mjs && node scripts/check-public-assets.mjs && astro check && astro build",
    "preview": "astro preview",
    "test": "node scripts/run-verification.mjs",
    "capture:responsive": "node scripts/capture-responsive.mjs",
    "print:onesheet": "node scripts/print-onesheet.mjs",
    "optimize:media": "node scripts/optimize-public-media.mjs",
    "test:concepts": "node scripts/test-concept-shell.mjs",
    "test:reviewed-concepts": "node scripts/test-reviewed-concept-journeys.mjs",
    "test:bucks-head": "node scripts/test-bucks-head-journey.mjs",
    "test:enniskeen": "node scripts/test-enniskeen-journey.mjs",
    "test:painted-earth": "node scripts/test-painted-earth-journey.mjs",
    "test:media": "node scripts/test-media-loading.mjs",
    "test:reviews": "node scripts/check-concept-publication.mjs",
    "test:public-assets": "node scripts/check-public-assets.mjs --orphans",
    "test:request": "node --experimental-strip-types scripts/test-request-function.ts",
    "test:prose-counts": "node scripts/check-prose-counts.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/antonio": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/yeseva-one": "5.3.0",
    "@vercel/analytics": "2.0.1",
    "astro": "7.1.4",
    "nodemailer": "9.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/nodemailer": "8.0.1",
    "@vercel/node": "5.8.26",
    "ffmpeg-static": "5.3.0",
    "puppeteer-core": "24.43.1",
    "qrcode": "1.5.4",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.4",
      "esbuild": "0.28.1"
    }
  }
