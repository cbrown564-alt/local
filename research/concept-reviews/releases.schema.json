{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mournemade.co.uk/schemas/concept-review-releases-v1.1.json",
  "title": "Mourne Made concept review releases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releases"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.1"
    },
    "releases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/release"
      }
    }
  },
  "$defs": {
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["human", "agent"]
        }
      }
    },
    "score": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 10,
      "multipleOf": 0.5
    },
    "designGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentAndRespectful",
        "claimsHonest",
        "realVisitorLoop",
        "subjectProof",
        "responsiveAndKeyboard",
        "readableAndMotionSafe"
      ],
      "properties": {
        "currentAndRespectful": { "type": "boolean" },
        "claimsHonest": { "type": "boolean" },
        "realVisitorLoop": { "type": "boolean" },
        "subjectProof": { "type": "boolean" },
        "responsiveAndKeyboard": { "type": "boolean" },
        "readableAndMotionSafe": { "type": "boolean" }
      }
    },
    "releaseConditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetPermission",
        "truthCurrent",
        "independentSafeguards",
        "repositoryChecks"
      ],
      "properties": {
        "assetPermission": { "type": "boolean" },
        "truthCurrent": { "type": "boolean" },
        "independentSafeguards": { "type": "boolean" },
        "repositoryChecks": { "type": "boolean" }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceTruthRespect",
        "visitorOutcome",
        "subjectIdentity",
        "firstViewport",
        "completeLoop",
        "responsiveAccessibility",
        "craftFinish"
      ],
      "properties": {
        "evidenceTruthRespect": { "$ref": "#/$defs/score" },
        "visitorOutcome": { "$ref": "#/$defs/score" },
        "subjectIdentity": { "$ref": "#/$defs/score" },
        "firstViewport": { "$ref": "#/$defs/score" },
        "completeLoop": { "$ref": "#/$defs/score" },
        "responsiveAccessibility": { "$ref": "#/$defs/score" },
        "craftFinish": { "$ref": "#/$defs/score" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "status",
        "sourceFingerprint",
        "reviewer",
        "designGates",
        "releaseConditions",
        "scores",
        "weightedScore",
        "reviewedAt",
        "truthCheckedAt"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "status": {
          "enum": ["Reviewable", "Release blocked", "Revise", "Pass"]
        },
        "sourceFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "reviewer": {
          "anyOf": [
            { "$ref": "#/$defs/reviewer" },
            { "type": "null" }
          ]
        },
        "designGates": {
          "$ref": "#/$defs/designGates"
        },
        "releaseConditions": {
          "$ref": "#/$defs/releaseConditions"
        },
        "scores": {
          "$ref": "#/$defs/scores"
        },
        "weightedScore": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 10
        },
        "reviewedAt": {
          "type": "string",
          "format": "date"
        },
        "truthCheckedAt": {
          "type": "string",
          "format": "date"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "const": "Reviewable" }
            }
          },
          "then": {
            "properties": {
              "scores": {
                "properties": {
                  "evidenceTruthRespect": { "type": "null" },
                  "visitorOutcome": { "type": "null" },
                  "subjectIdentity": { "type": "null" },
                  "firstViewport": { "type": "null" },
                  "completeLoop": { "type": "null" },
                  "responsiveAccessibility": { "type": "null" },
                  "craftFinish": { "type": "null" }
                }
              },
              "weightedScore": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "reviewer": { "$ref": "#/$defs/reviewer" },
              "scores": {
                "properties": {
                  "evidenceTruthRespect": { "type": "number" },
                  "visitorOutcome": { "type": "number" },
                  "subjectIdentity": { "type": "number" },
                  "firstViewport": { "type": "number" },
                  "completeLoop": { "type": "number" },
                  "responsiveAccessibility": { "type": "number" },
                  "craftFinish": { "type": "number" }
                }
              },
              "weightedScore": { "type": "number" }
            }
          }
        }
      ]
    }
  }
}
