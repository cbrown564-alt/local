---
import "../styles/motion-compare.css";

interface Props {
  /** Concept slug, used only to scope element ids. */
  slug: string;
  /** After (concept) demo clip — always present. */
  afterVideo: string;
  afterPoster: string;
  afterAlt: string;
  /** Before (live site) demo clip. Omit for a first-website concept: the
      before side then shows the static poster with `beforeNote`. */
  beforeVideo?: string;
  beforePoster: string;
  beforeAlt: string;
  beforeNote?: string;
  heading?: string;
  intro?: string;
}
const {
  slug,
  afterVideo,
  afterPoster,
  afterAlt,
  beforeVideo,
  beforePoster,
  beforeAlt,
  beforeNote = "This business has no website of its own — its current public presence is a social page behind a login. There is no live site to demo.",
  heading = "See it in motion",
  intro = "A still can't show the hero, the menus or how fast you reach the main action. These are ten-second visits to each version, captured the same way.",
} = Astro.props;

const afterOnly = !beforeVideo;
---

<section class="motion" data-motion aria-labelledby={`motion-${slug}-heading`}>
  <div class="shell">
    <div class="motion-intro">
      <div>
        <h2 id={`motion-${slug}-heading`}>{heading}</h2>
        <p>{intro}</p>
      </div>
      <button type="button" class="motion-toggle" data-motion-toggle aria-pressed="true">
        <span class="motion-toggle-icon" aria-hidden="true"></span>
        <span class="motion-toggle-label">Pause</span>
      </button>
    </div>

    <div class:list={["motion-grid", { "motion-grid--after-only": afterOnly }]}>
      <figure class="motion-panel">
        <figcaption class="motion-legend motion-legend-before">Before</figcaption>
        <div class="motion-frame">
          {beforeVideo ? (
            <video
              class="motion-video"
              data-motion-video
              muted
              loop
              playsinline
              preload="none"
              poster={beforePoster}
              aria-label={`Before: ${beforeAlt}`}
            >
              <source src={beforeVideo} type="video/mp4" />
            </video>
          ) : (
            <>
              <img class="motion-still" src={beforePoster} alt={beforeAlt} width="1265" height="710" loading="lazy" />
              <p class="motion-static-note">{beforeNote}</p>
            </>
          )}
        </div>
      </figure>

      <figure class="motion-panel">
        <figcaption class="motion-legend motion-legend-after">After</figcaption>
        <div class="motion-frame">
          <video
            class="motion-video"
            data-motion-video
            muted
            loop
            playsinline
            preload="none"
            poster={afterPoster}
            aria-label={`After: ${afterAlt}`}
          >
            <source src={afterVideo} type="video/mp4" />
          </video>
        </div>
      </figure>
    </div>
  </div>
</section>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>("[data-motion]").forEach((section) => {
    const videos = [...section.querySelectorAll<HTMLVideoElement>("[data-motion-video]")];
    const toggle = section.querySelector<HTMLButtonElement>("[data-motion-toggle]");
    const label = toggle?.querySelector<HTMLElement>(".motion-toggle-label");
    if (!videos.length || !toggle) return;

    // Intent to play. Reduced-motion visitors start paused and opt in.
    let wants = !reduce.matches;
    let inView = false;

    const syncButton = () => {
      toggle.setAttribute("aria-pressed", String(wants));
      section.classList.toggle("is-paused", !wants);
      if (label) label.textContent = wants ? "Pause" : "Play";
    };

    const playAll = () => {
      for (const v of videos) {
        const p = v.play();
        if (p) p.catch(() => {}); // autoplay can still be refused; poster stays
      }
    };
    const pauseAll = () => videos.forEach((v) => v.pause());

    const apply = () => (wants && inView ? playAll() : pauseAll());

    // Only load and play once the section scrolls into view.
    const io = new IntersectionObserver(
      (entries) => {
        inView = entries[0].isIntersecting;
        apply();
      },
      { threshold: 0.35 },
    );
    io.observe(section);

    toggle.addEventListener("click", () => {
      wants = !wants;
      syncButton();
      apply();
    });

    reduce.addEventListener?.("change", (event) => {
      wants = !event.matches;
      syncButton();
      apply();
    });

    syncButton();
  });
</script>
