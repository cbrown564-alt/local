---
interface Props {
  class?: string;
  tone?: "ink" | "blue";
}

const { class: className = "", tone = "ink" } = Astro.props;
---

<div class:list={["mourne-motif", `mourne-motif--${tone}`, className]} aria-hidden="true">
  <svg class="mourne-motif-svg" viewBox="0 0 1200 72" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path
      fill="currentColor"
      d="M0 52 L80 52 140 28 210 44 290 18 360 38 430 22 500 40 560 14 640 34 720 20 800 36 880 24 960 42 1040 26 1120 38 1200 48 L1200 72 L0 72 Z"
    />
    <path
      fill="currentColor"
      fill-opacity="0.45"
      d="M0 58 C200 54 400 62 600 56 C800 50 1000 60 1200 54 L1200 72 L0 72 Z"
    />
  </svg>
</div>
