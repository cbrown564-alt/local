---
import { enniskeen, bookin1, base, nav, type NavId } from "../../data/enniskeen-site";
import ConceptLayout from "../../layouts/ConceptLayout.astro";
import "../../styles/global.css";
import "../../styles/concept-enniskeen.css";

interface Props {
  title: string;
  current: NavId;
}

const { title, current } = Astro.props;
---

<ConceptLayout
  title={title}
  slug="hotel-enniskeen"
  bodyClass="concept-page concept-enniskeen"
  lang="en-GB"
  bannerNote="AI-generated concept imagery. The façade and named Room 6 and Room 9 bathrooms faithfully visualise real photographed features; other scenes are atmospheric, not documentary."
>
    <header class="enk-header">
      <div class="enk-brand">
        <a href={`${base}/`} class="enk-brand-link">
          <span class="enk-brand-name">{enniskeen.brand}</span>
          <span class="enk-brand-sub">{enniskeen.brandSub}</span>
        </a>
      </div>
      <nav class="enk-nav" aria-label="Concept navigation">
        {nav.filter((item) => item.id !== "home").map((item) => (
          <a href={item.href} aria-current={current === item.id ? "page" : undefined}>{item.label}</a>
        ))}
      </nav>
      <div class="enk-header-actions">
        <a class="enk-phone" href={enniskeen.phoneHref}>{enniskeen.phone}</a>
        <a class="enk-book" href={bookin1.engine} rel="external">Book a room</a>
      </div>
    </header>
    <slot />
    <footer class="enk-footer">
      <div class="enk-footer-grid">
        <div class="enk-footer-col">
          <p class="enk-footer-brand">{enniskeen.name}</p>
          <p>{enniskeen.address}</p>
          <p>{enniskeen.directions}</p>
        </div>
        <div class="enk-footer-col">
          <p class="enk-footer-head">Reach the house</p>
          <p><a href={enniskeen.phoneHref}>{enniskeen.phone}</a></p>
          <p><a href={enniskeen.emailHref}>{enniskeen.email}</a></p>
          <p>
            <a href={enniskeen.facebook} rel="external">Facebook</a>
            {" · "}
            <a href={enniskeen.twitter} rel="external">Twitter</a>
          </p>
        </div>
        <div class="enk-footer-col">
          <p class="enk-footer-head">Good to know</p>
          <p>Free parking · free Wi-Fi · all rooms en suite · passenger lift</p>
          <p>Packed lunches and room service on request. Guide dogs welcome; no other pets.</p>
          <p><a href={bookin1.vouchers} rel="external">Gift vouchers — the hotel's own voucher shop →</a></p>
        </div>
      </div>
      <nav class="enk-footer-nav" aria-label="Footer navigation">
        {nav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    </footer>
</ConceptLayout>
