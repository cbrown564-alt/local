---
/** An illustrated plan of the twelve acres.
 *
 *  Every named feature is one the hotel publishes about its own grounds — the
 *  house, the lawn and gardens, the woodland trail, the Wishing Well, the
 *  Shimna River, the drive off the Bryansford Road, and the views over Slieve
 *  Donard and the Irish Sea (index.html, WoodlandRiverTrail.html). Nothing is
 *  added for decoration: there is no invented pond, folly, courtyard or
 *  terrace bar on this drawing.
 *
 *  What it is *not* is a survey. The hotel publishes no site plan, so the
 *  relative positions here are indicative — drawn in the order a guest meets
 *  them walking down from the house — and the caption says exactly that. It is
 *  a country-house foyer map, not a claim about where the boundary runs.
 *
 *  The plate is laid out on an 800 × 560 grid in bands: road and drive across
 *  the top, the house and its lawn through the middle, the trail and the
 *  Wishing Well below, and the Shimna along the foot. Woodland fills what is
 *  left, and every cluster is placed to stay clear of a label.
 */
interface Props {
  /** Set on the estate page, where the map is the section's own heading. */
  headingId?: string;
}

const { headingId } = Astro.props;

/** Woodland: cluster centre, spread and count, drawn as small arcs rather than
 *  filled shapes so the whole plate stays a line drawing. */
const woods = [
  { x: 400, y: 162, spread: 112, rows: 1, count: 5, seed: 17 },
  { x: 150, y: 322, spread: 68, rows: 3, count: 6, seed: 3 },
  { x: 622, y: 258, spread: 78, rows: 3, count: 6, seed: 11 },
  { x: 168, y: 424, spread: 54, rows: 2, count: 4, seed: 5 },
  { x: 660, y: 414, spread: 52, rows: 2, count: 4, seed: 8 },
];

/** Deterministic jitter — a hand-drawn wobble that does not change between
 *  builds, so the plate is byte-stable and diffable. */
const wobble = (seed: number, index: number, amount: number) => {
  const value = Math.sin(seed * 12.9898 + index * 78.233) * 43758.5453;
  return (value - Math.floor(value) - 0.5) * 2 * amount;
};

const trees = woods.flatMap((wood, woodIndex) =>
  Array.from({ length: wood.rows * wood.count }, (_, index) => {
    const row = Math.floor(index / wood.count);
    const column = index % wood.count;
    const step = (wood.spread * 2) / Math.max(wood.count - 1, 1);
    return {
      key: `${woodIndex}-${index}`,
      x: wood.x - wood.spread + column * step + wobble(wood.seed, index, 10),
      y: wood.y + row * 28 + wobble(wood.seed + 1, index, 8),
      r: 8 + wobble(wood.seed + 2, index, 2.2),
    };
  }),
);
---

<figure class="enk-map">
  <svg
    class="enk-map-plate"
    viewBox="0 0 800 560"
    role="img"
    aria-labelledby={headingId ? `${headingId} enk-map-desc` : "enk-map-title enk-map-desc"}
  >
    {!headingId && <title id="enk-map-title">Plan of the Enniskeen estate</title>}
    <desc id="enk-map-desc">
      An indicative drawing of the twelve-acre estate: the drive arriving from
      the Bryansford Road to the house and its turret, lawns and gardens below
      the terrace, woodland on every side, and the trail running down past the
      Wishing Well to the Shimna River along the foot of the grounds. Views run
      south-west to Slieve Donard and east to Newcastle and the Irish Sea.
    </desc>

    <rect class="enk-map-ground" x="0" y="0" width="800" height="560" />
    <rect class="enk-map-rule" x="14" y="14" width="772" height="532" rx="3" />
    <rect class="enk-map-rule enk-map-rule--inner" x="21" y="21" width="758" height="518" rx="2" />

    <!-- Estate boundary: a soft irregular envelope, drawn as a hedge line -->
    <path
      class="enk-map-boundary"
      d="M70 212C120 152 260 120 400 118c145-2 280 32 326 90 28 36 16 96 4 152-12 62-58 82-198 86-140 4-300 0-380-20C68 412 50 372 56 318c6-52-2-84 14-106Z"
    />

    <!-- The Shimna, running along the foot of the grounds -->
    <path
      class="enk-map-river"
      d="M38 486c58-14 106-2 158 8s96 12 152-2 108-24 168-14 106 20 152 10"
    />
    <path
      class="enk-map-river enk-map-river--shadow"
      d="M38 497c58-14 106-2 158 8s96 12 152-2 108-24 168-14 106 20 152 10"
    />

    <!-- The drive, in from the Bryansford Road, up to the door -->
    <path class="enk-map-drive" d="M40 224c88 8 152 26 210 38 34 6 68 4 104 2" />
    <path class="enk-map-drive enk-map-drive--edge" d="M40 233c88 8 152 26 210 38 34 6 68 4 104 2" />

    <!-- Lawn and gardens, below the terrace -->
    <path
      class="enk-map-lawn"
      d="M416 296c74 0 132 12 132 26s-58 26-132 26-132-12-132-26 58-26 132-26Z"
    />

    <!-- The woodland trail: out of the gardens, past the Wishing Well, to the river -->
    <path
      class="enk-map-trail"
      d="M404 350c-4 22-30 34-54 42s-42 12-48 26 10 26 40 30 74-6 116-14 76-6 100 12"
    />

    <!-- Woodland -->
    <g class="enk-map-wood">
      {trees.map((tree) => (
        <path
          d={`M${tree.x - tree.r} ${tree.y}a${tree.r} ${tree.r * 0.86} 0 0 1 ${tree.r * 2} 0`}
        />
      ))}
    </g>

    <!-- Sightlines out of the gardens -->
    <g class="enk-map-sight">
      <path d="M288 320 190 366" />
      <path class="enk-map-sight-head" d="M203 353 189 367l4 15" />
      <path d="M548 322 654 350" />
      <path class="enk-map-sight-head" d="M641 340 655 351l-5 14" />
    </g>

    <!-- The house: long range under a pitched roof, with the turret in front -->
    <g class="enk-map-house" transform="translate(352 206)">
      <path d="M18 40h82v42H18z" />
      <path d="M30 40 64 14l36 26" />
      <path d="M100 52h26v30h-26z" />
      <circle cx="18" cy="52" r="16" />
      <path d="M2 36 18 14l16 22" />
      <path d="M18 14V6" />
    </g>

    <!-- The Wishing Well -->
    <g class="enk-map-well" transform="translate(300 408)">
      <ellipse cx="0" cy="10" rx="13" ry="7" />
      <path d="M-13 10V2a13 7 0 0 1 26 0v8" />
      <path d="M-15-4 0-16l15 12" />
      <path d="M0-16v-5" />
    </g>

    <!-- Compass. Its disc is filled so the boundary hedge passes behind it. -->
    <g class="enk-map-compass" transform="translate(688 108)">
      <circle cx="0" cy="0" r="26" />
      <path d="M0-33 8-6 0 2-8-6Z" />
      <path d="M0 33 8 6 0-2-8 6Z" class="enk-map-compass-south" />
      <text x="0" y="-38" text-anchor="middle">N</text>
    </g>

    <g class="enk-map-labels">
      <text x="416" y="194" text-anchor="middle" class="enk-map-label--house">Enniskeen House</text>
      <text x="416" y="328" text-anchor="middle">Lawn &amp; gardens</text>
      <text x="300" y="374" text-anchor="middle">The Wishing Well</text>
      <text x="506" y="410" text-anchor="middle">Woodland trail</text>
      <text x="150" y="524" text-anchor="middle">The Shimna River</text>
      <text x="46" y="196" text-anchor="start">Bryansford Road</text>
      <text x="150" y="286" text-anchor="middle">Twelve wooded acres</text>
      <text x="178" y="400" text-anchor="middle" class="enk-map-label--sight">Slieve Donard</text>
      <text x="654" y="374" text-anchor="middle" class="enk-map-label--sight">
        Newcastle
        <tspan x="654" dy="17">&amp; the Irish Sea</tspan>
      </text>
    </g>
  </svg>
  <figcaption>
    Indicative plan of the twelve acres, drawn from the hotel's own description
    of the grounds — the order a guest meets them, not a survey.
  </figcaption>
</figure>
