---
interface Props {
  class?: string;
  showPlace?: boolean;
}

const { class: className = "", showPlace = true } = Astro.props;
---

<span class:list={["brand-mark", className]} aria-hidden="true">
  <span class="brand-mark-block">
    <b>Mourne</b>
    <b>Made</b>
    <i></i>
  </span>
  {showPlace && <span class="brand-mark-place">Dundrum<br />+ Newcastle</span>}
</span>
