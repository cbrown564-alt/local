---
const businesses = [
  { name: "Cúpla", town: "Dundrum", href: "/transformations/cupla/" },
  { name: "Scopers", town: "Dundrum", href: "/transformations/scopers/" },
  { name: "The Bucks Head", town: "Dundrum", href: "/transformations/bucks-head/" },
  { name: "Donard Veterinary Clinic", town: "Newcastle", href: "/transformations/donard-veterinary/" },
  { name: "Mourne Cycles", town: "Newcastle", href: "/transformations/mourne-cycles/" },
  { name: "Enniskeen Country House Hotel", town: "Newcastle", href: "/transformations/hotel-enniskeen/" },
  { name: "Castle Farm Fresh Produce", town: "Dundrum", href: "/transformations/castle-farm/" },
];
---

<section class="local-strip" aria-label="Local businesses in the portfolio">
  <div class="shell local-strip-shell">
    <p class="local-strip-label">Portfolio</p>
    <ul class="local-strip-list">
      {businesses.map((business, index) => (
        <li class="local-strip-item">
          <a class="local-strip-link" href={business.href}>
            <span class="local-strip-name">{business.name}</span>
            <span class="local-strip-town">{business.town}</span>
          </a>
          {index < businesses.length - 1 && (
            <span class="local-strip-sep" aria-hidden="true">·</span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
