---
import BaseLayout from "../site/layouts/BaseLayout.astro";
import ArrowIcon from "../site/components/ArrowIcon.astro";
import FaultWalk from "../site/components/fault-walk/FaultWalk.astro";
import SwapTest from "../site/components/fault-walk/SwapTest.astro";
import type { FaultWalk as FaultWalkData, SwapTestTheme } from "../site/data/fault-walks";
import { whatWeLookFor } from "../site/data/fault-walks";
import { ogImages } from "../site/data/og-images";
import "../site/styles/what-we-look-for.css";

const walks = whatWeLookFor.filter((entry): entry is FaultWalkData => entry.kind === "walk");
const swap = whatWeLookFor.find((entry): entry is SwapTestTheme => entry.kind === "swap");
if (!swap) throw new Error("what-we-look-for: the swap test is missing from the reel");

/* Page order is 1–10. Internal theme ids (t1, t4…) stay in data and anchors
   only — never as guest-facing labels. */
type StripItem = { href: string; task: string; n: number };
const strip: { tag: string; label: string; start: number; items: StripItem[] }[] = [
  {
    tag: "Part one",
    label: "Something simple gets hard",
    start: 1,
    items: walks.slice(0, 6).map((walk, i) => ({
      href: `#${walk.id}`,
      task: walk.errand.toLowerCase(),
      n: i + 1,
    })),
  },
  {
    tag: "Part two",
    label: "It could be anyone's",
    start: 7,
    items: walks.slice(6).map((walk, i) => ({
      href: `#${walk.id}`,
      task: walk.errand.toLowerCase(),
      n: i + 7,
    })),
  },
  {
    tag: "The closer",
    label: "Done by hand",
    start: 10,
    items: [{ href: `#${swap.id}`, task: "tell two shopfronts apart", n: 10 }],
  },
];

/* The ten run as three movements: the access faults, the identity faults,
   then the swap test as the closer. The bands are the pacing — they break a
   long scroll into an argument with a beginning, a turn and an ending. */
const parts: Record<string, { tag: string; title: string; blurb: string }> = {
  t1: {
    tag: "Part one",
    title: "Six ordinary jobs, stopped or made hard.",
    blurb:
      "Each one below started as a reasonable decision. Try it yourself and feel where it breaks.",
  },
  t3: {
    tag: "Part two",
    title: "Three working sites that stopped sounding like anyone.",
    blurb: "Nothing here is broken. That is what makes these three harder to spot.",
  },
};
---

<BaseLayout
  title="What we look for — Mourne Made"
  description="Ten things we look for before we redesign anything — walked as made-up wireframes, so you can feel what each one costs a stranger."
  ogImage={ogImages.studio}
  ogImageAlt="Mourne Made — local websites for Dundrum and Newcastle"
>
  <div class="wwlf">
    <section class="wwlf-hero">
      <div class="shell">
        <p class="wwlf-hero-ten" aria-hidden="true">10</p>
        <p class="eyebrow">Mourne Made</p>
        <h1>Ten things we look for before we redesign anything.</h1>
        <p class="lede">
          What twenty concepts taught us to check first — and what each one costs someone
          standing outside your door.
        </p>
        <p class="wwlf-howto">
          <span class="wwlf-howto-lead">How it works.</span>
          Tap around inside each phone. You'll get stuck, or you'll have to hunt — that wasted
          effort is the point. Then press <strong>Fix it</strong> and try the same thing again.
        </p>
        <p class="wwlf-invented">
          These are made-up sites — grey blocks, no business names. Faults we find on a real site
          go only to that business, never onto a public page. The numbers here are yours, tapping
          these mocks; measured figures stay with the named case studies.
        </p>
      </div>
    </section>

    <nav class="wwlf-index" aria-label="Ten things a stranger might try">
      <div class="shell">
        <h2>Ten things a stranger might try.</h2>
        <div class="wwlf-strip">
          {
            strip.map((group) => (
              <section class="wwlf-strip-group">
                <h3>
                  <span>{group.tag}</span> {group.label}
                </h3>
                <ol start={group.start}>
                  {group.items.map((item) => (
                    <li>
                      <a href={item.href}>
                        <span class="wwlf-strip-n">{item.n}</span>
                        <span class="wwlf-strip-task">{item.task}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </section>
            ))
          }
        </div>
      </div>
    </nav>

    <div class="wwlf-themes">
      <div class="shell">
        {
          walks.map((walk, index) => {
            const part = parts[walk.id];
            const n = index + 1;
            return (
              <>
                {part && (
                  <header class="wwlf-part">
                    <p class="wwlf-part-tag">{part.tag}</p>
                    <h2 class="wwlf-part-title">{part.title}</h2>
                    <p class="wwlf-part-blurb">{part.blurb}</p>
                  </header>
                )}
                <FaultWalk walk={walk} n={n} />
              </>
            );
          })
        }
      </div>
    </div>

    <section class="wwlf-finale">
      <div class="shell">
        <header class="wwlf-part">
          <p class="wwlf-part-tag">The closer</p>
          <h2 class="wwlf-part-title">The last check is done by hand.</h2>
          <p class="wwlf-part-blurb">
            Not a job to finish — a quick test on two made-up shopfronts.
          </p>
        </header>
        <SwapTest theme={swap} n={10} />
      </div>
    </section>

    <section class="wwlf-purpose">
      <div class="shell">
        <p class="eyebrow">What this is for</p>
        <h2>A checklist we run before we redesign anything — not a quiz about you.</h2>
        <p>
          These ten are step 5 of the studio's research method: the check on a business's public
          site before anything is redesigned.
        </p>
        <p>
          Two things this page never does. It never turns our case-study notes into a claim about
          websites in general. And it never grades you: the taps above are yours, on these made-up
          phones — nothing here scores your site.
        </p>
      </div>
    </section>

    <section class="wwlf-close">
      <div class="shell">
        <p class="eyebrow">Your turn</p>
        <h2>Send a link. We'll walk your site the same way.</h2>
        <p>
          We note what stops a stranger, fix the worst of it as a free before-and-after, and show
          you both. No obligation.
        </p>
        <a class="button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { mountFaultWalks } from "../site/scripts/fault-walk";

  mountFaultWalks();
</script>
