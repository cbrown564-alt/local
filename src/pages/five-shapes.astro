---
import BaseLayout from "../site/layouts/BaseLayout.astro";
import ArrowIcon from "../site/components/ArrowIcon.astro";
import ShapePlate from "../site/components/five-shapes/ShapePlate.astro";
import FiveShapesHero from "../site/components/five-shapes/FiveShapesHero.astro";
import { fiveShapes } from "../site/data/five-shapes";
import { ogImages } from "../site/data/og-images";
import "../site/styles/what-we-look-for.css";
import "../site/styles/five-shapes.css";
---

<BaseLayout
  title="Five shapes — Mourne Made"
  description="There is no standard website. Five shapes a local site takes — a place, a counter business, a product, a care practice, a trade — drawn and annotated, because what the customer buys decides the shape."
  ogImage={ogImages.studio}
  ogImageAlt="Mourne Made — local websites for Dundrum and Newcastle"
>
  <div class="fvs">
    <section class="wwlf-hero fvs-hero">
      <div class="shell fvs-hero-grid">
        <div class="fvs-hero-copy">
          <p class="eyebrow">Mourne Made</p>
          <h1>There is no standard website.</h1>
          <p class="lede">
            Five shapes a local site takes — a place, a counter business, a product, a care
            practice, a trade. What the customer buys decides which one a business needs.
          </p>
          <p class="wwlf-invented">
            These are drawn plates — grey blocks and margin notes, no business names, nothing to
            pick, price or download. Each plate states what its shape needs; how common anything
            is, this page never claims.
          </p>
        </div>
        <FiveShapesHero />
      </div>
    </section>

    <nav class="wwlf-index" aria-label="The five shapes">
      <div class="shell">
        <h2>Five shapes, one question each.</h2>
        <ol class="fvs-strip">
          {
            fiveShapes.map((plate, index) => (
              <li>
                <a href={`#${plate.id}`} data-fvs-page={plate.id}>
                  <span class="wwlf-strip-n">{index + 1}</span>
                  <span>
                    <span class="wwlf-strip-task">{plate.shape}</span>
                    <span class="fvs-strip-q">{plate.ownerQuestion.toLowerCase()}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </nav>

    <section class="fvs-reel" data-fvs-reel aria-label="The five shapes as drawn plates">
      <div class="shell fvs-reel-bar">
        <div class="fvs-reel-arrows">
          <button type="button" class="fvs-reel-arrow" data-fvs-prev aria-label="Previous shape">
            <span class="fvs-reel-arrow-icon fvs-reel-arrow-icon--prev" aria-hidden="true">
              <ArrowIcon />
            </span>
          </button>
          <button type="button" class="fvs-reel-arrow" data-fvs-next aria-label="Next shape">
            <span class="fvs-reel-arrow-icon" aria-hidden="true">
              <ArrowIcon />
            </span>
          </button>
        </div>
      </div>
      <div class="fvs-reel-scroller" tabindex="0">
        <div class="fvs-reel-track">
          {
            fiveShapes.map((plate, index) => (
              <div class="fvs-reel-slide" data-plate={plate.id}>
                <ShapePlate plate={plate} n={index + 1} />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="fvs-misfit">
      <div class="shell">
        <h2>Two of these, or none of them.</h2>
        <p>
          A gallery sells a product and is a place. A farm shop is counter and product at once.
          A chamber, a club, a charity are none of the five.
        </p>
        <p>
          The shapes are a reading aid, not a form you fill in. Naming yours is our job — and
          naming it wrong is how you get hotel moves on a food bar.
        </p>
      </div>
    </section>

    <section class="wwlf-purpose">
      <div class="shell">
        <p class="eyebrow">What this is for</p>
        <h2>Five shapes the work keeps taking — not a census, and not a quiz.</h2>
        <p>
          Naming the shape is step 2 of the studio's research method: the shape picks the
          register, and the register picks the moves. What goes wrong in any shape is step 5 —
          five faults, walked as wireframes at <a href="/what-we-look-for/">What we look for</a>.
        </p>
        <p>
          Two things this page never does. It never reads the five as a claim about how common
          anything is. And it never says anything about a named business — those claims live on
          the case studies the plates link to.
        </p>
      </div>
    </section>

    <section class="wwlf-close">
      <div class="shell">
        <p class="eyebrow">Your turn</p>
        <h2>You don't need to know your shape.</h2>
        <p>
          Send the link. Spotting the shape — and what it's asking for — is the first thing we
          do, before anything gets drawn.
        </p>
        <a class="button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { mountFiveShapesReel } from "../site/scripts/five-shapes-reel";
  mountFiveShapesReel();
</script>
