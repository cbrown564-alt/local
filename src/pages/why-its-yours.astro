---
import BaseLayout from "../site/layouts/BaseLayout.astro";
import ArrowIcon from "../site/components/ArrowIcon.astro";
import ShapePlate from "../site/components/five-shapes/ShapePlate.astro";
import FiveShapesHero from "../site/components/five-shapes/FiveShapesHero.astro";
import { fiveShapes } from "../site/data/five-shapes";
import { ogImages } from "../site/data/og-images";
import "../site/styles/what-we-look-for.css";
import "../site/styles/five-shapes.css";
---

<BaseLayout
  title="Why it’s yours — Mourne Made"
  description="A hotel site and a food-bar site shouldn’t work the same way. Here’s how to see which kind of site you need — without picking a template."
  ogImage={ogImages.studio}
  ogImageAlt="Mourne Made — local websites for Dundrum and Newcastle"
>
  <div class="fvs">
    <section class="wwlf-hero fvs-hero">
      <div class="shell fvs-hero-grid">
        <div class="fvs-hero-copy">
          <p class="eyebrow">Mourne Made</p>
          <h1>Why it’s yours.</h1>
          <p class="lede">
            A hotel site and a food-bar site shouldn’t work the same way. Here’s how to see which
            kind of site you need — without picking a template.
          </p>
          <p class="wwlf-invented">
            These are drawn plates — grey blocks and margin notes, no business names, nothing to
            pick, price or download.
          </p>
        </div>
        <FiveShapesHero />
      </div>
    </section>

    <nav class="wwlf-index" aria-label="Five kinds of local site">
      <div class="shell">
        <h2>Five kinds of site, one question each.</h2>
        <ol class="fvs-strip">
          {
            fiveShapes.map((plate, index) => (
              <li>
                <a href={`#${plate.id}`} data-fvs-page={plate.id}>
                  <span class="wwlf-strip-n">{index + 1}</span>
                  <span>
                    <span class="wwlf-strip-task">{plate.ownerQuestion}</span>
                    <span class="fvs-strip-q">{plate.shape}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </nav>

    <section class="fvs-reel" data-fvs-reel aria-label="Five kinds of site as drawn plates">
      <div class="shell fvs-reel-bar">
        <div class="fvs-reel-arrows">
          <button type="button" class="fvs-reel-arrow" data-fvs-prev aria-label="Previous kind of site">
            <span class="fvs-reel-arrow-icon fvs-reel-arrow-icon--prev" aria-hidden="true">
              <ArrowIcon />
            </span>
          </button>
          <button type="button" class="fvs-reel-arrow" data-fvs-next aria-label="Next kind of site">
            <span class="fvs-reel-arrow-icon" aria-hidden="true">
              <ArrowIcon />
            </span>
          </button>
        </div>
      </div>
      <div class="fvs-reel-scroller" tabindex="0">
        <div class="fvs-reel-track">
          {
            fiveShapes.map((plate, index) => (
              <div class="fvs-reel-slide" data-plate={plate.id}>
                <ShapePlate plate={plate} n={index + 1} />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="fvs-misfit">
      <div class="shell">
        <h2>Two of these, or none of them.</h2>
        <p>
          A gallery sells a product and is a place. A farm shop is counter and product at once.
          A chamber, a club, a charity are none of the five.
        </p>
        <p>
          Naming yours is our job — and naming it wrong is how you get hotel moves on a food bar.
          You don’t need to fill in a form about it.
        </p>
      </div>
    </section>

    <section class="wwlf-close">
      <div class="shell">
        <p class="eyebrow">Your turn</p>
        <h2>You don't need to know your kind of site.</h2>
        <p>
          Send the link. Spotting what kind you need — and what it's asking for — is the first
          thing we do, before anything gets drawn.
        </p>
        <a class="button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { mountFiveShapesReel } from "../site/scripts/five-shapes-reel";
  mountFiveShapesReel();
</script>
