---
import BaseLayout from "../site/layouts/BaseLayout.astro";
import ArrowIcon from "../site/components/ArrowIcon.astro";
import SerifFont from "../site/components/SerifFont.astro";
import ResponsiveImage from "../site/components/ResponsiveImage.astro";
import { siteDetails } from "../site/data/site";
import { ogImages } from "../site/data/og-images";
import "../site/styles/about.css";

const postcards = [
  {
    slot: "tollymore",
    src: "/media/studio/conor-tollymore.jpg",
    width: 1125,
    height: 1500,
    alt: "Conor smiling on a gravel path through tall trees and ferns in Tollymore Forest.",
    caption: "Tollymore Forest",
  },
  {
    slot: "murlough",
    src: "/media/studio/conor-murlough.jpg",
    width: 1265,
    height: 949,
    alt: "Conor in sunglasses on the dunes at Murlough, with the beach and a bright sea behind.",
    caption: "Murlough Bay",
  },
  {
    slot: "donard",
    src: "/media/studio/conor-donard.jpg",
    width: 1265,
    height: 949,
    alt: "Conor in a fur-lined hat on a snowy stone path on Slieve Donard, with the sea far below.",
    caption: "Slieve Donard, in the snow",
  },
];

const promises = [
  {
    glyph: "compare",
    title: "I’ll show you first.",
    body: "Before you spend anything, I’ll make a before-and-after of your own homepage.",
  },
  {
    glyph: "shopfront",
    title: "You’ll get a price in writing.",
    body: "It’s fixed, with the build, the domain and the hosting set out separately.",
  },
  {
    glyph: "sprout",
    title: "Some of it goes back.",
    body: "A share of my time goes to clubs and charities round here, free or at a reduced cost.",
  },
];

const answers = [
  {
    q: "Is the before-and-after really free?",
    a: "Yes. There’s no catch and no obligation. If you like it and want to stop there, that’s fine.",
  },
  {
    q: "What will it cost?",
    a: "It depends on the job, and you’ll know before I start. It can start small: one page, done well.",
  },
  {
    q: "Will there be hidden costs?",
    a: "No. Keep a hosting provider you already use if you like. There’s no subscription to sign up to.",
  },
  {
    q: "How long will it take?",
    a: "I’ll give you a date for your before-and-after when I reply. If you go ahead, we agree the schedule before I start.",
  },
];
---

<BaseLayout
  title="Why local — Mourne Made"
  description="Mourne Made is a Dundrum and Newcastle studio that shows local businesses what their website could become — then puts paid work back into the community."
  ogImage={ogImages.studio}
  ogImageAlt="Mourne Made — local websites for Dundrum and Newcastle"
>
  <SerifFont />

  <div class="about">
    <section class="about-hero" aria-labelledby="about-hero-title">
      <div class="shell about-hero-grid">
        <div class="about-postcards">
          {postcards.map((card) => (
            <figure class={`about-postcard about-postcard--${card.slot}`}>
              <div class="about-postcard-photo">
                <ResponsiveImage
                  src={card.src}
                  alt={card.alt}
                  width={card.width}
                  height={card.height}
                  loading="eager"
                  sizes="(max-width: 860px) 60vw, 340px"
                />
              </div>
              <figcaption>{card.caption}</figcaption>
            </figure>
          ))}
        </div>

        <div class="about-hero-copy">
          <p class="about-kicker">Why local</p>
          <h1 id="about-hero-title">Hello. I’m <em>{siteDetails.founderFirstName}.</em></h1>
          <p class="about-lede">I live in Dundrum, and I build websites. I’d like the ones round here to be as good as the places themselves.</p>
        </div>
      </div>
    </section>

    <section class="about-letter" aria-labelledby="about-builder-title">
      <div class="shell about-letter-grid">
        <h2 id="about-builder-title">I’m a builder.</h2>
        <div class="about-letter-copy">
          <p>I work in data and AI, but what I’ve always liked is building things. I take something awkward, like a spreadsheet, a process or a pile of paperwork, and turn it into something that looks good and makes it easier for people to get what they need.</p>
          <p>A website is the same job. It should help someone find you, see what you do and get in touch, without having to work at it.</p>
        </div>
      </div>
    </section>

    <section class="about-belief" aria-labelledby="about-belief-title">
      <div class="shell">
        <div class="about-belief-head">
          <h2 id="about-belief-title">Good local businesses deserve websites as good as they are.</h2>
          <div class="about-letter-copy">
            <p>Walk down Main Street in Dundrum or along the promenade in Newcastle and you’ll find places people love. Plenty of them have a website that hasn’t changed in years, or just a Facebook page, and for good reason.</p>
            <p>A new website used to be slow and expensive. When the business is busy and the regulars already know where to find you, leaving it alone was the sensible choice.</p>
            <p>That’s changed. Used carefully, new AI tools let one person do work that used to need a team, so a refresh can be done properly, in good time and at a fair price.</p>
            <p class="about-belief-lead">Here’s how I’ll work with you:</p>
          </div>
        </div>
        <ul class="about-promises">
          {promises.map((item) => (
            <li>
              <svg class="about-glyph" viewBox="0 0 56 56" width="56" height="56" aria-hidden="true" focusable="false">
                {item.glyph === "compare" && (
                  <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="6" y="12" width="44" height="32" rx="3" />
                    <path d="M28 8 V48" />
                    <circle cx="28" cy="28" r="5" fill="var(--about-glyph-fill)" />
                    <path d="M12 20 H20 M12 25 H22 M12 30 H18" opacity=".45" />
                    <path d="M34 20 H44 M34 26 H40" />
                    <rect x="34" y="32" width="8" height="5" rx="1" />
                  </g>
                )}
                {item.glyph === "shopfront" && (
                  <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8 22 L11 12 H45 L48 22" />
                    <path d="M8 22 Q12 27 16 22 Q20 27 24 22 Q28 27 32 22 Q36 27 40 22 Q44 27 48 22" />
                    <path d="M11 25 V46 H45 V25" />
                    <path d="M17 46 V33 H25 V46" />
                    <rect x="30" y="31" width="10" height="8" rx="1" />
                    <path d="M6 46 H50" />
                  </g>
                )}
                {item.glyph === "sprout" && (
                  <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M28 46 V26" />
                    <path d="M28 32 C 18 32, 13 25, 13 17 C 22 17, 28 22, 28 32Z" fill="var(--about-glyph-fill)" />
                    <path d="M28 27 C 36 27, 42 21, 42 13 C 34 13, 28 18, 28 27Z" />
                    <path d="M14 46 C 20 42, 36 42, 42 46" />
                  </g>
                )}
              </svg>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="about-answers" aria-labelledby="about-answers-title">
      <div class="shell about-answers-grid">
        <div>
          <h2 id="about-answers-title">Before you ask.</h2>
        </div>
        <dl class="about-answers-list">
          {answers.map((item) => (
            <div>
              <dt>{item.q}</dt>
              <dd>{item.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="about-ask" aria-labelledby="about-ask-title">
      <div class="shell about-ask-inner">
        <h2 id="about-ask-title">Fancy a look at yours?</h2>
        <div class="about-ask-action">
          <a class="button" href="/request/">Get a free before-and-after <ArrowIcon /></a>
          <p>Or just email me: <a class="text-link" href={siteDetails.emailHref}>{siteDetails.email}</a></p>
        </div>
      </div>
    </section>

    <section class="about-closer" aria-labelledby="about-closer-title">
      <div class="shell about-closer-inner">
        <h2 id="about-closer-title">Why I do this</h2>
        <p>I like building things, and I like where I live. This lets me do both: use what I know to give the places round here a better front door online, and keep the good of it close to home.</p>
        <p class="about-sign">{siteDetails.founderFirstName}</p>
      </div>
    </section>
  </div>
</BaseLayout>
