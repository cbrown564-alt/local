---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
---

<BaseLayout title="Why local — Mourne & Main" description="Mourne and Main is built around practical digital work for businesses and community organisations in Dundrum and Newcastle.">
  <section class="page-hero about-hero">
    <div class="shell">
      <p class="eyebrow">Why local</p>
      <h1>The street should look as good online as it feels in person.</h1>
      <p class="lede">Mourne &amp; Main starts close to home: independent owners first, then the clubs, charities and public services that hold local life together.</p>
    </div>
  </section>

  <section class="principles">
    <div class="shell">
      <div class="principle-row"><span class="principle-number">01</span><h3>Show before selling</h3><p>You receive a small visual concept first. It makes the conversation concrete and keeps the decision low-risk.</p></div>
      <div class="principle-row"><span class="principle-number">02</span><h3>Explain without belittling</h3><p>A current website often reflects limited time or an old template. The work should identify missed opportunities without mocking either.</p></div>
      <div class="principle-row"><span class="principle-number">03</span><h3>Keep value here</h3><p>Paid work supports practical free or reduced-cost help for local organisations with a clear need and a limited budget.</p></div>
    </div>
  </section>

  <section class="community">
    <div class="shell community-grid">
      <article class="community-card">
        <p class="eyebrow">Commercial work</p>
        <h2>For businesses ready to grow</h2>
        <p>Focused websites, richer menus and recipes, better galleries, clearer booking paths and stronger local discovery.</p>
      </article>
      <article class="community-card community-card-community">
        <p class="eyebrow">Community work</p>
        <h2>For useful work without the budget</h2>
        <p>Selected clubs, charities and community projects can receive reduced-cost or contributed work as capacity allows.</p>
      </article>
    </div>
    <div class="shell button-row"><a class="button button-blue" href="/request/">Request a free before-and-after <ArrowIcon /></a></div>
  </section>
</BaseLayout>
