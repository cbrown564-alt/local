---
import BaseLayout from "../site/layouts/BaseLayout.astro";
import ArrowIcon from "../site/components/ArrowIcon.astro";
import FaultWalk from "../site/components/fault-walk/FaultWalk.astro";
import FaultWalkHero from "../site/components/fault-walk/FaultWalkHero.astro";
import SwapTest from "../site/components/fault-walk/SwapTest.astro";
import type { FaultWalk as FaultWalkData, SwapTestTheme } from "../site/data/fault-walks";
import { whatWeLookFor } from "../site/data/fault-walks";
import { ogImages } from "../site/data/og-images";
import "../site/styles/what-we-look-for.css";

const walks = whatWeLookFor.filter((entry): entry is FaultWalkData => entry.kind === "walk");
const swap = whatWeLookFor.find((entry): entry is SwapTestTheme => entry.kind === "swap");
if (!swap) throw new Error("where-it-fails: the swap test is missing from the reel");

/* Page order is 1–5. Internal theme ids (t1, t4…) stay in data and anchors
   only — never as guest-facing labels. The strip derives from the reel
   itself: a group starts wherever the parts map has an entry, and every
   number is the walk's own position — nothing is hardcoded to today's five. */
type StripItem = { href: string; task: string; n: number; verdict: string };
type StripGroup = { tag: string; label: string; start: number; items: StripItem[] };

/* The five run as three movements: the access snags, the identity snag,
   then the swap test as the closer. The bands are the pacing — they break a
   scroll into an argument with a beginning, a turn and an ending. */
const parts: Record<
  string,
  { tag: string; stripLabel: string; title: string; blurb: string }
> = {
  t1: {
    tag: "Part one",
    stripLabel: "Something simple gets hard",
    title: "Three ordinary jobs, stopped or made hard.",
    blurb:
      "Each one below started as a reasonable decision. Try it yourself and feel where it breaks.",
  },
  t7: {
    tag: "Part two",
    stripLabel: "It could be anyone's",
    title: "A working site that stopped sounding like anyone.",
    blurb: "Nothing here is broken. That is what makes this one harder to spot.",
  },
};

/* The verdict under each errand: does the snag stop the visitor outright,
   or let them through at a cost? That is part one's point against part two's. */
const verdictFor = (walk: FaultWalkData) =>
  walk.stop.kind === "blocked" ? "stops you" : "found, at a cost";

const strip: StripGroup[] = [];
walks.forEach((walk, index) => {
  const part = parts[walk.id];
  if (part || strip.length === 0) {
    strip.push({
      tag: part?.tag ?? "Part one",
      label: part?.stripLabel ?? "",
      start: index + 1,
      items: [],
    });
  }
  strip.at(-1)!.items.push({
    href: `#${walk.id}`,
    task: walk.errand.toLowerCase(),
    n: index + 1,
    verdict: verdictFor(walk),
  });
});
strip.push({
  tag: "The closer",
  label: "Done by hand",
  start: walks.length + 1,
  items: [
    {
      href: `#${swap.id}`,
      task: "tell two shopfronts apart",
      n: walks.length + 1,
      verdict: "by hand",
    },
  ],
});
---

<BaseLayout
  title="Where it fails — Mourne Made"
  description="Five ordinary things a visitor tries on a local site — and what each one costs them when the site isn’t ready."
  ogImage={ogImages.studio}
  ogImageAlt="Mourne Made — local websites for Dundrum and Newcastle"
>
  <div class="wwlf">
    <section class="wwlf-hero">
      <div class="shell wwlf-hero-grid">
        <p class="wwlf-hero-count" aria-hidden="true">5</p>
        <div class="wwlf-hero-copy">
          <p class="eyebrow">Mourne Made</p>
          <h1>Where it fails.</h1>
          <p class="lede">
            Five ordinary things a visitor tries on a local site — and what each one costs them
            when the site isn’t ready.
          </p>
          <p class="wwlf-howto">
            <span class="wwlf-howto-lead">How it works.</span>
            Tap around inside each phone. You'll get stuck, or you'll have to hunt — that wasted
            effort is the point. Then press <strong>Fix it</strong> and try the same thing again.
          </p>
          <p class="wwlf-invented">
            These are made-up sites — grey blocks, no business names. If we find the same thing on
            your site, it stays between us.
          </p>
        </div>
        <FaultWalkHero />
      </div>
    </section>

    <nav class="wwlf-index" aria-label="Five things a visitor might try">
      <div class="shell">
        <h2>Five things a visitor might try.</h2>
        <div class="wwlf-strip">
          {
            strip.map((group) => (
              <section class="wwlf-strip-group">
                <h3>
                  <span>{group.tag}</span> {group.label}
                </h3>
                <ol start={group.start}>
                  {group.items.map((item) => (
                    <li>
                      <a href={item.href} data-walk-ref={item.href.slice(1)}>
                        <span class="wwlf-strip-n">{item.n}</span>
                        <span class="wwlf-strip-task">{item.task}</span>
                        <span class="wwlf-strip-verdict">{item.verdict}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </section>
            ))
          }
        </div>
      </div>
    </nav>

    <div class="wwlf-themes">
      <div class="shell">
        {
          walks.map((walk, index) => {
            const part = parts[walk.id];
            const n = index + 1;
            return (
              <>
                {part && (
                  <header class="wwlf-part">
                    <p class="wwlf-part-tag">{part.tag}</p>
                    <h2 class="wwlf-part-title">{part.title}</h2>
                    <p class="wwlf-part-blurb">{part.blurb}</p>
                  </header>
                )}
                <FaultWalk walk={walk} n={n} />
              </>
            );
          })
        }
      </div>
    </div>

    <aside class="wwlf-midcta">
      <div class="shell">
        <div class="wwlf-midcta-copy">
          <p>
            Recognised your own site a couple of times already? That's the norm — every one of
            these started as a reasonable decision.
          </p>
          <a href="/request/">
            Send a link — we'll walk your site the same way <ArrowIcon />
          </a>
        </div>
        <figure class="wwlf-offer-plates">
          <div aria-hidden="true">
            <img
              src="/media/studio/show-the-change-closed.png"
              alt=""
              width="1672"
              height="941"
              loading="lazy"
            />
            <img
              src="/media/studio/show-the-change-open.png"
              alt=""
              width="1672"
              height="941"
              loading="lazy"
            />
          </div>
          <figcaption>
            <strong>Send the link. See the change. No obligation.</strong>
            <span>Synthetic paper study; no real business or result is shown.</span>
          </figcaption>
        </figure>
      </div>
    </aside>

    <section class="wwlf-finale">
      <div class="shell">
        <header class="wwlf-part">
          <p class="wwlf-part-tag">The closer</p>
          <h2 class="wwlf-part-title">The last check is done by hand.</h2>
          <p class="wwlf-part-blurb">
            Not a job to finish — a quick test on two made-up shopfronts.
          </p>
        </header>
        <SwapTest theme={swap} n={walks.length + 1} />
      </div>
    </section>

    <section class="wwlf-checklist">
      <div class="shell">
        <p class="eyebrow">Take it with you</p>
        <h2>Run the five on your own site.</h2>
        <p class="wwlf-checklist-lede">
          One question per check, in the same order as the walks above. Any "no" is something a
          visitor is already paying for.
        </p>
        <ol class="wwlf-checklist-list">
          {
            walks.map((walk, index) => (
              <li>
                <a href={`#${walk.id}`} data-walk-ref={walk.id}>
                  <span class="wwlf-checklist-n">{String(index + 1).padStart(2, "0")}</span>
                  <span class="wwlf-checklist-q">{walk.check}</span>
                </a>
              </li>
            ))
          }
          <li>
            <a href={`#${swap.id}`} data-walk-ref={swap.id}>
              <span class="wwlf-checklist-n">
                {String(walks.length + 1).padStart(2, "0")}
              </span>
              <span class="wwlf-checklist-q">{swap.check}</span>
            </a>
          </li>
        </ol>
      </div>
    </section>

    <section class="wwlf-close">
      <div class="shell">
        <p class="eyebrow">Your turn</p>
        <h2>Send a link. We'll walk your site the same way.</h2>
        <p>
          We note what stops a visitor, fix the worst of it as a free before-and-after, and show
          you both. No obligation.
        </p>
        <a class="button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { mountFaultWalks, mountShareLinks } from "../site/scripts/fault-walk";

  mountShareLinks();
  mountFaultWalks();
</script>
