---
import BaseLayout from "../../site/layouts/BaseLayout.astro";
import RebuildStage from "../../site/components/RebuildStage.astro";
import MotionCompare from "../../site/components/MotionCompare.astro";
import ReelPlayer from "../../site/components/ReelPlayer.astro";
import JourneyCase from "../../site/components/JourneyCase.astro";
import Disclosure from "../../site/components/Disclosure.astro";
import ArrowIcon from "../../site/components/ArrowIcon.astro";
import DesignNotes from "../../site/components/DesignNotes.astro";
import TransformationNav from "../../site/components/TransformationNav.astro";
import { transformations, type Transformation } from "../../site/data/transformations";
import { transformationOgImage } from "../../site/data/og-images";
import {
  transformationDetails,
  type TransformationDetail,
} from "../../site/data/transformation-details";

export function getStaticPaths() {
  const details: Record<string, TransformationDetail> = transformationDetails;

  return transformations.map((transformation) => ({
    params: { slug: transformation.slug },
    props: {
      transformation,
      detail: details[transformation.slug],
    },
  }));
}

interface Props {
  transformation: Transformation;
  detail: TransformationDetail;
}

const { transformation, detail } = Astro.props;
const motion = detail.motion;
const claimUrl = `/request/?business=${encodeURIComponent(transformation.name)}&town=${encodeURIComponent(transformation.town)}&source=transformation`;
const responsiveImages = (html: string) =>
  html.replace(
    /<img(\s+[^>]*?)src="((\/media\/(?:concepts\/[^/]+|place)\/)([^"]+))\.jpg"([^>]*?)\/?>/g,
    (_match, before, source, dir, stem, after) =>
      `<picture class="responsive-content-picture"><source type="image/webp" srcset="${dir}${stem}-640.webp 640w, ${dir}${stem}-1265.webp 1265w" sizes="(max-width: 720px) 100vw, 1180px"><img${before}src="${source}.jpg"${after}></picture>`,
  );
const secondSurfaces = detail.secondSurfacesHtml.map(responsiveImages);
---

<BaseLayout
  title={detail.title}
  description={detail.description}
  ogImage={transformationOgImage(transformation.slug)}
  ogImageAlt={`Before-and-after website concept for ${transformation.name} in ${transformation.town}`}
>
  <section class="case-hero">
    <div class="shell">
      <p class="eyebrow">{detail.eyebrow}</p>
      <h1>{detail.headline}</h1>
      <div class="case-meta">
        <span>{transformation.name}</span>
        <span>Concept study</span>
        <span>{detail.date}</span>
      </div>
    </div>
  </section>

  <section class="comparison-section">
    <div class="shell">
      <div class="comparison-intro">
        <h2>Before vs after</h2>
        <p>{detail.comparisonIntro}</p>
      </div>
      <Disclosure reminder />
      <RebuildStage
        before={transformation.before}
        after={transformation.after}
        beforeAlt={transformation.beforeAlt}
        afterAlt={transformation.afterAlt}
      />
      <div class="case-actions">
        <a class="button" data-claim-link href={claimUrl}>Is this your business? Claim this concept <ArrowIcon /></a>
        <a class="text-link concept-link" href={detail.conceptHref}>{detail.conceptLabel} <ArrowIcon /></a>
      </div>
    </div>
  </section>

  <MotionCompare
    slug={transformation.slug}
    beforeVideo={motion.beforeVideo}
    afterVideo={motion.afterVideo}
    beforePoster={motion.beforePoster}
    afterPoster={motion.afterPoster}
    beforeAlt={motion.beforeAlt}
    afterAlt={motion.afterAlt}
    beforeNote={motion.beforeNote}
  />

  {detail.journeys && (
    <JourneyCase slug={transformation.slug} journeys={detail.journeys} />
  )}

  {detail.reel && (
    <ReelPlayer
      slug={transformation.slug}
      video={detail.reel.video}
      poster={detail.reel.poster}
      alt={detail.reel.alt}
      heading={detail.reel.heading}
      intro={detail.reel.intro}
      duration={detail.reel.duration}
    />
  )}

  {secondSurfaces.map((html) => <Fragment set:html={html} />)}

  <DesignNotes heading={detail.notesHeading} notes={detail.notes} />

  <Fragment set:html={detail.sourceHtml} />

  <TransformationNav />
</BaseLayout>

<script>
  /* The QR on a printed sheet lands here, not on /request/, so this page is
     the hop where attribution used to die: the claim CTA is prerendered with
     source=transformation and knew nothing about the sheet that sent the
     visitor (docs/adr/0002).

     A sheet's slug is carried through even when it does not match this page.
     That is deliberate — a scan of one business's sheet that ends in a request
     for a different business is still the sheet that caused it. */
  const claim = document.querySelector<HTMLAnchorElement>("a[data-claim-link]");
  const incoming = new URLSearchParams(window.location.search).get("source");
  if (claim && incoming && /^onesheet-[a-z][a-z\d-]{0,60}$/.test(incoming)) {
    const url = new URL(claim.href, window.location.origin);
    url.searchParams.set("source", incoming);
    claim.href = `${url.pathname}${url.search}`;
  }
</script>
