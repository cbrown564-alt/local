---
import BaseLayout from "../../site/layouts/BaseLayout.astro";
import ArrowIcon from "../../site/components/ArrowIcon.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";
import { transformations } from "../../site/data/transformations";
import "../../site/styles/transformations.css";

const towns = ["All towns", "Dundrum", "Newcastle"] as const;
const categories = ["All types", ...[...new Set(transformations.map((item) => item.category))]];
const hasPublicTransformations = transformations.length > 0;
---

<BaseLayout
  title={
    hasPublicTransformations
      ? "Local transformations — Mourne Made"
      : "Portfolio review in progress — Mourne Made"
  }
  description={
    hasPublicTransformations
      ? "Browse clear, respectful before-and-after website concepts for businesses around Dundrum and Newcastle."
      : "Mourne Made's public concept portfolio is temporarily closed while every example is independently reviewed against a new publication standard."
  }
>
  <section class="page-hero page-hero--list">
    <div class="shell">
      <p class="eyebrow">{hasPublicTransformations ? "Local transformations" : "Publication update"}</p>
      <h1>
        {hasPublicTransformations
          ? `${transformations.length} local website concepts, ready to browse.`
          : "The portfolio is being re-reviewed."}
      </h1>
      <p class="lede">
        {hasPublicTransformations
          ? "Finished concept screens for real businesses in Dundrum and Newcastle. Filter the work, then open a full before-and-after when you want the detail."
          : "We introduced a stricter publication standard and applied it to every earlier concept. Public examples are temporarily held until they have complete evidence and an independent Pass."}
      </p>
      {hasPublicTransformations && (
        <p class="page-hero-claim">
          Each concept was made for one business — if one of these is yours, it's yours to claim.
        </p>
      )}
    </div>
  </section>

  <section class="transformation-list" data-transformation-list>
    <div class="shell">
      {hasPublicTransformations ? (
        <>
      <div class="owner-filters" aria-label="Filter transformations">
        <div class="owner-filter-group">
          <p class="owner-filter-label" id="town-filter-label">Town</p>
          <div class="owner-filter-pills" role="group" aria-labelledby="town-filter-label">
            {towns.map((town, index) => (
              <button
                type="button"
                class:list={["owner-filter-pill", { "is-active": index === 0 }]}
                data-filter="town"
                data-value={town === "All towns" ? "" : town}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                {town}
              </button>
            ))}
          </div>
        </div>
        <div class="owner-filter-group">
          <p class="owner-filter-label" id="type-filter-label">Type</p>
          <div class="owner-filter-pills" role="group" aria-labelledby="type-filter-label">
            {categories.map((category, index) => (
              <button
                type="button"
                class:list={["owner-filter-pill", { "is-active": index === 0 }]}
                data-filter="category"
                data-value={category === "All types" ? "" : category}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                {category}
              </button>
            ))}
          </div>
        </div>
      </div>

      <p class="owner-filter-status" data-filter-status aria-live="polite">
        Showing {transformations.length} transformations
      </p>

      <div class="transformation-detail-head">
        <p class="eyebrow">Browse the work</p>
        <h2>Choose a case study.</h2>
        <p class="transformation-detail-lede">Each card opens the full comparison, motion demos, design notes and source record.</p>
      </div>

      <div class="transformation-card-grid">
        {transformations.map((item) => (
          <article
            class="transformation-card"
            data-transformation-card
            data-town={item.town}
            data-category={item.category}
          >
            <a class="transformation-preview" href={item.href} aria-label={`Open the ${item.name} case study`}>
              <ResponsiveImage
                src={item.after}
                alt={item.afterAlt}
                width="1265"
                height="710"
                loading="lazy"
                sizes="(max-width: 720px) 100vw, (max-width: 1100px) 50vw, 390px"
              />
            </a>
            <div class="transformation-card-copy">
              <div class="transformation-tags">
                <span class="tag">{item.town}</span>
                <span class="tag tag-muted">{item.category}</span>
              </div>
              <h2>{item.name}</h2>
              <p>{item.summary}</p>
              <a class="text-link" href={item.href}>Open the full comparison <ArrowIcon /></a>
            </div>
          </article>
        ))}
      </div>

      <p class="owner-filter-empty" data-filter-empty hidden>
        No transformations match those filters yet. Clear a filter or
        <a href="/request/">request a free before-and-after</a> for your own business.
      </p>
        </>
      ) : (
        <div class="portfolio-review-state">
          <div class="portfolio-review-statement">
            <p class="portfolio-review-label">Current release state</p>
            <h2>No concept is public just because it used to be.</h2>
            <p>
              Earlier work remains available only as internal, noindex concept
              routes while its sources, asset rights, visitor journey,
              responsive behaviour and finish are checked. Historical scores
              do not count as approval.
            </p>
            <div class="button-row">
              <a class="button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
            </div>
          </div>
          <dl class="portfolio-review-standard">
            <div>
              <dt>Independent review</dt>
              <dd>One non-creator reviewer must inspect the live phone and desktop experience.</dd>
            </div>
            <div>
              <dt>Mandatory gates</dt>
              <dd>Truth, asset rights, subject proof, a real visitor loop, access and repository checks must all pass.</dd>
            </div>
            <div>
              <dt>Minimum score</dt>
              <dd>Every category and the weighted result must reach at least 7.0 out of 10.</dd>
            </div>
            <div>
              <dt>Return to public</dt>
              <dd>Passing concepts come back individually. None is grandfathered.</dd>
            </div>
          </dl>
        </div>
      )}
    </div>
  </section>

  <section class="mockup-includes">
    <div class="shell mockup-includes-grid">
      <div>
        <p class="eyebrow">What you get</p>
        <h2>What a free before-and-after includes.</h2>
        <p class="mockup-includes-lede">A small, concrete look at one useful screen — enough to judge the direction without a sales call.</p>
      </div>
      <ol class="mockup-includes-list">
        <li>
          <strong>One focused screen</strong>
          <span>Usually the opening page, booking path or the content that matters most to you.</span>
        </li>
        <li>
          <strong>A clear before-and-after</strong>
          <span>The before screen beside the after you can slide and compare.</span>
        </li>
        <li>
          <strong>Plain-language notes</strong>
          <span>What changed and why, written without jargon and without mocking the current site.</span>
        </li>
        <li>
          <strong>No obligation</strong>
          <span>Independent concept work from public information. You decide whether a conversation is worth having.</span>
        </li>
      </ol>
    </div>
  </section>

  <section class="trust-ladder">
    <div class="shell">
      <p class="eyebrow">How the ask stays low-risk</p>
      <h2>A short ladder from curiosity to a clear yes or no.</h2>
      <ol class="trust-ladder-list">
        <li>
          <span class="trust-ladder-num">01</span>
          <div>
            <h3>We look at what the public already sees</h3>
            <p>Website, listing or menu — the same material a customer finds today.</p>
          </div>
        </li>
        <li>
          <span class="trust-ladder-num">02</span>
          <div>
            <h3>You receive a focused before-and-after</h3>
            <p>One screen, labelled as an independent concept until any real client work begins.</p>
          </div>
        </li>
        <li>
          <span class="trust-ladder-num">03</span>
          <div>
            <h3>You judge the difference yourself</h3>
            <p>If it helps, we talk about paid work or a community contribution. If not, nothing further is owed.</p>
          </div>
        </li>
      </ol>
      <div class="button-row">
        <a class="button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
        <a class="text-link" href="/about/">Why local comes first <ArrowIcon /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-transformation-list]");
  if (root) {
    const cards = [...root.querySelectorAll<HTMLElement>("[data-transformation-card]")];
    const status = root.querySelector<HTMLElement>("[data-filter-status]");
    const empty = root.querySelector<HTMLElement>("[data-filter-empty]");
    const filters = {
      town: "",
      category: "",
    };

    const applyFilters = () => {
      let visible = 0;
      const match = (town: string | undefined, category: string | undefined) => {
        const townMatch = !filters.town || town === filters.town;
        const categoryMatch = !filters.category || category === filters.category;
        return townMatch && categoryMatch;
      };

      cards.forEach((card) => {
        const show = match(card.dataset.town, card.dataset.category);
        card.hidden = !show;
        if (show) visible += 1;
      });

      if (status) {
        status.textContent =
          visible === 1 ? "Showing 1 transformation" : `Showing ${visible} transformations`;
      }
      if (empty) empty.hidden = visible !== 0;
    };

    root.querySelectorAll<HTMLButtonElement>(".owner-filter-pill").forEach((button) => {
      button.addEventListener("click", () => {
        const key = button.dataset.filter as "town" | "category" | undefined;
        if (!key) return;
        filters[key] = button.dataset.value ?? "";
        root.querySelectorAll<HTMLButtonElement>(`.owner-filter-pill[data-filter="${key}"]`).forEach((peer) => {
          const active = peer === button;
          peer.classList.toggle("is-active", active);
          peer.setAttribute("aria-pressed", String(active));
        });
        applyFilters();
      });
    });
  }
</script>
