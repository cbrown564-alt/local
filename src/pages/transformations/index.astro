---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Disclosure from "../../components/Disclosure.astro";
import transformations from "../../data/transformations.json";
import "../../styles/transformations-gallery.css";

const dataJson = JSON.stringify(transformations).replaceAll("<", "\\u003c");
---

<BaseLayout title="Local transformations — Mourne & Main" description="Browse clear, respectful before-and-after website concepts for businesses around Dundrum and Newcastle.">
  <section class="page-hero">
    <div class="shell page-hero-grid">
      <div>
        <p class="eyebrow">Local transformations</p>
        <h1>Judge the work by the difference.</h1>
      </div>
      <p class="page-hero-meta">Each concept starts with public information. Current presentation, proposed change and supporting sources stay visibly separate.</p>
    </div>
  </section>

  <section class="transformation-gallery" data-transformations-gallery>
    <div class="shell">
      <Disclosure />

      <div class="tg-filterbar" id="transformation-filters" aria-label="Filter transformations">
        <label class="tg-search">
          <span class="tg-visually-hidden">Search by business name</span>
          <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
          <input type="search" data-filter="search" placeholder="Search by business name" autocomplete="off" />
        </label>
        <label>
          <span id="town-filter-label">Town</span>
          <select data-filter="town" aria-labelledby="town-filter-label">
            <option value="">All</option>
            <option value="Dundrum">Dundrum</option>
            <option value="Newcastle">Newcastle</option>
          </select>
        </label>
        <label>
          <span id="type-filter-label">Type</span>
          <select data-filter="type" aria-labelledby="type-filter-label">
            <option value="">All</option>
            <option value="first-website">First website</option>
            <option value="redesign">Website refresh</option>
          </select>
        </label>
        <button class="tg-clear" type="button" data-clear-filters>Clear filters</button>
      </div>

      <p class="tg-results-summary" data-results-summary aria-live="polite"></p>

      <div data-gallery-root></div>

      <div class="tg-empty" data-empty hidden>
        <h2>No transformations match these filters</h2>
        <p>Try clearing the filters or broadening your search.</p>
        <button class="tg-clear" type="button" data-clear-filters>Clear filters</button>
      </div>

      <section class="tg-coming" data-coming-section aria-labelledby="coming-heading">
        <h2 class="tg-section-heading" id="coming-heading">Coming soon</h2>
        <div class="tg-coming-row" aria-label="Next research subjects">
          <article class="tg-coming-card">
            <span>Concept queue · Newcastle</span>
            <div>
              <h3>Three verified prospects</h3>
              <p>A hardware yard, a seaside amusement arcade and the town's chamber of commerce — researched and verified against public sources in July 2026.</p>
            </div>
          </article>
          <article class="tg-coming-card">
            <span>Community queue · Newcastle</span>
            <div>
              <h3>Newcastle Chamber of Commerce</h3>
              <p>A civic hub concept planned as a visible community contribution.</p>
            </div>
          </article>
        </div>
      </section>
    </div>
  </section>

  <script id="transformation-data" type="application/json" is:inline set:html={dataJson}></script>

  <script>
    type Transformation = {
      slug: string;
      name: string;
      town: string;
      type: "first-website" | "redesign";
      categoryLabel: string;
      tag: string;
      description: string;
      conceptImage: string;
      currentImage: string;
      href: string;
      featured?: boolean;
    };

    const rootNode = document.querySelector<HTMLElement>("[data-transformations-gallery]");
    const dataNode = document.querySelector<HTMLScriptElement>("#transformation-data");
    if (!rootNode || !dataNode) throw new Error("Transformation gallery could not start.");

    const root = rootNode;
    const items = JSON.parse(dataNode.textContent || "[]") as Transformation[];

    const filters = {
      search: root.querySelector<HTMLInputElement>('[data-filter="search"]'),
      town: root.querySelector<HTMLSelectElement>('[data-filter="town"]'),
      type: root.querySelector<HTMLSelectElement>('[data-filter="type"]'),
    };

    const galleryRoot = root.querySelector<HTMLElement>("[data-gallery-root]");
    const emptyState = root.querySelector<HTMLElement>("[data-empty]");
    const comingSection = root.querySelector<HTMLElement>("[data-coming-section]");
    const summary = root.querySelector<HTMLElement>("[data-results-summary]");

    function escapeHtml(value: unknown) {
      return String(value ?? "").replace(/[&<>'"]/g, (character) => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;",
      })[character] || character);
    }

    function hasActiveFilters() {
      return Boolean(
        filters.search?.value.trim()
        || filters.town?.value
        || filters.type?.value,
      );
    }

    function filteredItems() {
      const search = filters.search?.value.trim().toLocaleLowerCase("en-GB") || "";
      const town = filters.town?.value || "";
      const type = filters.type?.value || "";

      return items.filter((item) => {
        if (search && !item.name.toLocaleLowerCase("en-GB").includes(search)) return false;
        if (town && item.town !== town) return false;
        if (type && item.type !== type) return false;
        return true;
      });
    }

    function renderCard(item: Transformation, featuredLayout = false) {
      const headingTag = featuredLayout ? "h2" : "h3";
      const featuredBadge = featuredLayout && item.featured
        ? '<span class="tg-featured-badge">Featured</span>'
        : item.featured
          ? '<span class="tg-featured-badge">Featured</span>'
          : "";

      return `<article class="tg-card${featuredLayout ? " tg-card-featured" : ""}">
        <a class="tg-card-link" href="${escapeHtml(item.href)}">
          <div class="tg-card-preview">
            <img class="tg-card-current" src="${escapeHtml(item.currentImage)}" alt="Current homepage for ${escapeHtml(item.name)}" width="1265" height="710" loading="lazy" />
            <img class="tg-card-concept" src="${escapeHtml(item.conceptImage)}" alt="Homepage concept for ${escapeHtml(item.name)}" width="1265" height="710" loading="lazy" />
            <span class="tg-card-handle" aria-hidden="true"></span>
            <span class="tg-split-label tg-split-before">Current</span>
            <span class="tg-split-label tg-split-after">Concept</span>
          </div>
          <div class="tg-card-body">
            ${featuredBadge}
            <span class="tag">${escapeHtml(item.tag)}</span>
            <${headingTag}>${escapeHtml(item.name)}</${headingTag}>
            <p>${escapeHtml(item.description)}</p>
            <span class="tg-card-cta">Open the comparison <svg aria-hidden="true" viewBox="0 0 16 16"><path fill="currentColor" d="M3 8h8M9 5l3 3-3 3"/></svg></span>
          </div>
        </a>
      </article>`;
    }

    function renderSection(title: string, sectionItems: Transformation[], gridClass = "tg-grid") {
      if (!sectionItems.length) return "";
      return `<section class="tg-section" aria-labelledby="${escapeHtml(title.replace(/\s+/g, "-").toLowerCase())}">
        <h2 class="tg-section-heading" id="${escapeHtml(title.replace(/\s+/g, "-").toLowerCase())}">${escapeHtml(title)}</h2>
        <div class="${gridClass}">
          ${sectionItems.map((item) => renderCard(item)).join("")}
        </div>
      </section>`;
    }

    function renderGallery() {
      if (!galleryRoot || !emptyState || !comingSection || !summary) return;

      const active = hasActiveFilters();
      const visible = filteredItems();

      if (!active) {
        const featured = items.find((item) => item.featured);
        const firstWebsites = items.filter((item) => item.type === "first-website");
        const refreshes = items.filter((item) => item.type === "redesign" && item.slug !== featured?.slug);

        galleryRoot.innerHTML = [
          featured ? `<div class="tg-grid-featured">${renderCard(featured, true)}</div>` : "",
          renderSection("First websites", firstWebsites),
          renderSection("Website refreshes", refreshes),
        ].join("");

        comingSection.hidden = false;
        summary.textContent = `${items.length} transformations`;
      } else {
        galleryRoot.innerHTML = visible.length
          ? `<div class="tg-grid">${visible.map((item) => renderCard(item)).join("")}</div>`
          : "";

        comingSection.hidden = true;
        summary.textContent = visible.length === items.length
          ? `${visible.length} transformations`
          : `${visible.length} of ${items.length} transformations`;
      }

      emptyState.hidden = visible.length !== 0;
      galleryRoot.hidden = visible.length === 0;
    }

    function clearFilters() {
      if (filters.search) filters.search.value = "";
      if (filters.town) filters.town.value = "";
      if (filters.type) filters.type.value = "";
      renderGallery();
    }

    Object.values(filters).forEach((control) => control?.addEventListener("input", renderGallery));

    root.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("[data-clear-filters]")) clearFilters();
    });

    renderGallery();
  </script>
</BaseLayout>
