---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BeforeAfter from "../../components/BeforeAfter.astro";
import Disclosure from "../../components/Disclosure.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
import DesignNotes from "../../components/DesignNotes.astro";

const notes = [
  {
    title: "Take the promenade out from behind the login",
    body: "Kent Amusements has no website. Searching for it lands on a Facebook page that greets a first-time visitor with Meta's cookie dialog and a login form — the arcade on Newcastle's Central Promenade sits greyed out behind them.",
    change: "A first screen with nothing in front of it, opening on the one place fact that matters: fifty summers of family fun on the Central Promenade.",
  },
  {
    title: "Name what is inside before someone has to ask",
    body: "Dodgems, the arcade floor and the new VR games live only as fragments across feed posts and third-party write-ups, so a family planning a day out has to scroll to learn what is actually there.",
    change: "The attractions named once along the foot of the screen — dodgems, VR, arcade — with the phone number the business already publishes one tap away.",
  },
  {
    title: "Give seasonal hours and family offers a standing place",
    body: "Opening times and family deals change with the season and are posted to social, so they exist only for people who already follow the page.",
    change: "A standing hours-and-offers ticket that always points at the same Facebook page the arcade already updates — the feed keeps doing the updating, behind a page that never goes stale.",
  },
];
---

<BaseLayout title="Kent Amusements concept transformation — Mourne & Main" description="A respectful, source-backed first-website concept for Kent Amusements, the seaside arcade on Newcastle's Central Promenade.">
  <section class="case-hero">
    <div class="shell">
      <Disclosure />
      <p class="eyebrow">First website · Newcastle</p>
      <h1>A first page for the promenade arcade.</h1>
      <div class="case-meta"><span>Kent Amusements</span><span>Concept study</span><span>22 July 2026</span></div>
    </div>
  </section>

  <section class="comparison-section">
    <div class="shell">
      <div class="comparison-intro">
        <h2>Current vs concept</h2>
        <p>Drag the handle. The left shows what a first-time visitor currently finds — the arcade's Facebook page as it loads without an account; the right shows the proposed first screen.</p>
      </div>
      <BeforeAfter
        before="/images/kent-amusements-current.jpg"
        after="/images/kent-amusements-concept.jpg"
        beforeAlt="Kent Amusements' current public presence: its Facebook page covered by Meta's cookie consent dialog and login form, with the arcade's introduction greyed out behind them"
        afterAlt="Mourne and Main concept opening in pier navy, spray mist and ticket amber, with the Fifty summers on the Central Promenade headline, a promenade marquee illustration, a family-offers ticket and an attractions rail"
      />
      <a class="text-link concept-link" href="/concepts/kent-amusements/">View the full concept screen <ArrowIcon /></a>
    </div>
  </section>

  <DesignNotes heading="Three changes to put the promenade out front." notes={notes} />

  <section class="source-section">
    <div class="shell source-grid">
      <div>
        <p class="eyebrow">Sources &amp; limits</p>
        <h2>Clear about what is real.</h2>
      </div>
      <div>
        <p>The current-presence image was captured from the arcade's public Facebook page on 22 July 2026, with Meta's cookie dialog and login prompt left in place — that is what a first-time visitor without an account meets. The Central Promenade address, the fifty-year trading claim, indoor dodgems, the March 2026 VR mention and the published phone number come from the arcade's public presence, Companies House (NI688147), TripAdvisor and local directories. The concept introduces no photography; the marquee illustration and ticket mark are concept work, not the business's own artwork. Content is limited to the Newcastle, Co. Down site and does not refer to any same-named arcade elsewhere. The layout, copy hierarchy and proposed experience are independent concept work.</p>
        <ul>
          <li><a href="https://www.facebook.com/kentamusementsnewcastle/" rel="external">Kent Amusements public Facebook page</a></li>
          <li><a href="https://www.instagram.com/kentamusementsnewcastle/" rel="external">Kent Amusements Instagram</a></li>
          <li><a href="https://www.tripadvisor.com/Attraction_Review-g186478-d14073725" rel="external">TripAdvisor listing used to verify current trading and VR</a></li>
          <li><a href="https://find-and-update.company-information.service.gov.uk/company/NI688147" rel="external">Companies House record used to verify the business</a></li>
        </ul>
        <p>No claim is made about sales performance, customer approval or the owner's plans for a website.</p>
        <a class="button" href="/request/">Request a free before-and-after for your business <ArrowIcon /></a>
      </div>
    </div>
  </section>
</BaseLayout>
