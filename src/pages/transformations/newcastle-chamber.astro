---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BeforeAfter from "../../components/BeforeAfter.astro";
import MotionCompare from "../../components/MotionCompare.astro";
import Disclosure from "../../components/Disclosure.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
import DesignNotes from "../../components/DesignNotes.astro";

const notes = [
  {
    title: "Put Co. Down on the front door",
    body: "The Chamber has no website. Searching its name lands among at least eight same-named chambers worldwide, and its own public Facebook presence is hard for a first-time visitor to use as a standing front door.",
    change: "A finder opening that leads with Newcastle, Co. Down and Main Street under the Mournes — place first, then the directory, events and join path.",
  },
  {
    title: "Make the directory the product",
    body: "Member news and how to join live only as feed posts and a Gmail address, so someone looking for a trader on Main Street has to already know where to look.",
    change: "A Main Street finder first screen: search into a category directory, a trade rail, and a join path that sells visibility — the practical benefit a volunteer chamber can deliver.",
  },
  {
    title: "Keep the town calendar where visitors can find it",
    body: "Halloween in Newcastle on 31 October 2026 is listed on the council tourism site as planned primarily by the Chamber, but a passer-by who starts on social still has to dig for the next date.",
    change: "A standing events card on the opening screen, with a full calendar page behind it — updates still pointing at the Facebook and Instagram the Chamber already runs.",
  },
];

const sitePages = [
  { href: "/concepts/newcastle-chamber/", label: "Home", note: "Finder opening" },
  { href: "/concepts/newcastle-chamber/members/", label: "Members", note: "Directory by trade" },
  { href: "/concepts/newcastle-chamber/events/", label: "Events", note: "Town calendar" },
  { href: "/concepts/newcastle-chamber/join/", label: "Join", note: "Neighbour voice + mailto" },
  { href: "/concepts/newcastle-chamber/about/", label: "About", note: "Volunteer hub" },
  { href: "/concepts/newcastle-chamber/contact/", label: "Contact", note: "Inbox & Main Street" },
];
---

<BaseLayout title="Newcastle Chamber of Commerce concept transformation — Mourne & Main" description="A respectful, source-backed first-website concept for Newcastle Chamber of Commerce: a Main Street finder with civic chrome and a full linked site.">
  <section class="case-hero">
    <div class="shell">
      <p class="eyebrow">First website · Newcastle · full site</p>
      <h1>A Main Street finder for the town's chamber.</h1>
      <div class="case-meta"><span>Newcastle Chamber of Commerce</span><span>Concept study</span><span>22 July 2026</span></div>
    </div>
  </section>

  <section class="comparison-section">
    <div class="shell">
      <div class="comparison-intro">
        <h2>Before vs after</h2>
        <p>Drag the handle. The left shows what a first-time visitor currently finds — the Chamber's Facebook page as it loads without an account; the right shows the proposed finder opening.</p>
      </div>
      <Disclosure reminder />
      <BeforeAfter
        before="/images/newcastle-chamber-before.jpg"
        after="/images/newcastle-chamber-after.jpg"
        beforeAlt="Newcastle Chamber of Commerce's current public presence: its Facebook page covered by a login form, with the Chamber's introduction greyed out behind the wall"
        afterAlt="Mourne and Main concept opening: harbour-navy civic chrome with Find a business on Main Street headline, directory search, Halloween events card and trade category rail"
      />
      <a class="text-link concept-link" href="/concepts/newcastle-chamber/">View the full concept site <ArrowIcon /></a>
    </div>
  </section>

  <MotionCompare
    slug="newcastle-chamber"
    afterVideo="/videos/newcastle-chamber-after.mp4"
    beforePoster="/images/newcastle-chamber-before.jpg"
    afterPoster="/images/newcastle-chamber-after.jpg"
    beforeAlt="Newcastle Chamber of Commerce's current public presence: its Facebook page covered by a login form, with the Chamber's introduction greyed out behind the wall"
    afterAlt="Ten-second visit to the Newcastle Chamber concept — the town's businesses under one roof opening, the events card and the members-events-join rail"
  />

  <section class="second-surface">
    <div class="shell">
      <div class="second-surface-intro">
        <div>
          <p class="second-surface-label">Second surface · Members</p>
          <h2>A member directory for Main Street.</h2>
        </div>
        <p>Once a visitor lands, the next question is which businesses are in the Chamber — and how to join. The directory answers both without new infrastructure: members listed by trade, a path to the existing Gmail inbox.</p>
      </div>
      <div class="second-surface-frame">
        <img
          src="/images/newcastle-chamber-members-after.jpg"
          alt="Newcastle Chamber member directory concept: harbour-navy header with the chamber seal, a grid of business cards organised by trade category, and a Join the Chamber banner at the foot"
          width="1265"
          height="710"
          loading="lazy"
        />
      </div>
      <p class="second-surface-caption">Member cards use illustrative names that reflect the kinds of trade on Main Street, Newcastle, Co. Down. Actual listing managed by the Chamber committee.</p>
      <a class="text-link concept-link" href="/concepts/newcastle-chamber/members/">View the members concept screen <ArrowIcon /></a>
    </div>
  </section>

  <section class="second-surface" style="padding-top: 0">
    <div class="shell">
      <div class="second-surface-intro">
        <div>
          <p class="second-surface-label">Full site · every page linked</p>
          <h2>Chosen direction after exploration.</h2>
        </div>
        <p>
          Research and three prototypes at <a class="text-link" href="/prototypes/chamber/">/prototypes/chamber/</a>
          led to this hybrid: Main Street Finder IA, civic Co. Down chrome, and a warmer neighbour join voice.
          Mailto join matches volunteer capacity.
        </p>
      </div>
      <ul class="chamber-site-map">
        {sitePages.map((p) => (
          <li>
            <a href={p.href}><strong>{p.label}</strong><span>{p.note}</span></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <DesignNotes heading="Three changes to make the Chamber findable." notes={notes} />

  <section class="source-section">
    <div class="shell source-grid">
      <div>
        <p class="eyebrow">Sources &amp; limits</p>
        <h2>Clear about what is real.</h2>
      </div>
      <div>
        <p>The before image was captured from the Chamber's public Facebook page on 22 July 2026, with the login prompt left in place — that is what a first-time visitor without an account meets on this capture (no cookie dialog appeared in frame). The Co. Down naming, Main Street address, Gmail contact, phone, Instagram and LinkedIn, the 2023 relaunch and Halloween in Newcastle on 31 October 2026 come from the Chamber's public pages and the council tourism listing; Facebook's own intro line reads “Newcastle County Down Chamber of Commerce”. No officer names are stated — volunteer committee roles were unconfirmed snippet data at verification. The concept introduces no photography; the seal mark is concept work, not an official crest. Member listings and non-Halloween calendar rows are illustrative. The layout, copy hierarchy and proposed experience are independent concept work.</p>
        <ul>
          <li><a href="https://www.facebook.com/newcastlechamberofcommerce/" rel="external">Newcastle Chamber of Commerce public Facebook page</a></li>
          <li><a href="https://www.instagram.com/newcastlechamber_/" rel="external">Chamber Instagram</a></li>
          <li><a href="https://www.visitmournegullionstrangford.com/explore/cities-towns-and-villages/newcastle/whats-on-in-newcastle" rel="external">Council tourism listing used for Halloween 2026</a></li>
          <li><a href="https://uk.linkedin.com/company/newcastle-chamber" rel="external">LinkedIn company page used to verify the organisation</a></li>
          <li><a href="/prototypes/chamber/">Full-site prototype exploration (Civic · Main Street · Network)</a></li>
        </ul>
        <p>No claim is made about membership numbers, committee decisions or the Chamber's plans for a website.</p>
        <a class="button" href="/request/">Request a free before-and-after for your business <ArrowIcon /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .chamber-site-map {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .chamber-site-map a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    background: var(--white);
    text-decoration: none;
    color: inherit;
    transition: border-color 140ms ease, transform 140ms ease;
  }
  .chamber-site-map a:hover {
    border-color: #9aafbb;
    transform: translateY(-2px);
  }
  .chamber-site-map strong {
    font-family: var(--display);
    font-size: 22px;
    letter-spacing: -0.02em;
  }
  .chamber-site-map span {
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .chamber-site-map { grid-template-columns: 1fr 1fr; }
  }
</style>
