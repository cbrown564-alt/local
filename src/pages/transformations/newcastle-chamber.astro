---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BeforeAfter from "../../components/BeforeAfter.astro";
import Disclosure from "../../components/Disclosure.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
import DesignNotes from "../../components/DesignNotes.astro";

const notes = [
  {
    title: "Put Co. Down in front of the search pile",
    body: "The Chamber has no website. Searching its name lands among at least eight same-named chambers worldwide, and its own Facebook page greets a first-time visitor with a login form — \"Newcastle County Down Chamber of Commerce\" sits behind the wall.",
    change: "A first screen that leads with Newcastle, Co. Down and Main Street under the Mournes, so the town is unmistakable before anyone has to log in.",
  },
  {
    title: "Give the civic hub a standing front door",
    body: "Member news, town events and how to join live only as feed posts and a Gmail address, so someone looking for the Chamber has to already know where to look.",
    change: "A civic opening that names the three jobs — member directory, events, join — with the join action landing in the same inbox the volunteer committee already answers.",
  },
  {
    title: "Keep the town calendar where visitors can find it",
    body: "Halloween in Newcastle on 31 October 2026 is listed on the council tourism site as planned primarily by the Chamber, but a passer-by who starts at Facebook still has to scroll past a wall to reach the next date.",
    change: "A standing events card that holds the next town date up front, with updates pointing at the Facebook and Instagram the Chamber already runs — no invented officer names, and no claim the page replaces their committee work.",
  },
];
---

<BaseLayout title="Newcastle Chamber of Commerce concept transformation — Mourne & Main" description="A respectful, source-backed first-website concept for Newcastle Chamber of Commerce, the civic hub for traders in Newcastle, Co. Down.">
  <section class="case-hero">
    <div class="shell">
      <p class="eyebrow">First website · Newcastle</p>
      <h1>A front door for the town's chamber.</h1>
      <div class="case-meta"><span>Newcastle Chamber of Commerce</span><span>Concept study</span><span>22 July 2026</span></div>
    </div>
  </section>

  <section class="comparison-section">
    <div class="shell">
      <div class="comparison-intro">
        <h2>Before vs after</h2>
        <p>Drag the handle. The left shows what a first-time visitor currently finds — the Chamber's Facebook page as it loads without an account; the right shows the proposed first screen.</p>
      </div>
      <Disclosure reminder />
      <BeforeAfter
        before="/images/newcastle-chamber-before.jpg"
        after="/images/newcastle-chamber-after.jpg"
        beforeAlt="Newcastle Chamber of Commerce's current public presence: its Facebook page covered by a login form, with the Chamber's introduction greyed out behind the wall"
        afterAlt="Mourne and Main concept opening in harbour navy, sea mist and civic brass, with The town's businesses under one roof headline, a Halloween events card and a members-events-join rail"
      />
      <a class="text-link concept-link" href="/concepts/newcastle-chamber/">View the full concept screen <ArrowIcon /></a>
    </div>
  </section>

  <section class="second-surface">
    <div class="shell">
      <div class="second-surface-intro">
        <div>
          <p class="second-surface-label">Second surface · Members</p>
          <h2>A member directory for Main Street.</h2>
        </div>
        <p>Once a visitor lands, the next question is which businesses are in the Chamber — and how to join. The directory screen answers both without any new infrastructure: members listed by trade, a one-click path to the existing Gmail inbox.</p>
      </div>
      <div class="second-surface-frame">
        <img
          src="/images/newcastle-chamber-members-after.jpg"
          alt="Newcastle Chamber member directory concept: harbour-navy header with the chamber seal, a grid of business cards organised by trade category — Hospitality, Food & Drink, Retail, Services — and a Join the Chamber banner at the foot"
          width="1265"
          height="710"
          loading="lazy"
        />
      </div>
      <p class="second-surface-caption">Member cards use illustrative names that reflect the kinds of trade on Main Street, Newcastle, Co. Down. Actual listing managed by the Chamber committee.</p>
      <a class="text-link concept-link" href="/concepts/newcastle-chamber/members/">View the members concept screen <ArrowIcon /></a>
    </div>
  </section>

  <DesignNotes heading="Three changes to make the Chamber findable." notes={notes} />

  <section class="source-section">
    <div class="shell source-grid">
      <div>
        <p class="eyebrow">Sources &amp; limits</p>
        <h2>Clear about what is real.</h2>
      </div>
      <div>
        <p>The before image was captured from the Chamber's public Facebook page on 22 July 2026, with the login prompt left in place — that is what a first-time visitor without an account meets on this capture (no cookie dialog appeared in frame). The Co. Down naming, Main Street address, Gmail contact, phone, Instagram and LinkedIn, the 2023 relaunch and Halloween in Newcastle on 31 October 2026 come from the Chamber's public pages and the council tourism listing; Facebook's own intro line reads “Newcastle County Down Chamber of Commerce”. No officer names are stated — volunteer committee roles were unconfirmed snippet data at verification. The concept introduces no photography; the seal mark is concept work, not an official crest. The layout, copy hierarchy and proposed experience are independent concept work.</p>
        <ul>
          <li><a href="https://www.facebook.com/newcastlechamberofcommerce/" rel="external">Newcastle Chamber of Commerce public Facebook page</a></li>
          <li><a href="https://www.instagram.com/newcastlechamber_/" rel="external">Chamber Instagram</a></li>
          <li><a href="https://www.visitmournegullionstrangford.com/explore/cities-towns-and-villages/newcastle/whats-on-in-newcastle" rel="external">Council tourism listing used for Halloween 2026</a></li>
          <li><a href="https://uk.linkedin.com/company/newcastle-chamber" rel="external">LinkedIn company page used to verify the organisation</a></li>
        </ul>
        <p>No claim is made about membership numbers, committee decisions or the Chamber's plans for a website.</p>
        <a class="button" href="/request/">Request a free before-and-after for your business <ArrowIcon /></a>
      </div>
    </div>
  </section>
</BaseLayout>
