---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BeforeAfter from "../../components/BeforeAfter.astro";
import Disclosure from "../../components/Disclosure.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
import DesignNotes from "../../components/DesignNotes.astro";

const notes = [
  {
    title: "Open with the valley, not the archive",
    body: "The captured page leads with an oval archive photograph, a blue serif title and seven uppercase menu items — while the hotel's own phrase, a mountainside hideaway, appears nowhere on the first screen.",
    change: "One composed scene — the valley framed from a balcony room, the hideaway line as the headline, and four quiet navigation items.",
  },
  {
    title: "Make checking dates effortless",
    body: "Book Now is one menu item among seven, and checking availability means leaving for the booking engine with no dates in hand.",
    change: "A persistent availability bar — arrive, nights, guests — that passes straight into the hotel's existing Bookin1 engine.",
  },
  {
    title: "Let the estate do the selling",
    body: "Twelve wooded acres, the river trail, Mourne Honey afternoon tea and the Brandy Pad Lounge are real, published draws — but they all live behind dropdown menus.",
    change: "The opening copy carries the estate's story in one breath, with afternoon tea one step away.",
  },
];
---

<BaseLayout title="Hotel Enniskeen concept transformation — Mourne & Main" description="A respectful, source-backed before-and-after website concept for Enniskeen Country House Hotel in Newcastle.">
  <section class="case-hero">
    <div class="shell">
      <p class="eyebrow">Website transformation · Newcastle</p>
      <h1>Let the valley make the welcome.</h1>
      <div class="case-meta"><span>Enniskeen Country House Hotel</span><span>Concept study</span><span>20 July 2026</span></div>
    </div>
  </section>

  <section class="comparison-section">
    <div class="shell">
      <div class="comparison-intro">
        <h2>Before vs after</h2>
        <p>Drag the handle. The left shows the public opening screen captured during research; the right shows the proposed first screen.</p>
      </div>
      <Disclosure reminder />
      <BeforeAfter
        before="/images/hotel-enniskeen-before.jpg"
        after="/images/hotel-enniskeen-after.jpg"
        beforeAlt="Enniskeen's current homepage with an archive logo, blue uppercase menu bar, photo carousel and cookie banner"
        afterAlt="Mourne and Main concept opening on the valley view from a balcony room, with the hideaway headline and an availability bar"
      />
      <a class="text-link concept-link" href="/concepts/hotel-enniskeen/">View the full concept screen <ArrowIcon /></a>
    </div>
  </section>

  <section class="second-surface">
    <div class="shell">
      <p class="second-surface-label">Second surface · Rooms &amp; suites</p>
      <div class="second-surface-intro">
        <h2>A room detail that earns the booking.</h2>
        <p>The hotel has no interior page for rooms — the current site links straight from a photo carousel to the Bookin1 engine with no copy, no amenities, no sense of what the stay is like. This concept page shows what a guest would want to read before they commit.</p>
      </div>
      <div class="second-surface-frame">
        <img
          src="/images/hotel-enniskeen-rooms-after.jpg"
          alt="The Enniskeen rooms concept page showing the balcony room hero, room type cards and an availability bar"
        />
      </div>
      <p class="second-surface-caption">Rooms concept — balcony stay story with Bookin1 availability, matching the opening screen’s valley identity.</p>
      <a class="text-link concept-link" href="/concepts/hotel-enniskeen/rooms/">View the rooms concept <ArrowIcon /></a>
    </div>
  </section>

  <DesignNotes heading="Three changes to make the stay feel closer." notes={notes} />

  <section class="source-section">
    <div class="shell source-grid">
      <div>
        <p class="eyebrow">Sources &amp; limits</p>
        <h2>Clear about what is real.</h2>
      </div>
      <div>
        <p>The existing-site image was captured from the public Enniskeen website on 20 July 2026, with its cookie notice left visible as a first-time visitor meets it. The hotel's name, the mountainside hideaway and Shimna Valley wording, the estate details, the phone number, the photographs and the Bookin1 booking engine all come from that site. The layout, copy hierarchy and proposed experience are independent concept work.</p>
        <ul>
          <li><a href="https://www.enniskeenhotel.co.uk/" rel="external">Enniskeen public website</a></li>
          <li><a href="https://www.tripadvisor.co.uk/Hotel_Review-g186478-d1462012" rel="external">TripAdvisor listing used to verify current trading</a></li>
        </ul>
        <p>No claim is made about sales performance, customer approval or the internal decisions behind the current site.</p>
        <a class="button" href="/request/">Request a free before-and-after for your business <ArrowIcon /></a>
      </div>
    </div>
  </section>
</BaseLayout>
