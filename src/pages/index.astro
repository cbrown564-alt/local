---
import BaseLayout from "../site/layouts/BaseLayout.astro";
import ArrowIcon from "../site/components/ArrowIcon.astro";
import { ogImages } from "../site/data/og-images";
import "../site/styles/home.css";
---

<BaseLayout
  title="Mourne Made — Websites for Dundrum and Newcastle"
  description="A one-person studio making websites for independent businesses in Dundrum and Newcastle, County Down."
  ogImage={ogImages.home}
  ogImageAlt="Mourne Made — websites for Dundrum and Newcastle"
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500;1,9..144,600&family=Karla:wght@400;500;700&display=swap"
    rel="stylesheet"
  />
  <section class="home-hero home-hero--product" aria-label="Mourne Made introduction">
    <div class="home-hero-frame">
      <div class="home-hero-content">
        <div class="home-hero-heading">
          <p class="home-kicker">Dundrum + Newcastle, County Down</p>
          <h1>Websites for the businesses on our own doorstep.</h1>
        </div>
        <div class="home-hero-action">
          <p class="lede">Mourne Made is one person making clear, fast websites for independent local businesses. Get in touch and we’ll talk about what yours could do.</p>
          <div class="button-row">
            <a class="button" href="/request/">Get in touch <ArrowIcon /></a>
            <a class="text-link" href="/about/">Why local</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="home-proof" aria-labelledby="home-proof-title">
    <div class="home-proof-frame">
      <p class="home-kicker">Recent work</p>
      <h2 id="home-proof-title">Same business. Clearer front door.</h2>
      <div class="home-proof-pair">
        <figure>
          <img src="/media/home/eni-before.webp" width="1280" height="581" loading="lazy" decoding="async" alt="Elizabeth Norman International homepage before: a dark teal banner with a long tagline and a row of search boxes." />
          <figcaption>Before</figcaption>
        </figure>
        <figure>
          <img src="/media/home/eni-after.webp" width="1280" height="581" loading="lazy" decoding="async" alt="Elizabeth Norman International homepage after: a light layout headed “A head for insight. An eye for talent.” with two clear buttons and a portrait." />
          <figcaption>After</figcaption>
        </figure>
      </div>
      <p class="home-proof-caption">Elizabeth Norman International, an insight and analytics recruiter. The new homepage leads with who they help and gives job seekers and employers a clear way in.</p>
      <p class="home-proof-note">I’ve also built for clients further afield, like Elizabeth Norman in London, but my focus is here, on Dundrum and Newcastle.</p>
      <a class="text-link" href="/request/">See what yours could look like <ArrowIcon /></a>
    </div>
  </section>
</BaseLayout>
