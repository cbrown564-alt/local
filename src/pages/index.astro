---
import BaseLayout from "../site/layouts/BaseLayout.astro";
import ArrowIcon from "../site/components/ArrowIcon.astro";
import RebuildStage from "../site/components/RebuildStage.astro";
import ResponsiveImage from "../site/components/ResponsiveImage.astro";
import { siteDetails } from "../site/data/site";
import { ogImages } from "../site/data/og-images";
import "../site/styles/home.css";

const steps = [
  {
    title: "See yours first",
    body: "I make a free before-and-after of your own homepage. You see the change before you decide anything, and there’s no obligation to go further.",
  },
  {
    title: "A fixed price, in writing",
    body: "If you want to go ahead, you get a written quote that separates the build, the domain and the hosting. The job can start small: one useful page first.",
  },
  {
    title: "Live, and yours",
    body: "The site goes live on accounts in your name. Keep a provider you already use if it suits. There’s no long-term subscription to sign up to.",
  },
];

const proofNotes = [
  "A line that says what they do, in plain words: specialist insight recruiters since 1989.",
  "Two clear ways in, one for job seekers and one for employers, instead of a search form.",
  "A menu that names what people came for: find a role, hire talent.",
];
---

<BaseLayout
  title="Mourne Made — Websites for Dundrum and Newcastle"
  description="A one-person studio making websites for independent businesses in Dundrum and Newcastle, County Down."
  ogImage={ogImages.home}
  ogImageAlt="Mourne Made — websites for Dundrum and Newcastle"
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Besley:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
    rel="stylesheet"
  />

  <div class="front">
    <section class="front-hero" aria-labelledby="front-hero-title">
      <div class="shell front-hero-grid">
        <div class="front-hero-copy">
          <p class="front-kicker">Dundrum + Newcastle, County Down</p>
          <h1 id="front-hero-title">Websites for the businesses on our own <em>doorstep.</em></h1>
          <p class="front-lede">You’ve already done the hard part: people know you and like what you do. Your website should say so as clearly as you would across the counter. I’ll show you what that could look like, for free.</p>
          <div class="button-row front-actions">
            <a class="button" href="/request/">Get a free before-and-after <ArrowIcon /></a>
            <a class="text-link" href="/about/">Why local</a>
          </div>
        </div>

        <figure class="front-hero-photo">
          <div class="front-hero-photo-frame">
            <ResponsiveImage
              src="/media/place/newcastle-promenade-shopfronts.jpg"
              alt="The Central Promenade in Newcastle on a sunny morning: a row of painted shopfronts behind a green with a large stone sculpture, and Slieve Donard rising behind them with cloud on its summit."
              width="1920"
              height="1279"
              loading="eager"
              sizes="(max-width: 860px) 100vw, 660px"
            />
          </div>
          <p class="front-hero-note" aria-hidden="true">
            <span>The front doors people already know.</span>
            <svg class="front-hero-note-arrow" viewBox="0 0 120 70" width="120" height="70" focusable="false">
              <path d="M114 52 C 80 58, 40 46, 14 14" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" />
              <path d="M12 30 L 13 13 L 29 17" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </p>
          <figcaption>The Central Promenade, Newcastle.</figcaption>
        </figure>
      </div>
    </section>

    <section class="front-proof" aria-labelledby="front-proof-title">
      <div class="shell">
        <div class="front-proof-head">
          <div>
            <p class="front-kicker">Recent client work</p>
            <h2 id="front-proof-title">Same business. Clearer front door.</h2>
          </div>
          <p class="front-proof-meta"><strong>Elizabeth Norman International</strong><br />Insight and analytics recruitment, London</p>
        </div>

        <div class="front-proof-stage">
          <RebuildStage
            before="/media/home/eni-before.webp"
            after="/media/home/eni-after.webp"
            beforeAlt="Elizabeth Norman International homepage before: a dark teal banner with a long tagline and a row of search boxes."
            afterAlt="Elizabeth Norman International homepage after: a light layout headed “Worth a closer look.”, a line saying they are specialist insight recruiters since 1989, two clear buttons, and a portrait set into a halftone pattern."
            showNotes={false}
          />
        </div>

        <ol class="front-proof-notes">
          {proofNotes.map((note) => <li>{note}</li>)}
        </ol>
      </div>
    </section>

    <section class="front-steps" aria-labelledby="front-steps-title">
      <div class="shell">
        <p class="front-kicker">How it works</p>
        <h2 id="front-steps-title">Three steps, and the first one’s free.</h2>
        <ol class="front-steps-list">
          {steps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="front-note" aria-labelledby="front-note-title">
      <div class="shell front-note-grid">
        <h2 id="front-note-title">You’ll deal with me, start to finish.</h2>
        <div class="front-note-copy">
          <p>I live in Dundrum. I’d rather the businesses I walk past every day had websites as good as they are in person, and I don’t think that should need an agency budget.</p>
          <p>There’s no sales team and no hand-off. The person you first talk to is the person who builds your site and answers your emails.</p>
          <p class="front-note-sign">{siteDetails.founderFirstName}</p>
          <a class="text-link" href={siteDetails.emailHref}>{siteDetails.email}</a>
        </div>
      </div>
    </section>

    <section class="front-close" aria-labelledby="front-close-title">
      <div class="shell front-close-inner">
        <h2 id="front-close-title">What could your front door look like?</h2>
        <div class="front-close-action">
          <p>Tell me your business and I’ll send back your own before-and-after. It’s free, and you’re under no obligation.</p>
          <a class="button" href="/request/">Get a free before-and-after <ArrowIcon /></a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
