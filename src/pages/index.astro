---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import Disclosure from "../components/Disclosure.astro";
import LocalStrip from "../components/LocalStrip.astro";
import MourneMotif from "../components/MourneMotif.astro";
import "../styles/home.css";
---

<BaseLayout title="Mourne & Main — Local websites, made visible" description="A local digital studio creating free before-and-after website concepts for Dundrum and Newcastle businesses.">
  <section class="home-hero">
    <div class="shell">
      <p class="eyebrow">Dundrum + Newcastle, County Down</p>
      <h1>See what your business could become online.</h1>
      <p class="lede">We turn a familiar local website into a clear, modern concept — then show you the difference before you spend a penny.</p>
      <div class="button-row">
        <a class="button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
        <a class="text-link" href="/transformations/">Browse local transformations <ArrowIcon /></a>
      </div>
      <div class="home-note" aria-label="What to expect">
        <span>Independent businesses first</span>
        <span>A real visual concept</span>
        <span>No obligation</span>
      </div>
    </div>
  </section>

  <section class="home-comparison" aria-labelledby="home-comparison-heading">
    <div class="shell">
      <div class="home-comparison-intro">
        <h2 id="home-comparison-heading">Current vs concept</h2>
        <p>Drag the handle to compare current vs concept.</p>
      </div>
      <BeforeAfter
        before="/images/donard-veterinary-current.jpg"
        after="/images/donard-veterinary-concept.jpg"
        beforeAlt="Donard Veterinary Clinic's current homepage: the practice badge and menu above a wall-to-wall collage of stock puppies and kittens, with a PetsApp chat popup showing the opening hours"
        afterAlt="Mourne and Main concept opening in the practice's plum and teal badge colours, with the Taking Care of Your Pets headline, an appointment request card and a services rail over a Mourne silhouette"
      />
    </div>
  </section>

  <section class="home-how-it-works section-warm" aria-labelledby="home-how-heading">
    <div class="shell">
      <p class="eyebrow">How it works</p>
      <h2 id="home-how-heading">Three steps, no pressure.</h2>
      <ol class="home-steps">
        <li class="home-step">
          <span class="home-step-number" aria-hidden="true">01</span>
          <h3>Share your link</h3>
          <p>Tell us your business and what matters most.</p>
        </li>
        <li class="home-step">
          <span class="home-step-number" aria-hidden="true">02</span>
          <h3>See a concept</h3>
          <p>We build one focused before-and-after screen.</p>
        </li>
        <li class="home-step">
          <span class="home-step-number" aria-hidden="true">03</span>
          <h3>Decide in your own time</h3>
          <p>No obligation, no hard sell.</p>
        </li>
      </ol>
    </div>
  </section>

  <LocalStrip />

  <section class="feature">
    <div class="shell">
      <div class="feature-heading">
        <div>
          <p class="eyebrow">The latest transformation</p>
          <h2>A better opening minute.</h2>
        </div>
        <p>One focused example shows how less interruption, stronger local imagery and a clear first action can change the feel of a website.</p>
      </div>
      <article class="home-feature-spotlight">
        <Disclosure compact />
        <span class="tag">Website concept · Newcastle</span>
        <h3>Donard Veterinary Clinic</h3>
        <p>From a wall of stock puppies to the practice's own badge — with appointment requests on the first screen and the emergency number one tap away.</p>
        <a class="text-link" href="/transformations/donard-veterinary/">See the full comparison <ArrowIcon /></a>
      </article>
    </div>
  </section>

  <MourneMotif tone="blue" />

  <section class="promise">
    <div class="shell promise-grid">
      <div class="promise-stat">379<span>public local listings reviewed so far</span></div>
      <div class="promise-copy">
        <p class="eyebrow">A local commitment</p>
        <h2>Good digital work should reach the whole community.</h2>
        <p>Paid projects keep the studio going. A share of that time goes back into free or reduced-cost work for local clubs, charities and organisations that would benefit but cannot justify a full commercial budget.</p>
        <a class="text-link" href="/about/">Why local comes first <ArrowIcon /></a>
      </div>
    </div>
  </section>

  <section class="closing-cta">
    <div class="shell">
      <h2>Ready to see the difference?</h2>
      <p>Tell us about your business and we'll send a free before-and-after concept — no obligation.</p>
      <div class="button-row">
        <a class="button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
        <a class="text-link" href="/transformations/">Browse local transformations <ArrowIcon /></a>
      </div>
    </div>
  </section>
</BaseLayout>
