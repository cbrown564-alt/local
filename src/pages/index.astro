---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import Disclosure from "../components/Disclosure.astro";
import { featuredTransformation } from "../data/transformations";
---

<BaseLayout title="Mourne & Main — Local websites, made visible" description="A local digital studio creating free before-and-after website concepts for Dundrum and Newcastle businesses." ogImage="/images/place/mournes-newcastle.jpg">
  <section class="home-hero home-hero--bay" aria-label="Mourne and Main introduction">
    <div class="home-hero-media">
      <img
        src="/images/place/mournes-newcastle.jpg"
        alt="Low tide on Newcastle beach with the town and Mourne Mountains beyond"
        width="2000"
        height="1250"
      />
    </div>
    <div class="home-hero-scrim" aria-hidden="true"></div>

    <div class="home-hero-frame">
      <div class="home-hero-content">
        <p class="home-kicker">Dundrum + Newcastle, County Down</p>
        <p class="brand-hero" aria-label="Mourne and Main">
          <span>Mourne</span><span class="wordmark-amp">&amp;</span><span>Main</span>
        </p>
        <h1>See what your business could become online.</h1>
        <p class="lede">A clear before-and-after for a familiar local site — before you spend a penny.</p>
        <div class="button-row">
          <a class="button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
          <a class="text-link home-hero-link" href="/transformations/">Browse local transformations <ArrowIcon /></a>
        </div>
      </div>

      <div class="home-hero-stage">
        <div class="home-hero-stage-meta">
          <p class="home-hero-kicker">Drag to compare · {featuredTransformation.name}, {featuredTransformation.town}</p>
          <a class="text-link home-hero-link" href={featuredTransformation.href}>Open the full comparison <ArrowIcon /></a>
        </div>
        <div class="home-hero-comparison">
          <BeforeAfter
            before={featuredTransformation.before}
            after={featuredTransformation.after}
            beforeAlt={featuredTransformation.beforeAlt}
            afterAlt={featuredTransformation.afterAlt}
            showNotes={false}
            compact
          />
        </div>
      </div>
    </div>
  </section>

  <section class="home-follow">
    <div class="shell home-follow-disclosure">
      <Disclosure compact />
    </div>
  </section>

  <section class="promise">
    <div class="shell promise-grid">
      <div class="promise-stat">379<span>public local listings reviewed so far</span></div>
      <div class="promise-copy">
        <p class="eyebrow">A local commitment</p>
        <h2>Good digital work should reach the whole community.</h2>
        <p>Paid projects keep the studio going. A share of that time goes back into free or reduced-cost work for local clubs, charities and organisations that would benefit but cannot justify a full commercial budget.</p>
        <a class="text-link" href="/about/">Why local comes first <ArrowIcon /></a>
      </div>
    </div>
  </section>

  <section class="closing-cta">
    <div class="shell">
      <h2>Ready to see the difference?</h2>
      <p>Tell us about your business and we'll send a free before-and-after concept — no obligation.</p>
      <div class="button-row">
        <a class="button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
        <a class="text-link" href="/transformations/">Browse local transformations <ArrowIcon /></a>
      </div>
    </div>
  </section>
</BaseLayout>
