---
import BaseLayout from "../site/layouts/BaseLayout.astro";
import ArrowIcon from "../site/components/ArrowIcon.astro";
import HomePhaseRebuild from "../site/components/HomePhaseRebuild.astro";
import TownMap from "../site/components/TownMap.astro";
import HomeClayFilm from "../site/components/HomeClayFilm.astro";
import { featuredTransformation, transformations } from "../site/data/transformations";
import { ogImages } from "../site/data/og-images";
import "../site/styles/home.css";

const hasPublicTransformations =
  transformations.length > 0 && Boolean(featuredTransformation);
---

<BaseLayout
  title="Mourne Made — Free before-and-after concepts"
  description="For Dundrum and Newcastle businesses. See what's possible before spending a penny."
  ogImage={ogImages.home}
  ogImageAlt="Mourne Made — free before-and-after website concepts for local businesses"
>
  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />
  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500;1,9..144,600&family=Karla:wght@400;500;700&display=swap"
    rel="stylesheet"
  />
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  />
  <section class="home-hero home-hero--product" aria-label="Mourne Made introduction">
    <div class="home-hero-frame">
      <div class="home-hero-content">
        <div class="home-hero-heading">
          <p class="home-kicker">Dundrum + Newcastle, County Down</p>
          <h1>Let’s show your business at its best.</h1>
        </div>
        <div class="home-hero-action">
          <p class="lede">We’ll make you a free before-and-after concept, so you can see what’s possible before spending a penny.</p>
          <div class="button-row">
            <a class="button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
          </div>
          {/* The claim door. A business owner who lands here needs a route to
              the concept already made for them; dropping it leaves them only
              the request form for work that already exists. */}
        </div>
      </div>

      {hasPublicTransformations ? (
        <HomePhaseRebuild
          before={featuredTransformation.before}
          after={featuredTransformation.after}
          beforeAlt={featuredTransformation.beforeAlt}
          afterAlt={featuredTransformation.afterAlt}
          name={featuredTransformation.name}
          town={featuredTransformation.town}
          href={featuredTransformation.href}
        />
      ) : (
        <section class="home-review-state" aria-labelledby="home-review-heading">
          <div class="home-review-copy">
            <p class="home-review-label">Portfolio review in progress</p>
            <h2 id="home-review-heading">
              We’re raising the bar before we show the work.
            </h2>
            <p>
              Every concept is being checked for truth, subject proof,
              accessibility and a complete visitor journey, then inspected by
              an independent reviewer. Only work that clears the new
              publication standard will return here.
            </p>
          </div>
          <div class="home-review-status" aria-label="Portfolio publication status">
            <span>Public examples today</span>
            <strong>None until they pass</strong>
            <a href="/transformations/">Read the portfolio update <ArrowIcon /></a>
          </div>
        </section>
      )}
    </div>
  </section>

  <section class="home-map" aria-labelledby="home-map-heading">
    <div class="shell home-map-head">
      <p class="home-kicker">Rooted here</p>
      <h2 id="home-map-heading">Made here, for here.</h2>
      <p class="home-map-lede">See what we’ve been making around here. If your business is on the map, the concept is yours.</p>
    </div>
    <div class="shell">
      <TownMap />
    </div>
  </section>

  <HomeClayFilm />

  <section class="closing-cta">
    <div class="shell">
      <h2>Ready to see what yours could do?</h2>
      <p>Tell us about your business. We’ll make one before-and-after. You decide in your own time.</p>
      <div class="button-row">
        <a class="button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
        <a class="text-link" href="/transformations/">Browse local website examples <ArrowIcon /></a>
      </div>
    </div>
  </section>

  <section class="promise">
    <div class="shell promise-grid">
      {transformations.length > 0 ? (
        <div class="promise-stat">{transformations.length}<span>independently reviewed local website examples</span></div>
      ) : (
        <div class="promise-stat promise-stat--review">
          Review first
          <span>Public proof returns one concept at a time, after it passes.</span>
        </div>
      )}
      <div class="promise-copy">
        <p class="eyebrow">A local commitment</p>
        <h2>Good websites should be within everyone’s reach.</h2>
        <p>Paid work funds the studio — and buys time to help local clubs, charities and organisations that can't stretch to a full commercial project.</p>
        <a class="text-link" href="/about/">Why local comes first <ArrowIcon /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
