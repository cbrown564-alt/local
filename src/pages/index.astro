---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
import Disclosure from "../components/Disclosure.astro";
---

<BaseLayout title="Mourne & Main — Local websites, made visible" description="A local digital studio creating free before-and-after website concepts for Dundrum and Newcastle businesses.">
  <section class="home-hero">
    <div class="shell">
      <p class="eyebrow">Dundrum + Newcastle, County Down</p>
      <h1>See what your business could become online.</h1>
      <p class="lede">We turn a familiar local website into a clear, modern concept — then show you the difference before you spend a penny.</p>
      <div class="button-row">
        <a class="button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
        <a class="text-link" href="/transformations/">Browse local transformations <ArrowIcon /></a>
      </div>
      <div class="home-note" aria-label="What to expect">
        <span>Independent businesses first</span>
        <span>A real visual concept</span>
        <span>No obligation</span>
      </div>
    </div>
  </section>

  <section class="feature">
    <div class="shell">
      <div class="feature-heading">
        <div>
          <p class="eyebrow">The first transformation</p>
          <h2>A better opening minute.</h2>
        </div>
        <p>One focused example shows how less interruption, stronger local imagery and a clear first action can change the feel of a website.</p>
      </div>
      <article class="feature-card">
        <div class="feature-visual">
          <div class="feature-browser" aria-hidden="true">
            <div class="browser-bar"><span></span><span></span><span></span></div>
            <img src="/images/castle-farm-concept.png" alt="" />
          </div>
        </div>
        <div class="feature-copy">
          <Disclosure compact />
          <span class="tag">Website concept · Dundrum</span>
          <h3>Castle Farm Fresh Produce</h3>
          <p>From stacked prompts to a produce-first shopfront that explains what is local, fresh and ready to order.</p>
          <a class="text-link" href="/transformations/castle-farm/">See the full comparison <ArrowIcon /></a>
        </div>
      </article>
    </div>
  </section>

  <section class="promise">
    <div class="shell promise-grid">
      <div class="promise-stat">381<span>public local listings reviewed so far</span></div>
      <div class="promise-copy">
        <p class="eyebrow">A local commitment</p>
        <h2>Good digital work should reach the whole community.</h2>
        <p>Paid projects keep the studio going. A share of that time goes back into free or reduced-cost work for local clubs, charities and organisations that would benefit but cannot justify a full commercial budget.</p>
        <a class="text-link" href="/about/">Why local comes first <ArrowIcon /></a>
      </div>
    </div>
  </section>
</BaseLayout>
