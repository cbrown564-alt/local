---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import Disclosure from "../components/Disclosure.astro";
import LocalStrip from "../components/LocalStrip.astro";
import MourneMotif from "../components/MourneMotif.astro";
import { featuredTransformation, transformations } from "../data/transformations";
import "../styles/home.css";

const hasPublicTransformations =
  transformations.length > 0 && Boolean(featuredTransformation);
---

<BaseLayout
  title="Mourne Made — Local websites, made visible"
  description="A local digital studio creating free before-and-after website concepts for Dundrum and Newcastle businesses."
  ogImage={
    hasPublicTransformations
      ? featuredTransformation.after
      : "/images/place/mournes-newcastle.jpg"
  }
>
  <section class="home-hero home-hero--product" aria-label="Mourne Made introduction">
    <div class="home-hero-frame">
      <div class="home-hero-content">
        <div class="home-hero-heading">
          <p class="home-kicker">Dundrum + Newcastle, County Down</p>
          <h1>Fancy a digital makeover?</h1>
        </div>
        <div class="home-hero-action">
          <p class="lede">Same business. Better first impression.</p>
          <div class="button-row">
            <a class="button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
          </div>
        </div>
      </div>

      {hasPublicTransformations ? (
        <div class="home-hero-stage">
          <div class="home-hero-comparison">
            <BeforeAfter
              before={featuredTransformation.before}
              after={featuredTransformation.after}
              beforeAlt={featuredTransformation.beforeAlt}
              afterAlt={featuredTransformation.afterAlt}
              showNotes={false}
              compact
            />
          </div>
          <footer class="home-hero-stage-footer">
            <Disclosure reminder />
            <p class="home-hero-stage-caption">
              Drag to compare · {featuredTransformation.name}, {featuredTransformation.town}
            </p>
            <nav class="home-hero-stage-links" aria-label="Featured comparison">
              <a class="button button-secondary home-hero-stage-browse" href="/transformations/">Browse local transformations <ArrowIcon /></a>
              <a class="text-link home-hero-stage-compare" href={featuredTransformation.href}>Open the full comparison <ArrowIcon /></a>
            </nav>
          </footer>
        </div>
      ) : (
        <section class="home-review-state" aria-labelledby="home-review-heading">
          <div class="home-review-copy">
            <p class="home-review-label">Portfolio review in progress</p>
            <h2 id="home-review-heading">
              We’re raising the bar before we show the work.
            </h2>
            <p>
              Every concept is being checked for truth, subject proof,
              accessibility and a complete visitor journey, then inspected by
              an independent reviewer. Only work that clears the new
              publication standard will return here.
            </p>
          </div>
          <div class="home-review-status" aria-label="Portfolio publication status">
            <span>Public examples today</span>
            <strong>None until they pass</strong>
            <a href="/transformations/">Read the portfolio update <ArrowIcon /></a>
          </div>
        </section>
      )}
    </div>
  </section>

  <section class="home-how-it-works section-warm" aria-labelledby="home-how-heading">
    <div class="shell">
      <p class="eyebrow">How it works</p>
      <h2 id="home-how-heading">Three steps, no pressure.</h2>
      <ol class="home-steps">
        <li class="home-step">
          <span class="home-step-number" aria-hidden="true">01</span>
          <h3>Share your business</h3>
          <p>Add a link if you have one and tell us what matters most.</p>
        </li>
        <li class="home-step">
          <span class="home-step-number" aria-hidden="true">02</span>
          <h3>See a concept</h3>
          <p>We build one focused before-and-after screen.</p>
        </li>
        <li class="home-step">
          <span class="home-step-number" aria-hidden="true">03</span>
          <h3>Decide in your own time</h3>
          <p>No obligation, no hard sell.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="home-place" aria-label="Local place">
    <div class="home-place-media">
      <img
        src="/images/place/mournes-newcastle.jpg"
        alt="Low tide on Newcastle beach with the town and Mourne Mountains beyond"
        width="2000"
        height="1250"
      />
    </div>
    <div class="home-place-scrim" aria-hidden="true"></div>
    <div class="home-place-copy">
      <p class="home-kicker home-place-kicker">Rooted here</p>
      <h2>Made here, for here.</h2>
      <p>A studio that lives in Dundrum and Newcastle — not a template ordered from somewhere far away.</p>
    </div>
  </section>

  <LocalStrip />

  <MourneMotif tone="blue" />

  <section class="closing-cta">
    <div class="shell">
      <h2>Curious what yours would look like?</h2>
      <p>Tell us about your business and we'll send a free before-and-after concept — no obligation.</p>
      <div class="button-row">
        <a class="button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
        <a class="text-link" href="/transformations/">Read the portfolio update <ArrowIcon /></a>
      </div>
    </div>
  </section>

  <section class="promise">
    <div class="shell promise-grid">
      {transformations.length > 0 ? (
        <div class="promise-stat">{transformations.length}<span>independently reviewed local concept transformations</span></div>
      ) : (
        <div class="promise-stat promise-stat--review">
          Review first
          <span>Public proof returns one concept at a time, after it passes.</span>
        </div>
      )}
      <div class="promise-copy">
        <p class="eyebrow">A local commitment</p>
        <h2>Good websites shouldn't only go to those who can pay.</h2>
        <p>Paid work funds the studio — and buys time to help local clubs, charities and organisations that can't stretch to a full commercial project.</p>
        <a class="text-link" href="/about/">Why local comes first <ArrowIcon /></a>
      </div>
    </div>
  </section>
</BaseLayout>
