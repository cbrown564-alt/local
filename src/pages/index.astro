---
import BaseLayout from "../site/layouts/BaseLayout.astro";
import ArrowIcon from "../site/components/ArrowIcon.astro";
import { ogImages } from "../site/data/og-images";
import "../site/styles/home.css";
---

<BaseLayout
  title="Mourne Made — Websites for Dundrum and Newcastle"
  description="A one-person studio making websites for independent businesses in Dundrum and Newcastle, County Down."
  ogImage={ogImages.home}
  ogImageAlt="Mourne Made — websites for Dundrum and Newcastle"
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500;1,9..144,600&family=Karla:wght@400;500;700&display=swap"
    rel="stylesheet"
  />
  <section class="home-hero home-hero--product" aria-label="Mourne Made introduction">
    <div class="home-hero-frame">
      <div class="home-hero-content">
        <div class="home-hero-heading">
          <p class="home-kicker">Dundrum + Newcastle, County Down</p>
          <h1>Websites for the businesses on our own doorstep.</h1>
        </div>
        <div class="home-hero-action">
          <p class="lede">Mourne Made is one person making clear, fast websites for independent local businesses. Get in touch and we’ll talk about what yours could do.</p>
          <div class="button-row">
            <a class="button" href="/request/">Get in touch <ArrowIcon /></a>
            <a class="text-link" href="/about/">Why local</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
