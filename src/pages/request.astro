---
import BaseLayout from "../site/layouts/BaseLayout.astro";
import ArrowIcon from "../site/components/ArrowIcon.astro";
import { ogImages } from "../site/data/og-images";
import { transformations } from "../site/data/transformations";
import "../site/styles/request.css";

const claimConcepts = Object.fromEntries(
  transformations.map((item) => [
    item.slug,
    { after: item.after, afterAlt: item.afterAlt },
  ]),
);
const requestExample = transformations.find((item) => item.slug === "hotel-enniskeen");
if (!requestExample) {
  throw new Error("Request page example needs the hotel-enniskeen transformation.");
}
---

<BaseLayout
  title="Request a free before-and-after — Mourne Made"
  description="Request a free, no-obligation website or digital-content before-and-after for a local business or organisation."
  ogImage={ogImages.request}
  ogImageAlt="Request a free before-and-after website concept from Mourne Made"
>
  <section
    class="shell request-layout"
    data-request-mode="request"
    data-claim-concepts={JSON.stringify(claimConcepts).replaceAll("<", "\\u003c")}
  >
    <div class="request-copy" data-request-copy>
      <div class="request-side" data-request-intro>
        <p class="eyebrow">Free before-and-after</p>
        <h1>See your own before and after.</h1>
        <p class="request-side-lede">Tell us the business. We’ll make one clearer screen — free, no obligation.</p>
        <figure class="claim-postcard request-example">
          <div class="claim-postcard-mat">
            <div class="request-example-split" aria-hidden="true">
              <div class="request-example-panel">
                <span>Before</span>
                <img src={requestExample.before} alt="" width="640" height="360" />
              </div>
              <div class="request-example-panel">
                <span>After</span>
                <img src={requestExample.after} alt="" width="640" height="360" />
              </div>
            </div>
            <p class="request-visually-hidden">
              Before: {requestExample.beforeAlt}. After: {requestExample.afterAlt}.
            </p>
          </div>
          <figcaption class="claim-postcard-caption">
            <a class="text-link" href={requestExample.href}>Example — {requestExample.name}, {requestExample.town}</a>
          </figcaption>
        </figure>
      </div>
      <div class="claim-side" data-claim-side hidden>
        <p class="eyebrow">Let's talk about your website</p>
        <figure class="claim-postcard">
          <div class="claim-postcard-mat">
            <img data-claim-postcard-img src="" alt="" width="1265" height="710" />
          </div>
          <figcaption class="claim-postcard-caption">Let's chat about it.</figcaption>
        </figure>
        <p class="claim-side-note"><strong>No obligation.</strong> Paid work starts only after a fixed written quote.</p>
      </div>
    </div>
    <form class="request-form" novalidate data-request-source="direct">
      {/* Submitted as a real field, not just tracked. Attribution that lives
          only in dataset never reaches the inbox, where the decision to keep
          printing a sheet actually gets made (docs/adr/0002). */}
      <input type="hidden" name="source" value="direct" />
      <div class="form-honeypot" aria-hidden="true">
        <label for="mm-check">Leave this field empty</label>
        <input id="mm-check" name="mm_check_field" tabindex="-1" autocomplete="new-password" />
      </div>
      <div class="form-error" role="alert" aria-live="assertive"></div>
      <div class="form-success" role="status" aria-live="polite"></div>
      <div class="claim-summary" data-claim-summary hidden>
        <p class="claim-summary-label">Website idea for</p>
        <p class="claim-summary-value"><strong data-claim-business></strong></p>
      </div>
      <div class="field" data-business-field>
        <label for="business">Business or organisation</label>
        <input id="business" name="business" autocomplete="organization" required />
      </div>
      <div class="request-optional" data-optional-fields>
        <p class="request-optional-label">Optional</p>
        <div class="field" data-idea-field>
          <label for="idea" data-idea-label>What should be clearer?</label>
          <textarea id="idea" name="idea" placeholder="Booking, the menu, how you look on a phone — whatever matters most."></textarea>
        </div>
        <div class="field" data-link-field>
          <label for="link">Current website or page</label>
          <input id="link" name="link" type="text" inputmode="url" autocomplete="url" placeholder="facebook.com/your-page" />
        </div>
        <div class="field-grid">
          <div class="field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" /></div>
          <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" /></div>
        </div>
      </div>
      <button class="button" type="submit"><span data-submit-label>Request a free before-and-after</span> <ArrowIcon /></button>
      <p class="form-note" data-form-note>Your details are used only to respond to this request. <a href="/privacy/">Read the privacy notice.</a></p>
    </form>
    <div class="request-confirmation" data-request-confirmation hidden tabindex="-1">
      <p class="eyebrow">Sent</p>
      <h2 data-confirmation-title></h2>
      <p data-confirmation-body></p>
      <p data-confirmation-next><strong>What happens next.</strong> We will be in touch, usually within a couple of working days.</p>
      <a class="button" data-confirmation-back href="/transformations/"><span data-confirmation-back-label>Back to the concepts</span> <ArrowIcon /></a>
    </div>
  </section>
</BaseLayout>

<script>
  import { track } from "@vercel/analytics";

  const layout = document.querySelector<HTMLElement>("[data-request-mode]");
  const form = document.querySelector<HTMLFormElement>(".request-form");
  const copy = document.querySelector<HTMLElement>("[data-request-copy]");
  const requestIntro = document.querySelector<HTMLElement>("[data-request-intro]");
  const claimSide = document.querySelector<HTMLElement>("[data-claim-side]");
  const postcardImg = document.querySelector<HTMLImageElement>("[data-claim-postcard-img]");
  const confirmation = document.querySelector<HTMLElement>("[data-request-confirmation]");
  const error = form?.querySelector<HTMLElement>(".form-error");
  const success = form?.querySelector<HTMLElement>(".form-success");
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const submitLabel = form?.querySelector<HTMLElement>("[data-submit-label]");
  const params = new URLSearchParams(window.location.search);
  const requestedBusiness = params.get("business")?.slice(0, 120);
  const requestSource = params.get("source")?.slice(0, 80);
  const caseSlug = params.get("case")?.slice(0, 80);
  const businessInput = form?.elements.namedItem("business");
  const businessField = form?.querySelector<HTMLElement>("[data-business-field]");
  const ideaField = form?.querySelector<HTMLTextAreaElement>("#idea");
  const ideaLabel = form?.querySelector<HTMLElement>("[data-idea-label]");
  const linkField = form?.querySelector<HTMLElement>("[data-link-field]");
  const claimSummary = form?.querySelector<HTMLElement>("[data-claim-summary]");
  const claimBusiness = form?.querySelector<HTMLElement>("[data-claim-business]");
  const formNote = form?.querySelector<HTMLElement>("[data-form-note]");
  const confirmationTitle = confirmation?.querySelector<HTMLElement>("[data-confirmation-title]");
  const confirmationBody = confirmation?.querySelector<HTMLElement>("[data-confirmation-body]");
  const confirmationNext = confirmation?.querySelector<HTMLElement>("[data-confirmation-next]");
  const confirmationBack = confirmation?.querySelector<HTMLAnchorElement>("[data-confirmation-back]");
  const confirmationBackLabel = confirmation?.querySelector<HTMLElement>("[data-confirmation-back-label]");

  const isClaimSource = (value: string | undefined) =>
    value === "transformation" || Boolean(value && /^onesheet-[a-z][a-z\d-]{0,60}$/.test(value));

  const claimConcepts = (() => {
    const raw = layout?.dataset.claimConcepts;
    if (!raw) return {} as Record<string, { after: string; afterAlt: string }>;
    try {
      return JSON.parse(raw) as Record<string, { after: string; afterAlt: string }>;
    } catch {
      return {};
    }
  })();

  if (requestedBusiness && businessInput instanceof HTMLInputElement) {
    businessInput.value = requestedBusiness;
    businessInput.defaultValue = requestedBusiness;
  }
  const sourceInput = form?.elements.namedItem("source");
  if (requestSource && form) {
    form.dataset.requestSource = requestSource;
    if (sourceInput instanceof HTMLInputElement) {
      // defaultValue too: the success path calls form.reset(), and a second
      // submission from the same page would otherwise revert to "direct".
      sourceInput.value = requestSource;
      sourceInput.defaultValue = requestSource;
    }
  }

  const source = form?.dataset.requestSource ?? "direct";
  const claimMode = isClaimSource(source);
  const defaultSubmitLabel = claimMode ? "Yes — get in touch" : "Request a free before-and-after";
  const caseFromSource = source.startsWith("onesheet-") ? source.slice("onesheet-".length) : "";
  const backSlug = (caseSlug && /^[a-z][a-z\d-]{0,60}$/.test(caseSlug) && caseSlug)
    || (caseFromSource && /^[a-z][a-z\d-]{0,60}$/.test(caseFromSource) && caseFromSource)
    || "";

  if (claimMode && layout && form) {
    layout.dataset.requestMode = "claim";
    document.title = "Let's talk about your website — Mourne Made";

    if (requestIntro) requestIntro.hidden = true;
    if (claimSide) claimSide.hidden = false;

    const concept = backSlug ? claimConcepts[backSlug] : undefined;
    if (concept && postcardImg) {
      postcardImg.src = concept.after;
      postcardImg.alt = concept.afterAlt;
    } else if (claimSide) {
      // No matching after image — keep the eyebrow and note, drop the empty frame.
      const postcard = claimSide.querySelector(".claim-postcard");
      if (postcard instanceof HTMLElement) postcard.hidden = true;
    }

    if (claimSummary && claimBusiness) {
      claimSummary.hidden = false;
      claimBusiness.textContent = requestedBusiness || "Your business";
    }
    if (businessField) businessField.hidden = true;
    if (linkField) linkField.hidden = true;
    if (ideaField) {
      ideaField.placeholder = "A correction, a better time to talk, or anything else.";
    }
    if (ideaLabel) ideaLabel.textContent = "Anything we should know?";
    if (submitLabel) submitLabel.textContent = defaultSubmitLabel;
    if (formNote) {
      formNote.replaceChildren();
      formNote.append("Your details are used only to respond about this concept. ");
      const privacy = document.createElement("a");
      privacy.href = "/privacy/";
      privacy.textContent = "Read the privacy notice.";
      formNote.append(privacy);
    }

    if (confirmationBack && backSlug) {
      confirmationBack.href = `/transformations/${backSlug}/`;
      if (confirmationBackLabel) {
        confirmationBackLabel.textContent = requestedBusiness
          ? `Back to the ${requestedBusiness} case study`
          : "Back to the case study";
      }
    }
  }

  form?.addEventListener("input", () => track("request_form_started", { source }), { once: true });
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    form.classList.add("request-form--submitted");
    if (error) error.textContent = "";
    if (success) success.textContent = "";
    const invalid = [...form.elements].find((element) => element instanceof HTMLInputElement || element instanceof HTMLTextAreaElement || element instanceof HTMLSelectElement ? !element.checkValidity() : false) as HTMLElement | undefined;
    if (invalid) {
      if (error) {
        error.textContent = invalid instanceof HTMLInputElement && invalid.type === "email" && invalid.value
          ? "Please use a valid email address, or leave the email field blank."
          : "Please enter the business or organisation name.";
      }
      invalid.focus();
      return;
    }
    const data = Object.fromEntries(new FormData(form).entries());
    const business = String(data.business ?? "");
    const email = String(data.email ?? "").trim();
    if (submit) submit.disabled = true;
    if (submitLabel) submitLabel.textContent = "Sending…";

    try {
      const response = await fetch("/api/request", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      const contentType = response.headers.get("content-type") ?? "";
      const result = contentType.includes("application/json")
        ? await response.json().catch(() => ({}))
        : {};
      if (!response.ok) {
        throw new Error(
          result.error
          || (response.status >= 500
            ? "The request service is temporarily unavailable. Please email cbrown564@gmail.com instead."
            : "The request could not be sent."),
        );
      }
      track("request_form_submitted", { source });

      if (claimMode && confirmation && layout) {
        form.hidden = true;
        if (copy) copy.hidden = true;
        confirmation.hidden = false;
        if (confirmationTitle) {
          confirmationTitle.textContent = business
            ? `Thanks — we have your note about ${business}.`
            : "Thanks — that is with us.";
        }
        if (confirmationBody) {
          confirmationBody.textContent = email
            ? "We’ll reply to the email address you provided."
            : "We’ll be in touch — no email needed.";
        }
        if (confirmationNext) {
          confirmationNext.replaceChildren();
          const strong = document.createElement("strong");
          strong.textContent = "What happens next.";
          confirmationNext.append(
            strong,
            email
              ? " We will reply to the email address you provided, usually within a couple of working days."
              : " We will be in touch, usually within a couple of working days.",
          );
        }
        confirmation.focus();
        confirmation.scrollIntoView({ behavior: "smooth", block: "start" });
      } else {
        form.reset();
        form.classList.remove("request-form--submitted");
        if (success) {
          success.textContent = email
            ? `Thanks — your request for ${business} has been sent. We’ll reply to the email address you provided.`
            : `Thanks — your request for ${business} has been sent. We’ll be in touch.`;
        }
        success?.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    } catch (submissionError) {
      if (error) error.textContent = submissionError instanceof Error
        ? submissionError.message
        : "The request could not be sent just now. Please try again.";
      error?.scrollIntoView({ behavior: "smooth", block: "center" });
    } finally {
      if (submit) submit.disabled = false;
      if (submitLabel) submitLabel.textContent = defaultSubmitLabel;
    }
  });
</script>
