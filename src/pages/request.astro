---
import BaseLayout from "../site/layouts/BaseLayout.astro";
import ArrowIcon from "../site/components/ArrowIcon.astro";
import "../site/styles/request.css";
---

<BaseLayout title="Request a free before-and-after — Mourne Made" description="Request a free, no-obligation website or digital-content before-and-after for a local business or organisation.">
  <section class="shell request-layout">
    <div class="request-copy">
      <p class="eyebrow">Free before-and-after</p>
      <h1>What would you like to see differently?</h1>
      <p>Share a current link if you have one, then tell us what matters most. We will choose one useful screen or piece of content and show a clearer direction.</p>
      <p><strong>No obligation.</strong> No full redesign hiding behind a sales call. Just a focused before-and-after to start the conversation.</p>
    </div>
    <form class="request-form" novalidate data-request-source="direct">
      <div class="form-honeypot" aria-hidden="true">
        <label for="mm-check">Leave this field empty</label>
        <input id="mm-check" name="mm_check_field" tabindex="-1" autocomplete="new-password" />
      </div>
      <div class="form-error" role="alert" aria-live="assertive"></div>
      <div class="form-success" role="status" aria-live="polite"></div>
      <div class="field-grid">
        <div class="field"><label for="business">Business or organisation</label><input id="business" name="business" autocomplete="organization" required /></div>
        <div class="field"><label for="town">Town</label><select id="town" name="town" required><option value="">Choose one</option><option value="Dundrum">Dundrum</option><option value="Newcastle">Newcastle</option><option value="Nearby">Nearby</option></select></div>
      </div>
      <div class="field"><label for="link">Current website, menu, listing or page <span class="field-optional">(optional)</span></label><input id="link" name="link" type="text" inputmode="url" autocomplete="url" placeholder="facebook.com/your-page" /><small>Leave this blank if you do not have a website or public page yet.</small></div>
      <div class="field"><label for="idea">What should be easier or more impressive?</label><textarea id="idea" name="idea" required placeholder="For example: make the food look better, simplify booking, or show the venue properly on mobile."></textarea></div>
      <div class="field-grid">
        <div class="field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required /></div>
        <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
      </div>
      <button class="button" type="submit"><span data-submit-label>Request a free before-and-after</span> <ArrowIcon /></button>
      <p class="form-note">Your details are used only to respond to this request. <a href="/privacy/">Read the privacy notice.</a></p>
    </form>
  </section>
</BaseLayout>

<script>
  import { track } from "@vercel/analytics";

  const form = document.querySelector<HTMLFormElement>(".request-form");
  const error = form?.querySelector<HTMLElement>(".form-error");
  const success = form?.querySelector<HTMLElement>(".form-success");
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const submitLabel = form?.querySelector<HTMLElement>("[data-submit-label]");
  const params = new URLSearchParams(window.location.search);
  const requestedBusiness = params.get("business")?.slice(0, 120);
  const requestedTown = params.get("town");
  const requestSource = params.get("source")?.slice(0, 80);
  const businessInput = form?.elements.namedItem("business");
  const townSelect = form?.elements.namedItem("town");

  if (requestedBusiness && businessInput instanceof HTMLInputElement) {
    businessInput.value = requestedBusiness;
  }
  if (
    requestedTown
    && townSelect instanceof HTMLSelectElement
    && [...townSelect.options].some((option) => option.value === requestedTown)
  ) {
    townSelect.value = requestedTown;
  }
  if (requestSource && form) {
    form.dataset.requestSource = requestSource;
  }

  const source = form?.dataset.requestSource ?? "direct";
  form?.addEventListener("input", () => track("request_form_started", { source }), { once: true });
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    form.classList.add("request-form--submitted");
    if (error) error.textContent = "";
    if (success) success.textContent = "";
    const invalid = [...form.elements].find((element) => element instanceof HTMLInputElement || element instanceof HTMLTextAreaElement || element instanceof HTMLSelectElement ? !element.checkValidity() : false) as HTMLElement | undefined;
    if (invalid) {
      if (error) error.textContent = "Please complete each required field and use a valid email address.";
      invalid.focus();
      return;
    }
    const data = Object.fromEntries(new FormData(form).entries());
    const business = data.business;
    if (submit) submit.disabled = true;
    if (submitLabel) submitLabel.textContent = "Sending…";

    try {
      const response = await fetch("/api/request", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      const contentType = response.headers.get("content-type") ?? "";
      const result = contentType.includes("application/json")
        ? await response.json().catch(() => ({}))
        : {};
      if (!response.ok) {
        throw new Error(
          result.error
          || (response.status >= 500
            ? "The request service is temporarily unavailable. Please email cbrown564@gmail.com instead."
            : "The request could not be sent."),
        );
      }
      form.reset();
      form.classList.remove("request-form--submitted");
      track("request_form_submitted", { source });
      if (success) success.textContent = `Thanks — your request for ${business} has been sent. We’ll reply to the email address you provided.`;
      success?.scrollIntoView({ behavior: "smooth", block: "center" });
    } catch (submissionError) {
      if (error) error.textContent = submissionError instanceof Error
        ? submissionError.message
        : "The request could not be sent just now. Please try again.";
      error?.scrollIntoView({ behavior: "smooth", block: "center" });
    } finally {
      if (submit) submit.disabled = false;
      if (submitLabel) submitLabel.textContent = "Request a free before-and-after";
    }
  });
</script>
