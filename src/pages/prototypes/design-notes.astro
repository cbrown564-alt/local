---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
import "../../styles/notes-prototypes.css";

const notes = [
  {
    title: "Open with the valley, not the archive",
    body: "The captured page leads with an oval archive photograph, a blue serif title and seven uppercase menu items — while the hotel's own phrase, a mountainside hideaway, appears nowhere on the first screen.",
    change: "One composed scene — the valley framed from a balcony room, the hideaway line as the headline, and four quiet navigation items.",
  },
  {
    title: "Make checking dates effortless",
    body: "Book Now is one menu item among seven, and checking availability means leaving for the booking engine with no dates in hand.",
    change: "A persistent availability bar — arrive, nights, guests — that passes straight into the hotel's existing Bookin1 engine.",
  },
  {
    title: "Let the estate do the selling",
    body: "Twelve wooded acres, the river trail, Mourne Honey afternoon tea and the Brandy Pad Lounge are real, published draws — but they all live behind dropdown menus.",
    change: "The opening copy carries the estate's story in one breath, with afternoon tea one step away.",
  },
];

const variants = [
  { id: "cards", label: "A · Cards", desc: "Current production layout — three equal columns." },
  { id: "timeline", label: "B · Timeline", desc: "Single column, numbered steps with a connecting rail." },
  { id: "accordion", label: "C · Accordion", desc: "Compact headers; expand one note at a time." },
  { id: "ledger", label: "D · Ledger", desc: "Observed vs proposed in a two-column table." },
];
---

<BaseLayout
  title="Design notes prototypes — Mourne & Main"
  description="Compare four layout approaches for transformation design notes."
  robots="noindex, nofollow"
>
  <section class="notes-prototype-hero">
    <div class="shell">
      <p class="eyebrow">Internal prototype</p>
      <h1>Design notes layouts</h1>
      <p class="lede">Four ways to present the reasoning behind a transformation. Sample content from Enniskeen Country House Hotel.</p>
      <p class="notes-prototype-meta"><a class="text-link" href="/transformations/hotel-enniskeen/">Back to live case study <ArrowIcon /></a></p>
    </div>
  </section>

  <div class="notes-prototype-switcher">
    <div class="shell">
      <div class="notes-prototype-tabs" role="tablist" aria-label="Layout variants">
        {variants.map((variant, index) => (
          <button
            type="button"
            class="notes-prototype-tab"
            role="tab"
            id={`tab-${variant.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`panel-${variant.id}`}
            data-variant-tab={variant.id}
          >
            {variant.label}
          </button>
        ))}
      </div>
    </div>
  </div>

  <section
    id="panel-cards"
    class="notes-prototype-panel notes-variant-cards"
    role="tabpanel"
    aria-labelledby="tab-cards"
    data-active="true"
    data-variant-panel="cards"
  >
    <div class="shell">
      <div class="notes-section-head">
        <p class="eyebrow">Variant A</p>
        <h2>Three changes to make the stay feel closer.</h2>
        <p class="notes-prototype-meta">{variants[0].desc}</p>
      </div>
      <div class="notes-grid">
        {notes.map((note, index) => (
          <article class="note-card">
            <span class="note-number">{index + 1}</span>
            <h3>{note.title}</h3>
            <p>{note.body}</p>
            <p class="note-change"><strong>Change:</strong> {note.change}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section
    id="panel-timeline"
    class="notes-prototype-panel notes-variant-timeline"
    role="tabpanel"
    aria-labelledby="tab-timeline"
    data-variant-panel="timeline"
  >
    <div class="shell">
      <div class="notes-section-head">
        <p class="eyebrow">Variant B</p>
        <h2>Three changes to make the stay feel closer.</h2>
        <p class="notes-prototype-meta">{variants[1].desc}</p>
      </div>
      <ol class="timeline-list">
        {notes.map((note, index) => (
          <li class="timeline-item">
            <span class="timeline-marker">{index + 1}</span>
            <div class="timeline-body">
              <h3>{note.title}</h3>
              <p>{note.body}</p>
              <p class="timeline-change"><strong>Change:</strong> {note.change}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section
    id="panel-accordion"
    class="notes-prototype-panel notes-variant-accordion"
    role="tabpanel"
    aria-labelledby="tab-accordion"
    data-variant-panel="accordion"
  >
    <div class="shell">
      <div class="notes-section-head">
        <p class="eyebrow">Variant C</p>
        <h2>Three changes to make the stay feel closer.</h2>
        <p class="notes-prototype-meta">{variants[2].desc}</p>
      </div>
      <ul class="accordion-list">
        {notes.map((note, index) => (
          <li class="accordion-item" data-open={index === 0 ? "true" : "false"}>
            <button type="button" class="accordion-trigger" aria-expanded={index === 0 ? "true" : "false"}>
              <span class="accordion-num">{index + 1}</span>
              <span class="accordion-title">{note.title}</span>
              <span class="accordion-icon" aria-hidden="true">+</span>
            </button>
            <div class="accordion-panel">
              <p>{note.body}</p>
              <p class="accordion-change"><strong>Change:</strong> {note.change}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section
    id="panel-ledger"
    class="notes-prototype-panel notes-variant-ledger"
    role="tabpanel"
    aria-labelledby="tab-ledger"
    data-variant-panel="ledger"
  >
    <div class="shell">
      <div class="notes-section-head">
        <p class="eyebrow">Variant D</p>
        <h2>Three changes to make the stay feel closer.</h2>
        <p class="notes-prototype-meta">{variants[3].desc}</p>
      </div>
      <div class="ledger-table">
        <div class="ledger-head">
          <span>What we saw</span>
          <span>What we'd change</span>
        </div>
        {notes.map((note, index) => (
          <div class="ledger-row">
            <h3 class="ledger-row-title"><span>{String(index + 1).padStart(2, "0")}</span>{note.title}</h3>
            <div class="ledger-cell">
              <span class="ledger-label">Observed</span>
              <p>{note.body}</p>
            </div>
            <div class="ledger-cell ledger-cell-proposed">
              <span class="ledger-label">Proposed</span>
              <p>{note.change}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-variant-tab]");
  const panels = document.querySelectorAll<HTMLElement>("[data-variant-panel]");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const id = tab.dataset.variantTab;
      tabs.forEach((item) => item.setAttribute("aria-selected", String(item === tab)));
      panels.forEach((panel) => {
        panel.dataset.active = String(panel.dataset.variantPanel === id);
      });
    });
  });

  document.querySelectorAll<HTMLElement>(".accordion-item").forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>(".accordion-trigger");
    trigger?.addEventListener("click", () => {
      const isOpen = item.dataset.open === "true";
      document.querySelectorAll<HTMLElement>(".accordion-item").forEach((other) => {
        other.dataset.open = "false";
        other.querySelector(".accordion-trigger")?.setAttribute("aria-expanded", "false");
      });
      if (!isOpen) {
        item.dataset.open = "true";
        trigger.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>
