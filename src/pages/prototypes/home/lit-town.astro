---
import BaseLayout from "../../../site/layouts/BaseLayout.astro";
import ArrowIcon from "../../../site/components/ArrowIcon.astro";
import businesses from "../../../site/data/businesses.json";
import { isTradingBusiness } from "../../../../tools/pipeline/census-class.mjs";

// Prototype only (noindex). Counts follow the website-status publish bar:
// Trading businesses, mapped points, never raw census rows. See
// research/pipeline/census-confidence-decision-2026-08-05.md.
const trading = businesses.filter((b) => isTradingBusiness(b));
const isLit = (b: (typeof businesses)[number]) =>
  b.websiteStatus === "HTTPS website" || b.websiteStatus === "HTTP website";
const points = trading.flatMap((b) =>
  typeof b.lat === "number" && typeof b.lon === "number"
    ? [{ lat: b.lat, lon: b.lon, lit: isLit(b) }]
    : [],
);
const plotted = points.length;
const darkMapped = points.filter((p) => !p.lit).length;
const litCount = points.filter((p) => p.lit).length;
---

<BaseLayout
  title="Prototype D · Lit Town — Mourne Made"
  description="Homepage alternative: a live 3D model of the Mournes and Dundrum Bay with every reviewed local business as a point of light."
  robots="noindex, nofollow"
  class="lit-town-page"
  hideHeader
  ogImage="/media/place/mournes-newcastle.jpg"
>
  <nav class="home-alt-nav lt-nav" aria-label="Homepage alternatives">
    <a href="/prototypes/home/">Index</a>
    <a href="/prototypes/home/product/">A · Product</a>
    <a href="/prototypes/home/bay/">B · Bay</a>
    <a href="/prototypes/home/window/">C · Window</a>
    <a href="/prototypes/home/lit-town/" aria-current="page">D · Lit Town</a>
    <a href="/">Live homepage</a>
  </nav>

  <section class="lt-hero" id="lt-hero" data-time="dusk" aria-label="A live model of Dundrum Bay and the Mourne Mountains with every reviewed local business shown as a point of light at its real location">
    <script is:inline>
      (() => {
        const hero = document.getElementById("lt-hero");
        if (!hero) return;
        const override = new URLSearchParams(location.search).get("time");
        if (override === "day" || override === "dusk" || override === "night") {
          hero.dataset.time = override;
          return;
        }
        const hour = new Date().getHours();
        if (hour >= 9 && hour < 17) hero.dataset.time = "day";
        else if ((hour >= 17 && hour < 23) || (hour >= 5 && hour < 9))
          hero.dataset.time = "dusk";
        else hero.dataset.time = "night";
      })();
    </script>

    <img
      class="lt-fallback"
      src="/media/place/mournes-newcastle.jpg"
      alt="Low tide on Newcastle beach with the town and Mourne Mountains beyond"
      width="2000"
      height="1250"
      loading="eager"
    />

    <div class="lt-scrim" aria-hidden="true"></div>

    <div class="lt-copy">
      <p class="lt-kicker">Dundrum + Newcastle, County Down</p>
      <p class="lt-brand" aria-label="Mourne Made"><span>Mourne</span><span class="wordmark-amp">Made</span></p>
      <h1>Where the mountains sweep down to the sea, about half the independent traders we mapped still have no site of their own.</h1>
      <p class="lt-count" aria-live="polite">
        <strong>{darkMapped} of {plotted}</strong> mapped independent traders have no website of their own.
      </p>
      <div class="button-row lt-actions">
        <a class="button" href="/request/">Light yours — free before-and-after <ArrowIcon /></a>
        <a class="text-link lt-secondary" href="/transformations/">Browse local transformations <ArrowIcon /></a>
      </div>
      <div class="lt-legend">
        <span><i class="lt-dot lt-dot-lit" aria-hidden="true"></i> has its own website today</span>
        <span><i class="lt-dot lt-dot-dark" aria-hidden="true"></i> none found in public listings</span>
        <button class="lt-sound" type="button" data-state="off">
          <span class="lt-sound-off">Hear the bay</span>
          <span class="lt-sound-on">Sound off</span>
        </button>
      </div>
    </div>

    <p class="lt-honesty">
      Real terrain from open elevation data. {plotted} mapped independent
      traders at their public coordinates ({litCount} with a website,
      {darkMapped} without — August 2026 verification pass). Prototype only;
      not the live homepage. Lighting follows your local time. Sound, when on,
      is synthesised in your browser — no recording plays.
    </p>

    <script
      type="application/json"
      id="lt-points"
      is:inline
      set:html={JSON.stringify(points)}
    />
  </section>

  <section class="lt-review-note">
    <div class="shell">
      <p class="eyebrow">Internal prototype · August 2026</p>
      <h2>Direction D — the town as the proof.</h2>
      <p>
        The first viewport is a live 3D model of our own valley: real SRTM
        elevation for the Mournes and Dundrum Bay, and every business from the
        review dataset placed at its real coordinates. Businesses with a
        website glow; the rest sit dark. The claim, the map and the emotion
        are all the same dataset the pipeline already maintains, so the hero
        can never say something the data doesn't.
      </p>
      <p>
        Falls back to the existing photography when WebGL is unavailable, and
        to a settled still frame under reduced motion. Append
        <code>?time=day</code>, <code>?time=dusk</code> or
        <code>?time=night</code> to review each lighting state.
      </p>
      <p><a class="text-link" href="/prototypes/home/">Back to the prototype index <ArrowIcon /></a></p>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    initLitTownHero,
    ShoreSound,
    type LitTownTime,
  } from "../../../site/scripts/lit-town-hero";

  const hero = document.getElementById("lt-hero");
  const dataElement = document.getElementById("lt-points");
  if (hero && dataElement?.textContent) {
    const points = JSON.parse(dataElement.textContent);
    const time = (hero.dataset.time ?? "dusk") as LitTownTime;
    const booted = initLitTownHero(hero, { points, time });
    if (!booted) hero.classList.add("lt-no-webgl");

    const soundButton = hero.querySelector<HTMLButtonElement>(".lt-sound");
    if (soundButton) {
      const shore = new ShoreSound();
      soundButton.addEventListener("click", () => {
        soundButton.dataset.state = shore.toggle() ? "on" : "off";
      });
    }
  }
</script>

<style>
  .lt-nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 5;
    display: flex;
    gap: 1.1rem;
    padding: 0.9rem 1.4rem;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    background: linear-gradient(180deg, rgb(6 10 20 / 55%), transparent);
  }

  .lt-nav a {
    color: rgb(235 242 248 / 82%);
    text-decoration: none;
  }

  .lt-nav a[aria-current="page"] {
    color: #ffc46a;
  }

  .lt-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: #eef3f8;
    background: linear-gradient(
      180deg,
      #10182b 0%,
      #232f4f 46%,
      #5c4340 76%,
      #b97e49 100%
    );
  }

  .lt-hero[data-time="day"] {
    background: linear-gradient(180deg, #9fc0d4 0%, #c8dbe6 55%, #e6eef2 100%);
    color: #132029;
  }

  .lt-hero[data-time="night"] {
    background: linear-gradient(180deg, #04070f 0%, #0a1122 60%, #16223c 100%);
  }

  .lt-hero :global(.lt-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .lt-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
  }

  .lt-no-webgl .lt-fallback {
    display: block;
  }

  .lt-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 50%, rgb(5 9 18 / 45%) 100%),
      linear-gradient(100deg, rgb(5 9 18 / 48%) 0%, transparent 52%);
    pointer-events: none;
  }

  .lt-hero[data-time="day"] .lt-scrim {
    background:
      linear-gradient(180deg, transparent 40%, rgb(230 238 242 / 55%) 100%),
      linear-gradient(100deg, rgb(230 238 242 / 45%) 0%, transparent 55%);
  }

  .lt-hero[data-time="day"] .lt-kicker,
  .lt-hero[data-time="day"] .lt-count,
  .lt-hero[data-time="day"] .lt-legend,
  .lt-hero[data-time="day"] .lt-honesty {
    color: rgb(19 32 41 / 78%);
  }

  .lt-hero[data-time="day"] .lt-count strong {
    color: #8a5410;
  }

  .lt-hero[data-time="day"] .lt-secondary {
    color: rgb(19 32 41 / 88%);
  }

  .lt-hero[data-time="day"] .lt-sound {
    border-color: rgb(19 32 41 / 40%);
  }

  .lt-hero[data-time="day"] .lt-brand .wordmark-amp {
    color: #8a5410;
  }

  .lt-hero[data-time="day"] .lt-dot-dark {
    background: #35516e;
  }

  .lt-copy {
    position: relative;
    z-index: 2;
    max-width: 44rem;
    padding: 6.5rem clamp(1.4rem, 5vw, 4.5rem) 4.6rem;
  }

  .lt-kicker {
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(238 243 248 / 72%);
    margin: 0 0 0.6rem;
  }

  .lt-brand {
    font-family: "Antonio Variable", sans-serif;
    font-weight: 640;
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 1.6rem;
  }

  .lt-brand .wordmark-amp {
    color: #ffc46a;
  }

  .lt-hero h1 {
    font-family: "Antonio Variable", sans-serif;
    font-weight: 560;
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    line-height: 1.04;
    letter-spacing: 0.005em;
    margin: 0 0 1.2rem;
    text-wrap: balance;
  }

  .lt-count {
    font-size: clamp(1.02rem, 1.6vw, 1.2rem);
    margin: 0 0 1.7rem;
    color: rgb(238 243 248 / 88%);
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 900ms ease,
      transform 900ms ease;
  }

  .lt-count strong {
    color: #ffc46a;
    font-size: 1.35em;
    font-family: "Antonio Variable", sans-serif;
    font-weight: 620;
    letter-spacing: 0.01em;
  }

  :global(.lt-counts-on) .lt-count,
  .lt-no-webgl .lt-count {
    opacity: 1;
    transform: none;
  }

  .lt-actions {
    margin-bottom: 1.9rem;
  }

  .lt-secondary {
    color: rgb(238 243 248 / 85%);
  }

  .lt-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.3rem;
    font-size: 0.83rem;
    color: rgb(238 243 248 / 68%);
    opacity: 0;
    transition: opacity 900ms ease 200ms;
  }

  :global(.lt-lights-on) .lt-legend,
  .lt-no-webgl .lt-legend {
    opacity: 1;
  }

  .lt-dot {
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    margin-right: 0.4rem;
    vertical-align: baseline;
  }

  .lt-dot-lit {
    background: #ffc46a;
    box-shadow: 0 0 8px rgb(255 196 106 / 85%);
  }

  .lt-dot-dark {
    background: #54688a;
  }

  .lt-sound {
    border: 1px solid rgb(238 243 248 / 35%);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.83rem;
    padding: 0.32rem 0.95rem;
    cursor: pointer;
  }

  .lt-sound:hover {
    border-color: rgb(238 243 248 / 70%);
  }

  .lt-sound .lt-sound-on,
  .lt-sound[data-state="on"] .lt-sound-off {
    display: none;
  }

  .lt-sound[data-state="on"] .lt-sound-on {
    display: inline;
  }

  .lt-honesty {
    position: absolute;
    right: clamp(1.2rem, 3vw, 2.4rem);
    bottom: 1.1rem;
    z-index: 2;
    max-width: 21rem;
    margin: 0;
    font-size: 0.72rem;
    line-height: 1.45;
    text-align: right;
    color: rgb(238 243 248 / 52%);
  }

  .lt-review-note {
    padding: 4.5rem 0 5.5rem;
    background: var(--foam, #f4f8fa);
  }

  .lt-review-note h2 {
    font-family: "Antonio Variable", sans-serif;
    margin: 0.5rem 0 1rem;
  }

  .lt-review-note p {
    max-width: 46rem;
  }

  @media (max-width: 720px) {
    .lt-honesty {
      position: static;
      max-width: none;
      text-align: left;
      padding: 0 1.4rem 5.5rem;
      order: 3;
    }

    .lt-hero {
      flex-direction: column;
      justify-content: flex-end;
    }

    .lt-copy {
      padding-bottom: 1.6rem;
    }
  }
</style>
