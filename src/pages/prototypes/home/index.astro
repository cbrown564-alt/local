---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArrowIcon from "../../../components/ArrowIcon.astro";
import "../../../styles/home-alternatives.css";

const variants = [
  {
    href: "/prototypes/home/product/",
    title: "A · Product Stage",
    desc: "Lead with the before/after as the dominant first-viewport image. Local belonging arrives next as a full-bleed bay moment — sequential, not competing.",
    image: "/images/donard-veterinary-concept.jpg",
    alt: "Donard Veterinary concept opening screen",
  },
  {
    href: "/prototypes/home/bay/",
    title: "B · Bay Opening",
    desc: "Give the shore the whole first viewport: brand, one line, CTAs. The featured transformation gets its own full-width section immediately below.",
    image: "/images/place/mournes-newcastle.jpg",
    alt: "Newcastle beach with the Mourne Mountains beyond",
  },
  {
    href: "/prototypes/home/window/",
    title: "C · Promenade Window",
    desc: "One composition: Main Street as awning and fascia; the before/after sits in the shop window. Place frames the product instead of competing with it.",
    image: "/images/place/businesses-main-street-dundrum.jpg",
    alt: "Shopfronts on Main Street, Dundrum",
  },
];
---

<BaseLayout
  title="Homepage alternatives — Mourne & Main"
  description="Three homepage directions that separate or blend product-first and place-first ideas."
  robots="noindex, nofollow"
  class="home-alt"
>
  <section class="home-alt-index">
    <div class="shell">
      <p class="eyebrow">Internal prototype</p>
      <h1>Homepage alternatives</h1>
      <p class="lede">
        Explored before shipping Product Stage to <a class="text-link" href="/">/</a>.
        A leads with the comparison; B gives the bay the first viewport; C blends place as a Main Street fascia.
      </p>
      <div class="home-alt-index-grid">
        {variants.map((variant) => (
          <a class="home-alt-index-card" href={variant.href}>
            <img src={variant.image} alt={variant.alt} width="960" height="600" />
            <div class="home-alt-index-card-body">
              <h2>{variant.title}</h2>
              <p>{variant.desc}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="home-alt-index-meta">
        <p>For design review only. Compare against the live homepage at <a class="text-link" href="/">/</a>.</p>
        <p><a class="text-link" href="/">Back to live homepage <ArrowIcon /></a></p>
      </div>
    </div>
  </section>
</BaseLayout>
