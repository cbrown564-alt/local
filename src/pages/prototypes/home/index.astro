---
import BaseLayout from "../../../site/layouts/BaseLayout.astro";
import "@fontsource-variable/manrope/wght.css";
import "../../../site/styles/home-radical.css";

const directions = [
  {
    href: "/prototypes/home/signal/",
    label: "A · Signal",
    title: "High-saturation signal",
    description: "Dark bay blue, acid yellow and coral. One sans family. Flat controls with a sharper, more urgent read.",
    image: "/media/place/mournes-newcastle.jpg",
    alt: "Newcastle beach and the Mourne Mountains",
    meta: "Dark / kinetic / direct",
  },
  {
    href: "/prototypes/home/field/",
    label: "B · Field note",
    title: "Warm field note",
    description: "Vermilion, blue and unbleached white. A display serif gives the studio a more human, signwriter-like voice.",
    image: "/media/place/businesses-main-street-dundrum.jpg",
    alt: "Businesses along Main Street in Dundrum",
    meta: "Warm / crafted / local",
  },
  {
    href: "/prototypes/home/channel/",
    label: "C · Open channel",
    title: "Bright open channel",
    description: "Electric green, lilac and ink. More air, more asymmetry, and a calm sans-led system that lets the copy lead.",
    image: "/media/place/boats-moored-at-newcastle-harbour.jpg",
    alt: "Boats moored in Newcastle Harbour",
    meta: "Bright / spacious / clear",
  },
  {
    href: "/prototypes/home/lit-town/",
    label: "D · Lit Town",
    title: "The town as the proof",
    description:
      "A live 3D model of the Mournes and Dundrum Bay from real elevation data, with every reviewed business as a light at its real coordinates — lit if it has a website, dark if not.",
    image: "/media/place/mournes-newcastle.jpg",
    alt: "Newcastle beach and the Mourne Mountains at low tide",
    meta: "Live / place-first / data-honest",
  },
  {
    href: "/prototypes/home/film/",
    label: "E · Film",
    title: "The day as the pitch",
    description:
      "One generated dawn-to-dusk film per town — Dundrum's quiet bay, Newcastle where the mountains sweep to the sea — behind the unchanged pitch, with the before/after as the proof fold beneath. Currently running on stand-in clips.",
    image: "/media/home/newcastle-film-poster.jpg",
    alt: "Generated dusk frame from the Newcastle town film — an imagined day, not footage",
    meta: "Generative / cinematic / town-switched",
  },
];
---

<BaseLayout title="Three new homepage directions — Mourne Made" description="Three radical homepage directions for Mourne Made." robots="noindex, nofollow" class="radical-page radical-index" hideHeader hideFooter>
  <nav class="radical-nav" aria-label="Homepage alternative prototypes">
    <a class="radical-nav-brand" href="/prototypes/home/">Mourne Made / design review</a>
    <div class="radical-nav-links">
      {directions.map((direction) => <a href={direction.href}>{direction.label}</a>)}
      <a href="/">Live homepage</a>
    </div>
  </nav>

  <main>
    <section class="index-intro">
      <div class="shell">
        <p class="index-kicker">Internal prototype set · August 2026</p>
        <h1>Three ways to make the studio feel different.</h1>
        <p>These directions keep the same promise, local evidence and before-and-after interaction, but change the colour system, typography, controls and page rhythm from the current Product Stage.</p>
      </div>
    </section>

    <section class="shell radical-index-grid" aria-label="Homepage directions">
      {directions.map((direction) => (
        <a class="radical-index-card" href={direction.href}>
          <div class="radical-index-card-visual"><img src={direction.image} alt={direction.alt} width="1200" height="900" /></div>
          <div class="radical-index-card-copy">
            <div class="radical-index-card-meta"><span>{direction.label}</span><span>Open →</span></div>
            <h2>{direction.title}</h2>
            <p>{direction.description}</p>
            <p>{direction.meta}</p>
          </div>
        </a>
      ))}
    </section>

    <div class="shell radical-index-note">
      <p>For design review only. The existing Product / Bay / Window explorations remain available under <a href="/prototypes/home/product/">the previous set</a>.</p>
    </div>
  </main>
</BaseLayout>
