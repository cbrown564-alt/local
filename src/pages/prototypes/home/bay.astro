---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArrowIcon from "../../../components/ArrowIcon.astro";
import BeforeAfter from "../../../components/BeforeAfter.astro";
import Disclosure from "../../../components/Disclosure.astro";
import LocalStrip from "../../../components/LocalStrip.astro";
import MourneMotif from "../../../components/MourneMotif.astro";
import { featuredTransformation } from "../../../data/transformations";
import "../../../styles/home-alternatives.css";
import "../../../styles/home.css";
---

<BaseLayout
  title="Prototype B · Bay Opening — Mourne & Main"
  description="Homepage alternative that gives the bay the first viewport, then the product."
  robots="noindex, nofollow"
  class="home-alt home-alt-b"
  ogImage="/images/place/mournes-newcastle.jpg"
>
  <nav class="home-alt-nav" aria-label="Homepage alternatives">
    <a href="/prototypes/home/">Index</a>
    <a href="/prototypes/home/product/">A · Product</a>
    <a href="/prototypes/home/bay/" aria-current="page">B · Bay</a>
    <a href="/prototypes/home/window/">C · Window</a>
  </nav>

  <section class="alt-b-hero" aria-label="Place-led homepage concept">
    <div class="alt-b-media">
      <img
        src="/images/place/mournes-newcastle.jpg"
        alt="Low tide on Newcastle beach with the town and Mourne Mountains beyond"
        width="2000"
        height="1250"
      />
    </div>
    <div class="alt-b-scrim" aria-hidden="true"></div>
    <div class="alt-b-content">
      <p class="home-alt-kicker alt-b-kicker">Dundrum + Newcastle, County Down</p>
      <p class="home-alt-brand alt-b-brand" aria-label="Mourne and Main">
        <span>Mourne</span><span class="wordmark-amp">&amp;</span><span>Main</span>
      </p>
      <h1>See what your business could become online.</h1>
      <p class="lede">A local studio that starts with the shore and the street — then shows a clearer website before you spend a penny.</p>
      <div class="button-row">
        <a class="button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
        <a class="text-link" href="/transformations/">Browse local transformations <ArrowIcon /></a>
      </div>
    </div>
  </section>

  <section class="alt-follow-disclosure">
    <div class="shell">
      <Disclosure compact />
    </div>
  </section>

  <section class="alt-b-proof" aria-labelledby="alt-b-proof-heading">
    <div class="alt-b-proof-head">
      <p class="eyebrow">One familiar example</p>
      <h2 id="alt-b-proof-heading">Drag to see the difference.</h2>
      <div class="alt-b-proof-meta">
        <p>{featuredTransformation.name} · {featuredTransformation.town}</p>
        <a class="text-link" href={featuredTransformation.href}>Open the full comparison <ArrowIcon /></a>
      </div>
    </div>
    <div class="alt-b-comparison-wrap">
      <BeforeAfter
        before={featuredTransformation.before}
        after={featuredTransformation.after}
        beforeAlt={featuredTransformation.beforeAlt}
        afterAlt={featuredTransformation.afterAlt}
        showNotes={false}
      />
    </div>
  </section>

  <section class="home-how-it-works section-warm" aria-labelledby="alt-b-how-heading">
    <div class="shell">
      <p class="eyebrow">How it works</p>
      <h2 id="alt-b-how-heading">Three steps, no pressure.</h2>
      <ol class="home-steps">
        <li class="home-step">
          <span class="home-step-number" aria-hidden="true">01</span>
          <h3>Share your link</h3>
          <p>Tell us your business and what matters most.</p>
        </li>
        <li class="home-step">
          <span class="home-step-number" aria-hidden="true">02</span>
          <h3>See a concept</h3>
          <p>We build one focused before-and-after screen.</p>
        </li>
        <li class="home-step">
          <span class="home-step-number" aria-hidden="true">03</span>
          <h3>Decide in your own time</h3>
          <p>No obligation, no hard sell.</p>
        </li>
      </ol>
    </div>
  </section>

  <LocalStrip />
  <MourneMotif tone="blue" />

  <section class="promise">
    <div class="shell promise-grid">
      <div class="promise-stat">379<span>public local listings reviewed so far</span></div>
      <div class="promise-copy">
        <p class="eyebrow">A local commitment</p>
        <h2>Good digital work should reach the whole community.</h2>
        <p>Paid projects keep the studio going. A share of that time goes back into free or reduced-cost work for local clubs, charities and organisations that would benefit but cannot justify a full commercial budget.</p>
        <a class="text-link" href="/about/">Why local comes first <ArrowIcon /></a>
      </div>
    </div>
  </section>

  <section class="closing-cta">
    <div class="shell">
      <h2>Ready to see the difference?</h2>
      <p>Tell us about your business and we'll send a free before-and-after concept — no obligation.</p>
      <div class="button-row">
        <a class="button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
        <a class="text-link" href="/transformations/">Browse local transformations <ArrowIcon /></a>
      </div>
    </div>
  </section>
</BaseLayout>
