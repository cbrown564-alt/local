---
import BaseLayout from "../../../site/layouts/BaseLayout.astro";
import ArrowIcon from "../../../site/components/ArrowIcon.astro";
import BeforeAfter from "../../../site/components/BeforeAfter.astro";
import { featuredTransformation } from "../../../site/data/transformations";
import "@fontsource-variable/manrope/wght.css";
import "@fontsource/yeseva-one/400.css";
import "../../../site/styles/home-radical.css";
---

<BaseLayout title="Direction B · Field note — Mourne Made" description="A warm, signwriter-inspired homepage direction for Mourne Made." robots="noindex, nofollow" class="radical-page radical-field" hideHeader hideFooter ogImage="/media/place/businesses-main-street-dundrum.jpg">
  <nav class="radical-nav" aria-label="Homepage alternative prototypes">
    <a class="radical-nav-brand" href="/prototypes/home/">Mourne Made / three directions</a>
    <div class="radical-nav-links">
      <a href="/prototypes/home/signal/">A · Signal</a>
      <a href="/prototypes/home/field/" aria-current="page">B · Field note</a>
      <a href="/prototypes/home/channel/">C · Open channel</a>
    </div>
  </nav>

  <main>
    <section class="field-hero" aria-labelledby="field-heading">
      <div class="shell field-hero-grid">
        <div>
          <p class="field-label">A local digital studio / Dundrum + Newcastle</p>
          <p class="field-wordmark">Mourne Made</p>
          <h1 id="field-heading">Give good work a clearer door.</h1>
          <p class="field-hero-lede">We make the next customer step easier to find, then show you the change before asking you to commit.</p>
          <div class="field-actions">
            <a class="field-button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
            <a class="field-link" href="/transformations/">Read the local examples <ArrowIcon /></a>
          </div>
        </div>
        <figure class="field-image-frame">
          <img src="/media/place/businesses-main-street-dundrum.jpg" alt="Businesses along Main Street in Dundrum" width="2000" height="1250" />
          <figcaption class="field-image-caption">Made for the places people already know</figcaption>
        </figure>
      </div>
    </section>

    <section class="field-proof" aria-labelledby="field-proof-heading">
      <div class="shell">
        <div class="field-proof-head">
          <h2 id="field-proof-heading">A useful change, on the page.</h2>
          <p>This is the part we make first: one focused before-and-after built around a real business and a real customer action.</p>
        </div>
        <div class="field-proof-stage">
          <BeforeAfter before={featuredTransformation.before} after={featuredTransformation.after} beforeAlt={featuredTransformation.beforeAlt} afterAlt={featuredTransformation.afterAlt} showNotes={false} />
          <p class="field-image-caption" style="color: var(--radical-ink)">{featuredTransformation.name} · {featuredTransformation.town} · concept work, independently made</p>
        </div>
      </div>
    </section>

    <section class="field-index-band" aria-label="The approach">
      <div class="shell field-index">
        <article class="field-index-item"><h3>Notice</h3><p>We start with the public route a customer is already taking.</p></article>
        <article class="field-index-item"><h3>Make</h3><p>We build the smallest screen or page that makes the next step clearer.</p></article>
        <article class="field-index-item"><h3>Keep</h3><p>We leave you with accounts, content and maintenance you can actually own.</p></article>
      </div>
    </section>

    <section class="field-close" aria-labelledby="field-close-heading">
      <div class="shell">
        <h2 id="field-close-heading">What would yours say?</h2>
        <p>Send the link people use today. We will return a free before-and-after concept for the route that matters most.</p>
        <div class="button-row"><a class="field-button" href="/request/">Start with your link <ArrowIcon /></a></div>
      </div>
    </section>
  </main>
</BaseLayout>
