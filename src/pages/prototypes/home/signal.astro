---
import BaseLayout from "../../../site/layouts/BaseLayout.astro";
import ArrowIcon from "../../../site/components/ArrowIcon.astro";
import BeforeAfter from "../../../site/components/BeforeAfter.astro";
import { featuredTransformation } from "../../../site/data/transformations";
import "@fontsource-variable/manrope/wght.css";
import "../../../site/styles/home-radical.css";
---

<BaseLayout title="Direction A · Signal — Mourne Made" description="A dark, high-saturation homepage direction for Mourne Made." robots="noindex, nofollow" class="radical-page radical-signal" hideHeader hideFooter ogImage="/media/place/mournes-newcastle.jpg">
  <nav class="radical-nav" aria-label="Homepage alternative prototypes">
    <a class="radical-nav-brand" href="/prototypes/home/">Mourne Made / three directions</a>
    <div class="radical-nav-links">
      <a href="/prototypes/home/signal/" aria-current="page">A · Signal</a>
      <a href="/prototypes/home/field/">B · Field note</a>
      <a href="/prototypes/home/channel/">C · Open channel</a>
    </div>
  </nav>

  <main>
    <section class="signal-hero" aria-labelledby="signal-heading">
      <div class="signal-hero-copy">
        <p class="signal-status">Dundrum + Newcastle / County Down</p>
        <p class="signal-brand"><span>mourne</span><span>made</span></p>
        <h1 id="signal-heading">Make the next click feel obvious.</h1>
        <p class="signal-hero-lede">A website should move a person from local interest to the action that keeps your business going.</p>
        <div class="signal-actions">
          <a class="signal-button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
          <a class="signal-link" href="/transformations/">Browse the work <ArrowIcon /></a>
        </div>
      </div>
      <figure class="signal-hero-media">
        <img src="/media/place/mournes-newcastle.jpg" alt="Newcastle beach with the town and Mourne Mountains beyond" width="2000" height="1250" />
        <figcaption class="signal-hero-label">Local context / useful change</figcaption>
      </figure>
    </section>

    <section class="signal-proof" aria-labelledby="signal-proof-heading">
      <div class="shell signal-proof-grid">
        <div>
          <h2 id="signal-proof-heading">See it working.</h2>
          <p class="signal-proof-intro">Before you pay for a rebuild, see one useful change on a familiar business. Drag the line and decide if the route feels clearer.</p>
        </div>
        <div class="signal-proof-stage">
          <BeforeAfter before={featuredTransformation.before} after={featuredTransformation.after} beforeAlt={featuredTransformation.beforeAlt} afterAlt={featuredTransformation.afterAlt} showNotes={false} compact />
          <p class="signal-proof-caption"><span>{featuredTransformation.name} · {featuredTransformation.town}</span><a href={featuredTransformation.href}>Open the full comparison <ArrowIcon /></a></p>
        </div>
      </div>
    </section>

    <section class="signal-rows" aria-label="What the work makes clearer">
      <div class="shell">
        <div class="signal-row"><h3>Find the action</h3><p>Booking, ordering, enquiry, visit, repeat purchase — the useful next step belongs in the first conversation.</p></div>
        <div class="signal-row"><h3>Keep what is true</h3><p>Your identity, your images and your way of working are the raw material. A clearer route does not need to erase the business.</p></div>
        <div class="signal-row"><h3>Make the scope fit</h3><p>Start with the smallest useful change, then measure the action it is meant to improve before adding more.</p></div>
      </div>
    </section>

    <section class="signal-close" aria-labelledby="signal-close-heading">
      <div class="shell">
        <h2 id="signal-close-heading">Show me mine.</h2>
        <p>Tell us where people get stuck and we will send a free before-and-after concept, with no obligation.</p>
        <div class="button-row"><a class="signal-button" href="/request/">Request yours <ArrowIcon /></a></div>
      </div>
    </section>
  </main>
</BaseLayout>
