---
import BaseLayout from "../../../site/layouts/BaseLayout.astro";
import ArrowIcon from "../../../site/components/ArrowIcon.astro";
import BeforeAfter from "../../../site/components/BeforeAfter.astro";
import Disclosure from "../../../site/components/Disclosure.astro";
import LocalStrip from "../../../site/components/LocalStrip.astro";
import MourneMotif from "./_MourneMotif.astro";
import { featuredTransformation } from "../../../site/data/transformations";
import "../../../site/styles/home-alternatives.css";
import "../../../site/styles/home.css";
---

<BaseLayout
  title="Prototype C · Promenade Window — Mourne Made"
  description="Homepage alternative that blends place atmosphere with a shop-window product comparison."
  robots="noindex, nofollow"
  class="home-alt home-alt-c"
  ogImage="/media/place/businesses-main-street-dundrum.jpg"
>
  <nav class="home-alt-nav" aria-label="Homepage alternatives">
    <a href="/prototypes/home/">Index</a>
    <a href="/prototypes/home/product/">A · Product</a>
    <a href="/prototypes/home/bay/">B · Bay</a>
    <a href="/prototypes/home/window/" aria-current="page">C · Window</a>
  </nav>

  <section class="alt-c-hero" aria-label="Promenade window homepage concept">
    <div class="alt-c-awning" aria-hidden="true">
      <img
        src="/media/place/businesses-main-street-dundrum.jpg"
        alt=""
        width="2000"
        height="400"
      />
      <div class="alt-c-awning-scrim"></div>
    </div>

    <div class="alt-c-frame">
      <div class="alt-c-copy">
        <p class="home-alt-kicker alt-c-kicker">Dundrum + Newcastle, County Down</p>
        <p class="home-alt-brand alt-c-brand" aria-label="Mourne Made">
          <span>Mourne</span><span class="wordmark-amp">Made</span>
        </p>
        <h1>See what your business could become online.</h1>
        <p class="lede">A shop window on a familiar street — drag to compare before and after.</p>
        <div class="button-row">
          <a class="button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
          <a class="text-link" href="/transformations/">Browse local transformations <ArrowIcon /></a>
        </div>
      </div>

      <div class="alt-c-window">
        <p class="alt-c-window-label">Shop window · {featuredTransformation.name}, {featuredTransformation.town}</p>
        <div class="alt-c-window-frame">
          <div class="alt-c-comparison">
            <BeforeAfter
              before={featuredTransformation.before}
              after={featuredTransformation.after}
              beforeAlt={featuredTransformation.beforeAlt}
              afterAlt={featuredTransformation.afterAlt}
              showNotes={false}
              compact
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="alt-c-follow">
    <div class="shell">
      <Disclosure compact />
    </div>
    <div class="alt-c-follow-copy">
      <p class="eyebrow">Why this blend</p>
      <h2>Place is the fascia. The product is the window.</h2>
      <p>Main Street appears as an awning and a shopfront frame — belonging without competing for the whole viewport. The before/after sits inside that frame as the one thing to look at.</p>
      <p class="alt-c-follow-link">
        <a class="text-link" href={featuredTransformation.href}>Open the full comparison <ArrowIcon /></a>
      </p>
    </div>
  </section>

  <LocalStrip />
  <MourneMotif tone="blue" />

  <section class="promise">
    <div class="shell promise-grid">
      <div class="promise-stat">379<span>public local listings reviewed so far</span></div>
      <div class="promise-copy">
        <p class="eyebrow">A local commitment</p>
        <h2>Good digital work should reach the whole community.</h2>
        <p>Paid projects keep the studio going. A share of that time goes back into free or reduced-cost work for local clubs, charities and organisations that would benefit but cannot justify a full commercial budget.</p>
        <a class="text-link" href="/about/">Why local comes first <ArrowIcon /></a>
      </div>
    </div>
  </section>

  <section class="closing-cta">
    <div class="shell">
      <h2>Ready to see the difference?</h2>
      <p>Tell us about your business and we'll send a free before-and-after concept — no obligation.</p>
      <div class="button-row">
        <a class="button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
        <a class="text-link" href="/transformations/">Browse local transformations <ArrowIcon /></a>
      </div>
    </div>
  </section>
</BaseLayout>
