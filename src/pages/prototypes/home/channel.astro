---
import BaseLayout from "../../../site/layouts/BaseLayout.astro";
import ArrowIcon from "../../../site/components/ArrowIcon.astro";
import BeforeAfter from "../../../site/components/BeforeAfter.astro";
import { featuredTransformation } from "../../../site/data/transformations";
import "@fontsource-variable/manrope/wght.css";
import "../../../site/styles/home-radical.css";
---

<BaseLayout title="Direction C · Open channel — Mourne Made" description="A bright, asymmetric homepage direction for Mourne Made." robots="noindex, nofollow" class="radical-page radical-channel" hideHeader hideFooter ogImage="/media/place/boats-moored-at-newcastle-harbour.jpg">
  <nav class="radical-nav" aria-label="Homepage alternative prototypes">
    <a class="radical-nav-brand" href="/prototypes/home/">Mourne Made / three directions</a>
    <div class="radical-nav-links">
      <a href="/prototypes/home/signal/">A · Signal</a>
      <a href="/prototypes/home/field/">B · Field note</a>
      <a href="/prototypes/home/channel/" aria-current="page">C · Open channel</a>
    </div>
  </nav>

  <main>
    <section class="channel-hero" aria-labelledby="channel-heading">
      <div class="shell channel-hero-grid">
        <div class="channel-hero-copy">
          <p class="channel-wordmark">Mourne Made / digital work for here</p>
          <div>
            <h1 id="channel-heading">Make room for the right next step.</h1>
            <p class="channel-hero-lede">A right-sized website should help a person decide: book, order, enquire, visit, or come back.</p>
            <div class="channel-actions">
              <a class="channel-button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
              <a class="channel-link" href="/transformations/">Explore transformations <ArrowIcon /></a>
            </div>
          </div>
        </div>
        <figure class="channel-hero-media">
          <img src="/media/place/boats-moored-at-newcastle-harbour.jpg" alt="Boats moored in Newcastle Harbour with the Mourne Mountains beyond" width="2000" height="1250" />
          <figcaption><span>Dundrum + Newcastle</span><span>County Down</span></figcaption>
        </figure>
      </div>
    </section>

    <section class="channel-proof" aria-labelledby="channel-proof-heading">
      <div class="shell">
        <div class="channel-proof-head">
          <h2 id="channel-proof-heading">The change is the proof.</h2>
          <p>We do not ask you to imagine the finished thing. We put a real route in front of you and talk through what it helps a customer do.</p>
        </div>
        <div class="channel-proof-stage">
          <BeforeAfter before={featuredTransformation.before} after={featuredTransformation.after} beforeAlt={featuredTransformation.beforeAlt} afterAlt={featuredTransformation.afterAlt} showNotes={false} compact />
        </div>
      </div>
    </section>

    <section class="channel-points" aria-label="What makes the work useful">
      <div class="shell">
        <div class="channel-point"><h3>Clear enough to act</h3><p>Important information stays visible: hours, prices, availability, contact details and the action that follows.</p></div>
        <div class="channel-point"><h3>Specific enough to judge</h3><p>Every concept starts from a familiar business, its public material and a change someone can understand quickly.</p></div>
        <div class="channel-point"><h3>Small enough to start</h3><p>The next step can be a single page, a better form or a maintained route — not automatically a giant rebuild.</p></div>
      </div>
    </section>

    <section class="channel-close" aria-labelledby="channel-close-heading">
      <div class="shell">
        <h2 id="channel-close-heading">Open the conversation.</h2>
        <p>Tell us what people need to do next. We will send a free before-and-after concept made around that action.</p>
        <div class="button-row"><a class="channel-button" href="/request/">Request yours <ArrowIcon /></a></div>
      </div>
    </section>
  </main>
</BaseLayout>
