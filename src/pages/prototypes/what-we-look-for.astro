---
import BaseLayout from "../../site/layouts/BaseLayout.astro";
import ArrowIcon from "../../site/components/ArrowIcon.astro";
import FaultWalk from "../../site/components/fault-walk/FaultWalk.astro";
import SwapTest from "../../site/components/fault-walk/SwapTest.astro";
import type { FaultWalk as FaultWalkData, SwapTestTheme } from "../../site/data/fault-walks";
import { whatWeLookFor } from "../../site/data/fault-walks";
import "../../site/styles/what-we-look-for.css";

const walks = whatWeLookFor.filter((entry): entry is FaultWalkData => entry.kind === "walk");
const swap = whatWeLookFor.find((entry): entry is SwapTestTheme => entry.kind === "swap");
if (!swap) throw new Error("what-we-look-for: the swap test is missing from the reel");

/* The ten run as three movements: the access faults, the identity faults,
   then the swap test as the closer. The bands are the pacing — they break a
   long scroll into an argument with a beginning, a turn and an ending. */
const parts: Record<string, { tag: string; title: string; blurb: string }> = {
  t1: {
    tag: "Part one",
    title: "Six ordinary errands, stopped or made to wander.",
    blurb:
      "Every stop below was a reasonable decision when somebody made it. Walk the errand yourself and feel where it breaks.",
  },
  t3: {
    tag: "Part two",
    title: "Three working sites that stopped sounding like anyone.",
    blurb:
      "Nothing in this movement is broken. That is what makes these three harder to see.",
  },
};
---

<BaseLayout
  title="What we look for · fault-walk study — Mourne Made"
  description="Prototype of the ten fault themes as walkable wireframes — the page briefed in research/what-we-look-for-brief.md."
  robots="noindex, nofollow"
>
  <div class="wwlf">
    <section class="wwlf-hero">
      <div class="shell">
        <p class="wwlf-hero-ten" aria-hidden="true">10</p>
        <p class="eyebrow">Mourne Made · prototype study · August 2026</p>
        <h1>Ten things we look for before we redesign anything.</h1>
        <p class="lede">
          What twenty concepts taught us to check first — and what each one costs the person
          standing outside your shop.
        </p>
        <p class="wwlf-howto">
          <span class="wwlf-howto-lead">How to read this page.</span> Tap around inside each
          phone. The fault will stop you, or make you hunt — that cost is the point. Then press
          <strong>Fix it</strong> and walk the same errand again.
        </p>
        <p class="wwlf-invented">
          Every demonstration on this page is invented: grey blocks, no business names, no real
          site's fault. The faults we record about real businesses go to the business concerned,
          one to one — never onto a public page. The numbers here are each mock's own; the
          measured figures stay with the named case studies.
        </p>
      </div>
    </section>

    <nav class="wwlf-index" aria-label="The ten themes, in the order we check them">
      <div class="shell">
        <h2>The ten, in the order we check them.</h2>
        <div class="wwlf-index-groups">
          <section class="wwlf-index-group">
            <h3><span>Part one</span> The errand fails</h3>
            <ol>
              {
                walks.slice(0, 6).map((walk) => (
                  <li>
                    <a href={`#${walk.id}`}>
                      <span class="wwlf-index-id">{walk.id}</span>
                      <span class="wwlf-index-name">{walk.theme}</span>
                      <span class="wwlf-index-errand">{walk.errand.toLowerCase()}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </section>
          <section class="wwlf-index-group">
            <h3><span>Part two</span> It could be anyone's</h3>
            <ol>
              {
                walks.slice(6).map((walk) => (
                  <li>
                    <a href={`#${walk.id}`}>
                      <span class="wwlf-index-id">{walk.id}</span>
                      <span class="wwlf-index-name">{walk.theme}</span>
                      <span class="wwlf-index-errand">{walk.errand.toLowerCase()}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </section>
          <section class="wwlf-index-group">
            <h3><span>The closer</span> Done by hand</h3>
            <ol>
              <li>
                <a href={`#${swap.id}`}>
                  <span class="wwlf-index-id">{swap.id}</span>
                  <span class="wwlf-index-name">{swap.theme}</span>
                  <span class="wwlf-index-errand">tell two shopfronts apart</span>
                </a>
              </li>
            </ol>
          </section>
        </div>
      </div>
    </nav>

    <div class="wwlf-themes">
      <div class="shell">
        {
          walks.map((walk) => {
            const part = parts[walk.id];
            return (
              <>
                {part && (
                  <header class="wwlf-part">
                    <p class="wwlf-part-tag">{part.tag}</p>
                    <h2 class="wwlf-part-title">{part.title}</h2>
                    <p class="wwlf-part-blurb">{part.blurb}</p>
                  </header>
                )}
                <FaultWalk walk={walk} />
              </>
            );
          })
        }
      </div>
    </div>

    <section class="wwlf-finale">
      <div class="shell">
        <header class="wwlf-part">
          <p class="wwlf-part-tag">The closer</p>
          <h2 class="wwlf-part-title">The last check is done by hand.</h2>
          <p class="wwlf-part-blurb">
            Not an errand — a test you perform yourself, on two invented shopfronts.
          </p>
        </header>
        <SwapTest theme={swap} />
      </div>
    </section>

    <section class="wwlf-purpose">
      <div class="shell">
        <p class="eyebrow">What this is for</p>
        <h2>This is the diagnostic, not a quiz.</h2>
        <p>
          These ten are step 5 of the studio's research method — the check run on every
          business's public surface before anything is redesigned. The method lives in the
          studio repo at <code>docs/RESEARCH_METHOD.md</code>; the themes and their scenes in
          <code>research/film/studio-recurring-themes.md</code>.
          {/* The public page should link the method doc once it has a public URL. */}
        </p>
        <p>
          Two things this page never does. It never turns the tally into a claim about websites
          in general — the counts count our own case-study notes, not the world. And it never
          grades you: the taps you rack up above are yours, on invented mocks, and nothing here
          scores your site.
        </p>
      </div>
    </section>

    <section class="wwlf-close">
      <div class="shell">
        <p class="eyebrow">Your turn</p>
        <h2>Send a link. Get the same walk done on your own site.</h2>
        <p>
          We record what stops a stranger, fix the worst of it as a free before-and-after, and
          show you both. No obligation.
        </p>
        <a class="button" href="/request/">Request a free before-and-after <ArrowIcon /></a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { mountFaultWalks } from "../../site/scripts/fault-walk";

  mountFaultWalks();
</script>
