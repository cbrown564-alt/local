---
import BaseLayout from "../../site/layouts/BaseLayout.astro";
import BrandMark from "../../site/components/BrandMark.astro";
import ArrowIcon from "../../site/components/ArrowIcon.astro";
import "../../site/styles/header-study.css";
---

<BaseLayout title="Header study — Mourne Made" description="A visual study of header directions for Mourne Made." hideFooter>
  <main class="header-study">
    <div class="shell header-study-intro">
      <a class="header-study-back" href="/prototypes/button-study/">← Button study</a>
      <p class="home-kicker">Mourne Made · component study</p>
      <h1>How should the site introduce itself?</h1>
      <p class="header-study-lede">Three header directions using the current logo, navigation and primary action. The rest of the page is intentionally quiet so the header can carry the decision.</p>
    </div>

    <div class="header-study-variants">
      <section class="header-variant header-variant--quiet" aria-label="Quiet header direction">
        <p class="header-variant-name"><span>A</span> Quiet navigation</p>
        <header class="study-header">
          <a class="study-brand" href="#"><BrandMark /></a>
          <nav><a href="#">Transformations</a><a href="#">Why local</a><a class="study-header-cta" href="#">Free before-and-after <ArrowIcon /></a></nav>
        </header>
        <p class="header-variant-note">The current structure, cleaned up: the action is blue, navigation stays light, and the logo gets the first word.</p>
      </section>

      <section class="header-variant header-variant--rule" aria-label="Rule header direction">
        <p class="header-variant-name"><span>B</span> Framed by a rule</p>
        <header class="study-header">
          <a class="study-brand" href="#"><BrandMark /></a>
          <nav><a href="#">Transformations</a><a href="#">Why local</a><a class="study-header-cta" href="#">Free before-and-after <ArrowIcon /></a></nav>
        </header>
        <p class="header-variant-note">A thin full-width rule gives the page a clear starting line and makes the header feel more deliberate without adding decoration.</p>
      </section>

      <section class="header-variant header-variant--blue" aria-label="Blue header direction">
        <p class="header-variant-name"><span>C</span> Blue opening band</p>
        <header class="study-header">
          <a class="study-brand" href="#"><BrandMark /></a>
          <nav><a href="#">Transformations</a><a href="#">Why local</a><a class="study-header-cta" href="#">Free before-and-after <ArrowIcon /></a></nav>
        </header>
        <p class="header-variant-note">A shallow blue band anchors the brand at the top of the page. The logo and links reverse out; the CTA becomes yellow.</p>
      </section>
    </div>
  </main>
</BaseLayout>
