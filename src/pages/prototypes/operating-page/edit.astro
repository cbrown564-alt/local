---
import OperatingPageShell from "../../../prototypes/operating-page/OperatingPageShell.astro";
---

<OperatingPageShell
  title="Private week editor"
  description="Prototype private editing link for the synthetic Salt & Stem weekly page."
  editor
>
  <section class="op-auth-gate" data-owner-gate aria-labelledby="owner-access-title">
    <div class="op-auth-mark" aria-hidden="true"><span>Salt</span><b>&amp;</b><span>Stem</span></div>
    <div class="op-auth-copy">
      <p>Private week link</p>
      <h1 id="owner-access-title">Open the page you keep true.</h1>
      <p>The intended boundary is a time-limited private link or passkey. This prototype uses one local button instead and is <strong>not production security</strong>.</p>
      <button type="button" data-enter-owner>Continue with prototype access <span aria-hidden="true">→</span></button>
      <small>No public page or unpublished draft is shown before access.</small>
    </div>
  </section>
  <div data-editor-host hidden></div>
</OperatingPageShell>

<script>
  import { initOperatingPageEditor } from "../../../prototypes/operating-page/editor-client";
  initOperatingPageEditor();
</script>
