---
import FutureShell from "../../../prototypes/futures/FutureShell.astro";

const stories = [
  { type: "The useful change", title: "A workshop enquiry that respects the workshop", image: "/media/concepts/mourne-cycles/mourne-cycles-workshop-after-1265.webp", colour: "blue" },
  { type: "Field note", title: "When the door is open but the page looks closed", image: "/media/place/businesses-main-street-dundrum.jpg", colour: "yellow" },
  { type: "The working week", title: "Before the farm van leaves the yard", image: "/media/concepts/castle-farm/castle-farm-after-1265.webp", colour: "green" },
];
---
<FutureShell title="Field publication" description="A complete print-and-street publication workstream for Mourne Made." current="publication" tone="print">
  <section class="pub-cover">
    <div class="pub-cover-name"><p>Mourne Made presents</p><h1 class="future-display">THE<br />USEFUL<br />PAGE</h1><p class="pub-issue">FIELD EDITION 01 · DUNDRUM TO NEWCASTLE · FREE</p></div>
    <div class="pub-cover-window"><img src="/media/place/businesses-main-street-dundrum.jpg" alt="Businesses along Main Street in Dundrum" width="2000" height="1250" /><p>One street.<br />Five questions.<br />No website scores.</p></div>
    <p class="pub-cover-intro">A small printed and digital publication about the moments local websites help—or get in the way.</p>
    <a class="pub-open" href="#issue">Open issue 01 ↓</a>
  </section>

  <section class="issue" id="issue">
    <header class="issue-header future-shell"><div><p>The Useful Page · 01</p><h2 class="future-display">One route through the town.</h2></div><p>Three substantial stories, five smaller observations and one removable transformation sheet. Every QR continues the printed story as a working interaction.</p></header>
    <div class="issue-ledger">
      {stories.map((story, index) => <article class={`ledger-story ledger-${story.colour}`}><div class="ledger-image"><img src={story.image} alt="" width="1265" height="710" loading="lazy" /></div><div class="ledger-copy"><span>{story.type}</span><strong class="future-display">{story.title}</strong><p>{index===0?"A repair request should carry the details a mechanic needs without pretending the diary is live.":index===1?"A visitor arriving from Google should not have to decode whether today’s information is still true.":"A farm’s site can follow the rhythm of packing and delivery instead of behaving like an endless supermarket shelf."}</p><button type="button" data-open-spread={index}>Read the spread →</button></div></article>)}
    </div>
  </section>

  <dialog class="spread-dialog" id="spread-dialog">
    <form method="dialog"><button aria-label="Close spread">×</button></form>
    <div class="spread-pages">
      <article class="spread-left"><p>THE USEFUL CHANGE</p><h2 class="future-display">The workshop cannot promise before it sees the bike.</h2><img src="/media/concepts/mourne-cycles/mourne-cycles-hero-video-source.png" alt="Generated trail scene for the Mourne Cycles concept" width="1672" height="941" /><small>Generated scene · concept study, not commissioned work</small></article>
      <article class="spread-right"><p class="spread-lede">So the page should gather what helps, then stop at the honest boundary.</p><ol><li><b>Name the problem.</b><span>Puncture, service, gears, brake—or not sure.</span></li><li><b>Offer a day.</b><span>A preference, clearly not a live slot.</span></li><li><b>Let the workshop confirm.</b><span>The mechanic keeps the final judgement.</span></li></ol><div class="spread-qr" aria-label="QR placeholder linking to the working interaction"></div><p class="spread-scan">SCAN TO TRY THE WORKSHOP ROUTE<br /><small>mourne-made.co.uk/p/01/workshop</small></p></article>
    </div>
  </dialog>

  <section class="formats">
    <div class="future-shell"><p class="future-label">One edition, four useful objects</p><h2 class="future-display">Made to travel differently.</h2></div>
    <div class="formats-table future-shell">
      <article><div class="format-object newspaper"><span>THE<br />USEFUL<br />PAGE</span></div><h3>Eight-page field edition</h3><p>Found at counters and read without a phone. The full argument.</p></article>
      <article><div class="format-object sheet"><span>BEFORE</span><b></b><span>AFTER</span></div><h3>Removable transformation</h3><p>One business-specific sheet, handed over privately unless publication is agreed.</p></article>
      <article><div class="format-object postcard"><span>OPEN?</span><i class="mini-qr"></i></div><h3>One-question postcard</h3><p>A small observation that opens one interactive scene—not the homepage.</p></article>
      <article><div class="format-object pocket"><span>KEEP THIS</span><b>Who keeps your hours current?</b></div><h3>Counter checklist</h3><p>A genuinely useful leave-behind with the studio’s name kept secondary.</p></article>
    </div>
  </section>

  <section class="route-section">
    <div class="route-heading future-shell"><div><p class="future-label">Distribution is editorial</p><h2 class="future-display">A route, not a mailshot.</h2></div><p>Edition 01 is designed for a single day on foot and by bike. Every stop has a reason to hold that particular piece.</p></div>
    <div class="route-map future-shell" id="route-map">
      <div class="route-track" aria-hidden="true"><i></i></div>
      <button type="button" style="--rx:9%;--ry:67%" data-stop="1" aria-pressed="true"><b>1</b><span>Dundrum counter</span></button>
      <button type="button" style="--rx:35%;--ry:48%" data-stop="2"><b>2</b><span>Village notice point</span></button>
      <button type="button" style="--rx:63%;--ry:37%" data-stop="3"><b>3</b><span>Newcastle workshop</span></button>
      <button type="button" style="--rx:87%;--ry:18%" data-stop="4"><b>4</b><span>Promenade counter</span></button>
      <div class="route-detail" aria-live="polite"><p>STOP <span>01</span></p><h3 class="future-display">A place where “are you open?” gets asked out loud.</h3><strong>Leave: 6 field editions + the opening-hours postcard</strong><small>Ask before leaving anything. Return after one week; do not count distribution as interest.</small></div>
    </div>
  </section>

  <section class="editorial-system future-shell">
    <div class="editorial-title"><p class="future-label">How it becomes repeatable</p><h2 class="future-display">The publication has an editorial engine.</h2><p>Each edition starts with a useful local question, not a need to fill pages.</p></div>
    <ol class="editorial-steps"><li><b>Listen</b><span>Collect repeated questions heard at counters, calls and public listings.</span></li><li><b>Verify</b><span>Separate published facts, observations and what only the owner can confirm.</span></li><li><b>Make one thing work</b><span>Build the interaction before writing the story around it.</span></li><li><b>Ask permission</b><span>Name a business publicly only when the relationship and evidence allow it.</span></li><li><b>Print small</b><span>Place deliberately, revisit, learn, then decide whether issue 02 exists.</span></li></ol>
  </section>

  <section class="issue-builder" id="issue-builder">
    <div class="builder-copy"><p class="future-label">Shape the next field edition</p><h2 class="future-display">What should issue 02 follow?</h2><p>Choose the question and the route changes with it. This is the planning object the workstream can build on.</p></div>
    <form class="builder-form"><label><input type="radio" name="issue" value="tonight" checked /> What is still open tonight?</label><label><input type="radio" name="issue" value="book" /> Why is booking still a phone call?</label><label><input type="radio" name="issue" value="week" /> What changes every week?</label></form>
    <div class="builder-output" aria-live="polite"><p>ISSUE 02 / NIGHT ROUTE</p><h3 class="future-display">After five, before closing.</h3><div><span>Lead story</span><b>How current hours become a promise</b></div><div><span>Working piece</span><b>Live “tonight” board using owner-held data</b></div><div><span>Route</span><b>Dundrum Main Street → Newcastle promenade</b></div><button type="button" onclick="window.print()">Print this working brief</button></div>
  </section>

  <section class="publication-decision future-shell"><p class="future-label">Decision</p><h2 class="future-display">This survives as a workstream.</h2><p>Start with one deliberately small edition. Build the workshop spread and its QR interaction first; extract the print system only after the physical proof works at A6 and A3. The next irreversible step is permission to feature and place—not more speculative content.</p></section>
</FutureShell>
<script>
  const dialog=document.getElementById("spread-dialog") as HTMLDialogElement;document.querySelectorAll("[data-open-spread]").forEach(button=>button.addEventListener("click",()=>dialog.showModal()));dialog?.addEventListener("click",event=>{if(event.target===dialog)dialog.close()});
  const stops:Record<string,string[]>={1:["01","A place where “are you open?” gets asked out loud.","Leave: 6 field editions + the opening-hours postcard","Ask before leaving anything. Return after one week; do not count distribution as interest."],2:["02","A shared pinboard where local plans are made.","Leave: 4 field editions + the one-question cards","Keep the piece useful without requiring a scan. Note which question people take."],3:["03","The business inside the lead story.","Bring: the private transformation sheet","Conversation first. Nothing public without permission; corrections return to the evidence record."],4:["04","A counter visited by people deciding what to do next.","Leave: 6 field editions + the evening route card","The QR opens the relevant interaction directly, never a generic sales page."]};const map=document.getElementById("route-map")!;map.querySelectorAll<HTMLButtonElement>("[data-stop]").forEach(button=>button.addEventListener("click",()=>{map.querySelectorAll("[data-stop]").forEach(b=>b.setAttribute("aria-pressed",String(b===button)));const item=stops[button.dataset.stop ?? "1"];map.querySelector<HTMLElement>(".route-detail p span")!.textContent=item[0];map.querySelector(".route-detail h3")!.textContent=item[1];map.querySelector(".route-detail strong")!.textContent=item[2];map.querySelector(".route-detail small")!.textContent=item[3]}));
  const issueOptions={tonight:["ISSUE 02 / NIGHT ROUTE","After five, before closing.","How current hours become a promise","Live “tonight” board using owner-held data","Dundrum Main Street → Newcastle promenade"],book:["ISSUE 02 / BOOKING ROUTE","The call before the booking.","Where specialist judgement belongs in a digital route","Three honest enquiry handoffs","Hotels → workshops → high-value services"],week:["ISSUE 02 / WEEKLY ROUTE","Before the week changes again.","The local businesses that work in weekly rhythms","An owner-editable weekly board","Farm round → menus → events"]};const builder=document.getElementById("issue-builder")!;builder.querySelectorAll<HTMLInputElement>("input").forEach(input=>input.addEventListener("change",()=>{const item=issueOptions[input.value as keyof typeof issueOptions];builder.querySelector<HTMLElement>(".builder-output>p")!.textContent=item[0];builder.querySelector(".builder-output h3")!.textContent=item[1];builder.querySelectorAll<HTMLElement>(".builder-output div b").forEach((el,i)=>el.textContent=item[i+2])}));
</script>
<style>
  .pub-cover{position:relative;min-height:calc(100svh - 82px);display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr auto;padding:clamp(1.3rem,4vw,3.5rem);color:var(--future-ink);background:#ef3f2f;overflow:hidden}.pub-cover-name{align-self:center;position:relative;z-index:2}.pub-cover-name>p{font-weight:750}.pub-cover h1{margin:.5rem 0;font-size:clamp(5.2rem,14vw,9rem);line-height:.72;letter-spacing:-.04em}.pub-issue{font-size:.72rem}.pub-cover-window{position:relative;align-self:center;height:min(68vh,650px);overflow:hidden;transform:rotate(2deg);border:12px solid var(--future-ink)}.pub-cover-window img{width:100%;height:100%;object-fit:cover;filter:contrast(1.05) saturate(.7)}.pub-cover-window p{position:absolute;left:0;bottom:0;margin:0;padding:1.1rem;color:white;background:var(--future-ink);font:680 clamp(1.8rem,4vw,3.5rem)/.9 Antonio,sans-serif}.pub-cover-intro{max-width:35rem;align-self:end;font-size:1.1rem}.pub-open{justify-self:end;align-self:end;padding:.8rem;color:var(--future-ink);background:var(--future-gorse);font-weight:760;text-decoration:none;border:2px solid var(--future-ink)}
  .issue{padding-block:clamp(5rem,9vw,8rem);background:#f3f0e7}.issue-header{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:end;margin-bottom:3rem}.issue-header h2{max-width:9ch;margin:.5rem 0 0;font-size:clamp(4rem,8vw,6rem);line-height:.86}.issue-header>p{font-size:1.08rem;line-height:1.6}.issue-ledger{width:min(1260px,calc(100% - 2.5rem));margin:auto}.ledger-story{min-height:450px;display:grid;grid-template-columns:1.1fr .9fr;margin-bottom:1.4rem;border:3px solid var(--future-ink)}.ledger-image{overflow:hidden}.ledger-image img{width:100%;height:100%;object-fit:cover}.ledger-copy{display:flex;flex-direction:column;align-items:flex-start;padding:clamp(1.5rem,4vw,3rem)}.ledger-yellow .ledger-copy{background:var(--future-gorse)}.ledger-blue .ledger-copy{color:white;background:var(--future-sea)}.ledger-green .ledger-copy{color:white;background:#315643}.ledger-copy>span{font-size:.76rem;font-weight:750;text-transform:uppercase}.ledger-copy strong{display:block;margin:1.3rem 0;font-size:clamp(2.5rem,5vw,4.5rem);line-height:.9}.ledger-copy p{max-width:36rem;line-height:1.55}.ledger-copy button{margin-top:auto;padding:.7rem 0;color:inherit;background:transparent;border:0;border-bottom:2px solid currentColor;font-weight:750}
  .spread-dialog{width:min(1100px,94vw);max-width:none;padding:0;border:0;background:transparent}.spread-dialog::backdrop{background:rgb(6 10 12 / 82%)}.spread-dialog>form{position:absolute;z-index:4;right:1rem;top:1rem}.spread-dialog>form button{width:44px;height:44px;background:var(--future-gorse);border:2px solid var(--future-ink);font-size:1.5rem}.spread-pages{display:grid;grid-template-columns:1fr 1fr;min-height:680px;background:#f3f0e7;box-shadow:0 8px 0 rgb(0 0 0 / 30%)}.spread-pages article{padding:clamp(2rem,5vw,4rem)}.spread-left{display:flex;flex-direction:column;background:#e34431}.spread-left h2{margin:1.2rem 0;font-size:clamp(3.2rem,6vw,5.2rem);line-height:.85}.spread-left img{width:100%;margin-top:auto}.spread-left small{margin-top:.5rem}.spread-right{display:flex;flex-direction:column}.spread-lede{font:680 2rem/1.05 Antonio,sans-serif}.spread-right ol{padding-left:1.2rem}.spread-right li{margin:1.3rem 0}.spread-right b,.spread-right span{display:block}.spread-qr,.mini-qr{background:conic-gradient(#132029 25%,transparent 0 50%,#132029 0 75%,transparent 0) 0/14px 14px}.spread-qr{width:90px;height:90px;margin-top:auto;border:8px solid white}.spread-scan{font-size:.72rem;font-weight:750}
  .formats{padding-block:clamp(5rem,9vw,8rem);background:var(--future-ink);color:white}.formats h2{margin:.5rem 0 3rem;font-size:clamp(4rem,8vw,6rem);line-height:.88}.formats-table{display:grid;grid-template-columns:repeat(4,1fr);gap:1.2rem}.formats-table article{display:flex;flex-direction:column}.format-object{height:270px;display:flex;position:relative;margin-bottom:1.2rem;color:var(--future-ink);background:#f1eee5;box-shadow:5px 5px 0 var(--future-gorse)}.newspaper{align-items:center;padding:1.2rem;font:680 3rem/.75 Antonio,sans-serif;background:#ef3f2f}.sheet{padding:1rem;flex-direction:column;justify-content:space-between}.sheet b{height:55%;background:url('/media/concepts/mourne-cycles/mourne-cycles-after-640.webp') center/cover}.sheet span{font-weight:750}.postcard{align-items:center;justify-content:space-around;background:var(--future-gorse);font:680 2.4rem Antonio,sans-serif}.mini-qr{width:65px;height:65px}.pocket{flex-direction:column;justify-content:space-between;padding:1.2rem;background:#b8d2dc}.pocket span{font-size:.7rem;font-weight:750}.pocket b{font:680 2rem/1 Antonio,sans-serif}.formats-table h3{margin:.7rem 0;font:680 1.6rem Antonio,sans-serif}.formats-table p{color:rgb(244 248 250 / 68%);font-size:.85rem}
  .route-section{padding-block:clamp(5rem,9vw,8rem);background:#bdd5df}.route-heading{display:grid;grid-template-columns:1fr 1fr;gap:4rem}.route-heading h2{margin:.5rem 0 3rem;font-size:clamp(4rem,8vw,6rem);line-height:.86}.route-heading>p{align-self:end;max-width:36rem;font-size:1.05rem}.route-map{position:relative;height:620px;background:url('/media/maps/town-coverage-generated.png') center/cover;border:4px solid var(--future-ink);overflow:hidden}.route-map::after{content:"Illustrative route study";position:absolute;right:0;bottom:0;padding:.5rem;color:white;background:var(--future-ink);font-size:.65rem}.route-track{position:absolute;left:10%;right:10%;top:26%;height:42%;border-top:5px dotted var(--future-ink);transform:rotate(-18deg)}.route-map>button{position:absolute;z-index:2;left:var(--rx);top:var(--ry);display:flex;align-items:center;gap:.5rem;padding:0;background:transparent;border:0}.route-map>button b{display:grid;place-items:center;width:40px;height:40px;color:white;background:var(--future-ink);border-radius:50%}.route-map>button span{display:none;padding:.45rem;background:var(--future-gorse);font-size:.72rem;font-weight:750}.route-map>button:hover span,.route-map>button:focus-visible span,.route-map>button[aria-pressed="true"] span{display:block}.route-map>button[aria-pressed="true"] b{color:var(--future-ink);background:var(--future-gorse)}.route-detail{position:absolute;z-index:3;left:3%;top:4%;width:min(380px,90%);padding:1.5rem;color:white;background:var(--future-sea)}.route-detail p{color:var(--future-gorse);font-weight:750}.route-detail h3{margin:.8rem 0;font-size:2.6rem;line-height:.9}.route-detail strong,.route-detail small{display:block}.route-detail small{margin-top:.8rem;color:rgb(255 255 255 / 68%)}
  .editorial-system{display:grid;grid-template-columns:1fr 1fr;gap:5rem;padding-block:clamp(5rem,10vw,9rem)}.editorial-title h2{margin:.6rem 0 1rem;font-size:clamp(3.7rem,7vw,5.8rem);line-height:.88}.editorial-title>p:last-child{max-width:36rem;font-size:1.05rem}.editorial-steps{list-style:none;padding:0;margin:0;border-top:3px solid var(--future-ink)}.editorial-steps li{display:grid;grid-template-columns:120px 1fr;gap:1rem;padding:1.25rem 0;border-bottom:1px solid rgb(19 32 41 / 30%)}.editorial-steps b{font:680 1.5rem Antonio,sans-serif}.editorial-steps span{line-height:1.45}
  .issue-builder{display:grid;grid-template-columns:.8fr .8fr 1.2fr;gap:3rem;padding:clamp(3rem,7vw,7rem) clamp(1.2rem,5vw,4.5rem);background:var(--future-gorse)}.builder-copy h2{margin:.6rem 0 1rem;font-size:clamp(3.5rem,6vw,5.2rem);line-height:.88}.builder-form{align-self:center}.builder-form label{display:block;padding:1rem 0;border-bottom:2px solid var(--future-ink);font-weight:750}.builder-form input{accent-color:var(--future-sea)}.builder-output{padding:2rem;color:white;background:var(--future-sea);box-shadow:8px 8px 0 var(--future-ink)}.builder-output>p{font-size:.72rem;color:var(--future-gorse);font-weight:750}.builder-output h3{font-size:3.2rem;line-height:.9}.builder-output div{display:grid;grid-template-columns:100px 1fr;gap:1rem;padding:.7rem 0;border-top:1px solid rgb(255 255 255 / 27%)}.builder-output div span{font-size:.72rem;color:rgb(255 255 255 / 64%)}.builder-output button{margin-top:1rem;padding:.8rem;background:var(--future-gorse);border:0;font-weight:750}.publication-decision{padding-block:clamp(5rem,10vw,9rem)}.publication-decision h2{margin:.5rem 0 1rem;font-size:clamp(4rem,8vw,6rem);line-height:.86}.publication-decision>p:last-child{max-width:60rem;font-size:1.12rem;line-height:1.6}
  @media(max-width:820px){.pub-cover,.issue-header,.route-heading,.editorial-system,.issue-builder{grid-template-columns:1fr}.pub-cover{min-height:900px}.pub-cover-window{height:440px}.pub-open{justify-self:start}.ledger-story{grid-template-columns:1fr}.ledger-image{min-height:280px}.formats-table{grid-template-columns:1fr 1fr}.spread-pages{grid-template-columns:1fr;max-height:85vh;overflow:auto}.route-map{height:720px}.route-detail{top:auto;bottom:3%}}
  @media(max-width:520px){.formats-table{grid-template-columns:1fr}.pub-cover h1{font-size:5.3rem}.route-map>button span{display:none!important}.route-map>button[aria-pressed="true"] span{display:block!important}.editorial-steps li{grid-template-columns:1fr}.builder-output h3{font-size:2.5rem}}
  @media print{.future-header,.future-footer,.pub-cover,.issue,.formats,.route-section,.editorial-system,.publication-decision{display:none!important}.issue-builder{display:block;background:white}.builder-copy,.builder-form{display:none}.builder-output{box-shadow:none;color:#132029;background:white;border:2px solid #132029}.builder-output button{display:none}}
</style>
