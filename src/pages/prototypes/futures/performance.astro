---
import FutureShell from "../../../prototypes/futures/FutureShell.astro";
---
<FutureShell title="Performance" description="An interactive transformation placed between recognition and the full case study." current="performance" tone="stage">
  <section class="performance-intro"><div><p class="future-label">It fits before the case study</p><h1 class="future-display">First, feel the cost.<br />Then see the change.</h1></div><div class="journey-line" aria-label="Visitor journey"><span>Transformation index</span><b>→</b><strong>20-second performance</strong><b>→</b><span>Working concept</span><b>→</b><span>Reasoning + request</span></div></section>
  <section class="stage" id="performance-stage" data-beat="0">
    <div class="stage-top"><p>Mourne Cycles · independent concept</p><p><span data-time>00:00</span> / 00:20</p></div>
    <div class="stage-screen">
      <img src="/media/concepts/mourne-cycles/mourne-cycles-before-1265.webp" alt="The current Mourne Cycles opening screen used in the transformation study" width="1265" height="710" />
      <div class="stage-obstacle"><p>Sunday ride. Soft brake.</p><strong>Can they look at it<br />before the weekend?</strong><span>Search · scan · scroll · call tomorrow</span></div>
      <div class="stage-sweep"></div>
      <div class="stage-after"><img src="/media/concepts/mourne-cycles/mourne-cycles-hero-video-source.png" alt="Generated trail-rider scene used in the proposed Mourne Cycles concept" width="1672" height="941" /><div><p>WORKSHOP / NEWCASTLE</p><h2 class="future-display">Back on the trail.</h2><button type="button">Choose the repair →</button><small>The workshop confirms every slot.</small></div></div>
      <div class="stage-choice"><p>The page has changed. What do you want to do?</p><a href="/concepts/mourne-cycles/workshop/">Use the workshop page</a><a href="/transformations/mourne-cycles/">See why it changed</a></div>
    </div>
    <div class="stage-controls"><button type="button" class="stage-play">Play the transformation</button><button type="button" class="stage-skip">Skip to the useful page</button><div class="stage-progress"><i></i></div><p data-caption>The visitor’s question arrives before the design.</p></div>
  </section>
  <section class="performance-role future-shell"><h2 class="future-display">It is a threshold, not a film reel.</h2><div><p><b>What it feels like</b>You recognise the frustrating moment, then the page physically reorganises around the answer.</p><p><b>What it achieves</b>The design decision becomes legible before the studio explains it. The visitor enters the working concept with a reason to care.</p><p><b>Where it does not go</b>Not on every page. Not autoplaying in the homepage hero. One optional threshold per flagship transformation.</p></div></section>
</FutureShell>
<script>
  const stage=document.getElementById("performance-stage")!;let timers:number[]=[];const captions=["The visitor’s question arrives before the design.","The current route makes them search for the next step.","The useful action moves into the opening screen.","The performance ends. The real page begins."];
  const setBeat=(beat:number,time:string)=>{stage.dataset.beat=String(beat);stage.querySelector<HTMLElement>("[data-time]")!.textContent=time;stage.querySelector<HTMLElement>("[data-caption]")!.textContent=captions[beat];(stage.querySelector(".stage-progress i") as HTMLElement).style.width=`${beat===0?0:beat===1?28:beat===2?68:100}%`};
  const play=()=>{timers.forEach(clearTimeout);setBeat(0,"00:00");timers=[window.setTimeout(()=>setBeat(1,"00:05"),900),window.setTimeout(()=>setBeat(2,"00:13"),3200),window.setTimeout(()=>setBeat(3,"00:20"),6100)]};
  stage.querySelector(".stage-play")?.addEventListener("click",play);stage.querySelector(".stage-skip")?.addEventListener("click",()=>{timers.forEach(clearTimeout);setBeat(3,"00:20")});
</script>
<style>
  .performance-intro{min-height:60vh;display:grid;grid-template-columns:1.2fr .8fr;align-items:end;gap:4rem;padding:clamp(5rem,10vw,9rem) clamp(1.2rem,5vw,4.5rem) 4rem;background:var(--future-gorse)}.performance-intro h1{max-width:12ch;margin:.6rem 0 0;font-size:clamp(4.3rem,9vw,6rem);line-height:.86}.journey-line{display:flex;align-items:center;flex-wrap:wrap;gap:.6rem;font-size:.78rem}.journey-line strong{padding:.7rem;color:white;background:var(--future-sea)}
  .stage{padding:clamp(1rem,3vw,2.5rem);color:white;background:#080b0d}.stage-top,.stage-controls{display:flex;justify-content:space-between;align-items:center;gap:1rem;width:min(1180px,100%);margin:auto}.stage-top p{font-size:.76rem;color:rgb(255 255 255 / 62%)}.stage-screen{position:relative;width:min(1180px,100%);aspect-ratio:16/8.6;margin:auto;overflow:hidden;background:#111}.stage-screen>img,.stage-after>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.stage-screen>img{filter:grayscale(1) brightness(.48)}.stage-obstacle{position:absolute;z-index:2;inset:0;display:flex;flex-direction:column;justify-content:center;padding:clamp(2rem,7vw,7rem);background:linear-gradient(90deg,rgba(0,0,0,.72),transparent)}.stage-obstacle p{color:var(--future-gorse);font-weight:750}.stage-obstacle strong{font:680 clamp(2.5rem,6vw,5.4rem)/.9 Antonio,sans-serif}.stage-obstacle span{margin-top:1.5rem;color:rgb(255 255 255 / 66%)}.stage-sweep{position:absolute;z-index:4;inset:0 auto 0 0;width:8px;background:var(--future-gorse);box-shadow:0 0 60px 20px rgba(224,193,77,.4);transform:translateX(-30px)}.stage-after{position:absolute;z-index:3;inset:0;clip-path:inset(0 100% 0 0)}.stage-after::after{content:"AI-generated scene";position:absolute;right:1rem;bottom:1rem;padding:.45rem;color:white;background:#111;font-size:.68rem}.stage-after>div{position:absolute;z-index:2;inset:0;display:flex;flex-direction:column;justify-content:end;align-items:flex-start;padding:clamp(2rem,6vw,5rem);background:linear-gradient(180deg,transparent 30%,rgba(7,11,10,.82))}.stage-after h2{margin:.3rem 0;font-size:clamp(3.2rem,7vw,6rem);line-height:.86}.stage-after button{padding:.8rem 1rem;background:var(--future-gorse);border:0;font-weight:750}.stage-after small{margin-top:.7rem}.stage-choice{position:absolute;z-index:5;right:clamp(1rem,4vw,4rem);top:50%;width:min(320px,calc(100% - 2rem));padding:1.5rem;color:var(--future-ink);background:var(--future-gorse);transform:translateY(-40%);opacity:0;pointer-events:none}.stage-choice a{display:block;margin-top:.6rem;padding:.8rem;color:white;background:var(--future-ink);text-decoration:none}.stage[data-beat="1"] .stage-obstacle{transform:translateX(-4%);filter:blur(1px);transition:2s}.stage[data-beat="2"] .stage-sweep{transform:translateX(calc(1180px - 20px));transition:2.7s cubic-bezier(.2,.8,.2,1)}.stage[data-beat="2"] .stage-after,.stage[data-beat="3"] .stage-after{clip-path:inset(0);transition:clip-path 2.7s cubic-bezier(.2,.8,.2,1)}.stage[data-beat="2"] .stage-obstacle,.stage[data-beat="3"] .stage-obstacle{opacity:0;transition:opacity .5s}.stage[data-beat="3"] .stage-choice{opacity:1;transform:translateY(-50%);pointer-events:auto;transition:.55s cubic-bezier(.2,.8,.2,1)}
  .stage-controls{display:grid;grid-template-columns:auto auto 1fr minmax(220px,320px);padding-block:1rem}.stage-controls button{padding:.65rem;color:white;background:transparent;border:1px solid rgb(255 255 255 / 36%)}.stage-play{color:var(--future-ink)!important;background:var(--future-gorse)!important;border-color:var(--future-gorse)!important;font-weight:750}.stage-progress{height:3px;background:rgb(255 255 255 / 18%)}.stage-progress i{display:block;width:0;height:100%;background:var(--future-gorse);transition:width .5s}.stage-controls p{font-size:.75rem;color:rgb(255 255 255 / 68%)}
  .performance-role{padding-block:clamp(5rem,10vw,9rem)}.performance-role h2{max-width:11ch;margin:0 0 3rem;font-size:clamp(3.5rem,7vw,5.8rem);line-height:.9}.performance-role>div{display:grid;grid-template-columns:repeat(3,1fr);gap:3rem;border-top:2px solid var(--future-ink);padding-top:1.5rem}.performance-role b{display:block;color:var(--future-sea);font-size:1.1rem;margin-bottom:.4rem}
  @media(max-width:800px){.performance-intro{grid-template-columns:1fr}.stage-screen{aspect-ratio:3/4}.stage-controls{grid-template-columns:1fr 1fr}.stage-controls p,.stage-progress{grid-column:1/-1}.performance-role>div{grid-template-columns:1fr}.stage-choice{left:1rem;right:1rem;width:auto}.stage-after h2{font-size:3.2rem}}
</style>
