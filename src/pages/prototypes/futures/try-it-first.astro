---
import FutureShell from "../../../prototypes/futures/FutureShell.astro";
---
<FutureShell title="Try it first" description="A working, evidence-bounded before-and-after starter." current="try" tone="tool">
  <section class="try-intro future-shell"><div><p class="future-label">The free before-and-after starts here</p><h1 class="future-display">Give us a name.<br />Get one useful move.</h1></div><p>This does not promise an instant redesign. It proves the intake can give something concrete back immediately, while showing exactly what still needs a human check.</p></section>
  <section class="try-workbench" id="try-workbench">
    <form class="lookup" novalidate>
      <label for="business">Try a researched example</label>
      <div class="lookup-line"><select id="business"><option value="cycles">Mourne Cycles</option><option value="farm">Castle Farm</option><option value="hotel">Enniskeen Hotel</option></select><button type="submit">Find the useful move →</button></div>
      <p>Prototype uses existing project evidence. A real submission would pause when evidence is thin.</p>
    </form>
    <div class="researching" hidden aria-live="polite"><i></i><p><b>Checking the public route…</b><span data-check>Finding the first visitor task</span></p></div>
    <section class="try-result" hidden aria-live="polite">
      <header><div><p class="future-label result-type"></p><h2 class="future-display result-name"></h2></div><span class="confidence">Based on public evidence</span></header>
      <div class="result-grid">
        <article class="current-route"><p>What a visitor meets</p><div class="route-screen"><span class="route-url"></span><strong class="route-current"></strong><small class="route-friction"></small></div></article>
        <article class="first-move"><p>The first useful move</p><div class="route-screen"><span>Proposed opening action</span><strong class="route-move"></strong><button type="button" class="demo-action">Try the interaction →</button></div></article>
      </div>
      <div class="proof-strip"><p><b>Fact used</b><span class="fact-used"></span></p><p><b>Not assumed</b><span class="not-assumed"></span></p><button type="button" class="correct">Something here is wrong</button></div>
      <div class="correction" hidden><label for="correction-note">Correct the public record before design starts</label><textarea id="correction-note" rows="3" placeholder="For example: workshop bookings now use a different number…"></textarea><div><button type="button" class="save-correction">Save correction locally</button><span aria-live="polite"></span></div></div>
      <div class="next-step"><div><b>What happens next</b><p>A person verifies the correction, checks the business’s voice and makes the full before-and-after. Nothing publishes automatically.</p></div><a class="future-button result-link" href="#">See the developed concept →</a></div>
    </section>
  </section>
  <section class="try-boundary future-shell"><h2 class="future-display">The realistic version is small on purpose.</h2><p>Automation finds a plausible starting task and assembles the evidence already held. The value is not “AI redesigned your business.” The value is that the first conversation begins with a visible, correctable move instead of a blank brief.</p></section>
</FutureShell>
<script>
  const examples={cycles:{type:"Specialist retail + workshop",name:"Mourne Cycles",url:"mournecycles.co.uk",current:"Browse bikes, workshop and hire through a general opening page.",friction:"A repair enquiry still begins as an unstructured call or email.",move:"Choose the repair. Offer a day. Let the shop confirm.",fact:"The public route lists workshop services and direct contact details.",assume:"No live availability, stock, price or guaranteed slot.",href:"/concepts/mourne-cycles/workshop/"},farm:{type:"Farm shop + delivery round",name:"Castle Farm",url:"public social listings",current:"Discover produce through changing social posts.",friction:"The weekly rhythm is hard to understand at a glance.",move:"See this week’s table and follow the delivery round.",fact:"Published products, trading evidence and the verified weekly pattern.",assume:"No invented stock level, delivery promise or price.",href:"/concepts/castle-farm/"},hotel:{type:"Independent hotel",name:"Enniskeen Hotel",url:"enniskeenhotel.co.uk",current:"Read the hotel story, then find the external booking route.",friction:"The first stay question is separated from the setting that creates desire.",move:"Choose arrival and nights inside the estate story.",fact:"The booking engine accepts arrival date and length of stay.",assume:"No room count, live rate or availability is copied.",href:"/concepts/hotel-enniskeen/"}};
  const workbench=document.getElementById("try-workbench")!;const form=workbench.querySelector("form")!;const result=workbench.querySelector<HTMLElement>(".try-result")!;const searching=workbench.querySelector<HTMLElement>(".researching")!;
  form.addEventListener("submit",event=>{event.preventDefault();result.hidden=true;searching.hidden=false;const key=(form.querySelector("select") as HTMLSelectElement).value as keyof typeof examples;const item=examples[key];const check=searching.querySelector<HTMLElement>("[data-check]")!;check.textContent="Finding the first visitor task";setTimeout(()=>check.textContent="Separating evidence from assumptions",500);setTimeout(()=>{searching.hidden=true;result.hidden=false;const put=(selector:string,value:string)=>{result.querySelector<HTMLElement>(selector)!.textContent=value};put(".result-type",item.type);put(".result-name",item.name);put(".route-url",item.url);put(".route-current",item.current);put(".route-friction",item.friction);put(".route-move",item.move);put(".fact-used",item.fact);put(".not-assumed",item.assume);result.querySelector<HTMLAnchorElement>(".result-link")!.href=item.href;result.scrollIntoView({behavior:"smooth",block:"start"})},1050)});
  result.querySelector(".correct")?.addEventListener("click",()=>{const correction=result.querySelector<HTMLElement>(".correction")!;correction.hidden=!correction.hidden;if(!correction.hidden)correction.querySelector("textarea")?.focus()});
  result.querySelector(".save-correction")?.addEventListener("click",()=>{result.querySelector<HTMLElement>(".correction span")!.textContent="Correction held for the review."});
  result.querySelector(".demo-action")?.addEventListener("click",event=>{(event.currentTarget as HTMLButtonElement).textContent="Interaction belongs in the full concept ↓"});
</script>
<style>
  .try-intro{min-height:55vh;display:grid;grid-template-columns:1.3fr .7fr;align-items:end;gap:4rem;padding-block:clamp(5rem,10vw,9rem) 3rem}.try-intro h1{max-width:10ch;margin:.6rem 0 0;font-size:clamp(4rem,9vw,6rem);line-height:.88}.try-intro>p{max-width:34rem;font-size:1.08rem;line-height:1.6}
  .try-workbench{padding:clamp(2rem,6vw,5rem);background:var(--future-mist)}.lookup{width:min(900px,100%);margin:auto}.lookup>label{display:block;font:680 clamp(2rem,4vw,3.4rem) Antonio,sans-serif;margin-bottom:1rem}.lookup-line{display:flex}.lookup select{flex:1;min-width:0;padding:1rem;background:white;border:2px solid var(--future-ink);font-size:1.05rem}.lookup-line button,.correction button{padding:1rem 1.2rem;color:var(--future-foam);background:var(--future-sea);border:2px solid var(--future-ink);font-weight:750}.lookup>p{font-size:.78rem;color:var(--future-deep)}
  .researching{width:min(900px,100%);min-height:230px;margin:2rem auto 0;display:flex;align-items:center;justify-content:center;gap:1.5rem;background:var(--future-ink);color:white}.researching[hidden]{display:none}.researching i{width:52px;height:52px;border:6px solid rgb(244 248 250 / 24%);border-top-color:var(--future-gorse);border-radius:50%;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.researching p{display:flex;flex-direction:column;gap:.35rem}.researching span{color:rgb(244 248 250 / 65%)}
  .try-result{width:min(1120px,100%);margin:3rem auto 0;background:var(--future-foam);border:3px solid var(--future-ink)}.try-result>header{display:flex;justify-content:space-between;align-items:start;gap:2rem;padding:2rem;border-bottom:2px solid var(--future-ink)}.try-result h2{margin:.2rem 0 0;font-size:clamp(3rem,6vw,5rem);line-height:.9}.confidence{padding:.5rem .75rem;background:var(--future-gorse);font-size:.76rem;font-weight:700}.result-grid{display:grid;grid-template-columns:1fr 1fr}.result-grid article{padding:2rem}.result-grid article+article{border-left:2px solid var(--future-ink)}.result-grid article>p{font-weight:750}.route-screen{min-height:280px;padding:1.4rem;background:#d6dde0;border-top:34px solid var(--future-ink)}.first-move .route-screen{color:white;background:var(--future-sea)}.route-screen span,.route-screen small{display:block}.route-screen strong{display:block;margin:2.5rem 0 1rem;font:680 clamp(2rem,4vw,3.3rem)/.95 Antonio,sans-serif}.route-screen small{font-size:.88rem;line-height:1.45}.demo-action{margin-top:1.5rem;padding:.7rem;background:var(--future-gorse);border:0;font-weight:750}.proof-strip{display:grid;grid-template-columns:1fr 1fr auto;gap:2rem;padding:1.5rem 2rem;background:var(--future-ink);color:white}.proof-strip p{margin:0}.proof-strip b,.proof-strip span{display:block}.proof-strip b{color:var(--future-gorse);font-size:.78rem}.proof-strip span{margin-top:.4rem;font-size:.83rem;color:rgb(244 248 250 / 76%)}.correct{align-self:center;color:var(--future-gorse);background:transparent;border:0;text-decoration:underline}.correction{padding:2rem;background:#fff}.correction label{display:block;font-weight:750}.correction textarea{width:100%;margin:.8rem 0;padding:.8rem;border:2px solid var(--future-ink)}.correction div{display:flex;align-items:center;gap:1rem}.next-step{display:flex;justify-content:space-between;align-items:center;gap:3rem;padding:2rem}.next-step p{max-width:55ch;margin:.3rem 0 0}.try-boundary{display:grid;grid-template-columns:1fr 1fr;gap:4rem;padding-block:clamp(5rem,10vw,9rem)}.try-boundary h2{margin:0;font-size:clamp(3rem,6vw,5rem);line-height:.9}.try-boundary p{font-size:1.08rem;line-height:1.6}
  @media(max-width:760px){.try-intro,.try-boundary{grid-template-columns:1fr;gap:1.5rem}.lookup-line{flex-direction:column}.lookup-line button{min-height:54px}.result-grid{grid-template-columns:1fr}.result-grid article+article{border-left:0;border-top:2px solid var(--future-ink)}.proof-strip{grid-template-columns:1fr}.try-result>header,.next-step{align-items:flex-start;flex-direction:column}.confidence{order:-1}}
</style>
