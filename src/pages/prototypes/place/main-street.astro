---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArrowIcon from "../../../components/ArrowIcon.astro";
import "../../../styles/place-prototypes.css";
---

<BaseLayout
  title="Prototype B · Main Street — Mourne Made"
  description="Place-based homepage prototype using Dundrum Main Street shopfronts."
  robots="noindex, nofollow"
  class="place-proto place-proto-street"
>
  <nav class="place-proto-nav" aria-label="Place prototypes">
    <a href="/prototypes/place/">Index</a>
    <a href="/prototypes/place/bay/">A · Bay</a>
    <a href="/prototypes/place/main-street/" aria-current="page">B · Street</a>
    <a href="/prototypes/place/harbour/">C · Harbour</a>
  </nav>

  <section class="place-hero place-hero--street" aria-label="Main Street homepage concept">
    <div class="place-hero-media">
      <img
        src="/images/place/businesses-main-street-dundrum.jpg"
        alt="Shopfronts on Main Street, Dundrum, including Blue Bay Cafe and Hair Design"
        width="1920"
        height="1230"
      />
    </div>
    <div class="place-hero-scrim" aria-hidden="true"></div>
    <div class="place-hero-content">
      <div class="place-street-fascia">
        <div class="place-street-fascia-inner">
          <p class="place-kicker">Made by the mountain, for the street</p>
          <p class="place-brand" aria-label="Mourne Made">
            <span>Mourne</span><span>Made</span>
          </p>
          <h1>See what your business could become online.</h1>
          <p class="lede">Painted fascias, clear offers, easy next steps — the same standards we want for every local website.</p>
          <div class="button-row">
            <a class="place-btn" href="/request/">Request a free before-and-after <ArrowIcon /></a>
            <a class="place-link" href="/transformations/">Browse local transformations <ArrowIcon /></a>
          </div>
          <p class="place-proto-credit">Photo: Main Street, Dundrum · Wikimedia Commons / Geograph</p>
        </div>
      </div>
    </div>
  </section>

  <section class="place-street-rail">
    <div class="place-street-rail-copy">
      <h2>Read like a shopfront, not a SaaS landing page.</h2>
      <p>The brand sits in a fascia band over real street photography — navy paint, signal yellow trim, asphalt below — so “Main” is visible, not just named.</p>
    </div>
    <img
      src="/images/place/main-street-1.jpg"
      alt="Looking along Main Street, Dundrum under an overcast sky"
      width="2000"
      height="1500"
    />
  </section>
</BaseLayout>
