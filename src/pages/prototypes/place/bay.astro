---
import BaseLayout from "../../../site/layouts/BaseLayout.astro";
import ArrowIcon from "../../../site/components/ArrowIcon.astro";
import "../../../site/styles/place-prototypes.css";
---

<BaseLayout
  title="Prototype A · Bay & Mournes — Mourne Made"
  description="Place-based homepage prototype using the Newcastle shore and Mourne Mountains."
  robots="noindex, nofollow"
  class="place-proto place-proto-bay"
>
  <nav class="place-proto-nav" aria-label="Place prototypes">
    <a href="/prototypes/place/">Index</a>
    <a href="/prototypes/place/bay/" aria-current="page">A · Bay</a>
    <a href="/prototypes/place/main-street/">B · Street</a>
    <a href="/prototypes/place/harbour/">C · Harbour</a>
  </nav>

  <section class="place-hero place-hero--bay" aria-label="Bay and Mournes homepage concept">
    <div class="place-hero-media">
      <img
        src="/media/place/mournes-newcastle.jpg"
        alt="Low tide on Newcastle beach with the town and Mourne Mountains beyond"
        width="2000"
        height="1250"
      />
    </div>
    <div class="place-hero-scrim" aria-hidden="true"></div>
    <div class="place-hero-content">
      <p class="place-kicker">Dundrum + Newcastle, County Down</p>
      <p class="place-brand" aria-label="Mourne Made">
        <span>Mourne</span><span>Made</span>
      </p>
      <h1>See what your business could become online.</h1>
      <p class="lede">A local studio that starts with the shore and the street — then shows a clearer website before you spend a penny.</p>
      <div class="button-row">
        <a class="place-btn" href="/request/">Request a free before-and-after <ArrowIcon /></a>
        <a class="place-link" href="/transformations/">Browse local transformations <ArrowIcon /></a>
      </div>
      <p class="place-proto-credit">Photo: Newcastle beach and the Mournes · Unsplash</p>
    </div>
  </section>

  <section class="place-bay-strip">
    <img
      src="/media/place/houses.jpg"
      alt="Houses on South Promenade, Newcastle"
      width="2000"
      height="1333"
    />
    <div class="place-bay-strip-copy">
      <h2>Colour from the bay, not from a template.</h2>
      <p>Sea slate, cool mist and gorse yellow replace cobalt and pale lavender — so the first screen already feels like this coast.</p>
    </div>
  </section>
</BaseLayout>
