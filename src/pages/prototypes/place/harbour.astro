---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArrowIcon from "../../../components/ArrowIcon.astro";
import "../../../styles/place-prototypes.css";
---

<BaseLayout
  title="Prototype C · Harbour Quay — Mourne & Main"
  description="Place-based homepage prototype using Newcastle harbour and promenade."
  robots="noindex, nofollow"
  class="place-proto place-proto-harbour"
>
  <nav class="place-proto-nav" aria-label="Place prototypes">
    <a href="/prototypes/place/">Index</a>
    <a href="/prototypes/place/bay/">A · Bay</a>
    <a href="/prototypes/place/main-street/">B · Street</a>
    <a href="/prototypes/place/harbour/" aria-current="page">C · Harbour</a>
  </nav>

  <section class="place-hero place-hero--harbour" aria-label="Harbour quay homepage concept">
    <div class="place-hero-media">
      <img
        src="/images/place/boats-moored-at-newcastle-harbour.jpg"
        alt="Boats resting on the silt at Newcastle harbour at low tide, including a bright yellow hull"
        width="988"
        height="1024"
      />
    </div>
    <div class="place-hero-scrim" aria-hidden="true"></div>
    <div class="place-hero-content">
      <p class="place-kicker">Working harbour · open promenade</p>
      <p class="place-brand" aria-label="Mourne and Main">
        <span>Mourne</span><span>&amp;</span><span>Main</span>
      </p>
      <h1>See what your business could become online.</h1>
      <p class="lede">Practical colour from the quay — boat yellow, water blue, weathered stone — for a studio that works where people already trade.</p>
      <div class="button-row">
        <a class="place-btn" href="/request/">Request a free before-and-after <ArrowIcon /></a>
        <a class="place-link" href="/transformations/">Browse local transformations <ArrowIcon /></a>
      </div>
      <p class="place-proto-credit">Photo: Newcastle harbour · Wikimedia Commons / Geograph</p>
    </div>
  </section>

  <section class="place-bay-strip place-harbour-strip">
    <img
      src="/images/place/central-promenade.jpg"
      alt="Central Promenade in Newcastle with the Mournes under cloud"
      width="1024"
      height="765"
    />
    <div class="place-bay-strip-copy">
      <h2>A quieter local palette.</h2>
      <p>Boat yellow and water blue replace cobalt and pale lavender — still bright enough for CTAs, but recognisably coastal County Down.</p>
      <div class="place-harbour-swatches" aria-label="Harbour palette">
        <span style="background:#efc93a" title="Boat yellow"></span>
        <span style="background:#3f647c" title="Water blue"></span>
        <span style="background:#7d776c" title="Quay stone"></span>
        <span style="background:#34312d" title="Silt"></span>
        <span style="background:#edf1f4" title="Foam"></span>
      </div>
    </div>
  </section>
</BaseLayout>
