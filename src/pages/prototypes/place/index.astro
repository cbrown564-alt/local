---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArrowIcon from "../../../components/ArrowIcon.astro";
import "../../../styles/place-prototypes.css";

const variants = [
  {
    href: "/prototypes/place/bay/",
    title: "A · Bay & Mournes",
    desc: "Full-bleed beach-to-mountain atmosphere. Cool mist, sea slate and gorse yellow drawn from the Newcastle shore.",
    image: "/images/place/mournes-newcastle.jpg",
    alt: "Newcastle beach at low tide with the Mourne Mountains behind the town",
  },
  {
    href: "/prototypes/place/main-street/",
    title: "B · Main Street",
    desc: "Shopfront fascia treatment over Dundrum’s Main Street. Painted navy, asphalt and a signal yellow bar like a hanging sign.",
    image: "/images/place/businesses-main-street-dundrum.jpg",
    alt: "Shopfronts on Main Street, Dundrum including Blue Bay Cafe",
  },
  {
    href: "/prototypes/place/harbour/",
    title: "C · Harbour Quay",
    desc: "Low-tide harbour intimacy with the promenade below. Boat yellow, quay stone and water blue instead of studio cobalt.",
    image: "/images/place/boats-moored-at-newcastle-harbour.jpg",
    alt: "Boats moored at Newcastle harbour at low tide",
  },
];
---

<BaseLayout
  title="Place visual language prototypes — Mourne & Main"
  description="Three place-based homepage atmosphere directions for Dundrum and Newcastle."
  robots="noindex, nofollow"
  class="place-proto"
>
  <section class="place-index">
    <div class="shell">
      <p class="eyebrow">Internal prototype</p>
      <h1>Place-based visual language</h1>
      <p class="lede">Three homepage atmospheres rooted in Dundrum and Newcastle — bay, main street and harbour — instead of abstract studio chrome.</p>
      <div class="place-index-grid">
        {variants.map((variant) => (
          <a class="place-index-card" href={variant.href}>
            <img src={variant.image} alt={variant.alt} width="960" height="600" />
            <div class="place-index-card-body">
              <h2>{variant.title}</h2>
              <p>{variant.desc}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="place-index-meta">
        <p>Prototype photos: Unsplash (Mournes from Newcastle beach) and Wikimedia Commons / Geograph (Dundrum Main Street, Newcastle harbour and promenade). For internal design review only.</p>
        <p><a class="text-link" href="/">Back to live homepage <ArrowIcon /></a></p>
      </div>
    </div>
  </section>
</BaseLayout>
