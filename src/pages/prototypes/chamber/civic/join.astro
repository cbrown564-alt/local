---
import CivicShell from "../../../../prototypes/chamber-prototypes/CivicShell.astro";
import { chamber, joinBenefits } from "../../../../site/data/chamber-prototype";
---
<CivicShell title="Join — Newcastle Chamber · Civic concept" current="join">
  <div class="cv-page cv-shell">
    <p class="cv-kicker">Membership</p>
    <h1>Join the chamber on <em>Main Street.</em></h1>
    <p class="cv-lede">
      No online payment theatre for a volunteer committee — write to the inbox the Chamber already answers,
      and they'll take it from there.
    </p>
    <div class="cv-benefits">
      {joinBenefits.map((b) => (
        <article class="cv-benefit">
          <h3>{b.title}</h3>
          <p>{b.body}</p>
        </article>
      ))}
    </div>
    <a class="cv-cta" href={chamber.emailHref}>Email {chamber.email}</a>
    <p style="margin-top: 16px; font-size: 14px; color: #5a6e7e;">
      Or call <a class="cv-link" href={chamber.phoneHref}>{chamber.phone}</a> · {chamber.address}
    </p>
  </div>
</CivicShell>
