---
import CivicShell from "../../../../prototypes/chamber-prototypes/CivicShell.astro";
import { aboutParagraphs, chamber } from "../../../../site/data/chamber-prototype";
const base = "/prototypes/chamber/civic";
---
<CivicShell title="About — Newcastle Chamber · Civic concept" current="about">
  <div class="cv-page cv-shell">
    <p class="cv-kicker">About the chamber</p>
    <h1>A volunteer hub for <em>Newcastle, Co. Down.</em></h1>
    <p class="cv-lede">Reformed in {chamber.relaunchYear}. Still answering from the same Gmail and socials the committee already runs.</p>
    <div class="cv-prose">
      {aboutParagraphs.map((p) => <p>{p}</p>)}
    </div>
    <p style="margin-top: 28px">
      <a class="cv-cta" href={`${base}/join/`}>Join the chamber</a>
      &nbsp;&nbsp;
      <a class="cv-link" href={`${base}/contact/`}>Contact details →</a>
    </p>
  </div>
</CivicShell>
