---
import CivicShell from "../../../../components/chamber-prototypes/CivicShell.astro";
import { chamber } from "../../../../data/chamber-prototype";
const base = "/prototypes/chamber/civic";
---
<CivicShell title="Contact — Newcastle Chamber · Civic concept" current="contact">
  <div class="cv-page cv-shell">
    <p class="cv-kicker">Find us</p>
    <h1>Write to the <em>committee.</em></h1>
    <p class="cv-lede">Volunteer-run since the {chamber.relaunchYear} relaunch. Same inbox, same socials — now with a standing front door.</p>
    <div class="cv-contact-grid">
      <div class="cv-contact-block">
        <h2>Inbox &amp; phone</h2>
        <p><a href={chamber.emailHref}>{chamber.email}</a></p>
        <p><a href={chamber.phoneHref}>{chamber.phone}</a></p>
        <p style="margin-top: 16px"><a class="cv-cta" href={chamber.emailHref}>Send an email</a></p>
      </div>
      <div class="cv-contact-block">
        <h2>On Main Street</h2>
        <p>{chamber.address}</p>
        <p style="margin-top: 12px">
          <a href={chamber.facebook}>Facebook</a> ·
          <a href={chamber.instagram}>Instagram</a> ·
          <a href={chamber.linkedin}>LinkedIn</a>
        </p>
        <p style="margin-top: 16px"><a class="cv-link" href={`${base}/join/`}>Prefer to join? Start here →</a></p>
      </div>
    </div>
  </div>
</CivicShell>
