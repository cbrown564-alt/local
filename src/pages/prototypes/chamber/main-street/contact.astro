---
import MainStreetShell from "../../../../prototypes/chamber-prototypes/MainStreetShell.astro";
import { chamber } from "../../../../site/data/chamber-prototype";
const base = "/prototypes/chamber/main-street";
---
<MainStreetShell title="Contact — Newcastle Chamber · Main Street concept" current="contact">
  <div class="ms-page">
    <p class="ms-kicker">Contact</p>
    <h1>Talk to the chamber</h1>
    <p class="ms-lede">Same Gmail and phone the committee already uses — now easy to find.</p>
    <div class="ms-contact">
      <div class="ms-contact-panel">
        <h2>Write or call</h2>
        <p><a href={chamber.emailHref}>{chamber.email}</a></p>
        <p><a href={chamber.phoneHref}>{chamber.phone}</a></p>
        <p style="margin-top: 16px"><a class="ms-cta" href={chamber.emailHref}>Send an email</a></p>
      </div>
      <div class="ms-contact-panel">
        <h2>Visit</h2>
        <p>{chamber.address}</p>
        <p style="margin-top: 12px">
          <a href={chamber.facebook}>Facebook</a> ·
          <a href={chamber.instagram}>Instagram</a>
        </p>
        <p style="margin-top: 16px"><a class="ms-link" href={`${base}/join/`}>List your business →</a></p>
      </div>
    </div>
  </div>
</MainStreetShell>
