---
import MainStreetShell from "../../../../components/chamber-prototypes/MainStreetShell.astro";
import { aboutParagraphs } from "../../../../data/chamber-prototype";
const base = "/prototypes/chamber/main-street";
---
<MainStreetShell title="About — Newcastle Chamber · Main Street concept" current="about">
  <div class="ms-page">
    <p class="ms-kicker">About</p>
    <h1>The chamber behind the shop window</h1>
    <p class="ms-lede">Volunteer-run hub for Main Street traders under the Mournes.</p>
    <div class="ms-prose">
      {aboutParagraphs.map((p) => <p>{p}</p>)}
    </div>
    <p style="margin-top: 24px">
      <a class="ms-cta" href={`${base}/members/`}>See the directory</a>
      &nbsp;&nbsp;
      <a class="ms-link" href={`${base}/contact/`}>Contact →</a>
    </p>
  </div>
</MainStreetShell>
