---
import MainStreetShell from "../../../../prototypes/chamber-prototypes/MainStreetShell.astro";
import { chamber, joinBenefits } from "../../../../site/data/chamber-prototype";
---
<MainStreetShell title="Join — Newcastle Chamber · Main Street concept" current="join">
  <div class="ms-page">
    <p class="ms-kicker">Membership</p>
    <h1>Get listed. Get found.</h1>
    <p class="ms-lede">
      The directory is the product. Join so visitors looking for a café, chemist or guest house
      in Newcastle, Co. Down land on you.
    </p>
    <div class="ms-benefits">
      {joinBenefits.map((b) => (
        <article class="ms-benefit">
          <h3>{b.title}</h3>
          <p>{b.body}</p>
        </article>
      ))}
    </div>
    <a class="ms-cta ms-cta--amber" href={chamber.emailHref}>Email to join</a>
    <p style="margin-top: 14px; color: var(--muted); font-size: 14px">
      {chamber.email} · <a class="ms-link" href={chamber.phoneHref}>{chamber.phone}</a>
    </p>
  </div>
</MainStreetShell>
