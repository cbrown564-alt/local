---
import MainStreetShell from "../../../../prototypes/chamber-prototypes/MainStreetShell.astro";
import { events } from "../../../../site/data/chamber-prototype";
---
<MainStreetShell title="What's on — Newcastle Chamber · Main Street concept" current="events">
  <div class="ms-page">
    <p class="ms-kicker">Town calendar</p>
    <h1>What's on</h1>
    <p class="ms-lede">
      Nights the Chamber helps put on — and a sketch of how a fuller calendar could grow without locking dates the committee hasn't set.
    </p>
    <div class="ms-event-stack">
      {events.map((event) => (
        <article class="ms-event">
          <div>
            <time>{event.date}</time>
            <h2>{event.title}</h2>
            <p>{event.blurb}</p>
            <p style="margin-top: 8px; font-size: 13px">{event.place} · {event.real ? "Verified" : "Illustrative"}</p>
          </div>
          <a class="ms-cta" href={event.ctaHref}>{event.ctaLabel}</a>
        </article>
      ))}
    </div>
  </div>
</MainStreetShell>
