---
import NetworkShell from "../../../../components/chamber-prototypes/NetworkShell.astro";
import { aboutParagraphs, chamber } from "../../../../data/chamber-prototype";
const base = "/prototypes/chamber/network";
---
<NetworkShell title="About — Newcastle Chamber · Network concept" current="about">
  <div class="nw-page">
    <p class="nw-kicker">About</p>
    <h1>A network, not a <em>noticeboard.</em></h1>
    <p class="nw-lede">Volunteer-run since {chamber.relaunchYear} — for traders under the Mournes.</p>
    <div class="nw-prose">
      {aboutParagraphs.map((p) => <p>{p}</p>)}
    </div>
    <p style="margin-top: 24px">
      <a class="nw-cta" href={`${base}/join/`}>Join your neighbours</a>
      &nbsp;&nbsp;
      <a class="nw-link" href={`${base}/contact/`}>Contact →</a>
    </p>
  </div>
</NetworkShell>
