---
import NetworkShell from "../../../../prototypes/chamber-prototypes/NetworkShell.astro";
import { chamber } from "../../../../site/data/chamber-prototype";
const base = "/prototypes/chamber/network";
---
<NetworkShell title="Contact — Newcastle Chamber · Network concept" current="contact">
  <div class="nw-page">
    <p class="nw-kicker">Contact</p>
    <h1>Say hello</h1>
    <p class="nw-lede">The committee still answers the same channels — this page just makes them easy to find.</p>
    <div class="nw-contact">
      <div class="nw-contact-card">
        <h2>Email &amp; phone</h2>
        <p><a href={chamber.emailHref}>{chamber.email}</a></p>
        <p><a href={chamber.phoneHref}>{chamber.phone}</a></p>
        <p style="margin-top: 16px"><a class="nw-cta nw-cta--coral" href={chamber.emailHref}>Send a note</a></p>
      </div>
      <div class="nw-contact-card">
        <h2>On the street</h2>
        <p>{chamber.address}</p>
        <p style="margin-top: 12px">
          <a href={chamber.facebook}>Facebook</a> ·
          <a href={chamber.instagram}>Instagram</a> ·
          <a href={chamber.linkedin}>LinkedIn</a>
        </p>
        <p style="margin-top: 16px"><a class="nw-link" href={`${base}/join/`}>Why join →</a></p>
      </div>
    </div>
  </div>
</NetworkShell>
