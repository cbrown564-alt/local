---
import "../../styles/global.css";
import "../../styles/concept-groves-chemist.css";
import ConceptLayout from "../../layouts/ConceptLayout.astro";

// Everything here existed on groveschemist.com before it was deactivated. The
// concept restores the capability, not a redesign of something still running.
const branches = [
  { name: "Dundrum", address: "165–167 Main Street, BT33 0LY", phone: "028 4375 1326" },
  { name: "Killough", address: "Killough Pharmacy", phone: "028 4484 2915" },
];
const services = [
  "Pharmacy First — minor ailments",
  "Blood pressure monitoring",
  "Contraception service",
  "Quit smoking support",
  "Medicines Use Reviews",
  "Nursing & residential homes",
];
const surgeries = ["Newcastle", "Dundrum", "Clough", "Downpatrick", "Ardglass"];
---

<ConceptLayout
  title={"Groves Chemist — independent concept"}
  slug="groves-chemist"
  bodyClass="concept-page concept-groves"
  businessName="Groves Chemist"
  town="Dundrum"
  bannerNote="Restores capability the pharmacy's own deactivated site used to carry."
>
  <div class="gc-strip">
    <span>Groves Chemists Ltd · Dundrum &amp; Killough · family owned</span>
    <span class="gc-strip-hours">Open today until 6.00pm</span>
  </div>

  <header class="gc-header">
    <a class="gc-brand" href="/concepts/groves-chemist/">
      <svg class="gc-cross" width="30" height="30" viewBox="0 0 30 30" aria-hidden="true">
        <rect x="12" y="2" width="6" height="26" rx="1.4" fill="currentColor" />
        <rect x="2" y="12" width="26" height="6" rx="1.4" fill="currentColor" />
      </svg>
      <span class="gc-brand-text">
        <span class="gc-brand-name">Groves Chemist</span>
        <span class="gc-brand-sub">Health promoting pharmacies</span>
      </span>
    </a>
    <nav class="gc-nav" aria-label="Concept navigation">
      <a href="#" data-concept-placeholder>Prescriptions</a><a href="#" data-concept-placeholder>Services</a><a href="#" data-concept-placeholder>Branches</a><a href="#" data-concept-placeholder>Advice</a>
    </nav>
    <a class="gc-phone" href="tel:+442843751326">028 4375 1326</a>
  </header>

  <main class="gc-main">
    <section class="gc-lede">
      <p class="gc-eyebrow">Dundrum &amp; Killough</p>
      <h1>Your repeat prescription,<br /><em>ordered before you forget.</em></h1>
      <p class="gc-body">
        We collect from surgeries in {surgeries.join(", ")}, and deliver free across
        BT30 and BT33. Tell us what you need and which branch suits — we'll do the
        chasing and text you when it's ready.
      </p>

      <ul class="gc-services">
        {services.map((service) => (
          <li>{service}</li>
        ))}
      </ul>

      <div class="gc-branches">
        {branches.map((branch) => (
          <article class="gc-branch">
            <h2>{branch.name}</h2>
            <p>{branch.address}</p>
            <a href={`tel:${branch.phone.replace(/\s/g, "")}`}>{branch.phone}</a>
          </article>
        ))}
      </div>
    </section>

    <!-- The dispensing label. A pharmacy's most familiar object, used as the
         form surface — perforated top edge, tabular numerals, warning line. -->
    <section class="gc-label" aria-labelledby="gc-label-title">
      <div class="gc-perf" aria-hidden="true"></div>
      <form class="gc-label-body" method="post" data-gc-order aria-label="Order a repeat prescription">
        <p class="gc-label-org">Groves Chemists Ltd · 165–167 Main Street, Dundrum</p>
        <h2 id="gc-label-title">Order a repeat</h2>

        <div class="gc-field">
          <label for="gc-name">Name on the prescription</label>
          <input id="gc-name" name="name" type="text" placeholder="e.g. Margaret Grove" autocomplete="name" required />
        </div>

        <div class="gc-field">
          <label for="gc-items">Items you need</label>
          <textarea id="gc-items" name="items" rows="3" placeholder="One per line, as printed on your repeat slip" required></textarea>
        </div>

        <fieldset class="gc-field gc-field--choice">
          <legend>Collect from</legend>
          <label><input type="radio" name="gc-branch" value="dundrum" checked /> <span>Dundrum</span></label>
          <label><input type="radio" name="gc-branch" value="killough" /> <span>Killough</span></label>
          <label><input type="radio" name="gc-branch" value="delivery" /> <span>Deliver to me</span></label>
        </fieldset>

        <button class="gc-submit" type="submit">Preview order handoff</button>

        <div class="gc-handoff" data-gc-handoff role="status" hidden tabindex="-1">
          <strong>Prototype handoff only — nothing is sent from this concept.</strong>
          <span>
            In the live site, this repeat request would go to the dispensary team at your
            chosen branch. For now, call with the details you entered.
          </span>
          <a data-gc-call-link href="tel:+442843751326">Call Dundrum · 028 4375 1326</a>
        </div>
        <p class="gc-label-stale" data-gc-stale role="status" hidden>
          Your details changed. Press <strong>Preview order handoff</strong> again so the
          call link matches what you typed.
        </p>

        <p class="gc-label-foot">
          Or call either branch directly · this independent concept does not submit
          prescription orders itself
        </p>

        <p class="gc-warn">
          <strong>Not for emergencies.</strong> If you need urgent help, phone the branch or
          call 111.
        </p>
      </form>
    </section>
  </main>
</ConceptLayout>

<script>
  const branchPhones: Record<string, { label: string; href: string }> = {
    dundrum: { label: "Call Dundrum · 028 4375 1326", href: "tel:+442843751326" },
    killough: { label: "Call Killough · 028 4484 2915", href: "tel:+442844842915" },
    delivery: { label: "Call Dundrum · 028 4375 1326", href: "tel:+442843751326" },
  };

  document.querySelectorAll<HTMLFormElement>("[data-gc-order]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const branch = String(new FormData(form).get("gc-branch") ?? "dundrum");
      const phone = branchPhones[branch] ?? branchPhones.dundrum;
      const handoff = form.querySelector<HTMLElement>("[data-gc-handoff]");
      const link = form.querySelector<HTMLAnchorElement>("[data-gc-call-link]");
      const stale = form.querySelector<HTMLElement>("[data-gc-stale]");
      if (!handoff || !link) return;

      link.href = phone.href;
      link.textContent = phone.label;
      handoff.hidden = false;
      if (stale) stale.hidden = true;
      handoff.focus();
    });

    form.addEventListener("input", () => {
      const handoff = form.querySelector<HTMLElement>("[data-gc-handoff]");
      const stale = form.querySelector<HTMLElement>("[data-gc-stale]");
      if (!handoff || handoff.hidden) return;
      handoff.hidden = true;
      if (stale) stale.hidden = false;
    });
  });
</script>
