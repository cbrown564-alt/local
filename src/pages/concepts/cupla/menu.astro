---
import "../../../styles/global.css";
import "../../../styles/concept-cupla.css";
const instagram = "https://www.instagram.com/cuplabrewbar/";
import ConceptLayout from "../../../layouts/ConceptLayout.astro";
---

<ConceptLayout title={"Biachlár · Menu — Cúpla, Dundrum"} slug="cupla" bodyClass="concept-page concept-cupla" lang="en-GB">
<div class="cp-strip">
      <span>105 Main Street, Dundrum, Co. Down · <em lang="ga">ar an bpríomhshráid</em></span>
      <span>Today's hours on <a href={instagram}>Instagram</a></span>
    </div>
    <header class="cp-header">
      <a class="cp-brand" href="/concepts/cupla/">
        <svg class="cp-rings" width="46" height="34" viewBox="0 0 46 34" fill="none" aria-hidden="true">
          <circle cx="16" cy="17" r="13.5" stroke="#1d4e54" stroke-width="2.4" />
          <circle cx="30" cy="17" r="13.5" stroke="#c98a3b" stroke-width="2.4" />
        </svg>
        <span class="cp-brand-text">
          <span class="cp-brand-name">Cúpla</span>
          <span class="cp-brand-sub">Brews · Bakes · Bowls</span>
        </span>
      </a>
      <nav class="cp-nav" aria-label="Concept navigation">
        <a href="/concepts/cupla/"><span lang="ga">Fáilte</span> <span aria-hidden="true">·</span> Home</a><a href="/concepts/cupla/menu/" aria-current="page"><span lang="ga">An biachlár</span> <span aria-hidden="true">·</span> Menu</a><a href="#" data-concept-placeholder><span lang="ga">Ár scéal</span> <span aria-hidden="true">·</span> Our story</a><a href="#" data-concept-placeholder><span lang="ga">Aimsigh sinn</span> <span aria-hidden="true">·</span> Find us</a>
      </nav>
      <a class="cp-follow" href={instagram}>Follow @cuplabrewbar</a>
    </header>

    <main class="cp-menu" id="main">
      <div class="cp-menu-head">
        <div class="cp-menu-head-copy">
          <h1 class="cp-menu-title"><span lang="ga">Biachlár</span> <em>Menu</em></h1>
          <p class="cp-menu-address">105 Main Street · Dundrum, Co. Down · <em lang="ga">Dún Droma</em></p>
          <p class="cp-menu-provisional">
            Illustrative sample menu and sterling prices for design evaluation;
            confirm current items and prices on Instagram.
          </p>
        </div>
        <p class="cp-menu-today">
          <span lang="ga">Speisialtachtaí inniu ar Instagram</span>
          <span class="cp-menu-today-sep" aria-hidden="true">·</span>
          <span>Today's specials on <a href={instagram}>@cuplabrewbar</a></span>
        </p>
      </div>

      <div class="cp-menu-cols">

        <!-- Coffee -->
        <section class="cp-menu-col" aria-labelledby="cp-col-coffee">
          <h2 class="cp-menu-col-hd" id="cp-col-coffee">
            <span class="cp-menu-col-ga" lang="ga">Caife</span>
            <span class="cp-menu-col-en">Coffee</span>
          </h2>
          <ul class="cp-menu-list">
            <li class="cp-menu-item">
              <span class="cp-menu-item-ga">Espresso</span>
              <span class="cp-menu-item-en">Short or long</span>
              <span class="cp-menu-item-price">£2.50</span>
            </li>
            <li class="cp-menu-item">
              <span class="cp-menu-item-ga">Americano</span>
              <span class="cp-menu-item-en">Filter strength</span>
              <span class="cp-menu-item-price">£3.00</span>
            </li>
            <li class="cp-menu-item">
              <span class="cp-menu-item-ga">Caife Bán <em>Flat White</em></span>
              <span class="cp-menu-item-en">Double ristretto</span>
              <span class="cp-menu-item-price">£3.80</span>
            </li>
            <li class="cp-menu-item">
              <span class="cp-menu-item-ga">Cappuccino</span>
              <span class="cp-menu-item-en">Dry or wet</span>
              <span class="cp-menu-item-price">£3.80</span>
            </li>
            <li class="cp-menu-item">
              <span class="cp-menu-item-ga">Latte</span>
              <span class="cp-menu-item-en">12 oz · 16 oz</span>
              <span class="cp-menu-item-price">£4.00</span>
            </li>
            <li class="cp-menu-item">
              <span class="cp-menu-item-ga">Caife Scagtha <em>Filter</em></span>
              <span class="cp-menu-item-en">Single origin, changed daily</span>
              <span class="cp-menu-item-price">£2.80</span>
            </li>
            <li class="cp-menu-item">
              <span class="cp-menu-item-ga">Tae <em>Tea</em></span>
              <span class="cp-menu-item-en">Loose-leaf, pot for one</span>
              <span class="cp-menu-item-price">£2.80</span>
            </li>
          </ul>
        </section>

        <!-- Bakes -->
        <section class="cp-menu-col" aria-labelledby="cp-col-bakes">
          <h2 class="cp-menu-col-hd" id="cp-col-bakes">
            <span class="cp-menu-col-ga" lang="ga">Bácús</span>
            <span class="cp-menu-col-en">Morning bakes</span>
          </h2>
          <ul class="cp-menu-list">
            <li class="cp-menu-item">
              <span class="cp-menu-item-ga">Scóna <em>Scone</em></span>
              <span class="cp-menu-item-en">Butter, jam and cream</span>
              <span class="cp-menu-item-price">£3.50</span>
            </li>
            <li class="cp-menu-item">
              <span class="cp-menu-item-ga">Croissant</span>
              <span class="cp-menu-item-en">Plain or almond</span>
              <span class="cp-menu-item-price">£3.00</span>
            </li>
            <li class="cp-menu-item">
              <span class="cp-menu-item-ga">Muffin an Lae</span>
              <span class="cp-menu-item-en">Ask at the counter</span>
              <span class="cp-menu-item-price">£3.00</span>
            </li>
            <li class="cp-menu-item">
              <span class="cp-menu-item-ga">Cáca Milis <em>Cake</em></span>
              <span class="cp-menu-item-en">Slice, changes daily</span>
              <span class="cp-menu-item-price">£4.50</span>
            </li>
            <li class="cp-menu-item">
              <span class="cp-menu-item-ga">Tósta <em>Toast</em></span>
              <span class="cp-menu-item-en">Sourdough with butter</span>
              <span class="cp-menu-item-price">£3.00</span>
            </li>
          </ul>
        </section>

        <!-- Brunch Bowls -->
        <section class="cp-menu-col" aria-labelledby="cp-col-bowls">
          <h2 class="cp-menu-col-hd" id="cp-col-bowls">
            <span class="cp-menu-col-ga" lang="ga">Babhlaí</span>
            <span class="cp-menu-col-en">Brunch bowls</span>
          </h2>
          <ul class="cp-menu-list">
            <li class="cp-menu-item">
              <span class="cp-menu-item-ga">Gránóla <em>Granola</em></span>
              <span class="cp-menu-item-en">Local honey, seasonal fruit</span>
              <span class="cp-menu-item-price">£7.00</span>
            </li>
            <li class="cp-menu-item">
              <span class="cp-menu-item-ga"><span lang="ga">Babhla</span> Açaí <em>Açaí bowl</em></span>
              <span class="cp-menu-item-en">Granola, banana, coconut</span>
              <span class="cp-menu-item-price">£9.00</span>
            </li>
            <li class="cp-menu-item">
              <span class="cp-menu-item-ga" lang="ga">Babhla Blasta <em lang="en">Savoury bowl</em></span>
              <span class="cp-menu-item-en">Egg, greens, seasonal veg</span>
              <span class="cp-menu-item-price">£10.50</span>
            </li>
            <li class="cp-menu-item">
              <span class="cp-menu-item-ga" lang="ga">Babhla an Lae <em lang="en">Bowl of the day</em></span>
              <span class="cp-menu-item-en">Ask at the counter</span>
              <span class="cp-menu-item-price">—</span>
            </li>
          </ul>
        </section>

      </div>

      <div class="cp-menu-specials">
        <span class="cp-menu-specials-ga">Speisialtachtaí an lae</span>
        <span class="cp-menu-specials-sep" aria-hidden="true">·</span>
        <span class="cp-menu-specials-en">Today's counter specials live on Instagram</span>
        <a class="cp-menu-specials-link" href={instagram}>@cuplabrewbar →</a>
      </div>
    </main>
</ConceptLayout>
