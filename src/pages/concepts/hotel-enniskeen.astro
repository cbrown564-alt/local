---
import "../../styles/global.css";
import "../../styles/concept-enniskeen.css";
const bookin1 = "https://www.bookin1.com/bookingEngine/index.jsp?ID=ecs&hotelCode=ecs#/hotel/ecs";
import ConceptLayout from "../../layouts/ConceptLayout.astro";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
---

<ConceptLayout title={"Enniskeen Country House Hotel — independent concept"} slug="hotel-enniskeen" bodyClass="concept-page concept-enniskeen" lang="en-GB">
<header class="enk-header">
      <div class="enk-brand">
        <span class="enk-brand-name">Enniskeen</span>
        <span class="enk-brand-sub">Country House Hotel · Shimna Valley</span>
      </div>
      <nav class="enk-nav" aria-label="Concept navigation">
        <a href="/concepts/hotel-enniskeen/rooms/">Stay</a><a href="#">Dine</a><a href="#">The estate</a><a href="#">Things to do</a>
      </nav>
      <div class="enk-header-actions">
        <a class="enk-phone" href="tel:+442843722392">028 4372 2392</a>
        <a class="enk-book" href={bookin1} rel="external">Book a room</a>
      </div>
    </header>
    <main class="enk-hero">
      <section class="enk-story">
        <p class="enk-kicker">Newcastle · County Down</p>
        <h1>A mountainside <em>hideaway</em> above the Shimna Valley.</h1>
        <p class="enk-lede">
          Family-run, in twelve wooded acres beneath the Mournes — the river trail from the
          door, Mourne Honey afternoon tea on the terrace, and a quiet nightcap in the
          Brandy Pad Lounge.
        </p>
        <div class="enk-actions">
          <a class="enk-cta" href="/concepts/hotel-enniskeen/rooms/">See rooms &amp; suites</a>
          <a class="enk-link" href="#">Afternoon tea →</a>
        </div>
      </section>
      <figure class="enk-visual">
        <ResponsiveImage pictureClass="concept-responsive-picture" src="/images/enniskeen-balcony.jpg" alt="A bedroom's french doors open onto a balcony overlooking the Shimna Valley and the Mourne Mountains" width="1280" height="853" loading="eager" />
        <figcaption>The valley from a balcony room</figcaption>
      </figure>
      <form class="enk-booking" action={bookin1} method="get" aria-label="Check availability">
        <label>Arrive <input type="date" name="arrive" value="2026-07-24" /></label>
        <label>Nights
          <select name="nights"><option>2</option><option>1</option><option>3</option><option>4</option><option>5</option><option>7</option></select>
        </label>
        <label>Guests
          <select name="guests"><option>2 adults</option><option>1 adult</option><option>2 + child</option><option>Family</option></select>
        </label>
        <button type="submit">Check availability</button>
      </form>
    </main>
</ConceptLayout>
