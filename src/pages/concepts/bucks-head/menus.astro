<script>
      const tabs = document.querySelectorAll<HTMLButtonElement>(".bh-tab");
      const panels = document.querySelectorAll<HTMLElement>(".bh-menu-panel");

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          tabs.forEach((t) => t.setAttribute("aria-selected", "false"));
          panels.forEach((p) => { delete p.dataset.active; });

          tab.setAttribute("aria-selected", "true");
          const target = document.getElementById(tab.getAttribute("aria-controls") ?? "");
          if (target) target.dataset.active = "true";
        });
      });
    </script>
