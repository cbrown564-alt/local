---
import "../../../styles/global.css";
import "../../../styles/concept-scopers.css";
const instagram = "https://www.instagram.com/scopersdundrum/";
const facebook = "https://www.facebook.com/p/Scopers-Dundrum-Co-Down-100083029315116/";
const bookingLink = instagram;
import ConceptLayout from "../../../layouts/ConceptLayout.astro";
---

<ConceptLayout title={"The Supper Club — Scopers · independent concept"} slug="scopers" bodyClass="concept-page concept-scopers" lang="en-GB">
<div class="sc-strip">
      <span><strong>Now open most of the week</strong> · 169 Main Street, Dundrum</span>
      <span>Today's hours on <a href={facebook} style="color:#fff;">Facebook</a></span>
    </div>
    <header class="sc-header">
      <a class="sc-brand" href="/concepts/scopers/">
        <svg class="sc-stamp" width="44" height="44" viewBox="0 0 44 44" fill="none" aria-hidden="true">
          <circle cx="22" cy="22" r="20.5" stroke="currentColor" stroke-width="2" />
          <path d="M22 33 C22 26 22 20 22 13 M22 20 C18 18 15.5 15 15 10.5 C19.5 11 22 14 22 18 M22 25 C26 23 28.5 20 29 15.5 C24.5 16 22 19 22 23" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span class="sc-brand-text">
          <span class="sc-brand-name">Scopers</span>
          <span class="sc-brand-sub">Zero-waste hot food bar</span>
        </span>
      </a>
      <nav class="sc-nav" aria-label="Concept navigation">
        <a href="/concepts/scopers/">The food</a><a href="#" aria-current="page">Supper club</a><a href="/concepts/scopers/">Our story</a><a href="/concepts/scopers/">Find us</a>
      </nav>
      <a class="sc-book" href={bookingLink}>Book your place</a>
    </header>

    <main>
      <section class="sc-night-hero">
        <div class="sc-night-eyebrow">
          <span class="sc-night-tag">Supper club</span>
          <span class="sc-night-date">Saturday 23 August · Doors 7 pm</span>
        </div>
        <h1 class="sc-night-title">Late summer.<br /><em>Mourne table.</em></h1>
        <p class="sc-night-lede">
          Up to eleven courses drawn entirely from what the Mourne Larder gives in August —
          gathered, foraged and cooked by Paul Cunningham at a location announced to guests
          the week before the night.
        </p>
        <div class="sc-night-actions">
          <a class="sc-cta" href={bookingLink}>Message to reserve</a>
          <a class="sc-link" href={facebook}>See past events on Facebook →</a>
        </div>
        <aside class="sc-night-card">
          <p class="sc-night-card-label">The details</p>
          <ul class="sc-night-details" aria-label="Event details">
            <li>
              <span class="sc-detail-key">When</span>
              <span class="sc-detail-val">Saturday 23 August 2025 · 7 pm</span>
            </li>
            <li>
              <span class="sc-detail-key">Where</span>
              <span class="sc-detail-val">A unique Mourne location — revealed to guests by DM</span>
            </li>
            <li>
              <span class="sc-detail-key">Courses</span>
              <span class="sc-detail-val">Up to eleven · entirely seasonal</span>
            </li>
            <li>
              <span class="sc-detail-key">Drinks</span>
              <span class="sc-detail-val">Natural wine and local beers available on the night</span>
            </li>
            <li>
              <span class="sc-detail-key">Spaces</span>
              <span class="sc-detail-val">Limited · private booking only</span>
            </li>
          </ul>
          <a class="sc-night-card-cta" href={bookingLink}>Reserve via Instagram DM</a>
          <small class="sc-night-card-note">Book through the same inbox the kitchen already answers</small>
        </aside>
      </section>

      <section class="sc-night-philosophy">
        <div class="sc-night-phil-inner">
          <p class="sc-kicker">The philosophy</p>
          <h2 class="sc-night-phil-h2">The Mourne Larder, course by course.</h2>
          <div class="sc-night-phil-body">
            <p>
              Paul Cunningham cooked on Great British Menu in 2021. When he came home to Dundrum,
              he brought the same discipline — nothing invented, nothing wasted, everything sourced
              from the immediate landscape around the Mournes.
            </p>
            <p>
              The supper club takes that further. A secret location chosen for the night, a menu
              finalised only once the week's foraging is in, a table of no more than a handful of
              guests. Eleven courses, or however many the season allows.
            </p>
          </div>
        </div>
        <div class="sc-night-course-list" aria-label="Sample courses">
          <p class="sc-night-course-label">What August brings</p>
          <ol>
            <li><span>Mourne honey &amp; wild thyme amuse</span></li>
            <li><span>Cured Kilkeel mackerel · sea vegetables</span></li>
            <li><span>Roast heritage tomato · goats' curd</span></li>
            <li><span>Wild mushroom broth · barley</span></li>
            <li><span>Buttermilk cured salmon · fennel oil</span></li>
            <li><span>Foraged leaf salad · hazelnut vinaigrette</span></li>
            <li><span>Slow-cooked Mourne lamb · sorrel</span></li>
            <li><span>Blackberry &amp; elderflower palate cleanser</span></li>
            <li><span>Cheese · Drumlin Farm · Coolattin cheddar</span></li>
            <li><span>Hedgerow fruit tart · clotted cream</span></li>
            <li><span>Petit fours · bee pollen &amp; dark chocolate</span></li>
          </ol>
          <p class="sc-night-course-note">Menu varies with each event — this season's harvest decides.</p>
        </div>
      </section>

      <section class="sc-night-book-section">
        <div class="sc-night-book-inner">
          <p class="sc-kicker">Reserve your place</p>
          <h2 class="sc-night-book-h2">Places are limited. The list fills quickly.</h2>
          <p class="sc-night-book-copy">
            Message us on Instagram or Facebook to join the list for the next night.
            We'll reply within a day with availability, pricing and everything you need to know.
          </p>
          <div class="sc-night-book-actions">
            <a class="sc-cta" href={instagram}>Message on Instagram</a>
            <a class="sc-cta sc-cta-outline" href={facebook}>Message on Facebook</a>
          </div>
          <p class="sc-night-book-meta">
            <strong>Next date:</strong> Saturday 23 August · future dates announced on Instagram and Facebook
          </p>
        </div>
        <a class="sc-night-back" href="/concepts/scopers/">← Back to the hot food bar</a>
      </section>
    </main>
</ConceptLayout>
