---
import "../../styles/global.css";
import "../../styles/concept-tool-centre.css";
const facebook = "https://www.facebook.com/Toolcentreplanthire/";
const phone = "tel:+442843725010";
const phoneDisplay = "028 4372 5010";
import ConceptLayout from "../../layouts/ConceptLayout.astro";
---

<ConceptLayout title={"The Tool Centre — independent concept"} slug="tool-centre" bodyClass="concept-page concept-tool-centre" lang="en-GB">
<div class="tc-strip">
      <span><strong>107 Main Street</strong> · Newcastle, Co. Down · BT33 0AE</span>
      <span>Mon–Sat 9–5 · Sun 10–4 · <a href={phone}>{phoneDisplay}</a></span>
    </div>
    <header class="tc-header">
      <a class="tc-brand" href="#">
        <svg class="tc-mark" width="42" height="42" viewBox="0 0 42 42" fill="none" aria-hidden="true">
          <circle cx="21" cy="21" r="20" fill="#0e0e0e" />
          <path d="M10 28 L16 8 H32 L26 28 Z" fill="#f0d000" />
          <path d="M12 24 H28 V28 H12 Z" fill="#0e0e0e" />
        </svg>
        <span class="tc-brand-text">
          <span class="tc-brand-name">The Tool Centre</span>
          <span class="tc-brand-sub">Hardware · Plant &amp; tool hire</span>
        </span>
      </a>
      <nav class="tc-nav" aria-label="Concept navigation">
        <a href="/concepts/tool-centre/hire-list/">Hire</a><a href="#">Hardware</a><a href="#">Gas</a><a href="#">Hours</a><a href="#">Find us</a>
      </nav>
      <a class="tc-call" href={phone}>Call {phoneDisplay}</a>
    </header>
    <main class="tc-hero">
      <section class="tc-story">
        <p class="tc-kicker">Newcastle, Co. Down · under the Mournes</p>
        <h1>Hardware on the shelf. <em>Hire on the yard.</em></h1>
        <p class="tc-lede">
          The Tool Centre on Main Street stocks the trade counter and hires plant
          and tools out the back — the same shop Facebook lists as <strong>Tool Centre Plant Hire</strong>, for contractors and DIY across
          Newcastle, Co. Down.
        </p>
        <div class="tc-actions">
          <a class="tc-cta" href={phone}>Call for hire rates</a>
          <a class="tc-link" href="/concepts/tool-centre/hire-list/">See hire price list →</a>
        </div>
      </section>
      <aside class="tc-panel">
        <article class="tc-desk">
          <p class="tc-desk-kicker">Hire desk</p>
          <h2>Today's rates — ask the counter.</h2>
          <ul class="tc-rates">
            <li><span class="tc-rate-item">Power tools</span><span class="tc-rate-ask">Day rate on request</span></li>
            <li><span class="tc-rate-item">Garden machinery</span><span class="tc-rate-ask">Day rate on request</span></li>
            <li><span class="tc-rate-item">Plant &amp; site gear</span><span class="tc-rate-ask">Day rate on request</span></li>
            <li><span class="tc-rate-item">Access equipment</span><span class="tc-rate-ask">Day rate on request</span></li>
          </ul>
          <a class="tc-desk-cta" href={phone}>Call {phoneDisplay}</a>
          <small>Straight through to the number the yard already answers</small>
        </article>
      </aside>
      <nav class="tc-rail" aria-label="Stock categories and hours">
        <a class="tc-rail-cell" href="#"><span class="tc-cat">Hardware</span><span class="tc-cat-note">Trade &amp; DIY stock</span></a>
        <a class="tc-rail-cell" href="/concepts/tool-centre/hire-list/"><span class="tc-cat">Tool hire</span><span class="tc-cat-note">Day &amp; weekend</span></a>
        <a class="tc-rail-cell" href="/concepts/tool-centre/hire-list/"><span class="tc-cat">Plant hire</span><span class="tc-cat-note">Site machinery</span></a>
        <a class="tc-rail-cell" href="#"><span class="tc-cat">Bottled gas</span><span class="tc-cat-note">Calor cylinders</span></a>
        <a class="tc-rail-cell" href={facebook}><span class="tc-cat">Open today</span><span class="tc-cat-note">Hours on Facebook →</span></a>
      </nav>
    </main>
</ConceptLayout>
