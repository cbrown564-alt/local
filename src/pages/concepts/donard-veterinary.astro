---
import "../../styles/global.css";
import "../../styles/concept-donard-veterinary.css";
const requestMail = "mailto:info@donardveterinaryclinic.co.uk?subject=Appointment%20request";
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500&family=Karla:wght@400;700&display=swap" rel="stylesheet" />
    <title>Donard Veterinary Clinic — independent concept</title>
  </head>
  <body class="concept-page concept-donard-veterinary">
    <div class="dv-strip">
      <span>Pet emergency? Call <a href="tel:+442843729414">028 4372 9414</a></span>
      <span class="dv-strip-hours">Mon–Fri 8:30am–6:30pm · Wed until 7pm · Sat 9am–1pm</span>
    </div>
    <header class="dv-header">
      <a class="dv-brand" href="#">
        <svg class="dv-badge" width="46" height="46" viewBox="0 0 46 46" fill="none" aria-hidden="true">
          <circle cx="23" cy="23" r="21.5" stroke="#4d2d5e" stroke-width="2.6" />
          <path d="M7 30 L16 17 L21 23 L28 13 L39 30" stroke="#4d2d5e" stroke-width="2.6" stroke-linejoin="round" fill="none" />
          <path d="M25.5 16.5 L28 13 L30.5 16.5" stroke="#2f9d82" stroke-width="2.6" stroke-linejoin="round" />
        </svg>
        <span class="dv-brand-text">
          <span class="dv-brand-name">Donard Veterinary Clinic</span>
          <span class="dv-brand-sub">Professional · Caring · Compassionate</span>
        </span>
      </a>
      <nav class="dv-nav" aria-label="Concept navigation">
        <a href="#">Our practice</a><a href="#">Pet services</a><a href="#">VidiVet</a><a href="#">FAQs</a><a href="#">Contact</a>
      </nav>
      <div class="dv-header-actions">
        <a class="dv-phone" href="tel:+442843729414">028 4372 9414</a>
        <a class="dv-book" href="/concepts/donard-veterinary/appointments/">Book an appointment</a>
      </div>
    </header>
    <main class="dv-hero">
      <svg class="dv-mournes" viewBox="0 0 1265 300" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 300 L0 210 L190 120 L340 200 L520 80 L710 220 L900 130 L1080 210 L1265 150 L1265 300 Z" fill="#efe8f5" />
        <path d="M0 300 L0 260 L230 180 L420 250 L640 150 L860 260 L1050 200 L1265 250 L1265 300 Z" fill="#e2d5ee" />
      </svg>
      <section class="dv-story">
        <p class="dv-kicker">Railway Street · Newcastle</p>
        <h1>Taking care of <em>your</em> pets.</h1>
        <p class="dv-lede">
          A compassionate, caring service delivering excellent professional veterinary
          care — routine health checks, diagnostics, surgery and dental in the clinic,
          with VidiVet answers whenever you're unsure.
        </p>
        <div class="dv-actions">
          <a class="dv-cta" href="/concepts/donard-veterinary/appointments/">Request an appointment</a>
          <a class="dv-link" href="/concepts/donard-veterinary/appointments/">Emergency information →</a>
        </div>
      </section>
      <aside class="dv-panel">
        <form class="dv-request" action={requestMail} method="get" aria-label="Request an appointment">
          <h2>Request an appointment</h2>
          <p>We'll ring back to confirm a time that suits.</p>
          <label>Your name <input type="text" name="name" autocomplete="name" /></label>
          <div class="dv-request-row">
            <label>Your pet
              <select name="pet"><option>Dog</option><option>Cat</option><option>Small pet</option><option>Other</option></select>
            </label>
            <label>Preferred day
              <select name="day"><option>First available</option><option>Monday</option><option>Tuesday</option><option>Wednesday</option><option>Thursday</option><option>Friday</option><option>Saturday</option></select>
            </label>
          </div>
          <label>Phone number <input type="tel" name="phone" autocomplete="tel" /></label>
          <button type="submit">Send request</button>
          <small>Or call <a href="tel:+442843729414">028 4372 9414</a> · repeat prescriptions welcome</small>
        </form>
      </aside>
      <nav class="dv-rail" aria-label="Pet services">
        <a class="dv-service" href="#"><span></span>Routine health care</a>
        <a class="dv-service" href="#"><span></span>Diagnostics</a>
        <a class="dv-service" href="#"><span></span>Surgery</a>
        <a class="dv-service" href="#"><span></span>Dental clinic</a>
        <a class="dv-service" href="#"><span></span>Weight clinic</a>
        <a class="dv-service" href="#"><span></span>Pet passports</a>
      </nav>
    </main>
    <div class="concept-disclosure">Independent concept · not the live Donard Veterinary site</div>
  </body>
</html>
