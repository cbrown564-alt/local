---
import "../../styles/global.css";
import "../../styles/concept-newcastle-chamber.css";
const email = "mailto:newcastlechamber2023@gmail.com";
const facebook = "https://www.facebook.com/newcastlechamberofcommerce/";
const instagram = "https://www.instagram.com/newcastlechamber_/";
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,500;0,600;0,700;1,500;1,600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>Newcastle Chamber of Commerce — independent concept</title>
  </head>
  <body class="concept-page concept-newcastle-chamber">
    <div class="nc-strip">
      <span><strong>Newcastle, Co. Down</strong> · 50A Main Street · under the Mournes</span>
      <span>News on <a href={facebook}>Facebook</a> &amp; <a href={instagram}>Instagram</a></span>
    </div>
    <header class="nc-header">
      <a class="nc-brand" href="#">
        <svg class="nc-seal" width="46" height="46" viewBox="0 0 46 46" fill="none" aria-hidden="true">
          <circle cx="23" cy="23" r="21.5" stroke="currentColor" stroke-width="1.6" />
          <circle cx="23" cy="23" r="17.5" stroke="currentColor" stroke-width="1" opacity="0.45" />
          <path d="M10 28 L16 20 L20 24 L26 14 L32 22 L36 18 L36 30 L10 30 Z" fill="currentColor" opacity="0.9" />
          <path d="M10 30 H36" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <span class="nc-brand-text">
          <span class="nc-brand-name">Newcastle Chamber</span>
          <span class="nc-brand-sub">of Commerce · Co. Down</span>
        </span>
      </a>
      <nav class="nc-nav" aria-label="Concept navigation">
        <a href="/concepts/newcastle-chamber/members/">Members</a><a href="#">Events</a><a href={email}>Join</a><a href={instagram}>Find us</a>
      </nav>
      <a class="nc-join" href={email}>Join the chamber</a>
    </header>
    <main class="nc-hero">
      <section class="nc-story">
        <p class="nc-kicker">Civic hub · Main Street</p>
        <h1>The town's businesses, <em>under one roof.</em></h1>
        <p class="nc-lede">
          Newcastle Chamber of Commerce — Co. Down, not Tyne — is the volunteer-run hub for
          traders on Main Street and beyond: a member directory, the town's events, and a clear
          door to join. Reformed in 2023; still answering from the same Gmail and socials.
        </p>
        <div class="nc-actions">
          <a class="nc-cta" href={email}>Email to join</a>
          <a class="nc-link" href={facebook}>Follow on Facebook →</a>
        </div>
      </section>
      <aside class="nc-panel">
        <article class="nc-event">
          <p class="nc-event-kicker">Coming up · town calendar</p>
          <h2>Halloween in Newcastle</h2>
          <p>Planned primarily by the Chamber with Newry, Mourne and Down District Council — family night on the town.</p>
          <p class="nc-event-meta"><strong>Saturday 31 October 2026</strong><span>Further details on Facebook &amp; Instagram as they land</span></p>
          <a class="nc-event-cta" href={facebook}>See event updates</a>
          <small>Straight from the Facebook page the Chamber already runs</small>
        </article>
      </aside>
      <nav class="nc-rail" aria-label="Chamber sections">
        <a class="nc-rail-cell" href="/concepts/newcastle-chamber/members/"><span class="nc-rail-label">Members</span><span class="nc-rail-note">Directory of Main Street traders</span></a>
        <a class="nc-rail-cell" href="#"><span class="nc-rail-label">Events</span><span class="nc-rail-note">Town calendar, kept current</span></a>
        <a class="nc-rail-cell" href={email}><span class="nc-rail-label">Join</span><span class="nc-rail-note">Write to the chamber inbox →</span></a>
        <a class="nc-rail-cell" href={instagram}><span class="nc-rail-label">Find us</span><span class="nc-rail-note">50A Main Street · @newcastlechamber_</span></a>
      </nav>
    </main>
    <div class="concept-disclosure">Independent concept · not a live Chamber site</div>
  </body>
</html>
