---
import "../../../styles/global.css";
import "../../../styles/concept-donard-veterinary.css";
const requestMail = "mailto:info@donardveterinaryclinic.co.uk?subject=Appointment%20request";
import ConceptLayout from "../../../layouts/ConceptLayout.astro";
import DonardRequestForm from "../../../components/concepts/DonardRequestForm.astro";
---

<ConceptLayout title={"Appointments & emergency care — Donard Veterinary Clinic"} slug="donard-veterinary" bodyClass="concept-page concept-donard-veterinary" lang="en-GB">
<div class="dv-strip">
      <span>Pet emergency? Call <a href="tel:+442843729414">028 4372 9414</a></span>
      <span class="dv-strip-hours">Mon–Fri 8:30am–6:30pm · Wed until 7pm · Sat 9am–1pm</span>
    </div>

    <header class="dv-header">
      <a class="dv-brand" href="/concepts/donard-veterinary/">
        <svg class="dv-badge" width="46" height="46" viewBox="0 0 46 46" fill="none" aria-hidden="true">
          <circle cx="23" cy="23" r="21.5" stroke="#4d2d5e" stroke-width="2.6" />
          <path d="M7 30 L16 17 L21 23 L28 13 L39 30" stroke="#4d2d5e" stroke-width="2.6" stroke-linejoin="round" fill="none" />
          <path d="M25.5 16.5 L28 13 L30.5 16.5" stroke="#2f9d82" stroke-width="2.6" stroke-linejoin="round" />
        </svg>
        <span class="dv-brand-text">
          <span class="dv-brand-name">Donard Veterinary Clinic</span>
          <span class="dv-brand-sub">Professional · Caring · Compassionate</span>
        </span>
      </a>
      <nav class="dv-nav" aria-label="Concept navigation">
        <a href="/concepts/donard-veterinary/">Our practice</a>
        <a href="#" data-concept-placeholder>Pet services</a>
        <a href="https://donardveterinaryclinic.co.uk/" rel="external">PetsApp</a>
        <a href="#" data-concept-placeholder>FAQs</a>
        <a href="#" data-concept-placeholder>Contact</a>
      </nav>
      <div class="dv-header-actions">
        <a class="dv-phone" href="tel:+442843729414">028 4372 9414</a>
        <a class="dv-book" href="#request">Request appointment</a>
      </div>
    </header>

    <main class="dv-appt-page">

      <div class="dv-appt-intro">
        <p class="dv-kicker">Appointments &amp; emergency care</p>
        <h1>Ask for help.<br /><em>We'll call back.</em></h1>
        <p class="dv-appt-lede">
          Fill in the form and we'll ring to confirm a time that suits.
          For urgent care, the emergency line is at the top of every page.
        </p>
      </div>

      <div class="dv-appt-grid">

        <section class="dv-appt-left" aria-labelledby="appt-form-heading">
          <DonardRequestForm id="request" headingId="appt-form-heading" />

          <div class="dv-appt-contact-row">
            <a class="dv-appt-contact-link" href="tel:+442843729414">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M2.5 3C2.5 3 3.8 1.8 4.7 3.1C5.5 4.3 6 4.8 6 4.8C6 4.8 6.4 5.3 5.6 6.1C4.8 6.9 6 8.2 7.2 9.4C8.5 10.7 9.8 11.9 10.6 11.1C11.4 10.3 11.9 10.8 11.9 10.8C11.9 10.8 13.2 11.4 12.4 12.8C11.6 14.2 10.3 13.4 10.3 13.4C6.2 11.3 2.5 7.2 2.5 3Z" stroke="#4d2d5e" stroke-width="1.4" stroke-linejoin="round"/>
              </svg>
              028 4372 9414
            </a>
            <span class="dv-appt-contact-sep" aria-hidden="true">·</span>
            <a class="dv-appt-contact-link" href={requestMail}>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <rect x="1.5" y="3.5" width="13" height="9" rx="1.2" stroke="#4d2d5e" stroke-width="1.4"/>
                <path d="M1.5 5L8 9.5L14.5 5" stroke="#4d2d5e" stroke-width="1.4" stroke-linejoin="round"/>
              </svg>
              info@donardveterinaryclinic.co.uk
            </a>
          </div>
        </section>

        <section class="dv-appt-right" aria-labelledby="emergency-heading">
          <div class="dv-emergency-card">
            <span class="dv-emergency-tag">Out-of-hours emergency</span>
            <h2 class="dv-emergency-heading" id="emergency-heading">Urgent help for your pet</h2>
            <p class="dv-emergency-body">
              If your pet needs emergency care outside our clinic hours, call the number below.
              For non-emergency online chat, open PetsApp from the clinic's current
              website. Availability and response times are shown there.
            </p>
            <a class="dv-emergency-call" href="tel:+442843729414">
              <span class="dv-emergency-call-label">Call us directly</span>
              <span class="dv-emergency-call-num">028 4372 9414</span>
            </a>
            <div class="dv-emergency-hours">
              <p class="dv-emergency-hours-title">Clinic opening hours</p>
              <ul>
                <li><span>Mon, Tue, Thu, Fri</span><span>8:30am – 6:30pm</span></li>
                <li><span>Wednesday</span><span>8:30am – 7:00pm</span></li>
                <li><span>Saturday</span><span>9:00am – 1:00pm</span></li>
                <li><span>Sunday</span><span class="dv-emergency-hours-closed">Closed</span></li>
              </ul>
            </div>
            <a class="dv-emergency-petsapp" href="https://donardveterinaryclinic.co.uk/" rel="external">
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                <circle cx="7.5" cy="7.5" r="6.5" stroke="currentColor" stroke-width="1.3"/>
                <path d="M5 7.5L7.5 10L10.5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Open PetsApp on the clinic website
            </a>
          </div>
        </section>

      </div>
    </main>
</ConceptLayout>
