---
import ChamberConceptShell from "../../../components/chamber-prototypes/ChamberConceptShell.astro";
import { aboutParagraphs, chamber } from "../../../data/chamber-prototype";

const base = "/concepts/newcastle-chamber";
---
<ChamberConceptShell title="About — Newcastle Chamber of Commerce · Co. Down" current="about">
  <main class="nc-page">
    <p class="nc-kicker">About the chamber</p>
    <h1>A volunteer hub for <em>Newcastle, Co. Down.</em></h1>
    <p class="nc-lede">
      Reformed in {chamber.relaunchYear}. Still answering from the same Gmail and socials —
      now with a standing front door.
    </p>
    <div class="nc-prose">
      {aboutParagraphs.map((p) => <p>{p}</p>)}
    </div>
    <p class="nc-page-actions">
      <a class="nc-cta" href={`${base}/join/`}>Join the chamber</a>
      <a class="nc-link" href={`${base}/contact/`}>Contact details →</a>
    </p>
  </main>
</ChamberConceptShell>
