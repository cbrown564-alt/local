---
import ChamberConceptShell from "../../../components/chamber-prototypes/ChamberConceptShell.astro";
import { chamber } from "../../../data/chamber-prototype";

const base = "/concepts/newcastle-chamber";
---
<ChamberConceptShell title="Contact — Newcastle Chamber of Commerce · Co. Down" current="contact">
  <main class="nc-page">
    <p class="nc-kicker">Find us</p>
    <h1>Write to the <em>committee.</em></h1>
    <p class="nc-lede">
      Volunteer-run since the {chamber.relaunchYear} relaunch. Same inbox and socials — easier to find.
    </p>
    <div class="nc-contact-grid">
      <div class="nc-contact-block">
        <h2>Inbox &amp; phone</h2>
        <p><a href={chamber.emailHref}>{chamber.email}</a></p>
        <p><a href={chamber.phoneHref}>{chamber.phone}</a></p>
        <p class="nc-contact-cta"><a class="nc-cta" href={chamber.emailHref}>Send an email</a></p>
      </div>
      <div class="nc-contact-block">
        <h2>On Main Street</h2>
        <p>{chamber.address}</p>
        <p class="nc-contact-social">
          <a href={chamber.facebook}>Facebook</a> ·
          <a href={chamber.instagram}>Instagram</a> ·
          <a href={chamber.linkedin}>LinkedIn</a>
        </p>
        <p class="nc-contact-cta"><a class="nc-link" href={`${base}/join/`}>Prefer to join? Start here →</a></p>
      </div>
    </div>
  </main>
</ChamberConceptShell>
