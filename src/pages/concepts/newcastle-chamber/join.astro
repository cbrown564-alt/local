---
import ChamberConceptShell from "../../../components/chamber-prototypes/ChamberConceptShell.astro";
import { chamber, joinBenefits } from "../../../data/chamber-prototype";
---
<ChamberConceptShell title="Join — Newcastle Chamber of Commerce · Co. Down" current="join">
  <main class="nc-page">
    <p class="nc-kicker">Membership</p>
    <h1>Trade with neighbours who <em>trade with you.</em></h1>
    <p class="nc-lede">
      Get found in the directory, show up for town nights, and stand with Main Street.
      Write to the inbox the volunteer committee already answers.
    </p>
    <div class="nc-benefits">
      {joinBenefits.map((b, i) => (
        <article class="nc-benefit">
          <span class="nc-benefit-num">{i + 1}</span>
          <div>
            <h3>{b.title}</h3>
            <p>{b.body}</p>
          </div>
        </article>
      ))}
    </div>
    <a class="nc-cta nc-cta--brass" href={chamber.emailHref}>Email to join</a>
    <p class="nc-page-meta">
      {chamber.email} · <a class="nc-link" href={chamber.phoneHref}>{chamber.phone}</a> · {chamber.address}
    </p>
  </main>
</ChamberConceptShell>
