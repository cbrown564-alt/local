---
import ChamberConceptShell from "../../../components/chamber-prototypes/ChamberConceptShell.astro";
import { events } from "../../../data/chamber-prototype";
---
<ChamberConceptShell
  title="Events — Newcastle Chamber of Commerce · Co. Down"
  current="events"
  disclosure="Sample dates are illustrative."
>
  <main class="nc-page">
    <p class="nc-kicker">Town calendar</p>
    <h1>What's on in <em>Newcastle.</em></h1>
    <p class="nc-lede">
      Nights the Chamber helps put on — starting with Halloween, with room for more as dates firm up.
    </p>
    <div class="nc-event-list">
      {events.map((event) => (
        <article class="nc-event-row">
          <time datetime={event.real ? event.dateSort : undefined}>{event.date}</time>
          <div>
            <h2>{event.title}</h2>
            <p>{event.blurb}</p>
            <p class="nc-event-place">{event.place}</p>
            {!event.real && <span class="nc-badge">Sample date</span>}
          </div>
          <a class="nc-cta" href={event.ctaHref}>{event.ctaLabel}</a>
        </article>
      ))}
    </div>
  </main>
</ChamberConceptShell>
