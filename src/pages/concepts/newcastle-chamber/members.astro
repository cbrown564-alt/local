---
import ChamberConceptShell from "../../../components/chamber-prototypes/ChamberConceptShell.astro";
import { chamber, categories, members } from "../../../data/chamber-prototype";

const base = "/concepts/newcastle-chamber";
---
<ChamberConceptShell
  title="Member Directory — Newcastle Chamber of Commerce · Co. Down"
  current="members"
  disclosure="Member list is illustrative."
>
  <main class="nc-dir" id="main">
    <div class="nc-dir-head">
      <div class="nc-dir-head-text">
        <p class="nc-kicker">Member directory · Newcastle</p>
        <h1>Example Main Street listings, <em>in one place.</em></h1>
        <p class="nc-dir-intro">
          This illustrative list demonstrates the directory experience; it does
          not identify verified Chamber members. A live version would contain
          committee-owned membership data. <a href={`${base}/join/`}>Ask to be
          listed</a>, or <a href={chamber.emailHref}>email the Chamber</a>.
        </p>
        <p class="nc-dir-search-status" data-nc-search-status role="status" hidden></p>
      </div>
      <nav class="nc-dir-tabs" aria-label="Jump to category">
        <a class="nc-dir-tab nc-dir-tab--active" href="#all">All</a>
        {categories.map((cat) => (
          <a class="nc-dir-tab" href={`#${cat.id}`}>
            <span class="nc-tab-full">{cat.label}</span>
            <span class="nc-tab-short">{cat.shortLabel}</span>
          </a>
        ))}
      </nav>
    </div>

    <div class="nc-dir-body" id="all">
      {categories.map((cat) => (
        <section class="nc-dir-category" id={cat.id}>
          <h2 class="nc-dir-cat-label">{cat.label}</h2>
          <ul class="nc-dir-grid" role="list">
            {members.filter((m) => m.category === cat.id).map((member) => (
              <li
                class="nc-dir-card"
                data-nc-member
                data-search-text={`${member.name} ${member.trade} ${member.note}`.toLowerCase()}
              >
                <p class="nc-dir-card-name">{member.name}</p>
                <p class="nc-dir-card-trade">{member.trade}</p>
                <p class="nc-dir-card-note">{member.note}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p class="nc-dir-empty" data-nc-empty hidden>
        No illustrative listings match that search. Try a trade such as café,
        pharmacy, hotel or gifts.
      </p>
    </div>

    <div class="nc-dir-join">
      <div class="nc-dir-join-inner">
        <p class="nc-dir-join-kicker">Not listed yet?</p>
        <h2>Join the Chamber and <em>get your business found.</em></h2>
        <p>Write to the volunteer inbox and the committee will be in touch.</p>
        <div class="nc-actions">
          <a class="nc-cta" href={`${base}/join/`}>Why join</a>
          <a class="nc-link" href={chamber.facebook}>Follow on Facebook →</a>
        </div>
      </div>
    </div>
  </main>
</ChamberConceptShell>

<script>
  const query = new URLSearchParams(window.location.search).get("q")?.trim() ?? "";
  const normalised = query.toLocaleLowerCase("en-GB");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-nc-member]")];
  const categories = [...document.querySelectorAll<HTMLElement>(".nc-dir-category")];
  const status = document.querySelector<HTMLElement>("[data-nc-search-status]");
  const empty = document.querySelector<HTMLElement>("[data-nc-empty]");

  if (normalised) {
    let visibleCount = 0;
    for (const card of cards) {
      const matches = card.dataset.searchText?.includes(normalised) ?? false;
      card.hidden = !matches;
      if (matches) visibleCount += 1;
    }
    for (const category of categories) {
      category.hidden = !category.querySelector("[data-nc-member]:not([hidden])");
    }
    if (status) {
      status.hidden = false;
      status.textContent = visibleCount === 1
        ? `1 illustrative listing for “${query}”.`
        : `${visibleCount} illustrative listings for “${query}”.`;
    }
    if (empty) empty.hidden = visibleCount !== 0;
  }
</script>
