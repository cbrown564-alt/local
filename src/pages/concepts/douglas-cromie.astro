---
import "../../styles/global.css";
import "../../styles/concept-douglas-cromie.css";
import ConceptLayout from "../../layouts/ConceptLayout.astro";

const marketplaceHref =
  "https://www.usedcarsni.com/search_results.php?dealer=26586938&search_type=1";
---

<ConceptLayout
  title={"Douglas & Cromie — independent concept"}
  slug="douglas-cromie"
  bodyClass="concept-page concept-dc"
  businessName="Douglas and Cromie"
  town="Newcastle"
  bannerNote="Identity, wording and photography are preserved from the dealer's archived public homepage."
>
  <div class="dc-strip">
    <span>Bryansford Service Station · 23 Bryansford Village · Newcastle</span>
    <span class="dc-strip-r">
      <span>Mon–Fri 08:00–18:00 · Sat 09:00–13:00</span>
      <a href="tel:+442843722382">028 4372 2382</a>
    </span>
  </div>

  <header class="dc-header">
    <a class="dc-brand" href="/concepts/douglas-cromie/" aria-label="Douglas and Cromie home">
      <img
        src="/images/douglas-cromie-logo.png"
        width="640"
        height="100"
        alt="Douglas and Cromie — New and Used Car Sales"
      />
    </a>
    <nav class="dc-nav" aria-label="Concept navigation">
      <a href="#why-us">Why us</a>
      <a href="#services">Workshop</a>
      <a href="#visit">Find us</a>
    </nav>
    <a class="dc-stock" href={marketplaceHref} rel="external">
      Check current vehicles
    </a>
  </header>

  <main>
    <section class="dc-hero" aria-labelledby="dc-title">
      <div class="dc-hero-copy">
        <p class="dc-kicker">New &amp; used car sales · MOT preparation · servicing</p>
        <h1 id="dc-title">Drive away<br />with confidence.</h1>
        <p class="dc-intro">
          Backed by 50 years in the business, our experienced staff are always
          on hand to help — before you buy and after you leave the forecourt.
        </p>
        <div class="dc-actions">
          <a class="dc-call" href="tel:+442843722382">Call 028 4372 2382</a>
          <a class="dc-directions" href="#visit">Get directions <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <figure class="dc-hero-image">
        <img
          src="/images/douglas-cromie-forecourt.jpg"
          width="1280"
          height="480"
          alt="Blue, red and yellow cars lined up on a forecourt"
        />
        <figcaption>Douglas &amp; Cromie homepage photography</figcaption>
      </figure>
    </section>

    <section class="dc-proof" id="why-us" aria-label="Why choose Douglas and Cromie">
      <p class="dc-proof-number">50</p>
      <p class="dc-proof-label">years in the business</p>
      <p class="dc-proof-copy">
        We pride ourselves on excellent after-sales care. You receive the same
        attention whether you are buying a new or used vehicle.
      </p>
    </section>

    <section class="dc-service-row" id="services" aria-label="Garage services">
      <p>New &amp; used car sales</p>
      <p>MOT preparation</p>
      <p>Servicing all makes</p>
      <p>Parts sales</p>
    </section>

    <section class="dc-visit" id="visit">
      <div>
        <p class="dc-visit-label">Visit the garage</p>
        <h2>Bryansford Service Station</h2>
        <p>23 Bryansford Village<br />Newcastle, Co. Down<br />BT33 0PT</p>
      </div>
      <div class="dc-hours">
        <p><span>Monday–Friday</span><strong>08:00–18:00</strong></p>
        <p><span>Saturday</span><strong>09:00–13:00</strong></p>
        <p><span>Sunday</span><strong>Closed</strong></p>
      </div>
      <a
        class="dc-map"
        href="https://www.google.com/maps/search/?api=1&query=Douglas%20and%20Cromie%2C%2023%20Bryansford%20Village%2C%20Newcastle%2C%20BT33%200PT"
        rel="external"
      >
        Open in maps <span aria-hidden="true">↗</span>
      </a>
    </section>
  </main>
</ConceptLayout>
