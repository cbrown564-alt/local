---
import "../../styles/global.css";
import "../../styles/concept-castle-farm.css";
import ConceptLayout from "../../layouts/ConceptLayout.astro";
---

<ConceptLayout title={"Castle Farm — independent concept"} slug="castle-farm" bodyClass="concept-page concept-castle-farm" lang="en-GB">
<header class="concept-header">
      <div class="concept-logo">Castle Farm <span>Dundrum · County Down</span></div>
      <nav class="concept-nav" aria-label="Concept navigation"><a href="#" data-concept-placeholder>Weekly boxes</a><a href="#" data-concept-placeholder>Fruit &amp; veg</a><a href="#" data-concept-placeholder>Meat</a><a href="#" data-concept-placeholder>Our farm</a></nav>
      <a class="concept-basket" href="#" data-concept-placeholder>Basket · 0</a>
    </header>
    <main>
      <section class="farm-hero">
        <div class="farm-hero-copy">
          <p class="farm-kicker">Fresh from Dundrum</p>
          <h1>This week's shop, sorted.</h1>
          <p>Local produce, family favourites and ready-planned boxes — collected from Castle Farm or delivered nearby.</p>
          <a class="farm-button" href="#" data-concept-placeholder>Shop this week's produce →</a>
        </div>
        <section class="farm-box-builder" aria-labelledby="farm-box-heading">
          <div class="farm-box-head">
            <span>This week at Castle Farm</span>
            <span>Dundrum · collect or deliver</span>
          </div>
          <div class="farm-box-body">
            <p class="farm-box-kicker">A simpler weekly shop</p>
            <h2 id="farm-box-heading">Build a box around your week.</h2>
            <ol class="farm-box-steps">
              <li><span>1</span><p><strong>Choose a box</strong><small>Start with a useful size for your household.</small></p></li>
              <li><span>2</span><p><strong>Add the staples</strong><small>Fruit and veg, meat, eggs and family favourites.</small></p></li>
              <li><span>3</span><p><strong>Collect or deliver</strong><small>Keep the last step visible before checkout.</small></p></li>
            </ol>
          </div>
          <a class="farm-box-action" href="#" data-concept-placeholder>
            <span>Start this week’s box</span><span aria-hidden="true">→</span>
          </a>
          <p class="farm-box-note">Concept journey — farm-supplied contents, prices and availability.</p>
        </section>
      </section>
      <section class="farm-proof" aria-label="Service highlights">
        <div><strong>Dundrum-grown</strong><span>Produce with a clear local story</span></div>
        <div><strong>Weekly boxes</strong><span>A simpler way to plan the shop</span></div>
        <div><strong>Collect or deliver</strong><span>The next step stays visible</span></div>
      </section>
    </main>
</ConceptLayout>
