---
import "../../styles/global.css";
import "../../styles/concept-castle-farm.css";
import ConceptLayout from "../../layouts/ConceptLayout.astro";
---

<ConceptLayout title={"Castle Farm — independent concept"} slug="castle-farm" bodyClass="concept-page concept-castle-farm" lang="en-GB">
<header class="concept-header">
      <div class="concept-logo">
        <span class="farm-wordmark"><img src="/images/castle-farm-produce.jpg" alt="Castle Farm" /></span>
        <span>Dundrum · County Down</span>
      </div>
      <nav class="concept-nav" aria-label="Concept navigation"><a href="#" data-concept-placeholder>Box deals</a><a href="#" data-concept-placeholder>Fruit &amp; veg</a><a href="#" data-concept-placeholder>Butchery</a><a href="#" data-concept-placeholder>Groceries</a></nav>
      <a class="concept-basket" href="#" data-concept-placeholder>Basket · 0</a>
    </header>
    <main>
      <section class="farm-hero">
        <div class="farm-hero-copy">
          <p class="farm-kicker">The weekly shop, from Dundrum</p>
          <h1>This week's shop, sorted.</h1>
          <p>Fruit and veg, butchery and grocery favourites, with produce boxes ready to collect or deliver across Northern Ireland.</p>
          <a class="farm-button" href="#" data-concept-placeholder>Choose a produce box <span aria-hidden="true">→</span></a>
          <ol class="farm-steps" aria-label="How the weekly box journey works">
            <li><span>1</span><strong>Choose a box</strong></li>
            <li><span>2</span><strong>Add the staples</strong></li>
            <li><span>3</span><strong>Collect or deliver</strong></li>
          </ol>
        </div>
        <figure class="farm-produce">
          <img src="/images/castle-farm-weekly-box-faithful.webp" alt="Faithful visualisation of Castle Farm's mixed weekly box, with vegetables, eggs, chicken and butcher items in a navy crate" />
          <figcaption>Faithful visualisation based on Castle Farm’s published mixed-box photograph.</figcaption>
          <div class="farm-box-action">
            <div>
              <span>Build around your week</span>
              <strong>Start with a box. Add what your household needs.</strong>
            </div>
            <a href="#" data-concept-placeholder aria-label="Start this week's box">Start a box <span aria-hidden="true">→</span></a>
          </div>
        </figure>
      </section>
      <section class="farm-proof" aria-label="Service highlights">
        <div><strong>Dundrum farm shop</strong><span>The real identity leads from the first screen</span></div>
        <div><strong>Produce box first</strong><span>A quicker route into the weekly shop</span></div>
        <div><strong>Collection or NI delivery</strong><span>Fulfilment stays clear before checkout</span></div>
      </section>
    </main>
</ConceptLayout>
