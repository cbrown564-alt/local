---
import "../../styles/global.css";
import "../../styles/concept-tonn-ruray.css";
import ConceptLayout from "../../layouts/ConceptLayout.astro";

// The apartment side of tonnruray.com is well built; the café is the failing
// half — second billing, a JUN24 menu PDF, no booking. This concept gives the
// café its own front door and leaves the apartments alone.
const service = [
  { time: "Morning", from: "9.00", detail: "Filter, pastries, the good porridge" },
  { time: "Brunch", from: "11.00", detail: "Bowls, eggs, the JUN24 menu made live" },
  { time: "Afternoon", from: "14.00", detail: "Cake, single-origin, a window seat" },
];
---

<ConceptLayout
  title={"Tonn Ruray Café — independent concept"}
  slug="tonn-ruray"
  bodyClass="concept-page concept-tonn"
  businessName="Tonn Ruray Café"
  town="Dundrum"
  bannerNote="Addresses the café only — the site's luxury-apartment side is left as it is."
>
  <div class="tr-strip">
    <span>61 Main Street, Dundrum · on Dundrum Bay</span>
    <span class="tr-strip-x">
      <a href="#" data-concept-placeholder>The café</a>
      <a href="https://www.tonnruray.com/" class="tr-strip-alt">Apartments →</a>
    </span>
  </div>

  <header class="tr-header">
    <a class="tr-brand" href="/concepts/tonn-ruray/">
      <span class="tr-brand-mark" aria-hidden="true">
        <svg width="34" height="20" viewBox="0 0 34 20" fill="none">
          <path d="M1 13 Q 6 4 11 11 T 21 11 T 33 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </span>
      <span class="tr-brand-text">
        <span class="tr-brand-name">Tonn Ruray</span>
        <span class="tr-brand-sub">Caife · the café</span>
      </span>
    </a>
    <nav class="tr-nav" aria-label="Concept navigation">
      <a href="#" data-concept-placeholder>Menu</a><a href="#" data-concept-placeholder>Mornings</a><a href="#" data-concept-placeholder>Find us</a>
    </nav>
    <a class="tr-book" href="#" data-concept-placeholder>Hold a table</a>
  </header>

  <main class="tr-main">
    <section class="tr-hero">
      <p class="tr-kicker">Wave of Ruray · a café on the bay</p>
      <h1>
        <span>Coffee</span>
        <span class="tr-hero-em">is a lot more</span>
        <span>than just a drink.</span>
      </h1>
      <p class="tr-lede">
        Gertrude Stein said it; we agree. Reconnect with yourself over the good stuff,
        looking out at the tide — the same view the apartments upstairs charge for,
        yours for the price of a flat white.
      </p>
      <div class="tr-hero-actions">
        <a class="tr-cta" href="#" data-concept-placeholder>See today's menu</a>
        <a class="tr-link" href="#" data-concept-placeholder>Hold a table for brunch →</a>
      </div>
      <p class="tr-note">
        The current site's café menu is a PDF stamped <strong>JUN24</strong>. This concept
        replaces it with a menu that changes when the counter does.
      </p>
    </section>

    <aside class="tr-service" aria-label="Through the day">
      <h2>Through the day</h2>
      <ol class="tr-timeline">
        {service.map((slot) => (
          <li class="tr-slot">
            <span class="tr-slot-from">{slot.from}</span>
            <span class="tr-slot-body">
              <span class="tr-slot-time">{slot.time}</span>
              <span class="tr-slot-detail">{slot.detail}</span>
            </span>
          </li>
        ))}
      </ol>
      <div class="tr-tideline" aria-hidden="true">
        <svg viewBox="0 0 260 60" preserveAspectRatio="none">
          <path d="M0 40 Q 32 18 64 34 T 130 34 T 196 22 T 260 36" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M0 50 Q 40 34 80 46 T 168 44 T 260 48" fill="none" stroke="currentColor" stroke-width="1" opacity=".5" />
        </svg>
      </div>
      <p class="tr-service-foot">A home from home, on the main street.</p>
    </aside>
  </main>
</ConceptLayout>
