---
import "../../styles/global.css";
import "../../styles/concept-mourne-cycles.css";
import ConceptLayout from "../../layouts/ConceptLayout.astro";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
---

<ConceptLayout title={"Mourne Cycles — independent concept"} slug="mourne-cycles" bodyClass="concept-page concept-mourne-cycles" lang="en-GB">
<div class="mc-strip">
      <span>Est. 2002 · Trek main dealer for the area</span>
      <span>63A Castlewellan Road, Newcastle · <a href="tel:+442843727272">028 4372 7272</a></span>
    </div>
    <header class="mc-header">
      <a class="mc-brand" href="#">
        <svg class="mc-peaks" width="44" height="26" viewBox="0 0 44 26" fill="none" aria-hidden="true">
          <path d="M1 25 L13 6 L19 14 L27 1 L43 25" stroke="#0f1013" stroke-width="2.4" stroke-linejoin="round" />
          <path d="M23.5 6.5 L27 1 L30.5 6.5" stroke="#d7282f" stroke-width="2.4" stroke-linejoin="round" />
        </svg>
        <span class="mc-brand-text">
          <span class="mc-brand-name">Mourne<span>&nbsp;Cycles</span></span>
          <span class="mc-brand-sub">Newcastle · County Down</span>
        </span>
      </a>
      <nav class="mc-nav" aria-label="Concept navigation">
        <a href="#" aria-current="page">Bikes</a><a href="#">Accessories</a><a href="/concepts/mourne-cycles/hire/">Workshop</a><a href="/concepts/mourne-cycles/hire/">Cycle to Work</a><a href="#">Visit us</a>
      </nav>
      <div class="mc-header-actions">
        <a class="mc-phone" href="tel:+442843727272">028 4372 7272</a>
        <a class="mc-book" href="/concepts/mourne-cycles/hire/">Book a service</a>
      </div>
    </header>
    <main class="mc-hero">
      <section class="mc-story">
        <p class="mc-kicker">The local bike shop, since 2002</p>
        <h1>Ride <em>with us.</em></h1>
        <p class="mc-lede">
          One of Northern Ireland's premier local bike shops and the area's
          main <strong>Trek</strong> dealer — with Shimano, SRAM and Bontrager on
          the shelves and a workshop that keeps every bike rolling.
        </p>
        <div class="mc-actions">
          <a class="mc-cta" href="#">Browse the bikes</a>
          <a class="mc-link" href="/concepts/mourne-cycles/hire/">Book a workshop slot →</a>
        </div>
      </section>
      <figure class="mc-visual">
        <ResponsiveImage pictureClass="concept-responsive-picture" src="/images/mourne-cycles-trail.jpg" alt="A mountain biker descends a rocky trail on a Trek full-suspension bike" width="1100" height="1344" loading="eager" />
        <figcaption>Trek — from the range in store</figcaption>
        <div class="mc-product">
          <ResponsiveImage pictureClass="concept-responsive-picture" src="/images/mourne-cycles-ebike.jpg" alt="A silver Trek step-through electric bike with a rear rack battery" width="700" height="525" />
          <span class="mc-product-tag">Electric</span>
          <p>Trek e-bikes in the showroom — come in for a test ride.</p>
        </div>
      </figure>
      <nav class="mc-rail" aria-label="Bike range">
        <a class="mc-cell" href="#"><span class="mc-cell-index">01</span><span class="mc-cell-name">Electric</span></a>
        <a class="mc-cell" href="#"><span class="mc-cell-index">02</span><span class="mc-cell-name">Road</span></a>
        <a class="mc-cell" href="#"><span class="mc-cell-index">03</span><span class="mc-cell-name">Mountain</span></a>
        <a class="mc-cell" href="#"><span class="mc-cell-index">04</span><span class="mc-cell-name">Hybrid</span></a>
        <a class="mc-cell" href="#"><span class="mc-cell-index">05</span><span class="mc-cell-name">Kids</span></a>
        <a class="mc-cell mc-cell-scheme" href="/concepts/mourne-cycles/hire/">
          <span class="mc-cell-index">Cycle to Work</span>
          <span class="mc-cell-name">Save through work</span>
          <small>Cyclescheme &amp; Green Commute Initiative accepted</small>
        </a>
      </nav>
    </main>
</ConceptLayout>
