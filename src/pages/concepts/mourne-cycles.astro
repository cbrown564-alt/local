---
import "../../styles/global.css";
import "../../styles/concept-mourne-cycles.css";
import ConceptLayout from "../../layouts/ConceptLayout.astro";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
---

<ConceptLayout title={"Mourne Cycles — independent concept"} slug="mourne-cycles" bodyClass="concept-page concept-mourne-cycles" lang="en-GB">
<div class="mc-strip">
      <span>Est. 2002 · listed Trek dealer &amp; Cyclescheme retailer</span>
      <span>63A Castlewellan Road, Newcastle · <a href="tel:+442843727272">028 4372 7272</a></span>
    </div>
    <header class="mc-header">
      <a class="mc-brand" href="/concepts/mourne-cycles/">
        <svg class="mc-peaks" width="44" height="26" viewBox="0 0 44 26" fill="none" aria-hidden="true">
          <path d="M1 25 L13 6 L19 14 L27 1 L43 25" stroke="#0f1013" stroke-width="2.4" stroke-linejoin="round" />
          <path d="M23.5 6.5 L27 1 L30.5 6.5" stroke="#d7282f" stroke-width="2.4" stroke-linejoin="round" />
        </svg>
        <span class="mc-brand-text">
          <span class="mc-brand-name">Mourne<span>&nbsp;Cycles</span></span>
          <span class="mc-brand-sub">Newcastle · County Down</span>
        </span>
      </a>
      <nav class="mc-nav" aria-label="Concept navigation">
        <a href="/concepts/mourne-cycles/" aria-current="page">Bikes</a><a href="#" data-concept-placeholder>Accessories</a><a href="/concepts/mourne-cycles/hire/">Workshop</a><a href="/concepts/mourne-cycles/hire/">Cycle to Work</a><a href="#" data-concept-placeholder>Visit us</a>
      </nav>
      <div class="mc-header-actions">
        <a class="mc-phone" href="tel:+442843727272">028 4372 7272</a>
        <a class="mc-book" href="/concepts/mourne-cycles/hire/">Book a service</a>
      </div>
    </header>
    <main class="mc-hero">
      <section class="mc-story">
        <p class="mc-kicker">Newcastle · local since 2002</p>
        <h1>Mourne <em>Cycles</em></h1>
        <p class="mc-thesis">Bikes, workshop care and straight local advice.</p>
        <p class="mc-lede">
          An established local bike shop, listed as a <strong>Trek</strong>
          dealer and Cyclescheme retailer, with a workshop on Castlewellan Road.
        </p>
        <div class="mc-actions">
          <a class="mc-cta" href="/concepts/mourne-cycles/hire/">Book a workshop slot</a>
          <a class="mc-link" href="#" data-concept-placeholder>Explore the bike range →</a>
        </div>
      </section>
      <figure class="mc-visual">
        <div class="mc-visual-image">
          <ResponsiveImage
            pictureClass="mc-visual-picture"
            src="/images/mourne-cycles-faithful-visualisation.jpg"
            alt="Faithful visualisation of a black Trek full-suspension mountain bike against a red slatted fence beside a blue bin marked 48, based on a customer photograph"
            width="1536"
            height="1024"
            loading="eager"
            sizes="(max-width: 940px) 100vw, 54vw"
          />
        </div>
        <figcaption>
          AI-generated visualisation, faithfully based on an April 2026
          Mourne Cycles customer photo. It does not claim current shop stock.
        </figcaption>
      </figure>
      <nav class="mc-rail" aria-label="Bike range">
        <a class="mc-cell" href="#" data-concept-placeholder><span class="mc-cell-index">01</span><span class="mc-cell-name">Electric</span></a>
        <a class="mc-cell" href="#" data-concept-placeholder><span class="mc-cell-index">02</span><span class="mc-cell-name">Road</span></a>
        <a class="mc-cell" href="#" data-concept-placeholder><span class="mc-cell-index">03</span><span class="mc-cell-name">Mountain</span></a>
        <a class="mc-cell" href="#" data-concept-placeholder><span class="mc-cell-index">04</span><span class="mc-cell-name">Hybrid</span></a>
        <a class="mc-cell" href="#" data-concept-placeholder><span class="mc-cell-index">05</span><span class="mc-cell-name">Kids</span></a>
        <a class="mc-cell mc-cell-scheme" href="/concepts/mourne-cycles/hire/">
          <span class="mc-cell-index">Cycle to Work</span>
          <span class="mc-cell-name">Save through work</span>
          <small>Listed Cyclescheme retailer</small>
        </a>
      </nav>
    </main>
</ConceptLayout>
