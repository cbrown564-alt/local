---
import "../../styles/global.css";
import "../../styles/concept-kent-amusements.css";
const instagram = "https://www.instagram.com/kentamusementsnewcastle/";
const facebook = "https://www.facebook.com/kentamusementsnewcastle/";
const phone = "028 4372 2515";
const phoneHref = "tel:+442843722515";
import ConceptLayout from "../../layouts/ConceptLayout.astro";
---

<ConceptLayout title={"Kent Amusements — independent concept"} slug="kent-amusements" bodyClass="concept-page concept-kent" lang="en-GB">
<div class="ka-strip">
      <span><strong>77–79 Central Promenade</strong> · Newcastle, Co. Down</span>
      <span>Seasonal hours on <a href={facebook}>Facebook</a></span>
    </div>
    <header class="ka-header">
      <a class="ka-brand" href="/concepts/kent-amusements/">
        <svg class="ka-mark" width="42" height="42" viewBox="0 0 42 42" fill="none" aria-hidden="true">
          <rect x="1.5" y="1.5" width="39" height="39" rx="4" stroke="currentColor" stroke-width="2.2" />
          <path d="M8 28 V14 H14.5 C17.8 14 20 16 20 18.8 C20 21.6 17.8 23.6 14.5 23.6 H11.2 V28 Z M11.2 20.6 H14.2 C15.7 20.6 16.7 19.7 16.7 18.8 C16.7 17.9 15.7 17 14.2 17 H11.2 Z" fill="currentColor" />
          <circle cx="29.5" cy="18" r="5.2" stroke="currentColor" stroke-width="2.2" />
          <path d="M26.2 28 L29.5 21.2 L32.8 28" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="29.5" cy="18" r="1.6" fill="currentColor" />
        </svg>
        <span class="ka-brand-text">
          <span class="ka-brand-name">Kent Amusements</span>
          <span class="ka-brand-sub">Central Promenade · Newcastle</span>
        </span>
      </a>
      <nav class="ka-nav" aria-label="Concept navigation">
        <a href="/concepts/kent-amusements/attractions/">Attractions</a><a href="/concepts/kent-amusements/attractions/">Hours</a><a href="/concepts/kent-amusements/attractions/">Family offers</a><a href={facebook}>Find us</a>
      </nav>
      <a class="ka-call" href={phoneHref}>Call {phone}</a>
    </header>
    <main class="ka-hero">
      <section class="ka-story">
        <p class="ka-kicker">Central Promenade · Newcastle</p>
        <h1>Kent <em>Amusements</em></h1>
        <p class="ka-thesis">Fifty summers of seaside fun.</p>
        <p class="ka-lede">
          Dodgems, arcade games and new VR — Kent Amusements is the seaside
          attraction families have been coming back to for over fifty years,
          right on Newcastle’s Central Promenade.
        </p>
        <div class="ka-actions">
          <a class="ka-cta" href={facebook}>See today’s hours</a>
          <a class="ka-link" href={instagram}>Follow @kentamusementsnewcastle →</a>
        </div>
      </section>
      <section class="ka-now-board" aria-labelledby="ka-now-heading">
        <div class="ka-now-head">
          <span>Inside Kent Amusements</span>
          <span>Central Promenade · Newcastle</span>
        </div>
        <div class="ka-now-body">
          <p class="ka-now-kicker">Pick your fun</p>
          <h2 id="ka-now-heading">What are you here for?</h2>
          <div class="ka-now-attractions">
            <a href="/concepts/kent-amusements/attractions/"><span>01</span><strong>Dodgems</strong><small>Indoor bumper cars</small><b aria-hidden="true">→</b></a>
            <a href="/concepts/kent-amusements/attractions/"><span>02</span><strong>VR games</strong><small>New for 2026</small><b aria-hidden="true">→</b></a>
            <a href="/concepts/kent-amusements/attractions/"><span>03</span><strong>Arcade</strong><small>Machines for all ages</small><b aria-hidden="true">→</b></a>
          </div>
        </div>
        <div class="ka-now-hours">
          <span><strong>Open today?</strong> Hours change with the season.</span>
          <a href={facebook}>Check Facebook <span aria-hidden="true">→</span></a>
        </div>
      </section>
      <nav class="ka-rail" aria-label="Attractions and contact">
        <a class="ka-rail-cell" href="/concepts/kent-amusements/attractions/"><span class="ka-ride">Dodgems</span><span class="ka-ride-note">Indoor bumper cars</span></a>
        <a class="ka-rail-cell" href="/concepts/kent-amusements/attractions/"><span class="ka-ride">VR games</span><span class="ka-ride-note">New for 2026</span></a>
        <a class="ka-rail-cell" href="/concepts/kent-amusements/attractions/"><span class="ka-ride">Arcade</span><span class="ka-ride-note">Machines for all ages</span></a>
        <a class="ka-rail-cell" href={phoneHref}><span class="ka-ride">Call us</span><span class="ka-ride-note">{phone} →</span></a>
      </nav>
    </main>
</ConceptLayout>
