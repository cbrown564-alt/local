---
import "../../styles/global.css";
import "../../styles/concept-kent-amusements.css";
const instagram = "https://www.instagram.com/kentamusementsnewcastle/";
const facebook = "https://www.facebook.com/kentamusementsnewcastle/";
const phone = "028 4372 2515";
const phoneHref = "tel:+442843722515";
import ConceptLayout from "../../layouts/ConceptLayout.astro";
---

<ConceptLayout title={"Kent Amusements — independent concept"} slug="kent-amusements" bodyClass="concept-page concept-kent" lang="en-GB">
<div class="ka-strip">
      <span><strong>77–79 Central Promenade</strong> · Newcastle, Co. Down</span>
      <span>Seasonal hours on <a href={facebook}>Facebook</a></span>
    </div>
    <header class="ka-header">
      <a class="ka-brand" href="/concepts/kent-amusements/">
        <svg class="ka-mark" width="42" height="42" viewBox="0 0 42 42" fill="none" aria-hidden="true">
          <rect x="1.5" y="1.5" width="39" height="39" rx="4" stroke="currentColor" stroke-width="2.2" />
          <path d="M8 28 V14 H14.5 C17.8 14 20 16 20 18.8 C20 21.6 17.8 23.6 14.5 23.6 H11.2 V28 Z M11.2 20.6 H14.2 C15.7 20.6 16.7 19.7 16.7 18.8 C16.7 17.9 15.7 17 14.2 17 H11.2 Z" fill="currentColor" />
          <circle cx="29.5" cy="18" r="5.2" stroke="currentColor" stroke-width="2.2" />
          <path d="M26.2 28 L29.5 21.2 L32.8 28" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="29.5" cy="18" r="1.6" fill="currentColor" />
        </svg>
        <span class="ka-brand-text">
          <span class="ka-brand-name">Kent Amusements</span>
          <span class="ka-brand-sub">Central Promenade · Newcastle</span>
        </span>
      </a>
      <nav class="ka-nav" aria-label="Concept navigation">
        <a href="/concepts/kent-amusements/attractions/">Attractions</a><a href="/concepts/kent-amusements/attractions/">Hours</a><a href="/concepts/kent-amusements/attractions/">Family offers</a><a href={facebook}>Find us</a>
      </nav>
      <a class="ka-call" href={phoneHref}>Call {phone}</a>
    </header>
    <main class="ka-hero">
      <section class="ka-story">
        <p class="ka-kicker">Family arcade · since the sixties</p>
        <h1>Fifty summers of fun on the <em>Central Promenade</em>.</h1>
        <p class="ka-lede">
          Dodgems, arcade games and new VR — Kent Amusements is the seaside
          attraction families have been coming back to for over fifty years,
          right on Newcastle’s Central Promenade.
        </p>
        <div class="ka-actions">
          <a class="ka-cta" href={facebook}>See today’s hours</a>
          <a class="ka-link" href={instagram}>Follow @kentamusementsnewcastle →</a>
        </div>
      </section>
      <aside class="ka-panel">
        <p class="ka-visual-note">
          Illustrated concept scene — real arcade photography is still required
          as subject proof.
        </p>
        <div class="ka-stage" aria-hidden="true">
          <svg class="ka-pier" viewBox="0 90 480 340" fill="none" preserveAspectRatio="xMidYMid meet">
            <defs>
              <linearGradient id="ka-sky" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#1a3a5c" />
                <stop offset="50%" stop-color="#2a5578" />
                <stop offset="100%" stop-color="#3d6f8f" />
              </linearGradient>
              <linearGradient id="ka-glow" x1="0.5" y1="0" x2="0.5" y2="1">
                <stop offset="0%" stop-color="#f0b429" stop-opacity="0.5" />
                <stop offset="100%" stop-color="#f0b429" stop-opacity="0" />
              </linearGradient>
            </defs>
            <rect y="90" width="480" height="340" fill="url(#ka-sky)" />
            <ellipse cx="240" cy="110" rx="110" ry="36" fill="url(#ka-glow)" />
            <path d="M0 360 H480 V430 H0 Z" fill="#0e1c2e" />
            <path d="M0 360 H480" stroke="#e8a317" stroke-width="4" />
            <g stroke="#1a3148" stroke-width="2">
              <line x1="40" y1="372" x2="40" y2="420" /><line x1="90" y1="372" x2="90" y2="420" />
              <line x1="140" y1="372" x2="140" y2="420" /><line x1="190" y1="372" x2="190" y2="420" />
              <line x1="240" y1="372" x2="240" y2="420" /><line x1="290" y1="372" x2="290" y2="420" />
              <line x1="340" y1="372" x2="340" y2="420" /><line x1="390" y1="372" x2="390" y2="420" />
              <line x1="440" y1="372" x2="440" y2="420" />
            </g>
            <rect x="56" y="168" width="368" height="160" rx="6" fill="#0b1726" />
            <path d="M44 168 H436 L412 118 H68 Z" fill="#e85a4f" />
            <path d="M68 118 H412" stroke="#f0b429" stroke-width="5" />
            <g class="ka-bulbs" fill="#f0b429">
              <circle cx="92" cy="140" r="5" /><circle cx="128" cy="140" r="5" /><circle cx="164" cy="140" r="5" />
              <circle cx="200" cy="140" r="5" /><circle cx="236" cy="140" r="5" /><circle cx="272" cy="140" r="5" />
              <circle cx="308" cy="140" r="5" /><circle cx="344" cy="140" r="5" /><circle cx="380" cy="140" r="5" />
            </g>
            <text x="240" y="232" text-anchor="middle" fill="#f7fbfc" font-family="Teko, sans-serif" font-size="68" font-weight="700" letter-spacing="6">KENT</text>
            <text x="240" y="286" text-anchor="middle" fill="#f0b429" font-family="Teko, sans-serif" font-size="36" font-weight="600" letter-spacing="8">AMUSEMENTS</text>
            <ellipse cx="140" cy="348" rx="48" ry="14" fill="#1e3a55" />
            <rect x="108" y="322" width="64" height="26" rx="10" fill="#e85a4f" />
            <circle cx="124" cy="350" r="8" fill="#f0b429" /><circle cx="156" cy="350" r="8" fill="#f0b429" />
            <ellipse cx="340" cy="348" rx="48" ry="14" fill="#1e3a55" />
            <rect x="308" y="322" width="64" height="26" rx="10" fill="#3db8a8" />
            <circle cx="324" cy="350" r="8" fill="#f0b429" /><circle cx="356" cy="350" r="8" fill="#f0b429" />
          </svg>
        </div>
        <article class="ka-ticket">
          <p class="ka-ticket-kicker">Proposed on a first page</p>
          <h2>Hours &amp; seasonal updates.</h2>
          <ul class="ka-offer">
            <li><span class="ka-offer-label">Opening hours</span><span class="ka-offer-val">Check Facebook for today</span></li>
            <li><span class="ka-offer-label">Family offers</span><span class="ka-offer-val">Proposed slot for seasonal updates</span></li>
            <li><span class="ka-offer-label">Find us</span><span class="ka-offer-val">77–79 Central Promenade</span></li>
          </ul>
          <a class="ka-ticket-cta" href={facebook}>Check Facebook for today →</a>
          <small>Hours live on the Facebook page the arcade already updates — offers only when they post them</small>
        </article>
      </aside>
      <nav class="ka-rail" aria-label="Attractions and contact">
        <a class="ka-rail-cell" href="/concepts/kent-amusements/attractions/"><span class="ka-ride">Dodgems</span><span class="ka-ride-note">Indoor bumper cars</span></a>
        <a class="ka-rail-cell" href="/concepts/kent-amusements/attractions/"><span class="ka-ride">VR games</span><span class="ka-ride-note">New for 2026</span></a>
        <a class="ka-rail-cell" href="/concepts/kent-amusements/attractions/"><span class="ka-ride">Arcade</span><span class="ka-ride-note">Machines for all ages</span></a>
        <a class="ka-rail-cell" href={phoneHref}><span class="ka-ride">Call us</span><span class="ka-ride-note">{phone} →</span></a>
      </nav>
    </main>
</ConceptLayout>
