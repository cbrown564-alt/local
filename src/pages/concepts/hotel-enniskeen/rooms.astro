---
import "../../../styles/global.css";
import "../../../styles/concept-enniskeen.css";
const bookin1 = "https://www.bookin1.com/bookingEngine/index.jsp?ID=ecs&hotelCode=ecs#/hotel/ecs";
import ConceptLayout from "../../../layouts/ConceptLayout.astro";
import ResponsiveImage from "../../../components/ResponsiveImage.astro";
---

<ConceptLayout title={"Rooms & Suites — Enniskeen Country House Hotel — independent concept"} slug="hotel-enniskeen" bodyClass="concept-page concept-enniskeen" lang="en-GB">
<header class="enk-header">
      <div class="enk-brand">
        <a href="/concepts/hotel-enniskeen/" class="enk-brand-link">
          <span class="enk-brand-name">Enniskeen</span>
          <span class="enk-brand-sub">Country House Hotel · Shimna Valley</span>
        </a>
      </div>
      <nav class="enk-nav" aria-label="Concept navigation">
        <a href="/concepts/hotel-enniskeen/rooms/" aria-current="page">Stay</a>
        <a href="#">Dine</a>
        <a href="#">The estate</a>
        <a href="#">Things to do</a>
      </nav>
      <div class="enk-header-actions">
        <a class="enk-phone" href="tel:+442843722392">028 4372 2392</a>
        <a class="enk-book" href={bookin1} rel="external">Book a room</a>
      </div>
    </header>

    <main>
      <!-- Featured room: balcony double -->
      <section class="enk-rooms-hero">
        <figure class="enk-rooms-hero-image">
          <ResponsiveImage
            pictureClass="concept-responsive-picture"
            src="/images/enniskeen-balcony.jpg"
            alt="A bedroom's french doors open onto a balcony overlooking the Shimna Valley and the Mourne Mountains"
            width="1280"
            height="853"
            loading="eager"
          />
        </figure>
        <div class="enk-rooms-hero-copy">
          <p class="enk-kicker">Stay · Rooms &amp; suites</p>
          <h1>Wake to the <em>valley</em> and the mountains beyond.</h1>
          <p class="enk-lede">
            Twelve rooms across the country house — each one quiet, each one facing the twelve
            wooded acres that drop away toward the Shimna River. Balcony rooms open straight onto
            the Mourne skyline; all rooms are en-suite, with breakfast in the morning and the
            Brandy Pad Lounge a short walk away.
          </p>
          <div class="enk-actions">
            <a class="enk-cta" href={bookin1} rel="external">Check availability</a>
            <a class="enk-link" href="tel:+442843722392">Call 028 4372 2392 →</a>
          </div>
        </div>
      </section>

      <!-- Room types -->
      <section class="enk-room-types" aria-labelledby="room-types-heading">
        <div class="enk-room-types-head">
          <p class="enk-kicker" style="animation:none">Room types</p>
          <h2 id="room-types-heading">Choose your room</h2>
          <p class="enk-rooms-sub">
            All rooms include breakfast, complimentary Wi-Fi, and use of the estate grounds.
            Live pricing and availability are confirmed through our booking engine.
          </p>
        </div>
        <ul class="enk-room-grid" role="list">
          <li class="enk-room-card">
            <div class="enk-room-card-image enk-room-card-image--balcony">
              <ResponsiveImage
                pictureClass="concept-responsive-picture"
                src="/images/enniskeen-balcony.jpg"
                alt="French doors open onto a private balcony with Mourne Mountain views"
                width="1280"
                height="853"
              />
            </div>
            <div class="enk-room-card-body">
              <h3>Balcony Double</h3>
              <p class="enk-room-view">
                <svg viewBox="0 0 16 16" aria-hidden="true" width="14" height="14"><path d="M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Z" fill="currentColor"/><path d="M6.5 5.5a1.5 1.5 0 1 0 3 0 1.5 1.5 0 0 0-3 0ZM5 8a3 3 0 1 1 6 0v4H5V8Z" fill="currentColor"/></svg>
                Shimna Valley · private balcony
              </p>
              <ul class="enk-room-features" aria-label="Room features">
                <li>Private balcony with mountain views</li>
                <li>En-suite with bath &amp; shower</li>
                <li>King-size bed</li>
                <li>Complimentary breakfast</li>
              </ul>
              <a class="enk-room-book" href={bookin1} rel="external">
                Check availability
                <svg viewBox="0 0 20 20" aria-hidden="true" width="16" height="16"><path d="M4 10h11M11 6l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </li>

          <li class="enk-room-card">
            <div class="enk-room-card-image enk-room-card-image--garden">
              <ResponsiveImage
                pictureClass="concept-responsive-picture"
                src="/images/enniskeen-balcony.jpg"
                alt="A country house bedroom overlooking the wooded estate gardens"
                width="1280"
                height="853"
              />
            </div>
            <div class="enk-room-card-body">
              <h3>Classic Double</h3>
              <p class="enk-room-view">
                <svg viewBox="0 0 16 16" aria-hidden="true" width="14" height="14"><path d="M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Z" fill="currentColor"/><path d="M6.5 5.5a1.5 1.5 0 1 0 3 0 1.5 1.5 0 0 0-3 0ZM5 8a3 3 0 1 1 6 0v4H5V8Z" fill="currentColor"/></svg>
                Estate gardens · ground floor
              </p>
              <ul class="enk-room-features" aria-label="Room features">
                <li>Garden outlook</li>
                <li>En-suite bathroom</li>
                <li>Double or twin configuration</li>
                <li>Complimentary breakfast</li>
              </ul>
              <a class="enk-room-book" href={bookin1} rel="external">
                Check availability
                <svg viewBox="0 0 20 20" aria-hidden="true" width="16" height="16"><path d="M4 10h11M11 6l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </li>

          <li class="enk-room-card">
            <div class="enk-room-card-image enk-room-card-image--family">
              <ResponsiveImage
                pictureClass="concept-responsive-picture"
                src="/images/enniskeen-balcony.jpg"
                alt="A spacious family room with a view toward the Mourne Mountains"
                width="1280"
                height="853"
              />
            </div>
            <div class="enk-room-card-body">
              <h3>Family Room</h3>
              <p class="enk-room-view">
                <svg viewBox="0 0 16 16" aria-hidden="true" width="14" height="14"><path d="M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Z" fill="currentColor"/><path d="M6.5 5.5a1.5 1.5 0 1 0 3 0 1.5 1.5 0 0 0-3 0ZM5 8a3 3 0 1 1 6 0v4H5V8Z" fill="currentColor"/></svg>
                Shimna Valley · up to 2 + 2
              </p>
              <ul class="enk-room-features" aria-label="Room features">
                <li>Double bed plus bunks or singles</li>
                <li>En-suite bathroom</li>
                <li>River trail &amp; estate from the door</li>
                <li>Complimentary breakfast for all</li>
              </ul>
              <a class="enk-room-book" href={bookin1} rel="external">
                Check availability
                <svg viewBox="0 0 20 20" aria-hidden="true" width="16" height="16"><path d="M4 10h11M11 6l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </li>
        </ul>
      </section>

      <!-- Included amenities strip -->
      <section class="enk-amenities" aria-labelledby="amenities-heading">
        <p class="enk-kicker" style="animation:none" id="amenities-heading">Included with every room</p>
        <ul class="enk-amenity-grid" role="list">
          <li class="enk-amenity">
            <span class="enk-amenity-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="26" height="26"><path d="M3 17h18M3 12h18M9 7l3-3 3 3"/><path d="M5 12V7a7 7 0 0 1 14 0v5"/></svg>
            </span>
            <strong>Full Irish breakfast</strong>
            <span>Served in the dining room each morning</span>
          </li>
          <li class="enk-amenity">
            <span class="enk-amenity-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="26" height="26"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>
            </span>
            <strong>Complimentary Wi-Fi</strong>
            <span>Throughout the house and grounds</span>
          </li>
          <li class="enk-amenity">
            <span class="enk-amenity-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="26" height="26"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </span>
            <strong>Twelve wooded acres</strong>
            <span>Estate walks and the river trail from the door</span>
          </li>
          <li class="enk-amenity">
            <span class="enk-amenity-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="26" height="26"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8Z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
            </span>
            <strong>Afternoon tea</strong>
            <span>Mourne Honey afternoon tea on the terrace</span>
          </li>
          <li class="enk-amenity">
            <span class="enk-amenity-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="26" height="26"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"/></svg>
            </span>
            <strong>Brandy Pad Lounge</strong>
            <span>A quiet nightcap in the house bar</span>
          </li>
          <li class="enk-amenity">
            <span class="enk-amenity-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="26" height="26"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </span>
            <strong>Flexible check-in</strong>
            <span>Call ahead — the team will do their best</span>
          </li>
        </ul>
      </section>

      <!-- Availability bar -->
      <section class="enk-page-booking-section" aria-labelledby="avail-heading">
        <div class="enk-page-booking-inner">
          <div class="enk-page-booking-copy">
            <h2 id="avail-heading">Ready to book?</h2>
            <p>Check what's free for your dates — live availability through Bookin1, the hotel's own engine.</p>
          </div>
          <form class="enk-page-booking" action={bookin1} method="get" aria-label="Check availability">
            <label>
              Arrive
              <input type="date" name="arrive" value="2026-07-24" />
            </label>
            <label>
              Nights
              <select name="nights">
                <option>2</option><option>1</option><option>3</option>
                <option>4</option><option>5</option><option>7</option>
              </select>
            </label>
            <label>
              Guests
              <select name="guests">
                <option>2 adults</option><option>1 adult</option>
                <option>2 + child</option><option>Family</option>
              </select>
            </label>
            <button type="submit">Check availability</button>
          </form>
        </div>
      </section>
    </main>
</ConceptLayout>
