---
import "../../styles/global.css";
import "../../styles/concept-cupla.css";
const instagram = "https://www.instagram.com/cuplabrewbar/";
const facebook = "https://www.facebook.com/p/C%C3%BApla-61565293502528/";
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Vollkorn:ital,wght@0,500;0,600;1,500;1,600&family=Mulish:wght@400;700&display=swap" rel="stylesheet" />
    <title>Cúpla — independent concept</title>
  </head>
  <body class="concept-page concept-cupla">
    <div class="cp-strip">
      <span>105 Main Street, Dundrum · <em>ar an bpríomhshráid</em></span>
      <span>Today's hours on <a href={instagram}>Instagram</a></span>
    </div>
    <header class="cp-header">
      <a class="cp-brand" href="#">
        <svg class="cp-rings" width="46" height="34" viewBox="0 0 46 34" fill="none" aria-hidden="true">
          <circle cx="16" cy="17" r="13.5" stroke="#1d4e54" stroke-width="2.4" />
          <circle cx="30" cy="17" r="13.5" stroke="#c98a3b" stroke-width="2.4" />
        </svg>
        <span class="cp-brand-text">
          <span class="cp-brand-name">Cúpla</span>
          <span class="cp-brand-sub">Brews · Bakes · Bowls</span>
        </span>
      </a>
      <nav class="cp-nav" aria-label="Concept navigation">
        <a href="#">An biachlár <span aria-hidden="true">·</span> Menu</a><a href="#">Ár scéal <span aria-hidden="true">·</span> Our story</a><a href="#">Aimsigh muid <span aria-hidden="true">·</span> Find us</a>
      </nav>
      <a class="cp-follow" href={instagram}>Follow @cuplabrewbar</a>
    </header>
    <main class="cp-hero">
      <section class="cp-story">
        <p class="cp-kicker">Caife · Dundrum</p>
        <h1>Fáilte isteach. <em>Come on in.</em></h1>
        <p class="cp-lede">
          <strong>Cúpla — the Irish for twins</strong> — is the café twin owners opened on
          Dundrum's main street in 2024: specialty coffee, bakes from the counter and
          brunch bowls, served in both of the town's languages.
        </p>
        <div class="cp-actions">
          <a class="cp-cta" href={instagram}>See today's counter</a>
          <a class="cp-link" href={facebook}>Find us on Facebook →</a>
        </div>
      </section>
      <aside class="cp-panel">
        <article class="cp-card">
          <p class="cp-card-kicker">Ar an gcuntar · At the counter</p>
          <ul class="cp-offer">
            <li><span class="cp-offer-ga">Caife</span><span class="cp-offer-en">Specialty coffee, brewed for here or the beach</span></li>
            <li><span class="cp-offer-ga">Bácús</span><span class="cp-offer-en">Bakes from the counter every morning</span></li>
            <li><span class="cp-offer-ga">Babhlaí</span><span class="cp-offer-en">Brunch bowls, made to linger over</span></li>
          </ul>
          <a class="cp-card-cta" href={instagram}>What's on today →</a>
          <small>Straight from the Instagram the café already runs</small>
        </article>
      </aside>
      <nav class="cp-rail" aria-label="Bilingual site sections">
        <a class="cp-rail-cell" href="#"><span class="cp-rail-ga">Maidin</span><span class="cp-rail-en">Morning</span></a>
        <a class="cp-rail-cell" href="#"><span class="cp-rail-ga">Lón</span><span class="cp-rail-en">Lunch</span></a>
        <a class="cp-rail-cell" href="#"><span class="cp-rail-ga">Le tabhairt leat</span><span class="cp-rail-en">Takeaway</span></a>
        <a class="cp-rail-cell" href={instagram}><span class="cp-rail-ga">Ar oscailt</span><span class="cp-rail-en">Today's hours →</span></a>
      </nav>
    </main>
    <div class="concept-disclosure">Independent concept · not a live Cúpla site</div>
  </body>
</html>
