---
import "../../styles/global.css";
import "../../styles/concept-scopers.css";
const instagram = "https://www.instagram.com/scopersdundrum/";
const facebook = "https://www.facebook.com/p/Scopers-Dundrum-Co-Down-100083029315116/";
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>Scopers — independent concept</title>
  </head>
  <body class="concept-page concept-scopers">
    <div class="sc-strip">
      <span><strong>Now open most of the week</strong> · 169 Main Street, Dundrum</span>
      <span>Today's hours on <a href={facebook} style="color:#fff;">Facebook</a></span>
    </div>
    <header class="sc-header">
      <a class="sc-brand" href="#">
        <svg class="sc-stamp" width="44" height="44" viewBox="0 0 44 44" fill="none" aria-hidden="true">
          <circle cx="22" cy="22" r="20.5" stroke="currentColor" stroke-width="2" />
          <path d="M22 33 C22 26 22 20 22 13 M22 20 C18 18 15.5 15 15 10.5 C19.5 11 22 14 22 18 M22 25 C26 23 28.5 20 29 15.5 C24.5 16 22 19 22 23" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span class="sc-brand-text">
          <span class="sc-brand-name">Scopers</span>
          <span class="sc-brand-sub">Zero-waste hot food bar</span>
        </span>
      </a>
      <nav class="sc-nav" aria-label="Concept navigation">
        <a href="#">The food</a><a href="/concepts/scopers/supper-club/">Supper club</a><a href="#">Our story</a><a href="#">Find us</a>
      </nav>
      <a class="sc-book" href="/concepts/scopers/supper-club/">Book the supper club</a>
    </header>
    <main class="sc-hero">
      <section class="sc-story">
        <p class="sc-kicker">Main Street · Dundrum</p>
        <h1>Northern Ireland's first <em>zero-waste</em> hot food bar.</h1>
        <p class="sc-lede">
          Paul Cunningham cooked on Great British Menu in 2021, then came home to open
          Scopers — breakfast, brunch and lunch built on his grandfather's foraging and
          the Mourne Larder: only what the local Mourne area provides, nothing wasted.
        </p>
        <div class="sc-actions">
          <a class="sc-cta" href={facebook}>See this week's menu</a>
          <a class="sc-link" href={instagram}>Follow @scopersdundrum →</a>
        </div>
      </section>
      <aside class="sc-panel">
        <article class="sc-club">
          <p class="sc-club-kicker">The Supper Club</p>
          <h2>Up to eleven courses. Somewhere unique.</h2>
          <p>Secret pop-up dining events in unique locations — seasonal courses from the Mourne Larder, open for private booking.</p>
          <p class="sc-club-meta"><strong>Next date announced soon</strong><span>Tickets released on Facebook and Instagram</span></p>
          <a class="sc-club-cta" href="/concepts/scopers/supper-club/">See the supper-club page</a>
          <small>Booking via Instagram · <a href={instagram} style="color:inherit;">message to reserve</a></small>
        </article>
      </aside>
      <nav class="sc-rail" aria-label="Signatures and hours">
        <a class="sc-rail-cell" href="#"><span class="sc-dish">Buttermilk pancakes</span><span class="sc-dish-note">maple syrup, fresh berries</span></a>
        <a class="sc-rail-cell" href="#"><span class="sc-dish">Smoked haddock</span><span class="sc-dish-note">golden batter, cider mayo</span></a>
        <a class="sc-rail-cell" href="#"><span class="sc-dish">Specialty coffee</span><span class="sc-dish-note">breakfast, brunch &amp; lunch</span></a>
        <a class="sc-rail-cell" href={facebook}><span class="sc-dish">Open most days</span><span class="sc-dish-note">today's hours on Facebook →</span></a>
      </nav>
    </main>
    <div class="concept-disclosure">Independent concept · not a live Scopers site</div>
  </body>
</html>
