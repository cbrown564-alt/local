---
import "../../styles/global.css";
import "../../styles/concept-bettys-butters.css";
import ConceptLayout from "../../layouts/ConceptLayout.astro";
import ResponsiveImage from "../../components/ResponsiveImage.astro";

// Betty's Better Butters publishes no product names, sizes or prices online, so
// the flavours below are clearly-marked structure placeholders — never passed
// off as the real range, which must come from the maker.
const jars = [
  { name: "Garlic & Herb", note: "the everyday one", tone: "herb", ph: true },
  { name: "Chilli & Lime", note: "for corn, for steak", tone: "chilli", ph: true },
  { name: "Café de Paris", note: "the restaurant classic", tone: "paris", ph: true },
  { name: "Maple & Sea Salt", note: "breakfast, upgraded", tone: "maple", ph: true },
];
---

<ConceptLayout
  title={"Betty's Better Butters — independent concept"}
  slug="bettys-butters"
  bodyClass="concept-page concept-bettys"
  businessName="Betty's Better Butters"
  town="Dundrum"
  bannerNote="Flavours shown are placeholders — the real range must come from the maker."
>
  <div class="bb-strip">
    <span>Betty's Better Butters · Dundrum · made in small batches</span>
    <span class="bb-strip-r">Collection · local delivery · Royal Mail across the UK</span>
  </div>

  <header class="bb-header">
    <a class="bb-brand" href="/concepts/bettys-butters/">
      <img
        src="/images/bettys-butters-brand-mark.png"
        alt="Betty's Better Butters — locally crafted flavours"
        width="346"
        height="346"
      />
    </a>
    <nav class="bb-nav" aria-label="Concept navigation">
      <a href="#" data-concept-placeholder>The range</a><a href="#" data-concept-placeholder>Our story</a><a href="#" data-concept-placeholder>Stockists</a><a href="#" data-concept-placeholder>Order</a>
    </nav>
    <a class="bb-shop" href="#" data-concept-placeholder>Shop the range</a>
  </header>

  <main class="bb-main">
    <section class="bb-hero">
      <div class="bb-hero-copy">
        <p class="bb-kicker">Flavoured butter · Dundrum</p>
        <h1>
          Restaurant flavour,
          <span class="bb-hero-em">brought home.</span>
        </h1>
        <p class="bb-lede">
          Bold flavoured butters from recipes collected over ten years in professional
          kitchens — made to turn a one-off treat into a new staple.
        </p>
        <div class="bb-hero-actions">
          <a class="bb-cta" href="#" data-concept-placeholder>See the range →</a>
          <a class="bb-story" href="#" data-concept-placeholder>Our story</a>
        </div>
      </div>

      <figure class="bb-hero-media">
        <ResponsiveImage
          pictureClass="bb-hero-picture"
          src="/images/bettys-butters-source-butter.jpg"
          alt="A knife slicing through butter on a wooden board"
          width="5184"
          height="3456"
          loading="eager"
          sizes="(max-width: 820px) 100vw, 54vw"
        />
        <figcaption>Made for the table · crafted in Dundrum</figcaption>
      </figure>
    </section>

    <section class="bb-range" aria-labelledby="bb-range-title">
      <div class="bb-range-intro">
        <p class="bb-range-number" aria-hidden="true">01</p>
        <div>
          <h2 id="bb-range-title">Make more of every meal.</h2>
          <p>
            A simple shelf can lead with flavour, then give allergens, serving ideas,
            sizes and delivery details where people need them.
          </p>
        </div>
      </div>

      <div class="bb-shelf" aria-label="Illustrative range placeholders">
        {jars.map((jar) => (
          <article class={`bb-jar bb-jar--${jar.tone}`}>
            <span class="bb-jar-dot" aria-hidden="true"></span>
            <div class="bb-jar-label">
              <h3>{jar.name}</h3>
              <p>{jar.note}</p>
            </div>
            {jar.ph && <span class="bb-ph">illustrative flavour</span>}
          </article>
        ))}
      </div>
      <p class="bb-range-note">
        Flavour names are illustrative placeholders. The real range, ingredients,
        allergens, sizes and prices must come from Betty’s Better Butters.
      </p>
    </section>
  </main>
</ConceptLayout>
