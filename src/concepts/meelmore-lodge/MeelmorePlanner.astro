---
/* Meelmore Lodge: Deep Mountain-Slate Basecamp Selector Stage
   Pairs Tent pitches, Walker hostel rooms, The Wee House, and Hare's Gap Bistro
   with the 16/10 bistro-breakfast plate and live Freetobook portal links. */
interface Props {
  bookingHref: string;
  phone: string;
  phoneHref: string;
}
const { bookingHref, phone, phoneHref } = Astro.props;

const options = [
  {
    id: "camp",
    label: "Tent pitches",
    heading: "Stone-walled meadow pitching right at the Trassey Track gate.",
    note: "Tents only, with no caravans, campervans or electric hook-ups, so the valley stays quiet under Slieve Meelmore.",
    rows: [
      { term: "Facilities", value: "Hot showers and walker washroom on site" },
      { term: "Trail access", value: "Step straight onto the Trassey Track to Hare's Gap" },
      { term: "Pitch booking", value: "Seasonal tent pitching reserved online via Freetobook" },
    ],
    cta: "Book tent pitch via Freetobook ↗",
    href: bookingHref,
    external: true,
  },
  {
    id: "hostel",
    label: "Walker hostel rooms",
    heading: "Warm, practical bunk and private rooms for Mourne walking groups.",
    note: "Built for DofE teams, hillwalking clubs and early-start summit days across Slieve Bearnagh and Slieve Donard.",
    rows: [
      { term: "Kit and kitchen", value: "Drying facilities and full self-catering kitchen" },
      { term: "Breakfast", value: "Cooked breakfasts next door at Hare's Gap Bistro" },
      { term: "Parking", value: "On-site trailhead parking off Trassey Road" },
    ],
    cta: "Check hostel beds via Freetobook ↗",
    href: bookingHref,
    external: true,
  },
  {
    id: "cottage",
    label: "The Wee House",
    heading: "Self-catering granite cottage tucked right below the High Mournes.",
    note: "A private cottage stay for couples or small families wanting mountain silence without packing a tent.",
    rows: [
      { term: "Interiors", value: "Full self-catering kitchen and warm living room" },
      { term: "Location", value: "Direct trailhead access without driving to a car park" },
      { term: "Reservations", value: "Booked directly online with Meelmore Lodge" },
    ],
    cta: "Check cottage dates via Freetobook ↗",
    href: bookingHref,
    external: true,
  },
  {
    id: "bistro",
    label: "Hare's Gap Bistro",
    heading: "Fuel up before the climb, warm up coming off the ridge.",
    note: "Cooked breakfasts, Ulster fry, buttered soda farls, homemade soup, lunches, home baking, teas and coffees for walkers and passing visitors.",
    rows: [
      { term: "April to September", value: "Open daily for breakfast, lunch and coffee" },
      { term: "October to March", value: "Open weekends right through the winter season" },
      { term: "Access", value: "No overnight stay needed, park at 52 Trassey Road" },
    ],
    cta: `Ring the lodge: ${phone}`,
    href: phoneHref,
    external: false,
  },
];
---

<section class="ml-section ml-basecamp" id="basecamp" aria-labelledby="ml-planner-title">
  <div class="ml-wrap ml-basecamp-grid">
    <div class="ml-basecamp-main" data-ml-planner>
      <h2 id="ml-planner-title">Choose your basecamp on Trassey Road.</h2>

      <div class="ml-tabs" role="tablist" aria-label="Choose stay or bistro option">
        {options.map((opt, idx) => (
          <button
            type="button"
            role="tab"
            id={`ml-tab-${opt.id}`}
            aria-controls={`ml-panel-${opt.id}`}
            aria-selected={idx === 0 ? "true" : "false"}
            tabindex={idx === 0 ? 0 : -1}
            class:list={["ml-tab", idx === 0 && "is-active"]}
            data-ml-tab={opt.id}
          >
            {opt.label}
          </button>
        ))}
      </div>

      {options.map((opt, idx) => (
        <div
          class="ml-panel"
          role="tabpanel"
          id={`ml-panel-${opt.id}`}
          aria-labelledby={`ml-tab-${opt.id}`}
          data-ml-panel={opt.id}
          hidden={idx !== 0}
        >
          <h3>{opt.heading}</h3>
          <p>{opt.note}</p>
          <dl class="ml-ledger">
            {opt.rows.map((row) => (
              <div class="ml-ledger-row">
                <dt>{row.term}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>
          <div class="ml-panel-foot">
            <a
              class="ml-panel-link"
              href={opt.href}
              target={opt.external ? "_blank" : undefined}
              rel={opt.external ? "noopener noreferrer" : undefined}
            >
              {opt.cta}
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="ml-basecamp-media" id="bistro">
      <figure class="ml-plate">
        <picture>
          <source
            srcset="/media/concepts/meelmore-lodge/meelmore-lodge-bistro-breakfast-640.webp 640w, /media/concepts/meelmore-lodge/meelmore-lodge-bistro-breakfast-1265.webp 1265w"
            sizes="(max-width: 900px) 100vw, 46vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/meelmore-lodge/meelmore-lodge-bistro-breakfast.jpg"
            alt="Mountain café table with Ulster fry, soda farls, steaming mug of tea and folded hillwalking map"
            width="1408"
            height="768"
            loading="lazy"
          />
        </picture>
        <figcaption>Hare's Gap Bistro off Trassey Road. Indicative breakfast plate visualisation.</figcaption>
      </figure>

      <dl class="ml-bistro-meta">
        <div>
          <dt>April to September</dt>
          <dd>Bistro open daily</dd>
        </div>
        <div>
          <dt>October to March</dt>
          <dd>Bistro open weekends</dd>
        </div>
        <div>
          <dt>Camping policy</dt>
          <dd>Tents only, no campervans or EHU</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-ml-planner]");
    if (!root) return;
    const tabs = Array.from(root.querySelectorAll("[data-ml-tab]"));
    const panels = Array.from(root.querySelectorAll("[data-ml-panel]"));

    const selectTab = (id, moveFocus) => {
      tabs.forEach((tab) => {
        const active = tab.getAttribute("data-ml-tab") === id;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-selected", active ? "true" : "false");
        tab.setAttribute("tabindex", active ? "0" : "-1");
        if (active && moveFocus) tab.focus();
      });
      panels.forEach((panel) => {
        panel.hidden = panel.getAttribute("data-ml-panel") !== id;
      });
    };

    tabs.forEach((tab, idx) => {
      tab.addEventListener("click", () => selectTab(tab.getAttribute("data-ml-tab"), false));
      tab.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") {
          e.preventDefault();
          const next = tabs[(idx + 1) % tabs.length];
          selectTab(next.getAttribute("data-ml-tab"), true);
        } else if (e.key === "ArrowLeft") {
          e.preventDefault();
          const prev = tabs[(idx - 1 + tabs.length) % tabs.length];
          selectTab(prev.getAttribute("data-ml-tab"), true);
        } else if (e.key === "Home") {
          e.preventDefault();
          selectTab(tabs[0].getAttribute("data-ml-tab"), true);
        } else if (e.key === "End") {
          e.preventDefault();
          selectTab(tabs[tabs.length - 1].getAttribute("data-ml-tab"), true);
        }
      });
    });

    document.querySelectorAll("[data-ml-jump]").forEach((link) => {
      link.addEventListener("click", () => {
        const targetTab = link.getAttribute("data-ml-jump");
        if (targetTab) selectTab(targetTab, false);
      });
    });
  })();
</script>
