---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import MeelmorePlanner from "./MeelmorePlanner.astro";
import "./styles.css";

/* Meelmore Lodge, 52 Trassey Road, Bryansford, Newcastle BT33 0QB.
   Verified live 26 Nov 2026: meelmorelodge.co.uk, live Freetobook (w_id=26971),
   Hare's Gap Bistro, tent camping (tents only), hostel and The Wee House cottage,
   028 4372 5949, meelmorelodge52@gmail.com. */
const phone = "028 4372 5949";
const phoneHref = "tel:+442843725949";
const email = "meelmorelodge52@gmail.com";
const bookingHref = "https://portal.freetobook.com/reservations?w_id=26971&w_tkn=WkJuvIxvU7Jg6HqViaOchgkJqltY4Wl2JCyBWwzpE4cwSnpn3U9mTUZaUCaDZ";
const fbHref = "https://www.facebook.com/MeelmoreLodgeAmenitySite/";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Meelmore+Lodge+52+Trassey+Road+Bryansford+BT33+0QB";
---

<ConceptLayout
  title="Meelmore Lodge and Hare's Gap Bistro, Trassey Road, Mourne Mountains"
  slug="meelmore-lodge"
  bodyClass="concept-page concept-meelmore"
  businessName="Meelmore Lodge"
  town="Bryansford"
  bannerNote="Imagery comprises indicative Mourne trailhead camping and Hare's Gap Bistro visualisations."
>
  <header class="ml-header" data-ml-header>
    <div class="ml-header-inner">
      <a class="ml-brand" href="#top">Meelmore Lodge</a>
      <nav class="ml-nav" aria-label="Primary">
        <a href="#basecamp" data-ml-jump="camp">Basecamp</a>
        <a href="#basecamp" data-ml-jump="bistro">Hare's Gap Bistro</a>
        <a href="#group-enquiry">Group enquiries</a>
        <a href="#location">Trassey Road</a>
      </nav>
      <div class="ml-header-actions">
        <a class="ml-header-tel" href={phoneHref}>{phone}</a>
        <a class="ml-header-cta" href={bookingHref} target="_blank" rel="noopener noreferrer">Book online</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="ml-hero" aria-labelledby="ml-hero-title">
      <span class="ml-hero-sentinel" data-ml-sentinel aria-hidden="true"></span>
      <div class="ml-hero-media">
        <picture>
          <source
            srcset="/media/concepts/meelmore-lodge/meelmore-lodge-trassey-trailhead-640.webp 640w, /media/concepts/meelmore-lodge/meelmore-lodge-trassey-trailhead-1265.webp 1265w"
            sizes="100vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/meelmore-lodge/meelmore-lodge-trassey-trailhead.jpg"
            alt="Early morning stone-walled Mourne meadow campsite with green tents looking up toward misty mountain peaks"
            width="1408"
            height="768"
            loading="eager"
          />
        </picture>
      </div>
      <div class="ml-hero-scrim" aria-hidden="true"></div>

      <div class="ml-wrap ml-hero-content">
        <div class="ml-hero-copy">
          <h1 id="ml-hero-title">At the gate of the High Mournes.</h1>
          <p class="ml-hero-lead">
            Tent pitches, walker hostel rooms, The Wee House cottage and hot breakfasts where the Trassey Track climbs toward Bearnagh.
          </p>
          <a class="ml-btn ml-btn--primary" href={bookingHref} target="_blank" rel="noopener noreferrer">Check live availability</a>
        </div>
        <div class="ml-hero-foot">
          <p class="ml-hero-caption">Indicative Trassey Road trailhead visualisation.</p>
        </div>
      </div>
    </section>

    <MeelmorePlanner bookingHref={bookingHref} phone={phone} phoneHref={phoneHref} />

    <section class="ml-section ml-enquiry" id="group-enquiry" aria-labelledby="ml-enq-title">
      <div class="ml-wrap ml-split">
        <div class="ml-enquiry-intro">
          <h2 id="ml-enq-title">Bringing a hillwalking club or DofE group?</h2>
          <p>
            Standard tent pitches and rooms book straight through Freetobook. For group hostel block bookings,
            early group breakfasts or expedition dates, send your outline directly to the lodge on Trassey Road.
          </p>
          <dl class="ml-contact-ledger">
            <div>
              <dt>Lodge desk</dt>
              <dd><a href={phoneHref}>{phone}</a></dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd><a href={`mailto:${email}`}>{email}</a></dd>
            </div>
            <div>
              <dt>Trailhead address</dt>
              <dd>52 Trassey Road, Bryansford, Newcastle, BT33 0QB</dd>
            </div>
          </dl>
        </div>

        <form class="ml-form" data-ml-form>
          <div class="ml-row">
            <label>
              <span>Leader or contact name</span>
              <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
            </label>
            <label>
              <span>Telephone</span>
              <input name="phone" type="tel" required autocomplete="tel" placeholder="028 or 07..." />
            </label>
          </div>
          <div class="ml-row">
            <label>
              <span>Arrival date</span>
              <input name="date" type="date" required />
            </label>
            <label>
              <span>Number of walkers</span>
              <input name="groupSize" type="number" min="2" max="40" value="8" required />
            </label>
          </div>
          <label>
            <span>Stay type</span>
            <select name="stayType">
              <option value="Tent camping group (tents only)">Tent camping group (tents only)</option>
              <option value="Walker hostel group booking">Walker hostel group booking</option>
              <option value="The Wee House self-catering cottage">The Wee House self-catering cottage</option>
              <option value="Hare's Gap Bistro group breakfast">Hare's Gap Bistro group breakfast</option>
            </select>
          </label>
          <label>
            <span>Route plans or notes</span>
            <textarea name="notes" rows="3" placeholder="Nights needed, early start times, or breakfast requirements"></textarea>
          </label>
          <button class="ml-btn ml-btn--primary" type="submit">Send trailhead enquiry</button>
        </form>
      </div>
    </section>

    <section class="ml-section ml-map-band" id="location" aria-label="Mourne trailhead map">
      <div class="ml-wrap">
        <LocalAreaMap
          id="ml-map"
          kicker=""
          businessName="Meelmore Lodge"
          address="52 Trassey Road, Bryansford, Newcastle, BT33 0QB"
          lon={-5.9978928}
          lat={54.2086476}
          spanKm={16}
          mapHref={mapsHref}
          markers={[
            { name: "Tollymore Forest", lon: -5.9465, lat: 54.2227, note: "6 mins east", side: "r" },
            { name: "Castlewellan", lon: -5.9442, lat: 54.2596, note: "10 mins north", side: "t" },
            { name: "Newcastle", lon: -5.8902, lat: 54.2121, note: "10 mins east", side: "r" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="ml-footer">
    <div class="ml-wrap ml-footer-inner">
      <div>
        <strong>Meelmore Lodge</strong>
        <p>52 Trassey Road, Bryansford, Newcastle, Co. Down, BT33 0QB</p>
      </div>
      <div class="ml-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={fbHref} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-ml-header]");
      const sentinel = document.querySelector("[data-ml-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            header.classList.toggle("is-scrolled", !entries[0].isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      const form = document.querySelector("[data-ml-form]");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        const subject = `Meelmore Lodge Enquiry: ${fd.get("stayType")} (${fd.get("date")})`;
        const body = [
          `Name: ${fd.get("name")}`,
          `Phone: ${fd.get("phone")}`,
          `Arrival: ${fd.get("date")}`,
          `Group size: ${fd.get("groupSize")}`,
          `Stay type: ${fd.get("stayType")}`,
          `Notes: ${fd.get("notes") || "None"}`,
        ].join("\n");
        const ev = new CustomEvent("mm:enquiry", {
          cancelable: true,
          detail: {
            to: "meelmorelodge52@gmail.com",
            subject,
            body,
            phone: "028 4372 5949",
            phoneHref: "tel:+442843725949",
          },
        });
        if (window.dispatchEvent(ev)) {
          window.location.href = `mailto:meelmorelodge52@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }
      });
    })();
  </script>
</ConceptLayout>
