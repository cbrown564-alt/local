---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import MeelmorePlanner from "./MeelmorePlanner.astro";
import "./styles.css";

/* Meelmore Lodge — 52 Trassey Road, Bryansford, Newcastle BT33 0QB.
   Verified live 26 Nov 2026: meelmorelodge.co.uk (Wix with raw --> leak),
   live Freetobook (w_id=26971), Hare's Gap Bistro, tent camping (tents only),
   hostel & The Wee House cottage, 028 4372 5949, meelmorelodge52@gmail.com. */
const phone = "028 4372 5949";
const phoneHref = "tel:+442843725949";
const email = "meelmorelodge52@gmail.com";
const bookingHref = "https://portal.freetobook.com/reservations?w_id=26971&w_tkn=WkJuvIxvU7Jg6HqViaOchgkJqltY4Wl2JCyBWwzpE4cwSnpn3U9mTUZaUCaDZ";
const fbHref = "https://www.facebook.com/MeelmoreLodgeAmenitySite/";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Meelmore+Lodge+52+Trassey+Road+Bryansford+BT33+0QB";
---

<ConceptLayout
  title="Meelmore Lodge & Hare's Gap Bistro — Trassey Road, Mourne Mountains"
  slug="meelmore-lodge"
  bodyClass="concept-page concept-meelmore"
  businessName="Meelmore Lodge"
  town="Bryansford"
  bannerNote="Imagery comprises indicative Mourne trailhead camping and Hare's Gap Bistro visualisations."
>
  <header class="ml-header">
    <div class="ml-header-inner">
      <a class="ml-brand" href="#top">
        <strong>Meelmore Lodge</strong>
        <span>Trassey Road · Mourne Trailhead</span>
      </a>
      <nav class="ml-nav" aria-label="Primary">
        <a href="#plan-stay">Basecamp</a>
        <a href="#bistro">Hare's Gap Bistro</a>
        <a href="#group-enquiry">Group Enquiries</a>
        <a href="#location">Trassey Track</a>
      </nav>
      <div class="ml-header-actions">
        <a class="ml-header-tel" href={phoneHref}>{phone}</a>
        <a class="ml-header-cta" href={bookingHref} target="_blank" rel="noopener noreferrer">Book Online</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="ml-hero" aria-labelledby="ml-hero-title">
      <figure class="ml-hero-media">
        <picture>
          <source srcset="/media/concepts/meelmore-lodge/meelmore-lodge-trassey-trailhead-640.webp 640w, /media/concepts/meelmore-lodge/meelmore-lodge-trassey-trailhead-1265.webp 1265w" sizes="100vw" type="image/webp" />
          <img src="/media/concepts/meelmore-lodge/meelmore-lodge-trassey-trailhead.jpg" alt="Early morning stone-walled Mourne meadow campsite with green tents looking up toward misty mountain peaks" width="1408" height="768" loading="eager" />
        </picture>
        <figcaption class="ml-hero-cap">Indicative Trassey Road trailhead visualisation.</figcaption>
      </figure>
      <div class="ml-hero-scrim" aria-hidden="true"></div>
      <div class="ml-hero-content">
        <p class="ml-eyebrow">52 Trassey Road · Bryansford · Foot of Slieve Meelmore</p>
        <h1 id="ml-hero-title">Pitch at the gate of the High Mournes.</h1>
        <p class="ml-hero-lead">
          Tent camping, walker hostel rooms, The Wee House cottage and hot breakfasts at Hare's Gap Bistro —
          right where the Trassey Track climbs toward Slieve Bearnagh and the Mourne Wall.
        </p>
        <div class="ml-hero-actions">
          <a class="ml-btn ml-btn--primary" href={bookingHref} target="_blank" rel="noopener noreferrer">Check Live Availability ↗</a>
          <a class="ml-btn ml-btn--ghost" href="#plan-stay">Choose Your Basecamp</a>
        </div>
      </div>
    </section>

    <MeelmorePlanner bookingHref={bookingHref} phone={phone} phoneHref={phoneHref} />

    <section class="ml-section ml-bistro" id="bistro" aria-labelledby="ml-bistro-title">
      <div class="ml-wrap ml-split">
        <figure class="ml-plate">
          <picture>
            <source srcset="/media/concepts/meelmore-lodge/meelmore-lodge-bistro-breakfast-640.webp 640w, /media/concepts/meelmore-lodge/meelmore-lodge-bistro-breakfast-1265.webp 1265w" sizes="(max-width: 860px) 100vw, 48vw" type="image/webp" />
            <img src="/media/concepts/meelmore-lodge/meelmore-lodge-bistro-breakfast.jpg" alt="Mountain café table with Ulster fry, soda farls, steaming mug of tea and folded hillwalking map" width="1408" height="768" loading="lazy" />
          </picture>
          <figcaption>Hare's Gap Bistro off Trassey Road. Indicative breakfast plate visualisation.</figcaption>
        </figure>
        <div>
          <p class="ml-kicker">Hare's Gap Bistro</p>
          <h2 id="ml-bistro-title">Fuel up before the climb, warm up coming off the ridge.</h2>
          <p>
            Whether you are setting out for Hare's Gap at dawn or stepping off Slieve Meelmore in sideways rain,
            Hare's Gap Bistro serves cooked breakfasts, lunches, home baking, teas and coffees — open weekends
            year-round and daily from April through September.
          </p>
          <dl class="ml-bistro-meta">
            <div><dt>April – September</dt><dd>Open daily</dd></div>
            <div><dt>October – March</dt><dd>Open weekends</dd></div>
            <div><dt>Camping Policy</dt><dd>Tents only (no campervans or EHU)</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section class="ml-section ml-enquiry" id="group-enquiry" aria-labelledby="ml-enq-title">
      <div class="ml-wrap ml-split">
        <div>
          <p class="ml-kicker">Walking Clubs &amp; Expedition Groups</p>
          <h2 id="ml-enq-title">Bringing a hillwalking club or DofE group?</h2>
          <p>
            Standard tent pitches and rooms book straight through Freetobook. For group hostel block bookings,
            early group breakfasts or expedition dates, send your outline directly to the lodge.
          </p>
          <p class="ml-contact-line">
            Lodge desk: <a href={phoneHref}>{phone}</a> · <a href={`mailto:${email}`}>{email}</a>
          </p>
        </div>
        <form class="ml-form" data-ml-form>
          <div class="ml-row">
            <label>
              <span>Leader / contact name</span>
              <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
            </label>
            <label>
              <span>Telephone</span>
              <input name="phone" type="tel" required autocomplete="tel" placeholder="07..." />
            </label>
          </div>
          <div class="ml-row">
            <label>
              <span>Arrival date</span>
              <input name="date" type="date" required />
            </label>
            <label>
              <span>Number of walkers</span>
              <input name="groupSize" type="number" min="2" max="40" value="8" required />
            </label>
          </div>
          <label>
            <span>Stay type</span>
            <select name="stayType">
              <option value="Tent Camping Group">Tent Camping Group (Tents Only)</option>
              <option value="Hostel Group Booking">Walker Hostel Group Booking</option>
              <option value="The Wee House Cottage">The Wee House Self-Catering Cottage</option>
              <option value="Bistro Group Breakfast">Hare's Gap Bistro Group Breakfast</option>
            </select>
          </label>
          <label>
            <span>Route plans or notes</span>
            <textarea name="notes" rows="3" placeholder="Nights needed, early start times, or breakfast requirements..."></textarea>
          </label>
          <button class="ml-btn ml-btn--primary" type="submit">Send Trailhead Enquiry</button>
        </form>
      </div>
    </section>

    <section class="ml-section ml-map-band" id="location" aria-label="Mourne trailhead map">
      <div class="ml-wrap">
        <LocalAreaMap
          id="ml-map"
          kicker="Trassey Road & High Mournes"
          businessName="Meelmore Lodge"
          address="52 Trassey Road, Bryansford, Newcastle, BT33 0QB"
          lon={-5.9978928}
          lat={54.2086476}
          spanKm={16}
          mapHref={mapsHref}
          markers={[
            { name: "Tollymore Forest", lon: -5.9465, lat: 54.2227, note: "6 mins east", side: "r" },
            { name: "Castlewellan", lon: -5.9442, lat: 54.2596, note: "10 mins north", side: "t" },
            { name: "Newcastle", lon: -5.8902, lat: 54.2121, note: "10 mins east", side: "r" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="ml-footer">
    <div class="ml-wrap ml-footer-inner">
      <div>
        <strong>Meelmore Lodge</strong>
        <p>52 Trassey Road, Bryansford, Newcastle, Co. Down, BT33 0QB</p>
      </div>
      <div class="ml-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={fbHref} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const form = document.querySelector("[data-ml-form]");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        const subject = `Meelmore Lodge Enquiry — ${fd.get("stayType")} (${fd.get("date")})`;
        const body = [
          `Name: ${fd.get("name")}`,
          `Phone: ${fd.get("phone")}`,
          `Arrival: ${fd.get("date")}`,
          `Group size: ${fd.get("groupSize")}`,
          `Stay type: ${fd.get("stayType")}`,
          `Notes: ${fd.get("notes") || "None"}`,
        ].join("\n");
        const ev = new CustomEvent("mm:enquiry", {
          cancelable: true,
          detail: { to: "meelmorelodge52@gmail.com", subject, body, phone: "028 4372 5949", phoneHref: "tel:+442843725949" },
        });
        if (document.dispatchEvent(ev)) {
          window.location.href = `mailto:meelmorelodge52@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }
      });
    })();
  </script>
</ConceptLayout>
