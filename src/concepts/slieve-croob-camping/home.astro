---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";

/* Slieve Croob Camping: Dromara Hills, Slieve Croob, Castlewellan, Co. Down.
   Sources (live-fetched 26 Nov 2026): slievecroobcamping.com (/).
   - Area of Outstanding Natural Beauty in the Dromara Hills overlooking the
     Mourne Mountains (54.3307, -5.9946).
   - Published pitch rates:
     Motorhomes £20/night, Caravans £20/night, Tents £20/night, Extra Car £5/night.
   - Firewood logs for sale on the family farm.
   - Check-in: 12:30 to 20:00, Check-out: 12:00.
   - Facilities: Motorhome/caravan water refill, shower, flushing toilet with
     hand basin, 2 fresh-water washing-up sinks.
   - Nearby landmarks named on site: Slieve Croob Mountain Path (walking distance),
     Slieve Croob Scenic Loop, Legananny Dolmen, Finnis Souterrain, Drumkeeragh
     Forest Park, Castlewellan Forest Park (lake & castle), Tollymore Forest Park,
     Silent Valley, Murlough Bay, Dundrum Castle, Newcastle Beach, Brontë Homeland,
     Hillsborough.
   - Contact: +44 7522 077970, SlieveCroobCamping@Outlook.com.
   Brief: research/concepts/slieve-croob-camping/slieve-croob-camping-elevation-brief.md */

const phone = "07522 077970";
const phoneIntl = "+44 7522 077970";
const phoneHref = "tel:+447522077970";
const whatsappHref = "https://wa.me/447522077970";
const email = "SlieveCroobCamping@Outlook.com";
const mapHref = "https://www.google.com/maps/search/?api=1&query=54.3307401,-5.9946054";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Work+Sans:wght@400;500;600;700&display=swap";

const landmarks = [
  {
    dist: "On foot from the gate",
    name: "Slieve Croob Mountain Path",
    note: "Walk straight out onto the summit path and the Slieve Croob Scenic Loop.",
  },
  {
    dist: "Dromara Hills lanes",
    name: "Legananny Dolmen and Finnis Souterrain",
    note: "Ancient County Down megalithic monuments tucked into the surrounding lanes.",
  },
  {
    dist: "Forest and lake",
    name: "Drumkeeragh and Castlewellan Forest Parks",
    note: "Forest trails, mountain biking, Castlewellan Lake, and historic castle grounds.",
  },
  {
    dist: "Mourne coast and valleys",
    name: "Tollymore, Silent Valley, and Murlough Bay",
    note: "Easy drive to Dundrum Castle, Newcastle Beach, Brontë Homeland, and Hillsborough.",
  },
];

const facilities = [
  "Motorhome and caravan fresh water refill",
  "On-site hot shower",
  "Flushing toilet with hand basin",
  "Two fresh-water washing-up sinks",
  "Seasoned firewood logs for sale on our family farm",
  "Check-in 12:30 to 20:00, check-out by 12:00",
];
---

<ConceptLayout
  title="Slieve Croob Camping: Dromara Hills, Overlooking the Mourne Mountains"
  slug="slieve-croob-camping"
  bodyClass="concept-page concept-slievecroob"
  lang="en-GB"
  businessName="Slieve Croob Camping"
  town="Castlewellan / Dromara"
  fontHref={fontHref}
  bannerNote="The hillside tent and stacked farm firewood scenes are indicative visualisations. Pitch enquiries compose a direct email to SlieveCroobCamping@Outlook.com or open WhatsApp/phone on 07522 077970."
>
  <header class="sc-header" data-sc-header>
    <div class="sc-header-inner">
      <a class="sc-brand" href="#top">Slieve Croob Camping</a>
      <nav class="sc-nav" aria-label="Slieve Croob Camping">
        <a href="#calculator">Pitch rates</a>
        <a href="#facilities">Farm facilities</a>
        <a href="#trails">Dromara and Mournes</a>
      </nav>
      <a class="sc-header-tel" href={phoneHref}>{phone}</a>
    </div>
  </header>

  <main id="top" class="sc-main">
    <section class="sc-hero" aria-labelledby="sc-hero-title">
      <div class="sc-hero-sentinel" data-sc-sentinel aria-hidden="true"></div>

      <div class="sc-hero-media">
        <ResponsiveImage
          src="/media/concepts/slieve-croob-camping/slieve-croob-ridge-camp.jpg"
          alt="Lantern-lit canvas tent pitched on a green Dromara hillside beside drystone walls looking across to the Mourne Mountains at dusk"
          width={1376}
          height={768}
          loading="eager"
          sizes="100vw"
          class="sc-hero-img"
        />
      </div>
      <div class="sc-hero-scrim" aria-hidden="true"></div>

      <div class="sc-wrap sc-hero-content">
        <div class="sc-hero-copy">
          <h1 id="sc-hero-title">Pitch high above the Mournes.</h1>
          <p class="sc-lede">
            Quiet family-farm pitches in the Dromara Hills for motorhomes, caravans,
            and tents at £20 a night.
          </p>
          <a class="sc-btn sc-btn--gorse" href="#calculator">Estimate and request a pitch</a>
        </div>

        <div class="sc-hero-foot">
          <p class="sc-hero-meta">Dromara Hills, Slieve Croob, County Down</p>
          <p class="sc-hero-caption">Dromara Hills pitch overlooking the Mournes. Indicative visualisation.</p>
        </div>
      </div>
    </section>

    <section class="sc-section sc-calc-section" id="calculator" aria-labelledby="sc-calc-title">
      <div class="sc-wrap sc-calc-grid">
        <div class="sc-calc-intro">
          <h2 id="sc-calc-title">£20 a night for motorhomes, caravans, or tents.</h2>
          <p>
            Pick your setup and nights to see your exact pitch total and send your
            arrival details straight to our family farm in the Dromara Hills.
          </p>

          <dl class="sc-rate-ledger">
            <div><dt>Motorhomes</dt><dd>£20 / night</dd></div>
            <div><dt>Caravans</dt><dd>£20 / night</dd></div>
            <div><dt>Tents</dt><dd>£20 / night</dd></div>
            <div><dt>Extra car</dt><dd>£5 / night</dd></div>
            <div><dt>Check-in and check-out</dt><dd>12:30 to 20:00, out by 12:00</dd></div>
          </dl>
        </div>

        <form class="sc-calc-panel" id="sc-form" data-email={email} data-whatsapp={whatsappHref}>
          <div class="sc-calc-readout">
            <div>
              <span class="sc-readout-label">Estimated pitch total</span>
              <p class="sc-readout-summary" id="sc-summary">2 nights, Motorhome, no extra cars</p>
            </div>
            <strong class="sc-readout-total" id="sc-total">£40</strong>
          </div>

          <fieldset class="sc-fieldset">
            <legend>Pitch type (£20 per night)</legend>
            <div class="sc-segmented" role="radiogroup" aria-label="Pitch type">
              <label class="sc-seg-opt">
                <input type="radio" name="pitch" value="Motorhome" checked />
                <span>Motorhome</span>
              </label>
              <label class="sc-seg-opt">
                <input type="radio" name="pitch" value="Caravan" />
                <span>Caravan</span>
              </label>
              <label class="sc-seg-opt">
                <input type="radio" name="pitch" value="Tent" />
                <span>Tent</span>
              </label>
            </div>
          </fieldset>

          <fieldset class="sc-fieldset">
            <legend>Extra cars (£5 per night each)</legend>
            <div class="sc-segmented" role="radiogroup" aria-label="Extra cars">
              <label class="sc-seg-opt">
                <input type="radio" name="extraCars" value="0" checked />
                <span>None</span>
              </label>
              <label class="sc-seg-opt">
                <input type="radio" name="extraCars" value="1" />
                <span>1 extra (+£5)</span>
              </label>
              <label class="sc-seg-opt">
                <input type="radio" name="extraCars" value="2" />
                <span>2 extra (+£10)</span>
              </label>
            </div>
          </fieldset>

          <div class="sc-row">
            <label class="sc-field">
              <span>Number of nights</span>
              <input type="number" name="nights" id="sc-nights" min="1" max="14" value="2" required />
            </label>
            <label class="sc-field">
              <span>Arrival date</span>
              <input type="date" name="arrival" id="sc-arrival" required />
            </label>
          </div>

          <div class="sc-row">
            <label class="sc-field">
              <span>Your name</span>
              <input name="name" autocomplete="name" required />
            </label>
            <label class="sc-field">
              <span>Phone number</span>
              <input name="phone" type="tel" autocomplete="tel" required />
            </label>
          </div>

          <label class="sc-check">
            <input type="checkbox" name="logs" id="sc-logs" value="Yes" />
            <span>Ask about seasoned firewood logs from the farm</span>
          </label>

          <button class="sc-btn sc-btn--pine sc-btn--full" type="submit">Open pitch request email</button>

          <p class="sc-form-alt">
            Prefer to text or ring? Message{" "}
            <a id="sc-whatsapp-link" href={whatsappHref} rel="noopener noreferrer">WhatsApp {phone}</a>{" "}
            or call <a href={phoneHref}>{phoneIntl}</a>.
          </p>
        </form>
      </div>
    </section>

    <section class="sc-section sc-farm-band" id="facilities" aria-labelledby="sc-fac-title">
      <div class="sc-wrap sc-farm-grid">
        <figure class="sc-logs-plate">
          <ResponsiveImage
            src="/media/concepts/slieve-croob-camping/slieve-croob-farm-logs.jpg"
            alt="Seasoned split ash firewood logs stacked beside a fieldstone wall and glowing camp firepit overlooking misty hills"
            width={1200}
            height={896}
            sizes="(max-width: 960px) 100vw, 48vw"
            class="sc-logs-img"
          />
          <figcaption>Family farm firewood and firepit evening mood. Indicative visualisation.</figcaption>
        </figure>

        <div class="sc-farm-copy">
          <h2 id="sc-fac-title">Everything you need for a clean, easy camp.</h2>
          <p class="sc-farm-intro">
            Set on our family farm in an Area of Outstanding Natural Beauty, with simple
            practical facilities and split logs ready for the firepit.
          </p>
          <ul class="sc-fac-list">
            {facilities.map((f) => <li>{f}</li>)}
          </ul>
          <a class="sc-btn sc-btn--gorse" href={mapHref} rel="noopener noreferrer">Open coordinates in Google Maps</a>
        </div>
      </div>
    </section>

    <section class="sc-section sc-trails" id="trails" aria-labelledby="sc-trails-title">
      <div class="sc-wrap">
        <div class="sc-trails-head">
          <h2 id="sc-trails-title">Slieve Croob on foot, the Mournes on the horizon.</h2>
          <p>
            Walk straight onto the summit path from the farm gate, or drive minutes into
            Dromara lanes, forest parks, and the County Down coast.
          </p>
        </div>

        <ul class="sc-trail-ledger">
          {landmarks.map((l) => (
            <li class="sc-trail-row">
              <span class="sc-trail-dist">{l.dist}</span>
              <strong class="sc-trail-name">{l.name}</strong>
              <p class="sc-trail-note">{l.note}</p>
            </li>
          ))}
        </ul>

        <div class="sc-map-wrap">
          <LocalAreaMap
            id="slieve-croob-map"
            businessName="Slieve Croob Camping"
            address="223 Clanvaraghan Road, Dromara, BT25 2LA"
            lon={-5.961}
            lat={54.316}
            spanKm={16}
            mapHref={mapHref}
            kicker=""
            markers={[
              { name: "Slieve Croob", lon: -5.973, lat: 54.334, note: "Walking distance", side: "t" },
              { name: "Castlewellan", lon: -5.939, lat: 54.259, note: "10 mins", side: "r" },
              { name: "Ballynahinch", lon: -5.899, lat: 54.402, note: "15 mins", side: "r" },
              { name: "Newcastle", lon: -5.891, lat: 54.212, note: "18 mins", side: "r" },
            ]}
          />
        </div>
      </div>
    </section>
  </main>

  <footer class="sc-footer">
    <div class="sc-wrap sc-footer-inner">
      <span><strong>Slieve Croob Camping</strong>, Dromara Hills, Slieve Croob, County Down</span>
      <span>
        <a href={phoneHref}>{phoneIntl}</a> · <a href={`mailto:${email}`}>{email}</a> ·{" "}
        <a href={mapHref} rel="noopener noreferrer">Google Maps</a>
      </span>
    </div>
  </footer>

  <script>
    const header = document.querySelector<HTMLElement>("[data-sc-header]");
    const sentinel = document.querySelector<HTMLElement>("[data-sc-sentinel]");
    if (header && sentinel) {
      const obs = new IntersectionObserver(
        (entries) => {
          header.classList.toggle("is-scrolled", !entries[0].isIntersecting);
        },
        { threshold: 0 },
      );
      obs.observe(sentinel);
    }

    const form = document.getElementById("sc-form") as HTMLFormElement | null;
    const nightsEl = document.getElementById("sc-nights") as HTMLInputElement | null;
    const arrivalEl = document.getElementById("sc-arrival") as HTMLInputElement | null;
    const logsEl = document.getElementById("sc-logs") as HTMLInputElement | null;
    const totalEl = document.getElementById("sc-total");
    const summaryEl = document.getElementById("sc-summary");
    const whatsappLink = document.getElementById("sc-whatsapp-link") as HTMLAnchorElement | null;

    const getState = () => {
      const pitch =
        form?.querySelector<HTMLInputElement>('input[name="pitch"]:checked')?.value || "Motorhome";
      const extras = Math.max(
        0,
        Number(form?.querySelector<HTMLInputElement>('input[name="extraCars"]:checked')?.value || 0),
      );
      const nights = Math.max(1, Math.min(14, Number(nightsEl?.value || 1)));
      const logs = Boolean(logsEl?.checked);
      const arrival = arrivalEl?.value || "";
      const total = nights * (20 + extras * 5);
      return { pitch, extras, nights, logs, arrival, total };
    };

    const updateTotal = () => {
      const { pitch, extras, nights, logs, arrival, total } = getState();
      if (totalEl) totalEl.textContent = `£${total}`;
      if (summaryEl) {
        const nightLabel = nights === 1 ? "1 night" : `${nights} nights`;
        const carLabel =
          extras === 0 ? "no extra cars" : extras === 1 ? "1 extra car" : `${extras} extra cars`;
        const logLabel = logs ? ", firewood logs requested" : "";
        summaryEl.textContent = `${nightLabel}, ${pitch}, ${carLabel}${logLabel}`;
      }
      if (whatsappLink && form?.dataset.whatsapp) {
        const msg = [
          `Hi Slieve Croob Camping, I would like to request a ${pitch.toLowerCase()} pitch for ${nights} night(s)`,
          arrival ? `arriving ${arrival}` : "",
          extras > 0 ? `with ${extras} extra car(s)` : "",
          logs ? "and firewood logs from the farm" : "",
          `(estimated total £${total}).`,
        ]
          .filter(Boolean)
          .join(" ");
        whatsappLink.href = `${form.dataset.whatsapp}?text=${encodeURIComponent(msg)}`;
      }
    };

    form?.addEventListener("input", updateTotal);
    form?.addEventListener("change", updateTotal);
    updateTotal();

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const d = new FormData(form);
      const { pitch, extras, nights, logs, total } = getState();
      const body = [
        `Pitch type: ${pitch}`,
        `Arrival date: ${d.get("arrival") || ""}`,
        `Nights: ${nights}`,
        `Extra cars: ${extras}`,
        `Estimated pitch total: £${total}`,
        `Firewood logs enquiry: ${logs ? "Yes" : "No"}`,
        "",
        `Name: ${d.get("name") || ""}`,
        `Phone: ${d.get("phone") || ""}`,
      ].join("\n");
      const to = form.dataset.email ?? "";
      const subject = `Pitch request (${pitch}): Slieve Croob Camping`;
      const url = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      if (
        window.dispatchEvent(
          new CustomEvent("mm:enquiry", { cancelable: true, detail: { to, subject, body, url } }),
        )
      ) {
        window.location.href = url;
      }
    });
  </script>
</ConceptLayout>
