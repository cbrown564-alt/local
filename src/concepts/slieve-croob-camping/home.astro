---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";

/* Slieve Croob Camping — Dromara Hills, Slieve Croob, Castlewellan, Co. Down.
   Sources (live-fetched 26 Nov 2026): slievecroobcamping.com (/).
   - Area of Outstanding Natural Beauty in the Dromara Hills overlooking the
     Mourne Mountains (54.3307, -5.9946).
   - Published pitch rates:
     Motorhomes £20/night · Caravans £20/night · Tents £20/night · Extra Car £5/night.
   - Firewood logs for sale on the family farm.
   - Check-in: 12:30 – 20:00 · Check-out: 12:00.
   - Facilities: Motorhome/caravan water refill, shower, flushing toilet with
     hand basin, 2 fresh-water washing-up sinks.
   - Nearby landmarks named on site: Slieve Croob Mountain Path (walking distance),
     Slieve Croob Scenic Loop, Legananny Dolmen, Finnis Souterrain, Drumkeeragh
     Forest Park, Castlewellan Forest Park (lake & castle), Tollymore Forest Park,
     Silent Valley, Murlough Bay, Dundrum Castle, Newcastle Beach, Hillsborough.
   - Contact: +44 7522 077970 · SlieveCroobCamping@Outlook.com.
   Brief: research/concepts/slieve-croob-camping/slieve-croob-camping-elevation-brief.md */

const phone = "07522 077970";
const phoneIntl = "+44 7522 077970";
const phoneHref = "tel:+447522077970";
const whatsappHref = "https://wa.me/447522077970";
const email = "SlieveCroobCamping@Outlook.com";
const mapHref = "https://www.google.com/maps/search/?api=1&query=54.3307401,-5.9946054";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&family=Work+Sans:wght@400;500;600;700&display=swap";

const landmarks = [
  { dist: "On foot", name: "Slieve Croob Mountain Path", note: "Walk straight out onto the summit path and the Slieve Croob Scenic Loop." },
  { dist: "Dromara Hills", name: "Legananny Dolmen & Finnis Souterrain", note: "Ancient County Down megalithic monuments tucked into the surrounding lanes." },
  { dist: "Forest & Lake", name: "Drumkeeragh & Castlewellan Forest Parks", note: "Forest trails, mountain biking, Castlewellan Lake and historic castle grounds." },
  { dist: "Mourne Coast", name: "Tollymore, Silent Valley & Murlough Bay", note: "Easy drive to Dundrum Castle, Newcastle Beach, Brontë Homeland and Hillsborough." },
];

const facilities = [
  "Motorhome & caravan fresh water refill",
  "On-site shower",
  "Flushing toilet with hand basin",
  "Two fresh-water washing-up sinks",
  "Seasoned firewood logs for sale on our family farm",
  "Check-in 12:30 – 20:00 · Check-out 12:00",
];
---

<ConceptLayout
  title="Slieve Croob Camping — Dromara Hills, Overlooking the Mourne Mountains"
  slug="slieve-croob-camping"
  bodyClass="concept-page concept-slievecroob"
  lang="en-GB"
  businessName="Slieve Croob Camping"
  town="Castlewellan / Dromara"
  fontHref={fontHref}
  bannerNote="The hillside bell tent and stacked farm firewood scenes are AI-generated visualisations. Pitch enquiries compose a direct email to SlieveCroobCamping@Outlook.com or call/WhatsApp 07522 077970."
>
  <header class="sc-header">
    <div class="sc-wrap sc-header-inner">
      <a class="sc-brand" href="#top">
        <span class="sc-elev">54°19'N · 5°59'W</span>
        <strong>Slieve Croob Camping</strong>
      </a>
      <nav class="sc-nav" aria-label="Slieve Croob Camping">
        <a href="#calculator">Pitch Rates</a>
        <a href="#facilities">Farm Facilities</a>
        <a href="#trails">Dromara &amp; Mournes</a>
      </nav>
      <a class="sc-header-cta" href={phoneHref}>Call {phone}</a>
    </div>
  </header>

  <main id="top" class="sc-main">
    <section class="sc-hero" aria-labelledby="sc-hero-title">
      <figure class="sc-hero-media">
        <ResponsiveImage
          src="/media/concepts/slieve-croob-camping/slieve-croob-ridge-camp.jpg"
          alt="Lantern-lit canvas tent pitched on a green Dromara hillside beside drystone walls looking across to the Mourne Mountains at dusk"
          width={1376}
          height={768}
          loading="eager"
          sizes="100vw"
          class="sc-hero-img"
        />
        <figcaption class="sc-hero-cap">Dromara Hills pitch overlooking the Mournes. Visualisation (AI-generated).</figcaption>
      </figure>
      <div class="sc-hero-scrim" aria-hidden="true"></div>

      <div class="sc-wrap sc-hero-inner">
        <p class="sc-kicker">Area of Outstanding Natural Beauty · Dromara Hills</p>
        <h1 id="sc-hero-title">Pitch high on our family farm, <em>looking straight across the Mournes.</em></h1>
        <p class="sc-lede">
          Simple, honest countryside camping for motorhomes, caravans and tents
          — £20 a night, firewood logs on the farm, and the Slieve Croob
          mountain path within walking distance.
        </p>
        <div class="sc-hero-actions">
          <a class="sc-btn sc-btn--gorse" href="#calculator">Estimate &amp; request a pitch</a>
          <a class="sc-btn sc-btn--ghost" href={whatsappHref} rel="noopener noreferrer">WhatsApp {phone} ↗</a>
        </div>
      </div>
    </section>

    <section class="sc-calc-section" id="calculator" aria-labelledby="sc-calc-title">
      <div class="sc-wrap sc-calc-grid">
        <div class="sc-calc-intro">
          <p class="sc-kicker sc-kicker--dark">Clear Farm Rates · No Hidden Extras</p>
          <h2 id="sc-calc-title">£20 per night — motorhome, caravan or tent.</h2>
          <p>
            Pick your setup and nights below to see the exact pitch total and
            send your arrival details straight to our family farm.
          </p>

          <dl class="sc-rate-ledger">
            <div><dt>Motorhomes</dt><dd>£20 / night</dd></div>
            <div><dt>Caravans</dt><dd>£20 / night</dd></div>
            <div><dt>Tents</dt><dd>£20 / night</dd></div>
            <div><dt>Extra car</dt><dd>£5 / night</dd></div>
            <div><dt>Check-in / Check-out</dt><dd>12:30 – 20:00 / by 12:00</dd></div>
          </dl>
        </div>

        <form class="sc-calc-card" id="sc-form" data-email={email}>
          <div class="sc-calc-top">
            <span>Estimated Pitch Total</span>
            <strong id="sc-total">£40</strong>
          </div>

          <div class="sc-row">
            <label>
              <span>Pitch type (£20/night)</span>
              <select name="pitch" id="sc-pitch">
                <option value="Motorhome">Motorhome (£20/night)</option>
                <option value="Caravan">Caravan (£20/night)</option>
                <option value="Tent">Tent (£20/night)</option>
              </select>
            </label>
            <label>
              <span>Number of nights</span>
              <input type="number" name="nights" id="sc-nights" min="1" max="14" value="2" required />
            </label>
          </div>

          <div class="sc-row">
            <label>
              <span>Arrival date</span>
              <input type="date" name="arrival" required />
            </label>
            <label>
              <span>Extra cars (£5/night)</span>
              <select name="extraCars" id="sc-extra">
                <option value="0">None</option>
                <option value="1">1 extra car (+£5/night)</option>
                <option value="2">2 extra cars (+£10/night)</option>
              </select>
            </label>
          </div>

          <div class="sc-row">
            <label>
              <span>Your name</span>
              <input name="name" autocomplete="name" required />
            </label>
            <label>
              <span>Phone number</span>
              <input name="phone" type="tel" autocomplete="tel" required />
            </label>
          </div>

          <label class="sc-check">
            <input type="checkbox" name="logs" value="Yes" />
            <span>Interested in firewood logs from the farm</span>
          </label>

          <button class="sc-btn sc-btn--pine sc-btn--full" type="submit">Open pitch request email →</button>
          <p class="sc-form-alt">
            Prefer a quick text or call? Ring <a href={phoneHref}>{phoneIntl}</a> or{" "}
            <a href={whatsappHref} rel="noopener noreferrer">message on WhatsApp ↗</a>.
          </p>
        </form>
      </div>
    </section>

    <section class="sc-farm-band" id="facilities" aria-labelledby="sc-fac-title">
      <div class="sc-wrap sc-farm-grid">
        <figure class="sc-logs-plate">
          <ResponsiveImage
            src="/media/concepts/slieve-croob-camping/slieve-croob-farm-logs.jpg"
            alt="Seasoned split ash firewood logs stacked beside a fieldstone wall and glowing camp firepit overlooking misty hills"
            width={1200}
            height={896}
            sizes="(max-width: 960px) 100vw, 48vw"
            class="sc-logs-img"
          />
          <figcaption>Family farm firewood &amp; firepit evening mood. Visualisation (AI-generated).</figcaption>
        </figure>

        <div class="sc-farm-copy">
          <p class="sc-kicker sc-kicker--dark">Practical Site Facilities</p>
          <h2 id="sc-fac-title">Everything you need for a clean, easy camp.</h2>
          <ul class="sc-fac-list">
            {facilities.map((f) => <li>{f}</li>)}
          </ul>
          <a class="sc-btn sc-btn--outline" href={mapHref} rel="noopener noreferrer">Open coordinates in Google Maps ↗</a>
        </div>
      </div>
    </section>

    <section class="sc-trails" id="trails" aria-labelledby="sc-trails-title">
      <div class="sc-wrap">
        <p class="sc-kicker">Topographic Field Guide · From the Gate</p>
        <h2 id="sc-trails-title">Slieve Croob on foot, the Mournes on the horizon.</h2>

        <ol class="sc-trail-grid">
          {landmarks.map((l, i) => (
            <li class="sc-trail-item">
              <div class="sc-trail-meta">
                <span>0{i + 1}</span>
                <span>{l.dist}</span>
              </div>
              <h3>{l.name}</h3>
              <p>{l.note}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>

  <footer class="sc-footer">
    <div class="sc-wrap sc-footer-inner">
      <span><strong>Slieve Croob Camping</strong> · Dromara Hills, Slieve Croob, County Down</span>
      <span><a href={phoneHref}>{phoneIntl}</a> · <a href={`mailto:${email}`}>{email}</a> · <a href={mapHref} rel="noopener noreferrer">Map ↗</a></span>
    </div>
  </footer>

  <script>
    const nightsEl = document.getElementById("sc-nights") as HTMLInputElement | null;
    const extraEl = document.getElementById("sc-extra") as HTMLSelectElement | null;
    const totalEl = document.getElementById("sc-total");
    const updateTotal = () => {
      const nights = Math.max(1, Number(nightsEl?.value || 1));
      const extras = Math.max(0, Number(extraEl?.value || 0));
      const total = nights * (20 + extras * 5);
      if (totalEl) totalEl.textContent = `£${total}`;
    };
    nightsEl?.addEventListener("input", updateTotal);
    extraEl?.addEventListener("change", updateTotal);

    const form = document.getElementById("sc-form") as HTMLFormElement | null;
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const d = new FormData(form);
      const nights = Math.max(1, Number(d.get("nights") || 1));
      const extras = Math.max(0, Number(d.get("extraCars") || 0));
      const total = nights * (20 + extras * 5);
      const body = [
        `Pitch type: ${d.get("pitch") || "Tent"}`,
        `Arrival date: ${d.get("arrival") || ""}`,
        `Nights: ${nights}`,
        `Extra cars: ${extras}`,
        `Estimated pitch total: £${total}`,
        `Firewood logs enquiry: ${d.get("logs") ? "Yes" : "No"}`,
        "",
        `Name: ${d.get("name") || ""}`,
        `Phone: ${d.get("phone") || ""}`,
      ].join("\n");
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`Pitch Request (${d.get("pitch")}) — Slieve Croob Camping`)}&body=${encodeURIComponent(body)}`;
    });
  </script>
</ConceptLayout>
