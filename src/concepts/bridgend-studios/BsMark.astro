---
interface Props {
  size?: number;
  tone?: "amber" | "obsidian" | "paper";
}
const { size = 40, tone = "amber" } = Astro.props;
const stroke = tone === "obsidian" ? "#141416" : tone === "paper" ? "#f5f3ef" : "#c79252";
---
<svg width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <rect x="4" y="8" width="40" height="32" rx="3" stroke={stroke} stroke-width="1.5" />
  <circle cx="24" cy="24" r="9.5" stroke={stroke} stroke-width="1.6" />
  <circle cx="24" cy="24" r="3.5" stroke={stroke} stroke-width="1.3" />
  <path d="M12 14H17" stroke={stroke} stroke-width="1.6" stroke-linecap="round" />
</svg>
