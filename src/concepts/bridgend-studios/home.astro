---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";
import BsMark from "./BsMark.astro";

/* Bridgend Studios — Michael Sheppard Photography, 1 Kilmore Road, Crossgar, BT30 9HJ.
   Sources (live-fetched 26 Nov 2026): http://www.bridgendstudios.com/ (/, /wedding-photography,
   /portrait-photography, /commercial-photography, /contact).
   - Weddings: planned with couple & both sets of parents; two photographers on
     every wedding from bridal prep through after the first dance; password-
     protected online gallery usually within a week.
   - Portraits: bump to babies, families (studio accommodates up to 20 family
     members), First Communions, Confirmations, Smash the Cake, corporate
     portraits. ~1 hour shoot £45 with high-res digital images; in-house framing
     from £75 and custom collages (naomi@bridgendstudios.com).
   - Commercial & Events: product, staff portraits, fashion, PR, events — studio
     or transportable on-site setup, royalty-free high-res images
     (michael@bridgendstudios.com). Studio Hire also available.
   - Phone: (028) 44 027 127 · Mobile: 07710 716892.
   - Client recommendations quoted verbatim from the live homepage.
   Brief: research/concepts/bridgend-studios/bridgend-studios-elevation-brief.md */

const landline = "028 4402 7127";
const landlineHref = "tel:+442844027127";
const mobile = "07710 716892";
const mobileHref = "tel:+447710716892";
const michaelEmail = "michael@bridgendstudios.com";
const naomiEmail = "naomi@bridgendstudios.com";
const facebook = "https://www.facebook.com/pages/Michael-Sheppard-Photography/156297884937";
const mapHref = "https://www.google.com/maps/search/?api=1&query=1+Kilmore+Road+Crossgar+BT30+9HJ";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;1,6..96,400;1,6..96,500&family=Jost:wght@400;500;600;700&display=swap";

const frames = [
  {
    code: "01A",
    name: "Wedding Photography",
    meta: "Two photographers · Full day · Gallery usually within 1 week",
    body: "Planned directly with the couple and both sets of parents. Two photographers document your day unobtrusively from bridal preparation through speeches, cake cutting and beyond the first dance.",
    cta: "Check a wedding date →",
    tab: "wedding",
  },
  {
    code: "02A",
    name: "Studio Portraits",
    meta: "£45 shoot (~1 hr) · Up to 20 family members",
    body: "Relaxed, child-friendly studio sessions from bump to babies, First Communions, Confirmations, Smash the Cake and extended family groups — supplied with high-resolution digital images.",
    cta: "Book a £45 studio shoot →",
    tab: "portrait",
  },
  {
    code: "03A",
    name: "Commercial & Studio Hire",
    meta: "Crossgar studio or transportable on-site setup",
    body: "Product shoots, staff portraits, fashion, PR campaigns and business events supplied royalty-free in high resolution — plus equipped studio hire on Kilmore Road.",
    cta: "Discuss a commercial brief →",
    tab: "commercial",
  },
];

const quotes = [
  {
    quote: "We had the baby right through to the grandparents. Straight away the whole family were at ease and it became a 'fun' event. We were delighted with the pictures when they came back — wonderful memories.",
    who: "Paul Griffiths",
    role: "Senior Account Manager, Fleet Financial Ltd, Belfast",
  },
  {
    quote: "I have hired Michael three times now in a matter of weeks because I was so impressed with the first project, including location work for my book launch in Belfast. Professional, on time and creative.",
    who: "Sinead McGarrigle",
    role: "Author & Owner of Lifetime Health, Seaforde",
  },
  {
    quote: "Throughout the photo shoot he was brilliant with dealing with my kids and listened to our needs. The results speak for themselves.",
    who: "Paul McEntee",
    role: "Recruitment Partner, Staff Source Ltd, Belfast",
  },
];
---

<ConceptLayout
  title="Bridgend Studios — Wedding, Portrait & Commercial Photography, Crossgar"
  slug="bridgend-studios"
  bodyClass="concept-page concept-bridgend"
  lang="en-GB"
  businessName="Bridgend Studios"
  town="Crossgar"
  fontHref={fontHref}
  bannerNote="The monochrome wedding lane and darkroom framing workshop plates are AI-generated visualisations. Portrait and framing enquiries route to naomi@bridgendstudios.com; wedding and commercial enquiries route to michael@bridgendstudios.com."
>
  <header class="bs-header">
    <div class="bs-wrap bs-header-inner">
      <a class="bs-brand" href="#top">
        <BsMark size={30} tone="amber" />
        <span>Bridgend Studios</span>
      </a>
      <nav class="bs-nav" aria-label="Bridgend Studios">
        <a href="#contact-sheet">Contact Sheet</a>
        <a href="#framing">In-House Framing</a>
        <a href="#reviews">Client Words</a>
        <a href="#enquire">Book a Date</a>
      </nav>
      <a class="bs-header-tel" href={mobileHref}>{mobile}</a>
    </div>
  </header>

  <main id="top" class="bs-main">
    <section class="bs-hero" aria-labelledby="bs-hero-title">
      <figure class="bs-hero-media">
        <ResponsiveImage
          src="/media/concepts/bridgend-studios/bridgend-studios-wedding-frame.jpg"
          alt="Monochrome fine-art documentary photograph of a bride and groom seen from behind walking down a misty County Down stone lane at dusk"
          width={1376}
          height={768}
          loading="eager"
          sizes="100vw"
          class="bs-hero-img"
        />
        <figcaption class="bs-hero-cap">Fine-art monochrome wedding mood. Visualisation (AI-generated).</figcaption>
      </figure>
      <div class="bs-hero-scrim" aria-hidden="true"></div>

      <div class="bs-wrap bs-hero-inner">
        <p class="bs-kicker">Michael Sheppard Photography · 1 Kilmore Road, Crossgar</p>
        <h1 id="bs-hero-title">Weddings, family portraits <em>&amp; in-house framing.</em></h1>
        <p class="bs-lede">
          Two photographers on every wedding day with online galleries usually
          ready within a week, £45 one-hour studio portrait shoots for up to 20
          family members, and bespoke framing made in Crossgar.
        </p>
        <div class="bs-hero-actions">
          <a class="bs-btn bs-btn--amber" href="#enquire">Check a wedding or studio date</a>
          <a class="bs-btn bs-btn--ghost" href={landlineHref}>Studio · {landline}</a>
        </div>
      </div>
    </section>

    <section class="bs-filmstrip" id="contact-sheet" aria-labelledby="bs-sheet-title">
      <div class="bs-sprockets" aria-hidden="true"></div>
      <div class="bs-wrap bs-film-inner">
        <div class="bs-sheet-head">
          <p class="bs-kicker">35mm Contact Sheet · Crossgar &amp; Across Northern Ireland</p>
          <h2 id="bs-sheet-title">Three ways to work with the studio.</h2>
        </div>

        <div class="bs-frames">
          {frames.map((f) => (
            <article class="bs-frame">
              <div class="bs-frame-edge">
                <span>FRAME {f.code}</span>
                <span>BRIDGEND · BT30</span>
              </div>
              <div class="bs-frame-body">
                <p class="bs-frame-meta">{f.meta}</p>
                <h3>{f.name}</h3>
                <p>{f.body}</p>
                <a class="bs-frame-cta" href="#enquire" data-pick-shoot={f.tab}>{f.cta}</a>
              </div>
            </article>
          ))}
        </div>
      </div>
      <div class="bs-sprockets" aria-hidden="true"></div>
    </section>

    <section class="bs-framing" id="framing" aria-labelledby="bs-framing-title">
      <div class="bs-wrap bs-framing-grid">
        <div class="bs-frame-preview-col">
          <div class="bs-wall-mount is-black" id="bs-wall-mount">
            <div class="bs-mat">
              <figure class="bs-print">
                <ResponsiveImage
                  src="/media/concepts/bridgend-studios/bridgend-studios-darkroom-portrait.jpg"
                  alt="Photography studio and framing workshop interior with black, oak and brass frames beside a medium-format camera"
                  width={1200}
                  height={896}
                  sizes="(max-width: 960px) 100vw, 48vw"
                  class="bs-print-img"
                />
              </figure>
            </div>
          </div>
          <p class="bs-frame-disclosure">
            Studio &amp; framing workshop mood. Visualisation (AI-generated). Preview finish:{" "}
            <strong id="bs-frame-label">Matte Black Gallery Moulding</strong>
          </p>
        </div>

        <div class="bs-framing-copy">
          <p class="bs-kicker bs-kicker--dark">In-House Framing · Framed Images From £75</p>
          <h2 id="bs-framing-title">Shoot in the studio, leave with art ready for the wall.</h2>
          <p>
            Our spacious Crossgar studio welcomes everything from newborns and
            First Communions to three-generation family portraits (up to 20
            people) for <strong>£45 for a one-hour session</strong> including
            high-resolution digital images. When you want prints mounted properly,
            Naomi handles our <strong>in-house framing from £75</strong> and
            custom multi-image collages.
          </p>

          <div class="bs-swatches" role="group" aria-label="Preview frame finish">
            <button type="button" class="bs-swatch is-active" data-frame="black" data-label="Matte Black Gallery Moulding">
              <span class="bs-swatch-chip bs-chip--black" aria-hidden="true"></span>
              Matte Black
            </button>
            <button type="button" class="bs-swatch" data-frame="oak" data-label="Warm Brushed Oak Moulding">
              <span class="bs-swatch-chip bs-chip--oak" aria-hidden="true"></span>
              Brushed Oak
            </button>
            <button type="button" class="bs-swatch" data-frame="brass" data-label="Aged Antique Brass Moulding">
              <span class="bs-swatch-chip bs-chip--brass" aria-hidden="true"></span>
              Antique Brass
            </button>
          </div>

          <div class="bs-framing-actions">
            <a class="bs-btn bs-btn--dark" href="#enquire" data-pick-shoot="portrait">Ask Naomi about portraits &amp; framing →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="bs-reviews" id="reviews" aria-labelledby="bs-reviews-title">
      <div class="bs-wrap">
        <p class="bs-kicker">Client Recommendations</p>
        <h2 id="bs-reviews-title">In their own words.</h2>

        <div class="bs-quote-list">
          {quotes.map((q) => (
            <blockquote class="bs-quote">
              <p>“{q.quote}”</p>
              <footer>
                <strong>{q.who}</strong>
                <span>{q.role}</span>
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <section class="bs-enquire" id="enquire" aria-labelledby="bs-enquire-title">
      <div class="bs-wrap bs-enquire-grid">
        <div class="bs-enquire-copy">
          <p class="bs-kicker bs-kicker--dark">Direct Studio Desk</p>
          <h2 id="bs-enquire-title">Check a date or framing quote.</h2>
          <p>
            Select what you are booking and your email routes directly to the
            right inbox —{" "}
            <a href={`mailto:${michaelEmail}`}>{michaelEmail}</a> for weddings,
            commercial shoots &amp; studio hire, or{" "}
            <a href={`mailto:${naomiEmail}`}>{naomiEmail}</a> for family
            portraits and in-house framing.
          </p>
          <div class="bs-studio-card" id="find">
            <p><strong>1 Kilmore Road, Crossgar, BT30 9HJ</strong></p>
            <p>Studio: <a href={landlineHref}>{landline}</a> · Mobile: <a href={mobileHref}>{mobile}</a></p>
            <p>
              <a href={mapHref} rel="noopener noreferrer">Open Google Maps ↗</a> ·{" "}
              <a href={facebook} rel="noopener noreferrer">Facebook ↗</a>
            </p>
          </div>
        </div>

        <form class="bs-form" id="bs-form" data-michael={michaelEmail} data-naomi={naomiEmail}>
          <div class="bs-row">
            <label>
              <span>Type of shoot</span>
              <select name="shoot" id="bs-shoot">
                <option value="wedding">Wedding Photography (to Michael)</option>
                <option value="portrait">Studio Portrait / Framing (to Naomi)</option>
                <option value="commercial">Commercial / Events / Studio Hire (to Michael)</option>
              </select>
            </label>
            <label>
              <span>Date or preferred month</span>
              <input name="date" placeholder="e.g. 18 July 2027" />
            </label>
          </div>
          <div class="bs-row">
            <label>
              <span>Your name</span>
              <input name="name" autocomplete="name" required />
            </label>
            <label>
              <span>Phone number</span>
              <input name="phone" type="tel" autocomplete="tel" required />
            </label>
          </div>
          <label>
            <span>Tell us about the day or shoot</span>
            <textarea name="details" rows="3" placeholder="Venue, group size, commercial brief or framing request"></textarea>
          </label>
          <button class="bs-btn bs-btn--dark bs-btn--full" type="submit" id="bs-submit-btn">Open email to Michael →</button>
        </form>
      </div>
    </section>
  </main>

  <footer class="bs-footer">
    <div class="bs-wrap bs-footer-inner">
      <span><strong>Bridgend Studios</strong> · Michael Sheppard Photography · 1 Kilmore Road, Crossgar, BT30 9HJ</span>
      <span><a href={landlineHref}>{landline}</a> · <a href={mobileHref}>{mobile}</a> · <a href={`mailto:${michaelEmail}`}>{michaelEmail}</a></span>
    </div>
  </footer>

  <script>
    const mount = document.getElementById("bs-wall-mount");
    const frameLabel = document.getElementById("bs-frame-label");
    const swatches = document.querySelectorAll<HTMLButtonElement>(".bs-swatch");
    swatches.forEach((sw) => {
      sw.addEventListener("click", () => {
        const mode = sw.dataset.frame ?? "black";
        if (mount) {
          mount.classList.remove("is-black", "is-oak", "is-brass");
          mount.classList.add(`is-${mode}`);
        }
        if (frameLabel && sw.dataset.label) frameLabel.textContent = sw.dataset.label;
        swatches.forEach((btn) => btn.classList.toggle("is-active", btn === sw));
      });
    });

    const shootSelect = document.getElementById("bs-shoot") as HTMLSelectElement | null;
    const submitBtn = document.getElementById("bs-submit-btn");
    const updateRecipientLabel = () => {
      if (!submitBtn || !shootSelect) return;
      submitBtn.textContent = shootSelect.value === "portrait"
        ? "Open email to Naomi →"
        : "Open email to Michael →";
    };
    shootSelect?.addEventListener("change", updateRecipientLabel);

    document.querySelectorAll<HTMLElement>("[data-pick-shoot]").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (shootSelect && btn.dataset.pickShoot) {
          shootSelect.value = btn.dataset.pickShoot;
          updateRecipientLabel();
        }
      });
    });

    const form = document.getElementById("bs-form") as HTMLFormElement | null;
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const d = new FormData(form);
      const shoot = String(d.get("shoot") || "wedding");
      const to = shoot === "portrait"
        ? (form.dataset.naomi ?? "naomi@bridgendstudios.com")
        : (form.dataset.michael ?? "michael@bridgendstudios.com");
      const labels: Record<string, string> = {
        wedding: "Wedding Photography Enquiry",
        portrait: "Portrait & Framing Enquiry",
        commercial: "Commercial / Studio Hire Enquiry",
      };
      const body = [
        `Shoot: ${labels[shoot] ?? shoot}`,
        `Date / month: ${d.get("date") || "To confirm"}`,
        `Name: ${d.get("name") || ""}`,
        `Phone: ${d.get("phone") || ""}`,
        "",
        String(d.get("details") || ""),
      ].join("\n");
      window.location.href = `mailto:${to}?subject=${encodeURIComponent(`${labels[shoot] ?? "Enquiry"} — Bridgend Studios`)}&body=${encodeURIComponent(body)}`;
    });
  </script>
</ConceptLayout>
