---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import BsMark from "./BsMark.astro";

/* Bridgend Studios — Michael Sheppard Photography, 1 Kilmore Road, Crossgar, BT30 9HJ.
   Sources (live-fetched 26 Nov 2026): http://www.bridgendstudios.com/ (/, /wedding-photography,
   /portrait-photography, /commercial-photography, /contact).
   - Weddings: planned with couple & both sets of parents; two photographers on
     every wedding from bridal prep through after the first dance; password-
     protected online gallery usually within a week.
   - Portraits: bump to babies, families (studio accommodates up to 20 family
     members), First Communions, Confirmations, Smash the Cake, corporate
     portraits. ~1 hour shoot £45 with high-res digital images; in-house framing
     from £75 and custom collages (naomi@bridgendstudios.com).
   - Commercial & Events: product, staff portraits, fashion, PR, events — studio
     or transportable on-site setup, royalty-free high-res images
     (michael@bridgendstudios.com). Studio Hire also available.
   - Phone: (028) 44 027 127 · Mobile: 07710 716892.
   - Client recommendations quoted verbatim from the live homepage.
   Brief: research/concepts/bridgend-studios/bridgend-studios-elevation-brief.md */

const landline = "028 4402 7127";
const landlineHref = "tel:+442844027127";
const mobile = "07710 716892";
const mobileHref = "tel:+447710716892";
const michaelEmail = "michael@bridgendstudios.com";
const naomiEmail = "naomi@bridgendstudios.com";
const facebook = "https://www.facebook.com/pages/Michael-Sheppard-Photography/156297884937";
const mapHref = "https://www.google.com/maps/search/?api=1&query=1+Kilmore+Road+Crossgar+BT30+9HJ";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,500;0,6..96,600;1,6..96,500&family=Jost:wght@400;500;600;700&display=swap";

const services = [
  {
    no: "01",
    name: "Wedding Photography",
    meta: "Two photographers · Full day",
    body: "Planned directly with the couple and both sets of parents. Two photographers cover your day unobtrusively from bridal preparation through speeches, cake cutting and beyond the first dance — with a password-protected online gallery usually ready within a week.",
    cta: "Check a wedding date",
    tab: "wedding",
  },
  {
    no: "02",
    name: "Studio Portraits & Framing",
    meta: "£45 shoot (~1 hr) · Framing from £75",
    body: "Relaxed, child-friendly studio sessions from bump to babies, First Communions, Confirmations, Smash the Cake and extended family groups up to 20 people. High-resolution digital images included, with in-house framing and custom collages available.",
    cta: "Book a portrait session",
    tab: "portrait",
  },
  {
    no: "03",
    name: "Commercial, Events & Studio Hire",
    meta: "In-studio or on location",
    body: "Product photography, staff portraits, fashion, PR campaigns and business events — shot in our equipped Crossgar studio or on location with our fully transportable lighting setup, supplied royalty-free in high resolution.",
    cta: "Discuss a commercial brief",
    tab: "commercial",
  },
];

const quotes = [
  {
    quote: "We had the baby right through to the grandparents. Straight away the whole family were at ease and it became a 'fun' event. We were delighted with the pictures when they came back — wonderful memories.",
    who: "Paul Griffiths",
    role: "Senior Account Manager, Fleet Financial Ltd, Belfast",
  },
  {
    quote: "I have hired Michael three times now in a matter of weeks because I was so impressed with the first project, including location work for my book launch in Belfast. Professional, on time and creative.",
    who: "Sinead McGarrigle",
    role: "Author & Owner of Lifetime Health, Seaforde",
  },
  {
    quote: "Throughout the photo shoot he was brilliant with dealing with my kids and listened to our needs. The results speak for themselves.",
    who: "Paul McEntee",
    role: "Recruitment Partner, Staff Source Ltd, Belfast",
  },
];
---

<ConceptLayout
  title="Bridgend Studios — Wedding, Portrait & Commercial Photography, Crossgar"
  slug="bridgend-studios"
  bodyClass="concept-page concept-bridgend"
  lang="en-GB"
  businessName="Bridgend Studios"
  town="Crossgar"
  fontHref={fontHref}
  bannerNote="The camera emblem is drawn for this page. Portrait and framing enquiries open an email to naomi@bridgendstudios.com; wedding and commercial enquiries go to michael@bridgendstudios.com."
>
  <div class="bs-strip">
    <span>1 Kilmore Road, Crossgar, BT30 9HJ · Michael Sheppard Photography</span>
    <span><a href={landlineHref}>{landline}</a> · <a href={mobileHref}>{mobile}</a></span>
  </div>

  <header class="bs-header">
    <a class="bs-brand" href="#top">
      <BsMark size={38} tone="amber" />
      <span class="bs-brand-text">
        <strong>Bridgend Studios</strong>
        <small>Crossgar · County Down</small>
      </span>
    </a>
    <nav class="bs-nav" aria-label="Bridgend Studios">
      <a href="#services">Services</a>
      <a href="#reviews">Client Words</a>
      <a href="#enquire">Book a Shoot</a>
      <a href="#find">Studio</a>
    </nav>
    <a class="bs-header-cta" href="#enquire">Check a date</a>
  </header>

  <main id="top">
    <section class="bs-hero" aria-labelledby="bs-hero-title">
      <div class="bs-wrap bs-hero-grid">
        <div>
          <p class="bs-kicker">1 Kilmore Road · Crossgar</p>
          <h1 id="bs-hero-title">Weddings, family portraits <em>and commercial photography.</em></h1>
          <p class="bs-lede">
            Relaxed photography by Michael Sheppard from our spacious studio in
            Crossgar and on location across Northern Ireland — two photographers
            at every wedding, £45 family studio sessions, and in-house framing.
          </p>
          <div class="bs-hero-actions">
            <a class="bs-btn bs-btn--amber" href="#enquire">Check availability</a>
            <a class="bs-btn bs-btn--ghost" href={mobileHref}>Call {mobile}</a>
          </div>
        </div>

        <aside class="bs-facts" aria-label="Studio details">
          <p class="bs-kicker">At a glance</p>
          <dl>
            <div><dt>Weddings</dt><dd>Two photographers · Full day · Online gallery usually within a week</dd></div>
            <div><dt>Family &amp; Portraits</dt><dd>£45 one-hour studio shoot · Up to 20 family members</dd></div>
            <div><dt>In-house Framing</dt><dd>Framed images from £75 &amp; bespoke collages</dd></div>
            <div><dt>Commercial &amp; Hire</dt><dd>Crossgar studio or transportable on-site setup</dd></div>
          </dl>
        </aside>
      </div>
    </section>

    <section class="bs-section bs-services" id="services" aria-labelledby="bs-services-title">
      <div class="bs-wrap">
        <p class="bs-kicker bs-kicker--dark">What We Shoot</p>
        <h2 id="bs-services-title">Three clear ways to work with the studio.</h2>
        <div class="bs-service-grid">
          {services.map((s) => (
            <article class="bs-service-card">
              <div class="bs-service-top">
                <span class="bs-no">{s.no}</span>
                <span class="bs-meta">{s.meta}</span>
              </div>
              <h3>{s.name}</h3>
              <p>{s.body}</p>
              <a class="bs-btn bs-btn--dark" href="#enquire" data-pick-shoot={s.tab}>{s.cta}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bs-section bs-reviews" id="reviews" aria-labelledby="bs-reviews-title">
      <div class="bs-wrap">
        <p class="bs-kicker">Client Recommendations</p>
        <h2 id="bs-reviews-title">In their own words.</h2>
        <div class="bs-quote-grid">
          {quotes.map((q) => (
            <blockquote class="bs-quote">
              <p>“{q.quote}”</p>
              <footer>
                <strong>{q.who}</strong>
                <span>{q.role}</span>
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <section class="bs-section bs-enquire" id="enquire" aria-labelledby="bs-enquire-title">
      <div class="bs-wrap bs-enquire-grid">
        <div>
          <p class="bs-kicker bs-kicker--dark">Enquire Directly</p>
          <h2 id="bs-enquire-title">Check a wedding date, portrait slot or framing quote.</h2>
          <p>
            Choose the type of shoot and we will route your email straight to
            the right person —{" "}
            <a href={`mailto:${michaelEmail}`}>{michaelEmail}</a> for weddings,
            commercial work and studio hire, or{" "}
            <a href={`mailto:${naomiEmail}`}>{naomiEmail}</a> for portraits and
            in-house framing.
          </p>
          <p class="bs-tel-note">
            Prefer to talk? Ring <a href={landlineHref}>{landline}</a> or{" "}
            <a href={mobileHref}>{mobile}</a>.
          </p>
        </div>

        <form class="bs-form" id="bs-form" data-michael={michaelEmail} data-naomi={naomiEmail}>
          <div class="bs-row">
            <label>
              <span>Type of shoot</span>
              <select name="shoot" id="bs-shoot">
                <option value="wedding">Wedding Photography (to Michael)</option>
                <option value="portrait">Studio Portrait / Framing (to Naomi)</option>
                <option value="commercial">Commercial / Events / Studio Hire (to Michael)</option>
              </select>
            </label>
            <label>
              <span>Date or preferred month</span>
              <input name="date" placeholder="e.g. Saturday 18 July 2027" />
            </label>
          </div>
          <div class="bs-row">
            <label>
              <span>Your name</span>
              <input name="name" autocomplete="name" required />
            </label>
            <label>
              <span>Phone number</span>
              <input name="phone" type="tel" autocomplete="tel" required />
            </label>
          </div>
          <label>
            <span>Tell us about the day or shoot</span>
            <textarea name="details" rows="3" placeholder="Venue, group size, commercial brief or framing request"></textarea>
          </label>
          <button class="bs-btn bs-btn--dark bs-btn--full" type="submit">Open enquiry email →</button>
        </form>
      </div>
    </section>

    <section class="bs-section bs-find" id="find" aria-labelledby="bs-find-title">
      <div class="bs-wrap bs-find-inner">
        <div>
          <p class="bs-kicker bs-kicker--dark">The Studio</p>
          <h2 id="bs-find-title">1 Kilmore Road, Crossgar, BT30 9HJ.</h2>
          <p>Easy reach from Downpatrick, Saintfield, Ballynahinch and Belfast — and happy to travel across Northern Ireland for weddings and location shoots.</p>
        </div>
        <div class="bs-find-actions">
          <a class="bs-btn bs-btn--dark" href={mapHref} rel="noopener noreferrer">Open Google Maps ↗</a>
          <a class="bs-btn bs-btn--outline" href={facebook} rel="noopener noreferrer">Facebook ↗</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="bs-footer">
    <div class="bs-wrap bs-footer-inner">
      <div class="bs-footer-brand">
        <BsMark size={30} tone="paper" />
        <div>
          <strong>Bridgend Studios</strong>
          <span>1 Kilmore Road, Crossgar, BT30 9HJ</span>
        </div>
      </div>
      <p class="bs-footer-right">
        <a href={landlineHref}>{landline}</a> · <a href={mobileHref}>{mobile}</a> · <a href={`mailto:${michaelEmail}`}>{michaelEmail}</a>
      </p>
    </div>
  </footer>

  <script>
    const shootSelect = document.getElementById("bs-shoot") as HTMLSelectElement | null;
    document.querySelectorAll<HTMLElement>("[data-pick-shoot]").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (shootSelect && btn.dataset.pickShoot) shootSelect.value = btn.dataset.pickShoot;
      });
    });

    const form = document.getElementById("bs-form") as HTMLFormElement | null;
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const d = new FormData(form);
      const shoot = String(d.get("shoot") || "wedding");
      const to = shoot === "portrait"
        ? (form.dataset.naomi ?? "naomi@bridgendstudios.com")
        : (form.dataset.michael ?? "michael@bridgendstudios.com");
      const labels: Record<string, string> = {
        wedding: "Wedding Photography Enquiry",
        portrait: "Portrait & Framing Enquiry",
        commercial: "Commercial / Studio Hire Enquiry",
      };
      const body = [
        `Shoot: ${labels[shoot] ?? shoot}`,
        `Date / month: ${d.get("date") || "To confirm"}`,
        `Name: ${d.get("name") || ""}`,
        `Phone: ${d.get("phone") || ""}`,
        "",
        String(d.get("details") || ""),
      ].join("\n");
      window.location.href = `mailto:${to}?subject=${encodeURIComponent(`${labels[shoot] ?? "Enquiry"} — Bridgend Studios`)}&body=${encodeURIComponent(body)}`;
    });
  </script>
</ConceptLayout>
