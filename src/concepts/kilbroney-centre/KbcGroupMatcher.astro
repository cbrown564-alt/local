---
/* The Kilbroney Centre — Deep Oak-Forest Stage with Stays, Grounds & Group Retreats Tabs. */
const programmes = [
  {
    id: "stays",
    label: "Stays",
    groupOption: "Youth / Children's Group",
    title: "Residential accommodation for youth groups, schools and family weekends.",
    points: [
      {
        label: "Youth and schools",
        detail: "Enclosed site off Forestbrook Road with dining hall, meeting rooms and residential space together.",
      },
      {
        label: "Family weekends",
        detail: "Comfortable multi-generational accommodation with shared lounges and dining spaces.",
      },
      {
        label: "Catering options",
        detail: "Catered or self-catering arrangements tailored around your group schedule.",
      },
    ],
    note: "Weekend dates from Friday evening to Sunday afternoon book well ahead; early enquiry is recommended.",
  },
  {
    id: "grounds",
    label: "Grounds",
    groupOption: "Summer Camp",
    title: "Private oak woodland steps from Kilbroney Park, mountain trails and Carlingford Lough.",
    points: [
      {
        label: "Outdoor clearings",
        detail: "Open green space and woodland trails for team games, campfires and evening gatherings.",
      },
      {
        label: "Summer camps",
        detail: "Week-long outdoor programmes across woodland, lough and Mourne mountain trails.",
      },
      {
        label: "Fairy Glen access",
        detail: "Direct walking access into Kilbroney Forest Park and the Fairy Glen.",
      },
    ],
    note: "Summer camp places fill quickly each spring; message the booking desk directly for current dates.",
  },
  {
    id: "retreats",
    label: "Group retreats",
    groupOption: "Adult / Church Retreat",
    title: "Quiet space away from the rush for leadership teams, choirs and parish retreats.",
    points: [
      {
        label: "Unhurried setting",
        detail: "Peaceful Rostrevor oak woodland minutes from village cafés and the Carlingford shore.",
      },
      {
        label: "Gathering rooms",
        detail: "Warm indoor spaces for workshops, quiet days and shared meals.",
      },
      {
        label: "Simple road access",
        detail: "Easy coastal drive along the A2 from Newry, Belfast and Dublin.",
      },
    ],
    note: "Midweek quiet days and single-night leadership stays can be arranged directly on 07342 883538.",
  },
];
---

<section class="kc-stage" id="stays" aria-labelledby="kc-stage-title">
  <div class="kc-wrap" data-kc-planner>
    <div class="kc-stage-head">
      <h2 id="kc-stage-title">Room to gather outdoors and rest inside.</h2>
      <div class="kc-tabs" role="tablist" aria-label="Explore stays, grounds and group retreats">
        {programmes.map((item, idx) => (
          <button
            type="button"
            role="tab"
            id={`kc-tab-${item.id}`}
            aria-controls={`kc-panel-${item.id}`}
            aria-selected={idx === 0 ? "true" : "false"}
            class:list={["kc-tab", idx === 0 && "is-active"]}
            data-kc-tab={item.id}
          >
            {item.label}
          </button>
        ))}
      </div>
    </div>

    <div class="kc-stage-grid">
      <div class="kc-stage-copy">
        {programmes.map((item, idx) => (
          <div
            class="kc-panel"
            role="tabpanel"
            id={`kc-panel-${item.id}`}
            aria-labelledby={`kc-tab-${item.id}`}
            data-kc-panel={item.id}
            hidden={idx !== 0}
          >
            <h3>{item.title}</h3>
            <dl class="kc-stage-ledger">
              {item.points.map((pt) => (
                <div>
                  <dt>{pt.label}</dt>
                  <dd>{pt.detail}</dd>
                </div>
              ))}
            </dl>
            <p class="kc-stage-note">{item.note}</p>
            <a class="kc-stone-btn" href="#enquire" data-kc-prefill={item.groupOption}>
              Check dates for {item.label.toLowerCase()}
            </a>
          </div>
        ))}
      </div>

      <figure class="kc-plate">
        <picture>
          <source
            srcset="/media/concepts/kilbroney-centre/kilbroney-outdoor-activity-640.webp 640w, /media/concepts/kilbroney-centre/kilbroney-outdoor-activity-1265.webp 1265w"
            sizes="(max-width: 900px) 100vw, 46vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/kilbroney-centre/kilbroney-outdoor-activity.jpg"
            alt="Woodland campfire circle with timber benches beside a stone forest trail overlooking Carlingford Lough"
            width="1408"
            height="768"
            loading="lazy"
          />
        </picture>
        <figcaption>Indicative woodland clearing and campfire grounds visualisation.</figcaption>
      </figure>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-kc-planner]");
    if (!root) return;
    const tabs = [...root.querySelectorAll("[data-kc-tab]")];
    const panels = [...root.querySelectorAll("[data-kc-panel]")];

    const selectTab = (id) => {
      const target = tabs.find((t) => t.getAttribute("data-kc-tab") === id);
      if (!target) return;
      tabs.forEach((t) => {
        const active = t === target;
        t.classList.toggle("is-active", active);
        t.setAttribute("aria-selected", active ? "true" : "false");
      });
      panels.forEach((p) => {
        p.hidden = p.getAttribute("data-kc-panel") !== id;
      });
      window.dispatchEvent(new CustomEvent("kc:tab-changed", { detail: { id } }));
    };

    tabs.forEach((btn) => {
      btn.addEventListener("click", () => {
        selectTab(btn.getAttribute("data-kc-tab"));
      });
    });

    window.addEventListener("kc:select-tab", (e) => {
      if (e && e.detail && e.detail.id) {
        selectTab(e.detail.id);
      }
    });

    root.querySelectorAll("[data-kc-prefill]").forEach((link) => {
      link.addEventListener("click", () => {
        const value = link.getAttribute("data-kc-prefill");
        const select = document.querySelector("[data-kc-group-select]");
        if (select && value) {
          select.value = value;
          select.dispatchEvent(new Event("change", { bubbles: true }));
        }
      });
    });
  })();
</script>
