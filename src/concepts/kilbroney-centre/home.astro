---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import KbcGroupMatcher from "./KbcGroupMatcher.astro";
import "./styles.css";

/* The Kilbroney Centre — 1 Forestbrook Road, Rostrevor, Newry BT34 3BT.
   Verified live 27 Nov 2026: residential stays, private oak woodland grounds, youth & family retreats.
   Contacts: 07342 883538, 028 4173 9104, booking@kilbroneycentre.com, FB KilbroneyCentre. */
const mobilePhone = "07342 883538";
const mobileHref = "tel:+447342883538";
const deskPhone = "028 4173 9104";
const deskHref = "tel:+442841739104";
const email = "booking@kilbroneycentre.com";
const fbHref = "https://www.facebook.com/KilbroneyCentre";
const mapsHref =
  "https://www.google.com/maps/search/?api=1&query=The+Kilbroney+Centre+1+Forestbrook+Road+Rostrevor+BT34+3BT";

const stayDropdown = [
  {
    tab: "stays",
    groupOption: "Youth / Children's Group",
    title: "Youth and school stays",
    desc: "Enclosed wooded grounds, dining hall and activity spaces on one site.",
    img: "/media/concepts/kilbroney-centre/kilbroney-woodland-retreat-640.webp",
    note: "Midweek and weekend residential stays",
  },
  {
    tab: "grounds",
    groupOption: "Summer Camp",
    title: "Woodland grounds and camps",
    desc: "Campfire clearings and trail access beside Kilbroney Park and Carlingford Lough.",
    img: "/media/concepts/kilbroney-centre/kilbroney-outdoor-activity-640.webp",
    note: "Forestbrook Road, Rostrevor",
  },
  {
    tab: "retreats",
    groupOption: "Adult / Church Retreat",
    title: "Family and church retreats",
    desc: "Quiet rooms, shared dining tables and unhurried pace beneath the Mournes.",
    img: "/media/concepts/kilbroney-centre/kilbroney-woodland-retreat-640.webp",
    note: "Friday to Sunday and quiet midweek dates",
  },
];
---

<ConceptLayout
  title="The Kilbroney Centre: Woodland Residential and Outdoor Retreat, Rostrevor"
  slug="kilbroney-centre"
  bodyClass="concept-page concept-kilbroney"
  businessName="The Kilbroney Centre"
  town="Rostrevor"
  bannerNote="Imagery comprises indicative Rostrevor oak woodland retreat and outdoor grounds visualisations."
>
  <header class="kc-header" data-kc-header>
    <div class="kc-header-inner">
      <a class="kc-brand" href="#top">The Kilbroney Centre</a>

      <nav class="kc-nav" aria-label="Primary">
        <div class="kc-dd-wrap" data-kc-dd>
          <button
            type="button"
            class="kc-nav-link kc-dd-trigger"
            aria-expanded="false"
            aria-controls="kc-stays-menu"
            data-kc-dd-trigger
          >
            <span>Stays</span>
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path
                d="M2.5 4.5L6 8l3.5-3.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>

          <div class="kc-dd-panel" id="kc-stays-menu" hidden data-kc-dd-panel>
            <ul class="kc-dd-list">
              {stayDropdown.map((item, idx) => (
                <li>
                  <a
                    href="#stays"
                    class:list={["kc-dd-item", idx === 0 && "is-active"]}
                    data-kc-dd-item
                    data-tab-target={item.tab}
                    data-img={item.img}
                    data-note={item.note}
                  >
                    <strong>{item.title}</strong>
                    <span>{item.desc}</span>
                  </a>
                </li>
              ))}
            </ul>
            <div class="kc-dd-preview" aria-hidden="true">
              <div class="kc-dd-photo">
                <img src={stayDropdown[0].img} alt="" width="640" height="349" data-kc-dd-img />
              </div>
              <p class="kc-dd-note" data-kc-dd-note>{stayDropdown[0].note}</p>
            </div>
          </div>
        </div>

        <a class="kc-nav-link" href="#stays" data-kc-jump="grounds">Grounds</a>
        <a class="kc-nav-link" href="#enquire">Book</a>
        <a class="kc-nav-link" href="#location">Rostrevor</a>
      </nav>

      <div class="kc-header-actions">
        <a class="kc-header-tel" href={mobileHref}>{mobilePhone}</a>
        <a class="kc-header-cta" href="#enquire">Enquire</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="kc-hero" aria-labelledby="kc-hero-title">
      <div class="kc-scroll-sentinel" aria-hidden="true" data-kc-sentinel></div>

      <div class="kc-hero-media">
        <picture>
          <source
            srcset="/media/concepts/kilbroney-centre/kilbroney-woodland-retreat-640.webp 640w, /media/concepts/kilbroney-centre/kilbroney-woodland-retreat-1265.webp 1265w"
            sizes="100vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/kilbroney-centre/kilbroney-woodland-retreat.jpg"
            alt="Stone-and-timber residential retreat building nestled among mossy oak trees in Rostrevor with Mourne slopes behind"
            width="1408"
            height="768"
            loading="eager"
          />
        </picture>
        <div class="kc-hero-scrim" aria-hidden="true"></div>
      </div>

      <div class="kc-wrap kc-hero-stage">
        <h1 id="kc-hero-title" class="kc-reveal kc-reveal-1">
          Woodland stays beneath the Mournes.
        </h1>

        <div class="kc-hero-foot kc-reveal kc-reveal-2">
          <div class="kc-hero-copy">
            <p>
              Private oak grounds on Forestbrook Road in Rostrevor for youth groups, family
              weekends, summer camps and retreats.
            </p>
            <a class="kc-stone-btn" href="#enquire">Check group dates</a>
          </div>
          <p class="kc-hero-caption">Indicative Rostrevor woodland retreat visualisation.</p>
        </div>
      </div>
    </section>

    <KbcGroupMatcher />

    <section class="kc-section kc-enquire" id="enquire" aria-labelledby="kc-enq-title">
      <div class="kc-wrap kc-split">
        <div class="kc-col">
          <h2 id="kc-enq-title">Tell us about your group and preferred dates.</h2>
          <p class="kc-body">
            Send an outline of your group type, rough numbers and target weekend or week. We reply
            directly from our Forestbrook Road booking desk with availability and catering options.
          </p>
          <dl class="kc-ledger">
            <div>
              <dt>Mobile and bookings</dt>
              <dd><a href={mobileHref}>{mobilePhone}</a></dd>
            </div>
            <div>
              <dt>Centre office</dt>
              <dd><a href={deskHref}>{deskPhone}</a></dd>
            </div>
            <div>
              <dt>Booking email</dt>
              <dd><a href={`mailto:${email}`}>{email}</a></dd>
            </div>
            <div>
              <dt>Address</dt>
              <dd>1 Forestbrook Road, Rostrevor, Newry BT34 3BT</dd>
            </div>
            <div>
              <dt>Updates</dt>
              <dd><a href={fbHref} target="_blank" rel="noopener noreferrer">Facebook: KilbroneyCentre</a></dd>
            </div>
          </dl>
        </div>

        <div class="kc-col">
          <form class="kc-form" data-kc-form>
            <div class="kc-row">
              <label>
                <span>Leader or contact name</span>
                <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
              </label>
              <label>
                <span>Telephone</span>
                <input name="phone" type="tel" required autocomplete="tel" placeholder="07 or 028..." />
              </label>
            </div>
            <div class="kc-row">
              <label>
                <span>Group type</span>
                <select name="groupType" data-kc-group-select>
                  <option value="Youth / Children's Group">Youth or children's group</option>
                  <option value="Family Weekend">Family weekend</option>
                  <option value="Summer Camp">Summer camp</option>
                  <option value="Adult / Church Retreat">Adult or church retreat</option>
                  <option value="School Residential">School residential</option>
                </select>
              </label>
              <label>
                <span>Estimated size and dates</span>
                <input name="dates" type="text" placeholder="e.g. 30 guests, May weekend" />
              </label>
            </div>
            <label>
              <span>Additional notes</span>
              <textarea
                name="notes"
                rows="3"
                placeholder="Catering preferences, accessibility needs or activity plans..."
              ></textarea>
            </label>
            <button class="kc-forest-btn" type="submit">Send booking enquiry</button>
          </form>
        </div>
      </div>
    </section>

    <section class="kc-section kc-map-band" id="location" aria-label="Rostrevor location map">
      <div class="kc-wrap">
        <LocalAreaMap
          id="kc-map"
          kicker=""
          businessName="Kilbroney Centre"
          address="1 Forestbrook Road, Rostrevor, Newry, BT34 3BT"
          lon={-6.1969}
          lat={54.1017}
          spanKm={16}
          mapHref={mapsHref}
          markers={[
            { name: "Rostrevor Village", lon: -6.2016, lat: 54.0991, note: "2 mins south", side: "b" },
            { name: "Warrenpoint", lon: -6.2504, lat: 54.1003, note: "6 mins west", side: "l" },
            { name: "Newry", lon: -6.3402, lat: 54.1751, note: "18 mins north-west", side: "t" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="kc-footer">
    <div class="kc-wrap kc-footer-inner">
      <div>
        <strong>The Kilbroney Centre</strong>
        <p>1 Forestbrook Road, Rostrevor, Newry, Co. Down, BT34 3BT</p>
      </div>
      <div class="kc-footer-links">
        <a href={mobileHref}>{mobilePhone}</a>
        <a href={deskHref}>{deskPhone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={fbHref} target="_blank" rel="noopener noreferrer">Facebook</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-kc-header]");
      const sentinel = document.querySelector("[data-kc-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            header.classList.toggle("is-scrolled", !entries[0].isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      const ddWrap = document.querySelector("[data-kc-dd]");
      const trigger = ddWrap?.querySelector("[data-kc-dd-trigger]");
      const panel = ddWrap?.querySelector("[data-kc-dd-panel]");
      const previewImg = ddWrap?.querySelector("[data-kc-dd-img]");
      const previewNote = ddWrap?.querySelector("[data-kc-dd-note]");
      const items = ddWrap ? [...ddWrap.querySelectorAll("[data-kc-dd-item]")] : [];

      const activateStayTab = (tabId) => {
        if (!tabId) return;
        window.dispatchEvent(new CustomEvent("kc:select-tab", { detail: { id: tabId } }));
      };

      const syncDropdownHighlight = (tabId) => {
        const match = items.find((i) => i.dataset.tabTarget === tabId);
        if (!match) return;
        items.forEach((i) => i.classList.toggle("is-active", i === match));
        if (previewImg && match.dataset.img) previewImg.src = match.dataset.img;
        if (previewNote && match.dataset.note) previewNote.textContent = match.dataset.note;
      };

      if (ddWrap && trigger && panel) {
        const setOpen = (open) => {
          panel.hidden = !open;
          trigger.setAttribute("aria-expanded", open ? "true" : "false");
          ddWrap.classList.toggle("is-open", open);
        };
        trigger.addEventListener("click", (e) => {
          e.stopPropagation();
          setOpen(panel.hidden);
        });
        document.addEventListener("click", (e) => {
          if (!ddWrap.contains(e.target)) setOpen(false);
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") setOpen(false);
        });
        items.forEach((item) => {
          const preview = () => {
            items.forEach((i) => i.classList.toggle("is-active", i === item));
            if (previewImg && item.dataset.img) previewImg.src = item.dataset.img;
            if (previewNote && item.dataset.note) previewNote.textContent = item.dataset.note;
          };
          item.addEventListener("mouseenter", preview);
          item.addEventListener("focus", preview);
          item.addEventListener("click", () => {
            activateStayTab(item.dataset.tabTarget);
            setOpen(false);
          });
        });
      }

      document.querySelectorAll("[data-kc-jump]").forEach((link) => {
        link.addEventListener("click", () => {
          activateStayTab(link.getAttribute("data-kc-jump"));
        });
      });

      window.addEventListener("kc:tab-changed", (e) => {
        if (e && e.detail && e.detail.id) {
          syncDropdownHighlight(e.detail.id);
        }
      });

      const form = document.querySelector("[data-kc-form]");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        const subject = `Residential Enquiry: ${fd.get("groupType")} (${fd.get("name")})`;
        const body = [
          `Contact: ${fd.get("name")}`,
          `Phone: ${fd.get("phone")}`,
          `Group Type: ${fd.get("groupType")}`,
          `Estimated Size & Dates: ${fd.get("dates") || "Flexible"}`,
          `Notes: ${fd.get("notes") || "None"}`,
        ].join("\n");
        const ev = new CustomEvent("mm:enquiry", {
          cancelable: true,
          detail: { to: "booking@kilbroneycentre.com", subject, body },
        });
        if (window.dispatchEvent(ev)) {
          window.location.href = `mailto:booking@kilbroneycentre.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }
      });
    })();
  </script>
</ConceptLayout>
