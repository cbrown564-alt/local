  <div class="cm-plate-grid" role="list">
    {keypoints.map((pt) => (
      <article class="cm-plate-card" role="listitem">
        <span class="cm-plate-num">{pt.num}</span>
        <div class="cm-plate-card-body">
          <h4 class="cm-plate-card-title">{pt.name}</h4>
          <p class="cm-plate-card-desc">{pt.desc}</p>
