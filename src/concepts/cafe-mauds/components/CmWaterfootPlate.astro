---
interface Props {
  headingId?: string;
}

import GeneratedMapPlate from "../../_shell/GeneratedMapPlate.astro";

const { headingId = "waterfoot-plate-title" } = Astro.props;

const keypoints = [
  {
    num: "01",
    name: "The Shimna Footbridge",
    desc: "Where the river flows out to Dundrum Bay. The iconic pedestrian bridge brings walkers directly to our front door.",
  },
  {
    num: "02",
    name: "106 Waterfoot Flagship",
    desc: "Sunlit brunch tables, freshly baked waffle irons, espresso bar, and our champion 30-flavour Mauds scoop cabinet.",
  },
  {
    num: "03",
    name: "The Seaside Terrace",
    desc: "Outdoor seating with uninterrupted vistas across the bay to Slieve Donard. Dog-friendly and sheltered for coffee in the sea air.",
  },
  {
    num: "04",
    name: "The Promenade Walk",
    desc: "Direct walk-in access from the seaside walkway. No reservation needed — simply step off the path for a cone or warm lunch.",
  },
];
---

<div class="cm-plate" aria-labelledby={headingId}>
  <div class="cm-plate-head">
    <span class="cm-plate-kicker">Architectural Setting · 106 Main Street</span>
    <h3 id={headingId} class="cm-plate-title">The Waterfoot, where the river meets the sea.</h3>
    <p class="cm-plate-intro">
      Positioned at the scenic threshold of Newcastle. Mountain views behind, the Shimna River beside,
      and the open bay right before our terrace.
    </p>
  </div>

  <div class="cm-plate-stage">
    <GeneratedMapPlate
      id="cm-waterfoot-map"
      src="/media/maps/cafe-mauds-waterfoot-generated.png"
      width={1536}
      height={1024}
      title="The Waterfoot"
      desc="An indicative illustrated view of Café Mauds at 106 Waterfoot in Newcastle, beside the Shimna River footbridge, the promenade and Dundrum Bay, with the Mourne Mountains behind."
      headingId={headingId}
    >
      <span class="cm-generated-map-label cm-generated-map-label--mountains">SLIEVE DONARD &amp; THE MOURNES</span>
      <span class="cm-generated-map-label cm-generated-map-label--cafe">CAFÉ MAUDS · 106<small>Waterfoot</small></span>
      <span class="cm-generated-map-label cm-generated-map-label--bridge">01<small>The Shimna Footbridge</small></span>
      <span class="cm-generated-map-label cm-generated-map-label--flagship">02<small>106 Waterfoot Flagship</small></span>
      <span class="cm-generated-map-label cm-generated-map-label--terrace">03<small>The Seaside Terrace</small></span>
      <span class="cm-generated-map-label cm-generated-map-label--promenade">04<small>The Promenade Walk</small></span>
      <span class="cm-generated-map-label cm-generated-map-label--bay">DUNDRUM BAY · IRISH SEA</span>
      <span class="cm-generated-map-label cm-generated-map-label--river">RIVER SHIMNA ESTUARY</span>
      <span class="cm-generated-map-label cm-generated-map-label--walkway">CENTRAL PROMENADE WALKWAY</span>
      <Fragment slot="caption">The Waterfoot setting around 106 Main Street — an indicative place illustration, not a measured site plan.</Fragment>
    </GeneratedMapPlate>
