---
/* Wood-fired peel card for 127 Main Street.
   Hours including Mon–Tue Closed are first-party (13 Sep 2026).
   Drawing honesty lives in bannerNote only. */
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

{compact ? (
  <svg
    class="pk-mark"
    width="46"
    height="46"
    viewBox="0 0 46 46"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="1.5" y="1.5" width="43" height="43" rx="6" fill="#1a1410" />
    <rect x="1.5" y="1.5" width="43" height="43" rx="6" stroke="#e86a2a" stroke-width="1.5" />
    <circle cx="23" cy="18" r="7.5" fill="none" stroke="#f4ebe0" stroke-width="1.4" />
    <circle cx="23" cy="18" r="3.2" fill="#e86a2a" />
    <path d="M23 25.5 V36" stroke="#f4ebe0" stroke-width="1.6" stroke-linecap="round" />
    <path d="M19.5 36 H26.5" stroke="#f4ebe0" stroke-width="1.6" stroke-linecap="round" />
  </svg>
) : (
  <svg
    class="pk-peel"
    viewBox="0 0 640 420"
    role="img"
    aria-label="Wood-fired peel for Piccolo Kitchen: 127 Main Street, Newcastle, handmade pizza since 2016, Monday and Tuesday closed"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="pk-board" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#2a211c" />
        <stop offset="1" stop-color="#16110e" />
      </linearGradient>
      <linearGradient id="pk-ember" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#ff8a3d" />
        <stop offset="1" stop-color="#c43a12" />
      </linearGradient>
      <radialGradient id="pk-oven" cx="50%" cy="42%" r="55%">
        <stop offset="0" stop-color="#3a2a22" />
        <stop offset="1" stop-color="#120e0c" />
      </radialGradient>
    </defs>

    <!-- peel shadow -->
    <ellipse cx="318" cy="392" rx="210" ry="14" fill="#000" opacity=".22" />

    <!-- peel blade -->
    <path
      d="M90 48 C90 28 108 14 130 14 H430 C505 14 560 68 560 140 C560 230 500 310 420 348 L318 390 L216 348 C136 310 90 230 90 140 Z"
      fill="url(#pk-board)"
      stroke="#e86a2a"
      stroke-width="2"
    />
    <path
      d="M118 56 C118 42 130 32 146 32 H414 C478 32 524 78 524 140 C524 214 474 280 410 312 L318 352 L226 312 C162 280 118 214 118 140 Z"
      fill="url(#pk-oven)"
    />

    <!-- oven mouth -->
    <ellipse cx="318" cy="168" rx="118" ry="78" fill="#0c0908" stroke="#e86a2a" stroke-width="2.2" />
    <ellipse cx="318" cy="168" rx="96" ry="60" fill="#1c120e" />
    <ellipse cx="318" cy="178" rx="54" ry="28" fill="url(#pk-ember)" opacity=".85" />
    <ellipse cx="318" cy="168" rx="22" ry="14" fill="#ffd2a0" opacity=".55" />

    <!-- handle stump -->
    <rect x="292" y="348" width="52" height="54" rx="10" fill="#1a1410" stroke="#e86a2a" stroke-width="1.6" />
    <rect x="304" y="360" width="28" height="70" rx="8" fill="#2f241e" />

    <text
      x="318"
      y="78"
      text-anchor="middle"
      fill="#f4ebe0"
      font-family="Sora, Segoe UI, sans-serif"
      font-size="11"
      font-weight="700"
      letter-spacing="4"
    >WOOD-FIRED · SINCE 2016</text>

    <text
      x="318"
      y="268"
      text-anchor="middle"
      fill="#fff6ee"
      font-family="Literata, Georgia, serif"
      font-size="34"
      font-weight="700"
    >127</text>
    <text
      x="318"
      y="292"
      text-anchor="middle"
      fill="#e8c4a8"
      font-family="Sora, Segoe UI, sans-serif"
      font-size="12"
      font-weight="600"
      letter-spacing="2.4"
    >MAIN STREET · NEWCASTLE</text>

    <text
      x="318"
      y="322"
      text-anchor="middle"
      fill="#ff8a3d"
      font-family="Sora, Segoe UI, sans-serif"
      font-size="11"
      font-weight="700"
      letter-spacing="1.8"
    >MON–TUE CLOSED</text>
  </svg>
)}
