---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

const instagram = "https://www.instagram.com/scopersdundrum/";
const facebook = "https://www.facebook.com/p/Scopers-Dundrum-Co-Down-100083029315116/";
const directions = "https://www.google.com/maps/search/?api=1&query=Scopers%2C%20169%20Main%20Street%2C%20Dundrum%2C%20Co%20Down";
const googleMaps =
  "https://www.google.com/maps/place/Scopers/data=!4m7!3m6!1s0x48613db9bcca7109:0x1f52c6abeb6c91ba!8m2!3d54.2568299!4d-5.8466888";

/* A guest's own words, set as a pull-quote the studio's copy never gets.
   Verbatim from Tereza Šolcová's public Google review (read 31 July 2026 as
   "6 days ago" — ~25 July 2026). Closing courtesy and emoji dropped; the
   three sentences are contiguous in the original. Withdraw if the review is
   edited or removed — a quotation that no longer exists at its source is the
   kind of unverifiable atmosphere this concept refuses. */
const review = {
  text:
    "This place convinced us to stay an extra night in Dundrum just so we could eat here again. It was absolutely incredible both times. A true taste of local heaven.",
  attribution: "Tereza Šolcová",
  context: "Reviewed on Google, July 2026 · Dine in · Lunch",
  source: googleMaps,
};

// Dish names and descriptions are quoted from Scopers' own public Instagram
// captions (read 31 July 2026 — see research/concepts/scopers/scopers-image-brief.md). The
// images are generated illustrations, never photographs of their food: the
// public site stays AI-imagery-only by the privacy decision of 31 July 2026.
const dishes = [
  {
    image: "/media/concepts/scopers/scopers-generated-chicken-burger.jpg",
    name: "Buttermilk chicken burger",
    note: "wild garlic mayo, tomato salsa",
    copy: "Proper quality chicken, marinated in buttermilk and breaded to order, with homemade wild garlic mayo and tomato salsa, in a home-baked milk bread bun.",
    alt: "Buttermilk-fried chicken burger in a seeded milk bread bun",
  },
  {
    image: "/media/concepts/scopers/scopers-generated-loaded-fries.jpg",
    name: "BBQ pork loaded fries",
    note: "chipotle mayo, crispy jalapeños",
    copy: "Slow-cooked BBQ pork over thick-cut chips, chipotle mayo and crisp jalapeños. The takeaway box that tastes like a kitchen.",
    alt: "Kraft box of chips loaded with BBQ pork, chipotle mayo and jalapeños",
  },
  {
    image: "/media/concepts/scopers/scopers-generated-carrots.jpg",
    name: "Seasonal carrots",
    note: "fresh · local · seasonal",
    copy: "“Carrots like you've never tasted them before.” The side dish that explains the whole kitchen: what the Mourne Larder gives, cooked properly, nothing wasted.",
    alt: "Glazed carrots with sesame, spring onion and edible flowers",
  },
  {
    image: "/media/concepts/scopers/scopers-generated-bread.jpg",
    name: "Bread baked each day",
    note: "every bun, every loaf",
    copy: "Fresh bread baked each day on the premises — including the milk bread buns the burgers are built on.",
    alt: "Two rustic loaves cooling on a wire rack",
  },
];
---

<ConceptLayout title={"Scopers — independent concept"} slug="scopers" bodyClass="concept-page concept-scopers" lang="en-GB" bannerNote="Food imagery is AI-generated.">
<div class="sc-strip">
      <span><strong>Now open most of the week</strong> · 169 Main Street, Dundrum</span>
      <span>Today's hours on <a href={facebook} style="color:#fff;">Facebook</a></span>
    </div>
    <header class="sc-header">
      <a class="sc-brand" href="/concepts/scopers/">
        <img class="sc-badge" src="/media/concepts/scopers/scopers-badge.png" width="40" height="46" alt="" aria-hidden="true" />
        <span class="sc-brand-text">
          <span class="sc-brand-name">Scopers</span>
          <span class="sc-brand-sub">Zero-waste hot food bar</span>
        </span>
      </a>
      <nav class="sc-nav" aria-label="Concept navigation">
        <a href="#food">The food</a><a href="/concepts/scopers/supper-club/">Supper club</a><a href="#story">Our story</a><a href="#find-us">Find us</a>
      </nav>
      <a class="sc-book" href="/concepts/scopers/supper-club/">Book the supper club</a>
    </header>
    <main class="sc-hero">
      <section class="sc-story">
        <p class="sc-kicker">Main Street · Dundrum</p>
        <h1>Northern Ireland's first <em>zero-waste</em> hot food bar.</h1>
        <p class="sc-lede">
          Paul Cunningham cooked on Great British Menu in 2021, then came home to open
          Scopers — breakfast, brunch and lunch built on his grandfather's foraging and
          the Mourne Larder: only what the local Mourne area provides, nothing wasted.
        </p>
        <div class="sc-actions">
          <a class="sc-cta" href="#food">See the food</a>
          <a class="sc-link" href={facebook}>This week's menu on Facebook →</a>
        </div>
      </section>
      <aside class="sc-panel">
        <article class="sc-club">
          <p class="sc-club-kicker">The Supper Club</p>
          <h2>Up to eleven courses. Somewhere unique.</h2>
          <p>Secret pop-up dining events in unique locations — seasonal courses from the Mourne Larder, open for private booking.</p>
          <p class="sc-club-meta"><strong>Next night · Wednesday 26 August, 7 pm</strong><span>Location revealed to guests the week before</span></p>
          <a class="sc-club-cta" href="/concepts/scopers/supper-club/">See the supper-club page</a>
          <small>Booking via Instagram · <a href={instagram} style="color:inherit;">message to reserve</a></small>
        </article>
      </aside>
      <nav class="sc-rail" aria-label="Signature dishes">
        {dishes.map((dish) => (
          <a class="sc-rail-cell" href="#food">
            <img class="sc-rail-thumb" src={dish.image} width="56" height="56" alt="" aria-hidden="true" />
            <span class="sc-rail-text">
              <span class="sc-dish">{dish.name}</span>
              <span class="sc-dish-note">{dish.note}</span>
            </span>
          </a>
        ))}
      </nav>
    </main>

    <section class="sc-food" id="food">
      <div class="sc-section-head">
        <p class="sc-kicker">The food</p>
        <h2 class="sc-h2">Proper food, made with care.</h2>
        <p class="sc-section-lede">
          Breakfast, brunch and lunch, cooked to order from what's local and in season.
          The menu moves with the week — this is what keeps coming back.
        </p>
      </div>
      <div class="sc-dish-grid">
        {dishes.map((dish) => (
          <figure class="sc-dish-card">
            <img src={dish.image} alt={dish.alt} width="1402" height="1122" loading="lazy" />
            <figcaption>
              <h3>{dish.name}</h3>
              <p>{dish.copy}</p>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="sc-food-foot">
        <a class="sc-cta" href={facebook}>This week's menu</a>
        <span class="sc-provenance">Images are illustrative.</span>
      </p>
    </section>

    <section class="sc-storyline" id="story">
      <div class="sc-storyline-copy">
        <p class="sc-kicker">Our story</p>
        <h2 class="sc-h2">A Great British Menu kitchen, on Dundrum Main Street.</h2>
        <p class="sc-dropcap">
          Paul Cunningham cooked on Great British Menu in 2021. He came home to
          Dundrum and opened a hot food bar built on the way his grandfather fed a
          family — forage what's there, use every part of it, waste nothing.
        </p>
        <p>
          That's the Mourne Larder: only what the mountains, the coast and the
          farms around us actually give. It decides the menu, not the other way
          round. Bread is baked here each day, the meat is properly reared, and
          the sides get the same attention as the burgers.
        </p>
        <p>
          Four years of it in July 2026 — and still the only zero-waste hot food
          bar of its kind in Northern Ireland.
        </p>
        <!-- Attribution and date are part of the quote, not decoration: this is
             a real, checkable Google review, and the concept is worth nothing if
             the owner cannot go and find it. -->
        <figure class="sc-pullquote">
          <blockquote cite={review.source}>“{review.text}”</blockquote>
          <figcaption>
            {review.attribution}
            <span>{review.context}</span>
          </figcaption>
        </figure>
        <a class="sc-link" href={instagram}>Follow @scopersdundrum →</a>
      </div>
      <figure class="sc-storyline-figure">
        <img
          src="/media/concepts/scopers/scopers-generated-counter.jpg"
          alt="Small hot food bar counter with kraft boxes, loaves and a cast-iron pan"
          width="1402"
          height="1122"
          loading="lazy"
        />
        <figcaption>The counter at 169 Main Street.</figcaption>
      </figure>
    </section>

    <section class="sc-find" id="find-us">
      <div class="sc-find-inner">
        <p class="sc-kicker">Find us</p>
        <h2 class="sc-h2">169 Main Street, Dundrum.</h2>
        <div class="sc-find-grid">
          <div class="sc-find-block">
            <h3>Where</h3>
            <p>169 Main Street<br />Dundrum, Co Down<br />BT33 0LY</p>
            <a class="sc-link" href={directions}>Directions on Google Maps →</a>
          </div>
          <div class="sc-find-block">
            <h3>When</h3>
            <p>Open most of the week for breakfast, brunch and lunch. Hours move with the season.</p>
            <a class="sc-link" href={facebook}>Today's hours on Facebook →</a>
          </div>
          <div class="sc-find-block">
            <h3>Talk to us</h3>
            <p>Supper-club places, private bookings and big orders are all arranged by message — the same inbox the kitchen already answers.</p>
            <a class="sc-link" href={instagram}>Message on Instagram →</a>
          </div>
        </div>
      </div>
    </section>
</ConceptLayout>
