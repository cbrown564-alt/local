---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import EssenceMedia from "../../site/components/EssenceMedia.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";
import ScHero from "./components/ScHero.astro";
import ScLarderMap from "./components/ScLarderMap.astro";
import {
  carrotTrace,
  chefTimeline,
  directions,
  dishes,
  facebook,
  instagram,
  paulCaption,
  supperClub,
} from "./content";
---

<ConceptLayout title={"Scopers — independent concept"} slug="scopers" bodyClass="concept-page concept-scopers" lang="en-GB" bannerNote="Food imagery is AI-generated.">
<div class="sc-strip">
      <span><strong>Now open most of the week</strong> · 169 Main Street, Dundrum</span>
      <span>Today's hours on <a href={facebook}>Facebook</a></span>
    </div>
    <header class="sc-header">
      <a class="sc-brand" href="/concepts/scopers/">
        <img class="sc-badge" src="/media/concepts/scopers/scopers-badge.png" width="40" height="46" alt="" aria-hidden="true" />
        <span class="sc-brand-text">
          <span class="sc-brand-name">Scopers</span>
          <span class="sc-brand-sub">Zero-waste hot food bar</span>
        </span>
      </a>
      <nav class="sc-nav" aria-label="Concept navigation">
        <a href="#food">The food</a><a href="/concepts/scopers/supper-club/">Supper club</a><a href="#story">Our story</a><a href="#find-us">Find us</a>
      </nav>
      <a class="sc-book" href="#food">See the food</a>
    </header>

    <main class="sc-hero-appetite">
      <ScHero>
        <div class="sc-hero-overlay" data-sc-overlay data-for="morning midday">
          <p class="sc-kicker">Main Street · Dundrum</p>
          <h1>Northern Ireland's first <em>zero-waste</em> hot food bar.</h1>
        </div>
        <div class="sc-hero-overlay" data-sc-overlay data-for="evening" hidden>
          <p class="sc-kicker">The Supper Club</p>
          <h1>Up to eleven courses. <em>Somewhere unique.</em></h1>
        </div>
      </ScHero>
      <div class="sc-hero-lower">
        <section class="sc-story">
          <p class="sc-lede">
            Paul Cunningham cooked on Great British Menu in 2021, then came home to open
            Scopers — breakfast, brunch and lunch built on his grandfather's foraging and
            the Mourne Larder: only what the local Mourne area provides, nothing wasted.
          </p>
          <div class="sc-actions">
            <a class="sc-cta" href="#food">See the food</a>
            <a class="sc-link" href={facebook}>This week's menu on Facebook →</a>
          </div>
        </section>
      </div>
      <EssenceMedia slug="scopers" />
    </main>

  <!-- Move 1: their voice, not ours — Paul's caption verbatim, with source named. -->
    <figure class="sc-caption-quote">
      <blockquote cite={paulCaption.source}>“{paulCaption.text}”</blockquote>
      <figcaption>
        {paulCaption.attribution}
        <span>{paulCaption.context}</span>
      </figcaption>
    </figure>

  <!-- Move 2: nothing wasted, made visible — one ingredient end-to-end. -->
    <section class="sc-larder" id="philosophy" aria-labelledby="larder-heading">
      <div class="sc-larder-top">
        <div class="sc-larder-copy">
          <h2 class="sc-h2" id="larder-heading">One side dish. The whole kitchen.</h2>
          <p class="sc-section-lede">
            Zero-waste is how we cook — forage what is there, use every part, waste nothing.
            Follow one ingredient through the week.
          </p>
          <p class="sc-larder-anchor">
            “Carrots like you've never tasted them before” — the side dish that explains
            the whole kitchen: what the Mourne Larder gives, cooked properly, nothing wasted.
          </p>
        </div>
        <figure class="sc-larder-visual">
          <ResponsiveImage
            src="/media/concepts/scopers/scopers-generated-carrots.jpg"
            alt="Glazed seasonal carrots"
            width="1402"
            height="1122"
            loading="lazy"
          />
          <figcaption>Seasonal carrots</figcaption>
        </figure>
      </div>
      <ol class="sc-trace" role="list">
        {carrotTrace.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
          </li>
        ))}
      </ol>
    </section>

  <!-- Supper invite after the carrot proof — secondary path, not the home hero job. -->
    <aside class="sc-invite-band" aria-labelledby="home-invite-heading">
      <article class="sc-club sc-club--invite">
        <img class="sc-club-seal" src="/media/concepts/scopers/scopers-badge.png" width="52" height="60" alt="" aria-hidden="true" />
        <p class="sc-club-kicker">The Supper Club</p>
        <p class="sc-club-date">{supperClub.nextDate}</p>
        <h2 id="home-invite-heading">Up to eleven courses. Somewhere unique.</h2>
        <p class="sc-club-secret">The location is revealed to guests the week before.</p>
        <a class="sc-club-cta" href="/concepts/scopers/supper-club/">Open the invitation</a>
        <small>Booking via Instagram · <a href={instagram}>message to reserve</a></small>
      </article>
    </aside>

  <!-- Move 4: the counter — dishes in a row, chalkboard labels, honest scarcity. -->
    <section class="sc-counter" id="food">
      <div class="sc-counter-head">
        <h2 class="sc-h2">Point, queue, eat.</h2>
        <p class="sc-counter-scarcity">Baked this morning. When it's gone, it's gone.</p>
      </div>
      <div class="sc-counter-row" role="list">
        {dishes.map((dish) => (
          <figure class="sc-counter-cell" role="listitem">
            <ResponsiveImage src={dish.image} alt={dish.alt} width="1402" height="1122" loading="lazy" />
            <figcaption>
              <span class="sc-counter-label">{dish.name}</span>
              <span class="sc-counter-note">{dish.note}</span>
              <p>{dish.copy}</p>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="sc-food-foot">
        <a class="sc-cta" href={facebook}>This week's menu</a>
      </p>
    </section>

  <!-- Move 6: the menu is a map — Mourne Larder drawn, indicative disclosure. -->
    <section class="sc-map-section" aria-labelledby="map-heading">
      <div class="sc-map-head">
        <h2 class="sc-h2" id="map-heading">The menu is a map.</h2>
        <p class="sc-section-lede">
          The ten square miles around Dundrum are our supply chain and our creed.
          Each dish is pinned to where it comes from — hedgerows, the coast, the foothills,
          the counter where bread is baked each day.
        </p>
      </div>
      <ScLarderMap headingId="map-heading" />
    </section>

  <!-- Move 7: from the banquet to the bar — documented dates only. -->
    <section class="sc-timeline-band" id="story" aria-labelledby="timeline-heading">
      <div class="sc-timeline-head">
        <h2 class="sc-h2" id="timeline-heading">The man who cooked for the nation now judges his day in milk bread buns.</h2>
      </div>
      <ol class="sc-timeline" role="list">
        {chefTimeline.map((entry) => (
          <li>
            <span class="sc-timeline-marker">{entry.marker}</span>
            <h3>{entry.title}</h3>
            <p>{entry.copy}</p>
          </li>
        ))}
      </ol>
    </section>

    <figure class="sc-counter-photo">
      <ResponsiveImage
        src="/media/concepts/scopers/scopers-generated-counter.jpg"
        alt="A small hot food bar counter with kraft boxes, loaves and a cast-iron pan"
        width="1402"
        height="1122"
        loading="lazy"
      />
      <figcaption>The counter at 169 Main Street — no table service, no bookings. You queue and point.</figcaption>
    </figure>

    <section class="sc-find" id="find-us">
      <div class="sc-find-inner">
        <h2 class="sc-h2">169 Main Street, Dundrum.</h2>
        <div class="sc-find-grid">
          <div class="sc-find-block">
            <h3>Where</h3>
            <p>169 Main Street<br />Dundrum, Co Down<br />BT33 0LY</p>
            <a class="sc-link" href={directions}>Directions on Google Maps →</a>
          </div>
          <div class="sc-find-block">
            <h3>When</h3>
            <p>Open most of the week for breakfast, brunch and lunch. Hours move with the season.</p>
            <a class="sc-link" href={facebook}>Today's hours on Facebook →</a>
          </div>
          <div class="sc-find-block">
            <h3>Talk to us</h3>
            <p>Supper-club places, private bookings and big orders are all arranged by message — the same inbox the kitchen already answers.</p>
            <a class="sc-link" href={instagram}>Message on Instagram →</a>
          </div>
        </div>
      </div>
    </section>
</ConceptLayout>
