---
import GeneratedMapPlate from "../../_shell/GeneratedMapPlate.astro";
import { larderPins } from "../content";

interface Props { headingId?: string; }
const { headingId } = Astro.props;

const places = larderPins;
---

<GeneratedMapPlate
  id="sc-map"
  src="/media/maps/scopers-larder-generated.png"
  width={1536}
  height={1024}
  title="The Mourne Larder around Dundrum"
  desc="An indicative illustrated relationship between Dundrum, its bay, Murlough, Newcastle and the Mournes, with hedgerows, foothills and the Main Street counter representing ingredients Scopers mentions publicly."
  headingId={headingId}
>
  <Fragment slot="caption">
    Indicative Mourne Larder artwork, based on Scopers' public sourcing language. No named farm, supplier or surveyed origin is claimed.
  </Fragment>
  <ul slot="key">
    {places.map((place) => <li><strong>{place.label}</strong><span>{place.dish}</span></li>)}
  </ul>
</GeneratedMapPlate>
