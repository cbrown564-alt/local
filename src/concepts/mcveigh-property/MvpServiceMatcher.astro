---
/* McVeigh Property Services: Interactive Property Services Stage.
   Guides Newry and South Down homeowners, landlords, and commercial clients to the right desk. */
const services = [
  {
    id: "sales",
    label: "Residential sales",
    title: "Accurate local pricing, clear marketing, and hands-on negotiation.",
    summary: "From detached County Down family homes to town-centre terraces, every sale is guided from initial appraisal through to key handover.",
    points: [
      { term: "Appraisals", detail: "Free, no-obligation home valuations across Newry, Mourne, and South Armagh." },
      { term: "Viewings", detail: "Accompanied appointments with straightforward weekly seller updates." },
      { term: "Completion", detail: "Active coordination with buyers and solicitors from agreed offer to completion." },
    ],
    cta: "Book a free sales valuation",
    selectValue: "Free sales valuation",
  },
  {
    id: "lettings",
    label: "Lettings and management",
    title: "Tenant sourcing, full property management, and residential block oversight.",
    summary: "Dedicated support for individual landlords and residential management companies seeking steady tenancy care and clear accounts.",
    points: [
      { term: "Tenancies", detail: "Careful tenant referencing, lease preparation, and compliant deposit protection." },
      { term: "Upkeep", detail: "Routine property inspections, maintenance coordination, and monthly landlord statements." },
      { term: "Block management", detail: "Service-charge budgeting, common-area upkeep, and contractor oversight from Kildare Street." },
    ],
    cta: "Request a rental appraisal",
    selectValue: "Rental and lettings appraisal",
  },
  {
    id: "commercial",
    label: "Commercial and land",
    title: "Retail units, offices, industrial space, and development sites.",
    summary: "Practical agency and valuation advice for business owners, investors, and landowners across the Newry City corridor.",
    points: [
      { term: "Commercial valuations", detail: "Market appraisals for town-centre retail premises, offices, and light industrial units." },
      { term: "Land and sites", detail: "Discreet or open-market disposal for residential plots and agricultural holdings." },
      { term: "Leases and investment", detail: "Lease renewals, rent reviews, and yield appraisals grounded in local demand." },
    ],
    cta: "Discuss commercial property",
    selectValue: "Commercial or land enquiry",
  },
];
---

<section class="mv-stage" id="services" aria-labelledby="mv-services-title">
  <div class="mv-wrap mv-stage-grid" data-mv-matcher>
    <div class="mv-stage-copy">
      <h2 id="mv-services-title">Property services built around Newry and South Down.</h2>

      <div class="mv-tabs" role="tablist" aria-label="Property services">
        {services.map((s, idx) => (
          <button
            type="button"
            role="tab"
            id={`mv-tab-${s.id}`}
            aria-controls={`mv-panel-${s.id}`}
            aria-selected={idx === 0 ? "true" : "false"}
            tabindex={idx === 0 ? "0" : "-1"}
            class:list={["mv-tab", idx === 0 && "is-active"]}
            data-mv-tab={s.id}
          >
            {s.label}
          </button>
        ))}
      </div>

      {services.map((s, idx) => (
        <div
          class="mv-panel"
          role="tabpanel"
          id={`mv-panel-${s.id}`}
          aria-labelledby={`mv-tab-${s.id}`}
          data-mv-panel={s.id}
          hidden={idx !== 0}
        >
          <h3 class="mv-panel-title">{s.title}</h3>
          <p class="mv-panel-summary">{s.summary}</p>
          <dl class="mv-ledger">
            {s.points.map((p) => (
              <div class="mv-ledger-row">
                <dt>{p.term}</dt>
                <dd>{p.detail}</dd>
              </div>
            ))}
          </dl>
          <a class="mv-btn mv-btn--light" href="#valuation" data-mv-select-service={s.selectValue}>
            {s.cta}
          </a>
        </div>
      ))}
    </div>

    <div class="mv-stage-media">
      <figure class="mv-plate">
        <picture>
          <source
            srcset="/media/concepts/mcveigh-property/mcveigh-keys-interior-640.webp 640w, /media/concepts/mcveigh-property/mcveigh-keys-interior-1265.webp 1265w"
            sizes="(max-width: 960px) 100vw, 44vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/mcveigh-property/mcveigh-keys-interior.jpg"
            alt="Bright modern Northern Ireland kitchen and living room with brass house key on a stone tray"
            width="1408"
            height="768"
            loading="lazy"
          />
        </picture>
        <figcaption>Indicative residential sales and handover interior visualisation.</figcaption>
      </figure>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-mv-matcher]");
    if (!root) return;
    const tabs = [...root.querySelectorAll("[data-mv-tab]")];
    const panels = [...root.querySelectorAll("[data-mv-panel]")];

    const activate = (btn, moveFocus) => {
      const id = btn.getAttribute("data-mv-tab");
      tabs.forEach((t) => {
        const active = t === btn;
        t.classList.toggle("is-active", active);
        t.setAttribute("aria-selected", active ? "true" : "false");
        t.setAttribute("tabindex", active ? "0" : "-1");
      });
      panels.forEach((p) => {
        p.hidden = p.getAttribute("data-mv-panel") !== id;
      });
      if (moveFocus) btn.focus();
    };

    tabs.forEach((btn, idx) => {
      btn.addEventListener("click", () => activate(btn, false));
      btn.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") {
          e.preventDefault();
          activate(tabs[(idx + 1) % tabs.length], true);
        } else if (e.key === "ArrowLeft") {
          e.preventDefault();
          activate(tabs[(idx - 1 + tabs.length) % tabs.length], true);
        }
      });
    });

    root.querySelectorAll("[data-mv-select-service]").forEach((link) => {
      link.addEventListener("click", () => {
        const val = link.getAttribute("data-mv-select-service");
        const select = document.querySelector("[data-mv-service-select]");
        if (select && val) {
          select.value = val;
          select.dispatchEvent(new Event("change", { bubbles: true }));
        }
      });
    });
  })();
</script>
