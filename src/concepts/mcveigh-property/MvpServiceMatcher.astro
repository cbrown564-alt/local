---
/* McVeigh Property Services — Interactive Valuation & Property Service Selector.
   Guides Newry & South Down homeowners, landlords and commercial clients straight to the right desk. */
const services = [
  {
    id: "sales",
    label: "Residential Sales",
    title: "Accurate local pricing, strong photography and hands-on negotiation.",
    points: ["Free, no-obligation home valuation across Newry & South Down", "Accompanied viewings & clear weekly seller updates", "Direct guidance from listing through completion"],
    cta: "Book a Free Valuation",
  },
  {
    id: "lettings",
    label: "Lettings & Management",
    title: "Tenant sourcing, referencing and full rental property management.",
    points: ["Careful tenant vetting & deposit protection", "Routine inspections & maintenance coordination", "Clear monthly statements for landlords"],
    cta: "Request a Rental Appraisal",
  },
  {
    id: "commercial",
    label: "Commercial & Land",
    title: "Retail units, offices, industrial space and development sites.",
    points: ["Newry City & corridor commercial valuations", "Land & development site marketing", "Lease renewals & investment appraisals"],
    cta: "Discuss Commercial Property",
  },
  {
    id: "block",
    label: "Block Management",
    title: "Structured management for residential apartment blocks and estates.",
    points: ["Service-charge budgeting & transparent accounts", "Common-area maintenance & contractor oversight", "Responsive day-to-day contact from Kildare Street"],
    cta: "Enquire on Block Management",
  },
];
---

<section class="mv-matcher-band" id="services" aria-labelledby="mv-matcher-title">
  <div class="mv-wrap">
    <div class="mv-matcher-card" data-mv-matcher>
      <div class="mv-matcher-head">
        <div>
          <p class="mv-kicker">1 Kildare Street · Newry</p>
          <h2 id="mv-matcher-title">Sales, lettings, commercial &amp; block management.</h2>
        </div>
        <div class="mv-tabs" role="tablist" aria-label="Choose property service">
          {services.map((s, idx) => (
            <button
              type="button"
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
              class:list={["mv-tab", idx === 0 && "is-active"]}
              data-mv-tab={s.id}
            >
              {s.label}
            </button>
          ))}
        </div>
      </div>
      {services.map((s, idx) => (
        <div class="mv-panel" role="tabpanel" data-mv-panel={s.id} hidden={idx !== 0}>
          <h3>{s.title}</h3>
          <ul class="mv-points">
            {s.points.map((p) => <li>{p}</li>)}
          </ul>
          <a class="mv-btn mv-btn--primary" href="#valuation">{s.cta}</a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .mv-matcher-band { padding: clamp(46px, 6vw, 76px) 0; }
  .mv-matcher-card {
    background: #ffffff;
    border: 1px solid rgba(19, 32, 51, 0.14);
    border-top: 3px solid #1e4b7a;
    border-radius: 4px;
    padding: clamp(24px, 4vw, 40px);
  }
  .mv-matcher-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 18px;
    padding-bottom: 22px;
    border-bottom: 1px solid rgba(19, 32, 51, 0.12);
  }
  .mv-matcher-head h2 { margin: 0; font-family: var(--mv-display); font-size: clamp(1.6rem, 3vw, 2.25rem); font-weight: 600; }
  .mv-tabs { display: flex; flex-wrap: wrap; gap: 8px; }
  .mv-tab {
    padding: 9px 15px;
    border: 1px solid rgba(19, 32, 51, 0.2);
    background: #f4f6f9;
    color: #132033;
    font-family: var(--mv-sans);
    font-size: 0.84rem;
    font-weight: 600;
    border-radius: 3px;
    cursor: pointer;
  }
  .mv-tab.is-active { background: #1e4b7a; border-color: #1e4b7a; color: #ffffff; }
  .mv-panel { padding-top: 24px; }
  .mv-panel h3 { margin: 0 0 18px; font-family: var(--mv-display); font-size: 1.32rem; font-weight: 600; }
  .mv-points {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .mv-points li {
    background: #f4f6f9;
    border: 1px solid rgba(19, 32, 51, 0.1);
    padding: 14px 16px;
    border-radius: 3px;
    font-size: 0.9rem;
    color: #132033;
  }
  @media (max-width: 780px) { .mv-points { grid-template-columns: minmax(0, 1fr); } }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-mv-matcher]");
    if (!root) return;
    const tabs = [...root.querySelectorAll("[data-mv-tab]")];
    const panels = [...root.querySelectorAll("[data-mv-panel]")];
    tabs.forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-mv-tab");
        tabs.forEach((t) => {
          const active = t === btn;
          t.classList.toggle("is-active", active);
          t.setAttribute("aria-selected", active ? "true" : "false");
        });
        panels.forEach((p) => { p.hidden = p.getAttribute("data-mv-panel") !== id; });
      });
    });
  })();
</script>
