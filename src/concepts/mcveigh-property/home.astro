---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import MvpServiceMatcher from "./MvpServiceMatcher.astro";
import "./styles.css";

/* McVeigh Property Services — 1 Kildare Street, Newry.
   Verified live 26 Nov 2026: mcveighpropertyservices.com prints "You are using an outdated browser" banner.
   Sales, Rentals, Commercial, Land & Sites, Valuations & Block Management. 028 3025 6387, info@mcveighps.com. */
const phone = "028 3025 6387";
const phoneHref = "tel:+442830256387";
const email = "info@mcveighps.com";
const fbHref = "https://www.facebook.com/mcveighpropertyservices/";
const igHref = "https://www.instagram.com/mcveighpropertyservices/";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=McVeigh+Property+Services+1+Kildare+Street+Newry";
---

<ConceptLayout
  title="McVeigh Property Services — Estate Agents & Valuations, Newry"
  slug="mcveigh-property"
  bodyClass="concept-page concept-mcveigh"
  businessName="McVeigh Property Services"
  town="Newry"
  bannerNote="Imagery comprises indicative County Down residential exterior and interior visualisations."
>
  <header class="mv-header">
    <div class="mv-header-inner">
      <a class="mv-brand" href="#top">McVeigh Property</a>
      <nav class="mv-nav" aria-label="Primary">
        <a href="#services">Services</a>
        <a href="#approach">Approach</a>
        <a href="#valuation">Valuations</a>
        <a href="#location">Kildare Street</a>
      </nav>
      <div class="mv-header-actions">
        <a class="mv-header-tel" href={phoneHref}>{phone}</a>
        <a class="mv-header-cta" href="#valuation">Free valuation</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="mv-hero" aria-labelledby="mv-hero-title">
      <div class="mv-hero-split">
        <div class="mv-hero-copy">
          <p class="mv-eyebrow">1 Kildare Street · Newry</p>
          <h1 id="mv-hero-title">Newry property advice <mark class="mv-hl">built on local knowledge.</mark></h1>
          <p class="mv-hero-lead">
            Residential sales, lettings, commercial units, land and block management across Newry,
            Mourne and South Armagh.
          </p>
          <div class="mv-hero-actions">
            <a class="mv-btn mv-btn--primary" href="#valuation">Arrange a free valuation</a>
            <a class="mv-link" href="#services">Explore services</a>
          </div>
          <ul class="mv-disciplines" aria-label="Property services">
            <li>Residential Sales</li>
            <li>Lettings &amp; Management</li>
            <li>Commercial &amp; Land</li>
          </ul>
        </div>

        <figure class="mv-hero-media">
          <picture>
            <source srcset="/media/concepts/mcveigh-property/mcveigh-property-hero-640.webp 640w, /media/concepts/mcveigh-property/mcveigh-property-hero-1265.webp 1265w" sizes="(max-width: 960px) 100vw, 52vw" type="image/webp" />
            <img src="/media/concepts/mcveigh-property/mcveigh-property-hero.jpg" alt="Contemporary County Down stone and render family home overlooking green hills near Newry at golden hour" width="1408" height="768" loading="eager" />
          </picture>
          <figcaption class="mv-hero-cap">County Down residential · indicative visualisation</figcaption>
        </figure>
      </div>
    </section>

    <MvpServiceMatcher />

    <section class="mv-section mv-approach" id="approach" aria-labelledby="mv-app-title">
      <div class="mv-wrap mv-split">
        <figure class="mv-plate">
          <picture>
            <source srcset="/media/concepts/mcveigh-property/mcveigh-keys-interior-640.webp 640w, /media/concepts/mcveigh-property/mcveigh-keys-interior-1265.webp 1265w" sizes="(max-width: 860px) 100vw, 48vw" type="image/webp" />
            <img src="/media/concepts/mcveigh-property/mcveigh-keys-interior.jpg" alt="Bright modern Northern Ireland kitchen and living room with brass house key on travertine tray" width="1408" height="768" loading="lazy" />
          </picture>
          <figcaption>Residential sales &amp; handover preparation · indicative interior visualisation.</figcaption>
        </figure>
        <div>
          <p class="mv-kicker">Local market clarity</p>
          <h2 id="mv-app-title">Honest valuations, responsive viewings, clean handovers.</h2>
          <p class="mv-body">
            Whether you are selling a family home in Newry, letting a town-centre apartment, or placing
            commercial space on the market, our Kildare Street team keeps buyers, tenants and solicitors
            moving without unnecessary drift.
          </p>
          <dl class="mv-contact-list">
            <div><dt>Office Desk</dt><dd><a href={phoneHref}>{phone}</a></dd></div>
            <div><dt>Email</dt><dd><a href={`mailto:${email}`}>{email}</a></dd></div>
            <div><dt>Office</dt><dd>1 Kildare Street, Newry, BT34 1DQ</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section class="mv-section mv-valuation" id="valuation" aria-labelledby="mv-val-title">
      <div class="mv-wrap mv-split">
        <div>
          <p class="mv-kicker">Free market appraisal</p>
          <h2 id="mv-val-title">Request a no-obligation sales or rental valuation.</h2>
          <p class="mv-body">
            Leave your postcode, property type and preferred contact time. We will reply directly to
            arrange an appraisal across Newry, Warrenpoint, Bessbrook, Camlough or South Down.
          </p>
        </div>
        <form class="mv-form" data-mv-form>
          <div class="mv-row">
            <label>
              <span>Your name</span>
              <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
            </label>
            <label>
              <span>Telephone</span>
              <input name="phone" type="tel" required autocomplete="tel" placeholder="028 / 07..." />
            </label>
          </div>
          <div class="mv-row">
            <label>
              <span>Town / Postcode</span>
              <input name="postcode" type="text" required placeholder="e.g. Newry BT34" />
            </label>
            <label>
              <span>Service needed</span>
              <select name="service">
                <option value="Free Sales Valuation">Free Sales Valuation</option>
                <option value="Rental / Lettings Appraisal">Rental / Lettings Appraisal</option>
                <option value="Commercial / Land Enquiry">Commercial or Land Enquiry</option>
                <option value="Block Management Proposal">Block Management Proposal</option>
              </select>
            </label>
          </div>
          <label>
            <span>Property notes</span>
            <textarea name="notes" rows="3" placeholder="Bedrooms, approximate timescale, or preferred call time..."></textarea>
          </label>
          <button class="mv-btn mv-btn--primary" type="submit">Request valuation call</button>
        </form>
      </div>
    </section>

    <section class="mv-section mv-map-band" id="location" aria-label="Newry Kildare Street map">
      <div class="mv-wrap">
        <LocalAreaMap
          id="mv-map"
          kicker="1 Kildare Street · Newry City"
          businessName="McVeigh Property Services"
          address="1 Kildare Street, Newry, BT34 1DQ"
          lon={-6.3369783}
          lat={54.1773128}
          spanKm={18}
          mapHref={mapsHref}
          markers={[
            { name: "Warrenpoint", lon: -6.2538, lat: 54.1014, note: "12 mins south-east", side: "r" },
            { name: "Camlough", lon: -6.4096, lat: 54.1807, note: "7 mins west", side: "l" },
            { name: "Hilltown", lon: -6.1228, lat: 54.2194, note: "16 mins east", side: "r" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="mv-footer">
    <div class="mv-wrap mv-footer-inner">
      <div>
        <strong>McVeigh Property Services</strong>
        <p>1 Kildare Street, Newry, Co. Down, BT34 1DQ</p>
      </div>
      <div class="mv-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={fbHref} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
        <a href={igHref} target="_blank" rel="noopener noreferrer">Instagram ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const form = document.querySelector("[data-mv-form]");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        const subject = `${fd.get("service")} — ${fd.get("postcode")}`;
        const body = [
          `Name: ${fd.get("name")}`,
          `Phone: ${fd.get("phone")}`,
          `Location / Postcode: ${fd.get("postcode")}`,
          `Service: ${fd.get("service")}`,
          `Notes: ${fd.get("notes") || "None"}`,
        ].join("\n");
        const ev = new CustomEvent("mm:enquiry", {
          cancelable: true,
          detail: { to: "info@mcveighps.com", subject, body, phone: "028 3025 6387", phoneHref: "tel:+442830256387" },
        });
        if (window.dispatchEvent(ev)) {
          window.location.href = `mailto:info@mcveighps.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }
      });
    })();
  </script>
</ConceptLayout>
