---
/**
 * Optional artefact plate: a drawn wheaten loaf in elevation.
 * Not a photograph from the bakery; not a Shopify product shot.
 */
interface Props {
  headingId?: string;
}

const { headingId = "cj-wheaten-title" } = Astro.props;
---

<figure class="cj-plate" aria-labelledby={headingId}>
  <svg
    class="cj-plate-svg"
    viewBox="0 0 640 420"
    role="img"
    aria-label="Drawn plate of a round wheaten loaf with a cross cut, sitting on bakery paper"
  >
    <defs>
      <radialGradient id="cj-paper" cx="50%" cy="42%" r="68%">
        <stop offset="0%" stop-color="#fffaf1" />
        <stop offset="70%" stop-color="#f3e6d0" />
        <stop offset="100%" stop-color="#e7d3b4" />
      </radialGradient>
      <radialGradient id="cj-crust" cx="46%" cy="38%" r="62%">
        <stop offset="0%" stop-color="#c9854a" />
        <stop offset="42%" stop-color="#a45c28" />
        <stop offset="100%" stop-color="#6b3416" />
      </radialGradient>
      <radialGradient id="cj-crumb" cx="48%" cy="46%" r="55%">
        <stop offset="0%" stop-color="#f0d7a8" />
        <stop offset="100%" stop-color="#d7a86a" />
      </radialGradient>
      <filter id="cj-grain" x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" result="n" />
        <feColorMatrix in="n" type="saturate" values="0" result="g" />
        <feBlend in="SourceGraphic" in2="g" mode="multiply" />
      </filter>
    </defs>

    <rect width="640" height="420" fill="url(#cj-paper)" />
    <rect width="640" height="420" fill="#8b5a2b" opacity=".03" filter="url(#cj-grain)" />

    <ellipse cx="320" cy="338" rx="198" ry="28" fill="#5c3317" opacity=".12" />

    <ellipse cx="320" cy="248" rx="168" ry="92" fill="url(#cj-crust)" />
    <ellipse cx="320" cy="236" rx="148" ry="74" fill="url(#cj-crumb)" opacity=".35" />

    <path
      d="M248 198c28 38 58 62 72 108"
      fill="none"
      stroke="#f6efe3"
      stroke-width="7"
      stroke-linecap="round"
      opacity=".88"
    />
    <path
      d="M394 196c-30 40-56 64-74 112"
      fill="none"
      stroke="#f6efe3"
      stroke-width="7"
      stroke-linecap="round"
      opacity=".88"
    />
    <path
      d="M248 198c28 38 58 62 72 108"
      fill="none"
      stroke="#6b3416"
      stroke-width="2.2"
      stroke-linecap="round"
      opacity=".45"
    />
    <path
      d="M394 196c-30 40-56 64-74 112"
      fill="none"
      stroke="#6b3416"
      stroke-width="2.2"
      stroke-linecap="round"
      opacity=".45"
    />

    <g fill="#5c3317" opacity=".42">
      <circle cx="268" cy="232" r="3.2" />
      <circle cx="292" cy="258" r="2.4" />
      <circle cx="348" cy="224" r="2.8" />
      <circle cx="372" cy="256" r="2.1" />
      <circle cx="310" cy="278" r="2.6" />
      <circle cx="338" cy="270" r="1.8" />
      <circle cx="254" cy="268" r="2.2" />
      <circle cx="390" cy="238" r="2.5" />
      <circle cx="304" cy="214" r="1.7" />
      <circle cx="360" cy="290" r="2" />
    </g>

    <text
      x="320"
      y="62"
      text-anchor="middle"
      fill="#5c3317"
      font-family="Instrument Serif, Georgia, serif"
      font-size="28"
      letter-spacing="0.18em"
    >WHEATEN</text>
    <line x1="248" y1="78" x2="392" y2="78" stroke="#c4a574" stroke-width="1" />
  </svg>
  <figcaption>Drawn plate of the wheaten loaf — the mark, not a daily board.</figcaption>
</figure>
