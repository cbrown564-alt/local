---
/** Drawn wheaten loaf — the mark for this concept, not a lifted shop logo. */
interface Props {
  size?: number;
  class?: string;
}

const { size = 36, class: className } = Astro.props;
---

<svg
  class:list={["cj-mark", className]}
  width={size}
  height={size}
  viewBox="0 0 36 36"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <ellipse cx="18" cy="22" rx="13.5" ry="9.2" fill="currentColor" opacity=".14" />
  <path
    d="M8.2 21.4c.4-7.2 4.2-12.2 9.8-12.2s9.4 5 9.8 12.2c.1 2.1-1.8 4.1-9.8 4.1s-9.9-2-9.8-4.1Z"
    fill="currentColor"
    opacity=".92"
  />
  <path
    d="M12.2 16.6c2.1 2.4 5.2 3.8 5.8 7.8M23.6 16.4c-2 2.6-4.8 3.9-5.6 8"
    stroke="#f6efe3"
    stroke-width="1.15"
    stroke-linecap="round"
  />
  <circle cx="14.2" cy="20.2" r=".7" fill="#f6efe3" opacity=".7" />
  <circle cx="20.8" cy="19.4" r=".55" fill="#f6efe3" opacity=".65" />
  <circle cx="17.4" cy="22.6" r=".45" fill="#f6efe3" opacity=".55" />
</svg>
