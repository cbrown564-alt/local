---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import "./styles.css";

/* The Maghera Inn — 86–89 Ballyloughlin Road, Maghera, Castlewellan BT31 9HE.
   Verified live 27 Nov 2026: themagherainn.com duplicates Gift Vouchers links in header and spreads
   ResDiary booking (THEMAGHERAINN/21858), Events/Receptions, and Kids/Main menus across fragmented pages.
   Contacts: 028 4372 2236, enquiries@themagherainn.com.
   Pub: Sun–Thu 11:30–23:00, Fri–Sat 11:30–01:00. Food: Mon–Thu 12:00–21:00, Fri–Sat 12:00–21:30, Sun 12:00–20:00. */
const phone = "028 4372 2236";
const phoneHref = "tel:+442843722236";
const email = "enquiries@themagherainn.com";
const resDiaryHref = "https://booking.resdiary.com/widget/Standard/THEMAGHERAINN/21858";
const siteHref = "https://themagherainn.com/";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=The+Maghera+Inn+86+Ballyloughlin+Road+Maghera+Castlewellan+BT31+9HE";

const innGroups = [
  {
    id: "kitchen",
    label: "Kitchen Menus & Sunday Dining",
    items: [
      { name: "All-Day & Evening Main Menu", note: "Prime Mourne steaks, coastal fish, hearty Irish classics and daily specials served in the bar & dining room", meta: "Mon–Sat from 12:00" },
      { name: "Traditional Sunday Roasts", note: "Family Sunday sittings served 12:00 – 20:00 — advance booking advised via ResDiary", meta: "12:00 – 20:00" },
      { name: "Children's Menu", note: "Proper home-cooked family plates for younger diners after a day in Newcastle or Castlewellan", meta: "Family friendly" },
    ],
  },
  {
    id: "events",
    label: "Private Receptions & Gift Vouchers",
    items: [
      { name: "Private Functions & Family Receptions", note: "Tailored set menus and welcoming hospitality for birthdays, anniversaries and family gatherings", meta: "Enquire below" },
      { name: "Maghera Inn Gift Vouchers", note: "Available direct from the inn or online for dining and celebrations", meta: "Official site ↗" },
    ],
  },
];
---

<ConceptLayout
  title="The Maghera Inn — Country Pub, Dining & Receptions, Maghera, Castlewellan"
  slug="the-maghera-inn"
  bodyClass="concept-page concept-magherainn"
  businessName="The Maghera Inn"
  town="Maghera, Castlewellan"
  bannerNote="Imagery comprises indicative Mourne country inn hearth and traditional Sunday table visualisations."
>
  <header class="mi-header" data-mi-header>
    <div class="mi-header-inner">
      <a class="mi-brand" href="#top">
        <span class="mi-mark" aria-hidden="true"></span>
        <span>The Maghera Inn</span>
      </a>

      <nav class="mi-nav" aria-label="Primary">
        <a class="mi-nav-link" href="#dining">Dining &amp; Hours</a>
        <a class="mi-nav-link" href="#receptions">Receptions</a>
        <a class="mi-nav-link" href="#location">Maghera</a>
      </nav>

      <div class="mi-header-actions">
        <a class="mi-header-tel" href={phoneHref}>{phone}</a>
        <a class="mi-pill-cta" href={resDiaryHref} target="_blank" rel="noopener noreferrer">Book table</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="mi-hero" aria-labelledby="mi-hero-title">
      <figure class="mi-hero-media">
        <picture>
          <source srcset="/media/concepts/the-maghera-inn/maghera-inn-hearth-640.webp 640w, /media/concepts/the-maghera-inn/maghera-inn-hearth-1265.webp 1265w" sizes="100vw" type="image/webp" />
          <img src="/media/concepts/the-maghera-inn/maghera-inn-hearth.jpg" alt="Warm traditional County Down country inn dining room with glowing hearth fire, exposed Mourne stone wall and brass lamps" width="1408" height="768" loading="eager" />
        </picture>
        <div class="mi-hero-scrim" aria-hidden="true"></div>
      </figure>

      <div class="mi-wrap mi-hero-stage">
        <div class="mi-hero-headline">
          <h1 id="mi-hero-title" class="mi-reveal mi-reveal-1">
            Fireside cooking<br /><em>below the Mournes.</em>
          </h1>
        </div>

        <div class="mi-hero-foot">
          <div class="mi-hero-copy mi-reveal mi-reveal-2">
            <p>
              A County Down landmark on Ballyloughlin Road, open seven days for all-day dining,
              Sunday roasts and family receptions.
            </p>
            <div class="mi-hero-actions">
              <a class="mi-arrow-btn" href={resDiaryHref} target="_blank" rel="noopener noreferrer">
                <span class="mi-arrow-label">Book a table</span>
                <span class="mi-arrow-circle" aria-hidden="true">
                  <svg class="mi-arrow mi-arrow--primary" width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  <svg class="mi-arrow mi-arrow--clone" width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
              </a>
              <SpecimenSheet
                id="mi-menu-sheet"
                triggerLabel="Menus, roasts & events"
                kicker="The Maghera Inn · Ballyloughlin Road, Maghera"
                title="Kitchen Menus, Service Times & Receptions"
                subtitle="Reserve tables live through ResDiary or call 028 4372 2236 for private groups."
                groups={innGroups}
                ctaLabel="Book Table Online ↗"
                ctaHref={resDiaryHref}
                ctaExternal={true}
                secondaryLabel={`Call ${phone}`}
                secondaryHref={phoneHref}
                buttonClass="mi-ghost-link"
              />
            </div>
          </div>

          <div class="mi-hero-meta mi-reveal mi-reveal-3">
            <a class="mi-scroll-cue" href="#dining">
              <span>Scroll down</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M6 2.5v7M3 6.5L6 9.5l3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
            <p class="mi-visual-note">Maghera dining room · indicative visualisation</p>
          </div>
        </div>
      </div>
    </section>

    <section class="mi-section mi-dining" id="dining" aria-labelledby="mi-din-title">
      <div class="mi-wrap mi-split">
        <figure class="mi-plate">
          <picture>
            <source srcset="/media/concepts/the-maghera-inn/maghera-inn-sunday-table-640.webp 640w, /media/concepts/the-maghera-inn/maghera-inn-sunday-table-1265.webp 1265w" sizes="(max-width: 860px) 100vw, 48vw" type="image/webp" />
            <img src="/media/concepts/the-maghera-inn/maghera-inn-sunday-table.jpg" alt="Traditional Irish country pub roast beef supper with golden roast potatoes, seasonal vegetables and creamy dark stout" width="1408" height="768" loading="lazy" />
          </picture>
          <figcaption>Sunday roast &amp; evening table · indicative dining visualisation.</figcaption>
        </figure>
        <div>
          <p class="mi-eyebrow">Open seven days · Maghera</p>
          <h2 id="mi-din-title">Drop in after a Mourne walk or book ahead for Sunday.</h2>
          <p class="mi-body">
            Minutes from Newcastle promenade, Dundrum Bay and Castlewellan Forest Park, our kitchen
            serves generously from noon every day with late bar hours on Fridays and Saturdays.
          </p>
          <div class="mi-hours-card">
            <h3>Bar &amp; Kitchen Hours</h3>
            <dl class="mi-hours-list">
              <div><dt>Bar (Sun – Thu)</dt><dd>11:30 – 23:00</dd></div>
              <div><dt>Bar (Fri – Sat)</dt><dd>11:30 – 01:00</dd></div>
              <div><dt>Food (Mon – Thu)</dt><dd>12:00 – 21:00</dd></div>
              <div><dt>Food (Fri – Sat)</dt><dd>12:00 – 21:30</dd></div>
              <div><dt>Food (Sunday)</dt><dd>12:00 – 20:00</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="mi-section mi-receptions" id="receptions" aria-labelledby="mi-rec-title">
      <div class="mi-wrap mi-split">
        <div>
          <p class="mi-eyebrow">Events &amp; family receptions</p>
          <h2 id="mi-rec-title">Host your celebration or gathering beside the hearth.</h2>
          <p class="mi-body">
            From anniversary dinners and christenings to family receptions and group set menus,
            share your rough date and party size below or call <a href={phoneHref}>{phone}</a>.
          </p>
          <p class="mi-email-line">Events desk <a href={`mailto:${email}`}>{email}</a></p>
        </div>
        <form class="mi-form" data-mi-form>
          <div class="mi-row">
            <label>
              <span>Your name</span>
              <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
            </label>
            <label>
              <span>Telephone</span>
              <input name="phone" type="tel" required autocomplete="tel" placeholder="028 / 07..." />
            </label>
          </div>
          <div class="mi-row">
            <label>
              <span>Occasion</span>
              <select name="occasion">
                <option value="Family Reception / Celebration">Family Reception / Celebration</option>
                <option value="Large Group Dining (10+)">Large Group Dining (10+)</option>
                <option value="Private Function / Buffet">Private Function / Buffet</option>
                <option value="Gift Voucher Enquiry">Gift Voucher Enquiry</option>
              </select>
            </label>
            <label>
              <span>Target date &amp; guests</span>
              <input name="guests" type="text" placeholder="e.g. 24 guests, Saturday" />
            </label>
          </div>
          <label>
            <span>Menu or seating notes</span>
            <textarea name="notes" rows="3" placeholder="Dietary notes, preferred sitting time or set menu questions..."></textarea>
          </label>
          <button class="mi-arrow-btn" type="submit">
            <span class="mi-arrow-label">Send event enquiry</span>
            <span class="mi-arrow-circle" aria-hidden="true">
              <svg class="mi-arrow mi-arrow--primary" width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <svg class="mi-arrow mi-arrow--clone" width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
          </button>
        </form>
      </div>
    </section>

    <section class="mi-section mi-map-band" id="location" aria-label="Maghera Castlewellan map">
      <div class="mi-wrap">
        <LocalAreaMap
          id="mi-map"
          tone="dark"
          kicker="86–89 Ballyloughlin Road · Maghera"
          businessName="The Maghera Inn"
          address="86–89 Ballyloughlin Road, Maghera, Castlewellan, BT31 9HE"
          lon={-5.8992}
          lat={54.2413}
          spanKm={16}
          mapHref={mapsHref}
          markers={[
            { name: "Newcastle", lon: -5.8902, lat: 54.2121, note: "5 mins south", side: "b" },
            { name: "Dundrum", lon: -5.8442, lat: 54.2591, note: "6 mins north-east", side: "r" },
            { name: "Castlewellan", lon: -5.9442, lat: 54.2596, note: "6 mins north-west", side: "l" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="mi-footer">
    <div class="mi-wrap mi-footer-inner">
      <div>
        <strong>The Maghera Inn</strong>
        <p>86–89 Ballyloughlin Road, Maghera, Castlewellan, Co. Down, BT31 9HE</p>
      </div>
      <div class="mi-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={resDiaryHref} target="_blank" rel="noopener noreferrer">ResDiary ↗</a>
        <a href={siteHref} target="_blank" rel="noopener noreferrer">Vouchers ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-mi-header]");
      if (header) {
        const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 40);
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      }
      const form = document.querySelector("[data-mi-form]");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        const subject = `Event Enquiry — ${fd.get("occasion")} (${fd.get("name")})`;
        const body = [
          `Name: ${fd.get("name")}`,
          `Phone: ${fd.get("phone")}`,
          `Occasion: ${fd.get("occasion")}`,
          `Date & Party Size: ${fd.get("guests") || "Flexible"}`,
          `Notes: ${fd.get("notes") || "None"}`,
        ].join("\n");
        const ev = new CustomEvent("mm:enquiry", {
          cancelable: true,
          detail: { to: "enquiries@themagherainn.com", subject, body },
        });
        if (window.dispatchEvent(ev)) {
          window.location.href = `mailto:enquiries@themagherainn.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }
      });
    })();
  </script>
</ConceptLayout>
