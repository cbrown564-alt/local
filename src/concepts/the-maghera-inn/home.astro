---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import "./styles.css";

/* The Maghera Inn, 86-89 Ballyloughlin Road, Maghera, Castlewellan BT31 9HE.
   Verified live 27 Nov 2026: ResDiary booking (THEMAGHERAINN/21858), Events/Receptions, Kids & Main menus.
   Contacts: 028 4372 2236, enquiries@themagherainn.com.
   Pub: Sun-Thu 11:30-23:00, Fri-Sat 11:30-01:00. Food: Mon-Thu 12:00-21:00, Fri-Sat 12:00-21:30, Sun 12:00-20:00. */
const phone = "028 4372 2236";
const phoneHref = "tel:+442843722236";
const email = "enquiries@themagherainn.com";
const resDiaryHref = "https://booking.resdiary.com/widget/Standard/THEMAGHERAINN/21858";
const siteHref = "https://themagherainn.com/";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=The+Maghera+Inn+86+Ballyloughlin+Road+Maghera+Castlewellan+BT31+9HE";

const diningTabs = [
  {
    id: "all-day",
    label: "All-day dining",
    intro: "Served from noon every day across the bar and dining room, minutes from Newcastle promenade and Castlewellan Forest Park.",
    items: [
      {
        title: "All-day and evening main menu",
        detail: "Prime Mourne steaks, coastal fish, hearty Irish classics and daily kitchen specials cooked to order.",
        meta: "Mon to Sat from 12:00",
      },
      {
        title: "Children's menu",
        detail: "Home-cooked family plates for younger diners after a day on the coast or in the Mournes.",
        meta: "Family friendly",
      },
      {
        title: "Country bar and late weekend pours",
        detail: "Open from 11:30 daily beside the stone hearth, with late bar service on Fridays and Saturdays.",
        meta: "Fri and Sat to 01:00",
      },
    ],
  },
  {
    id: "sunday-roasts",
    label: "Sunday roasts",
    intro: "A long-standing County Down Sunday gathering, with traditional roasts and generous seasonal sides served straight through the afternoon.",
    items: [
      {
        title: "Traditional Sunday roast sittings",
        detail: "Roast beef, golden roast potatoes, seasonal vegetables and gravy served from noon until evening.",
        meta: "Sun 12:00 to 20:00",
      },
      {
        title: "Advance table booking via ResDiary",
        detail: "Reserve your family table directly online or call 028 4372 2236 for larger Sunday parties.",
        meta: "Booking advised",
      },
      {
        title: "Easy stop between Dundrum and Newcastle",
        detail: "Set on Ballyloughlin Road in Maghera, five minutes from Newcastle and six from Dundrum and Castlewellan.",
        meta: "Maghera, BT31 9HE",
      },
    ],
  },
  {
    id: "receptions",
    label: "Receptions",
    intro: "Warm country hospitality and tailored set menus for family milestones, anniversary suppers and private gatherings.",
    items: [
      {
        title: "Private functions and family receptions",
        detail: "Tailored set menus and buffet options for birthdays, christenings, anniversaries and family get-togethers.",
        meta: "Tailored menus",
      },
      {
        title: "Large group dining tables",
        detail: "Coordinated sitting times and menu choices for parties of ten or more, arranged directly with our events desk.",
        meta: "Parties of 10+",
      },
      {
        title: "Maghera Inn gift vouchers",
        detail: "Dining and celebration vouchers available directly from the inn or through the official website.",
        meta: "Direct or online",
      },
    ],
  },
];

const innGroups = [
  {
    id: "kitchen",
    label: "Kitchen Menus and Sunday Dining",
    items: [
      { name: "All-Day and Evening Main Menu", note: "Prime Mourne steaks, coastal fish, hearty Irish classics and daily specials served in the bar and dining room", meta: "Mon to Sat from 12:00" },
      { name: "Traditional Sunday Roasts", note: "Family Sunday sittings served 12:00 to 20:00. Advance booking advised via ResDiary", meta: "12:00 to 20:00" },
      { name: "Children's Menu", note: "Proper home-cooked family plates for younger diners after a day in Newcastle or Castlewellan", meta: "Family friendly" },
    ],
  },
  {
    id: "events",
    label: "Private Receptions and Gift Vouchers",
    items: [
      { name: "Private Functions and Family Receptions", note: "Tailored set menus and welcoming hospitality for birthdays, anniversaries and family gatherings", meta: "Enquire below" },
      { name: "Maghera Inn Gift Vouchers", note: "Available direct from the inn or online for dining and celebrations", meta: "Official site ↗" },
    ],
  },
];
---

<ConceptLayout
  title="The Maghera Inn | Country Pub, Dining and Receptions, Maghera, Castlewellan"
  slug="the-maghera-inn"
  bodyClass="concept-page concept-magherainn"
  businessName="The Maghera Inn"
  town="Maghera, Castlewellan"
  bannerNote="Imagery comprises indicative Mourne country inn hearth and traditional Sunday table visualisations."
>
  <header class="mi-header" data-mi-header>
    <div class="mi-header-inner">
      <a class="mi-brand" href="#top">The Maghera Inn</a>

      <nav class="mi-nav" aria-label="Primary">
        <a class="mi-nav-link" href="#dining">Dining</a>
        <a class="mi-nav-link" href="#hours">Hours</a>
        <a class="mi-nav-link" href="#receptions">Receptions</a>
        <a class="mi-nav-link" href="#location">Maghera</a>
      </nav>

      <div class="mi-header-actions">
        <a class="mi-header-tel" href={phoneHref}>{phone}</a>
        <a class="mi-header-cta" href={resDiaryHref} target="_blank" rel="noopener noreferrer">Book table</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="mi-hero" aria-labelledby="mi-hero-title">
      <span class="mi-hero-sentinel" aria-hidden="true" data-mi-sentinel></span>
      <div class="mi-hero-media">
        <picture>
          <source srcset="/media/concepts/the-maghera-inn/maghera-inn-hearth-640.webp 640w, /media/concepts/the-maghera-inn/maghera-inn-hearth-1265.webp 1265w" sizes="100vw" type="image/webp" />
          <img
            src="/media/concepts/the-maghera-inn/maghera-inn-hearth.jpg"
            alt="Warm traditional County Down country inn dining room with glowing hearth fire, exposed Mourne stone wall and brass lamps"
            width="1408"
            height="768"
            loading="eager"
          />
        </picture>
        <div class="mi-hero-scrim" aria-hidden="true"></div>
      </div>

      <div class="mi-wrap mi-hero-stage">
        <div class="mi-hero-lockup">
          <h1 id="mi-hero-title" class="mi-reveal mi-reveal-1">
            Fireside cooking below the Mournes.
          </h1>
          <div class="mi-hero-foot mi-reveal mi-reveal-2">
            <div class="mi-hero-copy">
              <p>
                All-day dining, traditional Sunday roasts and family receptions on Ballyloughlin Road, open seven days.
              </p>
              <a class="mi-primary-btn" href={resDiaryHref} target="_blank" rel="noopener noreferrer">
                Book a table
              </a>
            </div>
            <p class="mi-hero-caption">Indicative Maghera dining room visualisation.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="mi-band mi-band--limestone" id="dining" aria-labelledby="mi-din-title">
      <div class="mi-wrap mi-split">
        <div class="mi-col">
          <h2 id="mi-din-title">Drop in after a Mourne walk or book ahead for Sunday.</h2>

          <div class="mi-tabs" role="tablist" aria-label="All-day dining, Sunday roasts and receptions">
            {diningTabs.map((tab, idx) => (
              <button
                type="button"
                role="tab"
                id={`mi-tab-${tab.id}`}
                aria-selected={idx === 0 ? "true" : "false"}
                aria-controls={`mi-panel-${tab.id}`}
                tabindex={idx === 0 ? 0 : -1}
                class:list={["mi-tab", idx === 0 && "is-active"]}
                data-mi-tab={tab.id}
              >
                {tab.label}
              </button>
            ))}
          </div>

          {diningTabs.map((tab, idx) => (
            <div
              id={`mi-panel-${tab.id}`}
              role="tabpanel"
              aria-labelledby={`mi-tab-${tab.id}`}
              hidden={idx !== 0}
              class="mi-panel"
              data-mi-panel={tab.id}
            >
              <p class="mi-panel-intro">{tab.intro}</p>
              <ul class="mi-ledger">
                {tab.items.map((item) => (
                  <li class="mi-ledger-row">
                    <div class="mi-ledger-main">
                      <h3>{item.title}</h3>
                      <p>{item.detail}</p>
                    </div>
                    <span class="mi-ledger-meta">{item.meta}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}

          <div class="mi-sheet-row">
            <SpecimenSheet
              id="mi-menu-sheet"
              triggerLabel="Browse menus, roasts and events"
              kicker="The Maghera Inn, Maghera"
              title="Kitchen Menus, Service Times and Receptions"
              subtitle="Reserve tables live through ResDiary or call 028 4372 2236 for private groups."
              groups={innGroups}
              ctaLabel="Book table online ↗"
              ctaHref={resDiaryHref}
              ctaExternal={true}
              secondaryLabel={`Call ${phone}`}
              secondaryHref={phoneHref}
              buttonClass="mi-sheet-trigger"
            />
          </div>
        </div>

        <div class="mi-col" id="hours">
          <figure class="mi-plate">
            <picture>
              <source srcset="/media/concepts/the-maghera-inn/maghera-inn-sunday-table-640.webp 640w, /media/concepts/the-maghera-inn/maghera-inn-sunday-table-1265.webp 1265w" sizes="(max-width: 900px) 100vw, 46vw" type="image/webp" />
              <img
                src="/media/concepts/the-maghera-inn/maghera-inn-sunday-table.jpg"
                alt="Traditional Irish country pub roast beef supper with golden roast potatoes, seasonal vegetables and creamy dark stout"
                width="1408"
                height="768"
                loading="lazy"
              />
            </picture>
            <figcaption>Indicative Sunday dining visualisation.</figcaption>
          </figure>

          <div class="mi-hours-block">
            <h3>Bar and kitchen hours</h3>
            <dl class="mi-hours-list">
              <div><dt>Bar, Sun to Thu</dt><dd>11:30 to 23:00</dd></div>
              <div><dt>Bar, Fri to Sat</dt><dd>11:30 to 01:00</dd></div>
              <div><dt>Kitchen, Mon to Thu</dt><dd>12:00 to 21:00</dd></div>
              <div><dt>Kitchen, Fri to Sat</dt><dd>12:00 to 21:30</dd></div>
              <div><dt>Kitchen, Sunday</dt><dd>12:00 to 20:00</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="mi-band mi-band--peat" id="receptions" aria-labelledby="mi-rec-title">
      <div class="mi-wrap mi-split mi-split--enquire">
        <div class="mi-col">
          <h2 id="mi-rec-title">Host your celebration or gathering beside the hearth.</h2>
          <p class="mi-dark-copy">
            From anniversary dinners and christenings to family receptions and group set menus,
            share your target date and party size below or call <a href={phoneHref}>{phone}</a>.
          </p>
          <p class="mi-email-line">Events desk <a href={`mailto:${email}`}>{email}</a></p>
        </div>

        <div class="mi-col">
          <form class="mi-form" data-mi-form>
            <div class="mi-form-row">
              <label>
                <span>Your name</span>
                <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
              </label>
              <label>
                <span>Telephone</span>
                <input name="phone" type="tel" required autocomplete="tel" placeholder="028 or 07..." />
              </label>
            </div>
            <div class="mi-form-row">
              <label>
                <span>Occasion</span>
                <select name="occasion">
                  <option value="Family reception or celebration">Family reception or celebration</option>
                  <option value="Large group dining (10+)">Large group dining (10+)</option>
                  <option value="Private function or buffet">Private function or buffet</option>
                  <option value="Gift voucher enquiry">Gift voucher enquiry</option>
                </select>
              </label>
              <label>
                <span>Target date and guests</span>
                <input name="guests" type="text" placeholder="e.g. 24 guests, Saturday" />
              </label>
            </div>
            <label>
              <span>Menu or seating notes</span>
              <textarea name="notes" rows="3" placeholder="Dietary notes, preferred sitting time or set menu questions."></textarea>
            </label>
            <button class="mi-primary-btn mi-submit-btn" type="submit">Send event enquiry</button>
          </form>
        </div>
      </div>
    </section>

    <section class="mi-band mi-band--limestone mi-map-band" id="location" aria-label="Maghera Castlewellan map">
      <div class="mi-wrap">
        <LocalAreaMap
          id="mi-map"
          kicker=""
          businessName="The Maghera Inn"
          address="86-89 Ballyloughlin Road, Maghera, Castlewellan, BT31 9HE"
          lon={-5.8992}
          lat={54.2413}
          spanKm={16}
          mapHref={mapsHref}
          markers={[
            { name: "Newcastle", lon: -5.8902, lat: 54.2121, note: "5 mins south", side: "b" },
            { name: "Dundrum", lon: -5.8442, lat: 54.2591, note: "6 mins north-east", side: "r" },
            { name: "Castlewellan", lon: -5.9442, lat: 54.2596, note: "6 mins north-west", side: "l" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="mi-footer">
    <div class="mi-wrap mi-footer-inner">
      <div>
        <strong class="mi-footer-brand">The Maghera Inn</strong>
        <p>86-89 Ballyloughlin Road, Maghera, Castlewellan, Co. Down, BT31 9HE</p>
      </div>
      <div class="mi-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={resDiaryHref} target="_blank" rel="noopener noreferrer">ResDiary ↗</a>
        <a href={siteHref} target="_blank" rel="noopener noreferrer">Vouchers ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-mi-header]");
      const sentinel = document.querySelector("[data-mi-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            header.classList.toggle("is-scrolled", !entries[0].isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      const tabs = [...document.querySelectorAll("[data-mi-tab]")];
      const panels = [...document.querySelectorAll("[data-mi-panel]")];
      const activateTab = (id, focusTab = false) => {
        tabs.forEach((btn) => {
          const active = btn.dataset.miTab === id;
          btn.classList.toggle("is-active", active);
          btn.setAttribute("aria-selected", active ? "true" : "false");
          btn.tabIndex = active ? 0 : -1;
          if (active && focusTab) btn.focus();
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.miPanel !== id;
        });
      };

      tabs.forEach((btn, idx) => {
        btn.addEventListener("click", () => activateTab(btn.dataset.miTab));
        btn.addEventListener("keydown", (e) => {
          if (e.key === "ArrowRight") {
            e.preventDefault();
            activateTab(tabs[(idx + 1) % tabs.length].dataset.miTab, true);
          } else if (e.key === "ArrowLeft") {
            e.preventDefault();
            activateTab(tabs[(idx - 1 + tabs.length) % tabs.length].dataset.miTab, true);
          }
        });
      });

      const form = document.querySelector("[data-mi-form]");
      if (form) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;
          const fd = new FormData(form);
          const subject = `Event enquiry: ${fd.get("occasion")} (${fd.get("name")})`;
          const body = [
            `Name: ${fd.get("name")}`,
            `Phone: ${fd.get("phone")}`,
            `Occasion: ${fd.get("occasion")}`,
            `Date and party size: ${fd.get("guests") || "Flexible"}`,
            `Notes: ${fd.get("notes") || "None"}`,
          ].join("\n");
          const ev = new CustomEvent("mm:enquiry", {
            cancelable: true,
            detail: { to: "enquiries@themagherainn.com", subject, body },
          });
          if (window.dispatchEvent(ev)) {
            window.location.href = `mailto:enquiries@themagherainn.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
          }
        });
      }
    })();
  </script>
</ConceptLayout>
