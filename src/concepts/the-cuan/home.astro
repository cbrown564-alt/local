---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import "./styles.css";

/* The Cuan, 6-12 The Square, Strangford Village BT30 7ND.
   Verified live 26 Nov 2026: Live ResDiary (22900), live room packages, live giveavoucher.com/thecuan.
   Phone: 028 4488 1222. */
const phone = "028 4488 1222";
const phoneHref = "tel:+442844881222";
const tableHref = "https://booking.resdiary.com/widget/Standard/TheCuan/22900?";
const roomHref = "https://thecuan.com/bookings/#!/accommodation/packages";
const voucherHref = "https://www.giveavoucher.com/thecuan";
const fbHref = "https://www.facebook.com/thecuan";
const igHref = "https://www.instagram.com/thecuan_/?hl=en";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=The+Cuan+6+The+Square+Strangford+BT30+7ND";

const cuanGroups = [
  {
    id: "dining",
    label: "Strangford dining",
    items: [
      {
        name: "Strangford Lough seafood",
        note: "Locally landed oysters, shellfish, and daily coastal fish served steps from the slipway.",
        meta: "Book via ResDiary",
      },
      {
        name: "Breakfast (Fri to Mon)",
        note: "Morning service from 08:00 to 10:30 for residents and Strangford visitors.",
        meta: "08:00 to 10:30",
      },
      {
        name: "Evening and Sunday tables",
        note: "Last kitchen orders Thu and Sun 19:45, Fri and Sat 20:45.",
        meta: "Reserve online",
      },
    ],
  },
  {
    id: "stay",
    label: "Luxury rooms and Cuan House",
    items: [
      {
        name: "Luxury village bedrooms",
        note: "Boutique en-suite rooms on The Square overlooking Strangford Lough.",
        meta: "Direct packages",
      },
      {
        name: "Cuan House and packages",
        note: "Dine-and-stay escapes, winter coastal breaks, and instant gift vouchers.",
        meta: "Book online",
      },
    ],
  },
];
---

<ConceptLayout
  title="The Cuan, Harbourside Inn, Rooms and Dining, Strangford"
  slug="the-cuan"
  bodyClass="concept-page concept-thecuan"
  businessName="The Cuan"
  town="Strangford"
  bannerNote="Imagery comprises indicative Strangford dining room and boutique bedroom visualisations."
>
  <header class="tc-header" data-tc-header>
    <div class="tc-header-inner">
      <a class="tc-brand" href="#top">The Cuan</a>
      <nav class="tc-nav" aria-label="Primary">
        <a href="#rooms">Dining and rooms</a>
        <a href="#hours">Dining hours</a>
        <a href="#enquire">Enquire</a>
        <a href="#location">Strangford</a>
      </nav>
      <div class="tc-header-actions">
        <a class="tc-header-tel" href={phoneHref}>{phone}</a>
        <a class="tc-header-cta" href={tableHref} target="_blank" rel="noopener noreferrer">Book table</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="tc-hero" aria-labelledby="tc-hero-title">
      <div class="tc-hero-sentinel" data-tc-sentinel aria-hidden="true"></div>
      <div class="tc-hero-media">
        <picture>
          <source
            srcset="/media/concepts/the-cuan/the-cuan-harbour-dining-640.webp 640w, /media/concepts/the-cuan/the-cuan-harbour-dining-1265.webp 1265w"
            sizes="100vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/the-cuan/the-cuan-harbour-dining.jpg"
            alt="Candlelit coastal seafood dining room in Strangford village with fresh oysters and twilight harbour light"
            width="1408"
            height="768"
            loading="eager"
          />
        </picture>
        <div class="tc-hero-scrim" aria-hidden="true"></div>
      </div>

      <div class="tc-wrap tc-hero-foot">
        <div class="tc-hero-title-col">
          <h1 id="tc-hero-title">Strangford seafood and harbour twilight.</h1>
        </div>
        <div class="tc-hero-copy-col">
          <p class="tc-hero-lead">
            Freshly landed lough shellfish, evening dining, and boutique rooms in Cuan House steps from the Portaferry slipway.
          </p>
          <a class="tc-btn tc-btn--hero" href={tableHref} target="_blank" rel="noopener noreferrer">Book via ResDiary</a>
          <p class="tc-hero-caption">Indicative Strangford dining room visualisation.</p>
        </div>
      </div>
    </section>

    <section class="tc-section tc-stage" id="rooms" aria-labelledby="tc-rooms-title">
      <div class="tc-wrap tc-stage-grid">
        <div class="tc-stage-copy">
          <h2 id="tc-rooms-title">Dinner beside the narrows and quiet rooms on The Square.</h2>

          <div class="tc-tabs" role="tablist" aria-label="Dining, Cuan House rooms, and vouchers" data-tc-tabs>
            <button
              type="button"
              class="tc-tab"
              role="tab"
              id="tc-tab-dining"
              aria-selected="true"
              aria-controls="tc-panel-dining"
            >
              Dining
            </button>
            <button
              type="button"
              class="tc-tab"
              role="tab"
              id="tc-tab-rooms"
              aria-selected="false"
              aria-controls="tc-panel-rooms"
              tabindex="-1"
            >
              Cuan House rooms
            </button>
            <button
              type="button"
              class="tc-tab"
              role="tab"
              id="tc-tab-vouchers"
              aria-selected="false"
              aria-controls="tc-panel-vouchers"
              tabindex="-1"
            >
              Vouchers
            </button>
          </div>

          <div class="tc-panel" role="tabpanel" id="tc-panel-dining" aria-labelledby="tc-tab-dining">
            <p>
              Locally landed Strangford Lough oysters, shellfish, and daily coastal fish served steps from the ferry slipway, with breakfast served Friday through Monday mornings.
            </p>
            <dl class="tc-stage-ledger">
              <div>
                <dt>Table reservations</dt>
                <dd><a href={tableHref} target="_blank" rel="noopener noreferrer">Book live via ResDiary ↗</a></dd>
              </div>
              <div>
                <dt>Breakfast service</dt>
                <dd>Friday to Monday, 08:00 to 10:30</dd>
              </div>
              <div>
                <dt>Last food orders</dt>
                <dd>Thu and Sun 19:45, Fri and Sat 20:45</dd>
              </div>
            </dl>
          </div>

          <div class="tc-panel" role="tabpanel" id="tc-panel-rooms" aria-labelledby="tc-tab-rooms" hidden>
            <p>
              Wake on The Square five minutes from Castle Ward and ten minutes from Ardglass links, with luxury village bedrooms and dine-and-stay escapes in Cuan House.
            </p>
            <dl class="tc-stage-ledger">
              <div>
                <dt>Room packages</dt>
                <dd><a href={roomHref} target="_blank" rel="noopener noreferrer">Check direct room packages ↗</a></dd>
              </div>
              <div>
                <dt>Nearby landmarks</dt>
                <dd>Steps to Strangford ferry, 4 minutes to Castle Ward, 14 minutes to Ardglass</dd>
              </div>
              <div>
                <dt>Reception desk</dt>
                <dd><a href={phoneHref}>{phone}</a></dd>
              </div>
            </dl>
          </div>

          <div class="tc-panel" role="tabpanel" id="tc-panel-vouchers" aria-labelledby="tc-tab-vouchers" hidden>
            <p>
              Share dinner on Strangford Lough or an overnight escape in Cuan House with instant online gift vouchers for coastal breaks and celebrations.
            </p>
            <dl class="tc-stage-ledger">
              <div>
                <dt>Instant vouchers</dt>
                <dd><a href={voucherHref} target="_blank" rel="noopener noreferrer">Order gift vouchers online ↗</a></dd>
              </div>
              <div>
                <dt>Redeemable for</dt>
                <dd>Evening dining, weekend stays, and dine-and-stay packages</dd>
              </div>
              <div>
                <dt>Desk assistance</dt>
                <dd><a href={phoneHref}>{phone}</a></dd>
              </div>
            </dl>
          </div>

          <div class="tc-stage-sheet">
            <SpecimenSheet
              id="tc-inn-sheet"
              triggerLabel="Open menus and rooms guide"
              kicker="The Cuan, 6-12 The Square, Strangford"
              title="Dining, luxury rooms, and gift vouchers"
              subtitle="Live table booking via ResDiary, direct stay packages, and instant vouchers."
              groups={cuanGroups}
              ctaLabel="Order gift vouchers ↗"
              ctaHref={voucherHref}
              ctaExternal={true}
              secondaryLabel={`Call ${phone}`}
              secondaryHref={phoneHref}
              buttonClass="tc-link-trigger"
            />
          </div>
        </div>

        <div class="tc-stage-media">
          <figure class="tc-plate">
            <picture>
              <source
                srcset="/media/concepts/the-cuan/the-cuan-luxury-room-640.webp 640w, /media/concepts/the-cuan/the-cuan-luxury-room-1265.webp 1265w"
                sizes="(max-width: 960px) 100vw, 48vw"
                type="image/webp"
              />
              <img
                src="/media/concepts/the-cuan/the-cuan-luxury-room.jpg"
                alt="Coastal village boutique hotel bedroom with oatmeal headboard, navy throw, and Strangford Lough morning light"
                width="1408"
                height="768"
                loading="lazy"
              />
            </picture>
            <figcaption>Boutique stay on The Square. Indicative bedroom visualisation.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="tc-section tc-hours-band" id="hours" aria-labelledby="tc-hours-title">
      <div class="tc-wrap tc-split">
        <div class="tc-copy-col">
          <h2 id="tc-hours-title">Plan your crossing and table sitting.</h2>
          <p>
            Reserve ahead online for Thursday through Sunday dining, or call the desk directly on <a href={phoneHref}>{phone}</a> for weddings, private groups, and seasonal hours.
          </p>
        </div>
        <div class="tc-ledger-col">
          <dl class="tc-ledger">
            <div>
              <dt>Sunday to Thursday</dt>
              <dd>08:00 to 20:00</dd>
            </div>
            <div>
              <dt>Friday and Saturday</dt>
              <dd>08:00 to 21:00</dd>
            </div>
            <div>
              <dt>Breakfast (Fri to Mon)</dt>
              <dd>08:00 to 10:30</dd>
            </div>
            <div>
              <dt>Last food orders</dt>
              <dd>Thu and Sun 19:45, Fri and Sat 20:45</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="tc-section tc-enquire" id="enquire" aria-labelledby="tc-enquire-title">
      <div class="tc-wrap tc-split">
        <div class="tc-copy-col">
          <h2 id="tc-enquire-title">Enquire for private dining, weddings, or Cuan House stays.</h2>
          <p>
            For same-day tables use <a href={tableHref} target="_blank" rel="noopener noreferrer">ResDiary ↗</a> or call <a href={phoneHref}>{phone}</a>. Put together your stay or group details below to send directly to the desk.
          </p>
          <dl class="tc-ledger">
            <div>
              <dt>Address</dt>
              <dd>6-12 The Square, Strangford, Downpatrick, BT30 7ND</dd>
            </div>
            <div>
              <dt>Direct bookings</dt>
              <dd class="tc-inline-links">
                <a href={tableHref} target="_blank" rel="noopener noreferrer">ResDiary ↗</a>
                <a href={roomHref} target="_blank" rel="noopener noreferrer">Room packages ↗</a>
                <a href={voucherHref} target="_blank" rel="noopener noreferrer">Vouchers ↗</a>
              </dd>
            </div>
          </dl>
        </div>

        <div class="tc-form-col">
          <form class="tc-form" data-tc-form>
            <div class="tc-row">
              <label>
                <span>Your name</span>
                <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
              </label>
              <label>
                <span>Telephone</span>
                <input name="phone" type="tel" required autocomplete="tel" placeholder="028 or 07..." />
              </label>
            </div>
            <div class="tc-row">
              <label>
                <span>Preferred date</span>
                <input name="date" type="date" required />
              </label>
              <label>
                <span>Guests</span>
                <input name="guests" type="number" min="1" max="60" value="4" required />
              </label>
            </div>
            <label>
              <span>Enquiry type</span>
              <select name="topic">
                <option value="Dinner table or group">Dinner table or group</option>
                <option value="Cuan House room stay">Cuan House room stay</option>
                <option value="Dine-and-stay coastal break">Dine-and-stay coastal break</option>
                <option value="Wedding or private celebration">Wedding or private celebration</option>
                <option value="Gift voucher enquiry">Gift voucher enquiry</option>
              </select>
            </label>
            <label>
              <span>Notes or dietary requests</span>
              <textarea name="notes" rows="3" placeholder="Preferred sitting time, ferry arrival, room count, or dietary notes"></textarea>
            </label>
            <button class="tc-btn tc-btn--dark" type="submit">Prepare desk enquiry</button>
          </form>
        </div>
      </div>
    </section>

    <section class="tc-section tc-map-band" id="location" aria-label="Strangford Village map">
      <div class="tc-wrap">
        <LocalAreaMap
          id="tc-map"
          kicker=""
          businessName="The Cuan"
          address="6-12 The Square, Strangford, Downpatrick, BT30 7ND"
          lon={-5.5557431}
          lat={54.3708398}
          spanKm={16}
          showFerry={true}
          mapHref={mapsHref}
          markers={[
            { name: "Castle Ward", lon: -5.5811, lat: 54.3735, note: "4 mins west", side: "l" },
            { name: "Downpatrick", lon: -5.7168, lat: 54.3286, note: "15 mins west", side: "l" },
            { name: "Ardglass", lon: -5.6085, lat: 54.2613, note: "14 mins south", side: "b" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="tc-footer">
    <div class="tc-wrap tc-footer-inner">
      <div>
        <strong>The Cuan</strong>
        <p>6-12 The Square, Strangford Village, Co. Down, BT30 7ND</p>
      </div>
      <div class="tc-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={voucherHref} target="_blank" rel="noopener noreferrer">Vouchers ↗</a>
        <a href={fbHref} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
        <a href={igHref} target="_blank" rel="noopener noreferrer">Instagram ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-tc-header]");
      const sentinel = document.querySelector("[data-tc-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            const entry = entries[0];
            if (!entry) return;
            header.classList.toggle("is-scrolled", !entry.isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      const tablist = document.querySelector("[data-tc-tabs]");
      if (tablist) {
        const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
        const activate = (tab, moveFocus) => {
          tabs.forEach((t) => {
            const selected = t === tab;
            t.setAttribute("aria-selected", String(selected));
            t.tabIndex = selected ? 0 : -1;
            const panelId = t.getAttribute("aria-controls");
            const panel = panelId ? document.getElementById(panelId) : null;
            if (panel) panel.hidden = !selected;
          });
          if (moveFocus) tab.focus();
        };
        tabs.forEach((tab, idx) => {
          tab.addEventListener("click", () => activate(tab, false));
          tab.addEventListener("keydown", (e) => {
            if (e.key === "ArrowRight") {
              e.preventDefault();
              activate(tabs[(idx + 1) % tabs.length], true);
            } else if (e.key === "ArrowLeft") {
              e.preventDefault();
              activate(tabs[(idx - 1 + tabs.length) % tabs.length], true);
            } else if (e.key === "Home") {
              e.preventDefault();
              activate(tabs[0], true);
            } else if (e.key === "End") {
              e.preventDefault();
              activate(tabs[tabs.length - 1], true);
            }
          });
        });
      }

      const form = document.querySelector("[data-tc-form]");
      if (form) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;
          const fd = new FormData(form);
          const topic = String(fd.get("topic") || "Enquiry");
          const dateVal = String(fd.get("date") || "Flexible");
          const guests = String(fd.get("guests") || "2");
          const subject = `${topic}: ${guests} guests (${dateVal})`;
          const body = [
            `Name: ${fd.get("name")}`,
            `Telephone: ${fd.get("phone")}`,
            `Preferred date: ${dateVal}`,
            `Guests: ${guests}`,
            `Enquiry: ${topic}`,
            `Notes: ${fd.get("notes") || "None"}`,
          ].join("\n");
          const ev = new CustomEvent("mm:enquiry", {
            cancelable: true,
            detail: {
              to: "The Cuan desk (028 4488 1222)",
              subject,
              body,
              url: "tel:+442844881222",
            },
          });
          if (window.dispatchEvent(ev)) {
            window.location.href = "tel:+442844881222";
          }
        });
      }
    })();
  </script>
</ConceptLayout>
