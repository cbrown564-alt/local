---
/* Eamon McAuley Interior Design: Deep Charcoal-Taupe High Street Atelier Stage
   Pairs the 16/10 fabric-atelier plate with an interactive segmented tablist for
   Residential schemes, High Street showroom, and Bespoke beds and fabrics. */
interface Props {
  mobile: string;
  mobileHref: string;
  landline: string;
  landlineHref: string;
  siteHref: string;
}
const { mobile, mobileHref, landline, landlineHref, siteHref } = Astro.props;

const tabs = [
  {
    id: "residential",
    label: "Residential schemes",
    heading: "Single rooms and full home builds shaped around light, scale and daily living.",
    summary:
      "From reworking a living room, kitchen-dining space or master suite to guiding a full new build from first-fix lighting through installation styling.",
    rows: [
      { term: "Space and lighting", value: "Layout, furniture scale plan and early electrical sightlines" },
      { term: "Material schedule", value: "Curated Irish linen, wool, stone, hardware and paint direction" },
      { term: "What to bring", value: "Rough room dimensions, daylight phone photos or architect plans" },
    ],
  },
  {
    id: "showroom",
    label: "High Street showroom",
    heading: "Compare weave, stone and undertone in natural daylight at 28 High Street.",
    summary:
      "Screens flatten texture and colour. Visit our Ballynahinch showroom to hold linens, wools, framed artwork, tableware, throws, candles and diffusers side by side.",
    rows: [
      { term: "Homeware edit", value: "Seasonal tableware, framed artwork, sculptural lighting and throws" },
      { term: "Home fragrance", value: "Curated diffusers, candles and room sprays selected in studio" },
      { term: "One-to-one visits", value: "Ring ahead on mobile or studio line for uninterrupted styling time" },
    ],
  },
  {
    id: "bespoke",
    label: "Bespoke beds and fabrics",
    heading: "Hand-finished drapery, statement beds and made-to-order upholstery.",
    summary:
      "Every bed, mattress, curtain heading and upholstered piece is specified from our High Street fabric library so proportions and finish hold together across the room.",
    rows: [
      { term: "Beds and sleep", value: "Bespoke beds and mattresses tailored to bedroom proportions" },
      { term: "Window dressing", value: "Curtains, blinds, poles, tracks and hand-finished headings" },
      { term: "Finishing layers", value: "Coordinated cushions, throws, rugs and made-to-order seating" },
    ],
  },
];
---

<section class="em-section em-atelier" id="atelier" aria-labelledby="em-atelier-title">
  <div class="em-wrap em-atelier-grid">
    <div class="em-atelier-media">
      <figure class="em-plate">
        <picture>
          <source
            srcset="/media/concepts/eamon-mcauley-interiors/eamon-mcauley-fabric-atelier-640.webp 640w, /media/concepts/eamon-mcauley-interiors/eamon-mcauley-fabric-atelier-1265.webp 1265w"
            sizes="(max-width: 900px) 100vw, 46vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/eamon-mcauley-interiors/eamon-mcauley-fabric-atelier.jpg"
            alt="Interior designer worktable with Irish linen swatches, herringbone wool, bronze hardware and limestone samples"
            width="1408"
            height="768"
            loading="lazy"
          />
        </picture>
        <figcaption>Material library and fabric sampling at 28 High Street. Indicative studio visualisation.</figcaption>
      </figure>

      <dl class="em-atelier-meta">
        <div>
          <dt>Direct mobile</dt>
          <dd><a href={mobileHref}>{mobile}</a></dd>
        </div>
        <div>
          <dt>Studio line</dt>
          <dd><a href={landlineHref}>{landline}</a></dd>
        </div>
        <div>
          <dt>Online catalogue</dt>
          <dd>
            <a href={siteHref} target="_blank" rel="noopener noreferrer">eamonmcauleyinteriordesign.com ↗</a>
          </dd>
        </div>
      </dl>
    </div>

    <div class="em-atelier-main" data-em-brief>
      <h2 id="em-atelier-title">High Street atelier and residential design studio.</h2>

      <div class="em-tabs" role="tablist" aria-label="Explore design and showroom services">
        {tabs.map((tab, idx) => (
          <button
            type="button"
            role="tab"
            id={`em-tab-${tab.id}`}
            aria-controls={`em-panel-${tab.id}`}
            aria-selected={idx === 0 ? "true" : "false"}
            tabindex={idx === 0 ? 0 : -1}
            class:list={["em-tab", idx === 0 && "is-active"]}
            data-em-tab={tab.id}
          >
            {tab.label}
          </button>
        ))}
      </div>

      {tabs.map((tab, idx) => (
        <div
          class="em-panel"
          role="tabpanel"
          id={`em-panel-${tab.id}`}
          aria-labelledby={`em-tab-${tab.id}`}
          data-em-panel={tab.id}
          hidden={idx !== 0}
        >
          <h3>{tab.heading}</h3>
          <p>{tab.summary}</p>
          <dl class="em-ledger">
            {tab.rows.map((row) => (
              <div class="em-ledger-row">
                <dt>{row.term}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-em-brief]");
    if (!root) return;
    const tabs = Array.from(root.querySelectorAll("[data-em-tab]"));
    const panels = Array.from(root.querySelectorAll("[data-em-panel]"));

    const selectTab = (id, moveFocus) => {
      tabs.forEach((tab) => {
        const active = tab.getAttribute("data-em-tab") === id;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-selected", active ? "true" : "false");
        tab.setAttribute("tabindex", active ? "0" : "-1");
        if (active && moveFocus) tab.focus();
      });
      panels.forEach((panel) => {
        panel.hidden = panel.getAttribute("data-em-panel") !== id;
      });
    };

    tabs.forEach((tab, idx) => {
      tab.addEventListener("click", () => selectTab(tab.getAttribute("data-em-tab"), false));
      tab.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") {
          e.preventDefault();
          const next = tabs[(idx + 1) % tabs.length];
          selectTab(next.getAttribute("data-em-tab"), true);
        } else if (e.key === "ArrowLeft") {
          e.preventDefault();
          const prev = tabs[(idx - 1 + tabs.length) % tabs.length];
          selectTab(prev.getAttribute("data-em-tab"), true);
        } else if (e.key === "Home") {
          e.preventDefault();
          selectTab(tabs[0].getAttribute("data-em-tab"), true);
        } else if (e.key === "End") {
          e.preventDefault();
          selectTab(tabs[tabs.length - 1].getAttribute("data-em-tab"), true);
        }
      });
    });
  })();
</script>
