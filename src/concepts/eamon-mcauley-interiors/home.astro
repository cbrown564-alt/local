---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import EmiSchemeBrief from "./EmiSchemeBrief.astro";
import "./styles.css";

/* Eamon McAuley Interior Design, 28 High Street, Ballynahinch BT24 8AB.
   Verified live 26 Nov 2026: eamonmcauleyinteriordesign.com.
   Residential interior design, Ballynahinch showroom, bespoke beds and mattresses,
   artwork, tableware, throws, diffusers and candles.
   Phone: 028 9086 0000, Mobile: 07761 147757. */
const mobile = "07761 147757";
const mobileHref = "tel:+447761147757";
const landline = "028 9086 0000";
const landlineHref = "tel:+442890860000";
const siteHref = "https://www.eamonmcauleyinteriordesign.com/";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Eamon+McAuley+Interior+Design+28+High+Street+Ballynahinch+BT24+8AB";
---

<ConceptLayout
  title="Eamon McAuley Interior Design, Studio and Showroom, Ballynahinch"
  slug="eamon-mcauley-interiors"
  bodyClass="concept-page concept-eamonmcauley"
  businessName="Eamon McAuley Interior Design"
  town="Ballynahinch"
  bannerNote="Imagery comprises indicative residential living-room and fabric-atelier visualisations."
>
  <header class="em-header" data-em-header>
    <div class="em-header-inner">
      <a class="em-brand" href="#top">Eamon McAuley</a>
      <nav class="em-nav" aria-label="Primary">
        <a href="#atelier">High Street atelier</a>
        <a href="#consultation">Consultation</a>
        <a href="#location">Ballynahinch</a>
      </nav>
      <div class="em-header-actions">
        <a class="em-header-tel" href={mobileHref}>{mobile}</a>
        <a class="em-header-cta" href="#consultation">Consultation</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="em-hero" aria-labelledby="em-hero-title">
      <span class="em-hero-sentinel" data-em-sentinel aria-hidden="true"></span>
      <div class="em-wrap">
        <div class="em-hero-lockup">
          <h1 id="em-hero-title">Tailored interiors for how a house is lived in.</h1>
          <p class="em-lead">
            Residential interior design across County Down and Belfast, anchored by our High Street showroom in Ballynahinch.
          </p>
          <a class="em-btn em-btn--primary" href="#consultation">Arrange a consultation</a>
        </div>

        <figure class="em-hero-plate">
          <picture>
            <source
              srcset="/media/concepts/eamon-mcauley-interiors/eamon-mcauley-living-scheme-640.webp 640w, /media/concepts/eamon-mcauley-interiors/eamon-mcauley-living-scheme-1265.webp 1265w"
              sizes="(max-width: 960px) 100vw, 92vw"
              type="image/webp"
            />
            <img
              src="/media/concepts/eamon-mcauley-interiors/eamon-mcauley-living-scheme.jpg"
              alt="Tailored contemporary-classic living room with bouclé seating, walnut joinery and pleated silk drapery"
              width="1408"
              height="768"
              loading="eager"
            />
          </picture>
          <figcaption>Residential living-room direction. Indicative interior visualisation.</figcaption>
        </figure>
      </div>
    </section>

    <EmiSchemeBrief
      mobile={mobile}
      mobileHref={mobileHref}
      landline={landline}
      landlineHref={landlineHref}
      siteHref={siteHref}
    />

    <section class="em-section em-consult" id="consultation" aria-labelledby="em-consult-title">
      <div class="em-wrap em-split">
        <div class="em-consult-intro">
          <h2 id="em-consult-title">Arrange a studio consultation on High Street.</h2>
          <p>
            Share your room dimensions, build stage, or the pieces you want to explore in daylight at 28 High Street,
            and we will confirm a quiet consultation slot.
          </p>
          <dl class="em-contact-ledger">
            <div>
              <dt>Direct mobile</dt>
              <dd><a href={mobileHref}>{mobile}</a></dd>
            </div>
            <div>
              <dt>Studio line</dt>
              <dd><a href={landlineHref}>{landline}</a></dd>
            </div>
            <div>
              <dt>Showroom</dt>
              <dd>28 High Street, Ballynahinch, BT24 8AB</dd>
            </div>
          </dl>
        </div>

        <form class="em-form" data-em-form>
          <div class="em-row">
            <label>
              <span>Your name</span>
              <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
            </label>
            <label>
              <span>Telephone</span>
              <input name="phone" type="tel" required autocomplete="tel" placeholder="028 or 07..." />
            </label>
          </div>
          <div class="em-row">
            <label>
              <span>Project focus</span>
              <select name="scope">
                <option value="Residential room scheme">Residential room scheme</option>
                <option value="Full home or new build">Full home or new build</option>
                <option value="Bespoke beds, upholstery and drapery">Bespoke beds, upholstery and drapery</option>
                <option value="High Street showroom visit">High Street showroom visit</option>
              </select>
            </label>
            <label>
              <span>Preferred date</span>
              <input name="date" type="date" required />
            </label>
          </div>
          <label>
            <span>Property location</span>
            <input name="location" type="text" placeholder="Ballynahinch, Saintfield, Belfast or surrounding County Down" />
          </label>
          <label>
            <span>Project notes</span>
            <textarea name="notes" rows="3" placeholder="Rooms involved, build timeline, or fabrics and pieces you have in mind"></textarea>
          </label>
          <button class="em-btn em-btn--primary" type="submit">Prepare consultation enquiry</button>
        </form>
      </div>
    </section>

    <section class="em-section em-map-band" id="location" aria-label="Ballynahinch showroom map">
      <div class="em-wrap">
        <LocalAreaMap
          id="em-map"
          kicker=""
          businessName="Eamon McAuley"
          address="28 High Street, Ballynahinch, BT24 8AB"
          lon={-5.8970602}
          lat={54.4010942}
          spanKm={20}
          mapHref={mapsHref}
          markers={[
            { name: "Saintfield", lon: -5.8338, lat: 54.4581, note: "9 mins north", side: "t" },
            { name: "Crossgar", lon: -5.7644, lat: 54.4021, note: "11 mins east", side: "r" },
            { name: "Castlewellan", lon: -5.9442, lat: 54.2596, note: "16 mins south", side: "b" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="em-footer">
    <div class="em-wrap em-footer-inner">
      <div>
        <strong>Eamon McAuley Interior Design</strong>
        <p>28 High Street, Ballynahinch, Co. Down, BT24 8AB</p>
      </div>
      <div class="em-footer-links">
        <a href={mobileHref}>{mobile}</a>
        <a href={landlineHref}>{landline}</a>
        <a href={siteHref} target="_blank" rel="noopener noreferrer">Online catalogue ↗</a>
        <a href={mapsHref} target="_blank" rel="noopener noreferrer">Showroom directions ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-em-header]");
      const sentinel = document.querySelector("[data-em-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            header.classList.toggle("is-scrolled", !entries[0].isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      const form = document.querySelector("[data-em-form]");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        const subject = `Eamon McAuley Consultation: ${fd.get("scope")} (${fd.get("date")})`;
        const body = [
          `Name: ${fd.get("name")}`,
          `Phone: ${fd.get("phone")}`,
          `Project focus: ${fd.get("scope")}`,
          `Preferred date: ${fd.get("date")}`,
          `Location: ${fd.get("location") || "Not specified"}`,
          `Notes: ${fd.get("notes") || "None"}`,
        ].join("\n");
        const ev = new CustomEvent("mm:enquiry", {
          cancelable: true,
          detail: {
            to: "Eamon McAuley Studio (07761 147757)",
            subject,
            body,
            url: "tel:+447761147757",
            phone: "07761 147757",
            phoneHref: "tel:+447761147757",
          },
        });
        if (window.dispatchEvent(ev)) {
          window.location.href = "tel:+447761147757";
        }
      });
    })();
  </script>
</ConceptLayout>
