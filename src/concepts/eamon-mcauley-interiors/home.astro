---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import EmiSchemeBrief from "./EmiSchemeBrief.astro";
import "./styles.css";

/* Eamon McAuley Interior Design — 28 High Street, Ballynahinch BT24 8AB.
   Verified live 26 Nov 2026: eamonmcauleyinteriordesign.com prints raw --> HTML leaks & legacy
   &#9658; Shop &#9668; nav artifacts. Residential interior design, Ballynahinch showroom,
   bespoke beds & mattresses, artwork, tableware, throws, diffusers & candles.
   Phone: 028 9086 0000 / Mobile: 07761 147757. */
const mobile = "07761 147757";
const mobileHref = "tel:+447761147757";
const landline = "028 9086 0000";
const landlineHref = "tel:+442890860000";
const siteHref = "https://www.eamonmcauleyinteriordesign.com/";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Eamon+McAuley+Interior+Design+28+High+Street+Ballynahinch+BT24+8AB";
---

<ConceptLayout
  title="Eamon McAuley Interior Design — Studio & Showroom, Ballynahinch"
  slug="eamon-mcauley-interiors"
  bodyClass="concept-page concept-eamonmcauley"
  businessName="Eamon McAuley Interior Design"
  town="Ballynahinch"
  bannerNote="Imagery comprises indicative residential living-room and fabric-atelier visualisations."
>
  <header class="em-header">
    <div class="em-header-inner">
      <a class="em-brand" href="#top">
        <strong>Eamon McAuley</strong>
        <span>Interior Design · Ballynahinch</span>
      </a>
      <nav class="em-nav" aria-label="Primary">
        <a href="#scope">Design Service</a>
        <a href="#atelier">High Street Showroom</a>
        <a href="#location">Visit Studio</a>
      </nav>
      <div class="em-header-actions">
        <a class="em-header-tel" href={mobileHref}>{mobile}</a>
        <a class="em-header-cta" href="#scope">Consultation</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="em-hero" aria-labelledby="em-hero-title">
      <div class="em-wrap em-hero-grid">
        <div class="em-hero-copy">
          <p class="em-kicker">28 High Street · Ballynahinch · County Down</p>
          <h1 id="em-hero-title">Calm, tailored interiors shaped for how a house is lived in.</h1>
          <p class="em-lead">
            Residential interior design across County Down and Belfast, anchored by our High Street
            showroom of bespoke furniture, beds, artwork, tableware, throws and home fragrance.
          </p>
          <div class="em-actions">
            <a class="em-btn em-btn--primary" href={mobileHref}>Call to Arrange a Consultation</a>
            <a class="em-btn em-btn--outline" href="#atelier">Explore the Showroom</a>
          </div>
        </div>
        <figure class="em-hero-plate">
          <picture>
            <source srcset="/media/concepts/eamon-mcauley-interiors/eamon-mcauley-living-scheme-640.webp 640w, /media/concepts/eamon-mcauley-interiors/eamon-mcauley-living-scheme-1265.webp 1265w" sizes="(max-width: 900px) 100vw, 52vw" type="image/webp" />
            <img src="/media/concepts/eamon-mcauley-interiors/eamon-mcauley-living-scheme.jpg" alt="Tailored contemporary-classic living room with bouclé seating, walnut joinery and pleated silk drapery" width="1408" height="768" loading="eager" />
          </picture>
          <figcaption>Residential living-room direction. Indicative interior visualisation.</figcaption>
        </figure>
      </div>
    </section>

    <EmiSchemeBrief mobile={mobile} mobileHref={mobileHref} landline={landline} landlineHref={landlineHref} />

    <section class="em-section em-atelier" id="atelier" aria-labelledby="em-at-title">
      <div class="em-wrap em-split">
        <figure class="em-plate">
          <picture>
            <source srcset="/media/concepts/eamon-mcauley-interiors/eamon-mcauley-fabric-atelier-640.webp 640w, /media/concepts/eamon-mcauley-interiors/eamon-mcauley-fabric-atelier-1265.webp 1265w" sizes="(max-width: 860px) 100vw, 48vw" type="image/webp" />
            <img src="/media/concepts/eamon-mcauley-interiors/eamon-mcauley-fabric-atelier.jpg" alt="Interior designer worktable with Irish linen swatches, herringbone wool, bronze hardware and limestone samples" width="1408" height="768" loading="lazy" />
          </picture>
          <figcaption>Material library &amp; fabric sampling. Indicative studio visualisation.</figcaption>
        </figure>
        <div>
          <p class="em-kicker">The Showroom · 28 High Street</p>
          <h2 id="em-at-title">Fabric, stone, lighting and homeware you can hold in daylight.</h2>
          <p>
            Screens flatten weave and undertone. Visit our Ballynahinch showroom to compare linens, wools,
            bespoke beds and mattresses, framed artwork, tableware, throws, candles and diffusers side by
            side before committing to a single room or full build.
          </p>
          <div class="em-contact-box">
            <div>
              <span>Direct Mobile</span>
              <a href={mobileHref}>{mobile}</a>
            </div>
            <div>
              <span>Studio Line</span>
              <a href={landlineHref}>{landline}</a>
            </div>
            <div>
              <span>Online Catalogue</span>
              <a href={siteHref} target="_blank" rel="noopener noreferrer">eamonmcauleyinteriordesign.com ↗</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="em-section em-map-band" id="location" aria-label="Ballynahinch showroom map">
      <div class="em-wrap">
        <LocalAreaMap
          id="em-map"
          kicker="28 High Street · Ballynahinch"
          businessName="Eamon McAuley Interior Design"
          address="28 High Street, Ballynahinch, BT24 8AB"
          lon={-5.8970602}
          lat={54.4010942}
          spanKm={20}
          mapHref={mapsHref}
          markers={[
            { name: "Saintfield", lon: -5.8338, lat: 54.4581, note: "9 mins north", side: "t" },
            { name: "Crossgar", lon: -5.7644, lat: 54.4021, note: "11 mins east", side: "r" },
            { name: "Castlewellan", lon: -5.9442, lat: 54.2596, note: "16 mins south", side: "b" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="em-footer">
    <div class="em-wrap em-footer-inner">
      <div>
        <strong>Eamon McAuley Interior Design</strong>
        <p>28 High Street, Ballynahinch, Co. Down, BT24 8AB</p>
      </div>
      <div class="em-footer-links">
        <a href={mobileHref}>{mobile}</a>
        <a href={landlineHref}>{landline}</a>
        <a href={mapsHref} target="_blank" rel="noopener noreferrer">Showroom Directions ↗</a>
      </div>
    </div>
  </footer>
</ConceptLayout>
