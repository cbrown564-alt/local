---
import ConceptLayout from "../../_shell/ConceptLayout.astro";
import "@fontsource-variable/manrope";
import "@fontsource/yeseva-one/400.css";
import "../styles.css";
import { paintedEarthBase, paintedEarthLive } from "../content";

interface Props {
  title: string;
  current?: "home" | "originals" | "gallery";
}

const { title, current = "home" } = Astro.props;
---

<ConceptLayout
  title={title}
  slug="painted-earth"
  bodyClass="concept-page concept-painted-earth"
  fontHref=""
  businessName="Painted Earth"
  town="Newcastle"
  bannerNote="Some catalogue imagery is AI-generated."
>
  <div class="pe-utility">
    <span>98 Main Street, Newcastle</span>
    <span>Mon–Sat 10–5 · Sun 1–5</span>
  </div>
  <header class="pe-header">
    <a class="pe-brand" href={`${paintedEarthBase}/`} aria-label="Painted Earth home">
      <span class="pe-seal" aria-hidden="true"><span>PE</span></span>
      <span class="pe-wordmark">Painted <em>Earth</em></span>
    </a>
    <nav aria-label="Main navigation">
      <a class:list={[current === "home" && "pe-nav-active"]} href={`${paintedEarthBase}/`}>Shop</a>
      <a class:list={[current === "originals" && "pe-nav-active"]} href={`${paintedEarthBase}/originals/`}>Original art</a>
      <a href={`${paintedEarthLive}/pages/art-craft-gallery`}>Upstairs gallery</a>
    </nav>
    <a class="pe-live-link" href={paintedEarthLive}>Shop online ↗</a>
  </header>
  <slot />
  <footer class="pe-footer">
    <div>
      <p class="pe-footer-brand">Painted Earth</p>
      <p>Independent Irish craft, art and gifts in the heart of Newcastle.</p>
    </div>
    <div>
      <p>98 Main Street, Newcastle BT33 0AE</p>
      <p><a href="tel:+442843722510">028 4372 2510</a> · <a href="mailto:hello@paintedearthgifts.com">hello@paintedearthgifts.com</a></p>
    </div>
    <p class="pe-footer-note">Artwork shown here is not the makers' own work.</p>
  </footer>
</ConceptLayout>
