---
import PaintedEarthArt from "../components/PaintedEarthArt.astro";
import PaintedEarthShell from "../components/PaintedEarthShell.astro";
import { paintedEarthBase, paintedEarthLive } from "../content";
---

<PaintedEarthShell title="Rossglass To Mournes — Painted Earth" current="originals">
  <main class="pe-product">
    <nav class="pe-breadcrumb" aria-label="Breadcrumb">
      <a href={`${paintedEarthBase}/originals/`}>Original art</a><span aria-hidden="true">/</span><span>Rossglass To Mournes</span>
    </nav>
    <section class="pe-product-layout">
      <PaintedEarthArt theme="mountain" label="Illustrative placeholder — not Gary Murray's artwork" />
      <div class="pe-product-copy">
        <p class="pe-intro">Available original · Gary Murray</p>
        <h1>Rossglass To Mournes</h1>
        <p class="pe-product-price">£700</p>
        <p>
          See the current photograph on our
          <a href={`${paintedEarthLive}/products/rossglass-to-mournes`}>product page</a>.
        </p>
        <section class="pe-choice" aria-labelledby="pe-choice-heading">
          <h2 id="pe-choice-heading">How would you receive it?</h2>
          <div class="pe-choice-row">
            <div>
              <strong>Collect in Newcastle</strong>
              <span>Original artwork is collection-only from 98 Main Street.</span>
            </div>
            <a href={`${paintedEarthLive}/products/rossglass-to-mournes`}>Shop this piece ↗</a>
          </div>
          <div class="pe-choice-row">
            <div>
              <strong>Ask about shipping</strong>
              <span>Painted Earth can arrange a quote. Shipping is not promised until they confirm it.</span>
            </div>
            <a href={`${paintedEarthLive}/pages/contact-us`}>Request a shipping quote ↗</a>
          </div>
        </section>
        <p class="pe-product-warning">Original art cannot be returned. Current terms and availability remain owned by Painted Earth.</p>
      </div>
    </section>
  </main>
</PaintedEarthShell>
