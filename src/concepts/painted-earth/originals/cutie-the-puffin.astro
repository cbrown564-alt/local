---
import PaintedEarthArt from "../components/PaintedEarthArt.astro";
import PaintedEarthShell from "../components/PaintedEarthShell.astro";
import { paintedEarthBase, paintedEarthLive } from "../content";
---

<PaintedEarthShell title="Cutie The Puffin — Painted Earth" current="originals">
  <main class="pe-product pe-product--sold">
    <nav class="pe-breadcrumb" aria-label="Breadcrumb">
      <a href={`${paintedEarthBase}/originals/`}>Original art</a><span aria-hidden="true">/</span><span>Cutie The Puffin</span>
    </nav>
    <section class="pe-product-layout">
      <PaintedEarthArt theme="puffin" label="Illustrative placeholder — not Gary Murray's artwork" />
      <div class="pe-product-copy">
        <p class="pe-intro">Sold original · Gary Murray</p>
        <h1>That piece has gone. The route does not end here.</h1>
        <p>
          Cutie The Puffin is unavailable. Continue with available work by the
          same artist, visit the upstairs gallery, or ask the shop what has
          arrived recently.
        </p>
        <div class="pe-recovery-actions">
          <a class="pe-primary" href={`${paintedEarthBase}/originals/?place=Sea`}>See available coastal work</a>
          <a class="pe-secondary" href={`${paintedEarthLive}/collections/original-art-work`}>Browse original art ↗</a>
          <a class="pe-text-link" href={`${paintedEarthLive}/pages/contact-us`}>Ask Painted Earth about new work ↗</a>
        </div>
        <div class="pe-recovery-preview">
          <PaintedEarthArt theme="tide" compact />
          <div>
            <strong>Tide · Gary Murray · £575</strong>
            <span>Check current availability.</span>
          </div>
        </div>
      </div>
    </section>
  </main>
</PaintedEarthShell>
