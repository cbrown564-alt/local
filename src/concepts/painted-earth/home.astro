---
import PaintedEarthArt from "./components/PaintedEarthArt.astro";
import PaintedEarthShell from "./components/PaintedEarthShell.astro";
import {
  paintedEarthBase,
  paintedEarthCatalogueDate,
  paintedEarthGalleryWords,
  paintedEarthHandoverTerms,
  paintedEarthLive,
  paintedEarthMakerHref,
  paintedEarthMakers,
  paintedEarthMakerTotal,
  paintedEarthPlaces,
  paintedEarthVisitorVoice,
  paintedEarthWaitingListWords,
  paintedEarthWorkshops,
  paintedEarthWorkshopsHref,
} from "./content";

const routes = [
  {
    title: "Original art",
    note: "Available work, collection terms and shipping quotes before checkout.",
    href: `${paintedEarthBase}/originals/`,
    theme: "evening",
  },
  {
    title: "Gifts under £30",
    note: "Cards, prints, books and small pieces from Irish makers.",
    href: `${paintedEarthLive}/collections/gifts-under-30`,
    theme: "bloom",
  },
  {
    title: "Birthday gifts & cards",
    note: "Start with the occasion, then choose the piece or price.",
    href: `${paintedEarthLive}/collections/birthday-cards`,
    theme: "robin",
  },
  {
    title: "Jewellery",
    note: "Browse by type or by the artist whose work you already know.",
    href: `${paintedEarthLive}/collections/irish-craft-jewellery`,
    theme: "tide",
  },
  {
    title: "Home & body",
    note: "Ceramics, textiles, fragrance and everyday craft.",
    href: `${paintedEarthLive}/collections/home-body`,
    theme: "dunes",
  },
];
---

<PaintedEarthShell title="Painted Earth" current="home">
  <main>
    <section class="pe-arrival">
      <div class="pe-arrival-copy">
        <p class="pe-intro">A small team with a big dream</p>
        <h1>What are you looking for?</h1>
        <p>
          Start with the piece, the occasion or the price. If a place matters
          more, take the local route just below.
        </p>
        <form class="pe-search" action={`${paintedEarthLive}/search`} method="get">
          <label for="pe-home-search">Search the shop</label>
          <div>
            <input id="pe-home-search" name="q" type="search" placeholder="A maker, a gift, a place…" />
            <button type="submit">Search the shop</button>
          </div>
        </form>
        <a class="pe-text-link" href={`${paintedEarthLive}/collections/all`}>Browse the full catalogue ↗</a>
      </div>
      <div class="pe-arrival-art" aria-label="Upstairs gallery">
        <PaintedEarthArt theme="mountain" label="Original art in the upstairs gallery" />
        <div class="pe-arrival-note">
          <span>Upstairs gallery</span>
          <strong>Original work, with the practical details up front.</strong>
        </div>
      </div>
    </section>

    <section class="pe-shop-routes" aria-labelledby="pe-routes-heading">
      <div class="pe-section-head">
        <h2 id="pe-routes-heading">Shop by what you need</h2>
        <p>Cards, prints, jewellery and original art — choose the route that fits.</p>
      </div>
      <ul class="pe-route-list" role="list">
        {routes.map((route) => (
          <li>
            <a href={route.href}>
              <PaintedEarthArt theme={route.theme} compact />
              <span class="pe-route-copy">
                <strong>{route.title}</strong>
                <span>{route.note}</span>
              </span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="pe-makers" aria-labelledby="pe-makers-heading">
      <div class="pe-section-head">
        <div>
          <p class="pe-intro">The makers' roll</p>
          <h2 id="pe-makers-heading">Ninety-two makers under one roof.</h2>
        </div>
        <p>
          Everything on our shelves is made by someone we can name — these are
          the names the catalogue knows best, as of {paintedEarthCatalogueDate}.
          Every name opens that maker's collection on our own shop.
        </p>
      </div>
      <div class="pe-makers-layout">
        <ul class="pe-makers-roll" role="list">
          {paintedEarthMakers.map((maker) => (
            <li>
              <a href={paintedEarthMakerHref(maker.name)}>
                <strong>{maker.name}</strong>
                {maker.pieces !== null && <span>{maker.pieces} pieces</span>}
              </a>
            </li>
          ))}
          <li class="pe-makers-rest">
            <span>…plus the rest of the {paintedEarthMakerTotal} — every maker on our shelves has a name.</span>
          </li>
        </ul>
        <div class="pe-makers-voice">
          <p class="pe-makers-own">{paintedEarthGalleryWords}</p>
          <blockquote class="pe-makers-review">
            <p>&ldquo;{paintedEarthVisitorVoice.quote}&rdquo;</p>
            <footer>{paintedEarthVisitorVoice.who} · {paintedEarthVisitorVoice.source}</footer>
          </blockquote>
        </div>
      </div>
    </section>

    <section class="pe-place-route" aria-labelledby="pe-place-heading">
      <div class="pe-place-copy">
        <p class="pe-intro">A second way in</p>
        <h2 id="pe-place-heading">Take a piece of this place with you.</h2>
        <p>
          Useful for visitors and gift buyers, optional for everyone else.
          Choosing a place applies a removable filter to the original-art shelf.
        </p>
      </div>
      <ul class="pe-place-list" role="list">
        {paintedEarthPlaces.map((place) => (
          <li>
            <a href={`${paintedEarthBase}/originals/?place=${encodeURIComponent(place.name)}`}>
              <PaintedEarthArt theme={place.theme} compact label={`Art inspired by ${place.name}`} />
              <strong>{place.name}</strong>
              <span>{place.count} pieces inspired by {place.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="pe-handover" aria-labelledby="pe-handover-heading">
      <div class="pe-handover-copy">
        <p class="pe-intro">The handover</p>
        <h2 id="pe-handover-heading">An original is not posted. It is collected.</h2>
        <p>
          The most precious thing we sell changes hands in person — up the
          stairs at 98 Main Street, in the lightfilled gallery we opened in
          April 2025. You meet the work, and the people who chose it, before
          it is yours.
        </p>
        <a class="pe-primary" href={`${paintedEarthBase}/originals/`}>Explore available original art</a>
      </div>
      <ul class="pe-handover-terms" role="list" aria-label="How an original reaches you">
        {paintedEarthHandoverTerms.map((term) => (
          <li>{term}</li>
        ))}
      </ul>
    </section>

    <section class="pe-workshops" aria-labelledby="pe-workshops-heading">
      <div class="pe-section-head">
        <div>
          <p class="pe-intro">Workshops</p>
          <h2 id="pe-workshops-heading">Four workshops, and every one of them full.</h2>
        </div>
        <p>
          Places go quickly, and the waiting list runs by hand — as the
          sold-out listings say: &ldquo;{paintedEarthWaitingListWords}&rdquo;
        </p>
      </div>
      <ul class="pe-workshop-list" role="list">
        {paintedEarthWorkshops.map((workshop) => (
          <li>
            <span class="pe-workshop-date">{workshop.date}</span>
            <strong>{workshop.title} with {workshop.tutor}</strong>
            <span class="pe-workshop-price">£{workshop.price}</span>
            <span class="pe-workshop-status">Fully booked</span>
          </li>
        ))}
      </ul>
      <div class="pe-workshop-next">
        <p>
          <strong>Proposal:</strong> a waiting list you can join from this
          page, instead of a note inside a sold-out listing. Until then,
          <a href={paintedEarthWorkshopsHref}>our workshops live on the shop ↗</a>
        </p>
      </div>
    </section>
  </main>
</PaintedEarthShell>
