---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import McTrailsMap from "./components/McTrailsMap.astro";
import {
  rangeCategories,
  shopVoice,
  standToday,
} from "./content";
---

<ConceptLayout title={"Mourne Cycles — independent concept"} slug="mourne-cycles" bodyClass="concept-page concept-mourne-cycles" lang="en-GB">
<div class="mc-strip">
      <span>Est. 2002 · listed Trek dealer &amp; Cyclescheme retailer</span>
      <span>63A Castlewellan Road, Newcastle · <a href="tel:+442843727272">028 4372 7272</a></span>
    </div>
    <header class="mc-header">
      <a class="mc-brand" href="/concepts/mourne-cycles/">
        <svg class="mc-peaks" width="44" height="26" viewBox="0 0 44 26" fill="none" aria-hidden="true">
          <path d="M1 25 L13 6 L19 14 L27 1 L43 25" stroke="#0f1013" stroke-width="2.4" stroke-linejoin="round" />
          <path d="M23.5 6.5 L27 1 L30.5 6.5" stroke="#d7282f" stroke-width="2.4" stroke-linejoin="round" />
        </svg>
        <span class="mc-brand-text">
          <span class="mc-brand-name">Mourne<span>&nbsp;Cycles</span></span>
          <span class="mc-brand-sub">Newcastle · County Down</span>
        </span>
      </a>
      <nav class="mc-nav" aria-label="Concept navigation">
        <a href="/concepts/mourne-cycles/" aria-current="page">Bikes</a>
        <a href="#" data-concept-placeholder>Accessories</a>
        <a href="/concepts/mourne-cycles/hire/">Workshop</a>
        <a href="/concepts/mourne-cycles/hire/#panel-scheme-h">Cycle to Work</a>
        <a href="#trails">Trails</a>
      </nav>
      <div class="mc-header-actions">
        <a class="mc-phone" href="tel:+442843727272">028 4372 7272</a>
        <a class="mc-book" href="/concepts/mourne-cycles/hire/">Book a service</a>
      </div>
    </header>
    <main class="mc-hero">
      <section class="mc-story">
        <p class="mc-kicker">Newcastle · local since 2002</p>
        <h1>Mourne <em>Cycles</em></h1>
        <figure class="mc-voice">
          <blockquote cite={shopVoice.source}>
            “{shopVoice.text}”
          </blockquote>
          <figcaption>
            {shopVoice.attribution}
            <span>{shopVoice.context}</span>
          </figcaption>
        </figure>
        <p class="mc-lede">
          The shop calls itself the main dealer in Trek bikes in the area —
          listed as a <strong>Trek</strong> dealer and Cyclescheme retailer, with a
          workshop on Castlewellan Road — the road out toward the Mournes' trail country.
        </p>
        <div class="mc-actions">
          <a class="mc-cta" href="/concepts/mourne-cycles/hire/">Book a workshop slot</a>
          <a class="mc-link" href="#trails">Where each bike goes →</a>
        </div>
      </section>
      <section class="mc-workshop-desk" aria-labelledby="mc-workshop-heading">
        <div class="mc-workshop-head">
          <span class="mc-workshop-status"><span aria-hidden="true"></span> Workshop enquiries open</span>
          <span class="mc-workshop-code" aria-hidden="true">MC · 2002</span>
        </div>
        <div class="mc-workshop-body">
          <p class="mc-workshop-label">Workshop desk</p>
          <h2 id="mc-workshop-heading">Get your bike checked.</h2>
          <div class="mc-stand" aria-labelledby="mc-stand-heading">
            <div class="mc-stand-head">
              <h3 id="mc-stand-heading">On the stand today</h3>
              <span class="mc-stand-tag">On the stand</span>
            </div>
            <ol class="mc-stand-jobs" role="list">
              {standToday.map((item) => (
                <li>
                  <span class="mc-stand-ticket" aria-hidden="true">{item.ticket}</span>
                  <span>{item.job}</span>
                </li>
              ))}
            </ol>
          </div>
          <ol class="mc-workshop-steps">
            <li>
              <span class="mc-workshop-num">01</span>
              <span><strong>Tell us what the bike needs</strong><small>A repair, a tune-up, or advice before you ride.</small></span>
            </li>
            <li>
              <span class="mc-workshop-num">02</span>
              <span><strong>The shop confirms the job</strong><small>Scope, price and turnaround come directly from Mourne Cycles.</small></span>
            </li>
            <li>
              <span class="mc-workshop-num">03</span>
              <span><strong>Bring the bike to Newcastle</strong><small>63A Castlewellan Road · call 028 4372 7272.</small></span>
            </li>
          </ol>
        </div>
        <div class="mc-workshop-actions">
          <a href="/concepts/mourne-cycles/hire/#panel-service-h">Start a workshop enquiry <span aria-hidden="true">→</span></a>
          <a href="tel:+442843727272">Call the shop</a>
        </div>
        <p class="mc-workshop-note">Call for price, scope and availability.</p>
      </section>
      <nav class="mc-rail" aria-label="Bike range by terrain">
        {rangeCategories.map((category) => (
          <a class="mc-cell" href="#trails">
            <span class="mc-cell-index">{category.index}</span>
            <span class="mc-cell-name">{category.name}</span>
            <small class="mc-cell-terrain">{category.terrain}</small>
          </a>
        ))}
        <a class="mc-cell mc-cell-scheme" href="/concepts/mourne-cycles/hire/#panel-scheme-h">
          <span class="mc-cell-index">Cycle to Work</span>
          <span class="mc-cell-name">Save through work</span>
          <small>Listed Cyclescheme retailer</small>
        </a>
      </nav>
    </main>

    <section class="mc-trails" id="trails" aria-labelledby="mc-trails-heading">
      <div class="mc-trails-head">
        <p class="mc-kicker">Our local trails</p>
        <h2 class="mc-section-h2" id="mc-trails-heading">The shop at the trailhead.</h2>
        <p class="mc-section-lede">
          63A Castlewellan Road is the road out of Newcastle toward Castlewellan — the
          gateway to the riding country Mourne Cycles names on its own site. Buy a bike
          here, ride the trails, and bring it back to the workshop when it needs looking after.
        </p>
      </div>
      <McTrailsMap headingId="mc-trails-heading" />
    </section>
</ConceptLayout>
