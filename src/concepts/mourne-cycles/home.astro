---
import fs from "node:fs";
import path from "node:path";
import McShell from "./components/McShell.astro";
import McKinetic from "./components/McKinetic.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";
import {
  bikeTypes,
  contact,
  shopVoice,
  standToday,
} from "./content";

const inPublic = (asset: string) =>
  fs.existsSync(path.join(process.cwd(), "public", asset.replace(/^\//, "")));

const heroImage = "/media/concepts/mourne-cycles/mourne-cycles-hero.jpg";
const hasHeroImage = inPublic(heroImage);

const bikePanels = bikeTypes.map((bike) => ({
  ...bike,
  hasImage: inPublic(bike.image),
}));
---

<McShell
  title={"Mourne Cycles — bikes, workshop & hire in Newcastle"}
  current="home"
  bannerNote="Workshop stand tickets are illustrative. Bike imagery is AI-generated and is not showroom photography."
>
    <main>
    <section class="mc-hero" aria-labelledby="mc-hero-heading">
      <figure class="mc-hero-visual">
        {hasHeroImage ? (
          <ResponsiveImage
            src={heroImage}
            alt="Mountain bike on a Castlewellan Forest trail with the Mournes ahead"
            width="1024"
            height="682"
            loading="eager"
          />
        ) : (
          <svg class="mc-hero-fallback" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <rect width="1440" height="900" fill="#17181c" />
            <path class="mc-hero-ridge" d="M-40 620 C120 480 220 420 340 380 C420 470 500 500 580 450 C700 360 820 300 960 280 C1080 400 1180 460 1480 520 L1480 900 L-40 900 Z" />
            <path class="mc-hero-ridge-far" d="M200 560 C360 470 480 430 620 420 C760 500 880 520 1020 470 C1140 430 1260 450 1480 510 L1480 900 L200 900 Z" />
            <path class="mc-hero-summit" d="M920 300 L960 220 L1000 300" />
            <path class="mc-hero-road" d="M-20 780 C280 720 520 640 760 560 S1180 420 1480 380" />
            <rect class="mc-hero-shop" x="180" y="700" width="72" height="36" rx="3" />
          </svg>
        )}
        <figcaption class="visually-hidden">
          Trail country above Newcastle — where we send riders from Castlewellan Road.
        </figcaption>
      </figure>
      <div class="mc-hero-copy">
        <p class="mc-kicker">Newcastle · local since 2002</p>
        <McKinetic
          as="h1"
          id="mc-hero-heading"
          effect="ride"
          parts={[{ text: "Mourne " }, { text: "Cycles", accent: true }]}
        />
        <p class="mc-lede">
          Trek dealer and workshop on Castlewellan Road — the road out toward trail country.
        </p>
        <div class="mc-actions">
          <a class="mc-cta" href="/concepts/mourne-cycles/workshop/">Book a workshop slot</a>
          <a class="mc-link" href="/concepts/mourne-cycles/bikes/">Find your kind of ride →</a>
        </div>
      </div>
    </section>

    <nav class="mc-rail" aria-label="Bike range by terrain">
      {bikePanels.map((bike) => (
        <a class="mc-cell" href={`/concepts/mourne-cycles/bikes/#${bike.id}`}>
          <span class="mc-cell-index">{bike.index}</span>
          <span class="mc-cell-name">{bike.name}</span>
          <small class="mc-cell-terrain">{bike.terrain}</small>
        </a>
      ))}
      <a class="mc-cell mc-cell-scheme" href="/concepts/mourne-cycles/cycle-to-work/">
        <span class="mc-cell-index">Cycle to Work</span>
        <span class="mc-cell-name">Save through work</span>
        <small>Listed Cyclescheme retailer</small>
      </a>
    </nav>

    <section class="mc-bikes" id="bikes" aria-labelledby="mc-bikes-heading">
      <div class="mc-bikes-head">
        <p class="mc-kicker">What we fit you for</p>
        <McKinetic
          as="h2"
          id="mc-bikes-heading"
          class="mc-section-h2"
          effect="lean"
          parts={[{ text: "Three kinds of riding from this road." }]}
        />
        <p class="mc-section-lede">
          Start with where you want to ride. Call us and we will match a bike
          from what is on the floor.
        </p>
      </div>
      <div class="mc-bike-grid">
        {bikePanels.map((bike) => (
          <article class="mc-bike-panel" aria-labelledby={`home-${bike.id}-heading`}>
            <div class="mc-bike-visual" data-has-image={bike.hasImage ? "" : undefined}>
              {bike.hasImage ? (
                <ResponsiveImage
                  src={bike.image}
                  alt={bike.imageAlt}
                  width={800}
                  height={600}
                  sizes="(max-width: 720px) 100vw, 400px"
                />
              ) : (
                <div class="mc-bike-visual-empty" aria-hidden="true">
                  <span>{bike.name}</span>
                </div>
              )}
            </div>
            <div class="mc-bike-copy">
              <p class="mc-bike-index">{bike.index}</p>
              <h3 id={`home-${bike.id}-heading`}>{bike.name}</h3>
              <p class="mc-bike-terrain">{bike.terrain}</p>
              <p class="mc-bike-for">{bike.forWhom}</p>
              <div class="mc-bike-actions">
                <a class="mc-bike-cta" href={`/concepts/mourne-cycles/bikes/#${bike.id}`}>More on {bike.name}</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mc-workshop" aria-labelledby="mc-workshop-heading">
      <div class="mc-workshop-desk">
        <div class="mc-workshop-head">
          <span class="mc-workshop-status"><span aria-hidden="true"></span> Workshop enquiries open</span>
          <span class="mc-workshop-code" aria-hidden="true">MC · 2002</span>
        </div>
        <div class="mc-workshop-body">
          <p class="mc-workshop-label">Workshop desk</p>
          <h2 id="mc-workshop-heading">Get your bike checked.</h2>
          <p class="mc-voice">{shopVoice.text}</p>
          <ol class="mc-workshop-steps">
            <li>
              <span class="mc-workshop-num">01</span>
              <span><strong>Tell us what the bike needs</strong><small>A repair, a tune-up, or advice before you ride.</small></span>
            </li>
            <li>
              <span class="mc-workshop-num">02</span>
              <span><strong>We confirm the job</strong><small>Scope, price and turnaround come straight from us.</small></span>
            </li>
            <li>
              <span class="mc-workshop-num">03</span>
              <span><strong>Bring the bike to Newcastle</strong><small>{contact.address} · call {contact.phone}.</small></span>
            </li>
          </ol>
        </div>
        <div class="mc-stand" aria-labelledby="mc-stand-heading">
          <div class="mc-stand-head">
            <h3 id="mc-stand-heading">On the stand today</h3>
          </div>
          <ol class="mc-stand-jobs" role="list">
            {standToday.map((item) => (
              <li>
                <span class="mc-stand-ticket" aria-hidden="true">{item.ticket}</span>
                <span>{item.job}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="mc-workshop-actions">
          <a href="/concepts/mourne-cycles/workshop/#mc-booking">Start a workshop enquiry <span aria-hidden="true">→</span></a>
          <a href={contact.phoneHref}>Call us</a>
        </div>
        <p class="mc-workshop-note">Call for price, scope and availability.</p>
      </div>
    </section>

    <section class="mc-trails-teaser" aria-labelledby="mc-trails-teaser-heading">
      <div class="mc-trails-teaser-copy">
        <p class="mc-kicker">Our local trails</p>
        <McKinetic
          as="h2"
          id="mc-trails-teaser-heading"
          class="mc-section-h2"
          effect="lean"
          parts={[{ text: "Trailhead on Castlewellan Road." }]}
        />
        <p class="mc-section-lede">
          63A is the road out of Newcastle toward Castlewellan — the gateway to the
          riding country around the Mournes. Buy a bike here, ride the trails, and
          bring it back to the workshop when it needs looking after.
        </p>
        <div class="mc-actions">
          <a class="mc-cta" href="/concepts/mourne-cycles/trails/">See the riding country →</a>
        </div>
      </div>
    </section>
    </main>
</McShell>
