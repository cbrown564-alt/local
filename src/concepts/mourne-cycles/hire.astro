---
import McShell from "./components/McShell.astro";
import McKinetic from "./components/McKinetic.astro";
import { contact, hireTiers } from "./content";
---

<McShell
  title={"Hire a bike — Mourne Cycles, Newcastle"}
  current="hire"
  bannerNote="Hire prices are indicative — the shop confirms availability, equipment and opening hours by phone."
>
    <main>
    <div class="mc-page-intro mc-page-intro-dark">
      <div class="mc-page-intro-copy">
        <p class="mc-page-kicker">Hire</p>
        <McKinetic
          as="h1"
          effect="ride"
          parts={[{ text: "Two wheels " }, { text: "for the day.", accent: true }]}
        />
      </div>
      <p class="mc-page-sub">
        Take a bike out toward the forest or along the coast road. Call{" "}
        {contact.phone} to confirm what is available before you set off.
      </p>
    </div>

    <section class="mc-hire-section" aria-labelledby="mc-hire-heading">
      <div class="mc-hire-panel">
        <div class="mc-hire-panel-inner">
          <p class="mc-workshop-label">Day hire</p>
          <h2 id="mc-hire-heading">Pick your bike.</h2>
          <p class="mc-provisional mc-provisional-dark">
            Prices indicative — call to confirm.
          </p>
          <ul class="mc-tier-list" aria-label="Hire options and prices">
            {hireTiers.map((tier) => (
              <li>
                <span class="mc-tier-name">{tier.name}</span>
                <span class="mc-tier-bar" aria-hidden="true"><span style={`width:${tier.bar}%`}></span></span>
                <span class="mc-tier-price">{tier.price}</span>
              </li>
            ))}
          </ul>
          <div class="mc-hire-actions">
            <a class="mc-cta" href={contact.phoneHref}>Call to book · {contact.phone}</a>
            <small>Confirm availability, equipment and opening hours by phone</small>
          </div>
        </div>
      </div>

      <div class="mc-hire-notes">
        <h3>Before you set off</h3>
        <ul>
          <li><strong>Bring ID and a contact number</strong><span>We will sort fit and saddle height before you leave.</span></li>
          <li><strong>Tell us where you are headed</strong><span>Castlewellan reds, Tollymore or the coast road — we will point you at the right route for the day.</span></li>
          <li><strong>Back before closing</strong><span>Confirm opening hours when you book — they change with the season.</span></li>
        </ul>
      </div>
    </section>
    </main>
</McShell>
