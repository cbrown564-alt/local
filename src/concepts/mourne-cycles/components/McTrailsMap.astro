---
import GeneratedMapPlate from "../../_shell/GeneratedMapPlate.astro";
import { trailPins } from "../content";

interface Props { headingId?: string; }
const { headingId } = Astro.props;

const places = trailPins;
---

<GeneratedMapPlate
  id="mc-map"
  src="/media/maps/mourne-cycles-trails-generated.png"
  width={1448}
  height={1086}
  title="Local trails around Mourne Cycles"
  desc="An indicative illustrated relationship between Mourne Cycles on Castlewellan Road, Castlewellan Forest, Tollymore Forest, Slieve Donard and the coast road."
  headingId={headingId}
>
  <span class="mm-generated-map-label" style="--map-x:70%;--map-y:84%">Mourne Cycles</span>
  <Fragment slot="caption">
    Public riding country the shop points people toward from Castlewellan Road. Routes and positions are illustrative, not navigational.
  </Fragment>
  <ul slot="key">
    {places.map((place) => <li><strong>{place.label}</strong><span>{place.note}</span></li>)}
  </ul>
</GeneratedMapPlate>
