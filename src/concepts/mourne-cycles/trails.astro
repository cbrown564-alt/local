---
import McShell from "./components/McShell.astro";
import McTrailsMap from "./components/McTrailsMap.astro";
import { contact } from "./content";
---

<McShell
  title={"Local trails — Mourne Cycles, Newcastle"}
  current="trails"
  bannerNote="Trail positions and profiles are illustrative, not navigational."
>
    <main>
    <div class="mc-page-intro">
      <div class="mc-page-intro-copy">
        <p class="mc-page-kicker">Our local trails</p>
        <h1>Trail country<br /><em>out the door.</em></h1>
      </div>
      <p class="mc-page-sub">
        63A Castlewellan Road is the road out of Newcastle toward the riding
        country around the Mournes. These are the places we point people
        toward — call {contact.phone} and we will talk through the right ride
        for your day.
      </p>
    </div>

    <section class="mc-trails" aria-labelledby="mc-trails-map-heading">
      <div class="mc-trails-head">
        <p class="mc-kicker">The map</p>
        <h2 class="mc-section-h2" id="mc-trails-map-heading">Where we send riders.</h2>
        <p class="mc-section-lede">
          The shop at the trailhead, Castlewellan Forest, Tollymore, Slieve
          Donard and the coast road — the riding country on our doorstep.
        </p>
      </div>
      <McTrailsMap headingId="mc-trails-map-heading" />
    </section>

    <section class="mc-trails-cta" aria-label="Plan a ride">
      <p class="mc-trails-cta-line">
        Tell us the ride you're after — <a href={contact.phoneHref}>call {contact.phone}</a> and
        we'll match a bike and a route to it.
      </p>
    </section>
    </main>
</McShell>
