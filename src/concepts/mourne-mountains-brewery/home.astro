---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import MmbBeerLedger from "./MmbBeerLedger.astro";
import "./styles.css";

/* Mourne Mountains Brewery — Milltown East Industrial Estate, Upper Dromore Rd, Warrenpoint BT34 3PN.
   Verified live 26 Nov 2026: mournemountainsbrewery.com (Wix with raw --> leak & tab-nav clutter),
   028 4176 7391, info@mournemountainsbrewery.com, Saturday Beer Hall 16:00–23:00, live /shop & /taproom. */
const phone = "028 4176 7391";
const phoneHref = "tel:+442841767391";
const email = "info@mournemountainsbrewery.com";
const shopHref = "https://www.mournemountainsbrewery.com/shop";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Mourne+Mountains+Brewery+Upper+Dromore+Road+Warrenpoint+BT34+3PN";
---

<ConceptLayout
  title="Mourne Mountains Brewery and Taproom, Warrenpoint"
  slug="mourne-mountains-brewery"
  bodyClass="concept-page concept-mmb"
  businessName="Mourne Mountains Brewery"
  town="Warrenpoint"
  bannerNote="Imagery comprises indicative taproom flight and brewhouse visualisations."
>
  <header class="mmb-header" data-mmb-header>
    <div class="mmb-header-inner">
      <a class="mmb-brand" href="#top">Mourne Mountains Brewery</a>
      <nav class="mmb-nav" aria-label="Primary">
        <a href="#brewhouse" data-mmb-jump="core">Core range</a>
        <a href="#brewhouse" data-mmb-jump="hall">Beer hall</a>
        <a href="#trade">Trade and events</a>
        <a href="#location">Find us</a>
      </nav>
      <div class="mmb-header-actions">
        <a class="mmb-header-tel" href={phoneHref}>{phone}</a>
        <a class="mmb-header-cta" href={shopHref} target="_blank" rel="noopener noreferrer">Web shop</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="mmb-hero" aria-labelledby="mmb-hero-title">
      <div class="mmb-hero-sentinel" data-mmb-sentinel aria-hidden="true"></div>
      <div class="mmb-hero-media">
        <picture>
          <source
            srcset="/media/concepts/mourne-mountains-brewery/mmb-taproom-pours-640.webp 640w, /media/concepts/mourne-mountains-brewery/mmb-taproom-pours-1265.webp 1265w"
            sizes="100vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/mourne-mountains-brewery/mmb-taproom-pours.jpg"
            alt="Tasting flight of four craft beers glowing on a reclaimed oak taproom counter under warm amber lights"
            width="1408"
            height="768"
            loading="eager"
          />
        </picture>
      </div>

      <div class="mmb-wrap mmb-hero-inner">
        <div class="mmb-hero-copy">
          <h1 id="mmb-hero-title">Poured straight from the tanks.</h1>
          <p class="mmb-hero-lead">
            Small-batch IPAs, helles lagers, fruited sours, and red ales brewed with Irish malts and fresh Mourne mountain water.
          </p>
          <a class="mmb-btn mmb-btn--primary" href={shopHref} target="_blank" rel="noopener noreferrer">
            Shop cans and cases
          </a>
        </div>

        <div class="mmb-hero-foot">
          <p class="mmb-hero-caption">Indicative taproom flight visualisation.</p>
        </div>
      </div>
    </section>

    <MmbBeerLedger />

    <section class="mmb-section mmb-trade" id="trade" aria-labelledby="mmb-trade-title">
      <div class="mmb-wrap mmb-split">
        <div class="mmb-trade-intro">
          <h2 id="mmb-trade-title">Stocking a bar, restaurant, or planning a taproom group?</h2>
          <p>
            We supply pubs, bottle shops, and events across Northern Ireland in keg and can. Send your
            enquiry straight to the brewhouse team or ring <a href={phoneHref}>{phone}</a>.
          </p>
          <dl class="mmb-contact-ledger">
            <div class="mmb-contact-row">
              <dt>Telephone</dt>
              <dd><a href={phoneHref}>{phone}</a></dd>
            </div>
            <div class="mmb-contact-row">
              <dt>Email</dt>
              <dd><a href={`mailto:${email}`}>{email}</a></dd>
            </div>
            <div class="mmb-contact-row">
              <dt>Saturday Beer Hall</dt>
              <dd>16:00 to 23:00 at Milltown East</dd>
            </div>
          </dl>
        </div>

        <form class="mmb-form" data-mmb-form>
          <div class="mmb-row">
            <label>
              <span>Your name</span>
              <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
            </label>
            <label>
              <span>Phone or venue</span>
              <input name="phone" type="text" required placeholder="028, 07, or venue name" />
            </label>
          </div>
          <label>
            <span>Enquiry type</span>
            <select name="topic">
              <option value="Trade account (kegs and cans)">Trade account (kegs and cans)</option>
              <option value="Saturday Beer Hall group table">Saturday Beer Hall group table</option>
              <option value="Wedding or private event kegs">Wedding or private event kegs</option>
              <option value="Web shop order query">Web shop order query</option>
            </select>
          </label>
          <label>
            <span>Details</span>
            <textarea name="notes" rows="3" placeholder="Venue location, preferred beers, approximate date, or group size"></textarea>
          </label>
          <button class="mmb-btn mmb-btn--primary" type="submit">Send brewhouse enquiry</button>
        </form>
      </div>
    </section>

    <section class="mmb-section mmb-map-band" id="location" aria-label="Warrenpoint brewery map">
      <div class="mmb-wrap">
        <LocalAreaMap
          id="mmb-map"
          tone="dark"
          kicker=""
          businessName="Mourne Mountains Brew"
          address="Unit 3, Milltown East Industrial Estate, Upper Dromore Rd, Warrenpoint, BT34 3PN"
          lon={-6.2658937}
          lat={54.1195999}
          spanKm={16}
          mapHref={mapsHref}
          markers={[
            { name: "Warrenpoint Front", lon: -6.2538, lat: 54.1014, note: "4 mins south", side: "b" },
            { name: "Newry City", lon: -6.3402, lat: 54.1751, note: "10 mins north-west", side: "l" },
            { name: "Rostrevor", lon: -6.1972, lat: 54.1015, note: "8 mins east", side: "r" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="mmb-footer">
    <div class="mmb-wrap mmb-footer-inner">
      <div>
        <strong>Mourne Mountains Brewery</strong>
        <p>Unit 3, Milltown East Industrial Estate, Upper Dromore Rd, Warrenpoint, BT34 3PN</p>
      </div>
      <div class="mmb-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={shopHref} target="_blank" rel="noopener noreferrer">Online shop</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-mmb-header]");
      const sentinel = document.querySelector("[data-mmb-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            header.classList.toggle("is-scrolled", !entries[0].isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      const tabRoot = document.querySelector("[data-mmb-tabs]");
      if (tabRoot) {
        const tabs = [...tabRoot.querySelectorAll("[data-mmb-tab]")];
        const panels = [...tabRoot.querySelectorAll("[data-mmb-panel]")];
        const activate = (id, focusTab = false) => {
          tabs.forEach((t) => {
            const active = t.getAttribute("data-mmb-tab") === id;
            t.classList.toggle("is-active", active);
            t.setAttribute("aria-selected", active ? "true" : "false");
            t.setAttribute("tabindex", active ? "0" : "-1");
            if (active && focusTab) t.focus();
          });
          panels.forEach((p) => {
            p.hidden = p.getAttribute("data-mmb-panel") !== id;
          });
        };

        tabs.forEach((btn, idx) => {
          btn.addEventListener("click", () => activate(btn.getAttribute("data-mmb-tab")));
          btn.addEventListener("keydown", (e) => {
            if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
              e.preventDefault();
              const next = (idx + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
              activate(tabs[next].getAttribute("data-mmb-tab"), true);
            } else if (e.key === "Home") {
              e.preventDefault();
              activate(tabs[0].getAttribute("data-mmb-tab"), true);
            } else if (e.key === "End") {
              e.preventDefault();
              activate(tabs[tabs.length - 1].getAttribute("data-mmb-tab"), true);
            }
          });
        });

        document.querySelectorAll("[data-mmb-jump]").forEach((link) => {
          link.addEventListener("click", () => {
            const targetId = link.getAttribute("data-mmb-jump");
            if (targetId) activate(targetId);
          });
        });
      }

      const form = document.querySelector("[data-mmb-form]");
      if (form) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;
          const fd = new FormData(form);
          const subject = `Brewery enquiry: ${fd.get("topic")}`;
          const body = [
            `Name: ${fd.get("name")}`,
            `Phone or venue: ${fd.get("phone")}`,
            `Topic: ${fd.get("topic")}`,
            `Details: ${fd.get("notes") || "None"}`,
          ].join("\n");
          const ev = new CustomEvent("mm:enquiry", {
            cancelable: true,
            detail: {
              to: "info@mournemountainsbrewery.com",
              subject,
              body,
              phone: "028 4176 7391",
              phoneHref: "tel:+442841767391",
            },
          });
          if (window.dispatchEvent(ev)) {
            window.location.href = `mailto:info@mournemountainsbrewery.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
          }
        });
      }
    })();
  </script>
</ConceptLayout>
