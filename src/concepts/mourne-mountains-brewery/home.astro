---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import MmbBeerLedger from "./MmbBeerLedger.astro";
import "./styles.css";

/* Mourne Mountains Brewery — Milltown East Industrial Estate, Upper Dromore Rd, Warrenpoint BT34 3PN.
   Verified live 26 Nov 2026: mournemountainsbrewery.com (Wix with raw --> leak & tab-nav clutter),
   028 4176 7391, info@mournemountainsbrewery.com, Saturday Beer Hall 16:00–23:00, live /shop & /taproom. */
const phone = "028 4176 7391";
const phoneHref = "tel:+442841767391";
const email = "info@mournemountainsbrewery.com";
const shopHref = "https://www.mournemountainsbrewery.com/shop";
const taproomHref = "https://www.mournemountainsbrewery.com/taproom";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Mourne+Mountains+Brewery+Upper+Dromore+Road+Warrenpoint+BT34+3PN";
---

<ConceptLayout
  title="Mourne Mountains Brewery & Taproom — Warrenpoint"
  slug="mourne-mountains-brewery"
  bodyClass="concept-page concept-mmb"
  businessName="Mourne Mountains Brewery"
  town="Warrenpoint"
  bannerNote="Imagery comprises indicative taproom flight and brewhouse visualisations."
>
  <header class="mmb-header">
    <div class="mmb-header-inner">
      <a class="mmb-brand" href="#top">
        <strong>Mourne Mountains Brewery</strong>
        <span>Independent Craft · Warrenpoint</span>
      </a>
      <nav class="mmb-nav" aria-label="Primary">
        <a href="#beers">The Beers</a>
        <a href="#taproom">Saturday Beer Hall</a>
        <a href="#trade">Trade &amp; Events</a>
        <a href="#location">Find Us</a>
      </nav>
      <div class="mmb-header-actions">
        <a class="mmb-header-tel" href={phoneHref}>{phone}</a>
        <a class="mmb-header-cta" href={shopHref} target="_blank" rel="noopener noreferrer">Web Shop ↗</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="mmb-hero" aria-labelledby="mmb-hero-title">
      <figure class="mmb-hero-media">
        <picture>
          <source srcset="/media/concepts/mourne-mountains-brewery/mmb-taproom-pours-640.webp 640w, /media/concepts/mourne-mountains-brewery/mmb-taproom-pours-1265.webp 1265w" sizes="100vw" type="image/webp" />
          <img src="/media/concepts/mourne-mountains-brewery/mmb-taproom-pours.jpg" alt="Tasting flight of four craft beers on a reclaimed oak taproom counter under warm amber lights" width="1408" height="768" loading="eager" />
        </picture>
        <figcaption class="mmb-hero-cap">Indicative taproom flight visualisation.</figcaption>
      </figure>
      <div class="mmb-hero-scrim" aria-hidden="true"></div>
      <div class="mmb-hero-content">
        <p class="mmb-eyebrow">Upper Dromore Road · Warrenpoint · Brewed with Altitude</p>
        <h1 id="mmb-hero-title">Independent Mourne beer poured straight from the tanks.</h1>
        <p class="mmb-hero-lead">
          Small-batch IPAs, helles lagers, fruited sours and red ales brewed with Irish base malts,
          house yeast and fresh water drawn from the Mourne Mountains.
        </p>
        <div class="mmb-hero-actions">
          <a class="mmb-btn mmb-btn--primary" href={shopHref} target="_blank" rel="noopener noreferrer">Shop Cans &amp; Mixed Cases ↗</a>
          <a class="mmb-btn mmb-btn--ghost" href={taproomHref} target="_blank" rel="noopener noreferrer">Saturday Beer Hall Info ↗</a>
        </div>
      </div>
    </section>

    <MmbBeerLedger />

    <section class="mmb-section mmb-taproom" id="taproom" aria-labelledby="mmb-tap-title">
      <div class="mmb-wrap mmb-split">
        <figure class="mmb-plate">
          <picture>
            <source srcset="/media/concepts/mourne-mountains-brewery/mmb-brewhouse-tanks-640.webp 640w, /media/concepts/mourne-mountains-brewery/mmb-brewhouse-tanks-1265.webp 1265w" sizes="(max-width: 860px) 100vw, 48vw" type="image/webp" />
            <img src="/media/concepts/mourne-mountains-brewery/mmb-brewhouse-tanks.jpg" alt="Stainless steel fermentation tanks, copper pipework and sacks of Irish malted barley in the brewhouse" width="1408" height="768" loading="lazy" />
          </picture>
          <figcaption>Warrenpoint brewhouse &amp; fermentation hall. Indicative brewhouse visualisation.</figcaption>
        </figure>
        <div>
          <p class="mmb-kicker">The Saturday Beer Hall</p>
          <h2 id="mmb-tap-title">Fresh keg &amp; cask pours metres from where they were brewed.</h2>
          <p>
            Every Saturday afternoon and evening the Beer Hall opens in Milltown East with rotating taps,
            brewery-only small batches, mixed cases to carry home and branded pint glassware.
          </p>
          <dl class="mmb-hours-list">
            <div><dt>Saturday Beer Hall</dt><dd>16:00 – 23:00</dd></div>
            <div><dt>Sunday – Friday</dt><dd>Brewing &amp; Web Dispatch</dd></div>
            <div><dt>Location</dt><dd>Unit 3, Milltown East, BT34 3PN</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section class="mmb-section mmb-trade" id="trade" aria-labelledby="mmb-trade-title">
      <div class="mmb-wrap mmb-split">
        <div>
          <p class="mmb-kicker">Kegs, Trade Accounts &amp; Group Visits</p>
          <h2 id="mmb-trade-title">Stocking a bar, restaurant or planning a taproom group?</h2>
          <p>
            We supply pubs, bottle shops and events across Northern Ireland in keg and can. Send your
            enquiry straight to the brewhouse team below or ring <a href={phoneHref}>{phone}</a>.
          </p>
          <p class="mmb-direct-meta">
            Email: <a href={`mailto:${email}`}>{email}</a>
          </p>
        </div>
        <form class="mmb-form" data-mmb-form>
          <div class="mmb-row">
            <label>
              <span>Your name</span>
              <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
            </label>
            <label>
              <span>Phone or venue</span>
              <input name="phone" type="text" required placeholder="028 / 07 or venue name" />
            </label>
          </div>
          <label>
            <span>Enquiry type</span>
            <select name="topic">
              <option value="Trade Keg & Can Supply">Trade Account (Kegs &amp; Cans)</option>
              <option value="Taproom Group Table">Saturday Beer Hall Group Table</option>
              <option value="Wedding / Event Keg Hire">Wedding or Private Event Kegs</option>
              <option value="Web Shop Order Query">Web Shop Order Query</option>
            </select>
          </label>
          <label>
            <span>Details</span>
            <textarea name="notes" rows="3" placeholder="Venue location, preferred beers, approximate date or group size..."></textarea>
          </label>
          <button class="mmb-btn mmb-btn--primary" type="submit">Send Brewhouse Enquiry</button>
        </form>
      </div>
    </section>

    <section class="mmb-section mmb-map-band" id="location" aria-label="Warrenpoint brewery map">
      <div class="mmb-wrap">
        <LocalAreaMap
          id="mmb-map"
          tone="dark"
          kicker="Milltown East · Warrenpoint"
          businessName="Mourne Mountains Brewery"
          address="Unit 3, Milltown East Industrial Estate, Upper Dromore Rd, Warrenpoint, BT34 3PN"
          lon={-6.2658937}
          lat={54.1195999}
          spanKm={16}
          mapHref={mapsHref}
          markers={[
            { name: "Warrenpoint Front", lon: -6.2538, lat: 54.1014, note: "4 mins south", side: "b" },
            { name: "Newry City", lon: -6.3402, lat: 54.1751, note: "10 mins north-west", side: "l" },
            { name: "Rostrevor", lon: -6.1972, lat: 54.1015, note: "8 mins east", side: "r" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="mmb-footer">
    <div class="mmb-wrap mmb-footer-inner">
      <div>
        <strong>Mourne Mountains Brewery</strong>
        <p>Unit 3, Milltown East Industrial Estate, Upper Dromore Rd, Warrenpoint, BT34 3PN</p>
      </div>
      <div class="mmb-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={shopHref} target="_blank" rel="noopener noreferrer">Online Shop ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const form = document.querySelector("[data-mmb-form]");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        const subject = `Brewery Enquiry — ${fd.get("topic")}`;
        const body = [
          `Name: ${fd.get("name")}`,
          `Phone / Venue: ${fd.get("phone")}`,
          `Topic: ${fd.get("topic")}`,
          `Details: ${fd.get("notes") || "None"}`,
        ].join("\n");
        const ev = new CustomEvent("mm:enquiry", {
          cancelable: true,
          detail: { to: "info@mournemountainsbrewery.com", subject, body, phone: "028 4176 7391", phoneHref: "tel:+442841767391" },
        });
        if (document.dispatchEvent(ev)) {
          window.location.href = `mailto:info@mournemountainsbrewery.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }
      });
    })();
  </script>
</ConceptLayout>
