---
/* Mourne Mountains Brewery — Interactive Beers, Beer Hall, and Trade Stage.
   Alternates on crisp malt-stone (#f4f3ef) with verified Warrenpoint brews,
   Saturday Beer Hall hours (16:00 to 23:00), and Mourne water provenance. */
const shopBase = "https://www.mournemountainsbrewery.com";
const taproomHref = `${shopBase}/taproom`;
const phone = "028 4176 7391";
const phoneHref = "tel:+442841767391";

const beers = [
  {
    name: "Rolling Thunder",
    style: "NEIPA",
    note: "Hazy, juicy New England IPA brewed with soft Mourne mountain water and late-addition hops.",
    url: `${shopBase}/product-page/rolling-thunder-neipa`,
  },
  {
    name: "Brewers Gloom",
    style: "West Coast IPA",
    note: "Piney, resinous, crisp West Coast bitterness balanced on Irish base malts.",
    url: `${shopBase}/product-page/brewers-gloom-west-coast-ipa`,
  },
  {
    name: "Mourneberger",
    style: "Helles lager",
    note: "Clean, cold-conditioned Bavarian-style helles lager poured fresh in cans and taproom kegs.",
    url: `${shopBase}/product-page/mourneberger-helles-lager`,
  },
  {
    name: "Wounded Knee",
    style: "Strawberry sour",
    note: "Bright fruited kettle sour with tart berry snap, poured fresh in the Saturday Beer Hall.",
    url: `${shopBase}/product-page/wounded-knee-strawberry-sour`,
  },
  {
    name: "Travelling Tales",
    style: "Hoppy red ale",
    note: "Toasted caramel Irish malt backbone lifted by citrus aroma hops.",
    url: `${shopBase}/product-page/travelling-tales-hoppy-red-ale`,
  },
  {
    name: "Session IPA",
    style: "Easy-drinking pale",
    note: "Crisp, aromatic session-strength pale built for long afternoons after the Mournes.",
    url: `${shopBase}/product-page/session-ipa`,
  },
];
---

<section class="mmb-section mmb-stage" id="brewhouse" aria-labelledby="mmb-stage-title">
  <div class="mmb-wrap mmb-stage-grid">
    <div class="mmb-stage-copy" data-mmb-tabs>
      <h2 id="mmb-stage-title">Beers, beer hall, and trade in Warrenpoint.</h2>

      <div class="mmb-tabs" role="tablist" aria-label="Explore Mourne Mountains Brewery">
        <button
          type="button"
          role="tab"
          id="mmb-tab-core"
          aria-controls="mmb-panel-core"
          aria-selected="true"
          tabindex="0"
          class="mmb-tab is-active"
          data-mmb-tab="core"
        >
          Core range
        </button>
        <button
          type="button"
          role="tab"
          id="mmb-tab-hall"
          aria-controls="mmb-panel-hall"
          aria-selected="false"
          tabindex="-1"
          class="mmb-tab"
          data-mmb-tab="hall"
        >
          Saturday beer hall
        </button>
        <button
          type="button"
          role="tab"
          id="mmb-tab-trade"
          aria-controls="mmb-panel-trade"
          aria-selected="false"
          tabindex="-1"
          class="mmb-tab"
          data-mmb-tab="trade"
        >
          Trade and events
        </button>
      </div>

      <div
        class="mmb-panel"
        role="tabpanel"
        id="mmb-panel-core"
        aria-labelledby="mmb-tab-core"
        data-mmb-panel="core"
      >
        <ul class="mmb-beer-ledger">
          {beers.map((beer) => (
            <li class="mmb-beer-row">
              <div class="mmb-beer-head">
                <h3>{beer.name}</h3>
                <span class="mmb-beer-style">{beer.style}</span>
              </div>
              <p>{beer.note}</p>
              <a class="mmb-beer-link" href={beer.url} target="_blank" rel="noopener noreferrer">
                Order cans in web shop
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div
        class="mmb-panel"
        role="tabpanel"
        id="mmb-panel-hall"
        aria-labelledby="mmb-tab-hall"
        data-mmb-panel="hall"
        hidden
      >
        <h3>Fresh keg and cask pours metres from where they were brewed</h3>
        <p>
          Every Saturday afternoon and evening the Beer Hall opens in Milltown East with rotating taps,
          brewery-only small batches, mixed cases to carry home, and branded pint glassware.
        </p>
        <dl class="mmb-ledger">
          <div class="mmb-ledger-row">
            <dt>Saturday Beer Hall</dt>
            <dd>16:00 to 23:00</dd>
          </div>
          <div class="mmb-ledger-row">
            <dt>Sunday to Friday</dt>
            <dd>Brewing and web dispatch</dd>
          </div>
          <div class="mmb-ledger-row">
            <dt>Brewing water</dt>
            <dd>Fresh Mourne mountain water, Irish base malts, house yeast</dd>
          </div>
          <div class="mmb-ledger-row">
            <dt>Location</dt>
            <dd>Unit 3, Milltown East, Upper Dromore Rd, BT34 3PN</dd>
          </div>
        </dl>
        <a class="mmb-btn mmb-btn--dark" href={taproomHref} target="_blank" rel="noopener noreferrer">
          Saturday beer hall guide
        </a>
      </div>

      <div
        class="mmb-panel"
        role="tabpanel"
        id="mmb-panel-trade"
        aria-labelledby="mmb-tab-trade"
        data-mmb-panel="trade"
        hidden
      >
        <h3>Kegs, cans, and private event pours across Northern Ireland</h3>
        <p>
          Direct brewery supply for pubs, restaurants, and bottle shops alongside group tables in the
          Saturday Beer Hall and keg hire for weddings or private celebrations.
        </p>
        <dl class="mmb-ledger">
          <div class="mmb-ledger-row">
            <dt>Trade supply</dt>
            <dd>Kegs and cans dispatched straight from Warrenpoint</dd>
          </div>
          <div class="mmb-ledger-row">
            <dt>Taproom groups</dt>
            <dd>Saturday Beer Hall group tables arranged on request</dd>
          </div>
          <div class="mmb-ledger-row">
            <dt>Brewhouse desk</dt>
            <dd><a href={phoneHref}>{phone}</a></dd>
          </div>
        </dl>
        <a class="mmb-btn mmb-btn--dark" href="#trade">Send a trade or event enquiry</a>
      </div>
    </div>

    <div class="mmb-stage-media">
      <figure class="mmb-plate">
        <picture>
          <source
            srcset="/media/concepts/mourne-mountains-brewery/mmb-brewhouse-tanks-640.webp 640w, /media/concepts/mourne-mountains-brewery/mmb-brewhouse-tanks-1265.webp 1265w"
            sizes="(max-width: 900px) 100vw, 44vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/mourne-mountains-brewery/mmb-brewhouse-tanks.jpg"
            alt="Stainless steel fermentation tanks, copper pipework, and sacks of Irish malted barley in the Warrenpoint brewhouse"
            width="1408"
            height="768"
            loading="lazy"
          />
        </picture>
        <figcaption>Warrenpoint brewhouse and fermentation hall. Indicative brewhouse visualisation.</figcaption>
      </figure>

      <dl class="mmb-provenance">
        <div class="mmb-provenance-row">
          <dt>Saturday Beer Hall</dt>
          <dd>16:00 to 23:00</dd>
        </div>
        <div class="mmb-provenance-row">
          <dt>Provenance</dt>
          <dd>Mourne mountain water and Irish base malts</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
