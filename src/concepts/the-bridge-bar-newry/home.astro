---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";

/* The Bridge Bar — 53–55 North Street, Newry, BT34 1DD.
   Sources (live-fetched 26 Nov 2026): bridgebarnewry.com (/).
   - Home of Craft Beers, Cocktails & Premium Spirits in Newry.
   - Cocktails menu includes classics: Mojito, Strawberry Daiquiri, Long Island Iced Tea.
   - Extensive premium gin list: Shortcross, Jawbox, Tanqueray & Hendrick's G&T serves.
   - Newly developed Beer Garden + full buffet & celebration event catering.
   - Live April 2026 PDF brochure:
     https://bridgebarnewry.com/wp-content/uploads/2026/04/2026-Bridge-Bar-Celebration-Event-Catering-150426.pdf
   - Live Buffet Dining Options PDF:
     https://bridgebarnewry.com/wp-content/uploads/2023/07/2023-Bridge-Bar-Buffet-Dining-Options-Brochure-2023.pdf
   - Phone: 028 3026 1777 · Email: info@bridgebarnewry.com · Facebook.
   Brief: research/concepts/the-bridge-bar-newry/the-bridge-bar-newry-elevation-brief.md */

const phone = "028 3026 1777";
const phoneHref = "tel:+442830261777";
const email = "info@bridgebarnewry.com";
const catering2026Pdf =
  "https://bridgebarnewry.com/wp-content/uploads/2026/04/2026-Bridge-Bar-Celebration-Event-Catering-150426.pdf";
const buffetPdf =
  "https://bridgebarnewry.com/wp-content/uploads/2023/07/2023-Bridge-Bar-Buffet-Dining-Options-Brochure-2023.pdf";
const facebook = "https://www.facebook.com/thebridgebarnewry";
const mapHref = "https://www.google.com/maps/search/?api=1&query=53-55+North+Street+Newry+BT34+1DD";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Yeseva+One&family=DM+Sans:wght@400;500;600;700&display=swap";

const pours = [
  {
    id: "gin",
    label: "Gin Ledger",
    title: "County Down & craft gin pairings poured properly.",
    copy: "Our back bar carries an extensive range of premium gins — including local Shortcross, Jawbox, Tanqueray and Hendrick's — paired to order. Ask our bartenders for their latest G&T combination.",
    highlights: ["Shortcross Gin (County Down)", "Jawbox Small Batch Gin", "Tanqueray & Hendrick's", "Bartender's Bespoke G&T Serves"],
  },
  {
    id: "cocktails",
    label: "Cocktail Counter",
    title: "Shaken classics for a proper night in Newry.",
    copy: "From crisp Mojitos and Strawberry Daiquiris to Long Island Iced Teas and fresh house creations — mixed to order whether you're starting the evening or gathering friends.",
    highlights: ["Fresh Mint Mojito", "Strawberry Daiquiri", "Long Island Iced Tea", "House & Seasonal Serves"],
  },
  {
    id: "craft",
    label: "Craft Beers & Spirits",
    title: "Craft draught, bottles & premium spirits on North Street.",
    copy: "Cold craft taps, rotating pours and top-shelf spirits served inside the main bar or straight out to our newly developed beer garden.",
    highlights: ["Craft Beer Selection", "Premium Spirits Shelf", "Newly Developed Beer Garden", "53–55 North Street, Newry"],
  },
];
---

<ConceptLayout
  title="The Bridge Bar — Craft Beers, Cocktails, Gin & Celebrations, Newry"
  slug="the-bridge-bar-newry"
  bodyClass="concept-page concept-bridgebar"
  lang="en-GB"
  businessName="The Bridge Bar"
  town="Newry"
  fontHref={fontHref}
  bannerNote="The backlit cocktail counter and festoon-lit beer garden scenes are AI-generated visualisations. Event brochures link to The Bridge Bar's live 2026 PDFs; group enquiries compose an email to info@bridgebarnewry.com."
>
  <header class="bb-header">
    <div class="bb-wrap bb-header-inner">
      <a class="bb-brand" href="#top">
        <strong>The Bridge Bar</strong>
        <small>53–55 North Street · Newry</small>
      </a>
      <nav class="bb-nav" aria-label="The Bridge Bar">
        <a href="#ledger">Gin &amp; Cocktails</a>
        <a href="#events">Beer Garden &amp; Catering</a>
        <a href="#book">Book a Party</a>
      </nav>
      <a class="bb-header-tel" href={phoneHref}>{phone}</a>
    </div>
  </header>

  <main id="top" class="bb-main">
    <section class="bb-hero" aria-labelledby="bb-hero-title">
      <figure class="bb-hero-media">
        <ResponsiveImage
          src="/media/concepts/the-bridge-bar-newry/bridge-bar-cocktail-counter.jpg"
          alt="Moody copper and walnut bar counter with two chilled crystal coupe cocktails and a botanical gin goblet under warm amber glow"
          width={1376}
          height={768}
          loading="eager"
          sizes="100vw"
          class="bb-hero-img"
        />
        <figcaption class="bb-hero-cap">Late-evening cocktail &amp; gin counter mood. Visualisation (AI-generated).</figcaption>
      </figure>
      <div class="bb-hero-scrim" aria-hidden="true"></div>

      <div class="bb-wrap bb-hero-inner">
        <p class="bb-kicker">North Street, Newry · Craft Beer, Cocktail &amp; Gin Bar</p>
        <h1 id="bb-hero-title">A great night in Newry starts at the bar.</h1>
        <p class="bb-lede">
          Shortcross and Jawbox G&amp;Ts, shaken cocktail classics, cold craft
          beers, our newly developed beer garden — and full buffet catering for
          family celebrations and corporate nights out.
        </p>
        <div class="bb-hero-actions">
          <a class="bb-btn bb-btn--copper" href="#book">Book a celebration or group</a>
          <a class="bb-btn bb-btn--ghost" href={catering2026Pdf} rel="noopener noreferrer">2026 Celebration Catering PDF ↗</a>
        </div>
      </div>
    </section>

    <section class="bb-ledger" id="ledger" aria-labelledby="bb-ledger-title">
      <div class="bb-wrap">
        <div class="bb-ledger-head">
          <div>
            <p class="bb-kicker">Behind the Copper Bar</p>
            <h2 id="bb-ledger-title">Explore the pouring ledger.</h2>
          </div>
          <div class="bb-tabs" role="tablist" aria-label="Bar menu focus">
            {pours.map((p, idx) => (
              <button
                type="button"
                role="tab"
                aria-selected={idx === 0 ? "true" : "false"}
                class:list={["bb-tab", { "is-active": idx === 0 }]}
                data-bb-tab={p.id}
              >
                {p.label}
              </button>
            ))}
          </div>
        </div>

        <div class="bb-ledger-stage">
          {pours.map((p, idx) => (
            <div class="bb-panel" data-bb-panel={p.id} hidden={idx !== 0}>
              <div class="bb-panel-copy">
                <h3>{p.title}</h3>
                <p>{p.copy}</p>
              </div>
              <ul class="bb-pour-list">
                {p.highlights.map((h) => <li>{h}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bb-events" id="events" aria-labelledby="bb-events-title">
      <div class="bb-wrap bb-events-grid">
        <figure class="bb-garden-plate">
          <ResponsiveImage
            src="/media/concepts/the-bridge-bar-newry/bridge-bar-evening-garden.jpg"
            alt="Festoon-lit brick and dark-timber Irish courtyard beer garden at twilight with sheltered booths and warm table lanterns"
            width={1200}
            height={896}
            sizes="(max-width: 960px) 100vw, 48vw"
            class="bb-garden-img"
          />
          <figcaption>Evening courtyard beer garden feel. Visualisation (AI-generated).</figcaption>
        </figure>

        <div class="bb-events-copy">
          <p class="bb-kicker bb-kicker--dark">Beer Garden &amp; Full Buffet Catering</p>
          <h2 id="bb-events-title">Birthdays, corporate nights &amp; 2026 celebration catering.</h2>
          <p>
            Hosting a family milestone, work night out or private get-together
            in Newry? Our newly developed beer garden and full buffet catering
            service take care of the drinks and food under one roof.
          </p>
          <div class="bb-brochures">
            <a class="bb-btn bb-btn--emerald" href={catering2026Pdf} rel="noopener noreferrer">2026 Celebration Catering PDF ↗</a>
            <a class="bb-btn bb-btn--outline" href={buffetPdf} rel="noopener noreferrer">Buffet Dining Brochure PDF ↗</a>
          </div>
        </div>
      </div>
    </section>

    <section class="bb-book" id="book" aria-labelledby="bb-book-title">
      <div class="bb-wrap bb-book-grid">
        <div>
          <p class="bb-kicker">Reserve a Space · 53–55 North Street</p>
          <h2 id="bb-book-title">Plan your party, buffet or beer garden group.</h2>
          <p>
            Send your preferred date and guest numbers straight to{" "}
            <a href={`mailto:${email}`}>{email}</a>, or call the bar on{" "}
            <a href={phoneHref}><strong>{phone}</strong></a>.
          </p>
          <p class="bb-find">
            53–55 North Street, Newry, BT34 1DD ·{" "}
            <a href={mapHref} rel="noopener noreferrer">Google Maps ↗</a> ·{" "}
            <a href={facebook} rel="noopener noreferrer">Facebook ↗</a>
          </p>
        </div>

        <form class="bb-form" id="bb-form" data-email={email}>
          <div class="bb-row">
            <label>
              <span>Occasion</span>
              <select name="occasion">
                <option value="Celebration / Birthday + Buffet">Celebration / Birthday + Buffet</option>
                <option value="Corporate / Work Night">Corporate / Work Night</option>
                <option value="Cocktail / Beer Garden Group">Cocktail / Beer Garden Group</option>
              </select>
            </label>
            <label>
              <span>Preferred date</span>
              <input type="date" name="date" required />
            </label>
          </div>
          <div class="bb-row">
            <label>
              <span>Approximate guests</span>
              <input name="guests" placeholder="e.g. 25 guests" required />
            </label>
            <label>
              <span>Your name &amp; phone</span>
              <input name="who" placeholder="Name and callback number" required />
            </label>
          </div>
          <button class="bb-btn bb-btn--copper bb-btn--full" type="submit">Open event enquiry email →</button>
        </form>
      </div>
    </section>
  </main>

  <footer class="bb-footer">
    <div class="bb-wrap bb-footer-inner">
      <span><strong>The Bridge Bar</strong> · 53–55 North Street, Newry, BT34 1DD</span>
      <span><a href={phoneHref}>{phone}</a> · <a href={`mailto:${email}`}>{email}</a> · <a href={facebook} rel="noopener noreferrer">Facebook</a></span>
    </div>
  </footer>

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>("[data-bb-tab]");
    const panels = document.querySelectorAll<HTMLElement>("[data-bb-panel]");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.bbTab;
        tabs.forEach((t) => {
          const active = t.dataset.bbTab === target;
          t.classList.toggle("is-active", active);
          t.setAttribute("aria-selected", String(active));
        });
        panels.forEach((p) => {
          p.hidden = p.dataset.bbPanel !== target;
        });
      });
    });

    const form = document.getElementById("bb-form") as HTMLFormElement | null;
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const d = new FormData(form);
      const body = [
        `Occasion: ${d.get("occasion") || ""}`,
        `Preferred date: ${d.get("date") || ""}`,
        `Estimated guests: ${d.get("guests") || ""}`,
        `Contact: ${d.get("who") || ""}`,
      ].join("\n");
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`Group / Event Enquiry — The Bridge Bar Newry`)}&body=${encodeURIComponent(body)}`;
    });
  </script>
</ConceptLayout>
