---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import DvChrome from "./components/DvChrome.astro";
import DvNetBranch from "./components/DvNetBranch.astro";
---

<ConceptLayout
  title={"Urgent help — Donard Veterinary Clinic"}
  slug="donard-veterinary"
  bodyClass="concept-page concept-donard-veterinary"
  lang="en-GB"
  bannerNote="Pet illustrations and the catchment map are drawn — not photographs or a boundary survey."
>
  <DvChrome current="emergency" />

  <main class="dv-route-page dv-route-page--branch">
    <div class="dv-route-intro">
      <p class="dv-kicker">Urgent help</p>
      <h1>Worried about your pet?<br /><em>Call us now.</em></h1>
      <p class="dv-route-lede">
        One number, day or night. During clinic hours you reach the team at
        8 Railway Street; outside hours you are diverted to the on-call vet.
      </p>
    </div>

    <DvNetBranch />

    <div class="dv-route-next">
      <p>
        Need digital advice instead?
        <a href="/concepts/donard-veterinary/vidivet/">VidiVet support →</a>
      </p>
      <p>
        Booking a routine visit?
        <a href="/concepts/donard-veterinary/appointments/">Request an appointment →</a>
      </p>
    </div>
  </main>
</ConceptLayout>
