---
/** Repeat prescription request. The live form asks only for name, email and
 *  phone — not which pet or which medicine — so the team has to call back
 *  just to find out what's wanted. This asks for both up front. Preview only:
 *  it validates and confirms but sends nothing (see form-kit.ts). */
import DvFormDone from "./DvFormDone.astro";
---

<form class="dv-form" data-dv-form="prescription" novalidate aria-labelledby="dv-rx-title">
  <div class="dv-form-head">
    <h3 id="dv-rx-title">Repeat prescription</h3>
    <p>For medicine your pet already takes. We'll ring when it's ready.</p>
  </div>

  <div class="dv-form-body" data-dv-body>
    <fieldset class="dv-field" aria-describedby="dv-rx-err-med">
      <legend><span class="dv-step" aria-hidden="true">1</span>Which medicine?</legend>
      <p class="dv-field-error" id="dv-rx-err-med" data-dv-error hidden>Tell us your pet's name and the medicine.</p>
      <div class="dv-row">
        <label class="dv-input dv-input--narrow">
          <span>Your pet's name</span>
          <input type="text" name="petName" autocomplete="off" required />
        </label>
        <label class="dv-input">
          <span>Medicine</span>
          <input type="text" name="medicine" autocomplete="off" required aria-describedby="dv-rx-hint" />
          <small id="dv-rx-hint">As it's written on the label, with the strength if you have it.</small>
        </label>
      </div>
    </fieldset>

    <fieldset class="dv-field" aria-describedby="dv-rx-err-you">
      <legend><span class="dv-step" aria-hidden="true">2</span>How can we reach you?</legend>
      <p class="dv-field-error" id="dv-rx-err-you" data-dv-error hidden>Please give us your name and a phone number.</p>
      <div class="dv-row">
        <label class="dv-input">
          <span>Your name</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label class="dv-input">
          <span>Phone number</span>
          <input type="tel" name="phone" inputmode="tel" autocomplete="tel" pattern="[0-9\s+\-\(\)]{7,}" required />
        </label>
      </div>
      <label class="dv-input">
        <span>Email <small>(optional)</small></span>
        <input type="email" name="email" autocomplete="email" />
      </label>
    </fieldset>

    <div class="dv-form-foot">
      <button class="dv-btn dv-btn--primary dv-btn--big" type="submit">Request prescription</button>
    </div>
  </div>

  <DvFormDone />
</form>

<script>
  import { wireForm, firstName } from "../form-kit";

  document.querySelectorAll<HTMLFormElement>('[data-dv-form="prescription"]').forEach((form) => {
    wireForm(form, (data) => ({
      title: `Thanks, ${firstName(data.get("name"))}. That's with us.`,
      copy: `We'll get ${String(data.get("medicine")).trim()} ready for ${String(data.get("petName")).trim()} and ring ${data.get("phone")} when it's ready to collect from Railway Street.`,
    }));
  });
</script>
