---
/** The Donard trio — dog, cat and rabbit drawn after the window decal on
 *  8 Railway Street, in the shopfront's teal, slate and white. Hand-authored
 *  SVG in a 240 × 180 frame, all three facing left, sharing one ground line
 *  at y = 174.
 *
 *  Renders bare <g> groups so the same drawing can sit inside the hero scene
 *  or be cropped into a glyph. `part` picks one animal; the default is the
 *  whole composition. Colours come from --dv-dog, --dv-cat and --dv-rabbit
 *  so a parent can recolour it. Classes on the tail, eyes and nose are motion
 *  hooks for the hero; they do nothing on their own. */
interface Props {
  part?: "all" | "dog" | "cat" | "rabbit";
}

const { part = "all" } = Astro.props;
const show = (name: string) => part === "all" || part === name;
---

{show("dog") && (
  <g class="dv-dog">
    <path fill="var(--dv-dog)" d="M16 43 C19 40 24 39 30 38 L44 35 C50 33 54 27 60 23 C68 16 84 14 94 20 C102 27 104 40 104 54 C104 70 108 84 116 98 C124 112 130 130 132 160 L132 174 L12 174 C4 174 4 166 12 164 L66 160 C62 148 60 132 60 118 C60 102 58 92 56 84 C54 77 50 72 44 70 C38 68 30 68 24 66 C19 64 16 62 15 58 C14 53 14 47 16 43 Z" />
    <path d="M14 168 L68 166" stroke="#000" stroke-opacity=".14" stroke-width="2" stroke-linecap="round" />
    <g class="dv-dog-ear">
      <path fill="var(--dv-dog-ear)" d="M72 30 C86 23 101 31 103 48 C105 66 101 84 93 93 C86 98 79 90 77 77 C75 61 70 43 72 30 Z" />
      <path d="M78 80 C81 92 88 96 94 91" fill="none" stroke="#fff" stroke-opacity=".55" stroke-width="1.6" stroke-linecap="round" />
    </g>
    <g class="dv-blink dv-blink--dog">
      <path d="M51 37.5 C53.5 35 57.5 35 59.5 37.5 C57.5 40 53.5 40 51 37.5 Z" fill="var(--dv-ink)" />
      <circle cx="56.6" cy="36.9" r=".9" fill="#fff" />
    </g>
    <path d="M13.5 46 C13.5 42.5 17 41 21 41.4 C23.6 41.8 24 45.6 22.6 48.2 C21 50.6 16 50.8 14.4 49 Z" fill="var(--dv-ink)" />
    <path d="M17 58 C22 60 28 61 34 60.5" fill="none" stroke="var(--dv-ink)" stroke-opacity=".35" stroke-width="1.2" stroke-linecap="round" />
  </g>
)}

{show("cat") && (
  <g class="dv-cat">
    <path class="dv-cat-tail" d="M201 124 C220 122 227 100 221 80 C217 64 223 52 232 51" fill="none" stroke="var(--dv-cat)" stroke-width="8" stroke-linecap="round" />
    <rect x="146" y="136" width="11" height="38" rx="5.5" fill="var(--dv-cat)" />
    <rect x="146" y="136" width="11" height="38" rx="5.5" fill="#000" opacity=".22" />
    <rect x="186" y="136" width="11" height="38" rx="5.5" fill="var(--dv-cat)" />
    <rect x="186" y="136" width="11" height="38" rx="5.5" fill="#000" opacity=".22" />
    <path fill="var(--dv-cat)" d="M112 80 C118 74 130 70 138 74 C150 88 164 100 178 104 C190 106 198 112 202 122 C206 134 204 148 198 158 C198 165 200 170 201 172 C201 175 198 175 195 174 L188 174 C183 174 183 169 188 168 C186 158 182 150 176 145 C166 141 152 141 142 139 C141 152 140 164 141 171 C141 174 138 174 136 174 L126 174 C121 174 121 169 127 168 C128 156 128 142 126 130 C124 118 120 108 117 100 C114 94 112 88 112 80 Z" />
    <g fill="var(--dv-cat)">
      <ellipse cx="118" cy="68" rx="18" ry="15.5" />
      <path d="M96 74 C96 68 101 63 108 63 L114 80 C108 84 100 83 97 79 Z" />
      <path d="M105 58 L103 43 L116 53 Z" stroke="var(--dv-cat)" stroke-width="2" stroke-linejoin="round" />
      <path d="M116 55 L115 41 L127 57 Z" stroke="var(--dv-cat)" stroke-width="2" stroke-linejoin="round" />
    </g>
    <path d="M176 145 C174 131 182 119 194 116" fill="none" stroke="#000" stroke-opacity=".12" stroke-width="2" stroke-linecap="round" />
    <path d="M105.5 48 L112.5 53.5 L106.5 55.5 Z" fill="var(--dv-blush)" opacity=".6" />
    <g class="dv-blink dv-blink--cat">
      <path d="M105.5 66 C108 62.6 113 62.6 115.2 65.2 C113 68.6 108 69 105.5 66 Z" fill="var(--dv-cat-eye)" />
      <ellipse cx="110.4" cy="65.8" rx="1.1" ry="2.8" fill="var(--dv-ink)" />
    </g>
    <path d="M95.4 72.4 L99.4 71.4 L98 75 Z" fill="var(--dv-blush)" />
    <path d="M98 76 C98 79 100 80.5 102 80.5" fill="none" stroke="var(--dv-ink)" stroke-width="1" stroke-linecap="round" opacity=".45" />
  </g>
)}

{show("rabbit") && (
  <g class="dv-rabbit" transform="translate(33 26.1) scale(.85)">
    <path fill="var(--dv-rabbit)" d="M60 127 C58 123 60 120 64 117 C70 110 76 105 82 103 C82 92 84 80 87 68 C93 78 96 88 95 100 C96 99.5 97 99.5 98 100 C100 89 103 79 107 71 C111 82 110 94 107 106 C102 112 101 119 105 123 C114 116 137 121 151 139 C160 149 166 161 164 171 C163 174 161 174 158 174 L84 174 C78 174 78 168 83 167 C80 160 78 155 79 150 C79 146 81 143 83 141 C80 143 74 143 69 141 C64 139 60 134 60 127 Z" />
    <path d="M88.4 75 C89 82 90 89 91 96" stroke="var(--dv-blush)" stroke-width="2" stroke-linecap="round" opacity=".7" />
    <path d="M106.4 78 C105.6 86 104.4 94 102.6 101" stroke="var(--dv-blush)" stroke-width="2" stroke-linecap="round" opacity=".5" />
    <path class="dv-blink dv-blink--rabbit" d="M77.5 112 C79.2 110 82.8 110 84.5 112 C82.8 114 79.2 114 77.5 112 Z" fill="var(--dv-ink)" />
    <ellipse class="dv-rabbit-nose" cx="60.6" cy="125.6" rx="1.7" ry="1.4" fill="var(--dv-blush)" />
    <path d="M61.5 130 C63 133 65.5 134 67.5 133" fill="none" stroke="var(--dv-ink)" stroke-width=".8" stroke-linecap="round" opacity=".3" />
    <path d="M120 174 C118 156 132 144 148 146 C160 152 164 164 161 174 Z" fill="#000" opacity=".06" />
  </g>
)}
