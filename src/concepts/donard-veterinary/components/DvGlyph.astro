---
/** Line icon set for the Donard page: one 24-unit grid, one stroke weight,
 *  no animals. The pets live in the trio mark (header, hero, booking form);
 *  keeping them out of the icons is what keeps the page from reading as a
 *  children's book. All decorative: the label beside each carries meaning. */
import type { GlyphName } from "../content";

interface Props {
  name: GlyphName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={["dv-glyph", `dv-glyph--${name}`, className]}
  viewBox="-5 -5 34 34"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "call" && (
    <>
      <path d="M5.2 3.5h3.1l1.6 4.1-2.1 1.4a11.5 11.5 0 0 0 5.2 5.2l1.4-2.1 4.1 1.6v3.1a2 2 0 0 1-2 2A15.3 15.3 0 0 1 3.2 5.5a2 2 0 0 1 2-2z" />
      <path d="M14.6 3.4a6.4 6.4 0 0 1 6 6" />
      <path d="M14.6 6.8a3 3 0 0 1 2.6 2.6" />
    </>
  )}
  {name === "book" && (
    <>
      <rect x="3" y="5" width="18" height="16" rx="2" />
      <path d="M3 10h18M8 3v4M16 3v4" />
      <path d="M9 15.5l2 2 4-4" />
    </>
  )}
  {name === "prescription" && (
    <>
      <rect x="7" y="2.5" width="10" height="4" rx="1" />
      <path d="M6 6.5h12v12.5a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2z" />
      <path d="M12 10.5v6M9 13.5h6" />
    </>
  )}
  {name === "advice" && (
    <>
      <path d="M4 4.5h16a1 1 0 0 1 1 1V16a1 1 0 0 1-1 1h-8.5L7 20.5V17H4a1 1 0 0 1-1-1V5.5a1 1 0 0 1 1-1z" />
      <path d="M8 10.8h.01M12 10.8h.01M16 10.8h.01" stroke-width="2.4" />
    </>
  )}
  {name === "routine" && (
    <g transform="rotate(-45 12 12)">
      <rect x="6" y="9.5" width="10" height="5" rx="1" />
      <path d="M16 12h3M19 9.5v5M6 12H2.5M9 9.5v2M12 9.5v2" />
    </g>
  )}
  {name === "diagnostics" && (
    <>
      <circle cx="10.5" cy="10.5" r="6.5" />
      <path d="M15.3 15.3l5.2 5.2" />
      <path d="M6.5 10.8h1.8l1.1-2.2 1.8 4.4 1.1-2.2h1.7" />
    </>
  )}
  {name === "surgery" && (
    <g transform="rotate(-45 12 12)">
      <rect x="2.5" y="8.5" width="19" height="7" rx="3.5" />
      <path d="M9 8.5v7M15 8.5v7" />
      <path d="M11.2 11h.01M12.8 11h.01M11.2 13h.01M12.8 13h.01" stroke-width="1.8" />
    </g>
  )}
  {name === "dental" && (
    <path d="M8 3.5c-2.5 0-4 2-4 4.8 0 2.3 1.2 3.6 1.6 6 .4 2.8 1 6.2 2.6 6.2 1.6 0 1.6-4.5 3.8-4.5s2.2 4.5 3.8 4.5c1.6 0 2.2-3.4 2.6-6.2.4-2.4 1.6-3.7 1.6-6 0-2.8-1.5-4.8-4-4.8-1.6 0-2.4 1-4 1s-2.4-1-4-1z" />
  )}
  {name === "weight" && (
    <>
      <rect x="3" y="4.5" width="18" height="16" rx="3" />
      <path d="M7.5 13.5a4.5 4.5 0 0 1 9 0" />
      <path d="M12 13.5l2.2-2.6" />
    </>
  )}
  {name === "passport" && (
    <>
      <rect x="5" y="2.5" width="14" height="19" rx="2" />
      <circle cx="12" cy="10.5" r="3.6" />
      <path d="M8.4 10.5h7.2M12 6.9c-1.5 1.9-1.5 5.3 0 7.2M12 6.9c1.5 1.9 1.5 5.3 0 7.2M9 17.5h6" />
    </>
  )}
</svg>
