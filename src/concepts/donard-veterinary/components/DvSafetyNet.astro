---
/** The phone always finds a vet — drawn as a branch, not a pipeline.
 *
 *  One number enters; two conditional routes leave it (in hours → clinic,
 *  outside hours → on-call diversion). VidiVet sits below as companion cover
 *  for clients — always on, not step three of the call path. */
import {
  clinicPhone,
  clinicPhoneHref,
  vidivetCover,
} from "../content";
import DvNetBranch from "./DvNetBranch.astro";
---

<section class="dv-safety-net" id="safety-net" aria-labelledby="dv-safety-heading">
  <div class="dv-safety-head">
    <p class="dv-kicker">The phone always finds a vet</p>
    <h2 class="dv-h2" id="dv-safety-heading">One number. Help in hours, and out.</h2>
    <p class="dv-section-lede">
      Ring the clinic line any time — during hours you reach the team; outside
      hours you are diverted to the on-call vet. VidiVet sits alongside for
      our clients.
    </p>
  </div>

  <DvNetBranch />

  <aside class="dv-net-companion" aria-labelledby="dv-vidivet-heading">
    <span class="dv-net-tag">{vidivetCover.badge}</span>
    <svg class="dv-net-art dv-net-art--sm" viewBox="0 0 120 120" role="img" aria-label="A video screen with a play symbol">
      <rect class="dv-draw-stroke dv-net-fill" x="22" y="30" width="76" height="54" rx="8" />
      <path class="dv-draw-stroke" d="M46 84 L42 96 L56 84" />
      <path class="dv-draw-accent-fill" d="M52 48 L52 66 L70 57 Z" />
      <path class="dv-draw-fine" d="M32 40 L40 40" />
    </svg>
    <div class="dv-net-card">
      <h3 id="dv-vidivet-heading">{vidivetCover.title}</h3>
      <p>{vidivetCover.copy}</p>
      <p class="dv-safety-detail">{vidivetCover.detail}</p>
      <a class="dv-link" href="/concepts/donard-veterinary/vidivet/">
        Read about VidiVet →
      </a>
    </div>
  </aside>

  <p class="dv-safety-foot">
    <a class="dv-cta dv-cta--compact" href={clinicPhoneHref}>{clinicPhone}</a>
    <a class="dv-link" href="/concepts/donard-veterinary/emergency/">
      Urgent help →
    </a>
  </p>
</section>
