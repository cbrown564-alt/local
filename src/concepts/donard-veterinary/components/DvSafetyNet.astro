---
/** Move 2 — the phone always finds a vet, drawn as a mechanism.
 *
 *  One number enters on the left; the call path (a stippled line, like the
 *  catchment patch) carries it through the three layers the practice itself
 *  publishes: the clinic in hours, diversion to the on-call vet beyond
 *  hours, VidiVet free for clients around the clock. Each connector is
 *  tagged with the condition that routes the call. The register is
 *  reassurance — a diagram you could follow at 11pm, not a spectacle.
 *
 *  Vignettes use the drawing kit (two weights, round caps, palette fills);
 *  the clinic house is the same mark drawn on the catchment map. */
import { clinicPhone, clinicPhoneHref, safetyNetLayers } from "../content";
---

<section class="dv-safety-net" id="safety-net" aria-labelledby="dv-safety-heading">
  <div class="dv-safety-head">
    <p class="dv-kicker">The phone always finds a vet</p>
    <h2 class="dv-h2" id="dv-safety-heading">One number. Three layers of cover.</h2>
    <p class="dv-section-lede">
      What happens when you ring — the practice's own published policy, drawn
      as it works.
    </p>
  </div>

  <ol class="dv-net-flow" role="list">
    <li class="dv-net-start">
      <svg class="dv-net-art" viewBox="0 0 120 120" role="img" aria-label="A ringing telephone handset">
        <path class="dv-draw-stroke" d="M34 82 C26 74 24 62 30 56 L40 46 C44 42 50 42 53 46 L57 50 C60 53 60 58 57 61 L54 64 C60 71 65 76 72 81 L75 78 C78 75 83 75 86 78 L90 82 C94 85 94 91 90 95 L82 103 C76 109 66 107 58 101 C49 94 40 88 34 82 Z" />
        <path class="dv-draw-accent" d="M74 30 C80 32 86 36 89 42" />
        <path class="dv-draw-accent" d="M82 20 C92 24 100 32 104 42" />
      </svg>
      <a class="dv-net-number" href={clinicPhoneHref}>{clinicPhone}</a>
      <span class="dv-net-start-label">One number, day or night</span>
    </li>

    {safetyNetLayers.map((layer) => (
      <>
        <li class="dv-net-conn" aria-hidden="true">
          <span class="dv-net-tag">{layer.incoming}</span>
          <svg class="dv-net-conn-h" viewBox="0 0 120 24">
            <path d="M4 12 H104" />
            <path d="M104 6 L114 12 L104 18" />
          </svg>
          <svg class="dv-net-conn-v" viewBox="0 0 24 80">
            <path d="M12 4 V64" />
            <path d="M6 64 L12 74 L18 64" />
          </svg>
        </li>
        <li class="dv-net-stop">
          <span class="dv-safety-step" aria-hidden="true">{layer.step}</span>
          {layer.vignette === "clinic" && (
            <svg class="dv-net-art" viewBox="0 0 120 120" role="img" aria-label="The clinic, drawn as a house with a cross">
              <rect class="dv-draw-stroke dv-net-fill" x="30" y="52" width="60" height="42" rx="2" />
              <path class="dv-draw-stroke" d="M24 52 L60 28 L96 52" />
              <path class="dv-draw-accent" d="M52 68 L68 68 M60 60 L60 76" />
              <rect class="dv-draw-stroke" x="38" y="72" width="11" height="22" />
              <rect class="dv-draw-stroke" x="73" y="72" width="11" height="22" />
            </svg>
          )}
          {layer.vignette === "oncall" && (
            <svg class="dv-net-art" viewBox="0 0 120 120" role="img" aria-label="A handset with an on-call cross badge">
              <path class="dv-draw-stroke" d="M28 88 C22 82 20 72 25 67 L33 59 C36 56 41 56 44 59 L47 62 C50 65 50 69 47 72 L45 74 C50 80 54 84 60 88 L62 86 C65 83 69 83 72 86 L75 89 C78 92 78 97 75 100 L69 106 C64 111 56 109 49 104 C41 98 33 93 28 88 Z" />
              <circle class="dv-draw-stroke dv-net-fill" cx="84" cy="40" r="20" />
              <path class="dv-draw-accent" d="M77 40 L91 40 M84 33 L84 47" />
            </svg>
          )}
          {layer.vignette === "vidivet" && (
            <svg class="dv-net-art" viewBox="0 0 120 120" role="img" aria-label="A video screen with a play symbol">
              <rect class="dv-draw-stroke dv-net-fill" x="22" y="30" width="76" height="54" rx="8" />
              <path class="dv-draw-stroke" d="M46 84 L42 96 L56 84" />
              <path class="dv-draw-accent-fill" d="M52 48 L52 66 L70 57 Z" />
              <path class="dv-draw-fine" d="M32 40 L40 40" />
            </svg>
          )}
          <div class="dv-net-card">
            <h3>{layer.title}</h3>
            <p>{layer.copy}</p>
            <p class="dv-safety-detail">{layer.detail}</p>
            {"href" in layer && layer.href && (
              <a class="dv-link" href={layer.href} rel="external">
                Read about VidiVet on the clinic website →
              </a>
            )}
          </div>
        </li>
      </>
    ))}
  </ol>

  <p class="dv-safety-foot">
    <a class="dv-cta dv-cta--compact" href={clinicPhoneHref}>{clinicPhone}</a>
    <a class="dv-link" href="/concepts/donard-veterinary/appointments/#emergency-heading">
      Emergency information →
    </a>
  </p>
</section>
