---
/** In-place confirmation shared by the preview forms; filled in by
 *  form-kit.ts once a request passes validation. */
---

<div class="dv-done" data-dv-done role="status" tabindex="-1" hidden>
  <span class="dv-done-tick" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
  </span>
  <strong data-dv-done-title></strong>
  <p data-dv-done-copy></p>
  <small>Preview only: nothing has been sent.</small>
  <button class="dv-link" type="button" data-dv-again>Make another request</button>
</div>
