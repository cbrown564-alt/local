---
import GeneratedMapPlate from "../../_shell/GeneratedMapPlate.astro";
import { catchmentPlaces } from "../content";

interface Props { headingId?: string; }
const { headingId } = Astro.props;

const places = [
  ...catchmentPlaces.map((place) => ({
    label: place.label,
    note: "",
  })),
  { label: "Newcastle", note: "8 Railway Street" },
] as const;
---

<GeneratedMapPlate
  id="dv-map"
  src="/media/maps/donard-catchment-generated.png"
  width={1448}
  height={1086}
  title="Areas served from Newcastle"
  desc="Newcastle on the coast at the foot of the Mournes, with Castlewellan, Dundrum, Bryansford, Clough, Annalong, Kilcoo and Hilltown nearby — the villages the practice says it looks after."
  headingId={headingId}
>
  <span class="mm-generated-map-label" style="--map-x:69%;--map-y:57%">Newcastle · Railway Street</span>
  <Fragment slot="caption">
    Newcastle and the nearby villages the practice says it looks after. Indicative, not a boundary survey.
  </Fragment>
  <ul slot="key">
    {places.map((place) => <li><strong>{place.label}</strong>{place.note && <span>{place.note}</span>}</li>)}
  </ul>
</GeneratedMapPlate>
