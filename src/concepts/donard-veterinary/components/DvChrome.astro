---
/** Shared strip + header for Donard companion routes. */
import { clinicPhone, clinicPhoneHref } from "../content";

interface Props {
  current?: "appointments" | "emergency" | "vidivet";
}

const { current } = Astro.props;

const home = "/concepts/donard-veterinary/";
const routes = {
  appointments: `${home}appointments/`,
  emergency: `${home}emergency/`,
  vidivet: `${home}vidivet/`,
} as const;
---

<div class="dv-strip">
  <span>Pet emergency? Call <a href={clinicPhoneHref}>{clinicPhone}</a></span>
  <span class="dv-strip-hours">Mon–Fri 8:30am–6:30pm · Wed until 7pm · Sat 9am–1pm</span>
</div>

<header class="dv-header">
  <a class="dv-brand" href={home}>
    <img
      class="dv-badge"
      src="/media/concepts/donard-veterinary/donard-veterinary-emblem.png"
      alt="Donard Veterinary Clinic emblem"
      width="48"
      height="48"
      loading="eager"
    />
    <span class="dv-brand-text">
      <span class="dv-brand-name">Donard Veterinary Clinic</span>
      <span class="dv-brand-sub">Professional · Caring · Compassionate</span>
    </span>
  </a>
  <nav class="dv-nav" aria-label="Primary">
    <a href={routes.emergency} aria-current={current === "emergency" ? "page" : undefined}>Emergency</a>
    <a href={routes.vidivet} aria-current={current === "vidivet" ? "page" : undefined}>VidiVet</a>
    <a href={routes.appointments} aria-current={current === "appointments" ? "page" : undefined}>Appointments</a>
    <a class="dv-nav-wide" href={`${home}#life`}>Pet services</a>
    <a class="dv-nav-wide" href={`${home}#catchment`}>Near you</a>
  </nav>
  <div class="dv-header-actions">
    <a class="dv-phone" href={clinicPhoneHref}>{clinicPhone}</a>
    <a class="dv-book" href={routes.appointments}>Request appointment</a>
  </div>
</header>
