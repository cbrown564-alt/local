---
/** Drawn dog — a sitting spaniel, hand-authored line illustration in the
 *  concept palette. Studio drawing, not a photograph of a patient.
 *  Part of the drawn cast (DvCat, DvRabbit) reused across the concept. */
interface Props {
  class?: string;
  label?: string;
  x?: number;
  y?: number;
  width?: number;
  height?: number;
}

const { class: className, label = "A sitting spaniel", x, y, width, height } = Astro.props;
---

<svg class:list={["dv-cast-art", className]} viewBox="0 0 240 260" role="img" aria-label={label} x={x} y={y} width={width} height={height}>
  <!-- muzzle wash -->
  <ellipse class="dv-draw-wash" cx="120" cy="122" rx="26" ry="17" />
  <!-- body -->
  <path class="dv-draw-stroke" d="M92 148 C78 168 73 198 82 217 C97 228 143 228 158 217 C167 198 162 168 148 148" />
  <!-- head -->
  <path class="dv-draw-stroke" d="M86 80 C82 58 100 46 120 46 C140 46 158 58 154 80 C158 96 156 116 146 129 C138 138 130 141 120 141 C110 141 102 138 94 129 C84 116 82 96 86 80 Z" />
  <!-- ears -->
  <path class="dv-draw-stroke" d="M89 70 C67 76 57 108 61 140 C63 156 73 164 82 159 C91 154 93 134 90 112" />
  <path class="dv-draw-stroke" d="M151 70 C173 76 183 108 179 140 C177 156 167 164 158 159 C149 154 147 134 150 112" />
  <path class="dv-draw-fine" d="M82 84 C72 98 68 124 72 148" />
  <path class="dv-draw-fine" d="M158 84 C168 98 172 124 168 148" />
  <!-- brow -->
  <path class="dv-draw-fine" d="M92 82 Q99 78 106 81" />
  <path class="dv-draw-fine" d="M134 81 Q141 78 148 82" />
  <!-- eyes -->
  <circle class="dv-draw-fill" cx="99" cy="95" r="4.5" />
  <circle class="dv-draw-fill" cx="141" cy="95" r="4.5" />
  <!-- nose + mouth -->
  <path class="dv-draw-fill" d="M109 111 C109 104 131 104 131 111 C131 119 124 125 120 125 C116 125 109 119 109 111 Z" />
  <path class="dv-draw-fine" d="M120 125 L120 131" />
  <path class="dv-draw-fine" d="M120 131 C113 138 104 137 100 131" />
  <path class="dv-draw-fine" d="M120 131 C127 138 136 137 140 131" />
  <!-- wagging tail -->
  <g class="dv-dog-tail">
    <path class="dv-draw-stroke" d="M157 192 C172 188 180 176 176 164" />
    <path class="dv-draw-fine" d="M163 188 C172 184 177 176 175 168" />
  </g>
  <!-- collar + tag -->
  <path class="dv-draw-accent" d="M95 144 C109 154 131 154 145 144" />
  <circle class="dv-draw-accent-fill" cx="120" cy="155" r="3.5" />
  <!-- chest fluff -->
  <path class="dv-draw-fine" d="M113 158 C112 163 113 167 112 171" />
  <path class="dv-draw-fine" d="M122 160 C121 165 122 169 121 173" />
  <path class="dv-draw-fine" d="M130 158 C130 163 131 167 130 171" />
  <!-- front legs + paws -->
  <path class="dv-draw-stroke" d="M100 180 C98 196 98 206 100 214" />
  <path class="dv-draw-stroke" d="M140 180 C142 196 142 206 140 214" />
  <path class="dv-draw-stroke" d="M88 213 C88 222 114 222 114 213" />
  <path class="dv-draw-stroke" d="M126 213 C126 222 152 222 152 213" />
  <path class="dv-draw-fine" d="M97 215 L97 220 M105 215 L105 220" />
  <path class="dv-draw-fine" d="M135 215 L135 220 M143 215 L143 220" />
  <!-- ground -->
  <path class="dv-draw-ground" d="M58 230 Q120 238 182 230" />
</svg>
