---
/** Drawn cat — sitting, tail curled, hand-authored line illustration in the
 *  concept palette. Studio drawing, not a photograph of a patient.
 *  Part of the drawn cast (DvDog, DvRabbit) reused across the concept. */
interface Props {
  class?: string;
  label?: string;
  x?: number;
  y?: number;
  width?: number;
  height?: number;
}

const { class: className, label = "Illustrated cat — sitting, tail curled", x, y, width, height } = Astro.props;
---

<svg class:list={["dv-cast-art", className]} viewBox="0 0 240 260" role="img" aria-label={label} x={x} y={y} width={width} height={height}>
  <ellipse class="dv-draw-wash" cx="122" cy="185" rx="28" ry="28" />
  <!-- body -->
  <path class="dv-draw-stroke" d="M94 118 C85 148 83 184 93 211 C110 221 142 221 154 211 C162 184 160 148 150 118" />
  <!-- head -->
  <path class="dv-draw-stroke" d="M90 92 C86 66 102 54 122 54 C142 54 158 66 154 92 C156 108 146 122 122 124 C98 122 88 108 90 92 Z" />
  <!-- ears -->
  <path class="dv-draw-stroke" d="M99 64 L94 42 L117 56" />
  <path class="dv-draw-stroke" d="M145 64 L150 42 L127 56" />
  <path class="dv-draw-fine" d="M101 58 L98 48 L110 55" />
  <path class="dv-draw-fine" d="M143 58 L146 48 L134 55" />
  <!-- eyes: almond with pupil -->
  <path class="dv-draw-fine" d="M98 88 Q107 82 116 88 Q107 94 98 88 Z" />
  <path class="dv-draw-fine" d="M128 88 Q137 82 146 88 Q137 94 128 88 Z" />
  <circle class="dv-draw-fill" cx="107" cy="88" r="2.6" />
  <circle class="dv-draw-fill" cx="137" cy="88" r="2.6" />
  <!-- nose + mouth -->
  <path class="dv-draw-fill" d="M118 100 L126 100 L122 106 Z" />
  <path class="dv-draw-fine" d="M122 106 C119 110 115 110 113 107" />
  <path class="dv-draw-fine" d="M122 106 C125 110 129 110 131 107" />
  <!-- whiskers -->
  <path class="dv-draw-fine" d="M96 98 C82 96 72 92 64 86" />
  <path class="dv-draw-fine" d="M97 104 C83 104 73 104 64 106" />
  <path class="dv-draw-fine" d="M148 98 C162 96 172 92 180 86" />
  <path class="dv-draw-fine" d="M147 104 C161 104 171 104 180 106" />
  <!-- chest fluff -->
  <path class="dv-draw-fine" d="M116 132 L119 138 L122 132 L125 138 L128 132" />
  <!-- front legs + paws -->
  <path class="dv-draw-stroke" d="M111 152 C109 176 109 196 111 210" />
  <path class="dv-draw-stroke" d="M133 152 C135 176 135 196 133 210" />
  <path class="dv-draw-stroke" d="M96 209 C96 217 120 217 120 209" />
  <path class="dv-draw-stroke" d="M124 209 C124 217 148 217 148 209" />
  <!-- tail curl -->
  <g class="dv-cat-tail">
    <path class="dv-draw-stroke" d="M154 206 C178 210 192 198 188 180 C185 168 174 164 167 170" />
    <path class="dv-draw-fine" d="M176 176 L186 172 M172 186 L182 184" />
  </g>
  <!-- ground -->
  <path class="dv-draw-ground" d="M58 228 Q120 236 186 228" />
</svg>
