---
/** Hero scene: the trio on the wave from the clinic's window film, the
 *  Mournes behind, a little Newcastle sky. Decorative and aria-hidden — the
 *  hero copy carries the meaning. Motion lives in styles.css under
 *  `.dv-scene`; with reduced motion the settled frame is what renders. */
import DvTrioParts from "./DvTrioParts.astro";
---

<svg class="dv-scene" viewBox="0 0 640 460" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMax meet">
  <defs>
    <linearGradient id="dv-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--dv-sky-top)" />
      <stop offset="1" stop-color="var(--dv-sky-low)" />
    </linearGradient>
    <clipPath id="dv-scene-frame"><rect width="640" height="460" rx="16" /></clipPath>
  </defs>
  <g clip-path="url(#dv-scene-frame)">
  <rect class="dv-scene-sky" width="640" height="460" fill="url(#dv-sky)" />
  <!-- the Mournes: far range, then Slieve Donard's shoulder nearer -->
  <path d="M0 300 C50 270 90 236 136 214 C160 228 176 234 196 226 C236 206 270 172 306 160 C336 186 360 200 392 196 C430 192 470 214 520 236 C560 252 600 262 640 268 V460 H0 Z" fill="var(--dv-hill-far)" />
  <path d="M0 344 C70 318 120 292 176 284 C220 280 250 296 290 292 C350 286 420 262 480 268 C540 274 590 300 640 312 V460 H0 Z" fill="var(--dv-hill-near)" />

  <!-- the window-film wave the pets sit on -->
  <path d="M0 410 C40 398 80 394 118 394 L548 394 C584 394 612 384 640 370 V460 H0 Z" fill="var(--dv-teal)" />
  <path d="M0 410 C40 398 80 394 118 394 L548 394 C584 394 612 384 640 370" fill="none" stroke="#fff" stroke-width="4" />
  <path d="M0 440 C120 424 260 424 380 432 C470 438 560 432 640 418 V460 H0 Z" fill="var(--dv-teal-d)" opacity=".55" />

  <g transform="translate(96 67) scale(1.88)">
    <g class="dv-scene-pet dv-scene-pet--dog"><DvTrioParts part="dog" /></g>
    <g class="dv-scene-pet dv-scene-pet--cat"><DvTrioParts part="cat" /></g>
    <g class="dv-scene-pet dv-scene-pet--rabbit"><DvTrioParts part="rabbit" /></g>
  </g>
  </g>
</svg>
