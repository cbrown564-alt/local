---
/**
 * Hero visual: ambient transformation from the practice's 2D silhouette
 * mark into living companions inside Donard Veterinary Clinic.
 * Decorative and aria-hidden; reduced-motion settles on the living photo.
 */
---

<div class="dv-hero-visual" aria-hidden="true">
  <picture>
    <source
      srcset="/media/concepts/donard-veterinary/donard-veterinary-hero-1265.webp 1265w, /media/concepts/donard-veterinary/donard-veterinary-hero-640.webp 640w"
      sizes="(max-width: 720px) 100vw, 640px"
      type="image/webp"
    />
    <img
      src="/media/concepts/donard-veterinary/donard-veterinary-hero.jpg"
      alt=""
      width="1200"
      height="896"
      loading="eager"
      decoding="async"
    />
  </picture>
  <video
    class="dv-hero-video"
    muted
    playsinline
    preload="metadata"
    poster="/media/concepts/donard-veterinary/donard-veterinary-hero.jpg"
    aria-hidden="true"
  >
    <source src="/media/concepts/donard-veterinary/donard-veterinary-hero.webm" type="video/webm" />
    <source src="/media/concepts/donard-veterinary/donard-veterinary-hero.mp4" type="video/mp4" />
  </video>
</div>

<script>
  const video = document.querySelector<HTMLVideoElement>(".dv-hero-video");
  if (video) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let completedPlays = 0;
    const settle = () => {
      video.pause();
      video.hidden = true;
    };
    const play = () => {
      void video.play().catch(settle);
    };

    video.addEventListener("ended", () => {
      completedPlays += 1;
      if (completedPlays >= 2) {
        settle();
      } else {
        video.currentTime = 0;
        play();
      }
    });
    video.addEventListener("error", settle);
    reducedMotion.addEventListener("change", (event) => {
      if (event.matches) settle();
    });

    if (reducedMotion.matches) settle();
    else play();
  }
</script>
