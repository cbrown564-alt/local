---
/** The drawn cast — dog, cat and small pet as hand-authored line
 *  illustrations in the concept palette. Honesty that they are drawings
 *  lives in the ConceptLayout bannerNote, not here. */
import DvDog from "./cast/DvDog.astro";
import DvCat from "./cast/DvCat.astro";
import DvRabbit from "./cast/DvRabbit.astro";
---

<figure class="dv-pets" aria-label="Pets we care for">
  <div class="dv-pets-row" role="list">
    <div class="dv-pet" role="listitem">
      <DvDog label="Dog" />
      <span class="dv-pet-label">Dog</span>
    </div>
    <div class="dv-pet" role="listitem">
      <DvCat label="Cat" />
      <span class="dv-pet-label">Cat</span>
    </div>
    <div class="dv-pet" role="listitem">
      <DvRabbit label="Small pet" />
      <span class="dv-pet-label">Small pet</span>
    </div>
  </div>
</figure>
