---
/** The drawn cast — dog, cat and small pet as hand-authored line
 *  illustrations in the concept palette.
 *
 *  Not photoreal: warm studio drawings, obviously commissioned, disclosed as
 *  drawings. The appointment form's species select (Dog / Cat / Small pet /
 *  Other) sets the cast. The same three components are reused across the
 *  concept — hero, life arc — so the page has one drawn language. */
import DvDog from "./cast/DvDog.astro";
import DvCat from "./cast/DvCat.astro";
import DvRabbit from "./cast/DvRabbit.astro";
---

<figure class="dv-pets" aria-labelledby="dv-pets-heading">
  <figcaption class="dv-pets-disclosure" id="dv-pets-heading">
  Illustrated pets · studio drawings, not photographs of patients
  </figcaption>
  <div class="dv-pets-row" role="list">
    <div class="dv-pet" role="listitem">
      <DvDog />
      <span class="dv-pet-label">Dog</span>
    </div>
    <div class="dv-pet" role="listitem">
      <DvCat />
      <span class="dv-pet-label">Cat</span>
    </div>
    <div class="dv-pet" role="listitem">
      <DvRabbit />
      <span class="dv-pet-label">Small pet</span>
    </div>
  </div>
</figure>
