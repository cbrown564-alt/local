---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import DvPetIllustrations from "./components/DvPetIllustrations.astro";
import DvSafetyNet from "./components/DvSafetyNet.astro";
import DvCatchmentMap from "./components/DvCatchmentMap.astro";
import DvLifeArc from "./components/DvLifeArc.astro";
import {
  bereavementQuote,
  independenceTimeline,
  vidivetUrl,
} from "./content";
---

<ConceptLayout
  title={"Donard Veterinary Clinic — independent concept"}
  slug="donard-veterinary"
  bodyClass="concept-page concept-donard-veterinary"
  lang="en-GB"
  bannerNote="Pet illustrations are drawn, not photographs."
>
<div class="dv-strip">
      <span>Pet emergency? Call <a href="tel:+442843729414">028 4372 9414</a></span>
      <span class="dv-strip-hours">Mon–Fri 8:30am–6:30pm · Wed until 7pm · Sat 9am–1pm</span>
    </div>
    <header class="dv-header">
      <a class="dv-brand" href="/concepts/donard-veterinary/">
        <svg class="dv-badge" width="46" height="46" viewBox="0 0 46 46" fill="none" aria-hidden="true">
          <circle cx="23" cy="23" r="21.5" stroke="#2a6b8f" stroke-width="2.6" />
          <path d="M7 30 L16 17 L21 23 L28 13 L39 30" stroke="#2a6b8f" stroke-width="2.6" stroke-linejoin="round" fill="none" />
          <path d="M25.5 16.5 L28 13 L30.5 16.5" stroke="#2f9d82" stroke-width="2.6" stroke-linejoin="round" />
        </svg>
        <span class="dv-brand-text">
          <span class="dv-brand-name">Donard Veterinary Clinic</span>
          <span class="dv-brand-sub">Professional · Caring · Compassionate</span>
        </span>
      </a>
      <nav class="dv-nav" aria-label="Concept navigation">
        <a href="#life">Pet services</a><a href="#safety-net">Emergency</a><a href={vidivetUrl} rel="external">VidiVet</a><a href="#catchment">Catchment</a><a href="/concepts/donard-veterinary/appointments/">Appointments</a>
      </nav>
      <div class="dv-header-actions">
        <a class="dv-phone" href="tel:+442843729414">028 4372 9414</a>
        <a class="dv-book" href="/concepts/donard-veterinary/appointments/">Book an appointment</a>
      </div>
    </header>
    <main>
    <div class="dv-hero">
      <!-- the Mournes, drawn low and faint behind the story panel — the same
           range as the catchment map, here as backdrop, not information -->
      <svg class="dv-hero-hills" viewBox="0 0 1440 220" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        <path class="dv-hero-ridge" d="M-20 196 C60 152 112 122 162 96 C192 130 212 140 242 124 C292 88 332 60 382 44 C422 90 452 110 492 96 C542 66 582 52 632 48 C682 92 722 116 782 110 C832 104 872 118 912 136 C952 152 992 164 1030 168" />
        <path class="dv-hero-ridge-tick" d="M382 58 L382 78 M387 66 L394 77" />
        <path class="dv-hero-ridge-tick" d="M162 108 L162 128 M167 116 L173 126" />
        <path class="dv-hero-ridge-tick" d="M632 62 L632 82 M637 70 L643 80" />
        <path class="dv-hero-foot" d="M-20 210 C200 180 420 172 640 182 C760 188 860 194 960 200" />
      </svg>
      <section class="dv-story">
        <p class="dv-kicker">8 Railway Street · Newcastle</p>
        <h1>Donard Veterinary <em>Clinic</em></h1>
        <p class="dv-thesis">Make it easy to ask for help.</p>
        <p class="dv-lede">
          An independent small-animal clinic providing routine care, diagnostics,
          surgery and dental treatment — with a phone line that always finds a vet.
        </p>
        <DvPetIllustrations />
        <div class="dv-actions">
          <a class="dv-cta" href="/concepts/donard-veterinary/appointments/">Request an appointment</a>
          <a class="dv-link" href="/concepts/donard-veterinary/appointments/#emergency-heading">Emergency information →</a>
        </div>
      </section>
      <section class="dv-care-desk" aria-labelledby="dv-care-heading">
        <div class="dv-care-head">
          <p>How can we help?</p>
          <span>Small-animal clinic · Newcastle</span>
        </div>
        <div class="dv-care-body">
          <h2 id="dv-care-heading">Choose the right first step.</h2>
          <div class="dv-care-options">
            <a href="/concepts/donard-veterinary/appointments/">
              <span class="dv-care-icon" aria-hidden="true">+</span>
              <span><strong>Routine appointment</strong><small>Health checks, diagnostics, surgery, dental care and more.</small></span>
              <span aria-hidden="true">→</span>
            </a>
            <a href="tel:+442843729414">
              <span class="dv-care-icon dv-care-icon--urgent" aria-hidden="true">!</span>
              <span><strong>Urgent help</strong><small>Call the clinic directly if you are worried about your pet.</small></span>
              <span aria-hidden="true">→</span>
            </a>
            <a href={vidivetUrl} rel="external">
              <span class="dv-care-icon dv-care-icon--online" aria-hidden="true">V</span>
              <span><strong>VidiVet support</strong><small>Free 24/7 digital vet advice for clinic clients.</small></span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        <div class="dv-care-hours">
          <span><strong>Clinic hours</strong> Mon–Fri 8:30–6:30 · Wednesday until 7</span>
          <a href="tel:+442843729414">028 4372 9414</a>
        </div>
      </section>
      <nav class="dv-rail" aria-label="Pet services">
        <a class="dv-service" href="#life"><span></span>Routine health care</a>
        <a class="dv-service" href="#life"><span></span>Diagnostics</a>
        <a class="dv-service" href="#life"><span></span>Surgery</a>
        <a class="dv-service" href="#life"><span></span>Dental clinic</a>
        <a class="dv-service" href="#life"><span></span>Weight clinic</a>
        <a class="dv-service" href="#safety-net"><span></span>Emergency</a>
      </nav>
    </div>

    <DvSafetyNet />

    <figure class="dv-caption-quote">
      <blockquote cite={bereavementQuote.source}>
        “{bereavementQuote.text}”
      </blockquote>
      <figcaption>
        Donard Veterinary Clinic
        <span>
          <a href={bereavementQuote.source} rel="external">{bereavementQuote.context}</a>
        </span>
      </figcaption>
    </figure>

    <DvLifeArc />

    <section class="dv-map-section" id="catchment" aria-labelledby="dv-map-heading">
      <div class="dv-map-head">
        <p class="dv-kicker">Your local practice</p>
        <h2 class="dv-h2" id="dv-map-heading">Close to home — with a geography.</h2>
        <p class="dv-section-lede">
          Newcastle plus the eight villages the practice names on its own site —
          Castlewellan, Dundrum, Bryansford, Clough, Annalong, Kilcoo and Hilltown.
        </p>
      </div>
      <DvCatchmentMap headingId="dv-map-heading" />
    </section>

    <section class="dv-timeline-band" id="story" aria-labelledby="dv-timeline-heading">
      <div class="dv-timeline-head">
        <p class="dv-kicker">Still independent</p>
        <h2 class="dv-h2" id="dv-timeline-heading">Opened 2017. Nine years on, still theirs.</h2>
      </div>
      <ol class="dv-timeline" role="list">
        {independenceTimeline.map((entry) => (
          <li>
            <span class="dv-timeline-marker">{entry.marker}</span>
            <h3>{entry.title}</h3>
            <p>{entry.copy}</p>
            {"href" in entry && entry.href && (
              <a class="dv-timeline-link" href={entry.href} rel="external">
                July 2026 recruitment listing →
              </a>
            )}
          </li>
        ))}
      </ol>
    </section>
    </main>
</ConceptLayout>
