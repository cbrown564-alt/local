---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import DvChrome from "./components/DvChrome.astro";
import DonardRequestForm from "./components/DonardRequestForm.astro";
import {
  clinicPhone,
  clinicPhoneHref,
} from "./content";
---

<ConceptLayout
  title={"Request an appointment — Donard Veterinary Clinic"}
  slug="donard-veterinary"
  bodyClass="concept-page concept-donard-veterinary"
  lang="en-GB"
  bannerNote="Pet illustrations and the catchment map are drawn — not photographs or a boundary survey."
>
  <DvChrome current="appointments" />

  <main class="dv-appt-page">

      <div class="dv-appt-intro">
        <p class="dv-kicker">Routine appointments</p>
        <h1>Ask for a time.<br /><em>We'll call back.</em></h1>
        <p class="dv-appt-lede">
          Tell us a little about your pet and when suits. We'll ring to confirm
          an appointment — usually the same day we receive your request.
        </p>
      </div>

      <div class="dv-appt-layout">
        <section class="dv-appt-form-col" aria-labelledby="appt-form-heading">
          <DonardRequestForm id="request" headingId="appt-form-heading" />
        </section>

        <aside class="dv-appt-aside" aria-labelledby="appt-next-heading">
          <h2 class="dv-appt-aside-title" id="appt-next-heading">What happens next</h2>
          <ol class="dv-appt-steps" role="list">
            <li>
              <span class="dv-appt-step-num" aria-hidden="true">1</span>
              <div>
                <strong>Send the request</strong>
                <p>A short message with your details goes to the clinic.</p>
              </div>
            </li>
            <li>
              <span class="dv-appt-step-num" aria-hidden="true">2</span>
              <div>
                <strong>We call you back</strong>
                <p>A member of the team rings the number you gave to agree a time.</p>
              </div>
            </li>
            <li>
              <span class="dv-appt-step-num" aria-hidden="true">3</span>
              <div>
                <strong>Come in when it suits</strong>
                <p>Bring your pet to 8 Railway Street — or call us if plans change.</p>
              </div>
            </li>
          </ol>

          <div class="dv-appt-hours">
            <p class="dv-appt-hours-title">Clinic hours</p>
            <ul>
              <li><span>Mon, Tue, Thu, Fri</span><span>8:30am – 6:30pm</span></li>
              <li><span>Wednesday</span><span>8:30am – 7:00pm</span></li>
              <li><span>Saturday</span><span>9:00am – 1:00pm</span></li>
            </ul>
          </div>

          <p class="dv-appt-phone-pref">
            Prefer to book by phone?
            <a href={clinicPhoneHref}>{clinicPhone}</a>
          </p>
        </aside>
      </div>

      <section class="dv-appt-urgent" id="emergency-heading" aria-labelledby="emergency-title">
        <div class="dv-appt-urgent-copy">
          <p class="dv-appt-urgent-label">If you need urgent help</p>
          <h2 class="dv-appt-urgent-title" id="emergency-title">Call us — the same number, day or night.</h2>
          <p>
            Outside clinic hours you are diverted to the on-call vet. Our clients
            also have free 24/7 digital advice through VidiVet.
          </p>
        </div>
        <div class="dv-appt-urgent-actions">
          <a class="dv-cta dv-cta--compact" href={clinicPhoneHref}>{clinicPhone}</a>
          <a class="dv-link" href="/concepts/donard-veterinary/emergency/">Urgent help →</a>
          <a class="dv-link" href="/concepts/donard-veterinary/vidivet/">VidiVet support →</a>
        </div>
      </section>

  </main>
</ConceptLayout>
