---
import ChamberConceptShell from "../../prototypes/chamber-prototypes/ChamberConceptShell.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";
import { categories, members } from "../../site/data/chamber-prototype";

const base = "/concepts/newcastle-chamber";
const counts = Object.fromEntries(
  categories.map((cat) => [cat.id, members.filter((m) => m.category === cat.id).length]),
);
---
<ChamberConceptShell title="Newcastle Chamber of Commerce — independent concept" current="home">
  <main class="nc-hero">
    <section class="nc-story">
      <p class="nc-kicker">Directory · events · a voice for local trade</p>
      <h1>Newcastle Chamber <em>of Commerce</em></h1>
      <p class="nc-thesis">Find a business in town.</p>
      <p class="nc-lede">
        The volunteer-run hub for traders in Newcastle, Co. Down — with a
        useful directory, the town calendar and a clear door to join.
      </p>
      <form class="nc-search" action={`${base}/members/`} method="get" role="search">
        <label class="visually-hidden" for="nc-q">Search the business directory</label>
        {/* Every example in the placeholder returns at least one listing;
            "chemist" previously returned zero. */}
        <input id="nc-q" type="search" name="q" placeholder="Hotel, vet, bikes…" />
        <button type="submit">Search</button>
      </form>
      <p class="nc-prototype-note">
        These listings are real Newcastle businesses. The Chamber has not
        confirmed them as members.
      </p>
      <div class="nc-actions">
        <a class="nc-cta" href={`${base}/members/`}>Browse the directory</a>
        <a class="nc-link" href={`${base}/join/`}>List your business →</a>
      </div>
    </section>
    <figure class="nc-panel">
      <div class="nc-visual-image">
        <ResponsiveImage
          pictureClass="nc-visual-picture"
          src="/media/place/central-promenade.jpg"
          alt="Newcastle Central Promenade with the Mourne Mountains rising behind the town"
          width="1024"
          height="768"
          loading="eager"
          sizes="(max-width: 940px) 100vw, 44vw"
        />
      </div>
      <figcaption>
        Newcastle Central Promenade · Eric Jones, 2012 · CC BY-SA 2.0
      </figcaption>
    </figure>
    <nav class="nc-rail" aria-label="Browse by trade">
      {categories.map((cat) => (
        <a class="nc-rail-cell" href={`${base}/members/?cat=${cat.id}`}>
          <span class="nc-rail-label">{cat.shortLabel}</span>
          <span class="nc-rail-note">{counts[cat.id]} listings</span>
        </a>
      ))}
    </nav>
  </main>
</ChamberConceptShell>
