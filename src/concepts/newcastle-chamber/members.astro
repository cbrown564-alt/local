---
import ChamberConceptShell from "../../prototypes/chamber-prototypes/ChamberConceptShell.astro";
import { chamber, categories, members } from "../../site/data/chamber-prototype";

const base = "/concepts/newcastle-chamber";
---
<ChamberConceptShell
  title="Member Directory — Newcastle Chamber of Commerce · Co. Down"
  current="members"
>
  <main class="nc-dir" id="main">
    <div class="nc-dir-head">
      <div class="nc-dir-head-text">
        <p class="nc-kicker">Business directory · Newcastle</p>
        <h1>Newcastle traders, <em>in one place.</em></h1>
        <p class="nc-dir-intro">
          These are real Newcastle businesses from public listings. The Chamber
          has not confirmed them as members. <a href={`${base}/join/`}>Ask to be
          listed</a>, or <a href={chamber.emailHref}>email the Chamber</a>.
        </p>
        <form class="nc-dir-search" action={`${base}/members/`} method="get" role="search">
          <label class="visually-hidden" for="nc-dir-q">Search the directory</label>
          <input id="nc-dir-q" type="search" name="q" placeholder="Hotel, vet, bikes…" data-nc-search-input />
          <button type="submit">Search</button>
        </form>
        <p class="nc-dir-search-status" data-nc-search-status role="status" hidden></p>
      </div>
      <nav class="nc-dir-tabs" aria-label="Filter by category">
        <a class="nc-dir-tab" data-nc-tab="all" href={`${base}/members/`}>All</a>
        {categories.map((cat) => (
          <a class="nc-dir-tab" data-nc-tab={cat.id} href={`${base}/members/?cat=${cat.id}`}>
            <span class="nc-tab-full">{cat.label}</span>
            <span class="nc-tab-short">{cat.shortLabel}</span>
          </a>
        ))}
      </nav>
    </div>

    <div class="nc-dir-body" id="all">
      {categories.map((cat) => (
        <section class="nc-dir-category" id={cat.id} data-nc-category={cat.id}>
          <h2 class="nc-dir-cat-label">{cat.label}</h2>
          {/* Repeated per section so a deep link or a filtered view always
              lands with the membership disclaimer in view, not hundreds of
              pixels above it. */}
          <p class="nc-dir-cat-note">
            Listed from dated public sources · not a verified membership list
          </p>
          <ul class="nc-dir-grid" role="list">
            {members.filter((m) => m.category === cat.id).map((member) => (
              <li
                class="nc-dir-card"
                data-nc-member
                data-search-text={`${member.name} ${member.trade} ${member.note} ${member.name === "Mourne Cycles" ? "bikes cycling cycles" : ""}`.toLowerCase()}
              >
                <p class="nc-dir-card-name">{member.name}</p>
                <p class="nc-dir-card-trade">{member.trade}</p>
                <p class="nc-dir-card-note">{member.note}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p class="nc-dir-empty" data-nc-empty hidden>
        No listing matches that search. Try a trade such as hotel, vet, bikes,
        gifts or dental — or <a href={`${base}/members/`}>show every listing</a>.
      </p>
    </div>

    <div class="nc-dir-join">
      <div class="nc-dir-join-inner">
        <p class="nc-dir-join-kicker">Not listed yet?</p>
        <h2>Join the Chamber and <em>get your business found.</em></h2>
        <p>Write to the volunteer inbox and the committee will be in touch.</p>
        <div class="nc-actions">
          <a class="nc-cta" href={`${base}/join/`}>Why join</a>
          <a class="nc-link" href={chamber.facebook}>Follow on Facebook →</a>
        </div>
      </div>
    </div>
  </main>
</ChamberConceptShell>

<script>
  const params = new URLSearchParams(window.location.search);
  const query = params.get("q")?.trim() ?? "";
  const category = params.get("cat")?.trim() ?? "";
  const normalised = query.toLocaleLowerCase("en-GB");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-nc-member]")];
  const sections = [...document.querySelectorAll<HTMLElement>("[data-nc-category]")];
  const status = document.querySelector<HTMLElement>("[data-nc-search-status]");
  const empty = document.querySelector<HTMLElement>("[data-nc-empty]");
  const input = document.querySelector<HTMLInputElement>("[data-nc-search-input]");

  // The active tab is derived from the URL rather than hard-coded, so "All"
  // cannot keep its active styling while a query or category filter is on.
  const activeTab = document.querySelector<HTMLElement>(
    `[data-nc-tab="${category || "all"}"]`,
  );
  activeTab?.classList.add("nc-dir-tab--active");
  activeTab?.setAttribute("aria-current", "true");

  if (input && query) input.value = query;

  if (normalised || category) {
    let visibleCount = 0;
    for (const card of cards) {
      const section = card.closest<HTMLElement>("[data-nc-category]");
      const inCategory = !category || section?.dataset.ncCategory === category;
      const matchesQuery = !normalised || (card.dataset.searchText?.includes(normalised) ?? false);
      const matches = inCategory && matchesQuery;
      card.hidden = !matches;
      if (matches) visibleCount += 1;
    }
    for (const section of sections) {
      section.hidden = !section.querySelector("[data-nc-member]:not([hidden])");
    }
    if (status) {
      const categoryLabel = category
        ? document.querySelector<HTMLElement>(`[data-nc-category="${category}"] .nc-dir-cat-label`)?.textContent?.trim()
        : "";
      const scope = query && categoryLabel
        ? ` for “${query}” in ${categoryLabel}`
        : query
          ? ` for “${query}”`
          : categoryLabel
            ? ` in ${categoryLabel}`
            : "";
      status.hidden = false;
      status.textContent = `${visibleCount} ${visibleCount === 1 ? "listing" : "listings"}${scope}. Listed from public sources, not verified members.`;
    }
    if (empty) empty.hidden = visibleCount !== 0;
  }
</script>
