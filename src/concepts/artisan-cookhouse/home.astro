---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import "./styles.css";

/* The Artisan Cookhouse: 4 Kildare Street, Strangford, Downpatrick BT30 7LJ.
   Verified live 27 Nov 2026: artisancookhouse.com duplicates its header navigation
   (Dine / Reserve a Table / Menus / Stay / Book A Room / Experiences / Gift Vouchers / Contact) twice.
   Contacts: 028 4488 1654, https://www.artisancookhouse.com/. */
const phone = "028 4488 1654";
const phoneHref = "tel:+442844881654";
const siteHref = "https://www.artisancookhouse.com/";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=The+Artisan+Cookhouse+4+Kildare+Street+Strangford+BT30+7LJ";

const cookhouseTabs = [
  {
    id: "dining",
    label: "Dining",
    summary: "Candlelit evening plates built around Strangford Lough seafood and County Down farms.",
    rows: [
      {
        title: "Strangford Lough and County Down larder",
        detail: "Thoughtfully cooked seasonal menus featuring local coastal fish, artisan sourdough and regional growers.",
        meta: "Seasonal menus",
      },
      {
        title: "Intimate Kildare Street dining room",
        detail: "Relaxed village hospitality steps from Strangford harbour and the Portaferry ferry terminal.",
        meta: "Evening service",
      },
      {
        title: "Direct table reservations",
        detail: "Book evening tables online at artisancookhouse.com or speak with the dining room directly.",
        meta: phone,
      },
    ],
    ctaLabel: "Reserve a table online",
  },
  {
    id: "rooms",
    label: "Rooms",
    summary: "Calm, beautifully finished village bedrooms upstairs for unhurried Strangford breaks.",
    rows: [
      {
        title: "Boutique overnight bedrooms",
        detail: "Quiet guest rooms on Kildare Street finished in natural linen, timber and soft coastal tones.",
        meta: "Overnight stays",
      },
      {
        title: "Steps from the harbour and ferry",
        detail: "Arrive across Strangford Narrows from Portaferry or travel south from Belfast for the weekend.",
        meta: "Strangford village",
      },
      {
        title: "Morning walks at Castle Ward",
        detail: "Wake rested four minutes from Castle Ward demesne, coastal paths and Strangford Lough shore.",
        meta: "4 mins west",
      },
    ],
    ctaLabel: "Check room availability",
  },
  {
    id: "vouchers",
    label: "Vouchers",
    summary: "Food-led coastal experiences and gift vouchers redeemable across dining and stays.",
    rows: [
      {
        title: "Dining and stay gift vouchers",
        detail: "Redeemable toward evening dining in the cookhouse or boutique overnight stays on Kildare Street.",
        meta: "Order online",
      },
      {
        title: "Culinary coastal experiences",
        detail: "Unhurried food-led Strangford weekends designed for birthdays, anniversaries and seasonal breaks.",
        meta: "Experiences",
      },
      {
        title: "Personal assistance from the team",
        detail: "Arrange a bespoke voucher value online at artisancookhouse.com or by calling the house directly.",
        meta: phone,
      },
    ],
    ctaLabel: "Order gift vouchers",
  },
];

const cookhouseGroups = [
  {
    id: "dine",
    label: "Bistro dining and seasonal menus",
    items: [
      {
        name: "Strangford Lough and County Down produce",
        note: "Thoughtfully cooked evening plates showcasing coastal fish, local farms and seasonal menus.",
        meta: "Reserve online",
      },
      {
        name: "Intimate Kildare Street dining room",
        note: "Relaxed candlelit village hospitality just steps from Strangford harbour.",
        meta: "Call 028 4488 1654",
      },
    ],
  },
  {
    id: "stay",
    label: "Stay, experiences and vouchers",
    items: [
      {
        name: "Boutique overnight rooms",
        note: "Calm, beautifully finished village bedrooms on Kildare Street for unhurried Strangford breaks.",
        meta: "Book a room",
      },
      {
        name: "Culinary experiences and gift vouchers",
        note: "Food-led coastal breaks and gift vouchers redeemable across dining and overnight stays.",
        meta: "Order online",
      },
    ],
  },
];
---

<ConceptLayout
  title="The Artisan Cookhouse: Bistro Dining, Rooms and Experiences, Strangford"
  slug="artisan-cookhouse"
  bodyClass="concept-page concept-artisancookhouse"
  businessName="The Artisan Cookhouse"
  town="Strangford"
  bannerNote="Imagery comprises indicative Strangford village bistro dining and coastal bedroom visualisations."
>
  <header class="ac-header" data-ac-header>
    <div class="ac-header-inner">
      <a class="ac-brand" href="#top">The Artisan Cookhouse</a>

      <nav class="ac-nav" aria-label="Primary">
        <a class="ac-nav-link" href="#house" data-ac-nav-tab="dining">Dining</a>
        <a class="ac-nav-link" href="#house" data-ac-nav-tab="rooms">Rooms</a>
        <a class="ac-nav-link" href="#house" data-ac-nav-tab="vouchers">Vouchers</a>
        <a class="ac-nav-link" href="#enquire">Enquire</a>
        <a class="ac-nav-link" href="#location">Strangford</a>
      </nav>

      <div class="ac-header-actions">
        <a class="ac-header-tel" href={phoneHref}>{phone}</a>
        <a class="ac-header-cta" href={siteHref} target="_blank" rel="noopener noreferrer">Reserve</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="ac-hero" aria-labelledby="ac-hero-title">
      <div class="ac-hero-sentinel" aria-hidden="true" data-ac-sentinel></div>
      <div class="ac-hero-media">
        <picture>
          <source
            srcset="/media/concepts/artisan-cookhouse/artisan-cookhouse-dining-640.webp 640w, /media/concepts/artisan-cookhouse/artisan-cookhouse-dining-1265.webp 1265w"
            sizes="100vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/artisan-cookhouse/artisan-cookhouse-dining.jpg"
            alt="Candlelit Strangford village bistro table with pan-seared local sea bass, sourdough and crisp white wine beside a twilight harbour window"
            width="1408"
            height="768"
            loading="eager"
          />
        </picture>
        <div class="ac-hero-scrim" aria-hidden="true"></div>
      </div>

      <div class="ac-wrap ac-hero-stage">
        <div class="ac-hero-horizon">
          <div class="ac-hero-title-col">
            <h1 id="ac-hero-title" class="ac-reveal ac-reveal-1">
              Coastal dining and village rooms.
            </h1>
          </div>

          <div class="ac-hero-action-col ac-reveal ac-reveal-2">
            <p class="ac-hero-lead">
              Set on Kildare Street beside the Strangford ferry, serving seasonal County Down plates with calm overnight rooms.
            </p>
            <a class="ac-primary-btn" href="#enquire">Reserve a table or room</a>
          </div>
        </div>

        <div class="ac-hero-foot ac-reveal ac-reveal-3">
          <p class="ac-hero-caption">Indicative Strangford village bistro dining visualisation.</p>
        </div>
      </div>
    </section>

    <section class="ac-section ac-house" id="house" aria-labelledby="ac-house-title">
      <div class="ac-wrap ac-house-grid">
        <div class="ac-house-main" data-ac-tabs>
          <h2 id="ac-house-title">Evening tables, calm bedrooms and coastal vouchers.</h2>

          <div class="ac-tabs" role="tablist" aria-label="Dining, rooms and vouchers">
            {cookhouseTabs.map((tab, idx) => (
              <button
                type="button"
                role="tab"
                id={`ac-tab-${tab.id}`}
                aria-controls={`ac-panel-${tab.id}`}
                aria-selected={idx === 0 ? "true" : "false"}
                class:list={["ac-tab", idx === 0 && "is-active"]}
                data-ac-tab={tab.id}
              >
                {tab.label}
              </button>
            ))}
          </div>

          {cookhouseTabs.map((tab, idx) => (
            <div
              class="ac-panel"
              role="tabpanel"
              id={`ac-panel-${tab.id}`}
              aria-labelledby={`ac-tab-${tab.id}`}
              data-ac-panel={tab.id}
              hidden={idx !== 0}
            >
              <p class="ac-panel-summary">{tab.summary}</p>
              <dl class="ac-ledger">
                {tab.rows.map((row) => (
                  <div class="ac-ledger-row">
                    <dt>{row.title}</dt>
                    <dd>
                      <span class="ac-ledger-detail">{row.detail}</span>
                      <span class="ac-ledger-meta">{row.meta}</span>
                    </dd>
                  </div>
                ))}
              </dl>
              <div class="ac-panel-foot">
                <a class="ac-dark-btn" href={siteHref} target="_blank" rel="noopener noreferrer">
                  {tab.ctaLabel}
                </a>
              </div>
            </div>
          ))}

          <div class="ac-sheet-row">
            <SpecimenSheet
              id="ac-guide-sheet"
              triggerLabel="Open full dining, rooms and vouchers guide"
              kicker="The Artisan Cookhouse, 4 Kildare Street, Strangford"
              title="Dining, rooms and gift vouchers"
              subtitle="Reserve tables, rooms or gift vouchers online at artisancookhouse.com or call 028 4488 1654."
              groups={cookhouseGroups}
              ctaLabel="Visit official booking"
              ctaHref={siteHref}
              ctaExternal={true}
              secondaryLabel={`Call ${phone}`}
              secondaryHref={phoneHref}
              buttonClass="ac-sheet-link"
            />
          </div>
        </div>

        <div class="ac-house-visual">
          <figure class="ac-plate">
            <picture>
              <source
                srcset="/media/concepts/artisan-cookhouse/artisan-cookhouse-room-640.webp 640w, /media/concepts/artisan-cookhouse/artisan-cookhouse-room-1265.webp 1265w"
                sizes="(max-width: 900px) 100vw, 44vw"
                type="image/webp"
              />
              <img
                src="/media/concepts/artisan-cookhouse/artisan-cookhouse-room.jpg"
                alt="Serene coastal village guest bedroom with crisp white cotton linens, slate-blue wool throw and bright morning sash window"
                width="1408"
                height="768"
                loading="lazy"
              />
            </picture>
            <figcaption>Indicative Kildare Street guest bedroom visualisation.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="ac-section ac-enquire" id="enquire" aria-labelledby="ac-enquire-title">
      <div class="ac-wrap ac-enquire-grid">
        <div class="ac-enquire-info">
          <h2 id="ac-enquire-title">Plan an evening table or overnight stay in Strangford.</h2>
          <p class="ac-enquire-copy">
            Whether you are crossing from Portaferry on the lough ferry or travelling south from Belfast for the weekend, prepare an enquiry below or reserve online directly.
          </p>

          <dl class="ac-contact-ledger">
            <div>
              <dt>Telephone</dt>
              <dd><a href={phoneHref}>{phone}</a></dd>
            </div>
            <div>
              <dt>Address</dt>
              <dd>4 Kildare Street, Strangford, Downpatrick, BT30 7LJ</dd>
            </div>
            <div>
              <dt>Online booking</dt>
              <dd><a href={siteHref} target="_blank" rel="noopener noreferrer">artisancookhouse.com</a></dd>
            </div>
          </dl>
        </div>

        <form class="ac-form" data-ac-form novalidate>
          <div class="ac-form-row">
            <label class="ac-field">
              <span>Your name</span>
              <input type="text" name="name" required autocomplete="name" placeholder="Claire Reid" />
            </label>
            <label class="ac-field">
              <span>Telephone</span>
              <input type="tel" name="phone" required autocomplete="tel" placeholder="028 4488 0000" />
            </label>
          </div>

          <div class="ac-form-row">
            <label class="ac-field">
              <span>Enquiry type</span>
              <select name="requestType">
                <option value="Evening dining table">Evening dining table</option>
                <option value="Overnight village room">Overnight village room</option>
                <option value="Dining and overnight stay">Dining and overnight stay</option>
                <option value="Culinary experience or gift voucher">Culinary experience or gift voucher</option>
              </select>
            </label>
            <label class="ac-field">
              <span>Preferred date</span>
              <input type="date" name="date" />
            </label>
          </div>

          <div class="ac-form-row">
            <label class="ac-field">
              <span>Guests</span>
              <input type="number" name="guests" min="1" max="12" value="2" />
            </label>
            <label class="ac-field">
              <span>Dietary notes or stay details</span>
              <input type="text" name="notes" placeholder="Window table, ferry arrival, voucher value" />
            </label>
          </div>

          <div class="ac-form-foot">
            <button type="submit" class="ac-primary-btn">Prepare reservation enquiry</button>
            <p class="ac-form-status" role="status" aria-live="polite" data-ac-status></p>
          </div>
        </form>
      </div>
    </section>

    <section class="ac-section ac-map-band" id="location" aria-label="Strangford Kildare Street map">
      <div class="ac-wrap">
        <LocalAreaMap
          id="ac-map"
          kicker=""
          businessName="Artisan Cookhouse"
          address="4 Kildare Street, Strangford, Downpatrick, BT30 7LJ"
          lon={-5.5570}
          lat={54.3703}
          spanKm={16}
          showFerry={true}
          mapHref={mapsHref}
          markers={[
            { name: "Castle Ward", lon: -5.5811, lat: 54.3735, note: "4 mins west", side: "l" },
            { name: "Downpatrick", lon: -5.7168, lat: 54.3286, note: "15 mins west", side: "l" },
            { name: "Ardglass", lon: -5.6085, lat: 54.2613, note: "14 mins south", side: "b" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="ac-footer">
    <div class="ac-wrap ac-footer-inner">
      <div>
        <strong class="ac-footer-brand">The Artisan Cookhouse</strong>
        <p class="ac-footer-addr">4 Kildare Street, Strangford, Downpatrick, Co. Down, BT30 7LJ</p>
      </div>
      <div class="ac-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={siteHref} target="_blank" rel="noopener noreferrer">Reserve and vouchers</a>
        <a href={mapsHref} target="_blank" rel="noopener noreferrer">Directions</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-ac-header]");
      const sentinel = document.querySelector("[data-ac-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            const entry = entries[0];
            if (!entry) return;
            header.classList.toggle("is-scrolled", !entry.isIntersecting && entry.boundingClientRect.top < 0);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      const tabsRoot = document.querySelector("[data-ac-tabs]");
      const tabs = tabsRoot ? [...tabsRoot.querySelectorAll("[data-ac-tab]")] : [];
      const panels = tabsRoot ? [...tabsRoot.querySelectorAll("[data-ac-panel]")] : [];
      const activateTab = (id) => {
        if (!id || !tabs.length) return;
        tabs.forEach((t) => {
          const active = t.getAttribute("data-ac-tab") === id;
          t.classList.toggle("is-active", active);
          t.setAttribute("aria-selected", active ? "true" : "false");
        });
        panels.forEach((p) => {
          p.hidden = p.getAttribute("data-ac-panel") !== id;
        });
      };

      tabs.forEach((btn) => {
        btn.addEventListener("click", () => activateTab(btn.getAttribute("data-ac-tab")));
      });

      document.querySelectorAll("[data-ac-nav-tab]").forEach((link) => {
        link.addEventListener("click", () => {
          const id = link.getAttribute("data-ac-nav-tab");
          activateTab(id);
        });
      });

      const form = document.querySelector("[data-ac-form]");
      const statusEl = document.querySelector("[data-ac-status]");
      if (form) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;
          const fd = new FormData(form);
          const requestType = String(fd.get("requestType") || "Reservation");
          const name = String(fd.get("name") || "").trim();
          const subject = `${requestType} enquiry: ${name}`;
          const body = [
            `Guest: ${name}`,
            `Telephone: ${fd.get("phone") || ""}`,
            `Enquiry: ${requestType}`,
            `Preferred date: ${fd.get("date") || "Flexible"}`,
            `Party size: ${fd.get("guests") || "2"}`,
            `Notes: ${fd.get("notes") || "None"}`,
          ].join("\n");

          const ev = new CustomEvent("mm:enquiry", {
            cancelable: true,
            detail: {
              to: "The Artisan Cookhouse (028 4488 1654)",
              subject,
              body,
              url: "https://www.artisancookhouse.com/",
            },
          });
          const notHandled = window.dispatchEvent(ev);
          if (notHandled && statusEl) {
            statusEl.textContent = "Enquiry prepared. Complete booking at artisancookhouse.com or call 028 4488 1654.";
          }
        });
      }
    })();
  </script>
</ConceptLayout>
