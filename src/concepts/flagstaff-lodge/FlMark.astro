---
interface Props {
  size?: number;
  tone?: "gold" | "pine" | "cream";
}
const { size = 40, tone = "gold" } = Astro.props;
const stroke = tone === "pine" ? "#1c3429" : tone === "cream" ? "#f7f2e4" : "#c89b4b";
---
<svg
  class="fl-mark"
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  aria-hidden="true"
>
  <rect x="3" y="3" width="42" height="42" rx="4" stroke={stroke} stroke-width="1.5" />
  <path d="M16 36V12" stroke={stroke} stroke-width="2" stroke-linecap="round" />
  <path d="M16 13.5L32 18L16 23.5" stroke={stroke} stroke-width="1.8" stroke-linejoin="round" fill="none" />
  <path d="M10 34C17 28.5 23 26.5 29 29.5C33 31.5 36 30.5 38.5 28.5" stroke={stroke} stroke-width="1.5" stroke-linecap="round" />
</svg>
