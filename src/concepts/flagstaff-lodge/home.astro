---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import FlEventPlanner from "./FlEventPlanner.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";
import FlMark from "./FlMark.astro";

/* Flagstaff Lodge — 11 Forkhill Road, Cloughoge, Newry BT35 8LZ.
   Formerly known as "The Newry Golf Inn".
   Facts sourced from flagstafflodgenewry.com (read 26 Nov 2026) and FSA FHRS
   register (Authority 145, inspected 2025-07-17):
   - 18 purpose-built en-suite rooms (opened February 2016): Executive Suites,
     Family Rooms, Classic Double, Classic Triple, Classic Twin, Single Room.
   - Room booking engine: NetAffinity (FLAGSTAFIBE01, bookings.html).
   - Dining hours: Mon–Thu from 4:00pm–8:30pm, Fri–Sat from 12 noon,
     Sunday Carvery 11:30am–3:30pm (dine in or takeaway, no booking needed),
     Sunday Evening Bistro from 4:30pm, Residents' breakfast 7:30am–10:00am.
   - Lounge Bar: live music Saturday evenings, major sporting events.
   - Weddings: licensed Civil Wedding venue, turnkey Inclusive Packages,
     Bridal Suite, Banqueting Suite.
   - Meetings: Boardroom for up to 25–30 delegates, Daily Delegate Rates.
   - Parking & access: 124 free spaces on site, wheelchair-friendly ramps at
     the restaurant entrance.
   - Distances: 1.7 mi Newry Cathedral, 2.8 mi Ashfield Golf Club,
     4.5 mi Slieve Gullion, 10.3 mi Carlingford, 35.7 mi Belfast International,
     50.2 mi Dublin Airport.
   Brief: research/concepts/flagstaff-lodge/flagstaff-lodge-elevation-brief.md */

const phone = "028 3026 3871";
const phoneIntl = "+44 28 3026 3871";
const phoneHref = "tel:+442830263871";
const email = "info@flagstafflodgenewry.com";
const facebook = "https://www.facebook.com/flagstafflodgeNewry";
const bookingBase = "https://www.flagstafflodgenewry.com/bookings.html";
const mapHref = "https://www.google.com/maps/search/?api=1&query=54.150892,-6.350870";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap";

const rooms = [
  {
    name: "Executive Suites",
    beds: "Super king bed",
    note: "Spacious guest suite with en-suite wet room, warming towel rails and a large desk area.",
  },
  {
    name: "Family Rooms",
    beds: "Super king + two singles",
    note: "Generous layout for families travelling together. Baby cots provided free of charge on request.",
  },
  {
    name: "Classic Double",
    beds: "Super king bed",
    note: "En-suite bathroom with warming towel rails, large desk and separate seating area.",
  },
  {
    name: "Classic Triple",
    beds: "Three-guest setup",
    note: "Finished to the same modern standard as the rest of our 18-room lodge.",
  },
  {
    name: "Classic Twin",
    beds: "Twin beds",
    note: "Ideal for friends, golfers and corporate colleagues stopping off the A1/M1.",
  },
  {
    name: "Single Room",
    beds: "Single occupancy",
    note: "Quiet, comfortable overnight base midway between Belfast and Dublin.",
  },
];

const roomStandards = [
  "En-suite with warming towel rails",
  "Complimentary high-speed Wi-Fi",
  "Flat-screen TV with Freeview",
  "Large desk area",
  "Tea & coffee facilities",
  "Complimentary mineral water",
  "Individually controlled heating",
  "Hairdryer",
];

const diningTimes = [
  { label: "Residents' Breakfast", time: "7:30am – 10:00am", note: "Advance booking welcome for non-resident parties." },
  { label: "Monday – Thursday", time: "4:00pm – 8:30pm", note: "Bistro & bar dining." },
  { label: "Friday & Saturday", time: "12:00 noon – 8:30pm", note: "Booking recommended; Saturday live music in the Lounge Bar." },
  { label: "Sunday Carvery", time: "11:30am – 3:30pm", note: "Dine in our bar and bistro or takeaway. No reservation needed." },
  { label: "Sunday Evening Bistro", time: "4:30pm – 7:45pm", note: "Evening bistro menu. Reservations recommended." },
];

const corridorStops = [
  { dist: "50.2 mi S", place: "Dublin Airport", major: false },
  { dist: "10.3 mi SE", place: "Carlingford", major: false },
  { dist: "4.5 mi W", place: "Slieve Gullion", major: false },
  { dist: "0 mi", place: "Flagstaff Lodge", major: true },
  { dist: "1.7 mi N", place: "Newry Cathedral", major: false },
  { dist: "2.8 mi N", place: "Ashfield Golf Club", major: false },
  { dist: "35.7 mi N", place: "Belfast Int'l", major: false },
];
---

<ConceptLayout
  title="Flagstaff Lodge — Hotel, Dining & Weddings, Cloughoge, Newry"
  slug="flagstaff-lodge"
  bodyClass="concept-page concept-flagstaff"
  lang="en-GB"
  businessName="Flagstaff Lodge"
  town="Newry"
  fontHref={fontHref}
  bannerNote="The lodge dusk scene and Sunday carvery dining plate are AI-generated visualisations. Room searches hand straight to Flagstaff Lodge's own NetAffinity booking engine; voucher, table and wedding enquiries compose an email to info@flagstafflodgenewry.com."
>
  <header class="fl-header">
    <div class="fl-wrap fl-header-inner">
      <a class="fl-brand" href="#top">
        <FlMark size={36} tone="gold" />
        <span class="fl-brand-text">
          <strong>Flagstaff Lodge</strong>
          <small>Cloughoge, Newry · Est. as The Newry Golf Inn</small>
        </span>
      </a>
      <nav class="fl-nav" aria-label="Flagstaff Lodge">
        <a href="#rooms">Rooms</a>
        <a href="#dining">Carvery &amp; Lounge</a>
        <a href="#weddings">Weddings &amp; Boardroom</a>
        <a href="#enquire">Vouchers</a>
        <a href="#find">Location</a>
      </nav>
      <a class="fl-header-tel" href={phoneHref}>{phone}</a>
    </div>
  </header>

  <main id="top" class="fl-main">
    <section class="fl-hero" aria-labelledby="fl-hero-title">
      <figure class="fl-hero-media">
        <ResponsiveImage
          src="/media/concepts/flagstaff-lodge/flagstaff-lodge-hero-dusk.jpg"
          alt="Dusk view of a stone and cream-rendered country lodge with warm amber windows beneath a moody mountain ridge"
          width={1376}
          height={768}
          loading="eager"
          sizes="100vw"
          class="fl-hero-img"
        />
        <figcaption class="fl-hero-disclosure">Dusk lodge &amp; Ring of Gullion atmosphere. Visualisation (AI-generated).</figcaption>
      </figure>
      <div class="fl-hero-scrim" aria-hidden="true"></div>

      <div class="fl-wrap fl-hero-content">
        <div class="fl-hero-copy">
          <p class="fl-kicker">11 Forkhill Road · Just off the A1 / M1 · Newry</p>
          <h1 id="fl-hero-title">Rest, dine and gather <em>at the foot of Slieve Gullion.</em></h1>
          <p class="fl-lede">
            A landmark hostelry midway between Belfast and Dublin — eighteen
            purpose-built en-suite rooms, Sunday carvery without needing to
            book, Saturday live music in the Lounge Bar, and a licensed venue
            for civil weddings and boardroom meetings.
          </p>
        </div>

        <form class="fl-seam-bar" id="book-stay" data-booking-base={bookingBase} aria-label="Check live room availability">
          <div class="fl-seam-intro">
            <span class="fl-seam-eyebrow">Direct room search</span>
            <strong>18 En-Suite Bedrooms</strong>
          </div>
          <label class="fl-seam-field">
            <span>Check-in</span>
            <input type="date" name="checkin" id="fl-checkin" required />
          </label>
          <label class="fl-seam-field">
            <span>Check-out</span>
            <input type="date" name="checkout" id="fl-checkout" required />
          </label>
          <button class="fl-btn fl-btn--gold fl-seam-submit" type="submit">Check live rates ↗</button>
          <a class="fl-seam-alt" href="#enquire" data-open-tab="voucher">Order a voucher →</a>
        </form>
      </div>
    </section>

    <section class="fl-ruler" aria-label="A1 and M1 corridor distances from Flagstaff Lodge">
      <div class="fl-wrap">
        <div class="fl-ruler-head">
          <span class="fl-ruler-label">A1 / M1 Belfast — Dublin Corridor</span>
          <span class="fl-ruler-meta">124 free parking spaces · Step-free restaurant ramp · BT35 8LZ</span>
        </div>
        <ol class="fl-ruler-track">
          {corridorStops.map((stop) => (
            <li class:list={["fl-stop", { "is-home": stop.major }]}>
              <span class="fl-stop-dot" aria-hidden="true"></span>
              <strong>{stop.place}</strong>
              <small>{stop.dist}</small>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="fl-section fl-rooms" id="rooms" aria-labelledby="fl-rooms-title">
      <div class="fl-wrap">
        <div class="fl-editorial-head">
          <div>
            <p class="fl-kicker fl-kicker--pine">Accommodation · Opened February 2016</p>
            <h2 id="fl-rooms-title">Eighteen quiet bedrooms off the carriageway.</h2>
          </div>
          <div class="fl-editorial-aside">
            <p>
              Purpose-built beside our long-standing bar and banqueting suite for
              wedding guests, family breaks, golfers and Belfast–Dublin business
              stops. Free baby cots available on request.
            </p>
            <a class="fl-text-link" href={bookingBase} rel="noopener noreferrer">Open NetAffinity room calendar ↗</a>
          </div>
        </div>

        <ol class="fl-room-ledger">
          {rooms.map((room, i) => (
            <li class="fl-ledger-row">
              <span class="fl-ledger-no">0{i + 1}</span>
              <div class="fl-ledger-main">
                <h3>{room.name}</h3>
                <p>{room.note}</p>
              </div>
              <span class="fl-ledger-beds">{room.beds}</span>
            </li>
          ))}
        </ol>

        <div class="fl-standards-strip">
          <span class="fl-standards-title">In every room</span>
          <ul>
            {roomStandards.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="fl-dining" id="dining" aria-labelledby="fl-dining-title">
      <div class="fl-dining-split">
        <figure class="fl-dining-plate">
          <ResponsiveImage
            src="/media/concepts/flagstaff-lodge/flagstaff-lodge-carvery-table.jpg"
            alt="Sunday roast dining table set with stoneware plates, roast vegetables, brass candlesticks and warm fireside light"
            width={1200}
            height={896}
            sizes="(max-width: 960px) 100vw, 50vw"
            class="fl-dining-img"
          />
          <figcaption>Sunday carvery &amp; fireside dining atmosphere. Visualisation (AI-generated).</figcaption>
        </figure>

        <div class="fl-dining-body">
          <p class="fl-kicker">Dining, Sunday Carvery &amp; Lounge Bar</p>
          <h2 id="fl-dining-title">Sunday carvery — dine in or take home, no booking needed.</h2>
          <p class="fl-dining-lede">
            Known locally for years as <em>The Newry Golf Inn</em>, Flagstaff
            Lodge built its reputation on generous modern Irish cooking,
            gluten-free options, and multiple TripAdvisor Certificates of
            Excellence — backed by a traditional Lounge Bar with major sport and
            <strong>live music every Saturday night</strong>.
          </p>

          <dl class="fl-times">
            {diningTimes.map((row) => (
              <div class="fl-time-row">
                <dt>
                  <strong>{row.label}</strong>
                  <span>{row.note}</span>
                </dt>
                <dd>{row.time}</dd>
              </div>
            ))}
          </dl>

          <div class="fl-dining-actions">
            <a class="fl-btn fl-btn--gold" href="#enquire" data-open-tab="table">Book an evening bistro table</a>
            <a class="fl-btn fl-btn--ghost-light" href={phoneHref}>Call {phone}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="fl-section fl-weddings" id="weddings" aria-labelledby="fl-weddings-title">
      <div class="fl-wrap">
        <div class="fl-editorial-head">
          <div>
            <p class="fl-kicker fl-kicker--pine">Weddings, Civil Ceremonies &amp; Conferences</p>
            <h2 id="fl-weddings-title">From vows to last dance — or boardroom to dinner.</h2>
          </div>
          <p class="fl-editorial-aside">
            Simple for guests arriving from Belfast, Dublin, Newry or Dundalk:
            124 free on-site spaces, step-free restaurant ramps, Banqueting
            Suite, Bridal Suite and 18 bedrooms under one roof.
          </p>
        </div>

        <div class="fl-dual-band">
          <article class="fl-band-col">
            <span class="fl-band-eyebrow">Licensed Civil Wedding Venue</span>
            <h3>Weddings &amp; Inclusive Packages</h3>
            <p>
              Host your civil ceremony, wedding banquet and evening reception in
              one setting with turnkey Inclusive Packages tailored to your
              numbers and supported by our experienced team.
            </p>
            <ul>
              <li>Licensed for civil ceremonies &amp; partnerships</li>
              <li>Dedicated Banqueting Suite &amp; Bridal Suite</li>
              <li>18 en-suite rooms on site for travelling guests</li>
            </ul>
            <a class="fl-btn fl-btn--pine" href="#enquire" data-open-tab="wedding">Enquire about a wedding date</a>
          </article>

          <article class="fl-band-col fl-band-col--tinted">
            <span class="fl-band-eyebrow">Midway Between Belfast &amp; Dublin</span>
            <h3>Boardroom &amp; Private Functions</h3>
            <p>
              From executive breakfasts and all-day meetings to trade shows,
              family dinners and fundraisers — with Daily Delegate Rates and
              high-speed Wi-Fi throughout.
            </p>
            <ul>
              <li>Dedicated Boardroom for up to 25–30 delegates</li>
              <li>Banqueting Suite for larger conferences &amp; dinners</li>
              <li>Seasonal menus &amp; overnight accommodation</li>
            </ul>
            <a class="fl-btn fl-btn--outline-dark" href="#enquire" data-open-tab="conference">Request delegate rates</a>
          </article>
        </div>

        <FlEventPlanner />
      </div>
    </section>

    <section class="fl-section fl-enquire" id="enquire" aria-labelledby="fl-enquire-title">
      <div class="fl-wrap">
        <div class="fl-enquire-top">
          <div>
            <p class="fl-kicker fl-kicker--pine">Direct Desk &amp; Gift Vouchers</p>
            <h2 id="fl-enquire-title">Vouchers, bistro tables &amp; event dates.</h2>
          </div>
          <div class="fl-tabs" role="tablist" aria-label="Enquiry type">
            <button type="button" role="tab" aria-selected="true" class="fl-tab is-active" data-tab="voucher">Gift Voucher</button>
            <button type="button" role="tab" aria-selected="false" class="fl-tab" data-tab="table">Bistro Table</button>
            <button type="button" role="tab" aria-selected="false" class="fl-tab" data-tab="wedding">Wedding</button>
            <button type="button" role="tab" aria-selected="false" class="fl-tab" data-tab="conference">Conference</button>
          </div>
        </div>

        <div class="fl-desk-layout">
          <div class="fl-voucher-stage" id="fl-voucher-stage">
            <div class="fl-voucher-card" aria-live="polite">
              <div class="fl-voucher-frame">
                <div class="fl-voucher-top">
                  <FlMark size={30} tone="gold" />
                  <span>Gift Voucher · Newry</span>
                </div>
                <p class="fl-voucher-brand">Flagstaff Lodge</p>
                <p class="fl-voucher-amount" id="fl-preview-amount">£100</p>
                <p class="fl-voucher-for">
                  <span>Prepared for</span>
                  <strong id="fl-preview-for">Dining, Sunday Carvery or Overnight Stay</strong>
                </p>
                <div class="fl-voucher-foot">
                  <span id="fl-preview-delivery">Collect at reception</span>
                  <span>11 Forkhill Road, BT35 8LZ</span>
                </div>
              </div>
            </div>
            <p class="fl-stage-note">
              Your details compose a ready-to-send email straight to{" "}
              <a href={`mailto:${email}`}>{email}</a> — or call reception on{" "}
              <a href={phoneHref}>{phone}</a>.
            </p>
          </div>

          <form class="fl-form" id="fl-enquiry-form" data-email={email}>
            <input type="hidden" name="enquiryType" id="fl-enquiry-type" value="voucher" />

            <div class="fl-panel" data-panel="voucher">
              <div class="fl-form-row">
                <label>
                  <span>Voucher value (£)</span>
                  <input name="voucherAmount" id="fl-voucher-amount" value="£100" placeholder="e.g. £50, £100, £150" />
                </label>
                <label>
                  <span>Collection or post</span>
                  <select name="voucherDelivery" id="fl-voucher-delivery">
                    <option value="Collect at reception">Collect at reception</option>
                    <option value="Post out">Post out (confirm address by reply)</option>
                  </select>
                </label>
              </div>
              <label>
                <span>Recipient / occasion (optional)</span>
                <input name="voucherFor" id="fl-voucher-for" placeholder="e.g. For Mum & Dad — Anniversary" />
              </label>
            </div>

            <div class="fl-panel" data-panel="table" hidden>
              <p class="fl-panel-note">Recommended for Friday, Saturday and Sunday evening bistro dining. Sunday Carvery (11:30am – 3:30pm) needs no booking.</p>
              <div class="fl-form-row">
                <label>
                  <span>Preferred date</span>
                  <input type="date" name="tableDate" />
                </label>
                <label>
                  <span>Time &amp; party size</span>
                  <input name="tableDetails" placeholder="e.g. 6:30pm, 4 guests" />
                </label>
              </div>
            </div>

            <div class="fl-panel" data-panel="wedding" hidden>
              <p class="fl-panel-note">Ask about Inclusive Wedding Packages, Civil Ceremonies, the Bridal Suite or private family occasions.</p>
              <div class="fl-form-row">
                <label>
                  <span>Preferred date or month</span>
                  <input name="weddingDate" placeholder="e.g. Autumn 2027" />
                </label>
                <label>
                  <span>Estimated guests</span>
                  <input name="weddingGuests" placeholder="e.g. 90 day / 140 evening" />
                </label>
              </div>
              <label>
                <span>Event format</span>
                <select name="weddingCeremony">
                  <option value="Reception only">Reception only</option>
                  <option value="Civil ceremony + reception">Civil ceremony &amp; reception</option>
                  <option value="Private family function / party">Private family function / party</option>
                </select>
              </label>
            </div>

            <div class="fl-panel" data-panel="conference" hidden>
              <p class="fl-panel-note">Boardroom seats up to 25–30 delegates; Banqueting Suite available for larger events with Daily Delegate Rates.</p>
              <div class="fl-form-row">
                <label>
                  <span>Company / organisation</span>
                  <input name="company" />
                </label>
                <label>
                  <span>Event date &amp; delegates</span>
                  <input name="conferenceDetails" placeholder="e.g. 14 Jan, 25 delegates" />
                </label>
              </div>
              <label>
                <span>Overnight rooms required?</span>
                <select name="conferenceRooms">
                  <option value="No">Day meeting only</option>
                  <option value="Yes">Yes — include accommodation</option>
                </select>
              </label>
            </div>

            <div class="fl-form-common">
              <div class="fl-form-row">
                <label>
                  <span>Your name</span>
                  <input name="name" autocomplete="name" required />
                </label>
                <label>
                  <span>Phone number</span>
                  <input name="phone" type="tel" autocomplete="tel" required />
                </label>
              </div>
              <label>
                <span>Notes or dietary / access requests (optional)</span>
                <textarea name="notes" rows="2"></textarea>
              </label>
            </div>

            <div class="fl-form-foot">
              <button class="fl-btn fl-btn--pine" type="submit" id="fl-submit-btn">Open voucher email →</button>
              <span>Opens in your email app; nothing sends until you confirm.</span>
            </div>
          </form>
        </div>
      </div>
    </section>

    <section class="fl-find" id="find" aria-labelledby="fl-find-title">
      <div class="fl-wrap fl-find-inner">
        <div>
          <p class="fl-kicker">Location &amp; Heritage</p>
          <h2 id="fl-find-title">11 Forkhill Road, Cloughoge, Newry BT35 8LZ.</h2>
          <p>
            Started life as a par-3 golf course and clubhouse (<em>The Newry Golf Inn</em>),
            now a full hostelry, banqueting suite and 18-room lodge framed by
            the Ring of Gullion, the Mountains of Mourne and the Cooley
            Peninsula — with easy access to Carlingford, Dundalk, The Boulevard
            and the Game of Thrones Studio Tour.
          </p>
        </div>
        <div class="fl-find-meta">
          <p><strong>GPS:</strong> 54.150892, -6.350870 · 124 free spaces</p>
          <p><strong>Reception:</strong> <a href={phoneHref}>{phoneIntl}</a> · <a href={`mailto:${email}`}>{email}</a></p>
          <div class="fl-find-actions">
            <a class="fl-btn fl-btn--gold" href={mapHref} rel="noopener noreferrer">Open Google Maps ↗</a>
            <a class="fl-btn fl-btn--ghost-light" href={facebook} rel="noopener noreferrer">Facebook ↗</a>
          </div>
        </div>
      </div>

      <div class="fl-wrap" style="margin-top: 34px;">
        <LocalAreaMap
          id="flagstaff-map"
          businessName="Flagstaff Lodge"
          address="11 Forkhill Road, Cloughoge, Newry, BT35 8QY"
          lon={-6.35087}
          lat={54.15089}
          spanKm={18}
          tone="dark"
          mapHref={mapHref}
          kicker="A1 / M1 Corridor & Ring of Gullion"
          markers={[
            { name: "Newry City", lon: -6.340, lat: 54.176, note: "5 mins", side: "r" },
            { name: "Slieve Gullion", lon: -6.433, lat: 54.123, note: "10 mins", side: "l" },
            { name: "Warrenpoint", lon: -6.250, lat: 54.103, note: "12 mins", side: "r" },
            { name: "Carlingford", lon: -6.185, lat: 54.042, note: "20 mins", side: "r" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="fl-footer">
    <div class="fl-wrap fl-footer-inner">
      <div class="fl-footer-brand">
        <FlMark size={30} tone="cream" />
        <span><strong>Flagstaff Lodge</strong> · 11 Forkhill Road, Cloughoge, Newry, BT35 8LZ</span>
      </div>
      <p class="fl-footer-links">
        <a href={phoneHref}>{phoneIntl}</a> · <a href={`mailto:${email}`}>{email}</a> · <a href={facebook} rel="noopener noreferrer">Facebook</a>
      </p>
    </div>
  </footer>

  <script>
    // Default room search dates to next Friday → Sunday (2 nights)
    const checkinEl = document.getElementById("fl-checkin") as HTMLInputElement | null;
    const checkoutEl = document.getElementById("fl-checkout") as HTMLInputElement | null;
    const iso = (d: Date) => d.toISOString().slice(0, 10);
    if (checkinEl && checkoutEl) {
      const start = new Date();
      const daysToFri = ((5 - start.getDay() + 7) % 7) || 7;
      start.setDate(start.getDate() + daysToFri);
      const end = new Date(start);
      end.setDate(end.getDate() + 2);
      checkinEl.min = iso(new Date());
      checkinEl.value = iso(start);
      checkoutEl.min = iso(start);
      checkoutEl.value = iso(end);
      checkinEl.addEventListener("change", () => {
        if (!checkinEl.value) return;
        const next = new Date(`${checkinEl.value}T00:00:00`);
        next.setDate(next.getDate() + 1);
        checkoutEl.min = iso(next);
        if (!checkoutEl.value || checkoutEl.value <= checkinEl.value) {
          checkoutEl.value = iso(next);
        }
      });
    }

    const bookForm = document.getElementById("book-stay") as HTMLFormElement | null;
    bookForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      const base = bookForm.dataset.bookingBase ?? "https://www.flagstafflodgenewry.com/bookings.html";
      const start = checkinEl?.value;
      const end = checkoutEl?.value;
      const target = start && end ? `${base}#!/accommodation/rooms/date/${start}/${end}` : base;
      window.open(target, "_blank", "noopener,noreferrer");
    });

    // Live-rendered Gift Voucher preview
    const vAmount = document.getElementById("fl-voucher-amount") as HTMLInputElement | null;
    const vFor = document.getElementById("fl-voucher-for") as HTMLInputElement | null;
    const vDelivery = document.getElementById("fl-voucher-delivery") as HTMLSelectElement | null;
    const pAmount = document.getElementById("fl-preview-amount");
    const pFor = document.getElementById("fl-preview-for");
    const pDelivery = document.getElementById("fl-preview-delivery");

    const syncVoucher = () => {
      if (pAmount && vAmount) pAmount.textContent = vAmount.value.trim() || "£100";
      if (pFor && vFor) pFor.textContent = vFor.value.trim() || "Dining, Sunday Carvery or Overnight Stay";
      if (pDelivery && vDelivery) pDelivery.textContent = vDelivery.value;
    };
    vAmount?.addEventListener("input", syncVoucher);
    vFor?.addEventListener("input", syncVoucher);
    vDelivery?.addEventListener("change", syncVoucher);

    // Tabbed enquiry desk
    const tabs = document.querySelectorAll<HTMLButtonElement>("[data-tab]");
    const panels = document.querySelectorAll<HTMLElement>("[data-panel]");
    const typeInput = document.getElementById("fl-enquiry-type") as HTMLInputElement | null;
    const submitBtn = document.getElementById("fl-submit-btn");
    const buttonLabels: Record<string, string> = {
      voucher: "Open voucher email →",
      table: "Open table enquiry email →",
      wedding: "Open wedding enquiry email →",
      conference: "Open conference enquiry email →",
    };

    const activateTab = (name: string) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.tab === name;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-selected", String(active));
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== name;
      });
      if (typeInput) typeInput.value = name;
      if (submitBtn) submitBtn.textContent = buttonLabels[name] ?? "Open enquiry email →";
    };

    tabs.forEach((tab) => tab.addEventListener("click", () => tab.dataset.tab && activateTab(tab.dataset.tab)));
    document.querySelectorAll<HTMLElement>("[data-open-tab]").forEach((el) => {
      el.addEventListener("click", () => el.dataset.openTab && activateTab(el.dataset.openTab));
    });

    const enquiryForm = document.getElementById("fl-enquiry-form") as HTMLFormElement | null;
    enquiryForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      const d = new FormData(enquiryForm);
      const kind = String(d.get("enquiryType") ?? "voucher");
      const subjects: Record<string, string> = {
        voucher: "Gift Voucher Enquiry — Flagstaff Lodge",
        table: "Bistro Table Reservation — Flagstaff Lodge",
        wedding: "Wedding / Event Enquiry — Flagstaff Lodge",
        conference: "Conference / Boardroom Enquiry — Flagstaff Lodge",
      };
      const lines: string[] = [];
      if (kind === "voucher") {
        lines.push(`Voucher value: ${d.get("voucherAmount") || "To confirm"}`);
        lines.push(`Delivery: ${d.get("voucherDelivery") || ""}`);
        if (d.get("voucherFor")) lines.push(`For / occasion: ${d.get("voucherFor")}`);
      } else if (kind === "table") {
        lines.push(`Preferred date: ${d.get("tableDate") || "To confirm"}`);
        lines.push(`Time & party size: ${d.get("tableDetails") || "To confirm"}`);
      } else if (kind === "wedding") {
        lines.push(`Preferred date / month: ${d.get("weddingDate") || "To confirm"}`);
        lines.push(`Estimated guests: ${d.get("weddingGuests") || "To confirm"}`);
        lines.push(`Event type: ${d.get("weddingCeremony") || ""}`);
      } else if (kind === "conference") {
        if (d.get("company")) lines.push(`Company / organisation: ${d.get("company")}`);
        lines.push(`Date & delegates: ${d.get("conferenceDetails") || "To confirm"}`);
        lines.push(`Overnight rooms required: ${d.get("conferenceRooms") || "No"}`);
      }
      lines.push("", `Name: ${d.get("name") || ""}`, `Phone: ${d.get("phone") || ""}`);
      if (d.get("notes")) lines.push("", `Notes: ${d.get("notes")}`);
      const to = enquiryForm.dataset.email ?? "info@flagstafflodgenewry.com";
      const subject = subjects[kind] ?? "Enquiry — Flagstaff Lodge";
      const body = lines.join("\n");
      const url = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      if (window.dispatchEvent(new CustomEvent("mm:enquiry", { cancelable: true, detail: { to, subject, body, url } }))) {
        window.location.href = url;
      }
    });
  </script>
</ConceptLayout>
