---
/* Flagstaff Lodge: Interactive Occasion & Suite Matcher.
   Matches guest count and gathering style to verified Flagstaff Lodge spaces
   and pre-fills the direct enquiry desk. */
---

<div class="fl-planner" data-fl-planner>
  <div class="fl-planner-head">
    <div>
      <h2 id="fl-planner-title">Match your guest count to the right suite.</h2>
      <p class="fl-planner-intro">
        Choose the occasion and slide your expected numbers to see which room fits best,
        then pre-fill the enquiry desk below.
      </p>
    </div>
    <div class="fl-planner-match" aria-live="polite">
      <span class="fl-planner-match-label">Recommended space</span>
      <strong data-fl-space>Banqueting Suite and Bridal Suite</strong>
    </div>
  </div>

  <div class="fl-planner-controls">
    <div class="fl-seg" role="radiogroup" aria-label="Occasion type">
      <button
        type="button"
        role="radio"
        aria-checked="true"
        class="fl-seg-item is-active"
        data-fl-occ="wedding"
      >
        Civil wedding
      </button>
      <button
        type="button"
        role="radio"
        aria-checked="false"
        class="fl-seg-item"
        data-fl-occ="conference"
      >
        Boardroom and conference
      </button>
      <button
        type="button"
        role="radio"
        aria-checked="false"
        class="fl-seg-item"
        data-fl-occ="table"
      >
        Evening bistro gathering
      </button>
    </div>

    <label class="fl-guest-slider">
      <span class="fl-slider-meta">
        <span>Estimated guests</span>
        <strong data-fl-guests-val>80 guests</strong>
      </span>
      <input type="range" min="4" max="160" step="2" value="80" data-fl-range />
    </label>
  </div>

  <div class="fl-planner-foot">
    <p data-fl-summary>
      Licensed civil ceremony and wedding banquet in our Banqueting Suite, with
      18 en-suite bedrooms on site and 124 free car parking spaces straight off the A1.
    </p>
    <button type="button" class="fl-btn fl-btn--gold" data-fl-prefill>
      Pre-fill enquiry desk
    </button>
  </div>
</div>

<script is:inline>
  (() => {
    const planner = document.querySelector("[data-fl-planner]");
    if (!planner) return;

    let occ = "wedding";
    const range = planner.querySelector("[data-fl-range]");
    const guestsVal = planner.querySelector("[data-fl-guests-val]");
    const spaceEl = planner.querySelector("[data-fl-space]");
    const summaryEl = planner.querySelector("[data-fl-summary]");
    const occBtns = Array.from(planner.querySelectorAll("[data-fl-occ]"));
    if (!range || !guestsVal || !spaceEl || !summaryEl) return;

    const update = () => {
      const n = Number(range.value || 80);
      guestsVal.textContent = `${n} guests`;
      if (occ === "wedding") {
        spaceEl.textContent = "Banqueting Suite and Bridal Suite";
        summaryEl.textContent = `Inclusive Wedding Package for around ${n} guests, licensed for civil ceremonies, with 18 en-suite bedrooms on site and 124 free spaces straight off the A1.`;
      } else if (occ === "conference") {
        if (n <= 30) {
          spaceEl.textContent = "Dedicated Executive Boardroom";
          summaryEl.textContent = `Private Executive Boardroom for ${n} delegates with Daily Delegate Rates, high-speed Wi-Fi, seasonal lunch menus, and direct A1 access between Belfast and Dublin.`;
        } else {
          spaceEl.textContent = "Banqueting Suite (conference layout)";
          summaryEl.textContent = `Banqueting Suite configured for ${n} delegates, suited to trade shows, all-day conferences, and team dinners with overnight rooms on site.`;
        }
      } else {
        spaceEl.textContent = n > 24 ? "Private dining in the Banqueting Suite" : "Evening Bistro and Lounge Bar";
        summaryEl.textContent =
          n > 24
            ? `Private family celebration or group dinner for ${n} guests with tailored seasonal menus and step-free access from our 124-space car park.`
            : `Relaxed bistro dining for ${n} guests (Monday to Thursday from 4pm, Friday and Saturday from noon, Sunday bistro from 4:30pm, or walk straight in for Sunday carvery 11:30am to 3:30pm).`;
      }
    };

    occBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        occ = btn.getAttribute("data-fl-occ") || "wedding";
        occBtns.forEach((b) => {
          const active = b === btn;
          b.classList.toggle("is-active", active);
          b.setAttribute("aria-checked", active ? "true" : "false");
        });
        if (occ === "conference" && Number(range.value) > 40) range.value = "24";
        if (occ === "table" && Number(range.value) > 20) range.value = "8";
        if (occ === "wedding" && Number(range.value) < 40) range.value = "80";
        update();
      });
    });

    range.addEventListener("input", update);

    const prefillBtn = planner.querySelector("[data-fl-prefill]");
    if (prefillBtn) {
      prefillBtn.addEventListener("click", () => {
        const tabBtn = document.querySelector(`[data-fl-desk-tab="${occ}"]`);
        if (tabBtn instanceof HTMLElement) tabBtn.click();
        const notes = document.querySelector('#fl-enquiry-form textarea[name="notes"]');
        if (notes instanceof HTMLTextAreaElement) {
          notes.value = `Approx. ${range.value} guests, interested in ${spaceEl.textContent}.`;
        }
        document.getElementById("enquire")?.scrollIntoView({ behavior: "smooth" });
      });
    }

    update();
  })();
</script>
