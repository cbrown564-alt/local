---
/* Flagstaff Lodge — Interactive Occasion & Suite Planner.
   Matches guest count & gathering style to verified Flagstaff Lodge spaces
   and pre-fills the direct enquiry desk. */
---

<div class="fl-planner" data-fl-planner>
  <div class="fl-planner-head">
    <div>
      <p class="fl-kicker fl-kicker--pine">Suite &amp; Table Matcher</p>
      <h3>Match your guest count to the right room.</h3>
    </div>
    <span class="fl-planner-badge" data-fl-space>Banqueting Suite &amp; Bridal Suite</span>
  </div>

  <div class="fl-planner-controls">
    <div class="fl-occ-pills" role="group" aria-label="Occasion type">
      <button type="button" class="fl-occ-btn is-active" data-fl-occ="wedding">Civil Wedding</button>
      <button type="button" class="fl-occ-btn" data-fl-occ="conference">Boardroom / Conference</button>
      <button type="button" class="fl-occ-btn" data-fl-occ="table">Evening Bistro / Gathering</button>
    </div>

    <label class="fl-guest-slider">
      <span>Estimated guests: <strong data-fl-guests-val>80 guests</strong></span>
      <input type="range" min="4" max="160" step="2" value="80" data-fl-range />
    </label>
  </div>

  <div class="fl-planner-foot">
    <p data-fl-summary>
      Licensed civil ceremony and wedding banquet in our Banqueting Suite, with
      18 en-suite bedrooms on site and 124 free car parking spaces straight off the A1/M1.
    </p>
    <button type="button" class="fl-btn fl-btn--pine" data-fl-prefill>
      Pre-fill enquiry desk →
    </button>
  </div>
</div>

<style>
  .fl-planner {
    margin-top: 32px;
    padding: 28px 30px;
    background: #ffffff;
    border: 1px solid var(--fl-line);
    border-top: 3px solid var(--fl-gold);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .fl-planner-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .fl-planner-head h3 {
    margin: 0;
    font-family: var(--fl-serif);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--fl-ink);
  }

  .fl-planner-badge {
    padding: 6px 12px;
    background: var(--fl-stone);
    color: var(--fl-pine);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .fl-planner-controls {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 24px;
    align-items: center;
  }

  .fl-occ-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .fl-occ-btn {
    padding: 9px 14px;
    border: 1px solid rgba(24, 33, 27, 0.24);
    background: #ffffff;
    color: var(--fl-ink);
    font: inherit;
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 140ms ease, color 140ms ease, border-color 140ms ease;
  }

  .fl-occ-btn.is-active {
    background: var(--fl-pine);
    border-color: var(--fl-pine);
    color: var(--fl-cream);
  }

  .fl-guest-slider {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.86rem;
    color: var(--fl-muted);
  }

  .fl-guest-slider strong {
    color: var(--fl-ink);
    font-variant-numeric: tabular-nums;
  }

  .fl-guest-slider input[type="range"] {
    width: 100%;
    accent-color: var(--fl-pine);
    cursor: pointer;
  }

  .fl-planner-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    padding-top: 16px;
    border-top: 1px solid var(--fl-line);
  }

  .fl-planner-foot p {
    margin: 0;
    max-width: 62ch;
    font-size: 0.9rem;
    color: var(--fl-muted);
  }

  @media (max-width: 820px) {
    .fl-planner-controls {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const planner = document.querySelector<HTMLElement>("[data-fl-planner]");
  if (planner) {
    let occ = "wedding";
    const range = planner.querySelector<HTMLInputElement>("[data-fl-range]")!;
    const guestsVal = planner.querySelector<HTMLElement>("[data-fl-guests-val]")!;
    const spaceEl = planner.querySelector<HTMLElement>("[data-fl-space]")!;
    const summaryEl = planner.querySelector<HTMLElement>("[data-fl-summary]")!;

    const update = () => {
      const n = Number(range.value || 80);
      guestsVal.textContent = `${n} guests`;
      if (occ === "wedding") {
        spaceEl.textContent = "Banqueting Suite & Bridal Suite";
        summaryEl.textContent = `Inclusive Wedding Package for around ${n} guests — licensed for civil ceremonies, with 18 en-suite bedrooms on site and 124 free spaces right off the A1/M1.`;
      } else if (occ === "conference") {
        if (n <= 30) {
          spaceEl.textContent = "Dedicated Executive Boardroom";
          summaryEl.textContent = `Private Executive Boardroom for ${n} delegates with Daily Delegate Rates, high-speed Wi-Fi, seasonal lunch menus, and easy Belfast–Dublin A1 access.`;
        } else {
          spaceEl.textContent = "Banqueting Suite (Conference Layout)";
          summaryEl.textContent = `Banqueting Suite configured for ${n} delegates — ideal for trade shows, all-day conferences, and team dinners with overnight rooms on site.`;
        }
      } else {
        spaceEl.textContent = n > 24 ? "Private Dining / Banqueting Suite" : "Evening Bistro & Lounge Bar";
        summaryEl.textContent =
          n > 24
            ? `Private family celebration or group dinner for ${n} guests with tailored seasonal menus and step-free access from our 124-space car park.`
            : `Relaxed bistro dining for ${n} guests (Mon–Thu from 4pm, Fri–Sat from noon, Sun bistro from 4:30pm — or walk straight in for Sunday Carvery 11:30am–3:30pm).`;
      }
    };

    planner.querySelectorAll<HTMLButtonElement>("[data-fl-occ]").forEach((btn) => {
      btn.addEventListener("click", () => {
        occ = btn.dataset.flOcc || "wedding";
        planner.querySelectorAll("[data-fl-occ]").forEach((b) => b.classList.toggle("is-active", b === btn));
        if (occ === "conference" && Number(range.value) > 40) range.value = "24";
        if (occ === "table" && Number(range.value) > 20) range.value = "8";
        if (occ === "wedding" && Number(range.value) < 40) range.value = "80";
        update();
      });
    });

    range.addEventListener("input", update);

    planner.querySelector<HTMLButtonElement>("[data-fl-prefill]")?.addEventListener("click", () => {
      const tabBtn = document.querySelector<HTMLButtonElement>(`[data-tab="${occ}"]`);
      tabBtn?.click();
      const notes = document.querySelector<HTMLTextAreaElement>('#fl-enquiry-form textarea[name="notes"]');
      if (notes) {
        notes.value = `Approx. ${range.value} guests — interested in ${spaceEl.textContent}.`;
      }
      document.getElementById("enquire")?.scrollIntoView({ behavior: "smooth" });
    });

    update();
  }
</script>
