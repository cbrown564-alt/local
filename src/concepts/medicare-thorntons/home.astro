---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import CollectionSlip from "./CollectionSlip.astro";

/* MediCare Thorntons — community pharmacy on Central Promenade.
   49 Central Promenade, Newcastle, BT33 0HH.
   Phone: 028 4372 3248.
   Prescription dispensing, repeat collection & local delivery service. */

const phone = "028 4372 3248";
const phoneHref = "tel:+442843723248";
const group = "https://medicare-group.com/";
const maps =
  "https://www.google.com/maps/search/?api=1&query=49+Central+Promenade+Newcastle+BT33+0HH";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,500;0,7..72,600;1,7..72,500&family=Public+Sans:wght@400;500;600;700&display=swap";

const pharmacyServices = [
  {
    kicker: "Dispensing",
    title: "NHS & Private Prescriptions",
    body: "Accurate, timely dispensing of acute and repeat prescriptions issued by local GP surgeries and clinics across South Down.",
  },
  {
    kicker: "Repeat Service",
    title: "Prescription Collection & Delivery",
    body: "We coordinate directly with your doctor's surgery to collect your repeat prescription and have your medication ready for collection or delivered to your door.",
  },
  {
    kicker: "Consultations",
    title: "Minor Ailments & Pharmacist Advice",
    body: "Confidential consultations for common conditions, healthcare advice, and over-the-counter medicines without an appointment.",
  },
  {
    kicker: "Wellness",
    title: "Health Checks & Medication Reviews",
    body: "Blood pressure monitoring, medication usage reviews, seasonal flu vaccinations, and tailored support with new prescriptions.",
  },
];
---

<ConceptLayout
  title={"MediCare Thorntons — independent concept"}
  slug="medicare-thorntons"
  bodyClass="concept-page concept-medicare-thorntons"
  lang="en-GB"
  businessName="MediCare Thorntons"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The collection slip is a drawing."
>
  <div class="mt-strip">
    <span>49 Central Promenade, Newcastle · BT33 0HH · Community Pharmacy</span>
    <span class="mt-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="mt-header">
    <a class="mt-brand" href="/concepts/medicare-thorntons/">
      <span class="mt-brand-mark" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 44 44" fill="none">
          <rect width="44" height="44" rx="4" fill="#eef2f0"/>
          <rect x="1.5" y="1.5" width="41" height="41" rx="3.5" stroke="#2f4a52" stroke-width="1.4"/>
          <path d="M22 10v24M10 22h24" stroke="#2f6a62" stroke-width="2.6" stroke-linecap="round"/>
          <circle cx="22" cy="22" r="14" fill="none" stroke="#9ab0a8" stroke-width="1"/>
        </svg>
      </span>
      <span class="mt-brand-text">
        <span class="mt-brand-name">MediCare Thorntons</span>
        <span class="mt-brand-sub">49 Central Promenade · Newcastle</span>
      </span>
    </a>
    <nav class="mt-nav" aria-label="Concept navigation">
      <a href="#services">Dispensary Services</a>
      <a href="#repeats">Repeat Prescriptions</a>
      <a href="#consultation">Health Advice</a>
      <a href="#branch">Branch Info</a>
    </nav>
    <a class="mt-ring-btn" href={phoneHref}>Call Pharmacy</a>
  </header>

  <main class="mt-main">
    <section class="mt-hero" aria-labelledby="mt-name">
      <div class="mt-hero-main">
        <span class="mt-kicker">Community Dispensary · Central Promenade</span>
        <h1 id="mt-name">MediCare Thorntons</h1>
        <p class="mt-place">49 Central Promenade · Newcastle · BT33 0HH</p>
        <p class="mt-say">Professional prescription care and healthcare support on Newcastle's promenade.</p>
        <p class="mt-lede">
          As part of Northern Ireland’s trusted MediCare pharmacy group, our Thorntons branch provides expert dispensing,
          free repeat collection and delivery services, and confidential healthcare advice for residents and visitors.
        </p>
        <div class="mt-hero-actions">
          <a class="mt-btn mt-btn--primary" href={phoneHref}>Phone Branch {phone}</a>
          <a class="mt-btn mt-btn--outline" href={group} rel="noopener noreferrer">MediCare Group Services</a>
        </div>
      </div>

      <div class="mt-hero-slip">
        <CollectionSlip headingId="mt-name" />
      </div>
    </section>

    <section class="mt-services-section" id="services" aria-labelledby="mt-services-title">
      <div class="mt-section-head">
        <span class="mt-kicker">Dispensary Care</span>
        <h2 id="mt-services-title">Healthcare &amp; Prescription Services</h2>
        <p class="mt-section-intro">
          Our qualified pharmacists and dispensary technicians are here to assist you with every aspect of your medication.
        </p>
      </div>

      <div class="mt-services-grid" role="list">
        {pharmacyServices.map((svc) => (
          <article class="mt-service-card" role="listitem">
            <span class="mt-card-kicker">{svc.kicker}</span>
            <h3>{svc.title}</h3>
            <p>{svc.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-repeats-section" id="repeats" aria-labelledby="mt-repeats-title">
      <div class="mt-repeats-card">
        <div class="mt-repeats-copy">
          <span class="mt-kicker">Repeat Prescriptions</span>
          <h2 id="mt-repeats-title">Prescription Collection &amp; Home Delivery</h2>
          <p class="mt-repeats-lede">
            Save time and never miss a dose. We manage repeat orders directly with local surgeries in Newcastle, Dundrum, and Castlewellan.
          </p>

          <div class="mt-repeats-steps">
            <div class="mt-step-item">
              <span class="mt-step-num">01</span>
              <div>
                <h4>Nominate Thorntons</h4>
                <p>Inform your GP practice or notify our pharmacy that you wish Thorntons on Central Promenade to dispense your prescriptions.</p>
              </div>
            </div>
            <div class="mt-step-item">
              <span class="mt-step-num">02</span>
              <div>
                <h4>We Dispense &amp; Check</h4>
                <p>Our team collects the prescription, prepares your medications carefully, and completes all clinical safety checks.</p>
              </div>
            </div>
            <div class="mt-step-item">
              <span class="mt-step-num">03</span>
              <div>
                <h4>Collect or Home Delivery</h4>
                <p>Pick up your medications from our promenade counter or request our free local delivery service straight to your home.</p>
              </div>
            </div>
          </div>

          <div class="mt-repeats-cta">
            <a class="mt-btn mt-btn--primary" href={phoneHref}>Call {phone} to Sign Up</a>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-branch-section" id="branch" aria-labelledby="mt-branch-title">
      <div class="mt-branch-grid">
        <div class="mt-branch-details">
          <span class="mt-kicker">Branch Contact</span>
          <h2 id="mt-branch-title">49 Central Promenade</h2>
          <p class="mt-branch-lede">
            Conveniently located on Central Promenade with easy promenade access.
            Speak directly with our pharmacy team for prescription queries or health consultations.
          </p>
          <div class="mt-branch-links">
            <a class="mt-btn mt-btn--primary" href={phoneHref}>Telephone {phone}</a>
            <a class="mt-btn mt-btn--outline" href={maps} rel="noopener noreferrer">Directions on Map</a>
          </div>
        </div>

        <address class="mt-address-card">
          <strong>MediCare Thorntons</strong>
          <span>49 Central Promenade</span>
          <span>Newcastle, County Down</span>
          <span>BT33 0HH</span>
          <a class="mt-phone-link" href={phoneHref}>{phone}</a>
          <p class="mt-group-note">
            Part of the MediCare Pharmacy Group · Northern Ireland's largest indigenous pharmacy family.
          </p>
          <a class="mt-group-link" href={group} rel="noopener noreferrer">medicare-group.com</a>
        </address>
      </div>
    </section>
  </main>

  <footer class="mt-footer">
    <p class="mt-footer-name">MediCare Thorntons</p>
    <p>49 Central Promenade, Newcastle · NHS Community Pharmacy</p>
  </footer>
</ConceptLayout>
