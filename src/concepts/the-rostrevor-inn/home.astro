---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";

/* The Rostrevor Inn — 33–35 Bridge Street, Rostrevor, Co. Down, BT34 3BG.
   Sources (live-fetched 26 Nov 2026): therostrevorinn.com (/, /accommodation/,
   /the-bar/, /live-music/, /contact-us/, /gift-vouchers/).
   - Refurbished 18th-century building where the Crawford family first served
     drinks in the mid-1800s. Yards from Fairy Glen & Kilbroney Park.
   - 7 en-suite bedrooms (singles, doubles & family/group rooms including the
     Narnia-themed family room) with hearty breakfasts cooked to order.
   - Live room booking engine:
     https://web-bookings.hotels.uk.com/#/booking/32318/items/availability?k=9ITXuus4zTgJi5TOZ2A9AJIIw
   - Crawfords Traditional Bar & Stables snugs: Killowen & Mourne Dew local craft
     gins, poitíns & whiskies, Two Stacks, Maggie's Leap craft IPA, Guinness,
     cocktails & fine wines.
   - Weekly Live Music Playbill:
     Wednesday: Matthew McGrath songs & stories by the fireside in Crawfords.
     Friday: Multi-instrumentalist Dermot McQuaid.
     Saturday: Live music every Saturday night.
     Sunday 5pm: Danny McGreevy's traditional session + monthly folk club.
   - Published Hours:
     Breakfast 9:00am – 11:00am (7 days, seasonal) ·
     Lunch 12:30pm – 3:00pm (Thu–Sat) ·
     Dinner 5:30pm – 9:00pm (Wed–Sat) ·
     Sunday 12:30pm – 8:00pm All Day ·
     Crawfords Bar 3:00pm – Close.
   - Gift Vouchers: online (£25, £50+) or same-day first-class post by phone.
   - Phone: 028 4173 9911 · Email: therostrevorinn@gmail.com.
   Brief: research/concepts/the-rostrevor-inn/the-rostrevor-inn-elevation-brief.md */

const phone = "028 4173 9911";
const phoneHref = "tel:+442841739911";
const email = "therostrevorinn@gmail.com";
const bookRoomUrl =
  "https://web-bookings.hotels.uk.com/#/booking/32318/items/availability?k=9ITXuus4zTgJi5TOZ2A9AJIIw";
const vouchersUrl = "https://therostrevorinn.com/gift-vouchers/";
const facebook = "https://www.facebook.com/therostrevorinn/";
const instagram = "https://www.instagram.com/therostrevorinn/";
const mapHref = "https://www.google.com/maps/search/?api=1&query=33-35+Bridge+Street+Rostrevor+BT34+3BG";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,500&family=Karla:wght@400;500;600;700&display=swap";

const playbill = [
  { day: "Wednesday", bill: "Matthew McGrath", detail: "Legendary songs & stories by the fireside in Crawfords Bar." },
  { day: "Friday Night", bill: "Dermot McQuaid", detail: "Live acoustic sets from the acclaimed multi-instrumentalist." },
  { day: "Saturday Night", bill: "Live Village Music", detail: "Full Saturday night session across Crawfords Bar & the Stables." },
  { day: "Sunday · 5:00pm", bill: "Danny McGreevy Trad Session", detail: "Weekly traditional Irish session plus our monthly Folk Club." },
];

const hours = [
  { service: "Breakfast (7 days, seasonal)", time: "9:00am – 11:00am" },
  { service: "Lunch (Thu – Sat)", time: "12:30pm – 3:00pm" },
  { service: "Dinner (Wed – Sat)", time: "5:30pm – 9:00pm" },
  { service: "Sunday All-Day Dining", time: "12:30pm – 8:00pm" },
  { service: "Crawfords Bar", time: "3:00pm – Close" },
];
---

<ConceptLayout
  title="The Rostrevor Inn — Crawfords Bar, Stables Bistro, Live Music & Rooms"
  slug="the-rostrevor-inn"
  bodyClass="concept-page concept-rostrevorinn"
  lang="en-GB"
  businessName="The Rostrevor Inn"
  town="Rostrevor"
  fontHref={fontHref}
  bannerNote="The fireside trad session and Stables dining room scenes are AI-generated visualisations. Room availability opens The Rostrevor Inn's live booking portal; gift vouchers link to therostrevorinn.com/gift-vouchers/."
>
  <header class="ri-header">
    <div class="ri-wrap ri-header-inner">
      <a class="ri-brand" href="#top">
        <strong>The Rostrevor Inn</strong>
        <small>33–35 Bridge Street · Crawfords Bar Since the Mid-1800s</small>
      </a>
      <nav class="ri-nav" aria-label="The Rostrevor Inn">
        <a href="#playbill">Live Music</a>
        <a href="#stables">Stables &amp; Bar</a>
        <a href="#rooms">7 Rooms &amp; Narnia</a>
        <a href="#enquire">Tables &amp; Hours</a>
      </nav>
      <div class="ri-header-right">
        <a class="ri-tel" href={phoneHref}>{phone}</a>
        <a class="ri-book-btn" href={bookRoomUrl} rel="noopener noreferrer">Book a Room ↗</a>
      </div>
    </div>
  </header>

  <main id="top" class="ri-main">
    <section class="ri-hero" aria-labelledby="ri-hero-title">
      <figure class="ri-hero-media">
        <ResponsiveImage
          src="/media/concepts/the-rostrevor-inn/rostrevor-inn-fireside-session.jpg"
          alt="Candlelit 18th-century Irish village pub snug with peat fire, acoustic guitar, fiddle, whiskey tumbler and pint of stout"
          width={1376}
          height={768}
          loading="eager"
          sizes="100vw"
          class="ri-hero-img"
        />
        <figcaption class="ri-hero-cap">18th-century fireside trad session mood. Visualisation (AI-generated).</figcaption>
      </figure>
      <div class="ri-hero-scrim" aria-hidden="true"></div>

      <div class="ri-wrap ri-hero-inner">
        <p class="ri-kicker">18th-Century Village Inn · Yards From Fairy Glen &amp; Kilbroney Park</p>
        <h1 id="ri-hero-title">Fireside sessions, local spirits <em>and seven rooms above Crawfords Bar.</em></h1>
        <p class="ri-lede">
          Where the Crawford family first poured drinks in the mid-1800s — now
          home to four nights a week of live folk and trad music, our stone
          Stables bistro, Killowen and Mourne Dew pours, and seven en-suite
          rooms including our Narnia-themed family room.
        </p>
        <div class="ri-hero-actions">
          <a class="ri-btn ri-btn--amber" href={bookRoomUrl} rel="noopener noreferrer">Check live room availability ↗</a>
          <a class="ri-btn ri-btn--ghost" href={vouchersUrl} rel="noopener noreferrer">Instant Gift Vouchers (£25+) ↗</a>
          <a class="ri-btn ri-btn--ghost" href="#playbill">This week's music playbill ↓</a>
        </div>
      </div>
    </section>

    <section class="ri-playbill" id="playbill" aria-labelledby="ri-playbill-title">
      <div class="ri-wrap">
        <div class="ri-bill-board">
          <div class="ri-bill-head">
            <p class="ri-kicker">Weekly Playbill · Crawfords Bar, Rostrevor</p>
            <h2 id="ri-playbill-title">Four nights of live music every single week.</h2>
          </div>

          <ol class="ri-bill-rows">
            {playbill.map((gig) => (
              <li class="ri-bill-row">
                <span class="ri-gig-day">{gig.day}</span>
                <strong class="ri-gig-act">{gig.bill}</strong>
                <span class="ri-gig-detail">{gig.detail}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="ri-stables" id="stables" aria-labelledby="ri-stables-title">
      <div class="ri-wrap ri-stables-grid">
        <figure class="ri-stables-plate">
          <ResponsiveImage
            src="/media/concepts/the-rostrevor-inn/rostrevor-inn-stables-dining.jpg"
            alt="Candlelit oak bistro table inside historic rubble-stone stables with hearty roasted dish, crusty sourdough and red wine"
            width={1200}
            height={896}
            sizes="(max-width: 960px) 100vw, 48vw"
            class="ri-stables-img"
          />
          <figcaption>Historic Stables bistro &amp; evening dining mood. Visualisation (AI-generated).</figcaption>
        </figure>

        <div class="ri-stables-copy">
          <p class="ri-kicker ri-kicker--dark">The Stables Bistro &amp; Local Distilleries</p>
          <h2 id="ri-stables-title">Mourne craft pours by the hearth, bistro dining in the Stables.</h2>
          <p>
            Settle into the atmospheric Stables snugs with a pint of Guinness or
            local <strong>Maggie's Leap</strong> craft IPA, or explore gins,
            poitíns and whiskies from two award-winning neighbouring
            distilleries — <strong>Killowen</strong> and <strong>Mourne Dew</strong> —
            alongside <strong>Two Stacks</strong> whiskey.
          </p>

          <dl class="ri-hours" id="enquire">
            {hours.map((h) => (
              <div>
                <dt>{h.service}</dt>
                <dd>{h.time}</dd>
              </div>
            ))}
          </dl>

          <div class="ri-stables-actions">
            <a class="ri-btn ri-btn--mahogany" href={phoneHref}>Book a bistro table · {phone}</a>
            <a class="ri-btn ri-btn--outline" href={`mailto:${email}?subject=${encodeURIComponent("Table or Stay Enquiry — The Rostrevor Inn")}`}>Email {email}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="ri-rooms" id="rooms" aria-labelledby="ri-rooms-title">
      <div class="ri-wrap ri-rooms-grid">
        <div>
          <p class="ri-kicker">Seven En-Suite Bedrooms · Cooked-to-Order Breakfast</p>
          <h2 id="ri-rooms-title">Singles, doubles — and our Narnia-themed family room.</h2>
          <p>
            Step straight out of Bridge Street into Fairy Glen, Kilbroney Park
            and world-class mountain biking trails, then come back to big beds
            and hearty breakfasts cooked to order by our chefs.
          </p>
          <div class="ri-room-actions">
            <a class="ri-btn ri-btn--amber" href={bookRoomUrl} rel="noopener noreferrer">Book rooms direct ↗</a>
            <a class="ri-btn ri-btn--ghost" href={vouchersUrl} rel="noopener noreferrer">Buy instant Gift Voucher ↗</a>
          </div>
        </div>

        <div class="ri-voucher-box">
          <h3>Gift Vouchers &amp; Directions</h3>
          <p>
            Order instant emailed vouchers online (from £25) or ring{" "}
            <a href={phoneHref}>{phone}</a> for same-day first-class post.
          </p>
          <p><strong>33–35 Bridge Street, Rostrevor, BT34 3BG</strong></p>
          <div class="ri-social-links">
            <a href={mapHref} rel="noopener noreferrer">Google Maps ↗</a>
            <a href={facebook} rel="noopener noreferrer">Facebook ↗</a>
            <a href={instagram} rel="noopener noreferrer">Instagram ↗</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="ri-footer">
    <div class="ri-wrap ri-footer-inner">
      <span><strong>The Rostrevor Inn</strong> · 33–35 Bridge Street, Rostrevor, Co. Down, BT34 3BG</span>
      <span><a href={phoneHref}>{phone}</a> · <a href={`mailto:${email}`}>{email}</a> · <a href={bookRoomUrl} rel="noopener noreferrer">Book Direct ↗</a></span>
    </div>
  </footer>
</ConceptLayout>
