---
/**
 * Binghams Menswear — bespoke tailor's shears and measuring tape mark.
 * Reflects the craft of the fitting: half an hour with tape, chalk and scissors.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className = "" } = Astro.props;
---

<svg
  class:list={["bm-mark", className]}
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  aria-hidden="true"
>
  <!-- Tailor shears / measuring tape heraldic motif -->
  <!-- Left scissor loop and blade -->
  <circle cx="12" cy="30" r="4.5" stroke="currentColor" stroke-width="2" />
  <path
    d="M15 27L28 10"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
  />
  
  <!-- Right scissor loop and blade -->
  <circle cx="28" cy="30" r="4.5" stroke="currentColor" stroke-width="2" />
  <path
    d="M25 27L12 10"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
  />

  <!-- Central pivot rivet -->
  <circle cx="20" cy="20.5" r="1.5" fill="currentColor" />

  <!-- Measuring tape arc frame above -->
  <path
    d="M7 16C7 8.8 12.8 3 20 3C27.2 3 33 8.8 33 16"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-dasharray="2.5 2.5"
  />
</svg>

<style>
  .bm-mark {
    display: inline-block;
    vertical-align: middle;
    color: currentColor;
    flex-shrink: 0;
  }
</style>
