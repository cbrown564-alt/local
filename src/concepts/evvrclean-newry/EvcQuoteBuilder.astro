---
/* Evvrclean Newry — Deep Slate-Teal Contrast Stage with Commercial, Domestic & Laundrette Tabs. */
const services = [
  {
    id: "commercial",
    label: "Commercial",
    optionValue: "Commercial Cleaning Contract",
    title: "Dependable scheduled cleaning for offices, retail units and clinics.",
    points: [
      {
        label: "Flexible hours",
        detail: "Early-morning, evening or weekend schedules built around your staff.",
      },
      {
        label: "Local team",
        detail: "Consistent operatives covering Newry, Armagh Road and County Down.",
      },
      {
        label: "Site walkaround",
        detail: "Free on-site walkaround before quoting so your scope matches how the space is used.",
      },
    ],
    note: "Most Newry and South Down site visits can be scheduled promptly with written pricing.",
  },
  {
    id: "domestic",
    label: "Domestic",
    optionValue: "Domestic Housekeeping / Deep Clean",
    title: "Thorough weekly, fortnightly or deep-clean visits for busy households.",
    points: [
      {
        label: "Full rooms",
        detail: "Kitchens, bathrooms, floors and living areas finished to a consistent standard.",
      },
      {
        label: "Deep cleans",
        detail: "One-off deep cleans, end-of-tenancy handovers and seasonal refreshes.",
      },
      {
        label: "Direct booking",
        detail: "Arrange visits directly with our Newry desk on 028 3005 0330.",
      },
    ],
    note: "Share your number of bedrooms and preferred frequency for a straightforward guide price.",
  },
  {
    id: "laundrette",
    label: "Laundrette",
    optionValue: "Laundrette / Commercial Linen",
    title: "Drop-off laundrette and commercial linen turnaround on Armagh Road.",
    points: [
      {
        label: "Hospitality & home",
        detail: "Service washes, bed linen, towels, salon wear, workwear and bulky duvets.",
      },
      {
        label: "Unit 11 access",
        detail: "Heavy-duty washing, drying and crisp folding with door-side parking at ITEC Business Park.",
      },
      {
        label: "Regular runs",
        detail: "Commercial collection and return schedules available for local businesses.",
      },
    ],
    note: "Dedicated support is always available at customersupport@evvrclean.co.uk.",
  },
];
---

<section class="evc-stage" id="services" aria-labelledby="evc-stage-title">
  <div class="evc-wrap" data-evc-scope>
    <div class="evc-stage-head">
      <h2 id="evc-stage-title">Choose the service you need.</h2>
      <div class="evc-tabs" role="tablist" aria-label="Choose cleaning service">
        {services.map((svc, idx) => (
          <button
            type="button"
            role="tab"
            id={`evc-tab-${svc.id}`}
            aria-controls={`evc-panel-${svc.id}`}
            aria-selected={idx === 0 ? "true" : "false"}
            class:list={["evc-tab", idx === 0 && "is-active"]}
            data-evc-tab={svc.id}
          >
            {svc.label}
          </button>
        ))}
      </div>
    </div>

    <div class="evc-stage-grid">
      <div class="evc-stage-copy">
        {services.map((svc, idx) => (
          <div
            class="evc-panel"
            role="tabpanel"
            id={`evc-panel-${svc.id}`}
            aria-labelledby={`evc-tab-${svc.id}`}
            data-evc-panel={svc.id}
            hidden={idx !== 0}
          >
            <h3>{svc.title}</h3>
            <dl class="evc-stage-ledger">
              {svc.points.map((pt) => (
                <div>
                  <dt>{pt.label}</dt>
                  <dd>{pt.detail}</dd>
                </div>
              ))}
            </dl>
            <p class="evc-stage-note">{svc.note}</p>
            <a class="evc-stage-cta" href="#quote" data-evc-prefill={svc.optionValue}>
              Request a {svc.label.toLowerCase()} quote
            </a>
          </div>
        ))}
      </div>

      <figure class="evc-plate">
        <picture>
          <source
            srcset="/media/concepts/evvrclean-newry/evvrclean-laundrette-linens-640.webp 640w, /media/concepts/evvrclean-newry/evvrclean-laundrette-linens-1265.webp 1265w"
            sizes="(max-width: 900px) 100vw, 46vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/evvrclean-newry/evvrclean-laundrette-linens.jpg"
            alt="Crisp folded white hotel-grade cotton towels and pressed linens beside stainless steel commercial laundry drums"
            width="1408"
            height="768"
            loading="lazy"
          />
        </picture>
        <figcaption>Indicative laundrette and pressed linen facility visualisation.</figcaption>
      </figure>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-evc-scope]");
    if (!root) return;
    const tabs = [...root.querySelectorAll("[data-evc-tab]")];
    const panels = [...root.querySelectorAll("[data-evc-panel]")];

    const selectTab = (id) => {
      const target = tabs.find((t) => t.getAttribute("data-evc-tab") === id);
      if (!target) return;
      tabs.forEach((t) => {
        const active = t === target;
        t.classList.toggle("is-active", active);
        t.setAttribute("aria-selected", active ? "true" : "false");
      });
      panels.forEach((p) => {
        p.hidden = p.getAttribute("data-evc-panel") !== id;
      });
      window.dispatchEvent(new CustomEvent("evc:tab-changed", { detail: { id } }));
    };

    tabs.forEach((btn) => {
      btn.addEventListener("click", () => {
        selectTab(btn.getAttribute("data-evc-tab"));
      });
    });

    window.addEventListener("evc:select-tab", (e) => {
      if (e && e.detail && e.detail.id) {
        selectTab(e.detail.id);
      }
    });

    root.querySelectorAll("[data-evc-prefill]").forEach((link) => {
      link.addEventListener("click", () => {
        const value = link.getAttribute("data-evc-prefill");
        const select = document.querySelector("[data-evc-service-select]");
        if (select && value) {
          select.value = value;
          select.dispatchEvent(new Event("change", { bubbles: true }));
        }
      });
    });
  })();
</script>
