---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import EvcQuoteBuilder from "./EvcQuoteBuilder.astro";
import "./styles.css";

/* Evvrclean — Unit 11, ITEC Business Park, 52A Armagh Road, Newry BT35 6PS.
   Verified live 27 Nov 2026: commercial cleaning, domestic housekeeping & commercial laundrette.
   Contacts: 028 3005 0330, Enquiries@evvrclean.co.uk, customersupport@evvrclean.co.uk. */
const phone = "028 3005 0330";
const phoneHref = "tel:+442830050330";
const email = "Enquiries@evvrclean.co.uk";
const supportEmail = "customersupport@evvrclean.co.uk";
const mapsHref =
  "https://www.google.com/maps/search/?api=1&query=Evvrclean+Unit+11+ITEC+Business+Park+52A+Armagh+Road+Newry+BT35+6PS";

const serviceDropdown = [
  {
    id: "commercial",
    title: "Commercial contracts",
    desc: "Offices, retail units and clinics cleaned on reliable local schedules.",
    img: "/media/concepts/evvrclean-newry/evvrclean-commercial-space-640.webp",
    note: "Newry and County Down premises",
  },
  {
    id: "domestic",
    title: "Domestic housekeeping",
    desc: "Regular weekly visits and thorough end-of-tenancy deep cleans.",
    img: "/media/concepts/evvrclean-newry/evvrclean-commercial-space-640.webp",
    note: "Flexible weekly and one-off visits",
  },
  {
    id: "laundrette",
    title: "Commercial laundrette",
    desc: "Pressed linens, towels, duvets and hospitality washes from Armagh Road.",
    img: "/media/concepts/evvrclean-newry/evvrclean-laundrette-linens-640.webp",
    note: "Unit 11, ITEC Business Park",
  },
];
---

<ConceptLayout
  title="Evvrclean: Commercial Cleaning, Domestic Care and Laundrette, Newry"
  slug="evvrclean-newry"
  bodyClass="concept-page concept-evvrclean"
  businessName="Evvrclean"
  town="Newry"
  bannerNote="Imagery comprises indicative spotless commercial workspace and laundrette linen care visualisations."
>
  <header class="evc-header" data-evc-header>
    <div class="evc-header-inner">
      <a class="evc-brand" href="#top">Evvrclean</a>

      <nav class="evc-nav" aria-label="Primary">
        <div class="evc-dd-wrap" data-evc-dd>
          <button
            type="button"
            class="evc-nav-link evc-dd-trigger"
            aria-expanded="false"
            aria-controls="evc-svc-menu"
            data-evc-dd-trigger
          >
            <span>Services</span>
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path
                d="M2.5 4.5L6 8l3.5-3.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
          <div class="evc-dd-panel" id="evc-svc-menu" hidden data-evc-dd-panel>
            <ul class="evc-dd-list">
              {serviceDropdown.map((item, idx) => (
                <li>
                  <a
                    href="#services"
                    class:list={["evc-dd-item", idx === 0 && "is-active"]}
                    data-evc-dd-item
                    data-tab-target={item.id}
                    data-img={item.img}
                    data-note={item.note}
                  >
                    <strong>{item.title}</strong>
                    <span>{item.desc}</span>
                  </a>
                </li>
              ))}
            </ul>
            <div class="evc-dd-preview" aria-hidden="true">
              <div class="evc-dd-photo">
                <img src={serviceDropdown[0].img} alt="" width="640" height="349" data-evc-dd-img />
              </div>
              <p class="evc-dd-note" data-evc-dd-note>{serviceDropdown[0].note}</p>
            </div>
          </div>
        </div>
        <a class="evc-nav-link" href="#services" data-evc-jump="laundrette">Laundrette</a>
        <a class="evc-nav-link" href="#quote">Quote</a>
        <a class="evc-nav-link" href="#location">Newry</a>
      </nav>

      <div class="evc-header-actions">
        <a class="evc-header-tel" href={phoneHref}>{phone}</a>
        <a class="evc-header-cta" href="#quote">Get a quote</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="evc-hero" aria-labelledby="evc-hero-title">
      <div class="evc-scroll-sentinel" aria-hidden="true" data-evc-sentinel></div>

      <div class="evc-wrap">
        <div class="evc-hero-lockup">
          <h1 id="evc-hero-title" class="evc-reveal evc-reveal-1">
            Spotless spaces, cared for locally.
          </h1>
          <div class="evc-hero-lead evc-reveal evc-reveal-2">
            <p>
              Commercial contracts, domestic housekeeping and crisp linen care from Unit 11, ITEC
              Business Park in Newry.
            </p>
            <a class="evc-btn" href="#quote">Request a free quote</a>
          </div>
        </div>

        <div class="evc-hero-media evc-reveal evc-reveal-3">
          <picture>
            <source
              srcset="/media/concepts/evvrclean-newry/evvrclean-commercial-space-640.webp 640w, /media/concepts/evvrclean-newry/evvrclean-commercial-space-1265.webp 1265w"
              sizes="(max-width: 1280px) 92vw, 1240px"
              type="image/webp"
            />
            <img
              src="/media/concepts/evvrclean-newry/evvrclean-commercial-space.jpg"
              alt="Sunlit modern office reception and glass-walled boardroom with gleaming oak floors and spotless surfaces"
              width="1408"
              height="768"
              loading="eager"
            />
          </picture>
        </div>

        <div class="evc-hero-foot">
          <p class="evc-hero-caption">Indicative commercial workspace cleaning visualisation.</p>
        </div>
      </div>
    </section>

    <EvcQuoteBuilder />

    <section class="evc-section evc-quote" id="quote" aria-labelledby="evc-q-title">
      <div class="evc-wrap evc-split">
        <div class="evc-col">
          <h2 id="evc-q-title">Tell us your premises and schedule.</h2>
          <p class="evc-body">
            Whether you need five-day office cleaning, a fortnightly home visit or commercial linen
            turnaround from our Armagh Road unit, send a brief note and our Newry team will reply
            promptly.
          </p>
          <dl class="evc-ledger">
            <div>
              <dt>Direct desk</dt>
              <dd><a href={phoneHref}>{phone}</a></dd>
            </div>
            <div>
              <dt>New quotes</dt>
              <dd><a href={`mailto:${email}`}>{email}</a></dd>
            </div>
            <div>
              <dt>Client support</dt>
              <dd><a href={`mailto:${supportEmail}`}>{supportEmail}</a></dd>
            </div>
            <div>
              <dt>Unit 11 drop-off</dt>
              <dd>ITEC Business Park, 52A Armagh Road, Newry BT35 6PS</dd>
            </div>
          </dl>
        </div>

        <div class="evc-col">
          <form class="evc-form" data-evc-form>
            <div class="evc-row">
              <label>
                <span>Your name</span>
                <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
              </label>
              <label>
                <span>Telephone</span>
                <input name="phone" type="tel" required autocomplete="tel" placeholder="028 or 07..." />
              </label>
            </div>
            <div class="evc-row">
              <label>
                <span>Service required</span>
                <select name="service" data-evc-service-select>
                  <option value="Commercial Cleaning Contract">Commercial cleaning contract</option>
                  <option value="Domestic Housekeeping / Deep Clean">Domestic housekeeping or deep clean</option>
                  <option value="Laundrette / Commercial Linen">Laundrette and commercial linen</option>
                  <option value="Free On-Site Walkaround">Free on-site walkaround</option>
                </select>
              </label>
              <label>
                <span>Area or postcode</span>
                <input name="area" type="text" placeholder="e.g. Newry BT35 or Warrenpoint" />
              </label>
            </div>
            <label>
              <span>Cleaning frequency and details</span>
              <textarea
                name="notes"
                rows="3"
                placeholder="Approximate size of premises, preferred days or laundry volume..."
              ></textarea>
            </label>
            <button class="evc-btn" type="submit">Send quote request</button>
          </form>
        </div>
      </div>
    </section>

    <section class="evc-section evc-map-band" id="location" aria-label="Newry ITEC Business Park map">
      <div class="evc-wrap">
        <LocalAreaMap
          id="evc-map"
          kicker=""
          businessName="Evvrclean Newry"
          address="Unit 11, ITEC Business Park, 52A Armagh Road, Newry, BT35 6PS"
          lon={-6.3445}
          lat={54.1863}
          spanKm={16}
          mapHref={mapsHref}
          markers={[
            { name: "Newry City Centre", lon: -6.3402, lat: 54.1751, note: "4 mins south", side: "b" },
            { name: "Bessbrook", lon: -6.3958, lat: 54.1972, note: "7 mins west", side: "l" },
            { name: "Warrenpoint", lon: -6.2504, lat: 54.1003, note: "14 mins south-east", side: "r" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="evc-footer">
    <div class="evc-wrap evc-footer-inner">
      <div>
        <strong>Evvrclean</strong>
        <p>Unit 11, ITEC Business Park, 52A Armagh Road, Newry, BT35 6PS</p>
      </div>
      <div class="evc-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={`mailto:${supportEmail}`}>{supportEmail}</a>
        <a href={mapsHref} target="_blank" rel="noopener noreferrer">Directions</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-evc-header]");
      const sentinel = document.querySelector("[data-evc-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            header.classList.toggle("is-scrolled", !entries[0].isIntersecting);
          },
          { rootMargin: "-74px 0px 0px 0px", threshold: 0 },
        );
        io.observe(sentinel);
      }

      const ddWrap = document.querySelector("[data-evc-dd]");
      const trigger = ddWrap?.querySelector("[data-evc-dd-trigger]");
      const panel = ddWrap?.querySelector("[data-evc-dd-panel]");
      const previewImg = ddWrap?.querySelector("[data-evc-dd-img]");
      const previewNote = ddWrap?.querySelector("[data-evc-dd-note]");
      const items = ddWrap ? [...ddWrap.querySelectorAll("[data-evc-dd-item]")] : [];

      const activateServiceTab = (tabId) => {
        if (!tabId) return;
        window.dispatchEvent(new CustomEvent("evc:select-tab", { detail: { id: tabId } }));
      };

      const syncDropdownHighlight = (tabId) => {
        const match = items.find((i) => i.dataset.tabTarget === tabId);
        if (!match) return;
        items.forEach((i) => i.classList.toggle("is-active", i === match));
        if (previewImg && match.dataset.img) previewImg.src = match.dataset.img;
        if (previewNote && match.dataset.note) previewNote.textContent = match.dataset.note;
      };

      if (ddWrap && trigger && panel) {
        const setOpen = (open) => {
          panel.hidden = !open;
          trigger.setAttribute("aria-expanded", open ? "true" : "false");
          ddWrap.classList.toggle("is-open", open);
        };
        trigger.addEventListener("click", (e) => {
          e.stopPropagation();
          setOpen(panel.hidden);
        });
        document.addEventListener("click", (e) => {
          if (!ddWrap.contains(e.target)) setOpen(false);
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") setOpen(false);
        });
        items.forEach((item) => {
          const preview = () => {
            items.forEach((i) => i.classList.toggle("is-active", i === item));
            if (previewImg && item.dataset.img) previewImg.src = item.dataset.img;
            if (previewNote && item.dataset.note) previewNote.textContent = item.dataset.note;
          };
          item.addEventListener("mouseenter", preview);
          item.addEventListener("focus", preview);
          item.addEventListener("click", () => {
            activateServiceTab(item.dataset.tabTarget);
            setOpen(false);
          });
        });
      }

      document.querySelectorAll("[data-evc-jump]").forEach((link) => {
        link.addEventListener("click", () => {
          activateServiceTab(link.getAttribute("data-evc-jump"));
        });
      });

      window.addEventListener("evc:tab-changed", (e) => {
        if (e && e.detail && e.detail.id) {
          syncDropdownHighlight(e.detail.id);
        }
      });

      const form = document.querySelector("[data-evc-form]");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        const subject = `Quote Request: ${fd.get("service")} (${fd.get("area") || "Newry"})`;
        const body = [
          `Name: ${fd.get("name")}`,
          `Phone: ${fd.get("phone")}`,
          `Service: ${fd.get("service")}`,
          `Location: ${fd.get("area") || "Newry"}`,
          `Details: ${fd.get("notes") || "None"}`,
        ].join("\n");
        const ev = new CustomEvent("mm:enquiry", {
          cancelable: true,
          detail: { to: "Enquiries@evvrclean.co.uk", subject, body },
        });
        if (window.dispatchEvent(ev)) {
          window.location.href = `mailto:Enquiries@evvrclean.co.uk?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }
      });
    })();
  </script>
</ConceptLayout>
