---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import EvcQuoteBuilder from "./EvcQuoteBuilder.astro";
import "./styles.css";

/* Evvrclean — Unit 11, ITEC Business Park, 52A Armagh Road, Newry BT35 6PS.
   Verified live 27 Nov 2026: evvrclean.co.uk loads 13 Google font families on a bloated Website-Editor
   template around commercial/domestic cleaning & laundrette services.
   Contacts: 028 3005 0330, Enquiries@evvrclean.co.uk, customersupport@evvrclean.co.uk. */
const phone = "028 3005 0330";
const phoneHref = "tel:+442830050330";
const email = "Enquiries@evvrclean.co.uk";
const supportEmail = "customersupport@evvrclean.co.uk";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Evvrclean+Unit+11+ITEC+Business+Park+52A+Armagh+Road+Newry+BT35+6PS";
---

<ConceptLayout
  title="Evvrclean — Commercial Cleaning, Domestic Care & Laundrette, Newry"
  slug="evvrclean-newry"
  bodyClass="concept-page concept-evvrclean"
  businessName="Evvrclean"
  town="Newry"
  bannerNote="Imagery comprises indicative spotless commercial workspace and laundrette linen care visualisations."
>
  <header class="evc-header">
    <div class="evc-header-inner">
      <a class="evc-brand" href="#top">
        <strong>Evvrclean</strong>
        <span>Newry · Commercial, Domestic &amp; Laundrette</span>
      </a>
      <nav class="evc-nav" aria-label="Primary">
        <a href="#services">Services</a>
        <a href="#laundrette">Laundrette</a>
        <a href="#quote">Free Quote</a>
        <a href="#location">ITEC Business Park</a>
      </nav>
      <div class="evc-header-actions">
        <a class="evc-header-tel" href={phoneHref}>{phone}</a>
        <a class="evc-header-cta" href="#quote">Get a Quote</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="evc-hero" aria-labelledby="evc-hero-title">
      <div class="evc-wrap evc-hero-grid">
        <div>
          <p class="evc-kicker">Unit 11, ITEC Business Park · 52A Armagh Road, Newry</p>
          <h1 id="evc-hero-title">Spotless workspaces, cared-for homes and crisp commercial laundry.</h1>
          <p class="evc-lead">
            Newry's dependable team for contract commercial cleaning, regular domestic housekeeping
            and fast-turnaround laundrette linen care — managed locally with clear scheduling.
          </p>
          <div class="evc-actions">
            <a class="evc-btn evc-btn--primary" href="#quote">Request a Free Quote</a>
            <a class="evc-btn evc-btn--outline" href={phoneHref}>Call {phone}</a>
          </div>
        </div>
        <figure class="evc-hero-plate">
          <picture>
            <source srcset="/media/concepts/evvrclean-newry/evvrclean-commercial-space-640.webp 640w, /media/concepts/evvrclean-newry/evvrclean-commercial-space-1265.webp 1265w" sizes="(max-width: 900px) 100vw, 52vw" type="image/webp" />
            <img src="/media/concepts/evvrclean-newry/evvrclean-commercial-space.jpg" alt="Sunlit modern office reception and glass-walled boardroom with gleaming oak floors and spotless surfaces" width="1408" height="768" loading="eager" />
          </picture>
          <figcaption>Commercial office &amp; reception finish. Indicative cleaning visualisation.</figcaption>
        </figure>
      </div>
    </section>

    <EvcQuoteBuilder />

    <section class="evc-section evc-laundrette" id="laundrette" aria-labelledby="evc-laun-title">
      <div class="evc-wrap evc-split">
        <figure class="evc-plate">
          <picture>
            <source srcset="/media/concepts/evvrclean-newry/evvrclean-laundrette-linens-640.webp 640w, /media/concepts/evvrclean-newry/evvrclean-laundrette-linens-1265.webp 1265w" sizes="(max-width: 860px) 100vw, 48vw" type="image/webp" />
            <img src="/media/concepts/evvrclean-newry/evvrclean-laundrette-linens.jpg" alt="Crisp folded white hotel-grade cotton towels and pressed linens beside stainless steel commercial laundry drums" width="1408" height="768" loading="lazy" />
          </picture>
          <figcaption>Laundrette &amp; pressed linen care. Indicative facility visualisation.</figcaption>
        </figure>
        <div>
          <p class="evc-kicker">Unit 11 · Armagh Road, Newry</p>
          <h2 id="evc-laun-title">Drop-off laundrette &amp; commercial linen turnaround.</h2>
          <p>
            From hospitality bed linen, towels and salon wear to household duvets and weekly wash
            loads, our ITEC Business Park unit handles heavy-duty washing, drying and crisp folding
            with easy door-side parking.
          </p>
          <div class="evc-contact-box">
            <p><strong>Direct Desk:</strong> <a href={phoneHref}>{phone}</a></p>
            <p><strong>New Quotes:</strong> <a href={`mailto:${email}`}>{email}</a></p>
            <p><strong>Client Support:</strong> <a href={`mailto:${supportEmail}`}>{supportEmail}</a></p>
          </div>
        </div>
      </div>
    </section>

    <section class="evc-section evc-quote" id="quote" aria-labelledby="evc-q-title">
      <div class="evc-wrap evc-split">
        <div>
          <p class="evc-kicker">Tailored Local Quotes</p>
          <h2 id="evc-q-title">Tell us your premises and schedule.</h2>
          <p>
            Whether you need five-day office cleaning, a fortnightly home visit or commercial linen
            turnaround, send a brief note below and our Newry team will reply promptly.
          </p>
        </div>
        <form class="evc-form" data-evc-form>
          <div class="evc-row">
            <label>
              <span>Your name</span>
              <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
            </label>
            <label>
              <span>Telephone</span>
              <input name="phone" type="tel" required autocomplete="tel" placeholder="028 / 07..." />
            </label>
          </div>
          <div class="evc-row">
            <label>
              <span>Service required</span>
              <select name="service">
                <option value="Commercial Cleaning Contract">Commercial Cleaning Contract</option>
                <option value="Domestic Housekeeping / Deep Clean">Domestic Housekeeping / Deep Clean</option>
                <option value="Laundrette / Commercial Linen">Laundrette / Commercial Linen</option>
                <option value="Free On-Site Walkaround">Free On-Site Walkaround</option>
              </select>
            </label>
            <label>
              <span>Area / postcode</span>
              <input name="area" type="text" placeholder="e.g. Newry BT35 / Warrenpoint" />
            </label>
          </div>
          <label>
            <span>Cleaning frequency &amp; details</span>
            <textarea name="notes" rows="3" placeholder="Approximate size of premises, preferred days or laundry volume..."></textarea>
          </label>
          <button class="evc-btn evc-btn--primary" type="submit">Send Quote Request</button>
        </form>
      </div>
    </section>

    <section class="evc-section" id="location" aria-label="Newry ITEC Business Park map">
      <div class="evc-wrap">
        <LocalAreaMap
          id="evc-map"
          kicker="Unit 11, ITEC Business Park · Armagh Road"
          businessName="Evvrclean"
          address="Unit 11, ITEC Business Park, 52A Armagh Road, Newry, BT35 6PS"
          lon={-6.3445}
          lat={54.1863}
          spanKm={16}
          mapHref={mapsHref}
          markers={[
            { name: "Newry City Centre", lon: -6.3402, lat: 54.1751, note: "4 mins south", side: "b" },
            { name: "Bessbrook", lon: -6.3958, lat: 54.1972, note: "7 mins west", side: "l" },
            { name: "Warrenpoint", lon: -6.2504, lat: 54.1003, note: "14 mins south-east", side: "r" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="evc-footer">
    <div class="evc-wrap evc-footer-inner">
      <div>
        <strong>Evvrclean</strong>
        <p>Unit 11, ITEC Business Park, 52A Armagh Road, Newry, BT35 6PS</p>
      </div>
      <div class="evc-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={`mailto:${supportEmail}`}>{supportEmail}</a>
        <a href={mapsHref} target="_blank" rel="noopener noreferrer">Directions ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const form = document.querySelector("[data-evc-form]");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        const subject = `Quote Request — ${fd.get("service")} (${fd.get("area") || "Newry"})`;
        const body = [
          `Name: ${fd.get("name")}`,
          `Phone: ${fd.get("phone")}`,
          `Service: ${fd.get("service")}`,
          `Location: ${fd.get("area") || "Newry"}`,
          `Details: ${fd.get("notes") || "None"}`,
        ].join("\n");
        const ev = new CustomEvent("mm:enquiry", {
          cancelable: true,
          detail: { to: "Enquiries@evvrclean.co.uk", subject, body },
        });
        if (window.dispatchEvent(ev)) {
          window.location.href = `mailto:Enquiries@evvrclean.co.uk?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }
      });
    })();
  </script>
</ConceptLayout>
