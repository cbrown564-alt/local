---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";
import YwMark from "./YwMark.astro";

/* Yew Wood Cottage — 25 Foughilletra Road, Jonesborough, Newry, County Armagh, BT35 8JE.
   Sources (live-fetched 26 Nov 2026): yewwoodcottage.co.uk (/, /facilities,
   /places-of-interest, /contact), Discover NI.
   - Sleeps 6 across 3 en-suite bedrooms (main bedroom with bath, WC & basin;
     two further bedrooms with en-suite shower, WC & basin) plus a separate WC.
   - Open-plan lounge, dining & kitchen (dishwasher, fridge/freezer, microwave),
     separate utility (washing machine, tumble dryer), heated floors throughout,
     free Wi-Fi, telephone, parking, large BBQ & patio with views of South Armagh
     and Slieve Gullion. Pets welcome.
   - Phone: 028 3084 8936 / 07831 647729 · Email: stay@yewwoodcottage.com.
   Brief: research/concepts/yew-wood-cottage/yew-wood-cottage-elevation-brief.md */

const landline = "028 3084 8936";
const landlineHref = "tel:+442830848936";
const mobile = "07831 647729";
const mobileHref = "tel:+447831647729";
const email = "stay@yewwoodcottage.com";
const mapHref = "https://www.google.com/maps/search/?api=1&query=25+Foughilletra+Road+Newry+BT35+8JE";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Nunito+Sans:wght@400;500;600;700&display=swap";

const rooms = [
  { label: "Main Bedroom", detail: "En-suite with full bath, washbasin and toilet." },
  { label: "Bedroom Two", detail: "En-suite shower room, washbasin and toilet." },
  { label: "Bedroom Three", detail: "En-suite shower room, washbasin and toilet — plus a separate guest WC." },
  { label: "Living & Utility", detail: "Open-plan lounge, dining & kitchen (dishwasher, fridge/freezer, microwave) plus separate utility with washer & dryer." },
];

const nearby = [
  { group: "Walks & Heritage", detail: "Views of Slieve Gullion from the patio, Slieve Gullion Forest Park trails, Kilsnasaggart Stone in Jonesborough, and Moyry Castle." },
  { group: "Local Pubs & Music", detail: "The Welcome Inn in Forkhill for traditional Irish music, and Murphy's Pub just along the roads." },
  { group: "Meigh Village", detail: "Post office, supermarket, chemist, florist, laundry and hair & beauty salon minutes away." },
  { group: "Towns & Loughs", detail: "6 miles to Newry, 8 miles to Dundalk, Carlingford close by, fishing at Camlough Lake, golf and horse riding." },
];
---

<ConceptLayout
  title="Yew Wood Cottage — Self-Catering Holiday Bungalow, Newry, County Armagh"
  slug="yew-wood-cottage"
  bodyClass="concept-page concept-yewwood"
  lang="en-GB"
  businessName="Yew Wood Cottage"
  town="Forkhill / Jonesborough"
  fontHref={fontHref}
  bannerNote="The morning patio and open-plan hearth scenes are AI-generated visualisations. Stay enquiries compose a direct email to stay@yewwoodcottage.com or call 07831 647729."
>
  <header class="yw-masthead">
    <div class="yw-wrap yw-masthead-inner">
      <nav class="yw-nav-left" aria-label="Primary">
        <a href="#cottage">The Bungalow</a>
        <a href="#area">South Armagh</a>
      </nav>
      <a class="yw-crest" href="#top">
        <YwMark size={30} tone="yew" />
        <strong>Yew Wood Cottage</strong>
      </a>
      <nav class="yw-nav-right" aria-label="Booking">
        <a href="#enquire">Book Direct</a>
        <a href={mobileHref}>{mobile}</a>
      </nav>
    </div>
  </header>

  <main id="top" class="yw-main">
    <section class="yw-hero" aria-labelledby="yw-hero-title">
      <div class="yw-wrap yw-hero-header">
        <p class="yw-eyebrow">25 Foughilletra Road · Jonesborough · South Armagh</p>
        <h1 id="yw-hero-title">Quiet mornings looking across to <em>Slieve Gullion.</em></h1>
        <p class="yw-subtitle">
          A modern, single-level holiday bungalow sleeping six — three en-suite
          bedrooms, heated floors in every room, a wide patio and barbecue, and
          a genuine welcome for dogs.
        </p>
        <div class="yw-hero-links">
          <a class="yw-btn yw-btn--yew" href="#enquire">Send a direct stay enquiry</a>
          <a class="yw-btn yw-btn--text" href={mobileHref}>Or call {mobile} →</a>
        </div>
      </div>

      <figure class="yw-panorama">
        <ResponsiveImage
          src="/media/concepts/yew-wood-cottage/yew-wood-morning-view.jpg"
          alt="Sunlit stone cottage patio with two ceramic coffee mugs overlooking green South Armagh fields and Slieve Gullion in morning mist"
          width={1376}
          height={768}
          loading="eager"
          sizes="100vw"
          class="yw-panorama-img"
        />
        <figcaption class="yw-wrap yw-caption-row">
          <span><strong>Sleeps 6</strong> · 3 en-suite bedrooms · Pets welcome · Heated floors · Free parking &amp; Wi-Fi</span>
          <em>Morning patio &amp; Ring of Gullion atmosphere. Visualisation (AI-generated).</em>
        </figcaption>
      </figure>
    </section>

    <section class="yw-section yw-cottage" id="cottage" aria-labelledby="yw-cottage-title">
      <div class="yw-wrap yw-essay-grid">
        <div class="yw-essay-copy">
          <p class="yw-eyebrow">All on One Level</p>
          <h2 id="yw-cottage-title">Warm floors underfoot, space for six without stairs.</h2>
          <p class="yw-dropcap">
            Set back on Foughilletra Road between Jonesborough and Forkhill, Yew
            Wood Cottage is laid out cleanly on a single level so families,
            friends and older relatives can spread out easily. Every bedroom
            carries its own en-suite, the open-plan kitchen and lounge keep
            everyone together after a day on the hills, and a separate utility
            room takes care of muddy boots and walking gear.
          </p>

          <dl class="yw-plan-list">
            {rooms.map((r) => (
              <div class="yw-plan-row">
                <dt>{r.label}</dt>
                <dd>{r.detail}</dd>
              </div>
            ))}
          </dl>
        </div>

        <figure class="yw-hearth-plate">
          <ResponsiveImage
            src="/media/concepts/yew-wood-cottage/yew-wood-hearth-interior.jpg"
            alt="Bright open-plan country cottage living room with pale stone floors, linen sofa, wood stove and tall windows framing green hills"
            width={1200}
            height={896}
            sizes="(max-width: 960px) 100vw, 48vw"
            class="yw-hearth-img"
          />
          <figcaption>Open-plan living room &amp; heated stone floor feel. Visualisation (AI-generated).</figcaption>
        </figure>
      </div>
    </section>

    <section class="yw-gazetteer" id="area" aria-labelledby="yw-area-title">
      <div class="yw-wrap">
        <div class="yw-gaz-head">
          <p class="yw-eyebrow">Field Notes · Around BT35 8JE</p>
          <h2 id="yw-area-title">On the lane in South Armagh — six miles to Newry, eight to Dundalk.</h2>
        </div>

        <div class="yw-gaz-grid">
          {nearby.map((n, i) => (
            <article class="yw-gaz-col">
              <span class="yw-gaz-num">0{i + 1}</span>
              <h3>{n.group}</h3>
              <p>{n.detail}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="yw-section yw-postcard-section" id="enquire" aria-labelledby="yw-enquire-title">
      <div class="yw-wrap">
        <div class="yw-postcard">
          <form class="yw-postcard-left" id="yw-form" data-email={email}>
            <p class="yw-eyebrow">Direct With the Owners · No Agency Fees</p>
            <h2 id="yw-enquire-title">Write to ask about your dates.</h2>

            <div class="yw-field-row">
              <label>
                <span>Check-in</span>
                <input type="date" name="checkin" required />
              </label>
              <label>
                <span>Check-out</span>
                <input type="date" name="checkout" required />
              </label>
            </div>

            <div class="yw-field-row">
              <label>
                <span>Guests (up to 6)</span>
                <select name="guests">
                  <option value="2 guests">2 guests</option>
                  <option value="3–4 guests" selected>3–4 guests</option>
                  <option value="5–6 guests">5–6 guests</option>
                </select>
              </label>
              <label>
                <span>Bringing a dog?</span>
                <select name="pets">
                  <option value="No">No</option>
                  <option value="Yes">Yes — bringing a dog</option>
                </select>
              </label>
            </div>

            <div class="yw-field-row">
              <label>
                <span>Your name</span>
                <input name="name" autocomplete="name" required />
              </label>
              <label>
                <span>Phone number</span>
                <input name="phone" type="tel" autocomplete="tel" required />
              </label>
            </div>

            <button class="yw-btn yw-btn--yew" type="submit">Open stay enquiry email →</button>
          </form>

          <aside class="yw-postcard-right" aria-label="Cottage postal address and phone">
            <div class="yw-stamp" aria-hidden="true">
              <span>SOUTH ARMAGH</span>
              <strong>DIRECT STAY</strong>
              <small>BT35 8JE</small>
            </div>

            <div class="yw-address-lines">
              <p class="yw-to-label">Addressed directly to</p>
              <p class="yw-addr-line"><strong>Yew Wood Cottage</strong></p>
              <p class="yw-addr-line">25 Foughilletra Road, Jonesborough</p>
              <p class="yw-addr-line">Newry, County Armagh, BT35 8JE</p>
              <p class="yw-addr-line"><a href={`mailto:${email}`}>{email}</a></p>
              <p class="yw-addr-line">
                <a href={mobileHref}>{mobile}</a> · <a href={landlineHref}>{landline}</a>
              </p>
            </div>

            <a class="yw-map-link" href={mapHref} rel="noopener noreferrer">View directions on Google Maps ↗</a>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <footer class="yw-footer">
    <div class="yw-wrap yw-footer-inner">
      <span><strong>Yew Wood Cottage</strong> · 25 Foughilletra Road, Newry, County Armagh, BT35 8JE</span>
      <span><a href={landlineHref}>{landline}</a> · <a href={mobileHref}>{mobile}</a> · <a href={`mailto:${email}`}>{email}</a></span>
    </div>
  </footer>

  <script>
    const form = document.getElementById("yw-form") as HTMLFormElement | null;
    const ci = form?.querySelector<HTMLInputElement>('input[name="checkin"]');
    const co = form?.querySelector<HTMLInputElement>('input[name="checkout"]');
    const iso = (d: Date) => d.toISOString().slice(0, 10);
    if (ci && co) {
      const s = new Date();
      s.setDate(s.getDate() + 14);
      const e = new Date(s);
      e.setDate(e.getDate() + 3);
      ci.min = iso(new Date());
      ci.value = iso(s);
      co.min = iso(s);
      co.value = iso(e);
    }
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const d = new FormData(form);
      const body = [
        `Check-in: ${d.get("checkin") || ""}`,
        `Check-out: ${d.get("checkout") || ""}`,
        `Guests: ${d.get("guests") || ""}`,
        `Bringing a pet: ${d.get("pets") || "No"}`,
        "",
        `Name: ${d.get("name") || ""}`,
        `Phone: ${d.get("phone") || ""}`,
      ].join("\n");
      const to = form.dataset.email ?? "stay@yewwoodcottage.com";
      window.location.href = `mailto:${to}?subject=${encodeURIComponent(`Stay enquiry: ${d.get("checkin") || "Yew Wood Cottage"}`)}&body=${encodeURIComponent(body)}`;
    });
  </script>
</ConceptLayout>
