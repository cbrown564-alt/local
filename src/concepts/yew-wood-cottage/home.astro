---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";
import YwMark from "./YwMark.astro";

/* Yew Wood Cottage — 25 Foughilletra Road, Jonesborough, Newry, County Armagh, BT35 8JE.
   Sources (live-fetched 26 Nov 2026): yewwoodcottage.co.uk (/, /facilities,
   /places-of-interest, /contact), Discover NI.
   - Sleeps 6 across 3 en-suite bedrooms (main bedroom with bath, WC & basin;
     two further bedrooms with en-suite shower, WC & basin) plus a separate WC.
   - Open-plan lounge, dining & kitchen (dishwasher, fridge/freezer, microwave),
     separate utility (washing machine, tumble dryer), heated floors throughout,
     free Wi-Fi, telephone, parking, large BBQ & patio with views of South Armagh
     and Slieve Gullion. Pets welcome.
   - Phone: 028 3084 8936 / 07831 647729 · Email: stay@yewwoodcottage.com. */

const landline = "028 3084 8936";
const landlineHref = "tel:+442830848936";
const mobile = "07831 647729";
const mobileHref = "tel:+447831647729";
const email = "stay@yewwoodcottage.com";
const mapHref = "https://www.google.com/maps/search/?api=1&query=25+Foughilletra+Road+Newry+BT35+8JE";

const cottageSpaces = [
  {
    id: "bedrooms",
    tabLabel: "Three en-suite bedrooms",
    title: "Step-free sleeping space for up to six guests",
    summary:
      "Every bedroom carries its own private bathroom on one accessible ground floor, making stays comfortable for families, walking groups, and older relatives alike.",
    details: [
      { label: "Main bedroom", value: "En-suite with full bath, washbasin, and toilet" },
      { label: "Bedroom two", value: "En-suite shower room, washbasin, and toilet" },
      { label: "Bedroom three", value: "En-suite shower room, washbasin, and toilet, plus a separate guest WC" },
    ],
  },
  {
    id: "hearth",
    tabLabel: "Hearth and heated floors",
    title: "Open-plan living room, full kitchen, and warm stone underfoot",
    summary:
      "The lounge, dining area, and fitted kitchen share wide windows toward the South Armagh hills, backed by heated floors throughout every room and a separate utility room for muddy boots.",
    details: [
      { label: "Heating", value: "Heated floors throughout every room plus living-room stove" },
      { label: "Kitchen", value: "Open-plan dining and kitchen with dishwasher, fridge/freezer, and microwave" },
      { label: "Utility room", value: "Separate utility space with washing machine and tumble dryer" },
    ],
  },
  {
    id: "patio",
    tabLabel: "Patio and dog-friendly grounds",
    title: "Sunlit patio views of Slieve Gullion, with dogs welcome",
    summary:
      "Step outside with morning coffee onto the wide stone patio and barbecue area overlooking South Armagh fields and Slieve Gullion, with private off-road parking and a warm welcome for pets.",
    details: [
      { label: "Outdoors", value: "Large patio and barbecue with open views of South Armagh and Slieve Gullion" },
      { label: "Pets", value: "Well-behaved family dogs welcome by direct arrangement" },
      { label: "Essentials", value: "Private on-site parking, free Wi-Fi, and house telephone" },
    ],
  },
];

const nearby = [
  {
    group: "Walks and heritage",
    distance: "From the patio",
    detail: "Open views of Slieve Gullion from the cottage, Slieve Gullion Forest Park trails, Kilsnasaggart Stone in Jonesborough, and Moyry Castle.",
  },
  {
    group: "Local pubs and music",
    distance: "Along the lane",
    detail: "The Welcome Inn in Forkhill for traditional Irish music, and Murphy's Pub just along the roads.",
  },
  {
    group: "Meigh village",
    distance: "Minutes away",
    detail: "Post office, supermarket, chemist, florist, laundry, and hair and beauty salon close to hand.",
  },
  {
    group: "Towns and loughs",
    distance: "6 to 15 miles",
    detail: "Six miles to Newry, eight miles to Dundalk, Carlingford close by, fishing at Camlough Lake, golf, and horse riding.",
  },
];
---

<ConceptLayout
  title="Yew Wood Cottage, Self-Catering Holiday Bungalow, Jonesborough, County Armagh"
  slug="yew-wood-cottage"
  bodyClass="concept-page concept-yewwood"
  lang="en-GB"
  businessName="Yew Wood Cottage"
  town="Forkhill / Jonesborough"
  bannerNote="Imagery comprises indicative morning patio and open-plan hearth visualisations. Stay enquiries compose a direct email to stay@yewwoodcottage.com or call 07831 647729."
>
  <header class="yw-header" data-yw-header>
    <div class="yw-header-inner">
      <a class="yw-brand" href="#top">
        <YwMark size={28} tone="current" />
        <span>Yew Wood Cottage</span>
      </a>
      <nav class="yw-nav" aria-label="Primary">
        <a href="#cottage">Inside</a>
        <a href="#area">South Armagh</a>
        <a href="#enquire">Book direct</a>
        <a href="#location">Location</a>
      </nav>
      <div class="yw-header-actions">
        <a class="yw-header-tel" href={mobileHref}>{mobile}</a>
        <a class="yw-header-cta" href="#enquire">Enquire direct</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="yw-hero" aria-labelledby="yw-hero-title">
      <div class="yw-hero-sentinel" data-yw-sentinel aria-hidden="true"></div>

      <div class="yw-wrap yw-hero-lockup">
        <h1 id="yw-hero-title">Quiet mornings facing Slieve Gullion.</h1>
        <p class="yw-hero-sub">
          A single-level bungalow sleeping six, with three en-suite bedrooms, heated floors
          throughout, a sunlit patio, and dogs welcome.
        </p>
        <div class="yw-hero-action">
          <a class="yw-btn yw-btn--moss" href="#enquire">Send a direct stay enquiry</a>
        </div>
      </div>

      <div class="yw-wrap yw-hero-stage">
        <div class="yw-hero-media">
          <ResponsiveImage
            src="/media/concepts/yew-wood-cottage/yew-wood-morning-view.jpg"
            alt="Sunlit stone cottage patio with two ceramic coffee mugs overlooking green South Armagh fields and Slieve Gullion in morning mist"
            width={1376}
            height={768}
            loading="eager"
            sizes="(max-width: 1240px) 100vw, 1240px"
            class="yw-hero-img"
          />
        </div>
        <p class="yw-hero-caption">
          Morning patio looking across South Armagh toward Slieve Gullion. Indicative visualisation.
        </p>
      </div>
    </section>

    <section class="yw-section yw-cottage" id="cottage" aria-labelledby="yw-cottage-title">
      <div class="yw-wrap">
        <div class="yw-section-head">
          <h2 id="yw-cottage-title">Inside the bungalow, all on one level.</h2>
          <p class="yw-section-copy yw-section-copy--dark">
            Set back on Foughilletra Road between Jonesborough and Forkhill, with heated floors in
            every room, three private en-suites, and wide views toward the hills.
          </p>
        </div>

        <div class="yw-tabs" role="tablist" aria-label="Inside Yew Wood Cottage">
          {cottageSpaces.map((space, idx) => (
            <button
              type="button"
              role="tab"
              id={`yw-tab-${space.id}`}
              aria-selected={idx === 0 ? "true" : "false"}
              aria-controls={`yw-panel-${space.id}`}
              tabindex={idx === 0 ? "0" : "-1"}
              class={`yw-tab${idx === 0 ? " is-active" : ""}`}
              data-yw-tab={space.id}
            >
              {space.tabLabel}
            </button>
          ))}
        </div>

        <div class="yw-cottage-layout">
          <figure class="yw-plate">
            <ResponsiveImage
              src="/media/concepts/yew-wood-cottage/yew-wood-hearth-interior.jpg"
              alt="Bright open-plan country cottage living room with pale stone floors, linen sofa, oak dining table, wood stove, and tall windows framing green South Armagh hills"
              width={1200}
              height={896}
              sizes="(max-width: 960px) 100vw, 52vw"
              class="yw-plate-img"
            />
            <figcaption>Open-plan living room, stove, and heated stone floors. Indicative visualisation.</figcaption>
          </figure>

          <div class="yw-cottage-panels">
            {cottageSpaces.map((space, idx) => (
              <article
                id={`yw-panel-${space.id}`}
                role="tabpanel"
                aria-labelledby={`yw-tab-${space.id}`}
                class={`yw-cottage-panel${idx === 0 ? " is-active" : ""}`}
                data-yw-panel={space.id}
                hidden={idx !== 0}
              >
                <h3>{space.title}</h3>
                <p>{space.summary}</p>
                <dl class="yw-spec-list">
                  {space.details.map((row) => (
                    <div class="yw-spec-row">
                      <dt>{row.label}</dt>
                      <dd>{row.value}</dd>
                    </div>
                  ))}
                </dl>
                <a class="yw-btn yw-btn--light" href="#enquire">Ask about your dates</a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="yw-section yw-area" id="area" aria-labelledby="yw-area-title">
      <div class="yw-wrap">
        <div class="yw-section-head">
          <h2 id="yw-area-title">On the lane in South Armagh, six miles to Newry and eight to Dundalk.</h2>
          <p class="yw-section-copy">
            Forest trails, traditional Irish music, village essentials in Meigh, and Carlingford
            Lough are all an easy drive from Foughilletra Road.
          </p>
        </div>

        <ul class="yw-nearby-ledger">
          {nearby.map((item) => (
            <li class="yw-nearby-row">
              <div class="yw-nearby-head">
                <h3>{item.group}</h3>
                <span>{item.distance}</span>
              </div>
              <p>{item.detail}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="yw-section yw-enquire" id="enquire" aria-labelledby="yw-enquire-title">
      <div class="yw-wrap yw-enquire-grid">
        <div class="yw-enquire-intro">
          <h2 id="yw-enquire-title">Ask about your dates directly.</h2>
          <p>
            Write directly to the owners with your preferred dates, group size, and whether you are
            bringing a dog, or ring <a href={mobileHref}>{mobile}</a> to check availability.
          </p>

          <dl class="yw-contact-list">
            <div class="yw-contact-row">
              <dt>Mobile</dt>
              <dd><a href={mobileHref}>{mobile}</a></dd>
            </div>
            <div class="yw-contact-row">
              <dt>Landline</dt>
              <dd><a href={landlineHref}>{landline}</a></dd>
            </div>
            <div class="yw-contact-row">
              <dt>Email</dt>
              <dd><a href={`mailto:${email}`}>{email}</a></dd>
            </div>
            <div class="yw-contact-row">
              <dt>Address</dt>
              <dd>25 Foughilletra Road, Jonesborough, Newry, County Armagh, BT35 8JE</dd>
            </div>
            <div class="yw-contact-row">
              <dt>Directions</dt>
              <dd><a href={mapHref} rel="noopener noreferrer">Open Google Maps</a></dd>
            </div>
          </dl>
        </div>

        <form class="yw-form" id="yw-form" data-email={email}>
          <div class="yw-row">
            <label>
              <span>Check-in date</span>
              <input type="date" name="checkin" required />
            </label>
            <label>
              <span>Check-out date</span>
              <input type="date" name="checkout" required />
            </label>
          </div>

          <div class="yw-row">
            <label>
              <span>Guests (up to 6)</span>
              <select name="guests">
                <option value="2 guests">2 guests</option>
                <option value="3 to 4 guests" selected>3 to 4 guests</option>
                <option value="5 to 6 guests">5 to 6 guests</option>
              </select>
            </label>
            <label>
              <span>Bringing a dog?</span>
              <select name="pets">
                <option value="No">No pets</option>
                <option value="Yes, bringing a dog">Yes, bringing a dog</option>
              </select>
            </label>
          </div>

          <div class="yw-row">
            <label>
              <span>Your name</span>
              <input name="name" type="text" autocomplete="name" placeholder="Full name" required />
            </label>
            <label>
              <span>Telephone</span>
              <input name="phone" type="tel" autocomplete="tel" placeholder="028 or 07..." required />
            </label>
          </div>

          <label>
            <span>Notes for your stay</span>
            <textarea name="notes" rows="3" placeholder="Arrival time, accessibility notes, or dog details..."></textarea>
          </label>

          <p class="yw-form-echo" data-yw-echo aria-live="polite">
            3 nights, 3 to 4 guests, No pets
          </p>

          <button class="yw-btn yw-btn--moss" type="submit">Send direct stay enquiry</button>
        </form>
      </div>
    </section>

    <section class="yw-section yw-map-band" id="location" aria-labelledby="yw-location-title">
      <div class="yw-wrap">
        <div class="yw-section-head">
          <h2 id="yw-location-title">Foughilletra Road in the Ring of Gullion.</h2>
          <p class="yw-section-copy">
            Quiet countryside between Jonesborough and Forkhill, minutes from Slieve Gullion Forest
            Park, Newry, Camlough Lake, and Carlingford.
          </p>
        </div>

        <LocalAreaMap
          id="yew-wood-map"
          kicker=""
          businessName="Yew Wood Cottage"
          address="25 Foughilletra Road, Jonesborough, Newry, BT35 8JE"
          lon={-6.389}
          lat={54.108}
          spanKm={16}
          mapHref={mapHref}
          markers={[
            { name: "Slieve Gullion", lon: -6.433, lat: 54.123, note: "Forest Park nearby", side: "l" },
            { name: "Newry", lon: -6.340, lat: 54.176, note: "6 miles", side: "r" },
            { name: "Camlough Lake", lon: -6.402, lat: 54.184, note: "Fishing nearby", side: "l" },
            { name: "Carlingford", lon: -6.185, lat: 54.042, note: "15 mins", side: "r" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="yw-footer">
    <div class="yw-wrap yw-footer-inner">
      <div class="yw-footer-brand">
        <YwMark size={26} tone="cream" />
        <div>
          <strong>Yew Wood Cottage</strong>
          <p>25 Foughilletra Road, Jonesborough, Newry, County Armagh, BT35 8JE</p>
        </div>
      </div>
      <div class="yw-footer-links">
        <a href={mobileHref}>{mobile}</a>
        <a href={landlineHref}>{landline}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href="#top">Back to top</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      // Sticky header subtle border separation once scrolled
      const header = document.querySelector("[data-yw-header]");
      const sentinel = document.querySelector("[data-yw-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            header.classList.toggle("is-scrolled", !entries[0].isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      // Interactive Inside the Bungalow segmented tablist
      const tabs = Array.from(document.querySelectorAll("[data-yw-tab]"));
      const panels = Array.from(document.querySelectorAll("[data-yw-panel]"));

      const activateTab = (targetId, moveFocus = false) => {
        tabs.forEach((tab) => {
          const active = tab.getAttribute("data-yw-tab") === targetId;
          tab.classList.toggle("is-active", active);
          tab.setAttribute("aria-selected", active ? "true" : "false");
          tab.setAttribute("tabindex", active ? "0" : "-1");
          if (active && moveFocus) tab.focus();
        });
        panels.forEach((panel) => {
          const active = panel.getAttribute("data-yw-panel") === targetId;
          panel.classList.toggle("is-active", active);
          panel.hidden = !active;
        });
      };

      tabs.forEach((tab, idx) => {
        tab.addEventListener("click", () => {
          const id = tab.getAttribute("data-yw-tab");
          if (id) activateTab(id);
        });
        tab.addEventListener("keydown", (e) => {
          if (e.key !== "ArrowRight" && e.key !== "ArrowLeft" && e.key !== "Home" && e.key !== "End") return;
          e.preventDefault();
          let next = idx;
          if (e.key === "ArrowRight") next = (idx + 1) % tabs.length;
          if (e.key === "ArrowLeft") next = (idx - 1 + tabs.length) % tabs.length;
          if (e.key === "Home") next = 0;
          if (e.key === "End") next = tabs.length - 1;
          const nextId = tabs[next]?.getAttribute("data-yw-tab");
          if (nextId) activateTab(nextId, true);
        });
      });

      // Direct stay enquiry dates, live echo, and mm:enquiry dispatch on window
      const form = document.getElementById("yw-form");
      const echo = document.querySelector("[data-yw-echo]");
      const ci = form?.querySelector('input[name="checkin"]');
      const co = form?.querySelector('input[name="checkout"]');
      const iso = (d) => d.toISOString().slice(0, 10);

      if (ci && co) {
        const start = new Date();
        start.setDate(start.getDate() + 14);
        const end = new Date(start);
        end.setDate(end.getDate() + 3);
        ci.min = iso(new Date());
        ci.value = iso(start);
        co.min = iso(start);
        co.value = iso(end);
      }

      const updateEcho = () => {
        if (!form || !echo) return;
        const checkin = ci?.value || "";
        const checkout = co?.value || "";
        const guests = form.querySelector('select[name="guests"]')?.value || "3 to 4 guests";
        const petsSelect = form.querySelector('select[name="pets"]');
        const petsLabel = petsSelect?.selectedOptions?.[0]?.textContent || "No pets";
        let nightsText = "";
        if (checkin && checkout) {
          const d1 = new Date(`${checkin}T12:00:00`);
          const d2 = new Date(`${checkout}T12:00:00`);
          const diff = Math.round((d2.getTime() - d1.getTime()) / 86400000);
          if (diff > 0) {
            const fromStr = d1.toLocaleDateString("en-GB", { day: "numeric", month: "short" });
            nightsText = `${diff} ${diff === 1 ? "night" : "nights"} from ${fromStr}`;
          }
        }
        const parts = [nightsText, guests, petsLabel].filter(Boolean);
        echo.textContent = parts.join(", ");
      };

      if (form) {
        form.addEventListener("input", updateEcho);
        form.addEventListener("change", updateEcho);
        updateEcho();

        form.addEventListener("submit", (event) => {
          event.preventDefault();
          if (!form.reportValidity()) return;
          const d = new FormData(form);
          const body = [
            `Check-in: ${d.get("checkin") || ""}`,
            `Check-out: ${d.get("checkout") || ""}`,
            `Guests: ${d.get("guests") || ""}`,
            `Bringing a dog: ${d.get("pets") || "No"}`,
            `Name: ${d.get("name") || ""}`,
            `Telephone: ${d.get("phone") || ""}`,
            `Notes: ${d.get("notes") || "None"}`,
          ].join("\n");
          const to = form.getAttribute("data-email") || "stay@yewwoodcottage.com";
          const subject = `Stay enquiry: ${d.get("checkin") || "Yew Wood Cottage"}`;
          const url = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
          const ev = new CustomEvent("mm:enquiry", {
            cancelable: true,
            detail: {
              to,
              subject,
              body,
              url,
              phone: "07831 647729",
              phoneHref: "tel:+447831647729",
            },
          });
          if (window.dispatchEvent(ev)) {
            window.location.href = url;
          }
        });
      }
    })();
  </script>
</ConceptLayout>
