---
interface Props {
  size?: number;
  tone?: "yew" | "cream" | "terracotta" | "current";
}
const { size = 40, tone = "yew" } = Astro.props;
const stroke =
  tone === "current"
    ? "currentColor"
    : tone === "cream"
      ? "#f3f5f2"
      : tone === "terracotta"
        ? "#c46b45"
        : "#152920";
---
<svg width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <rect x="3" y="3" width="42" height="42" rx="6" stroke={stroke} stroke-width="1.5" />
  <path d="M10 27L24 14L38 27" stroke={stroke} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M15 24V36H33V24" stroke={stroke} stroke-width="1.6" stroke-linejoin="round" />
  <path d="M24 36V28M24 28C21.5 27.5 20.5 25.5 21.5 23.5M24 28C26.5 27.5 27.5 25.5 26.5 23.5" stroke={stroke} stroke-width="1.4" stroke-linecap="round" />
</svg>
