---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import "./styles.css";

/* Ring of Gullion Cycles, 140 Forkhill Road, Drumintee, Newry BT35 8SY.
   Verified live 27 Nov 2026: ringofgullioncycles.co.uk mixes Cube, Cannondale, Colnago, Fuji & Transition bikes with Rolly Toys.
   Contacts: 028 3088 8352, ringofgullioncycles@outlook.com.
   Hours: Mon-Fri 09:30-17:30, Sat 10:00-17:00, Sun 12:00-16:00. */
const phone = "028 3088 8352";
const phoneHref = "tel:+442830888352";
const email = "ringofgullioncycles@outlook.com";
const shopHref = "https://ringofgullioncycles.co.uk/";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Ring+of+Gullion+Cycles+140+Forkhill+Road+Drumintee+Newry+BT35+8SY";

const dropdownCategories = [
  {
    id: "road",
    tab: "bikes",
    title: "Road and gravel",
    desc: "Colnago, Cannondale and Fuji frames built for South Armagh climbs.",
    img: "/media/concepts/ring-of-gullion-cycles/gullion-cycles-mountain-road-640.webp",
    caption: "In-store frame sizing for road and gravel",
  },
  {
    id: "mtb",
    tab: "bikes",
    title: "Mountain and trail",
    desc: "Cube and Transition trail bikes tuned for Slieve Gullion and Rostrevor.",
    img: "/media/concepts/ring-of-gullion-cycles/gullion-cycles-showroom-640.webp",
    caption: "Suspension setup on the Drumintee stand",
  },
  {
    id: "ebikes",
    tab: "sizing",
    title: "Electric bikes",
    desc: "Bosch-powered Cube and Cannondale e-bikes with Cycle to Work support.",
    img: "/media/concepts/ring-of-gullion-cycles/gullion-cycles-showroom-640.webp",
    caption: "Bosch e-bike fitting and local aftercare",
  },
  {
    id: "family",
    tab: "workshop",
    title: "Kids and Rolly Toys",
    desc: "Junior bikes and genuine Rolly pedal tractors built ready to ride.",
    img: "/media/concepts/ring-of-gullion-cycles/gullion-cycles-mountain-road-640.webp",
    caption: "Safety-checked in our Forkhill Road workshop",
  },
];

const showroomTabs = [
  {
    id: "bikes",
    label: "Bikes",
    intro: "Six specialist marques stocked on Forkhill Road, from carbon road frames and Bosch e-bikes to junior cycles and Rolly Toys.",
    items: [
      {
        id: "road",
        title: "Colnago, Cannondale and Fuji road and gravel",
        detail: "Performance carbon road and all-road gravel frames matched to your riding posture and local South Armagh climbs.",
        meta: "Authorised stockist",
      },
      {
        id: "mtb",
        title: "Cube and Transition mountain bikes",
        detail: "Hardtail, trail and gravity-ready full-suspension rigs set up for Slieve Gullion, Rostrevor and Castlewellan singletrack.",
        meta: "Trail setup",
      },
      {
        id: "ebikes",
        title: "Cube and Cannondale electric bikes",
        detail: "Bosch-powered electric hybrids and e-MTBs built in Drumintee with full local diagnostics and aftercare.",
        meta: "Bosch systems",
      },
      {
        id: "family",
        title: "Kids bikes and Rolly Toys",
        detail: "Lightweight junior cycles and genuine Rolly pedal tractors and trailers built in-store ready for the lane.",
        meta: "Built ready",
      },
    ],
  },
  {
    id: "sizing",
    label: "Sizing",
    intro: "Every adult and junior bike leaves Drumintee matched to your height, reach and terrain rather than straight out of a cardboard box.",
    items: [
      {
        id: "fit",
        title: "In-store frame sizing and reach check",
        detail: "Try Cube, Cannondale, Colnago, Fuji and Transition geometry in person before committing to a frame size.",
        meta: "Open 7 days",
      },
      {
        id: "cycle-to-work",
        title: "Cycle to Work scheme guidance",
        detail: "Bring your workplace scheme details and we will match commuter, road or Bosch e-bike floor stock cleanly.",
        meta: "Scheme support",
      },
      {
        id: "weekend-visits",
        title: "Weekend and Sunday afternoon calls",
        detail: "Minutes from Slieve Gullion Forest Park and the Dundalk border, with Saturday and Sunday hours for family visits.",
        meta: "Sun 12:00 to 16:00",
      },
    ],
  },
  {
    id: "workshop",
    label: "Workshop",
    intro: "Dedicated mechanical setup, suspension tuning and safety checks handled on the stand at 140 Forkhill Road.",
    items: [
      {
        id: "setup",
        title: "Full mechanical build and gearing setup",
        detail: "Brakes, drivetrains and cockpit ergonomics dialled in before collection so your first ride feels planted.",
        meta: "On the stand",
      },
      {
        id: "suspension",
        title: "Suspension servicing and trail prep",
        detail: "Fork and shock servicing, tubeless checks and trail readiness for riders heading up Slieve Gullion or Rostrevor.",
        meta: "MTB and e-MTB",
      },
      {
        id: "aftercare",
        title: "E-bike and family bike aftercare",
        detail: "Ongoing mechanical maintenance, spares and safety checks for Bosch electric bikes and children's cycles.",
        meta: "Local support",
      },
    ],
  },
];

const rangeGroups = [
  {
    id: "adult",
    label: "Road, MTB, Gravel and E-Bikes",
    items: [
      { name: "Cube and Cannondale E-Bikes and MTB", note: "Full-suspension trail bikes, hardtails and Bosch-powered electric bikes fitted properly in Drumintee", meta: "In-store sizing" },
      { name: "Colnago, Fuji and Transition", note: "Performance carbon road, gravel and gravity-ready mountain frames with full setup", meta: "Authorised stockist" },
      { name: "Workshop and Cycle to Work", note: "Full mechanical setup, suspension servicing and Cycle to Work scheme support", meta: "Open 7 days" },
    ],
  },
  {
    id: "family",
    label: "Kids Bikes and Rolly Ride-Ons",
    items: [
      { name: "Junior and Kids Mountain Bikes", note: "Lightweight children's bikes built and safety-checked ready for family spins", meta: "Ready to ride" },
      { name: "Rolly Toys and Pedal Tractors", note: "Genuine Rolly pedal tractors, trailers and farm ride-ons stocked for South Armagh and Down families", meta: "In stock" },
    ],
  },
];
---

<ConceptLayout
  title="Ring of Gullion Cycles | Bikes, E-Bikes and Workshop, Drumintee, Newry"
  slug="ring-of-gullion-cycles"
  bodyClass="concept-page concept-gullioncycles"
  businessName="Ring of Gullion Cycles"
  town="Drumintee, Newry"
  bannerNote="Imagery comprises indicative cycle showroom and Slieve Gullion mountain-road cycling visualisations."
>
  <header class="rgc-header" data-rgc-header>
    <div class="rgc-header-inner">
      <a class="rgc-brand" href="#top">Ring of Gullion Cycles</a>

      <nav class="rgc-nav" aria-label="Primary">
        <div class="rgc-dd-wrap" data-rgc-dd>
          <button
            type="button"
            class="rgc-nav-link rgc-dd-trigger"
            aria-expanded="false"
            aria-controls="rgc-bikes-menu"
            data-rgc-dd-trigger
          >
            <span>Bikes</span>
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2.5 4.5L6 8l3.5-3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          <div class="rgc-dd-panel" id="rgc-bikes-menu" hidden data-rgc-dd-panel>
            <ul class="rgc-dd-list">
              {dropdownCategories.map((cat, idx) => (
                <li>
                  <a
                    href="#brands"
                    class:list={["rgc-dd-item", idx === 0 && "is-active"]}
                    data-rgc-dd-item
                    data-tab={cat.tab}
                    data-focus-item={cat.id}
                    data-img={cat.img}
                    data-caption={cat.caption}
                  >
                    <strong>{cat.title}</strong>
                    <span>{cat.desc}</span>
                  </a>
                </li>
              ))}
            </ul>
            <div class="rgc-dd-preview" aria-hidden="true">
              <img
                src={dropdownCategories[0].img}
                alt=""
                width="640"
                height="349"
                data-rgc-dd-img
              />
              <p class="rgc-dd-caption" data-rgc-dd-caption>{dropdownCategories[0].caption}</p>
            </div>
          </div>
        </div>

        <a class="rgc-nav-link" href="#hours">Hours</a>
        <a class="rgc-nav-link" href="#enquire">Sizing</a>
        <a class="rgc-nav-link" href="#location">Drumintee</a>
      </nav>

      <div class="rgc-header-actions">
        <a class="rgc-header-tel" href={phoneHref}>{phone}</a>
        <a class="rgc-header-cta" href={shopHref} target="_blank" rel="noopener noreferrer">Online store</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="rgc-hero" aria-labelledby="rgc-hero-title">
      <span class="rgc-hero-sentinel" aria-hidden="true" data-rgc-sentinel></span>
      <div class="rgc-hero-media">
        <picture>
          <source srcset="/media/concepts/ring-of-gullion-cycles/gullion-cycles-showroom-640.webp 640w, /media/concepts/ring-of-gullion-cycles/gullion-cycles-showroom-1265.webp 1265w" sizes="100vw" type="image/webp" />
          <img
            src="/media/concepts/ring-of-gullion-cycles/gullion-cycles-showroom.jpg"
            alt="Modern cycle showroom with matte-black carbon road bike, trail mountain bike and olive electric hybrid displayed on steel and oak racks"
            width="1408"
            height="768"
            loading="eager"
          />
        </picture>
        <div class="rgc-hero-scrim" aria-hidden="true"></div>
      </div>

      <div class="rgc-wrap rgc-hero-stage">
        <div class="rgc-hero-lockup">
          <h1 id="rgc-hero-title" class="rgc-reveal rgc-reveal-1">
            Built for Gullion roads and trails.
          </h1>
          <div class="rgc-hero-foot rgc-reveal rgc-reveal-2">
            <div class="rgc-hero-copy">
              <p>
                Cube, Cannondale, Colnago, Fuji and Transition bikes built and sized in Drumintee, open seven days.
              </p>
              <a class="rgc-primary-btn" href="#enquire">Book a bike fit</a>
            </div>
            <p class="rgc-hero-caption">Indicative Drumintee showroom visualisation.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="rgc-band rgc-band--stone" id="brands" aria-labelledby="rgc-br-title">
      <div class="rgc-wrap rgc-split">
        <div class="rgc-col">
          <h2 id="rgc-br-title">Six specialist marques, one Drumintee workshop.</h2>

          <div class="rgc-tabs" role="tablist" aria-label="Bikes, sizing and workshop">
            {showroomTabs.map((tab, idx) => (
              <button
                type="button"
                role="tab"
                id={`rgc-tab-${tab.id}`}
                aria-selected={idx === 0 ? "true" : "false"}
                aria-controls={`rgc-panel-${tab.id}`}
                tabindex={idx === 0 ? 0 : -1}
                class:list={["rgc-tab", idx === 0 && "is-active"]}
                data-rgc-tab={tab.id}
              >
                {tab.label}
              </button>
            ))}
          </div>

          {showroomTabs.map((tab, idx) => (
            <div
              id={`rgc-panel-${tab.id}`}
              role="tabpanel"
              aria-labelledby={`rgc-tab-${tab.id}`}
              hidden={idx !== 0}
              class="rgc-panel"
              data-rgc-panel={tab.id}
            >
              <p class="rgc-panel-intro">{tab.intro}</p>
              <ul class="rgc-ledger">
                {tab.items.map((item) => (
                  <li class="rgc-ledger-row" data-rgc-row={item.id}>
                    <div class="rgc-ledger-main">
                      <h3>{item.title}</h3>
                      <p>{item.detail}</p>
                    </div>
                    <span class="rgc-ledger-meta">{item.meta}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}

          <div class="rgc-sheet-row">
            <SpecimenSheet
              id="rgc-brands-sheet"
              triggerLabel="Browse full brands and stock guide"
              kicker="Ring of Gullion Cycles, Drumintee"
              title="Bikes, E-Bikes and Rolly Ride-Ons"
              subtitle="Open Monday through Sunday. Call 028 3088 8352 to hold a model or arrange a fit."
              groups={rangeGroups}
              ctaLabel="Browse online store ↗"
              ctaHref={shopHref}
              ctaExternal={true}
              secondaryLabel={`Call ${phone}`}
              secondaryHref={phoneHref}
              buttonClass="rgc-sheet-trigger"
            />
          </div>
        </div>

        <div class="rgc-col" id="hours">
          <figure class="rgc-plate">
            <picture>
              <source srcset="/media/concepts/ring-of-gullion-cycles/gullion-cycles-mountain-road-640.webp 640w, /media/concepts/ring-of-gullion-cycles/gullion-cycles-mountain-road-1265.webp 1265w" sizes="(max-width: 900px) 100vw, 46vw" type="image/webp" />
              <img
                src="/media/concepts/ring-of-gullion-cycles/gullion-cycles-mountain-road.jpg"
                alt="Gravel and mountain bike resting beside a mossy granite wall overlooking Slieve Gullion hills at dawn"
                width="1408"
                height="768"
                loading="lazy"
              />
            </picture>
            <figcaption>Indicative Slieve Gullion road visualisation.</figcaption>
          </figure>

          <div class="rgc-hours-block">
            <h3>Showroom and workshop hours</h3>
            <dl class="rgc-hours-list">
              <div><dt>Monday to Friday</dt><dd>09:30 to 17:30</dd></div>
              <div><dt>Saturday</dt><dd>10:00 to 17:00</dd></div>
              <div><dt>Sunday</dt><dd>12:00 to 16:00</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="rgc-band rgc-band--obsidian" id="enquire" aria-labelledby="rgc-enq-title">
      <div class="rgc-wrap rgc-split rgc-split--enquire">
        <div class="rgc-col">
          <h2 id="rgc-enq-title">Ask about frame sizes, electric bikes or Cycle to Work.</h2>
          <p class="rgc-dark-copy">
            Tell us what you ride and roughly your height. We will confirm current Drumintee floor
            stock, or you can ring the shop directly on <a href={phoneHref}>{phone}</a>.
          </p>
          <p class="rgc-email-line">Email <a href={`mailto:${email}`}>{email}</a></p>
        </div>

        <div class="rgc-col">
          <form class="rgc-form" data-rgc-form>
            <div class="rgc-form-row">
              <label>
                <span>Your name</span>
                <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
              </label>
              <label>
                <span>Telephone</span>
                <input name="phone" type="tel" required autocomplete="tel" placeholder="028 or 07..." />
              </label>
            </div>
            <div class="rgc-form-row">
              <label>
                <span>Bike category</span>
                <select name="category">
                  <option value="Electric bike (e-bike)">Electric bike (e-bike)</option>
                  <option value="Mountain or trail bike">Mountain or trail bike</option>
                  <option value="Road or gravel bike">Road or gravel bike</option>
                  <option value="Kids bike or Rolly Toy">Kids bike or Rolly Toy</option>
                  <option value="Workshop service">Workshop service</option>
                </select>
              </label>
              <label>
                <span>Rider height or size</span>
                <input name="size" type="text" placeholder="e.g. 5'10 or Medium" />
              </label>
            </div>
            <label>
              <span>Models or questions</span>
              <textarea name="notes" rows="3" placeholder="Preferred brand (Cube, Cannondale, Colnago, Fuji, Transition) or Cycle to Work details."></textarea>
            </label>
            <button class="rgc-primary-btn rgc-submit-btn" type="submit">Send stock enquiry</button>
          </form>
        </div>
      </div>
    </section>

    <section class="rgc-band rgc-band--obsidian rgc-map-band" id="location" aria-label="Drumintee Forkhill Road map">
      <div class="rgc-wrap">
        <LocalAreaMap
          id="rgc-map"
          tone="dark"
          kicker=""
          businessName="Ring of Gullion Cycles"
          address="140 Forkhill Road, Drumintee, Newry, BT35 8SY"
          lon={-6.4161}
          lat={54.0980}
          spanKm={18}
          mapHref={mapsHref}
          markers={[
            { name: "Slieve Gullion Park", lon: -6.4472, lat: 54.1223, note: "7 mins north-west", side: "l" },
            { name: "Newry City", lon: -6.3402, lat: 54.1751, note: "14 mins north-east", side: "t" },
            { name: "Dundalk", lon: -6.4059, lat: 54.0007, note: "14 mins south", side: "b" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="rgc-footer">
    <div class="rgc-wrap rgc-footer-inner">
      <div>
        <strong class="rgc-footer-brand">Ring of Gullion Cycles</strong>
        <p>140 Forkhill Road, Drumintee, Newry, BT35 8SY</p>
      </div>
      <div class="rgc-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={shopHref} target="_blank" rel="noopener noreferrer">Online store ↗</a>
        <a href={mapsHref} target="_blank" rel="noopener noreferrer">Directions ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-rgc-header]");
      const sentinel = document.querySelector("[data-rgc-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            header.classList.toggle("is-scrolled", !entries[0].isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      const tabs = [...document.querySelectorAll("[data-rgc-tab]")];
      const panels = [...document.querySelectorAll("[data-rgc-panel]")];
      const activateTab = (id, focusTab = false) => {
        tabs.forEach((btn) => {
          const active = btn.dataset.rgcTab === id;
          btn.classList.toggle("is-active", active);
          btn.setAttribute("aria-selected", active ? "true" : "false");
          btn.tabIndex = active ? 0 : -1;
          if (active && focusTab) btn.focus();
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.rgcPanel !== id;
        });
      };

      tabs.forEach((btn, idx) => {
        btn.addEventListener("click", () => activateTab(btn.dataset.rgcTab));
        btn.addEventListener("keydown", (e) => {
          if (e.key === "ArrowRight") {
            e.preventDefault();
            activateTab(tabs[(idx + 1) % tabs.length].dataset.rgcTab, true);
          } else if (e.key === "ArrowLeft") {
            e.preventDefault();
            activateTab(tabs[(idx - 1 + tabs.length) % tabs.length].dataset.rgcTab, true);
          }
        });
      });

      const ddWrap = document.querySelector("[data-rgc-dd]");
      const trigger = ddWrap?.querySelector("[data-rgc-dd-trigger]");
      const panel = ddWrap?.querySelector("[data-rgc-dd-panel]");
      const previewImg = ddWrap?.querySelector("[data-rgc-dd-img]");
      const previewCaption = ddWrap?.querySelector("[data-rgc-dd-caption]");
      const items = ddWrap ? [...ddWrap.querySelectorAll("[data-rgc-dd-item]")] : [];

      if (ddWrap && trigger && panel) {
        const setOpen = (open) => {
          panel.hidden = !open;
          trigger.setAttribute("aria-expanded", open ? "true" : "false");
          ddWrap.classList.toggle("is-open", open);
        };
        trigger.addEventListener("click", (e) => {
          e.stopPropagation();
          setOpen(panel.hidden);
        });
        document.addEventListener("click", (e) => {
          if (!ddWrap.contains(e.target)) setOpen(false);
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") setOpen(false);
        });
        items.forEach((item) => {
          const preview = () => {
            items.forEach((i) => i.classList.toggle("is-active", i === item));
            if (previewImg && item.dataset.img) previewImg.src = item.dataset.img;
            if (previewCaption && item.dataset.caption) previewCaption.textContent = item.dataset.caption;
          };
          item.addEventListener("mouseenter", preview);
          item.addEventListener("focus", preview);
          item.addEventListener("click", () => {
            if (item.dataset.tab) activateTab(item.dataset.tab);
            setOpen(false);
          });
        });
      }

      const form = document.querySelector("[data-rgc-form]");
      if (form) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;
          const fd = new FormData(form);
          const subject = `Bike enquiry: ${fd.get("category")} (${fd.get("name")})`;
          const body = [
            `Name: ${fd.get("name")}`,
            `Phone: ${fd.get("phone")}`,
            `Category: ${fd.get("category")}`,
            `Rider height or size: ${fd.get("size") || "Not specified"}`,
            `Notes: ${fd.get("notes") || "None"}`,
          ].join("\n");
          const ev = new CustomEvent("mm:enquiry", {
            cancelable: true,
            detail: { to: "ringofgullioncycles@outlook.com", subject, body },
          });
          if (window.dispatchEvent(ev)) {
            window.location.href = `mailto:ringofgullioncycles@outlook.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
          }
        });
      }
    })();
  </script>
</ConceptLayout>
