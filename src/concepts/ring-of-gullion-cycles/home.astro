---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import "./styles.css";

/* Ring of Gullion Cycles — 140 Forkhill Road, Drumintee, Newry BT35 8SY.
   Verified live 27 Nov 2026: ringofgullioncycles.co.uk renders title as lowercase unspaced `ringofgullioncycles`
   on a generic Shopify theme mixing Cube, Cannondale, Colnago, Fuji & Transition bikes with Rolly Toys.
   Contacts: 028 3088 8352, ringofgullioncycles@outlook.com.
   Hours: Mon–Fri 09:30–17:30, Sat 10:00–17:00, Sun 12:00–16:00. */
const phone = "028 3088 8352";
const phoneHref = "tel:+442830888352";
const email = "ringofgullioncycles@outlook.com";
const shopHref = "https://ringofgullioncycles.co.uk/";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Ring+of+Gullion+Cycles+140+Forkhill+Road+Drumintee+Newry+BT35+8SY";

const rangeGroups = [
  {
    id: "adult",
    label: "Road, MTB, Gravel & E-Bikes",
    items: [
      { name: "Cube & Cannondale E-Bikes & MTB", note: "Full-suspension trail bikes, hardtails and Bosch-powered electric bikes fitted properly in Drumintee", meta: "In-store sizing" },
      { name: "Colnago, Fuji & Transition", note: "Performance carbon road, gravel and gravity-ready mountain frames with full setup", meta: "Authorised stockist" },
      { name: "Workshop & Cycle to Work", note: "Full mechanical setup, suspension servicing and Cycle to Work scheme support", meta: "Open 7 days" },
    ],
  },
  {
    id: "family",
    label: "Kids Bikes & Rolly Ride-Ons",
    items: [
      { name: "Junior & Kids Mountain Bikes", note: "Lightweight children's bikes built and safety-checked ready for family spins", meta: "Ready to ride" },
      { name: "Rolly Toys & Pedal Tractors", note: "Genuine Rolly pedal tractors, trailers and farm ride-ons stocked for South Armagh & Down families", meta: "In stock" },
    ],
  },
];
---

<ConceptLayout
  title="Ring of Gullion Cycles — E-Bikes, MTB, Road & Rolly Toys, Drumintee, Newry"
  slug="ring-of-gullion-cycles"
  bodyClass="concept-page concept-gullioncycles"
  businessName="Ring of Gullion Cycles"
  town="Drumintee, Newry"
  bannerNote="Imagery comprises indicative cycle showroom and Slieve Gullion mountain-road cycling visualisations."
>
  <header class="rgc-header">
    <div class="rgc-header-inner">
      <a class="rgc-brand" href="#top">
        <strong>Ring of Gullion Cycles</strong>
        <span>Drumintee · 140 Forkhill Road</span>
      </a>
      <nav class="rgc-nav" aria-label="Primary">
        <a href="#brands">Brands &amp; Bikes</a>
        <a href="#hours">7-Day Hours</a>
        <a href="#enquire">Bike Sizing</a>
        <a href="#location">Find Drumintee</a>
      </nav>
      <div class="rgc-header-actions">
        <a class="rgc-header-tel" href={phoneHref}>{phone}</a>
        <a class="rgc-header-cta" href={shopHref} target="_blank" rel="noopener noreferrer">Online Store ↗</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="rgc-hero" aria-labelledby="rgc-hero-title">
      <div class="rgc-wrap rgc-hero-grid">
        <div>
          <p class="rgc-kicker">140 Forkhill Road · Drumintee · Newry · Open 7 Days</p>
          <h1 id="rgc-hero-title">Cube, Cannondale, Colnago &amp; Transition — built for Gullion roads and trails.</h1>
          <p class="rgc-lead">
            Independent cycle specialists in the Ring of Gullion stocking world-class road, MTB and
            e-bike brands alongside kids' bikes and Rolly pedal tractors — open seven days a week.
          </p>
          <div class="rgc-actions">
            <a class="rgc-btn rgc-btn--primary" href="#enquire">Check Frame Size &amp; Stock</a>
            <SpecimenSheet
              id="rgc-brands-sheet"
              triggerLabel="Brands & Stock Guide"
              kicker="Ring of Gullion Cycles · 140 Forkhill Road, Drumintee"
              title="Bikes, E-Bikes & Rolly Ride-Ons"
              subtitle="Open Monday through Sunday — call 028 3088 8352 to hold a model or arrange a fit."
              groups={rangeGroups}
              ctaLabel="Browse Online Store ↗"
              ctaHref={shopHref}
              ctaExternal={true}
              secondaryLabel={`Call ${phone}`}
              secondaryHref={phoneHref}
              buttonClass="rgc-btn rgc-btn--outline"
            />
          </div>
        </div>
        <figure class="rgc-hero-plate">
          <picture>
            <source srcset="/media/concepts/ring-of-gullion-cycles/gullion-cycles-showroom-640.webp 640w, /media/concepts/ring-of-gullion-cycles/gullion-cycles-showroom-1265.webp 1265w" sizes="(max-width: 900px) 100vw, 52vw" type="image/webp" />
            <img src="/media/concepts/ring-of-gullion-cycles/gullion-cycles-showroom.jpg" alt="Modern cycle store showroom displaying carbon road, full-suspension mountain and electric bikes on dark steel and oak wall racks" width="1408" height="768" loading="eager" />
          </picture>
          <figcaption>Drumintee bike showroom. Indicative store visualisation.</figcaption>
        </figure>
      </div>
    </section>

    <section class="rgc-section rgc-brands" id="brands" aria-labelledby="rgc-br-title">
      <div class="rgc-wrap rgc-three">
        <article>
          <span>Performance</span>
          <h2 id="rgc-br-title">Cube, Cannondale &amp; Colnago</h2>
          <p>Properly built road, gravel and Bosch e-bikes matched to your height, riding terrain and budget.</p>
        </article>
        <article>
          <span>Trail &amp; Gravity</span>
          <h3>Fuji &amp; Transition MTB</h3>
          <p>Trail and enduro machines tuned for Slieve Gullion, Rostrevor and Castlewellan singletrack.</p>
        </article>
        <article>
          <span>Family</span>
          <h3>Kids Bikes &amp; Rolly Toys</h3>
          <p>Junior cycles and authentic Rolly pedal tractors assembled in-store so they are ready from day one.</p>
        </article>
      </div>
    </section>

    <section class="rgc-section rgc-trails" id="hours" aria-labelledby="rgc-tr-title">
      <div class="rgc-wrap rgc-split">
        <figure class="rgc-plate">
          <picture>
            <source srcset="/media/concepts/ring-of-gullion-cycles/gullion-cycles-mountain-road-640.webp 640w, /media/concepts/ring-of-gullion-cycles/gullion-cycles-mountain-road-1265.webp 1265w" sizes="(max-width: 860px) 100vw, 48vw" type="image/webp" />
            <img src="/media/concepts/ring-of-gullion-cycles/gullion-cycles-mountain-road.jpg" alt="Gravel and mountain bike resting beside a mossy granite wall overlooking Slieve Gullion hills at dawn" width="1408" height="768" loading="lazy" />
          </picture>
          <figcaption>Ring of Gullion cycling country. Indicative landscape visualisation.</figcaption>
        </figure>
        <div>
          <p class="rgc-kicker">Open 7 Days · Drumintee, Newry</p>
          <h2 id="rgc-tr-title">Call in any day of the week — including Sunday afternoons.</h2>
          <p>
            Minutes from Slieve Gullion Forest Park and the Dundalk border, we stay open seven days
            so weekend riders and families can size bikes, collect spares or try an e-bike in person.
          </p>
          <div class="rgc-hours-card">
            <h3>Showroom &amp; Workshop Hours</h3>
            <dl class="rgc-hours-list">
              <div><dt>Monday – Friday</dt><dd>09:30 – 17:30</dd></div>
              <div><dt>Saturday</dt><dd>10:00 – 17:00</dd></div>
              <div><dt>Sunday</dt><dd>12:00 – 16:00</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="rgc-section rgc-enquire" id="enquire" aria-labelledby="rgc-enq-title">
      <div class="rgc-wrap rgc-split">
        <div>
          <p class="rgc-kicker">Direct Stock &amp; Sizing Enquiry</p>
          <h2 id="rgc-enq-title">Ask about frame sizes, e-bikes or Cycle to Work.</h2>
          <p>
            Drop us a quick message with the style of bike you are after, or ring the shop directly
            on <a href={phoneHref}>{phone}</a>.
          </p>
          <p class="rgc-email-line">Email: <a href={`mailto:${email}`}>{email}</a></p>
        </div>
        <form class="rgc-form" data-rgc-form>
          <div class="rgc-row">
            <label>
              <span>Your name</span>
              <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
            </label>
            <label>
              <span>Telephone</span>
              <input name="phone" type="tel" required autocomplete="tel" placeholder="028 / 07..." />
            </label>
          </div>
          <div class="rgc-row">
            <label>
              <span>Bike category</span>
              <select name="category">
                <option value="Electric Bike (E-Bike)">Electric Bike (E-Bike)</option>
                <option value="Mountain / Trail Bike">Mountain / Trail Bike</option>
                <option value="Road / Gravel Bike">Road / Gravel Bike</option>
                <option value="Kids Bike / Rolly Toy">Kids Bike / Rolly Toy</option>
                <option value="Workshop Service">Workshop Service</option>
              </select>
            </label>
            <label>
              <span>Rider height / size</span>
              <input name="size" type="text" placeholder="e.g. 5'10 / Medium" />
            </label>
          </div>
          <label>
            <span>Models or questions</span>
            <textarea name="notes" rows="3" placeholder="Mention preferred brand (Cube, Cannondale, Colnago, Fuji, Transition) or Cycle to Work..."></textarea>
          </label>
          <button class="rgc-btn rgc-btn--primary" type="submit">Send Stock Enquiry</button>
        </form>
      </div>
    </section>

    <section class="rgc-section" id="location" aria-label="Drumintee Forkhill Road map">
      <div class="rgc-wrap">
        <LocalAreaMap
          id="rgc-map"
          tone="dark"
          kicker="140 Forkhill Road · Drumintee"
          businessName="Ring of Gullion Cycles"
          address="140 Forkhill Road, Drumintee, Newry, BT35 8SY"
          lon={-6.4161}
          lat={54.0980}
          spanKm={18}
          mapHref={mapsHref}
          markers={[
            { name: "Slieve Gullion Park", lon: -6.4472, lat: 54.1223, note: "7 mins north-west", side: "l" },
            { name: "Newry City", lon: -6.3402, lat: 54.1751, note: "14 mins north-east", side: "t" },
            { name: "Dundalk", lon: -6.4059, lat: 54.0007, note: "14 mins south", side: "b" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="rgc-footer">
    <div class="rgc-wrap rgc-footer-inner">
      <div>
        <strong>Ring of Gullion Cycles</strong>
        <p>140 Forkhill Road, Drumintee, Newry, BT35 8SY</p>
      </div>
      <div class="rgc-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={shopHref} target="_blank" rel="noopener noreferrer">Online Store ↗</a>
        <a href={mapsHref} target="_blank" rel="noopener noreferrer">Directions ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const form = document.querySelector("[data-rgc-form]");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        const subject = `Bike Enquiry — ${fd.get("category")} (${fd.get("name")})`;
        const body = [
          `Name: ${fd.get("name")}`,
          `Phone: ${fd.get("phone")}`,
          `Category: ${fd.get("category")}`,
          `Rider Height / Size: ${fd.get("size") || "Not specified"}`,
          `Notes: ${fd.get("notes") || "None"}`,
        ].join("\n");
        const ev = new CustomEvent("mm:enquiry", {
          cancelable: true,
          detail: { to: "ringofgullioncycles@outlook.com", subject, body },
        });
        if (window.dispatchEvent(ev)) {
          window.location.href = `mailto:ringofgullioncycles@outlook.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }
      });
    })();
  </script>
</ConceptLayout>
