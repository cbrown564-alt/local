---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import "./styles.css";

/* Ring of Gullion Cycles — 140 Forkhill Road, Drumintee, Newry BT35 8SY.
   Verified live 27 Nov 2026: ringofgullioncycles.co.uk renders title as lowercase unspaced `ringofgullioncycles`
   on a generic Shopify theme mixing Cube, Cannondale, Colnago, Fuji & Transition bikes with Rolly Toys.
   Contacts: 028 3088 8352, ringofgullioncycles@outlook.com.
   Hours: Mon–Fri 09:30–17:30, Sat 10:00–17:00, Sun 12:00–16:00. */
const phone = "028 3088 8352";
const phoneHref = "tel:+442830888352";
const email = "ringofgullioncycles@outlook.com";
const shopHref = "https://ringofgullioncycles.co.uk/";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Ring+of+Gullion+Cycles+140+Forkhill+Road+Drumintee+Newry+BT35+8SY";

const dropdownCategories = [
  {
    id: "road",
    title: "Road & Gravel",
    desc: "Colnago, Cannondale and Fuji frames built for South Armagh climbs.",
    img: "/media/concepts/ring-of-gullion-cycles/gullion-cycles-mountain-road-640.webp",
    tag: "In-store frame sizing",
  },
  {
    id: "mtb",
    title: "Mountain & Trail",
    desc: "Cube and Transition trail bikes tuned for Slieve Gullion and Rostrevor.",
    img: "/media/concepts/ring-of-gullion-cycles/gullion-cycles-showroom-640.webp",
    tag: "Suspension setup",
  },
  {
    id: "ebikes",
    title: "Electric Bikes",
    desc: "Bosch-powered Cube and Cannondale e-bikes with local aftercare.",
    img: "/media/concepts/ring-of-gullion-cycles/gullion-cycles-showroom-640.webp",
    tag: "Cycle to Work",
  },
  {
    id: "family",
    title: "Kids & Rolly Toys",
    desc: "Junior bikes and genuine Rolly pedal tractors assembled ready to go.",
    img: "/media/concepts/ring-of-gullion-cycles/gullion-cycles-mountain-road-640.webp",
    tag: "Ready from day one",
  },
];

const rangeGroups = [
  {
    id: "adult",
    label: "Road, MTB, Gravel & E-Bikes",
    items: [
      { name: "Cube & Cannondale E-Bikes & MTB", note: "Full-suspension trail bikes, hardtails and Bosch-powered electric bikes fitted properly in Drumintee", meta: "In-store sizing" },
      { name: "Colnago, Fuji & Transition", note: "Performance carbon road, gravel and gravity-ready mountain frames with full setup", meta: "Authorised stockist" },
      { name: "Workshop & Cycle to Work", note: "Full mechanical setup, suspension servicing and Cycle to Work scheme support", meta: "Open 7 days" },
    ],
  },
  {
    id: "family",
    label: "Kids Bikes & Rolly Ride-Ons",
    items: [
      { name: "Junior & Kids Mountain Bikes", note: "Lightweight children's bikes built and safety-checked ready for family spins", meta: "Ready to ride" },
      { name: "Rolly Toys & Pedal Tractors", note: "Genuine Rolly pedal tractors, trailers and farm ride-ons stocked for South Armagh & Down families", meta: "In stock" },
    ],
  },
];
---

<ConceptLayout
  title="Ring of Gullion Cycles — Bikes, E-Bikes & Workshop, Drumintee, Newry"
  slug="ring-of-gullion-cycles"
  bodyClass="concept-page concept-gullioncycles"
  businessName="Ring of Gullion Cycles"
  town="Drumintee, Newry"
  bannerNote="Imagery comprises indicative cycle showroom and Slieve Gullion mountain-road cycling visualisations."
>
  <header class="rgc-header" data-rgc-header>
    <div class="rgc-header-inner">
      <a class="rgc-brand" href="#top">
        <span class="rgc-mark" aria-hidden="true"></span>
        <span>Ring of Gullion Cycles</span>
      </a>

      <nav class="rgc-nav" aria-label="Primary">
        <div class="rgc-dd-wrap" data-rgc-dd>
          <button
            type="button"
            class="rgc-nav-link rgc-dd-trigger"
            aria-expanded="false"
            aria-controls="rgc-bikes-menu"
            data-rgc-dd-trigger
          >
            <span>Bikes</span>
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2.5 4.5L6 8l3.5-3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          <div class="rgc-dd-panel" id="rgc-bikes-menu" hidden data-rgc-dd-panel>
            <ul class="rgc-dd-list">
              {dropdownCategories.map((cat, idx) => (
                <li>
                  <a
                    href="#brands"
                    class:list={["rgc-dd-item", idx === 0 && "is-active"]}
                    data-rgc-dd-item
                    data-img={cat.img}
                    data-tag={cat.tag}
                    data-alt={cat.title}
                  >
                    <strong>{cat.title}</strong>
                    <span>{cat.desc}</span>
                  </a>
                </li>
              ))}
            </ul>
            <div class="rgc-dd-preview" aria-hidden="true">
              <img
                src={dropdownCategories[0].img}
                alt=""
                width="640"
                height="349"
                data-rgc-dd-img
              />
              <span class="rgc-dd-tag" data-rgc-dd-tag>{dropdownCategories[0].tag}</span>
            </div>
          </div>
        </div>

        <a class="rgc-nav-link" href="#hours">Hours</a>
        <a class="rgc-nav-link" href="#enquire">Sizing</a>
        <a class="rgc-nav-link" href="#location">Drumintee</a>
      </nav>

      <div class="rgc-header-actions">
        <a class="rgc-header-tel" href={phoneHref}>{phone}</a>
        <a class="rgc-pill-cta" href={shopHref} target="_blank" rel="noopener noreferrer">
          <span>Online Store</span>
        </a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="rgc-hero" aria-labelledby="rgc-hero-title">
      <figure class="rgc-hero-media">
        <picture>
          <source srcset="/media/concepts/ring-of-gullion-cycles/gullion-cycles-showroom-640.webp 640w, /media/concepts/ring-of-gullion-cycles/gullion-cycles-showroom-1265.webp 1265w" sizes="100vw" type="image/webp" />
          <img
            src="/media/concepts/ring-of-gullion-cycles/gullion-cycles-showroom.jpg"
            alt="Modern cycle showroom with matte-black carbon road bike, trail mountain bike and olive electric hybrid displayed on steel and oak racks"
            width="1408"
            height="768"
            loading="eager"
          />
        </picture>
        <div class="rgc-hero-scrim" aria-hidden="true"></div>
      </figure>

      <div class="rgc-wrap rgc-hero-stage">
        <div class="rgc-hero-headline">
          <h1 id="rgc-hero-title" class="rgc-reveal rgc-reveal-1">
            Built for Gullion<br /><em>roads and trails.</em>
          </h1>
        </div>

        <div class="rgc-hero-foot">
          <div class="rgc-hero-copy rgc-reveal rgc-reveal-2">
            <p>
              Cube, Cannondale, Colnago, Fuji and Transition bikes. Properly built and sized on
              Forkhill Road in Drumintee, open seven days.
            </p>
            <div class="rgc-hero-actions">
              <a class="rgc-arrow-btn" href="#enquire">
                <span class="rgc-arrow-btn-label">Book a bike fit</span>
                <span class="rgc-arrow-circle" aria-hidden="true">
                  <svg class="rgc-arrow rgc-arrow--primary" width="13" height="13" viewBox="0 0 14 14" fill="none">
                    <path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <svg class="rgc-arrow rgc-arrow--clone" width="13" height="13" viewBox="0 0 14 14" fill="none">
                    <path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </a>

              <SpecimenSheet
                id="rgc-brands-sheet"
                triggerLabel="Brands & stock guide"
                kicker="Ring of Gullion Cycles · 140 Forkhill Road, Drumintee"
                title="Bikes, E-Bikes & Rolly Ride-Ons"
                subtitle="Open Monday through Sunday — call 028 3088 8352 to hold a model or arrange a fit."
                groups={rangeGroups}
                ctaLabel="Browse Online Store ↗"
                ctaHref={shopHref}
                ctaExternal={true}
                secondaryLabel={`Call ${phone}`}
                secondaryHref={phoneHref}
                buttonClass="rgc-ghost-link"
              />
            </div>
          </div>

          <div class="rgc-hero-meta rgc-reveal rgc-reveal-3">
            <a class="rgc-scroll-cue" href="#brands">
              <span>Scroll down</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M6 2.5v7M3 6.5L6 9.5l3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <p class="rgc-visual-note">Drumintee showroom · indicative visualisation</p>
          </div>
        </div>
      </div>
    </section>

    <section class="rgc-section rgc-brands" id="brands" aria-labelledby="rgc-br-title">
      <div class="rgc-wrap">
        <div class="rgc-section-head">
          <p class="rgc-eyebrow">What we stock</p>
          <h2 id="rgc-br-title">Six specialist marques, one Drumintee workshop.</h2>
        </div>

        <div class="rgc-three">
          <article>
            <span class="rgc-num">01</span>
            <h3>Cube, Cannondale &amp; Colnago</h3>
            <p>Road, gravel and Bosch-powered electric bikes matched properly to your riding height, gearing and local climbs.</p>
          </article>
          <article>
            <span class="rgc-num">02</span>
            <h3>Fuji &amp; Transition MTB</h3>
            <p>Trail, hardtail and enduro bikes set up on the stand for Slieve Gullion, Rostrevor and Castlewellan singletrack.</p>
          </article>
          <article>
            <span class="rgc-num">03</span>
            <h3>Kids Bikes &amp; Rolly Toys</h3>
            <p>Lightweight junior cycles and genuine Rolly pedal tractors built in-store so they leave ready for the lane.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="rgc-section rgc-trails" id="hours" aria-labelledby="rgc-tr-title">
      <div class="rgc-wrap rgc-split">
        <figure class="rgc-plate">
          <picture>
            <source srcset="/media/concepts/ring-of-gullion-cycles/gullion-cycles-mountain-road-640.webp 640w, /media/concepts/ring-of-gullion-cycles/gullion-cycles-mountain-road-1265.webp 1265w" sizes="(max-width: 860px) 100vw, 48vw" type="image/webp" />
            <img src="/media/concepts/ring-of-gullion-cycles/gullion-cycles-mountain-road.jpg" alt="Gravel and mountain bike resting beside a mossy granite wall overlooking Slieve Gullion hills at dawn" width="1408" height="768" loading="lazy" />
          </picture>
          <figcaption>Slieve Gullion riding country · indicative landscape visualisation.</figcaption>
        </figure>

        <div class="rgc-hours-col">
          <p class="rgc-eyebrow">Open seven days · Forkhill Road</p>
          <h2 id="rgc-tr-title">Call in any day of the week, including Sunday afternoons.</h2>
          <p class="rgc-body">
            Minutes from Slieve Gullion Forest Park and the Dundalk border, we stay open seven days
            so weekend riders and families can size bikes, collect spares or test an e-bike in person.
          </p>

          <div class="rgc-hours-card">
            <h3>Showroom &amp; Workshop</h3>
            <dl class="rgc-hours-list">
              <div><dt>Monday – Friday</dt><dd>09:30 – 17:30</dd></div>
              <div><dt>Saturday</dt><dd>10:00 – 17:00</dd></div>
              <div><dt>Sunday</dt><dd>12:00 – 16:00</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="rgc-section rgc-enquire" id="enquire" aria-labelledby="rgc-enq-title">
      <div class="rgc-wrap rgc-split">
        <div class="rgc-enq-intro">
          <p class="rgc-eyebrow">Direct sizing &amp; stock desk</p>
          <h2 id="rgc-enq-title">Ask about frame sizes, e-bikes or Cycle to Work.</h2>
          <p class="rgc-body">
            Tell us what you ride and roughly your height. We will confirm current Drumintee floor
            stock, or you can ring the shop directly on <a href={phoneHref}>{phone}</a>.
          </p>
          <p class="rgc-email-line">Email <a href={`mailto:${email}`}>{email}</a></p>
        </div>

        <form class="rgc-form" data-rgc-form>
          <div class="rgc-row">
            <label>
              <span>Your name</span>
              <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
            </label>
            <label>
              <span>Telephone</span>
              <input name="phone" type="tel" required autocomplete="tel" placeholder="028 / 07..." />
            </label>
          </div>
          <div class="rgc-row">
            <label>
              <span>Bike category</span>
              <select name="category">
                <option value="Electric Bike (E-Bike)">Electric Bike (E-Bike)</option>
                <option value="Mountain / Trail Bike">Mountain / Trail Bike</option>
                <option value="Road / Gravel Bike">Road / Gravel Bike</option>
                <option value="Kids Bike / Rolly Toy">Kids Bike / Rolly Toy</option>
                <option value="Workshop Service">Workshop Service</option>
              </select>
            </label>
            <label>
              <span>Rider height / size</span>
              <input name="size" type="text" placeholder="e.g. 5'10 / Medium" />
            </label>
          </div>
          <label>
            <span>Models or questions</span>
            <textarea name="notes" rows="3" placeholder="Preferred brand (Cube, Cannondale, Colnago, Fuji, Transition) or Cycle to Work..."></textarea>
          </label>
          <button class="rgc-arrow-btn" type="submit">
            <span class="rgc-arrow-btn-label">Send stock enquiry</span>
            <span class="rgc-arrow-circle" aria-hidden="true">
              <svg class="rgc-arrow rgc-arrow--primary" width="13" height="13" viewBox="0 0 14 14" fill="none">
                <path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <svg class="rgc-arrow rgc-arrow--clone" width="13" height="13" viewBox="0 0 14 14" fill="none">
                <path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </button>
        </form>
      </div>
    </section>

    <section class="rgc-section rgc-map-band" id="location" aria-label="Drumintee Forkhill Road map">
      <div class="rgc-wrap">
        <LocalAreaMap
          id="rgc-map"
          tone="dark"
          kicker="140 Forkhill Road · Drumintee"
          businessName="Ring of Gullion Cycles"
          address="140 Forkhill Road, Drumintee, Newry, BT35 8SY"
          lon={-6.4161}
          lat={54.0980}
          spanKm={18}
          mapHref={mapsHref}
          markers={[
            { name: "Slieve Gullion Park", lon: -6.4472, lat: 54.1223, note: "7 mins north-west", side: "l" },
            { name: "Newry City", lon: -6.3402, lat: 54.1751, note: "14 mins north-east", side: "t" },
            { name: "Dundalk", lon: -6.4059, lat: 54.0007, note: "14 mins south", side: "b" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="rgc-footer">
    <div class="rgc-wrap rgc-footer-inner">
      <div>
        <strong>Ring of Gullion Cycles</strong>
        <p>140 Forkhill Road, Drumintee, Newry, BT35 8SY</p>
      </div>
      <div class="rgc-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={shopHref} target="_blank" rel="noopener noreferrer">Online Store ↗</a>
        <a href={mapsHref} target="_blank" rel="noopener noreferrer">Directions ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      // 1. Floating transparent header -> glass bar on scroll
      const header = document.querySelector("[data-rgc-header]");
      if (header) {
        const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 40);
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      }

      // 2. Editorial Navigation Dropdown with live preview swap
      const ddWrap = document.querySelector("[data-rgc-dd]");
      const trigger = ddWrap?.querySelector("[data-rgc-dd-trigger]");
      const panel = ddWrap?.querySelector("[data-rgc-dd-panel]");
      const previewImg = ddWrap?.querySelector("[data-rgc-dd-img]");
      const previewTag = ddWrap?.querySelector("[data-rgc-dd-tag]");
      const items = ddWrap ? [...ddWrap.querySelectorAll("[data-rgc-dd-item]")] : [];

      if (ddWrap && trigger && panel) {
        const setOpen = (open) => {
          panel.hidden = !open;
          trigger.setAttribute("aria-expanded", open ? "true" : "false");
          ddWrap.classList.toggle("is-open", open);
        };
        trigger.addEventListener("click", (e) => {
          e.stopPropagation();
          setOpen(panel.hidden);
        });
        document.addEventListener("click", (e) => {
          if (!ddWrap.contains(e.target)) setOpen(false);
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") setOpen(false);
        });
        items.forEach((item) => {
          const activate = () => {
            items.forEach((i) => i.classList.toggle("is-active", i === item));
            if (previewImg && item.dataset.img) previewImg.src = item.dataset.img;
            if (previewTag && item.dataset.tag) previewTag.textContent = item.dataset.tag;
          };
          item.addEventListener("mouseenter", activate);
          item.addEventListener("focus", activate);
          item.addEventListener("click", () => setOpen(false));
        });
      }

      // 3. Direct enquiry confirmation sheet
      const form = document.querySelector("[data-rgc-form]");
      if (form) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;
          const fd = new FormData(form);
          const subject = `Bike Enquiry — ${fd.get("category")} (${fd.get("name")})`;
          const body = [
            `Name: ${fd.get("name")}`,
            `Phone: ${fd.get("phone")}`,
            `Category: ${fd.get("category")}`,
            `Rider Height / Size: ${fd.get("size") || "Not specified"}`,
            `Notes: ${fd.get("notes") || "None"}`,
          ].join("\n");
          const ev = new CustomEvent("mm:enquiry", {
            cancelable: true,
            detail: { to: "ringofgullioncycles@outlook.com", subject, body },
          });
          if (window.dispatchEvent(ev)) {
            window.location.href = `mailto:ringofgullioncycles@outlook.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
          }
        });
      }
    })();
  </script>
</ConceptLayout>
