---
interface Props {
  size?: number;
  tone?: "brick" | "cream" | "slate";
}
const { size = 40, tone = "brick" } = Astro.props;
const stroke = tone === "cream" ? "#faf6ed" : tone === "slate" ? "#22272a" : "#c0563c";
---
<svg width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <rect x="3" y="3" width="42" height="42" rx="4" stroke={stroke} stroke-width="1.5" />
  <path d="M9 24L24 12L39 24" stroke={stroke} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M14 21V36H34V21" stroke={stroke} stroke-width="1.6" />
  <path d="M21 36V28C21 26.3 22.3 25 24 25C25.7 25 27 26.3 27 28V36" stroke={stroke} stroke-width="1.5" />
  <circle cx="24" cy="18.5" r="2" stroke={stroke} stroke-width="1.3" />
</svg>
