---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

const phone = "077 6229 6999";
const phoneHref = "tel:+447762296999";
const email = "conlynhouse@gmail.com";
const site = "https://conlynhouse.com/";
const book = "https://www.conlynhouse.com/booking/";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,500;0,6..96,700;1,6..96,500&family=Commissioner:wght@400;500;600;700&display=swap";

const rooms = [
  "The New Yorker",
  "The Regency",
  "Little Havana",
  "Key West",
  "La Parisienne",
  "Walsh's Retreat",
  "The Olive",
  "Hollywood",
  "Sorrento",
];

const holds = [
  { name: "The door", line: "Purple. Downs Road, metres from the water." },
  { name: "The rooms", line: "Single, double, twin, family. Deluxe with a balcony over the beach." },
  { name: "Ground floor", line: "Disabled access to ground-floor bedrooms, and an extra bathroom on that floor." },
  { name: "Breakfast", line: "Served 8 until 10. Ulster fry, omelette, pancakes, French toast, porridge, fruit." },
  { name: "Tray", line: "Coffee, tea, water and snacks in the room. Wifi." },
];
---

<ConceptLayout
  title={"Conlyn House — Newcastle"}
  slug="conlyn-house"
  bodyClass="concept-page concept-conlyn"
  businessName="Conlyn House"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The windows at dusk are a generated image, not a photograph of the house."
>
  <main class="ch-page">
    <section class="ch-first" aria-labelledby="ch-name">
      <figure class="ch-grounds">
        <img
          src="/media/concepts/conlyn-house/windows-dusk.jpg"
          alt="Bedroom windows at dusk looking out to a bay and a mountain sloping to the sea"
          width="940"
          height="627"
        />
        <figcaption>Windows lit at dusk.</figcaption>
      </figure>
      <div class="ch-first-copy">
        <p class="ch-open-now">11 Downs Road, Newcastle, BT33 0AG</p>
        <h1 id="ch-name">Conlyn House</h1>
        <p class="ch-say">
          Beachfront bed and breakfast. A mere 9-iron from Royal County Down.
          Wake to Dundrum Bay and Slieve Donard sloping to the Irish Sea.
        </p>
        <p class="ch-place">
          Breakfast 8 until 10. Ensuite in every room. Deluxe rooms have a
          balcony over the beach. WhatsApp or ring {phone}.
        </p>
        <nav class="ch-first-nav" aria-label="On this page">
          <a href="#nights">Ask about nights</a>
          <a href="#house">What the house holds</a>
        </nav>
      </div>
    </section>

    <figure class="ch-pull">
      <blockquote>
        <p>
          Wake up to the soothing sounds of the ocean caressing the County Down
          coastline just metres from your luxuriously-decorated bedroom and
          enjoy a delicious cooked breakfast as you savour the panoramic views
          of Dundrum Bay and the majestic Slieve Donard sloping to kiss the
          Irish Sea.
        </p>
      </blockquote>
      <figcaption>conlynhouse.com</figcaption>
    </figure>

    <section class="ch-holds" id="house" aria-labelledby="ch-holds-title">
      <p class="ch-kicker">Nine rooms on Downs Road</p>
      <h2 id="ch-holds-title">What the house holds</h2>
      <ul class="ch-inventory">
        {holds.map((item) => (
          <li>
            <span>{item.name}</span>
            <span>{item.line}</span>
          </li>
        ))}
      </ul>
      <p class="ch-rooms-label">Each bedroom has a name</p>
      <ul class="ch-rooms">
        {rooms.map((name) => (
          <li>{name}</li>
        ))}
      </ul>
      <p class="ch-current">
        Sea and mountain from most rooms. Special diets if you tell us.
        What is free this week — ring, or write.
      </p>
    </section>

    <section class="ch-pad" id="nights" aria-labelledby="ch-pad-title">
      <p class="ch-kicker">Your nights</p>
      <h2 id="ch-pad-title">Nights, and who is coming.</h2>
      <p class="ch-pad-lead">
        Name, nights, and who is coming. We answer by email or WhatsApp.
        We do not keep a live calendar — if the nights are free, we will say so.
      </p>

      <div class="ch-phone-face">
        <a class="ch-dial" href={phoneHref}>{phone}</a>
        <p class="ch-dial-hint">WhatsApp the same number</p>

        <form class="ch-script-form" data-ch-request>
          <label for="ch-who">Your name</label>
          <input id="ch-who" name="name" type="text" autocomplete="name" required />

          <label for="ch-when">Nights you have in mind</label>
          <input id="ch-when" name="when" type="text" placeholder="12–14 September" required />

          <fieldset>
            <legend>Who is coming</legend>
            <label><input type="radio" name="ch-who-with" value="just us" checked /> Just us</label>
            <label><input type="radio" name="ch-who-with" value="a family" /> A family</label>
            <label><input type="radio" name="ch-who-with" value="one person" /> One person</label>
          </fieldset>

          <label for="ch-notes">Anything we should know</label>
          <textarea id="ch-notes" name="notes" rows="3"></textarea>

          <button type="submit">Write the enquiry</button>

          <div class="ch-handoff" data-ch-handoff role="status" hidden tabindex="-1">
            <strong>Your enquiry is ready.</strong>
            <a data-ch-mail href={`mailto:${email}`}>Open the draft</a>
            <span>Or ring <a href={phoneHref}>{phone}</a>. You can also write through <a href={book}>conlynhouse.com/booking</a>.</span>
          </div>
        </form>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      var recipient = "conlynhouse@gmail.com";
      var form = document.querySelector("[data-ch-request]");
      if (!form) return;
      var handoff = form.querySelector("[data-ch-handoff]");
      var link = form.querySelector("[data-ch-mail]");
      if (!handoff || !link) return;

      form.addEventListener("submit", function (event) {
        event.preventDefault();
        if (!form.reportValidity()) return;
        var name = form.querySelector("#ch-who").value.trim();
        var when = form.querySelector("#ch-when").value.trim();
        var notes = form.querySelector("#ch-notes").value.trim();
        var chosen = form.querySelector('input[name="ch-who-with"]:checked');
        var who = chosen ? chosen.value : "just us";
        var query = new URLSearchParams({
          subject: "Stay — " + when,
          body: [
            "Hello Conlyn House,",
            "",
            "I am hoping to stay " + when + ".",
            "It would be " + who + ".",
            "Name: " + name,
            notes ? "Notes: " + notes : "",
            "",
            "Please tell me if those nights are free.",
          ].filter(Boolean).join("\n"),
        });
        link.href = "mailto:" + recipient + "?" + query;
        handoff.hidden = false;
        handoff.focus();
      });
    })();
  </script>
</ConceptLayout>
