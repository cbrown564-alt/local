---
/**
 * Conlyn House — bespoke architectural mark.
 * Captures the purple door entrance, the coastal arch threshold,
 * and the 11 Downs Road / Central Promenade seaside setting.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className = "" } = Astro.props;
---

<svg
  class:list={["ch-mark", className]}
  width={size}
  height={Math.round(size * 1.18)}
  viewBox="0 0 32 38"
  fill="none"
  aria-hidden="true"
>
  <!-- Classical entrance arch / gable -->
  <path
    d="M4 14C4 7.37 9.37 2 16 2C22.63 2 28 7.37 28 14V36H4V14Z"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <!-- Inner door frame (the purple door threshold) -->
  <path
    d="M9 16C9 12.13 12.13 9 16 9C19.87 9 23 12.13 23 16V36H9V16Z"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <!-- Transom fanlight rays -->
  <path d="M16 9V16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
  <path d="M12 11.5L16 16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
  <path d="M20 11.5L16 16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
  <!-- Door split & brass handle -->
  <path d="M16 16V36" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
  <circle cx="14" cy="26" r="1" fill="currentColor" />
  <!-- Promenade doorstep / sea horizon base line -->
  <path d="M1 36H31" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
</svg>

<style>
  .ch-mark {
    display: inline-block;
    vertical-align: middle;
    color: currentColor;
    flex-shrink: 0;
  }
</style>
