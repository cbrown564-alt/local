---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import DancerDoor from "./DancerDoor.astro";

/* Thumbelina — jar: a toy you take home. Speak as the shop.
   Traditional toy shop on Railway Street. Not a party factory
   (Bear Necessities). Not the café at 2 (Railway Street).
   No standalone site. Instagram holds today. No form.
   Hours are Google-only (Sun closed; Mon–Sat 10–5 in the 23 Aug
   brief) — omit rather than date a clock; not re-confirmed 29 Aug 2026.
   Do not print a founding year. Duration counts (15 / 18 / nearly 20 /
   Established 20 years) disagree and move — Instagram keeps that line.
   Audrey named because Belfast Live (1 Apr 2023) and IG already do. */
const phone = "028 4372 7444";
const phoneHref = "tel:+442843727444";
const instagram = "https://www.instagram.com/thumbelinatoyshop/";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,500;0,6..96,700;0,6..96,800;1,6..96,500;1,6..96,600&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap";
---

<ConceptLayout
  title={"Thumbelina — independent concept"}
  slug="thumbelina"
  bodyClass="concept-page concept-thumbelina"
  lang="en-GB"
  businessName="Thumbelina"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The dancer at the door is a drawing of the 10A plate."
>
  <div class="tb-strip">
    <span>10A Railway Street, Newcastle · BT33 0AL</span>
    <span class="tb-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="tb-header">
    <a class="tb-brand" href="/concepts/thumbelina/">
      <span class="tb-brand-mark" aria-hidden="true">
        <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
          <rect width="44" height="44" fill="#4a3228"/>
          <rect x="1.4" y="1.4" width="41.2" height="41.2" stroke="#e8c4c0" stroke-width="1.4"/>
          <circle cx="22" cy="9.2" r="3.1" fill="#f3d4c8"/>
          <circle cx="22" cy="8.2" r="2.2" fill="#3a2a24"/>
          <path d="M22 12.4c-1.6 2.2-2.4 5.2-2.2 8.2h4.4c.2-3-.6-6-2.2-8.2Z" fill="#9e4a56"/>
          <path d="M15.5 21.2c2.2-.6 4.4-.4 6.5.6 2.1-1 4.3-1.2 6.5-.6-1.6 2.8-4 4.4-6.5 4.6-2.5-.2-4.9-1.8-6.5-4.6Z" fill="#e8c4c0"/>
          <path d="M20.2 25.6l-1.4 10.2M23.8 25.6l1.4 10.2" stroke="#4a3228" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M17.4 36.2h4.2M22.4 36.2h4.2" stroke="#9e4a56" stroke-width="1.2" stroke-linecap="round"/>
          <circle cx="16.2" cy="38.4" r="1.5" fill="#c45c6a"/>
          <circle cx="22" cy="39" r="1.3" fill="#e8c4c0"/>
          <circle cx="27.6" cy="38.2" r="1.4" fill="#9e4a56"/>
        </svg>
      </span>
      <span class="tb-brand-text">
        <span class="tb-brand-name">Thumbelina</span>
        <span class="tb-brand-sub">10A Railway Street · Newcastle</span>
      </span>
    </a>
    <nav class="tb-nav" aria-label="Concept navigation">
      <a href="#shop">The shop</a>
      <a href="#counter">The counter</a>
      <a href="#door">The door</a>
    </nav>
    <a class="tb-walk" href="#door">Walk in</a>
  </header>

  <main class="tb-main">
    <section class="tb-mast" aria-labelledby="tb-name">
      <div class="tb-mast-copy">
        <p class="tb-kicker">Toy shop · Railway Street</p>
        <h1 id="tb-name">Thumbelina</h1>
        <p class="tb-number">10A Railway Street · Newcastle</p>
        <p class="tb-say">A ballet dancer at the door.</p>
        <p class="tb-lede">
          Dolls, teddies, wooden toys, puzzles and dinosaurs. One-to-one
          advice at the counter. Walk in, or ring.
        </p>
        <p class="tb-cta">
          <a class="tb-walk tb-walk--inline" href="#door">Walk in</a>
          <a class="tb-ring" href={phoneHref}>{phone}</a>
        </p>
      </div>
      <p class="tb-mast-num" aria-hidden="true">10A</p>
    </section>

    <section class="tb-folio" id="shop" aria-labelledby="tb-shop-title">
      <p class="tb-folio-mark">Thumbelina · 10A Railway Street · in Slieve Donard’s shadow</p>
      <div class="tb-folio-grid">
        <div class="tb-folio-copy">
          <p class="tb-kicker">The shop</p>
          <h2 id="tb-shop-title">A wee bit different.</h2>
          <p>
            A traditional toy shop on Railway Street. Audrey behind the
            counter. The dancer at the door.
          </p>
          <p>
            Dolls, teddies, wooden toys, puzzles, dinosaurs and more.
            What is on the shelf today lives on Instagram.
          </p>
          <p class="tb-ig">
            <a href={instagram} rel="noopener noreferrer">Instagram · @thumbelinatoyshop</a>
          </p>
        </div>
        <blockquote class="tb-pull" cite="https://www.belfastlive.co.uk/news/meet-newcastle-shop-owners-adding-26608745">
          <p>
            I wanted to have a shop that was a wee bit different, that I
            could talk and meet people and recommend toys to people and
            that’s exactly what I’ve done.
          </p>
          <footer>Audrey Byrne · April 2023</footer>
        </blockquote>
      </div>
    </section>

    <section class="tb-counter" id="counter" aria-labelledby="tb-counter-title">
      <div class="tb-counter-copy">
        <p class="tb-kicker tb-kicker--on-walnut">The counter</p>
        <h2 id="tb-counter-title">Tell Audrey the story.</h2>
        <p>
          One-to-one customer advice. You say who it is for. We find the
          toy. You take it home.
        </p>
      </div>
      <ol class="tb-beats">
        <li>
          <span class="tb-beat-n">01</span>
          <span class="tb-beat-t">You walk in</span>
        </li>
        <li>
          <span class="tb-beat-n">02</span>
          <span class="tb-beat-t">Audrey finds the toy</span>
        </li>
        <li>
          <span class="tb-beat-n">03</span>
          <span class="tb-beat-t">You take it home</span>
        </li>
      </ol>
      <p class="tb-cta tb-cta--on-walnut">
        <a class="tb-walk tb-walk--on-walnut" href="#door">Walk in</a>
        <a class="tb-ring tb-ring--on-walnut" href={phoneHref}>{phone}</a>
      </p>
    </section>

    <section class="tb-street" id="door" aria-labelledby="tb-door-title">
      <div class="tb-street-copy">
        <p class="tb-kicker">The door</p>
        <h2 id="tb-door-title">10A Railway Street.</h2>
        <p class="tb-street-lede">
          The ballet dancer with flowers at her feet. Walk in. Ring if
          you like.
        </p>
        <p class="tb-artefact-cta">
          <span class="tb-walk tb-walk--inline">Walk in</span>
          <a class="tb-ring" href={phoneHref}>{phone}</a>
        </p>
      </div>

      <figure class="tb-artefact">
        <DancerDoor />
        <figcaption>The dancer at 10A.</figcaption>
      </figure>

      <address class="tb-address">
        <strong>Thumbelina</strong>
        <span>10A Railway Street</span>
        <span>Newcastle</span>
        <span>BT33 0AL</span>
        <a href={phoneHref}>{phone}</a>
        <a href={instagram} rel="noopener noreferrer">Instagram · @thumbelinatoyshop</a>
      </address>
    </section>
  </main>
</ConceptLayout>
