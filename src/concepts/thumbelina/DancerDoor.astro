---
/* Drawn 10A door plate: ballet dancer with flowers at her feet.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
---

<svg
  class="tb-plate"
  viewBox="0 0 960 620"
  role="img"
  aria-label="Thumbelina shopfront at 10A Railway Street: fascia over a window, door numbered 10A, ballet dancer with flowers at her feet"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="tb-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#efe6dc"/>
      <stop offset="1" stop-color="#e4d5c8"/>
    </linearGradient>
    <linearGradient id="tb-render" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#d8c4b4"/>
      <stop offset="1" stop-color="#c4ad9c"/>
    </linearGradient>
    <linearGradient id="tb-room" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f3e4d2"/>
      <stop offset="1" stop-color="#e0c9ae"/>
    </linearGradient>
    <linearGradient id="tb-glass" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f7fbf8" stop-opacity="0.38"/>
      <stop offset="0.5" stop-color="#e8c4c0" stop-opacity="0.08"/>
      <stop offset="1" stop-color="#c4ad9c" stop-opacity="0.22"/>
    </linearGradient>
    <linearGradient id="tb-fascia" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#5a3c32"/>
      <stop offset="1" stop-color="#4a3228"/>
    </linearGradient>
    <pattern id="tb-pave" width="52" height="16" patternUnits="userSpaceOnUse">
      <rect width="52" height="16" fill="#d4c6b6"/>
      <rect y="14" width="52" height="2" fill="#c0b09e"/>
      <rect x="25" width="1.2" height="16" fill="#c0b09e"/>
    </pattern>
  </defs>

  <rect width="960" height="620" fill="url(#tb-sky)"/>

  <!-- Upper storey -->
  <rect x="92" y="28" width="776" height="132" fill="url(#tb-render)"/>
  <rect x="92" y="28" width="776" height="8" fill="#b39a88"/>
  <g fill="#efe4d8" stroke="#6a5346" stroke-width="2">
    <rect x="156" y="52" width="86" height="84"/>
    <rect x="292" y="52" width="86" height="84"/>
    <rect x="582" y="52" width="86" height="84"/>
    <rect x="718" y="52" width="86" height="84"/>
  </g>
  <g stroke="#6a5346" stroke-width="1.3">
    <path d="M199 52v84M156 94h86M335 52v84M292 94h86M625 52v84M582 94h86M761 52v84M718 94h86"/>
  </g>

  <!-- Fascia -->
  <rect x="68" y="156" width="824" height="88" fill="url(#tb-fascia)"/>
  <rect x="68" y="156" width="824" height="5" fill="#b08a5a"/>
  <rect x="68" y="239" width="824" height="5" fill="#b08a5a"/>
  <text
    x="480"
    y="208"
    text-anchor="middle"
    fill="#f7f1ea"
    font-family="Bodoni Moda, Times New Roman, serif"
    font-size="48"
    font-style="italic"
    font-weight="700"
    letter-spacing="8"
  >Thumbelina</text>
  <text
    x="480"
    y="232"
    text-anchor="middle"
    fill="#e8c4c0"
    font-family="Plus Jakarta Sans, Segoe UI, sans-serif"
    font-size="11"
    font-weight="700"
    letter-spacing="5.4"
  >10A RAILWAY STREET</text>

  <!-- Shop body -->
  <rect x="68" y="244" width="824" height="228" fill="#3a261f"/>

  <!-- Window -->
  <rect x="86" y="262" width="560" height="192" fill="url(#tb-room)"/>
  <!-- Shelves -->
  <g stroke="#4a3228" stroke-width="4">
    <line x1="108" y1="318" x2="622" y2="318"/>
    <line x1="108" y1="372" x2="622" y2="372"/>
    <line x1="108" y1="426" x2="622" y2="426"/>
  </g>
  <!-- Wooden blocks on shelves — shop stock, not childhood clipart -->
  <g fill="#c9a06a">
    <rect x="128" y="292" width="34" height="22" rx="1"/>
    <rect x="172" y="286" width="22" height="28" rx="1"/>
    <rect x="248" y="348" width="40" height="20" rx="1"/>
    <rect x="402" y="346" width="26" height="22" rx="1"/>
    <rect x="520" y="400" width="36" height="22" rx="1"/>
  </g>
  <g fill="#9e4a56">
    <rect x="318" y="294" width="28" height="20" rx="1"/>
    <rect x="468" y="348" width="22" height="20" rx="1"/>
    <rect x="196" y="402" width="30" height="20" rx="1"/>
  </g>
  <circle cx="390" cy="304" r="14" fill="#e8c4c0"/>
  <circle cx="574" cy="358" r="12" fill="#f3d4c8"/>
  <rect x="86" y="262" width="560" height="192" fill="url(#tb-glass)"/>
  <path d="M104 270l48 176" stroke="#ffffff" stroke-opacity="0.28" stroke-width="9"/>
  <path d="M168 268l22 178" stroke="#ffffff" stroke-opacity="0.1" stroke-width="5"/>
  <rect x="86" y="262" width="560" height="192" fill="none" stroke="#241c19" stroke-width="3"/>
  <line x1="366" y1="262" x2="366" y2="454" stroke="#241c19" stroke-width="2"/>

  <!-- Door -->
  <rect x="668" y="262" width="202" height="210" fill="#efe4d8" stroke="#241c19" stroke-width="3"/>
  <rect x="686" y="278" width="166" height="118" fill="#d7c3b4" stroke="#4a3228" stroke-width="2"/>
  <rect x="694" y="286" width="150" height="102" fill="#cbb7a8"/>
  <!-- Brass 10A plate -->
  <rect x="724" y="318" width="90" height="46" rx="2" fill="#b08a5a" stroke="#8a6a3c" stroke-width="1.4"/>
  <text
    x="769"
    y="350"
    text-anchor="middle"
    fill="#2f201a"
    font-family="Bodoni Moda, Times New Roman, serif"
    font-size="28"
    font-weight="800"
  >10A</text>
  <circle cx="848" cy="412" r="4.5" fill="#b08a5a"/>
  <rect x="686" y="406" width="166" height="48" fill="#4a3228"/>
  <rect x="686" y="406" width="166" height="6" fill="#b08a5a"/>

  <!-- Pavement -->
  <rect x="0" y="472" width="960" height="148" fill="url(#tb-pave)"/>
  <rect x="0" y="468" width="960" height="6" fill="#b39a88"/>

  <!-- Flowers at her feet -->
  <g transform="translate(214 502)">
    <path d="M38 18c-6 10-18 22-28 28" stroke="#4a5c3a" stroke-width="2" fill="none"/>
    <path d="M62 16c4 12 14 24 26 32" stroke="#4a5c3a" stroke-width="2" fill="none"/>
    <path d="M50 8c0 18 2 34 4 48" stroke="#4a5c3a" stroke-width="2.2" fill="none"/>
    <circle cx="36" cy="14" r="8" fill="#9e4a56"/>
    <circle cx="36" cy="14" r="3" fill="#f7f1ea"/>
    <circle cx="54" cy="6" r="9" fill="#e8c4c0"/>
    <circle cx="54" cy="6" r="3.2" fill="#9e4a56"/>
    <circle cx="70" cy="16" r="7.5" fill="#c45c6a"/>
    <circle cx="70" cy="16" r="2.6" fill="#f7f1ea"/>
    <ellipse cx="22" cy="28" rx="7" ry="4" fill="#6a7a4a" transform="rotate(-24 22 28)"/>
    <ellipse cx="82" cy="30" rx="8" ry="4" fill="#6a7a4a" transform="rotate(18 82 30)"/>
  </g>

  <!-- Painted wooden dancer — shop-sign figure, not a stock tutu clip -->
  <g transform="translate(248 318)">
    <!-- bun -->
    <circle cx="52" cy="8" r="9" fill="#3a2a24"/>
    <!-- head -->
    <circle cx="48" cy="18" r="12" fill="#f3d4c8"/>
    <path d="M40 12c4-6 16-6 20 2" fill="#3a2a24"/>
    <!-- raised arm -->
    <path d="M44 42c-16-8-22-24-14-38" stroke="#f3d4c8" stroke-width="7" stroke-linecap="round" fill="none"/>
    <circle cx="30" cy="6" r="5" fill="#f3d4c8"/>
    <!-- lowered arm -->
    <path d="M58 48c16 4 22 16 16 28" stroke="#f3d4c8" stroke-width="7" stroke-linecap="round" fill="none"/>
    <circle cx="74" cy="76" r="5" fill="#f3d4c8"/>
    <!-- bodice -->
    <path d="M40 40c2 16 6 22 12 24 6-2 10-8 12-24-8-4-16-4-24 0Z" fill="#9e4a56"/>
    <!-- tutu as layered scallops, not a triangle -->
    <path d="M22 64c8-10 18-14 30-14s22 4 30 14c-6 8-18 14-30 14S28 72 22 64Z" fill="#e8c4c0"/>
    <path d="M28 66c6-6 14-9 24-9s18 3 24 9c-5 6-14 10-24 10s-19-4-24-10Z" fill="#d4a8a8"/>
    <path d="M36 68c4-4 10-6 16-6s12 2 16 6c-4 4-10 6-16 6s-12-2-16-6Z" fill="#f7f1ea"/>
    <!-- standing leg -->
    <path d="M48 78l-2 64" stroke="#f3d4c8" stroke-width="8" stroke-linecap="round"/>
    <!-- pointed toe -->
    <path d="M58 86c18 18 22 40 10 56" stroke="#f3d4c8" stroke-width="7" stroke-linecap="round" fill="none"/>
    <!-- slippers + ribbons -->
    <path d="M42 140h12" stroke="#9e4a56" stroke-width="5" stroke-linecap="round"/>
    <path d="M64 140h16" stroke="#9e4a56" stroke-width="5" stroke-linecap="round"/>
    <path d="M46 128c-4 4-4 10 0 14M70 128c4 4 4 10 0 14" stroke="#7a3540" stroke-width="1.4" fill="none"/>
  </g>
</svg>
