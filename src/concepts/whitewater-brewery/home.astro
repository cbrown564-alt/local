---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import "./styles.css";

/* Whitewater Brewing Co., Lakeside Brae, Clarkhill Road, Castlewellan BT31 9RH.
   Verified live 27 Nov 2026: whitewaterbrewery.com, /tours/, Beer Dough Pizzeria, FB WhitewaterBeer, IG whitewaterbeer.
   Contacts: 028 4377 8900, Lakeside Brae, Clarkhill Road, Castlewellan BT31 9RH. */
const phone = "028 4377 8900";
const phoneHref = "tel:+442843778900";
const siteHref = "https://www.whitewaterbrewery.com/";
const toursHref = "https://www.whitewaterbrewery.com/tours/";
const fbHref = "https://www.facebook.com/WhitewaterBeer";
const igHref = "https://www.instagram.com/whitewaterbeer/";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Whitewater+Brewing+Co+Lakeside+Brae+Clarkhill+Road+Castlewellan+BT31+9RH";

const taproomTabs = [
  {
    id: "tours",
    label: "Brewhouse tours",
    intro: "Walk the Castlewellan brewhouse floor with our makers and taste independent Mourne beers poured straight from the cellar.",
    items: [
      {
        title: "Guided brewhouse walk and tasting flight",
        detail: "Step inside our Lakeside Brae brewhouse, see how each small batch comes together and finish with a guided tasting.",
        meta: "Book online",
      },
      {
        title: "Flagship ales, lagers and stouts",
        detail: "Independent Northern Ireland beers brewed with pure Mourne water and whole-grain malts on Clarkhill Road.",
        meta: "On tap and cans",
      },
      {
        title: "Seasonal small-batch releases",
        detail: "Rotating hop-forward IPAs, crisp pilsners and dark malts poured fresh at the source overlooking County Down hills.",
        meta: "Taproom fresh",
      },
    ],
  },
  {
    id: "pizzeria",
    label: "Wood-fired pizzeria",
    intro: "Our Beer Dough Pizzeria pairs hand-stretched sourdough crusts straight with the taproom lines after a day in the Mournes.",
    items: [
      {
        title: "Beer dough sourdough bases",
        detail: "Slow-fermented sourdough bases enriched with Whitewater beer for a blistered, crisp, malty crust.",
        meta: "Baked to order",
      },
      {
        title: "Paired straight with the taps",
        detail: "Settle inside the timber-and-stone taproom with a fresh pint and wood-fired pizza overlooking the hills.",
        meta: "Lakeside Brae",
      },
      {
        title: "Minutes from Castlewellan Forest Park",
        detail: "Four minutes north of Castlewellan Forest Park and twelve from Newcastle for post-walk food and pours.",
        meta: "Easy stop",
      },
    ],
  },
  {
    id: "shop",
    label: "Shop",
    intro: "Bring Whitewater home from the Castlewellan takeaway counter or order direct through our online brewery shop.",
    items: [
      {
        title: "Brewhouse takeaway cases",
        detail: "Pick up mixed cases of flagship pours and limited taproom cans direct from Lakeside Brae.",
        meta: "Brewery pickup",
      },
      {
        title: "Glassware and brewery gifts",
        detail: "Branded glasses, tasting packs and gift boxes stocked at the brewery and on whitewaterbrewery.com.",
        meta: "Order online",
      },
      {
        title: "Group tours and event orders",
        detail: "Call 028 4377 8900 or use the enquiry desk below to arrange group tastings or larger takeaway orders.",
        meta: "028 4377 8900",
      },
    ],
  },
];

const taproomGroups = [
  {
    id: "beers",
    label: "Craft Beers Brewed in the Mournes",
    items: [
      { name: "Flagship Ales, Lagers and Stouts", note: "Independent small-batch beers brewed with pure Mourne water on Lakeside Brae", meta: "On tap and cans" },
      { name: "Seasonal and Limited Releases", note: "Rotating hop-forward IPAs, crisp pilsners and dark malts poured fresh at the source", meta: "Taproom fresh" },
      { name: "Brewhouse Takeaway Shop", note: "Pick up mixed cases, glassware and gifts direct from the Castlewellan brewery", meta: "Order online ↗" },
    ],
  },
  {
    id: "pizzeria",
    label: "Beer Dough Pizzeria and Tours",
    items: [
      { name: "Beer Dough Sourdough Pizzeria", note: "Hand-stretched sourdough bases fermented with Whitewater beer, baked fresh to order", meta: "Lakeside Brae" },
      { name: "Guided Brewhouse Tours", note: "Walk the brewhouse floor with our team and finish with a guided tasting flight", meta: "Book online ↗" },
    ],
  },
];
---

<ConceptLayout
  title="Whitewater Brewing Co. | Brewhouse, Beer Dough Pizzeria and Tours, Castlewellan"
  slug="whitewater-brewery"
  bodyClass="concept-page concept-whitewater"
  businessName="Whitewater Brewing Co."
  town="Castlewellan"
  bannerNote="Imagery comprises indicative Mourne craft brewhouse taproom and wood-fired beer dough pizza visualisations."
>
  <header class="wwb-header" data-wwb-header>
    <div class="wwb-header-inner">
      <a class="wwb-brand" href="#top">Whitewater Brewing Co.</a>

      <nav class="wwb-nav" aria-label="Primary">
        <a class="wwb-nav-link" href="#brewhouse">Brewhouse</a>
        <a class="wwb-nav-link" href="#pizzeria" data-wwb-jump="pizzeria">Pizzeria</a>
        <a class="wwb-nav-link" href="#enquire">Tours</a>
        <a class="wwb-nav-link" href="#location">Castlewellan</a>
      </nav>

      <div class="wwb-header-actions">
        <a class="wwb-header-tel" href={phoneHref}>{phone}</a>
        <a class="wwb-header-cta" href={toursHref} target="_blank" rel="noopener noreferrer">Book tour</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="wwb-hero" aria-labelledby="wwb-hero-title">
      <span class="wwb-hero-sentinel" aria-hidden="true" data-wwb-sentinel></span>
      <div class="wwb-hero-media">
        <picture>
          <source srcset="/media/concepts/whitewater-brewery/whitewater-brewhouse-taps-640.webp 640w, /media/concepts/whitewater-brewery/whitewater-brewhouse-taps-1265.webp 1265w" sizes="100vw" type="image/webp" />
          <img
            src="/media/concepts/whitewater-brewery/whitewater-brewhouse-taps.jpg"
            alt="Sunlit rural craft brewery taproom with poured amber ale, golden IPA and dark stout on an oak bar beside brewing vessels overlooking the Mourne Mountains"
            width="1408"
            height="768"
            loading="eager"
          />
        </picture>
        <div class="wwb-hero-scrim" aria-hidden="true"></div>
      </div>

      <div class="wwb-wrap wwb-hero-stage">
        <div class="wwb-hero-lead">
          <h1 id="wwb-hero-title" class="wwb-reveal wwb-reveal-1">
            Mourne craft beer and wood-fired dough.
          </h1>
          <p class="wwb-hero-copy wwb-reveal wwb-reveal-2">
            Fresh pours, guided brewhouse tours and beer-dough sourdough pizza on Lakeside Brae near Castlewellan.
          </p>
          <div class="wwb-reveal wwb-reveal-2">
            <a class="wwb-primary-btn" href={toursHref} target="_blank" rel="noopener noreferrer">
              Book a brewery tour
            </a>
          </div>
        </div>

        <div class="wwb-hero-foot">
          <p class="wwb-hero-caption">Indicative Lakeside Brae taproom visualisation.</p>
        </div>
      </div>
    </section>

    <section class="wwb-band wwb-band--stone" id="brewhouse" aria-labelledby="wwb-p-title">
      <div class="wwb-wrap wwb-split">
        <div class="wwb-col">
          <h2 id="wwb-p-title">Independent brewing at the foot of the Mournes.</h2>

          <div class="wwb-tabs" role="tablist" aria-label="Brewhouse tours, wood-fired pizzeria and shop">
            {taproomTabs.map((tab, idx) => (
              <button
                type="button"
                role="tab"
                id={`wwb-tab-${tab.id}`}
                aria-selected={idx === 0 ? "true" : "false"}
                aria-controls={`wwb-panel-${tab.id}`}
                tabindex={idx === 0 ? 0 : -1}
                class:list={["wwb-tab", idx === 0 && "is-active"]}
                data-wwb-tab={tab.id}
              >
                {tab.label}
              </button>
            ))}
          </div>

          {taproomTabs.map((tab, idx) => (
            <div
              id={`wwb-panel-${tab.id}`}
              role="tabpanel"
              aria-labelledby={`wwb-tab-${tab.id}`}
              hidden={idx !== 0}
              class="wwb-panel"
              data-wwb-panel={tab.id}
            >
              <p class="wwb-panel-intro">{tab.intro}</p>
              <ul class="wwb-ledger">
                {tab.items.map((item) => (
                  <li class="wwb-ledger-row">
                    <div class="wwb-ledger-main">
                      <h3>{item.title}</h3>
                      <p>{item.detail}</p>
                    </div>
                    <span class="wwb-ledger-meta">{item.meta}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}

          <div class="wwb-sheet-row">
            <SpecimenSheet
              id="ww-tap-sheet"
              triggerLabel="Browse taphouse and pizzeria guide"
              kicker="Whitewater Brewing Co., Castlewellan"
              title="Craft Beers, Beer Dough Pizzeria and Tours"
              subtitle="Visit Lakeside Brae on Clarkhill Road or call 028 4377 8900 for group tour bookings."
              groups={taproomGroups}
              ctaLabel="Book brewhouse tour ↗"
              ctaHref={toursHref}
              ctaExternal={true}
              secondaryLabel={`Call ${phone}`}
              secondaryHref={phoneHref}
              buttonClass="wwb-sheet-trigger"
            />
          </div>
        </div>

        <div class="wwb-col" id="pizzeria">
          <figure class="wwb-plate">
            <picture>
              <source srcset="/media/concepts/whitewater-brewery/whitewater-beer-dough-pizza-640.webp 640w, /media/concepts/whitewater-brewery/whitewater-beer-dough-pizza-1265.webp 1265w" sizes="(max-width: 900px) 100vw, 46vw" type="image/webp" />
              <img
                src="/media/concepts/whitewater-brewery/whitewater-beer-dough-pizza.jpg"
                alt="Blistered wood-fired beer-dough sourdough pizza with mozzarella and basil on a wooden paddle beside a pint of amber craft beer"
                width="1408"
                height="768"
                loading="lazy"
              />
            </picture>
            <figcaption>Indicative beer-dough pizza visualisation.</figcaption>
          </figure>

          <dl class="wwb-details">
            <div>
              <dt>Taproom desk</dt>
              <dd><a href={phoneHref}>{phone}</a></dd>
            </div>
            <div>
              <dt>Address</dt>
              <dd>Lakeside Brae, Clarkhill Road, Castlewellan, BT31 9RH</dd>
            </div>
            <div>
              <dt>Tours</dt>
              <dd><a href={toursHref} target="_blank" rel="noopener noreferrer">whitewaterbrewery.com/tours ↗</a></dd>
            </div>
            <div>
              <dt>Online shop</dt>
              <dd><a href={siteHref} target="_blank" rel="noopener noreferrer">whitewaterbrewery.com ↗</a></dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="wwb-band wwb-band--malt" id="enquire" aria-labelledby="wwb-enq-title">
      <div class="wwb-wrap wwb-split wwb-split--enquire">
        <div class="wwb-col">
          <h2 id="wwb-enq-title">Plan a brewery tour or group visit on Lakeside Brae.</h2>
          <p class="wwb-dark-copy">
            Organising a group tasting tour, a pizzeria table after a Mourne walk or a mixed case
            pickup? Share your preferred date below, book standard slots online or call the
            brewhouse on <a href={phoneHref}>{phone}</a>.
          </p>
        </div>

        <div class="wwb-col">
          <form class="wwb-form" data-wwb-form>
            <div class="wwb-form-row">
              <label>
                <span>Your name</span>
                <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
              </label>
              <label>
                <span>Telephone</span>
                <input name="phone" type="tel" required autocomplete="tel" placeholder="028 or 07..." />
              </label>
            </div>
            <div class="wwb-form-row">
              <label>
                <span>Visit type</span>
                <select name="visit">
                  <option value="Guided brewhouse tour">Guided brewhouse tour</option>
                  <option value="Group tour and tasting">Group tour and tasting</option>
                  <option value="Beer Dough Pizzeria table">Beer Dough Pizzeria table</option>
                  <option value="Takeaway case order">Takeaway case order</option>
                </select>
              </label>
              <label>
                <span>Preferred date and group size</span>
                <input name="group" type="text" placeholder="e.g. 8 guests, Saturday" />
              </label>
            </div>
            <label>
              <span>Notes</span>
              <textarea name="notes" rows="3" placeholder="Any tasting preferences, dietary notes or takeaway case questions."></textarea>
            </label>
            <button class="wwb-primary-btn wwb-submit-btn" type="submit">Send tour enquiry</button>
          </form>
        </div>
      </div>
    </section>

    <section class="wwb-band wwb-band--stone wwb-map-band" id="location" aria-label="Castlewellan Lakeside Brae map">
      <div class="wwb-wrap">
        <LocalAreaMap
          id="ww-map"
          kicker=""
          businessName="Whitewater Brewing Co."
          address="Lakeside Brae, Clarkhill Road, Castlewellan, BT31 9RH"
          lon={-5.9447}
          lat={54.2796}
          spanKm={16}
          mapHref={mapsHref}
          markers={[
            { name: "Castlewellan Forest", lon: -5.9442, lat: 54.2596, note: "4 mins south", side: "b" },
            { name: "Newcastle", lon: -5.8902, lat: 54.2121, note: "12 mins south-east", side: "r" },
            { name: "Ballynahinch", lon: -5.8971, lat: 54.4011, note: "15 mins north", side: "t" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="wwb-footer">
    <div class="wwb-wrap wwb-footer-inner">
      <div>
        <strong class="wwb-footer-brand">Whitewater Brewing Co.</strong>
        <p>Lakeside Brae, Clarkhill Road, Castlewellan, Co. Down, BT31 9RH</p>
      </div>
      <div class="wwb-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={toursHref} target="_blank" rel="noopener noreferrer">Tours ↗</a>
        <a href={siteHref} target="_blank" rel="noopener noreferrer">Shop ↗</a>
        <a href={fbHref} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
        <a href={igHref} target="_blank" rel="noopener noreferrer">Instagram ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-wwb-header]");
      const sentinel = document.querySelector("[data-wwb-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            header.classList.toggle("is-scrolled", !entries[0].isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      const tabs = [...document.querySelectorAll("[data-wwb-tab]")];
      const panels = [...document.querySelectorAll("[data-wwb-panel]")];
      const activateTab = (id, focusTab = false) => {
        tabs.forEach((btn) => {
          const active = btn.dataset.wwbTab === id;
          btn.classList.toggle("is-active", active);
          btn.setAttribute("aria-selected", active ? "true" : "false");
          btn.tabIndex = active ? 0 : -1;
          if (active && focusTab) btn.focus();
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.wwbPanel !== id;
        });
      };

      tabs.forEach((btn, idx) => {
        btn.addEventListener("click", () => activateTab(btn.dataset.wwbTab));
        btn.addEventListener("keydown", (e) => {
          if (e.key === "ArrowRight") {
            e.preventDefault();
            activateTab(tabs[(idx + 1) % tabs.length].dataset.wwbTab, true);
          } else if (e.key === "ArrowLeft") {
            e.preventDefault();
            activateTab(tabs[(idx - 1 + tabs.length) % tabs.length].dataset.wwbTab, true);
          }
        });
      });

      document.querySelectorAll("[data-wwb-jump]").forEach((link) => {
        link.addEventListener("click", () => {
          const id = link.dataset.wwbJump;
          if (id) activateTab(id);
        });
      });

      const form = document.querySelector("[data-wwb-form]");
      if (form) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;
          const fd = new FormData(form);
          const subject = `Brewery enquiry: ${fd.get("visit")} (${fd.get("name")})`;
          const body = [
            `Name: ${fd.get("name")}`,
            `Phone: ${fd.get("phone")}`,
            `Visit type: ${fd.get("visit")}`,
            `Preferred date and group size: ${fd.get("group") || "Flexible"}`,
            `Notes: ${fd.get("notes") || "None"}`,
          ].join("\n");
          const ev = new CustomEvent("mm:enquiry", {
            cancelable: true,
            detail: {
              to: "Whitewater Brewing Co. (028 4377 8900)",
              subject,
              body,
              url: "tel:+442843778900",
            },
          });
          if (window.dispatchEvent(ev)) {
            window.location.href = "tel:+442843778900";
          }
        });
      }
    })();
  </script>
</ConceptLayout>
