---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import "./styles.css";

/* Whitewater Brewing Co. — Lakeside Brae, Clarkhill Road, Castlewellan BT31 9RH.
   Verified live 27 Nov 2026: whitewaterbrewery.com renders empty cart text ("0 was successfully added to your cart.")
   at top of page and buries Beer Dough Pizzeria & guided tours under WooCommerce chrome.
   Contacts: 028 4377 8900, whitewaterbrewery.com, /tours/, FB WhitewaterBeer, IG whitewaterbeer. */
const phone = "028 4377 8900";
const phoneHref = "tel:+442843778900";
const siteHref = "https://www.whitewaterbrewery.com/";
const toursHref = "https://www.whitewaterbrewery.com/tours/";
const fbHref = "https://www.facebook.com/WhitewaterBeer";
const igHref = "https://www.instagram.com/whitewaterbeer/";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Whitewater+Brewing+Co+Lakeside+Brae+Clarkhill+Road+Castlewellan+BT31+9RH";

const taproomGroups = [
  {
    id: "beers",
    label: "Craft Beers Brewed in the Mournes",
    items: [
      { name: "Flagship Ales, Lagers & Stouts", note: "Independent small-batch beers brewed with pure Mourne water on Lakeside Brae", meta: "On tap & cans" },
      { name: "Seasonal & Limited Releases", note: "Rotating hop-forward IPAs, crisp pilsners and dark malts poured fresh at the source", meta: "Taproom fresh" },
      { name: "Brewhouse Takeaway Shop", note: "Pick up mixed cases, glassware and gifts direct from the Castlewellan brewery", meta: "Order online ↗" },
    ],
  },
  {
    id: "pizzeria",
    label: "Beer Dough Pizzeria & Tours",
    items: [
      { name: "Beer Dough Sourdough Pizzeria", note: "Hand-stretched sourdough bases fermented with Whitewater beer, baked fresh to order", meta: "Lakeside Brae" },
      { name: "Guided Brewhouse Tours", note: "Walk the brewhouse floor with our team and finish with a guided tasting flight", meta: "Book online ↗" },
    ],
  },
];
---

<ConceptLayout
  title="Whitewater Brewing Co. — Brewhouse, Beer Dough Pizzeria & Tours, Castlewellan"
  slug="whitewater-brewery"
  bodyClass="concept-page concept-whitewater"
  businessName="Whitewater Brewing Co."
  town="Castlewellan"
  bannerNote="Imagery comprises indicative Mourne craft brewhouse taproom and wood-fired beer dough pizza visualisations."
>
  <header class="ww-header" data-ww-header>
    <div class="ww-header-inner">
      <a class="ww-brand" href="#top">
        <span class="ww-mark" aria-hidden="true"></span>
        <span>Whitewater Brewing Co.</span>
      </a>

      <nav class="ww-nav" aria-label="Primary">
        <a class="ww-nav-link" href="#brewhouse">Brewhouse</a>
        <a class="ww-nav-link" href="#pizzeria">Pizzeria</a>
        <a class="ww-nav-link" href={siteHref} target="_blank" rel="noopener noreferrer">Shop</a>
        <a class="ww-nav-link" href="#location">Castlewellan</a>
      </nav>

      <div class="ww-header-actions">
        <a class="ww-header-tel" href={phoneHref}>{phone}</a>
        <a class="ww-pill-cta" href={toursHref} target="_blank" rel="noopener noreferrer">Book tour</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="ww-hero" aria-labelledby="ww-hero-title">
      <figure class="ww-hero-media">
        <picture>
          <source srcset="/media/concepts/whitewater-brewery/whitewater-brewhouse-taps-640.webp 640w, /media/concepts/whitewater-brewery/whitewater-brewhouse-taps-1265.webp 1265w" sizes="100vw" type="image/webp" />
          <img src="/media/concepts/whitewater-brewery/whitewater-brewhouse-taps.jpg" alt="Sunlit rural craft brewery taproom with poured amber ale, golden IPA and dark stout on an oak bar beside brewing vessels" width="1408" height="768" loading="eager" />
        </picture>
        <div class="ww-hero-scrim" aria-hidden="true"></div>
      </figure>

      <div class="ww-wrap ww-hero-stage">
        <div class="ww-hero-headline">
          <h1 id="ww-hero-title" class="ww-reveal ww-reveal-1">
            Mourne craft beer<br /><em>and wood-fired dough.</em>
          </h1>
        </div>

        <div class="ww-hero-foot">
          <div class="ww-hero-copy ww-reveal ww-reveal-2">
            <p>
              Brewed on Lakeside Brae near Castlewellan. Visit the taphouse for fresh pours,
              guided brewery tours and beer-dough sourdough pizza.
            </p>
            <div class="ww-hero-actions">
              <a class="ww-arrow-btn" href={toursHref} target="_blank" rel="noopener noreferrer">
                <span class="ww-arrow-label">Book a brewery tour</span>
                <span class="ww-arrow-circle" aria-hidden="true">
                  <svg class="ww-arrow ww-arrow--primary" width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  <svg class="ww-arrow ww-arrow--clone" width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
              </a>
              <SpecimenSheet
                id="ww-tap-sheet"
                triggerLabel="Taphouse & pizzeria guide"
                kicker="Whitewater Brewing Co. · Lakeside Brae, Castlewellan"
                title="Craft Beers, Beer Dough Pizzeria & Tours"
                subtitle="Visit Lakeside Brae on Clarkhill Road or call 028 4377 8900 for group tour bookings."
                groups={taproomGroups}
                ctaLabel="Book Brewhouse Tour ↗"
                ctaHref={toursHref}
                ctaExternal={true}
                secondaryLabel={`Call ${phone}`}
                secondaryHref={phoneHref}
                buttonClass="ww-ghost-link"
              />
            </div>
          </div>

          <div class="ww-hero-meta ww-reveal ww-reveal-3">
            <a class="ww-scroll-cue" href="#brewhouse">
              <span>Scroll down</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M6 2.5v7M3 6.5L6 9.5l3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
            <p class="ww-visual-note">Lakeside Brae taproom · indicative visualisation</p>
          </div>
        </div>
      </div>
    </section>

    <section class="ww-section ww-pillars" id="brewhouse" aria-labelledby="ww-p-title">
      <div class="ww-wrap">
        <div class="ww-section-head">
          <p class="ww-eyebrow">Lakeside Brae · Castlewellan</p>
          <h2 id="ww-p-title">Independent brewing at the foot of the Mournes.</h2>
        </div>

        <div class="ww-three">
          <article>
            <span class="ww-num">01</span>
            <h3>Brewed in the Mournes</h3>
            <p>Independent Northern Ireland brewing heritage crafted on Lakeside Brae with pure local water and whole-grain malts.</p>
          </article>
          <article>
            <span class="ww-num">02</span>
            <h3>Fresh at the source</h3>
            <p>Flagship ales, crisp lagers and seasonal small-batch pours served straight from the cellar overlooking County Down hills.</p>
          </article>
          <article>
            <span class="ww-num">03</span>
            <h3>Guided tasting tours</h3>
            <p>Step onto the brewhouse floor with our makers, learn how each style comes together and share a tasting flight.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="ww-section ww-pizzeria" id="pizzeria" aria-labelledby="ww-pz-title">
      <div class="ww-wrap ww-split">
        <figure class="ww-plate">
          <picture>
            <source srcset="/media/concepts/whitewater-brewery/whitewater-beer-dough-pizza-640.webp 640w, /media/concepts/whitewater-brewery/whitewater-beer-dough-pizza-1265.webp 1265w" sizes="(max-width: 860px) 100vw, 48vw" type="image/webp" />
            <img src="/media/concepts/whitewater-brewery/whitewater-beer-dough-pizza.jpg" alt="Blistered wood-fired beer-dough sourdough pizza with mozzarella and basil on a wooden paddle beside a pint of amber craft beer" width="1408" height="768" loading="lazy" />
          </picture>
          <figcaption>Beer Dough Pizzeria &amp; taproom pairing · indicative food visualisation.</figcaption>
        </figure>
        <div>
          <p class="ww-eyebrow">Wood-fired sourdough · Clarkhill Road</p>
          <h2 id="ww-pz-title">The Beer Dough Pizzeria, paired straight with the taps.</h2>
          <p class="ww-body">
            Our slow-fermented sourdough bases are enriched with Whitewater beer for a crisp, malty
            crust — ideal after a walk through Castlewellan Forest Park or a day in the Mournes.
          </p>
          <div class="ww-inline-actions">
            <a class="ww-arrow-btn ww-arrow-btn--dark" href={toursHref} target="_blank" rel="noopener noreferrer">
              <span class="ww-arrow-label">Reserve a tour</span>
              <span class="ww-arrow-circle" aria-hidden="true">
                <svg class="ww-arrow ww-arrow--primary" width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <svg class="ww-arrow ww-arrow--clone" width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            </a>
            <a class="ww-text-link" href={phoneHref}>Call {phone}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="ww-section ww-map-band" id="location" aria-label="Castlewellan Lakeside Brae map">
      <div class="ww-wrap">
        <LocalAreaMap
          id="ww-map"
          kicker="Lakeside Brae · Clarkhill Road, Castlewellan"
          businessName="Whitewater Brewing Co."
          address="Lakeside Brae, Clarkhill Road, Castlewellan, BT31 9RH"
          lon={-5.9447}
          lat={54.2796}
          spanKm={16}
          mapHref={mapsHref}
          markers={[
            { name: "Castlewellan Forest", lon: -5.9442, lat: 54.2596, note: "4 mins south", side: "b" },
            { name: "Newcastle", lon: -5.8902, lat: 54.2121, note: "12 mins south-east", side: "r" },
            { name: "Ballynahinch", lon: -5.8971, lat: 54.4011, note: "15 mins north", side: "t" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="ww-footer">
    <div class="ww-wrap ww-footer-inner">
      <div>
        <strong>Whitewater Brewing Co.</strong>
        <p>Lakeside Brae, Clarkhill Road, Castlewellan, Co. Down, BT31 9RH</p>
      </div>
      <div class="ww-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={toursHref} target="_blank" rel="noopener noreferrer">Tours ↗</a>
        <a href={fbHref} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
        <a href={igHref} target="_blank" rel="noopener noreferrer">Instagram ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-ww-header]");
      if (!header) return;
      const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 40);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    })();
  </script>
</ConceptLayout>
