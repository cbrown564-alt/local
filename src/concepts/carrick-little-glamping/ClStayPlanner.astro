---
/* Carrick Little Glamping: Interactive Doorstep Trail and Stay Planner.
   Helps guests plan a pod stay or gift voucher around real verified
   Carrick Little trailhead and Mourne coast stops, then pre-fills Julie's enquiry. */
const moods = [
  {
    id: "hike",
    label: "Slieve Binnian hike",
    topic: "Pod One (6m Deluxe, sleeps 4)",
    headline: "Step straight onto the Carrick Little Track from your pod door.",
    stops: [
      {
        place: "Carrick Little trailhead",
        detail: "Right on the lane outside 208 Head Road for an early start up Slieve Binnian.",
      },
      {
        place: "Blue Lough and Annalong Valley",
        detail: "Classic granite ridge circuit with wide views across the Irish Sea.",
      },
      {
        place: "Heated cedar pod return",
        detail: "Warm timber shelter, kettle, toaster, microwave, and private shower in Pod One.",
      },
    ],
    note: "Slieve Binnian hiking stay at Carrick Little",
  },
  {
    id: "coast",
    label: "Harbour and Silent Valley",
    topic: "General Stay Question",
    headline: "Unrushed mountain mornings paired with Annalong Harbour and Silent Valley.",
    stops: [
      {
        place: "Annalong Cornmill and harbour",
        detail: "Five minutes down to the granite harbour wall and coast road.",
      },
      {
        place: "Silent Valley Reservoir",
        detail: "Ten minutes into the mountain catchment walled by the Mourne peaks.",
      },
      {
        place: "Kilkeel and Newcastle",
        detail: "Ten minutes south to Kilkeel harbour or fifteen minutes north to Newcastle.",
      },
    ],
    note: "Coastal and Silent Valley pod break",
  },
  {
    id: "voucher",
    label: "Gift voucher surprise",
    topic: "Gift Voucher",
    headline: "Any amount, valid for a full 12 months across every season.",
    stops: [
      {
        place: "Flexible denomination",
        detail: "Issued for any amount towards a pod stay beneath the Mournes.",
      },
      {
        place: "Valid one full year",
        detail: "Redeemable across spring, summer, autumn, and crisp winter weekends.",
      },
      {
        place: "Arranged direct with Julie",
        detail: "Call 07729 787342, send a WhatsApp message, or compose an email below.",
      },
    ],
    note: "12-month gift voucher enquiry",
  },
];
---

<section class="cl-section cl-planner-band" id="stay-planner" aria-labelledby="cl-planner-title">
  <div class="cl-wrap" data-cl-planner>
    <div class="cl-planner-head">
      <div>
        <h2 id="cl-planner-title">Pick your pace beneath the Mournes.</h2>
        <p class="cl-planner-intro">
          Choose how you want to spend your stay from 208 Head Road, then pre-fill an enquiry straight to Julie.
        </p>
      </div>

      <div class="cl-seg" role="tablist" aria-label="Select stay pace">
        {moods.map((m, i) => (
          <button
            type="button"
            role="tab"
            id={`cl-mood-tab-${m.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls={`cl-mood-panel-${m.id}`}
            tabindex={i === 0 ? "0" : "-1"}
            class:list={["cl-seg-item", { "is-active": i === 0 }]}
            data-cl-mood={m.id}
            data-cl-topic={m.topic}
            data-cl-note={m.note}
          >
            {m.label}
          </button>
        ))}
      </div>
    </div>

    {moods.map((m, i) => (
      <div
        id={`cl-mood-panel-${m.id}`}
        role="tabpanel"
        aria-labelledby={`cl-mood-tab-${m.id}`}
        class:list={["cl-mood-panel", { "is-active": i === 0 }]}
        data-cl-mood-panel={m.id}
        hidden={i !== 0}
      >
        <p class="cl-mood-lead">{m.headline}</p>
        <dl class="cl-stops-ledger">
          {m.stops.map((s) => (
            <div class="cl-stop-row">
              <dt>{s.place}</dt>
              <dd>{s.detail}</dd>
            </div>
          ))}
        </dl>
      </div>
    ))}

    <div class="cl-planner-foot">
      <p>Heated year-round: just bring food, drinks, bedding, and towels.</p>
      <button type="button" class="cl-btn cl-btn--amber" data-cl-prefill>
        Pre-fill enquiry to Julie
      </button>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-cl-planner]");
    if (!root) return;

    const tabs = Array.from(root.querySelectorAll("[data-cl-mood]"));
    const panels = Array.from(root.querySelectorAll("[data-cl-mood-panel]"));
    let activeTopic = tabs[0]?.getAttribute("data-cl-topic") || "Pod One (6m Deluxe, sleeps 4)";
    let activeNote = tabs[0]?.getAttribute("data-cl-note") || "";

    const activate = (id, moveFocus = false) => {
      tabs.forEach((tab) => {
        const active = tab.getAttribute("data-cl-mood") === id;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-selected", active ? "true" : "false");
        tab.setAttribute("tabindex", active ? "0" : "-1");
        if (active) {
          activeTopic = tab.getAttribute("data-cl-topic") || activeTopic;
          activeNote = tab.getAttribute("data-cl-note") || "";
          if (moveFocus && tab instanceof HTMLElement) tab.focus();
        }
      });
      panels.forEach((panel) => {
        const active = panel.getAttribute("data-cl-mood-panel") === id;
        panel.classList.toggle("is-active", active);
        panel.hidden = !active;
      });
    };

    tabs.forEach((tab, idx) => {
      tab.addEventListener("click", () => {
        const id = tab.getAttribute("data-cl-mood");
        if (id) activate(id);
      });
      tab.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft" && e.key !== "Home" && e.key !== "End") return;
        e.preventDefault();
        let next = idx;
        if (e.key === "ArrowRight") next = (idx + 1) % tabs.length;
        if (e.key === "ArrowLeft") next = (idx - 1 + tabs.length) % tabs.length;
        if (e.key === "Home") next = 0;
        if (e.key === "End") next = tabs.length - 1;
        const nextId = tabs[next]?.getAttribute("data-cl-mood");
        if (nextId) activate(nextId, true);
      });
    });

    root.querySelector("[data-cl-prefill]")?.addEventListener("click", () => {
      const topicSel = document.querySelector('#cl-form select[name="topic"]');
      const detailsInp = document.querySelector('#cl-form input[name="details"]');
      if (topicSel instanceof HTMLSelectElement) {
        const match = Array.from(topicSel.options).find((o) => o.value === activeTopic);
        if (match) {
          topicSel.value = match.value;
          topicSel.dispatchEvent(new Event("change", { bubbles: true }));
        }
      }
      if (detailsInp instanceof HTMLInputElement) {
        detailsInp.value = activeNote;
      }
      document.getElementById("vouchers")?.scrollIntoView({ behavior: "smooth" });
    });
  })();
</script>
