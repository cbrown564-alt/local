---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";

/* Carrick Little Glamping — 208 Head Road, Annalong, Newry, BT34 4RQ.
   Sources (live-fetched 26 Nov 2026): carricklittleglamping.com (/, /about,
   /contact, /gift-vouchers).
   - Family-run by Julie Mooney: 3 fully equipped glamping pods directly on the
     Carrick Little Track at the foot of the Mourne Mountains with mountain & sea views.
   - Pod One: 6-metre deluxe pod sleeping up to 4 (2 adults / 2 children) with
     private washroom (shower, toilet & wash hand basin).
   - Included in all pods: sink, microwave, fridge, heater, kettle, toaster,
     crockery and cutlery. Guests only need to bring food, drinks and bedding/towels.
   - Check-in: anytime after 3:00pm · Check-out: by 11:00am.
   - Gift Vouchers: any amount, valid 1 year from issue — call Julie on 07729 787342.
   - Live Freetobook portal:
     https://portal.freetobook.com/reservations?w_id=39587&w_tkn=TE0NKByzhI04xDsoU16WgwsHhkw4xOC7ePVcULHqywQvbRxXkFNpT04DBOBDR
   - Fixed UK WhatsApp link: https://wa.me/447729787342 (live site omitted 44).
   - Phone: 07729 787342 · Email: sales@carrickplant.co.uk · GPS: 54.133095, -5.942121.
   Brief: research/concepts/carrick-little-glamping/carrick-little-glamping-elevation-brief.md */

const phone = "07729 787342";
const phoneHref = "tel:+447729787342";
const whatsappHref = "https://wa.me/447729787342";
const email = "sales@carrickplant.co.uk";
const freetobookUrl =
  "https://portal.freetobook.com/reservations?w_id=39587&w_tkn=TE0NKByzhI04xDsoU16WgwsHhkw4xOC7ePVcULHqywQvbRxXkFNpT04DBOBDR";
const facebook = "https://facebook.com/carricklittleglampingmournemountains/";
const tripadvisor =
  "https://www.tripadvisor.co.uk/Hotel_Review-g2137520-d17679253-Reviews-Carrick_Little_Glamping-Annalong_Kilkeel_County_Down_Northern_Ireland.html";
const mapHref = "https://www.google.com/maps/search/?api=1&query=54.133095,-5.942121";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,500;0,600;1,400&family=Source+Sans+3:wght@400;500;600;700&display=swap";

const included = [
  "Heater for cosy Mourne nights",
  "Fridge & microwave",
  "Kettle & toaster",
  "Sink, crockery & cutlery",
  "Pod One (6m deluxe): private shower, WC & basin",
  "Check-in after 3pm · Check-out by 11am",
];
---

<ConceptLayout
  title="Carrick Little Glamping — 3 Luxury Mourne Pods on Carrick Little Track, Annalong"
  slug="carrick-little-glamping"
  bodyClass="concept-page concept-carricklittle"
  lang="en-GB"
  businessName="Carrick Little Glamping"
  town="Annalong"
  fontHref={fontHref}
  bannerNote="The twilight cedar pods and sunrise pod doorway views are AI-generated visualisations. Live dates open Carrick Little Glamping's Freetobook portal; WhatsApp links directly to +44 7729 787342 and voucher requests go to Julie Mooney."
>
  <header class="cl-header">
    <div class="cl-wrap cl-header-inner">
      <a class="cl-brand" href="#top">
        <strong>Carrick Little Glamping</strong>
        <small>208 Head Road, Annalong · Directly on the Carrick Little Track</small>
      </a>
      <nav class="cl-nav" aria-label="Carrick Little Glamping">
        <a href="#pods">The 3 Pods</a>
        <a href="#packing">What to Bring</a>
        <a href="#vouchers">Gift Vouchers</a>
      </nav>
      <a class="cl-header-cta" href={freetobookUrl} rel="noopener noreferrer">Check Live Dates ↗</a>
    </div>
  </header>

  <main id="top" class="cl-main">
    <section class="cl-hero" aria-labelledby="cl-hero-title">
      <figure class="cl-hero-media">
        <ResponsiveImage
          src="/media/concepts/carrick-little-glamping/carrick-little-pods-twilight.jpg"
          alt="Three curved cedar glamping pods glowing warmly beside Mourne granite drystone walls with mountain slopes behind and the sea in the distance"
          width={1376}
          height={768}
          loading="eager"
          sizes="100vw"
          class="cl-hero-img"
        />
        <figcaption class="cl-hero-cap">Carrick Little Track twilight pods mood. Visualisation (AI-generated).</figcaption>
      </figure>
      <div class="cl-hero-scrim" aria-hidden="true"></div>

      <div class="cl-wrap cl-hero-inner">
        <p class="cl-kicker">Annalong, BT34 4RQ · Mountain &amp; Sea Views · Family-Run by Julie Mooney</p>
        <h1 id="cl-hero-title">Wake up directly on the <em>Carrick Little Track.</em></h1>
        <p class="cl-lede">
          Three cosy cedar glamping pods tucked right into the foot of the
          Mourne Mountains — built for hikers, couples, families and friends'
          getaways with mountain peaks behind you and the Irish Sea ahead.
        </p>
        <div class="cl-hero-actions">
          <a class="cl-btn cl-btn--gorse" href={freetobookUrl} rel="noopener noreferrer">Book direct on Freetobook ↗</a>
          <a class="cl-btn cl-btn--ghost" href={whatsappHref} rel="noopener noreferrer">WhatsApp Julie · {phone} ↗</a>
        </div>
      </div>
    </section>

    <div class="cl-track-bar">
      <div class="cl-wrap cl-track-inner">
        <span><strong>3 Glamping Pods</strong> · Pod One 6m Deluxe sleeps 4</span>
        <span><strong>Bring Only</strong> food, drinks &amp; bedding/towels</span>
        <span><strong>GPS</strong> 54.133095, -5.942121 · 208 Head Rd</span>
      </div>
    </div>

    <section class="cl-pods" id="pods" aria-labelledby="cl-pods-title">
      <div class="cl-wrap cl-pods-grid">
        <div class="cl-pods-copy">
          <p class="cl-kicker cl-kicker--dark">Inside the Pods · Open Year-Round</p>
          <h2 id="cl-pods-title">Warm timber shelter at the trailhead — no tent pegs required.</h2>
          <p>
            Our flagship <strong>Pod One</strong> is a spacious 6-metre deluxe
            pod sleeping up to 4 guests (2 adults &amp; 2 children) with its own
            private washroom (shower, toilet &amp; hand basin). Every pod is
            heated and kitted out for simple mountain evenings after the hills.
          </p>

          <ul class="cl-included" id="packing">
            {included.map((item) => <li>{item}</li>)}
          </ul>

          <div class="cl-bring-box">
            <strong>Simple packing rule:</strong>
            <span>All you need to bring is your own food, drinks, and bedding / towels — everything else is waiting in the pod.</span>
          </div>
        </div>

        <figure class="cl-interior-plate">
          <ResponsiveImage
            src="/media/concepts/carrick-little-glamping/carrick-little-pod-interior.jpg"
            alt="Curved natural timber glamping pod interior with woollen throws and two steaming mugs looking out the arched glass door to sunlit Mourne ridges"
            width={1200}
            height={896}
            sizes="(max-width: 960px) 100vw, 48vw"
            class="cl-interior-img"
          />
          <figcaption>Sunrise doorway view onto the Mourne ridges. Visualisation (AI-generated).</figcaption>
        </figure>
      </div>
    </section>

    <section class="cl-vouchers" id="vouchers" aria-labelledby="cl-vouchers-title">
      <div class="cl-wrap cl-vouchers-grid">
        <div class="cl-voucher-copy">
          <p class="cl-kicker">Gift Vouchers · Valid 1 Year</p>
          <h2 id="cl-vouchers-title">Give someone a night beneath the Mournes.</h2>
          <p>
            Carrick Little Glamping vouchers can be issued for any amount and
            are valid for a full year from purchase. Ring Julie directly on{" "}
            <a href={phoneHref}><strong>{phone}</strong></a>, message on{" "}
            <a href={whatsappHref} rel="noopener noreferrer">WhatsApp ↗</a>, or
            send a quick voucher note below.
          </p>
          <p class="cl-links-row">
            <a href={freetobookUrl} rel="noopener noreferrer">Live Availability ↗</a> ·{" "}
            <a href={mapHref} rel="noopener noreferrer">Google Maps ↗</a> ·{" "}
            <a href={tripadvisor} rel="noopener noreferrer">TripAdvisor ↗</a> ·{" "}
            <a href={facebook} rel="noopener noreferrer">Facebook ↗</a>
          </p>
        </div>

        <form class="cl-form" id="cl-form" data-email={email}>
          <div class="cl-row">
            <label>
              <span>What are you asking about?</span>
              <select name="topic">
                <option value="Gift Voucher">Gift Voucher (any amount)</option>
                <option value="Pod One (6m Deluxe, sleeps 4)">Pod One (6m Deluxe, sleeps 4)</option>
                <option value="Group / Multiple Pods">Booking Multiple Pods</option>
                <option value="General Stay Question">General Stay Question</option>
              </select>
            </label>
            <label>
              <span>Amount or dates</span>
              <input name="details" placeholder="e.g. £100 or June weekend" />
            </label>
          </div>
          <div class="cl-row">
            <label>
              <span>Your name</span>
              <input name="name" autocomplete="name" required />
            </label>
            <label>
              <span>Phone number</span>
              <input name="phone" type="tel" autocomplete="tel" required />
            </label>
          </div>
          <button class="cl-btn cl-btn--gorse cl-btn--full" type="submit">Open enquiry email to Julie →</button>
        </form>
      </div>
    </section>
  </main>

  <footer class="cl-footer">
    <div class="cl-wrap cl-footer-inner">
      <span><strong>Carrick Little Glamping</strong> · 208 Head Road, Annalong, Newry, BT34 4RQ</span>
      <span><a href={phoneHref}>{phone}</a> · <a href={whatsappHref} rel="noopener noreferrer">WhatsApp</a> · <a href={`mailto:${email}`}>{email}</a></span>
    </div>
  </footer>

  <script>
    const form = document.getElementById("cl-form") as HTMLFormElement | null;
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const d = new FormData(form);
      const topic = String(d.get("topic") || "Enquiry");
      const body = [
        `Topic: ${topic}`,
        `Details: ${d.get("details") || ""}`,
        `Name: ${d.get("name") || ""}`,
        `Phone: ${d.get("phone") || ""}`,
      ].join("\n");
      const to = form.dataset.email ?? "";
      const subject = `${topic} — Carrick Little Glamping`;
      const url = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      if (window.dispatchEvent(new CustomEvent("mm:enquiry", { cancelable: true, detail: { to, subject, body, url } }))) {
        window.location.href = url;
      }
    });
  </script>
</ConceptLayout>
