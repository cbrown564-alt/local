---
/* Drawn dispatch card for Shimna Taxis at 18 Railway Street.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

{compact ? (
  <svg
    class="st-mark"
    width="46"
    height="46"
    viewBox="0 0 46 46"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <rect width="46" height="46" rx="3" fill="#12161c"/>
    <rect x="1.5" y="1.5" width="43" height="43" rx="2.2" stroke="#e8a12e" stroke-width="1.5"/>
    <rect x="12" y="10" width="22" height="14" rx="2" fill="#1c222c" stroke="#e8a12e" stroke-width="1.2"/>
    <circle cx="23" cy="17" r="4.2" fill="#e8a12e"/>
    <circle cx="23" cy="17" r="2.1" fill="#12161c"/>
    <path d="M14 30h18M14 34h12" stroke="#d8dde6" stroke-width="1.4" stroke-linecap="round"/>
  </svg>
) : (
  <svg
    class="st-card"
    viewBox="0 0 960 620"
    role="img"
    aria-label="Dispatch card for Shimna Taxis at 18 Railway Street, Newcastle: 24 hours, both phone lines, ring to book"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="st-desk" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1a2029"/>
        <stop offset="1" stop-color="#10141a"/>
      </linearGradient>
      <linearGradient id="st-stock" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f4efe6"/>
        <stop offset="1" stop-color="#e8e0d2"/>
      </linearGradient>
      <linearGradient id="st-amber" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f0b84a"/>
        <stop offset="1" stop-color="#d4891a"/>
      </linearGradient>
      <linearGradient id="st-steel" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#9aa3b0"/>
        <stop offset="1" stop-color="#6b7380"/>
      </linearGradient>
    </defs>

    <rect width="960" height="620" fill="url(#st-desk)"/>
    <rect x="0" y="0" width="960" height="8" fill="#e8a12e"/>

    <!-- Desk lamp glow -->
    <ellipse cx="780" cy="40" rx="180" ry="70" fill="#e8a12e" opacity="0.08"/>

    <!-- Card body -->
    <rect x="140" y="48" width="680" height="520" rx="10" fill="url(#st-stock)" stroke="#c9bfae" stroke-width="1.5"/>
    <rect x="140" y="48" width="680" height="58" rx="10" fill="#12161c"/>
    <rect x="140" y="90" width="680" height="16" fill="#12161c"/>

    <text
      x="480"
      y="86"
      text-anchor="middle"
      fill="#f4efe6"
      font-family="Archivo, Segoe UI, sans-serif"
      font-size="22"
      font-weight="700"
      letter-spacing="6"
    >DISPATCH</text>

    <!-- Roof light chip -->
    <g transform="translate(168 128)">
      <rect x="0" y="18" width="72" height="28" rx="4" fill="#12161c"/>
      <path d="M12 18h48l8-14H4Z" fill="url(#st-amber)"/>
      <circle cx="36" cy="32" r="6" fill="#e8a12e"/>
      <circle cx="36" cy="32" r="2.8" fill="#12161c"/>
    </g>

    <text
      x="480"
      y="158"
      text-anchor="middle"
      fill="#12161c"
      font-family="Source Serif 4, Times New Roman, serif"
      font-size="42"
      font-weight="700"
      letter-spacing="1"
    >Shimna Taxis</text>
    <text
      x="480"
      y="186"
      text-anchor="middle"
      fill="#8a5a12"
      font-family="Archivo, Segoe UI, sans-serif"
      font-size="13"
      font-weight="700"
      letter-spacing="3.2"
    >SHIMNA TRAVEL TAXIS · NEWCASTLE</text>

    <line x1="200" y1="208" x2="760" y2="208" stroke="#c9bfae" stroke-width="1.2"/>

    <text
      x="480"
      y="248"
      text-anchor="middle"
      fill="#12161c"
      font-family="Archivo, Segoe UI, sans-serif"
      font-size="20"
      font-weight="700"
      letter-spacing="2.4"
    >18 RAILWAY STREET</text>
    <text
      x="480"
      y="274"
      text-anchor="middle"
      fill="#4a5360"
      font-family="Archivo, Segoe UI, sans-serif"
      font-size="14"
      font-weight="600"
      letter-spacing="1.8"
    >NEWCASTLE · CO. DOWN · BT33 0AL</text>

    <!-- Chip row -->
    <g transform="translate(220 304)">
      <rect x="0" y="0" width="140" height="36" rx="4" fill="#12161c"/>
      <text x="70" y="23" text-anchor="middle" fill="#e8a12e" font-family="Archivo, sans-serif" font-size="12" font-weight="700" letter-spacing="1.6">24 HRS / 365</text>
      <rect x="160" y="0" width="160" height="36" rx="4" fill="#12161c"/>
      <text x="240" y="23" text-anchor="middle" fill="#f4efe6" font-family="Archivo, sans-serif" font-size="12" font-weight="700" letter-spacing="1.4">RING TO BOOK</text>
      <rect x="340" y="0" width="180" height="36" rx="4" fill="#12161c"/>
      <text x="430" y="23" text-anchor="middle" fill="#f4efe6" font-family="Archivo, sans-serif" font-size="12" font-weight="700" letter-spacing="1.4">CARDS WELCOME</text>
    </g>

    <line x1="200" y1="368" x2="760" y2="368" stroke="#c9bfae" stroke-width="1.2"/>

    <!-- Phone block -->
    <g transform="translate(220 400)">
      <text x="0" y="0" fill="#4a5360" font-family="Archivo, sans-serif" font-size="11" font-weight="700" letter-spacing="2">LINE 1</text>
      <text x="0" y="32" fill="#12161c" font-family="Archivo, sans-serif" font-size="28" font-weight="800" letter-spacing="1">028 437 24100</text>
      <text x="320" y="0" fill="#4a5360" font-family="Archivo, sans-serif" font-size="11" font-weight="700" letter-spacing="2">LINE 2</text>
      <text x="320" y="32" fill="#12161c" font-family="Archivo, sans-serif" font-size="28" font-weight="800" letter-spacing="1">028 4372 3030</text>
    </g>

    <text
      x="480"
      y="500"
      text-anchor="middle"
      fill="#4a5360"
      font-family="Archivo, sans-serif"
      font-size="13"
      font-weight="600"
    >info@shimnatravel.co.uk</text>
    <text
      x="480"
      y="528"
      text-anchor="middle"
      fill="#8a5a12"
      font-family="Source Serif 4, Times New Roman, serif"
      font-size="16"
      font-weight="600"
      font-style="italic"
    >Airport · day trips · executive · golf · female driver on request</text>

    <!-- Meter stamp -->
    <g transform="translate(780 480)">
      <circle cx="0" cy="0" r="42" fill="none" stroke="url(#st-steel)" stroke-width="3"/>
      <circle cx="0" cy="0" r="34" fill="none" stroke="#e8a12e" stroke-width="1.5" stroke-dasharray="3 4"/>
      <text x="0" y="-4" text-anchor="middle" fill="#12161c" font-family="Archivo, sans-serif" font-size="10" font-weight="800" letter-spacing="1">FARE</text>
      <text x="0" y="14" text-anchor="middle" fill="#12161c" font-family="Archivo, sans-serif" font-size="11" font-weight="700">RING</text>
    </g>
  </svg>
)}
