---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

const phone = "028 4321 8150";
const phoneHref = "tel:+442843218150";
---

<ConceptLayout
  title={"New Peking Corner — independent concept"}
  slug="new-peking-corner"
  bodyClass="concept-page concept-peking"
  businessName="New Peking Corner"
  town="Newcastle"
>
  <header class="pk-header">
    <a class="pk-brand" href="/concepts/new-peking-corner/">New Peking Corner</a>
    <a class="pk-phone" href={phoneHref}>{phone}</a>
  </header>
  <main class="pk-main">
    <p class="pk-eyebrow">Takeaway · Railway Street</p>
    <h1>Tonight’s order starts with a phone call.</h1>
    <p class="pk-lead">
      New Peking Corner is the takeaway at 28 Railway Street, Newcastle.
      This page does not invent a menu. Ring the shop and they will tell you
      what is on.
    </p>
    <p class="pk-cta">
      <a class="pk-btn" href={phoneHref}>Call {phone}</a>
    </p>
    <section class="pk-find">
      <h2>Find the door</h2>
      <p>28 Railway Street, Newcastle, BT33 0AL</p>
      <p class="pk-note">Number as listed on public directories, 22 August 2026.</p>
    </section>
  </main>
</ConceptLayout>
