---
/* Mount Panther Farm Park: Interactive Seasons and Visits Stage.
   Connects straight to live Digitickets online ticketing and group booking enquiries. */
interface Props {
  ticketHref: string;
}
const { ticketHref } = Astro.props;

const visits = [
  {
    id: "walks",
    label: "Farm walks and passes",
    title: "Meet Highland calves, alpacas, deer, and farmyard favourites across open pastures.",
    summary: "Spend a relaxed morning or afternoon exploring paddock walks and play zones, with single-day entry and Season Passes booked directly online.",
    points: [
      { term: "Animal paddocks", detail: "Hands-on encounters with Highland calves, alpacas, deer, and farmyard regulars." },
      { term: "Adventure play", detail: "Indoor and outdoor play areas suited to clear skies and County Down showers alike." },
      { term: "Passes and entry", detail: "Day tickets and family Season Passes booked online through Digitickets." },
    ],
    cta: "Book day tickets online",
    href: ticketHref,
    external: true,
    selectKind: "",
  },
  {
    id: "groups",
    label: "School trips and parties",
    title: "Structured outdoor farm days for primary schools, nurseries, and birthday celebrations.",
    summary: "Enjoy safe coach arrival, dedicated picnic tables, and direct coordination with the Clough farm office.",
    points: [
      { term: "School and nursery", detail: "Guided animal talks, safe coach drop-off, and teacher planning notes on request." },
      { term: "Birthday parties", detail: "Reserved party area with full farm trail access for flexible weekend group sizes." },
      { term: "Covered shelter", detail: "Dedicated indoor and covered picnic space ready whatever the weather brings." },
    ],
    cta: "Send a group enquiry",
    href: "#groups",
    external: false,
    selectKind: "Primary school or nursery trip",
  },
  {
    id: "seasonal",
    label: "Pumpkin Patch and Christmas",
    title: "Spring lambs, summer picnics, autumn pumpkins, and our annual Christmas Experience.",
    summary: "Every seasonal event runs on timed entry slots so families explore themed trails without long queues.",
    points: [
      { term: "Autumn events", detail: "Pumpkin Patch harvest trails, photo spots, and Halloween Fright Night evenings." },
      { term: "Winter visits", detail: "Annual Christmas Experience with festive farm trails and seasonal treats." },
      { term: "Timed entry", detail: "Advance online tickets released per season on the Digitickets calendar." },
    ],
    cta: "Browse seasonal ticket calendar",
    href: ticketHref,
    external: true,
    selectKind: "",
  },
];
---

<section class="mp-stage" id="seasons" aria-labelledby="mp-planner-title">
  <div class="mp-wrap mp-stage-grid" data-mp-planner>
    <div class="mp-stage-copy">
      <h2 id="mp-planner-title">Seasons and visits across the farm park.</h2>

      <div class="mp-tabs" role="tablist" aria-label="Seasons and visits">
        {visits.map((v, idx) => (
          <button
            type="button"
            role="tab"
            id={`mp-tab-${v.id}`}
            aria-controls={`mp-panel-${v.id}`}
            aria-selected={idx === 0 ? "true" : "false"}
            tabindex={idx === 0 ? "0" : "-1"}
            class:list={["mp-tab", idx === 0 && "is-active"]}
            data-mp-tab={v.id}
          >
            {v.label}
          </button>
        ))}
      </div>

      {visits.map((v, idx) => (
        <div
          class="mp-panel"
          role="tabpanel"
          id={`mp-panel-${v.id}`}
          aria-labelledby={`mp-tab-${v.id}`}
          data-mp-panel={v.id}
          hidden={idx !== 0}
        >
          <h3 class="mp-panel-title">{v.title}</h3>
          <p class="mp-panel-summary">{v.summary}</p>
          <dl class="mp-ledger">
            {v.points.map((p) => (
              <div class="mp-ledger-row">
                <dt>{p.term}</dt>
                <dd>{p.detail}</dd>
              </div>
            ))}
          </dl>
          <a
            class="mp-btn mp-btn--light"
            href={v.href}
            target={v.external ? "_blank" : undefined}
            rel={v.external ? "noopener noreferrer" : undefined}
            data-mp-select-kind={v.selectKind || undefined}
          >
            {v.cta}
          </a>
        </div>
      ))}
    </div>

    <div class="mp-stage-media">
      <figure class="mp-plate">
        <picture>
          <source
            srcset="/media/concepts/mount-panther-farm/mount-panther-orchard-play-640.webp 640w, /media/concepts/mount-panther-farm/mount-panther-orchard-play-1265.webp 1265w"
            sizes="(max-width: 960px) 100vw, 44vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/mount-panther-farm/mount-panther-orchard-play.jpg"
            alt="Rustic farm park courtyard with timber picnic tables, flowering borders, and seasonal harvest crates"
            width="1408"
            height="768"
            loading="lazy"
          />
        </picture>
        <figcaption>Indicative seasonal orchard courtyard visualisation.</figcaption>
      </figure>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-mp-planner]");
    if (!root) return;
    const tabs = [...root.querySelectorAll("[data-mp-tab]")];
    const panels = [...root.querySelectorAll("[data-mp-panel]")];

    const activate = (btn, moveFocus) => {
      const id = btn.getAttribute("data-mp-tab");
      tabs.forEach((t) => {
        const active = t === btn;
        t.classList.toggle("is-active", active);
        t.setAttribute("aria-selected", active ? "true" : "false");
        t.setAttribute("tabindex", active ? "0" : "-1");
      });
      panels.forEach((p) => {
        p.hidden = p.getAttribute("data-mp-panel") !== id;
      });
      if (moveFocus) btn.focus();
    };

    tabs.forEach((btn, idx) => {
      btn.addEventListener("click", () => activate(btn, false));
      btn.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") {
          e.preventDefault();
          activate(tabs[(idx + 1) % tabs.length], true);
        } else if (e.key === "ArrowLeft") {
          e.preventDefault();
          activate(tabs[(idx - 1 + tabs.length) % tabs.length], true);
        }
      });
    });

    root.querySelectorAll("[data-mp-select-kind]").forEach((link) => {
      link.addEventListener("click", () => {
        const val = link.getAttribute("data-mp-select-kind");
        const select = document.querySelector("[data-mp-kind-select]");
        if (select && val) {
          select.value = val;
          select.dispatchEvent(new Event("change", { bubbles: true }));
        }
      });
    });
  })();
</script>
