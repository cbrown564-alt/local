---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import MwFinishStudio from "./MwFinishStudio.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";

/* Mourne Windows & Doors — 2 Newry Road, Hilltown, Newry, BT34 5TG.
   Sources (live-fetched 26 Nov 2026): mournewindows.com (/, /about-us, /windows,
   /doors, /our-reviews, /contact).
   - Over 40 years supplying & installing uPVC and aluminium windows, doors,
     conservatories and sunrooms across Newry, Belfast, Dublin and all Ireland.
   - Product range published on site:
     Windows: Casement, Tilt & Turn, Vertical Sliding Sash, Flush Casement, Dako Windows.
     Doors: Composite Doors, French & Patio Doors, uPVC Doors, Entrance Doors.
     Aluminium: Windows, Bi-fold Doors, Sliding Doors, Roof Lanterns, Flat Glass,
       Heritage Products, Internal Aluminium Screens.
     Other: Conservatories & Sunrooms, Fascias & Soffits, Glass, Aftercare,
       Finance / Grants / Offers.
   - Phone: 028 4063 8454 (NI) · +353 1 617 7825 (ROI) · Email: info@mournewindows.com.
   Brief: research/concepts/mourne-windows/mourne-windows-elevation-brief.md */

const phoneNi = "028 4063 8454";
const phoneNiHref = "tel:+442840638454";
const email = "info@mournewindows.com";
const facebook = "https://www.facebook.com/mournewindows";
const instagram = "https://www.instagram.com/mourne_windows/?hl=en";
const mapHref = "https://www.google.com/maps/search/?api=1&query=2+Newry+Road+Hilltown+Newry+BT34+5TG";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap";

const systems = [
  {
    id: "windows",
    label: "Windows & Heritage Sash",
    heading: "Energy-efficient casement, flush, tilt & turn, Dako and vertical sliding sash.",
    summary: "Engineered for security, thermal performance and clean sightlines — from traditional vertical sliding sash to modern flush casement and Dako window systems.",
    items: ["Casement & Flush Casement Windows", "Vertical Sliding Sash Windows", "Tilt & Turn Windows", "Dako Window Systems"],
  },
  {
    id: "doors",
    label: "Composite, Patio & uPVC Doors",
    heading: "Made-to-measure entrance and garden doors in chamfered or sculpted profiles.",
    summary: "Built to suit period stone cottages and contemporary new builds alike, with solid panel or glazing combinations tailored to your security and daylight needs.",
    items: ["Composite Entrance Doors", "French & Patio Doors", "uPVC Entrance & Back Doors", "Dako Door Ranges"],
  },
  {
    id: "aluminium",
    label: "Aluminium, Bi-Folds & Lanterns",
    heading: "Slimline aluminium glazing that opens the whole elevation to the view.",
    summary: "Architectural aluminium windows, bi-fold doors, sliding doors, roof lanterns, flat glass and internal aluminium screens.",
    items: ["Aluminium Bi-Fold & Sliding Doors", "Roof Lanterns & Flat Glass", "Heritage Aluminium Products", "Internal Aluminium Screens"],
  },
  {
    id: "sunrooms",
    label: "Conservatories, Sunrooms & Aftercare",
    heading: "Complete glazing extensions, fascias, soffits and long-term aftercare.",
    summary: "End-to-end design, home survey, installation and aftercare backed by over 40 years in the trade, with finance and grant guidance available.",
    items: ["Bespoke Conservatories & Sunrooms", "Fascias, Soffits & Replacement Glass", "Dedicated Aftercare Support", "Finance, Grants & Offers Advice"],
  },
];
---

<ConceptLayout
  title="Mourne Windows & Doors — 40+ Years Supplying & Fitting Glazing, Hilltown, Newry"
  slug="mourne-windows"
  bodyClass="concept-page concept-mournewindows"
  lang="en-GB"
  businessName="Mourne Windows & Doors"
  town="Hilltown / Newry"
  fontHref={fontHref}
  bannerNote="The aluminium bi-fold extension and heritage sliding sash window studies are AI-generated visualisations. Free home survey requests compose an email directly to info@mournewindows.com or call 028 4063 8454."
>
  <header class="mw-header">
    <div class="mw-wrap mw-header-inner">
      <a class="mw-brand" href="#top">
        <span class="mw-brand-mark" aria-hidden="true"></span>
        <span>
          <strong>Mourne Windows &amp; Doors</strong>
          <small>Hilltown, Newry · 40+ Years in the Trade</small>
        </span>
      </a>
      <nav class="mw-nav" aria-label="Mourne Windows and Doors">
        <a href="#systems">Glazing Systems</a>
        <a href="#craft">40 Years of Craft</a>
        <a href="#survey">Free Home Survey</a>
      </nav>
      <div class="mw-header-right">
        <a class="mw-tel" href={phoneNiHref}>{phoneNi}</a>
        <a class="mw-cta" href="#survey">Book Free Survey</a>
      </div>
    </div>
  </header>

  <main id="top" class="mw-main">
    <section class="mw-hero" aria-labelledby="mw-hero-title">
      <div class="mw-hero-frame">
        <figure class="mw-hero-media">
          <ResponsiveImage
            src="/media/concepts/mourne-windows/mourne-windows-bifold-view.jpg"
            alt="Contemporary Irish country home extension with slim anthracite aluminium bi-fold doors opened onto a granite patio overlooking green Mourne hills"
            width={1376}
            height={768}
            loading="eager"
            sizes="100vw"
            class="mw-hero-img"
          />
          <figcaption>Architectural bi-fold glazing &amp; daylight mood. Visualisation (AI-generated).</figcaption>
        </figure>
        <div class="mw-hero-scrim" aria-hidden="true"></div>

        <div class="mw-wrap mw-hero-inner">
          <div class="mw-hero-panel">
            <p class="mw-eyebrow">2 Newry Road, Hilltown · Serving Newry, Belfast, Dublin &amp; All Ireland</p>
            <h1 id="mw-hero-title">Precision windows, doors &amp; architectural glazing — fitted for over 40 years.</h1>
            <p class="mw-lede">
              uPVC, slimline aluminium, heritage sliding sash, composite doors,
              roof lanterns and sunrooms — surveyed, supplied and installed by
              our experienced Hilltown team.
            </p>
            <div class="mw-hero-actions">
              <a class="mw-btn mw-btn--steel" href="#survey">Request a free home survey</a>
              <a class="mw-btn mw-btn--ghost" href={phoneNiHref}>Call {phoneNi}</a>
            </div>
          </div>
        </div>
      </div>

      <div class="mw-spec-bar">
        <div class="mw-wrap mw-spec-inner">
          <span><strong>40+ Years</strong> supplying &amp; installing</span>
          <span><strong>uPVC &amp; Aluminium</strong> Dako &amp; heritage systems</span>
          <span><strong>Free Home Survey</strong> &amp; no-obligation quote</span>
          <span><strong>Showroom</strong> 2 Newry Rd, Hilltown BT34 5TG</span>
        </div>
      </div>
    </section>

    <section class="mw-systems" id="systems" aria-labelledby="mw-systems-title">
      <div class="mw-wrap">
        <div class="mw-systems-head">
          <div>
            <p class="mw-eyebrow mw-eyebrow--dark">Glazing Specification Selector</p>
            <h2 id="mw-systems-title">Four product families — pick what your home needs.</h2>
          </div>
          <p>
            Explore our range below and carry your selection straight into a
            free home survey request with our Hilltown consultants.
          </p>
        </div>

        <div class="mw-selector">
          <div class="mw-tabs" role="tablist" aria-label="Product families">
            {systems.map((sys, idx) => (
              <button
                type="button"
                role="tab"
                aria-selected={idx === 0 ? "true" : "false"}
                class:list={["mw-tab", { "is-active": idx === 0 }]}
                data-mw-tab={sys.id}
              >
                <span class="mw-tab-no">0{idx + 1}</span>
                <strong>{sys.label}</strong>
              </button>
            ))}
          </div>

          <div class="mw-stage">
            {systems.map((sys, idx) => (
              <div class="mw-panel" data-mw-panel={sys.id} hidden={idx !== 0}>
                <h3>{sys.heading}</h3>
                <p>{sys.summary}</p>
                <ul class="mw-spec-list">
                  {sys.items.map((item) => <li>{item}</li>)}
                </ul>
                <a class="mw-btn mw-btn--dark" href="#survey" data-mw-pick={sys.label}>
                  Request survey for {sys.label} →
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <MwFinishStudio />

    <section class="mw-craft" id="craft" aria-labelledby="mw-craft-title">
      <div class="mw-wrap mw-craft-grid">
        <figure class="mw-sash-plate">
          <ResponsiveImage
            src="/media/concepts/mourne-windows/mourne-windows-sash-craft.jpg"
            alt="Crisp white heritage vertical sliding sash window with fine glazing bars set into a sunlit limestone reveal"
            width={1200}
            height={896}
            sizes="(max-width: 960px) 100vw, 48vw"
            class="mw-sash-img"
          />
          <figcaption>Heritage vertical sliding sash finish mood. Visualisation (AI-generated).</figcaption>
        </figure>

        <div class="mw-craft-copy">
          <p class="mw-eyebrow mw-eyebrow--dark">Design · Energy Efficiency · Security</p>
          <h2 id="mw-craft-title">Traditional joinery character backed by modern thermal performance.</h2>
          <p>
            Whether you are replacing draughty frames in a County Down home,
            specifying aluminium bi-folds for a new extension or planning a
            sunroom, our trained consultants walk through energy efficiency,
            security and profile options during your free home survey — with
            dedicated aftercare long after fitting day.
          </p>
          <dl class="mw-showroom">
            <div><dt>Showroom &amp; Base</dt><dd>2 Newry Road, Hilltown, Newry, BT34 5TG</dd></div>
            <div><dt>Service Area</dt><dd>Newry, County Down, Belfast, Dublin &amp; across Ireland</dd></div>
            <div><dt>Telephone</dt><dd><a href={phoneNiHref}>{phoneNi}</a> · <a href={`mailto:${email}`}>{email}</a></dd></div>
          </dl>
          <div class="mw-craft-cta">
            <a class="mw-btn mw-btn--dark" href="#survey">Arrange a free home survey →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="mw-survey" id="survey" aria-labelledby="mw-survey-title">
      <div class="mw-wrap mw-survey-grid">
        <div>
          <p class="mw-eyebrow">Free Home Survey &amp; Quote</p>
          <h2 id="mw-survey-title">Tell us about your project.</h2>
          <p>
            Send your project details straight to{" "}
            <a href={`mailto:${email}`}>{email}</a> to arrange a free,
            no-obligation survey or showroom appointment in Hilltown, or ring us
            directly on <a href={phoneNiHref}><strong>{phoneNi}</strong></a>.
          </p>
          <div class="mw-survey-links">
            <a href={mapHref} rel="noopener noreferrer">Showroom Directions ↗</a>
            <a href={facebook} rel="noopener noreferrer">Facebook ↗</a>
            <a href={instagram} rel="noopener noreferrer">Instagram ↗</a>
          </div>
        </div>

        <form class="mw-form" id="mw-form" data-email={email}>
          <div class="mw-row">
            <label>
              <span>Project focus</span>
              <select name="product" id="mw-product">
                <option value="Windows & Heritage Sash">Windows &amp; Heritage Sash</option>
                <option value="Composite, Patio & uPVC Doors">Composite, Patio &amp; uPVC Doors</option>
                <option value="Aluminium, Bi-Folds & Lanterns">Aluminium, Bi-Folds &amp; Lanterns</option>
                <option value="Conservatories, Sunrooms & Aftercare">Conservatories, Sunrooms &amp; Aftercare</option>
                <option value="Full House New Build / Upgrade">Full House New Build / Upgrade</option>
              </select>
            </label>
            <label>
              <span>Town or county</span>
              <input name="location" placeholder="e.g. Newry or Downpatrick" required />
            </label>
          </div>
          <div class="mw-row">
            <label>
              <span>Your name</span>
              <input name="name" autocomplete="name" required />
            </label>
            <label>
              <span>Phone number</span>
              <input name="phone" type="tel" autocomplete="tel" required />
            </label>
          </div>
          <label>
            <span>Approximate openings or notes</span>
            <textarea name="notes" rows="2" placeholder="e.g. 8 replacement windows + front composite door, or bi-fold extension"></textarea>
          </label>
          <button class="mw-btn mw-btn--steel mw-btn--full" type="submit">Open survey request email →</button>
        </form>
      </div>

      <div class="mw-wrap" style="margin-top: 44px;">
        <LocalAreaMap
          id="mourne-windows-map"
          businessName="Mourne Windows & Doors"
          address="2 Newry Road, Hilltown, Newry, BT34 5TG"
          lon={-6.115}
          lat={54.198}
          spanKm={24}
          radiusKm={22}
          radiusLabel="Hilltown Showroom & Free Home Survey Area"
          tone="dark"
          mapHref={mapHref}
          kicker="Hilltown Showroom & Catchment"
          markers={[
            { name: "Newry", lon: -6.340, lat: 54.176, note: "15 mins", side: "l" },
            { name: "Banbridge", lon: -6.268, lat: 54.348, note: "20 mins", side: "l" },
            { name: "Castlewellan", lon: -5.939, lat: 54.259, note: "15 mins", side: "r" },
            { name: "Rostrevor", lon: -6.197, lat: 54.102, note: "15 mins", side: "l" },
            { name: "Downpatrick", lon: -5.716, lat: 54.328, note: "30 mins", side: "r" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="mw-footer">
    <div class="mw-wrap mw-footer-inner">
      <span><strong>Mourne Windows &amp; Doors</strong> · 2 Newry Road, Hilltown, Newry, BT34 5TG</span>
      <span><a href={phoneNiHref}>{phoneNi}</a> · <a href={`mailto:${email}`}>{email}</a></span>
    </div>
  </footer>

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>("[data-mw-tab]");
    const panels = document.querySelectorAll<HTMLElement>("[data-mw-panel]");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const id = tab.dataset.mwTab;
        tabs.forEach((t) => {
          const active = t.dataset.mwTab === id;
          t.classList.toggle("is-active", active);
          t.setAttribute("aria-selected", String(active));
        });
        panels.forEach((p) => {
          p.hidden = p.dataset.mwPanel !== id;
        });
      });
    });

    const prodSelect = document.getElementById("mw-product") as HTMLSelectElement | null;
    document.querySelectorAll<HTMLElement>("[data-mw-pick]").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (prodSelect && btn.dataset.mwPick) prodSelect.value = btn.dataset.mwPick;
      });
    });

    const form = document.getElementById("mw-form") as HTMLFormElement | null;
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const d = new FormData(form);
      const body = [
        `Project focus: ${d.get("product") || ""}`,
        `Location: ${d.get("location") || ""}`,
        `Name: ${d.get("name") || ""}`,
        `Phone: ${d.get("phone") || ""}`,
        "",
        String(d.get("notes") || ""),
      ].join("\n");
      const to = form.dataset.email ?? "";
      const subject = `Free Home Survey Request — ${d.get("product")}`;
      const url = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      if (window.dispatchEvent(new CustomEvent("mm:enquiry", { cancelable: true, detail: { to, subject, body, url } }))) {
        window.location.href = url;
      }
    });
  </script>
</ConceptLayout>
