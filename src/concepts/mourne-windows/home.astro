---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import MwFinishStudio from "./MwFinishStudio.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";

/* Mourne Windows & Doors — 2 Newry Road, Hilltown, Newry, BT34 5TG.
   Sources (live-fetched 26 Nov 2026): mournewindows.com (/, /about-us, /windows,
   /doors, /our-reviews, /contact).
   - Over 40 years supplying & installing uPVC and aluminium windows, doors,
     conservatories and sunrooms across Newry, Belfast, Dublin and all Ireland.
   - Product range published on site:
     Windows: Casement, Tilt & Turn, Vertical Sliding Sash, Flush Casement, Dako Windows.
     Doors: Composite Doors, French & Patio Doors, uPVC Doors, Entrance Doors.
     Aluminium: Windows, Bi-fold Doors, Sliding Doors, Roof Lanterns, Flat Glass,
       Heritage Products, Internal Aluminium Screens.
     Other: Conservatories & Sunrooms, Fascias & Soffits, Glass, Aftercare,
       Finance / Grants / Offers.
   - Phone: 028 4063 8454 (NI) · +353 1 617 7825 (ROI) · Email: info@mournewindows.com.
   Brief: research/concepts/mourne-windows/mourne-windows-elevation-brief.md */

const phoneNi = "028 4063 8454";
const phoneNiHref = "tel:+442840638454";
const phoneRoi = "+353 1 617 7825";
const phoneRoiHref = "tel:+35316177825";
const email = "info@mournewindows.com";
const facebook = "https://www.facebook.com/mournewindows";
const instagram = "https://www.instagram.com/mourne_windows/?hl=en";
const mapHref = "https://www.google.com/maps/search/?api=1&query=2+Newry+Road+Hilltown+Newry+BT34+5TG";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap";

const systems = [
  {
    id: "bifold",
    label: "Bi-fold and sliding doors",
    selectValue: "Bi-fold and sliding doors",
    previewImg: "/media/concepts/mourne-windows/mourne-windows-bifold-view.jpg",
    previewCaption: "Slimline aluminium bi-folds, sliding doors, and roof lanterns opening the full elevation.",
    heading: "Slimline aluminium glazing that opens the whole wall to natural light",
    summary:
      "Thermally broken aluminium bi-fold doors, sliding doors, roof lanterns, flat glass, heritage aluminium profiles, and internal aluminium screens surveyed and fitted across Ireland.",
    items: [
      "Aluminium bi-fold and sliding doors",
      "Roof lanterns and architectural flat glass",
      "Heritage aluminium windows and doors",
      "Internal aluminium screens",
    ],
  },
  {
    id: "sash",
    label: "Heritage sliding sash",
    selectValue: "Heritage sliding sash",
    previewImg: "/media/concepts/mourne-windows/mourne-windows-sash-craft.jpg",
    previewCaption: "Vertical sliding sash, flush casement, tilt and turn, and Dako window systems.",
    heading: "Period window character paired with modern warmth and security",
    summary:
      "Traditional vertical sliding sash, flush casement, tilt and turn, and Dako window systems built for County Down weather, crisp sightlines, and long-term thermal efficiency.",
    items: [
      "Vertical sliding sash windows",
      "Casement and flush casement windows",
      "Tilt and turn uPVC and aluminium windows",
      "Dako window systems",
    ],
  },
  {
    id: "doors-sunrooms",
    label: "Composite doors and sunrooms",
    selectValue: "Composite doors and sunrooms",
    previewImg: "/media/concepts/mourne-windows/mourne-windows-bifold-view.jpg",
    previewCaption: "Made-to-measure composite doors, French and patio doors, sunrooms, and aftercare.",
    heading: "Bespoke entrance doors, glazed extensions, and long-term aftercare",
    summary:
      "Composite entrance doors, French and patio doors, uPVC and Dako door ranges, sunrooms, conservatories, fascias, soffits, and replacement glass, backed by over 40 years in the trade and finance or grant guidance.",
    items: [
      "Composite, uPVC, and Dako entrance doors",
      "French doors and garden patio doors",
      "Bespoke conservatories and sunrooms",
      "Fascias, soffits, glass, and aftercare",
    ],
  },
];
---

<ConceptLayout
  title="Mourne Windows and Doors, Hilltown, Newry"
  slug="mourne-windows"
  bodyClass="concept-page concept-mournewindows"
  lang="en-GB"
  businessName="Mourne Windows & Doors"
  town="Hilltown / Newry"
  fontHref={fontHref}
  bannerNote="The aluminium bi-fold extension and heritage sliding sash window studies are AI-generated visualisations. Free home survey requests compose an email directly to info@mournewindows.com or call 028 4063 8454."
>
  <header class="mw-header" id="mw-header">
    <div class="mw-wrap mw-header-inner">
      <a class="mw-brand" href="#top">
        <span class="mw-brand-mark" aria-hidden="true"></span>
        <span>Mourne Windows &amp; Doors</span>
      </a>

      <nav class="mw-nav" aria-label="Mourne Windows and Doors">
        <div class="mw-nav-drop" data-mw-drop>
          <button
            type="button"
            class="mw-nav-drop-btn"
            aria-expanded="false"
            aria-controls="mw-systems-menu"
          >
            Glazing systems <span aria-hidden="true">▾</span>
          </button>
          <div class="mw-drop-panel" id="mw-systems-menu" hidden>
            <div class="mw-drop-list">
              {systems.map((sys, idx) => (
                <a
                  href="#systems"
                  class:list={["mw-drop-item", { "is-active": idx === 0 }]}
                  data-mw-drop-item={sys.id}
                  data-mw-drop-img={sys.previewImg}
                  data-mw-drop-cap={sys.previewCaption}
                >
                  <strong>{sys.label}</strong>
                  <span>{sys.items[0]}, {sys.items[1]}</span>
                </a>
              ))}
            </div>
            <figure class="mw-drop-preview">
              <img
                src={systems[0].previewImg}
                alt="Mourne Windows architectural glazing system preview"
                data-mw-drop-preview-img
                width="600"
                height="375"
              />
              <figcaption data-mw-drop-preview-cap>{systems[0].previewCaption}</figcaption>
            </figure>
          </div>
        </div>
        <a href="#finish-studio">Finish studio</a>
        <a href="#survey">Free home survey</a>
      </nav>

      <div class="mw-header-right">
        <a class="mw-tel" href={phoneNiHref}>{phoneNi}</a>
        <a class="mw-cta" href="#survey">Book free survey</a>
      </div>
    </div>
  </header>

  <main id="top" class="mw-main">
    <section class="mw-hero" aria-labelledby="mw-hero-title">
      <div class="mw-hero-sentinel" id="mw-hero-sentinel" aria-hidden="true"></div>
      <div class="mw-hero-media">
        <ResponsiveImage
          src="/media/concepts/mourne-windows/mourne-windows-bifold-view.jpg"
          alt="Contemporary Irish country home extension with slim anthracite aluminium bi-fold doors opened onto a granite patio overlooking green Mourne hills"
          width={1376}
          height={768}
          loading="eager"
          sizes="100vw"
          class="mw-hero-img"
        />
      </div>
      <div class="mw-hero-scrim" aria-hidden="true"></div>

      <div class="mw-wrap mw-hero-inner">
        <div class="mw-hero-copy">
          <h1 id="mw-hero-title">Architectural glazing, fitted for forty years.</h1>
          <p class="mw-lede">
            Aluminium bi-folds, heritage sliding sash, composite doors, and
            sunrooms, surveyed and fitted from Hilltown across Ireland.
          </p>
          <a class="mw-btn mw-btn--steel" href="#survey">Request a free home survey</a>
        </div>
      </div>

      <div class="mw-hero-foot">
        <div class="mw-wrap">
          <p class="mw-hero-caption">Indicative architectural bi-fold glazing and daylight visualisation.</p>
        </div>
      </div>
    </section>

    <section class="mw-systems" id="systems" aria-labelledby="mw-systems-title">
      <div class="mw-wrap">
        <div class="mw-systems-head">
          <h2 id="mw-systems-title">Glazing systems engineered for Irish weather and lasting sightlines.</h2>
          <p>
            Over 40 years supplying and installing Dako, uPVC, and heritage
            aluminium glazing across Newry, Belfast, Dublin, and all Ireland.
          </p>
        </div>

        <div class="mw-tablist" role="tablist" aria-label="Glazing systems">
          {systems.map((sys, idx) => (
            <button
              type="button"
              role="tab"
              id={`mw-tab-${sys.id}`}
              aria-selected={idx === 0 ? "true" : "false"}
              aria-controls={`mw-panel-${sys.id}`}
              tabindex={idx === 0 ? "0" : "-1"}
              class:list={["mw-tab", { "is-active": idx === 0 }]}
              data-mw-tab={sys.id}
            >
              {sys.label}
            </button>
          ))}
        </div>

        <div class="mw-systems-grid">
          <div class="mw-stage">
            {systems.map((sys, idx) => (
              <div
                class="mw-panel"
                role="tabpanel"
                id={`mw-panel-${sys.id}`}
                aria-labelledby={`mw-tab-${sys.id}`}
                data-mw-panel={sys.id}
                hidden={idx !== 0}
              >
                <h3>{sys.heading}</h3>
                <p class="mw-panel-copy">{sys.summary}</p>
                <ul class="mw-spec-list">
                  {sys.items.map((item) => <li>{item}</li>)}
                </ul>
                <a class="mw-btn mw-btn--steel" href="#survey" data-mw-pick={sys.selectValue}>
                  Request survey for {sys.label.toLowerCase()}
                </a>
              </div>
            ))}
          </div>

          <div class="mw-craft-side">
            <figure class="mw-sash-plate">
              <ResponsiveImage
                src="/media/concepts/mourne-windows/mourne-windows-sash-craft.jpg"
                alt="Crisp white heritage vertical sliding sash window with fine glazing bars set into a sunlit limestone reveal"
                width={1200}
                height={896}
                sizes="(max-width: 960px) 100vw, 48vw"
                class="mw-sash-img"
              />
              <figcaption>Indicative heritage vertical sliding sash finish visualisation.</figcaption>
            </figure>

            <dl class="mw-showroom">
              <div>
                <dt>Hilltown showroom</dt>
                <dd>2 Newry Road, Hilltown, Newry, BT34 5TG</dd>
              </div>
              <div>
                <dt>Fitting coverage</dt>
                <dd>Newry, County Down, Belfast, Dublin, and all Ireland</dd>
              </div>
              <div>
                <dt>Direct telephone</dt>
                <dd>
                  <a href={phoneNiHref}>{phoneNi}</a>
                  {" · "}
                  <a href={phoneRoiHref}>{phoneRoi}</a>
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <MwFinishStudio />

    <section class="mw-survey" id="survey" aria-labelledby="mw-survey-title">
      <div class="mw-wrap mw-survey-grid">
        <div class="mw-survey-copy">
          <h2 id="mw-survey-title">Arrange your free home survey and quote.</h2>
          <p>
            Share your project details with our Hilltown consultants at{" "}
            <a href={`mailto:${email}`}>{email}</a> for a free, no-obligation
            home survey or showroom visit, or call{" "}
            <a href={phoneNiHref}>{phoneNi}</a>.
          </p>
          <dl class="mw-survey-meta">
            <div>
              <dt>Showroom address</dt>
              <dd>2 Newry Road, Hilltown, Newry, BT34 5TG</dd>
            </div>
            <div>
              <dt>Links</dt>
              <dd>
                <a href={mapHref} rel="noopener noreferrer">Showroom directions ↗</a>
                {" · "}
                <a href={facebook} rel="noopener noreferrer">Facebook ↗</a>
                {" · "}
                <a href={instagram} rel="noopener noreferrer">Instagram ↗</a>
              </dd>
            </div>
          </dl>
        </div>

        <form class="mw-form" id="mw-form" data-email={email}>
          <div class="mw-row">
            <label>
              <span>Project focus</span>
              <select name="product" id="mw-product">
                <option value="Bi-fold and sliding doors">Bi-fold and sliding doors</option>
                <option value="Heritage sliding sash">Heritage sliding sash</option>
                <option value="Composite doors and sunrooms">Composite doors and sunrooms</option>
                <option value="Full house new build or upgrade">Full house new build or upgrade</option>
              </select>
            </label>
            <label>
              <span>Town or county</span>
              <input name="location" placeholder="e.g. Newry or Downpatrick" required />
            </label>
          </div>
          <div class="mw-row">
            <label>
              <span>Your name</span>
              <input name="name" autocomplete="name" required />
            </label>
            <label>
              <span>Phone number</span>
              <input name="phone" type="tel" autocomplete="tel" required />
            </label>
          </div>
          <label>
            <span>Approximate openings or notes</span>
            <textarea name="notes" rows="3" placeholder="e.g. 8 replacement windows and front composite door, or bi-fold extension"></textarea>
          </label>
          <button class="mw-btn mw-btn--steel mw-btn--full" type="submit">Open survey request email</button>
        </form>
      </div>

      <div class="mw-wrap mw-map-wrap">
        <LocalAreaMap
          id="mourne-windows-map"
          businessName="Mourne Windows"
          address="2 Newry Road, Hilltown, Newry, BT34 5TG"
          lon={-6.115}
          lat={54.198}
          spanKm={24}
          radiusKm={22}
          radiusLabel="Hilltown showroom and survey catchment"
          tone="light"
          mapHref={mapHref}
          kicker=""
          markers={[
            { name: "Newry", lon: -6.340, lat: 54.176, note: "15 mins", side: "l" },
            { name: "Banbridge", lon: -6.268, lat: 54.348, note: "20 mins", side: "l" },
            { name: "Castlewellan", lon: -5.939, lat: 54.259, note: "15 mins", side: "r" },
            { name: "Rostrevor", lon: -6.197, lat: 54.102, note: "15 mins", side: "l" },
            { name: "Downpatrick", lon: -5.716, lat: 54.328, note: "30 mins", side: "r" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="mw-footer">
    <div class="mw-wrap mw-footer-inner">
      <span><strong>Mourne Windows &amp; Doors</strong>, 2 Newry Road, Hilltown, Newry, BT34 5TG</span>
      <span>
        <a href={phoneNiHref}>{phoneNi}</a>
        {" · "}
        <a href={phoneRoiHref}>{phoneRoi}</a>
        {" · "}
        <a href={`mailto:${email}`}>{email}</a>
      </span>
    </div>
  </footer>

  <script>
    const header = document.getElementById("mw-header");
    const sentinel = document.getElementById("mw-hero-sentinel");
    if (header && sentinel) {
      const observer = new IntersectionObserver(
        (entries) => {
          const entry = entries[0];
          if (!entry) return;
          header.classList.toggle("is-scrolled", !entry.isIntersecting);
        },
        { threshold: 0 },
      );
      observer.observe(sentinel);
    }

    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-mw-tab]"));
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-mw-panel]"));

    const selectSystem = (id: string | undefined, focusTab = false) => {
      if (!id) return;
      tabs.forEach((t) => {
        const active = t.dataset.mwTab === id;
        t.classList.toggle("is-active", active);
        t.setAttribute("aria-selected", String(active));
        t.setAttribute("tabindex", active ? "0" : "-1");
        if (active && focusTab) t.focus();
      });
      panels.forEach((p) => {
        p.hidden = p.dataset.mwPanel !== id;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectSystem(tab.dataset.mwTab));
      tab.addEventListener("keydown", (event) => {
        if (event.key === "ArrowRight") {
          event.preventDefault();
          selectSystem(tabs[(index + 1) % tabs.length]?.dataset.mwTab, true);
        } else if (event.key === "ArrowLeft") {
          event.preventDefault();
          selectSystem(tabs[(index - 1 + tabs.length) % tabs.length]?.dataset.mwTab, true);
        } else if (event.key === "Home") {
          event.preventDefault();
          selectSystem(tabs[0]?.dataset.mwTab, true);
        } else if (event.key === "End") {
          event.preventDefault();
          selectSystem(tabs[tabs.length - 1]?.dataset.mwTab, true);
        }
      });
    });

    const dropWrap = document.querySelector<HTMLElement>("[data-mw-drop]");
    const dropBtn = dropWrap?.querySelector<HTMLButtonElement>(".mw-nav-drop-btn");
    const dropMenu = document.getElementById("mw-systems-menu");
    const dropImg = dropWrap?.querySelector<HTMLImageElement>("[data-mw-drop-preview-img]");
    const dropCap = dropWrap?.querySelector<HTMLElement>("[data-mw-drop-preview-cap]");
    const dropItems = dropWrap?.querySelectorAll<HTMLAnchorElement>("[data-mw-drop-item]");
    const setDrop = (open: boolean) => {
      if (!dropBtn || !dropMenu) return;
      dropBtn.setAttribute("aria-expanded", String(open));
      dropMenu.hidden = !open;
    };
    dropBtn?.addEventListener("click", () => setDrop(Boolean(dropMenu?.hidden)));
    dropItems?.forEach((item) => {
      const preview = () => {
        dropItems.forEach((i) => i.classList.toggle("is-active", i === item));
        if (dropImg && item.dataset.mwDropImg) dropImg.src = item.dataset.mwDropImg;
        if (dropCap && item.dataset.mwDropCap) dropCap.textContent = item.dataset.mwDropCap;
      };
      item.addEventListener("mouseenter", preview);
      item.addEventListener("focus", preview);
      item.addEventListener("click", () => {
        selectSystem(item.dataset.mwDropItem);
        setDrop(false);
      });
    });
    document.addEventListener("click", (e) => {
      if (dropWrap && !dropWrap.contains(e.target as Node)) setDrop(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setDrop(false);
    });

    const prodSelect = document.getElementById("mw-product") as HTMLSelectElement | null;
    document.querySelectorAll<HTMLElement>("[data-mw-pick]").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (prodSelect && btn.dataset.mwPick) {
          prodSelect.value = btn.dataset.mwPick;
          prodSelect.dispatchEvent(new Event("change", { bubbles: true }));
        }
      });
    });

    const form = document.getElementById("mw-form") as HTMLFormElement | null;
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const d = new FormData(form);
      const body = [
        `Project focus: ${d.get("product") || ""}`,
        `Location: ${d.get("location") || ""}`,
        `Name: ${d.get("name") || ""}`,
        `Phone: ${d.get("phone") || ""}`,
        "",
        String(d.get("notes") || ""),
      ].join("\n");
      const to = form.dataset.email ?? "";
      const subject = `Free home survey request: ${d.get("product")}`;
      const url = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      if (window.dispatchEvent(new CustomEvent("mm:enquiry", { cancelable: true, detail: { to, subject, body, url } }))) {
        window.location.href = url;
      }
    });
  </script>
</ConceptLayout>
