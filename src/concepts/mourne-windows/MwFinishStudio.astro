---
/* Mourne Windows & Doors: Interactive Architectural Finish & Opening Studio.
   Lets homeowners preview profile style & finish colour, set opening count,
   and load the exact specification directly into the free home survey form. */
const finishes = [
  { id: "anthracite", name: "Anthracite grey", hex: "#2f363d", sash: "#3c454e" },
  { id: "cream", name: "Heritage cream", hex: "#e7e0ce", sash: "#f1ecdf" },
  { id: "chartwell", name: "Chartwell green", hex: "#7e9583", sash: "#92a997" },
  { id: "oak", name: "Irish oak", hex: "#9b6b3e", sash: "#b07f4f" },
  { id: "white", name: "Crisp white", hex: "#f5f6f7", sash: "#ffffff" },
];

const profiles = [
  {
    id: "sash",
    label: "Heritage sliding sash",
    productValue: "Heritage sliding sash",
    note: "Balanced vertical sash with deep bottom rail and tilt-in easy clean.",
  },
  {
    id: "door",
    label: "Composite door",
    productValue: "Composite doors and sunrooms",
    note: "High-security multi-point locking core with thermally broken frame.",
  },
  {
    id: "bifold",
    label: "Aluminium bi-fold",
    productValue: "Bi-fold and sliding doors",
    note: "Slimline thermally broken aluminium folding cleanly to the garden.",
  },
];
---

<section class="mw-studio" id="finish-studio" aria-labelledby="mw-studio-title">
  <div class="mw-wrap">
    <div class="mw-studio-head">
      <h2 id="mw-studio-title">Preview frame profiles and finishes before your survey.</h2>
      <p class="mw-studio-sub">
        Compare popular profiles and colours, set your approximate opening
        count, and carry the note straight into your survey request.
      </p>
    </div>

    <div class="mw-studio-grid" data-mw-studio>
      <div class="mw-studio-stage">
        <svg class="mw-elev-svg" viewBox="0 0 520 340" role="img" aria-label="Architectural elevation preview of selected window or door profile and colour finish">
          <defs>
            <linearGradient id="mw-sky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#c9dae6" />
              <stop offset="62%" stop-color="#e5eef4" />
              <stop offset="100%" stop-color="#d2ded6" />
            </linearGradient>
            <linearGradient id="mw-glaze" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#ffffff" stop-opacity="0.34" />
              <stop offset="45%" stop-color="#ffffff" stop-opacity="0.06" />
              <stop offset="100%" stop-color="#182734" stop-opacity="0.16" />
            </linearGradient>
          </defs>

          <rect width="520" height="340" fill="#e9ecee" />
          <line x1="0" y1="296" x2="520" y2="296" stroke="#c4cbd0" stroke-width="1.5" />
          <rect x="64" y="294" width="392" height="12" fill="#d7dde1" stroke="#b3bcc2" stroke-width="1" />

          <g data-mw-elev="sash">
            <rect x="130" y="34" width="260" height="260" fill="url(#mw-sky)" />
            <rect x="130" y="34" width="260" height="260" fill="none" stroke="var(--mw-frame, #2f363d)" stroke-width="18" />
            <rect x="144" y="48" width="232" height="114" fill="url(#mw-glaze)" stroke="var(--mw-sash, #3c454e)" stroke-width="8" />
            <line x1="260" y1="48" x2="260" y2="162" stroke="var(--mw-sash, #3c454e)" stroke-width="4" />
            <rect x="140" y="158" width="240" height="10" fill="var(--mw-frame, #2f363d)" />
            <rect x="144" y="168" width="232" height="112" fill="url(#mw-glaze)" stroke="var(--mw-sash, #3c454e)" stroke-width="8" />
            <line x1="260" y1="168" x2="260" y2="280" stroke="var(--mw-sash, #3c454e)" stroke-width="4" />
            <rect x="192" y="160" width="16" height="4" rx="1" fill="#c6a25c" />
            <rect x="312" y="160" width="16" height="4" rx="1" fill="#c6a25c" />
          </g>

          <g data-mw-elev="door" style="display: none">
            <rect x="176" y="32" width="168" height="262" fill="#ffffff" />
            <rect x="176" y="32" width="168" height="262" fill="var(--mw-frame, #2f363d)" />
            <rect x="188" y="44" width="144" height="246" fill="var(--mw-sash, #3c454e)" stroke="rgba(0,0,0,0.16)" stroke-width="1.5" />
            <rect x="210" y="66" width="100" height="72" fill="url(#mw-sky)" stroke="var(--mw-frame, #2f363d)" stroke-width="5" />
            <rect x="210" y="66" width="100" height="72" fill="url(#mw-glaze)" />
            <line x1="260" y1="66" x2="260" y2="138" stroke="var(--mw-frame, #2f363d)" stroke-width="3" />
            <rect x="210" y="162" width="44" height="96" fill="none" stroke="rgba(0,0,0,0.22)" stroke-width="2" />
            <rect x="266" y="162" width="44" height="96" fill="none" stroke="rgba(0,0,0,0.22)" stroke-width="2" />
            <rect x="310" y="168" width="6" height="34" rx="2" fill="#d8dde2" />
            <rect x="236" y="148" width="48" height="7" rx="1.5" fill="#d8dde2" />
          </g>

          <g data-mw-elev="bifold" style="display: none">
            <rect x="74" y="46" width="372" height="248" fill="url(#mw-sky)" />
            <rect x="74" y="46" width="372" height="248" fill="none" stroke="var(--mw-frame, #2f363d)" stroke-width="12" />
            <rect x="84" y="56" width="114" height="228" fill="url(#mw-glaze)" stroke="var(--mw-sash, #3c454e)" stroke-width="6" />
            <rect x="203" y="56" width="114" height="228" fill="url(#mw-glaze)" stroke="var(--mw-sash, #3c454e)" stroke-width="6" />
            <rect x="322" y="56" width="114" height="228" fill="url(#mw-glaze)" stroke="var(--mw-sash, #3c454e)" stroke-width="6" />
            <path d="M168 170l-16 0m6 -6l-6 6 6 6" stroke="#ffffff" stroke-width="1.6" fill="none" opacity="0.7" />
            <path d="M352 170l16 0m-6 -6l6 6 -6 6" stroke="#ffffff" stroke-width="1.6" fill="none" opacity="0.7" />
            <rect x="316" y="160" width="4" height="26" rx="1" fill="#d8dde2" />
          </g>

          <g stroke="#6c7782" stroke-width="1" font-size="11" fill="#4b5661" font-family="Inter, sans-serif">
            <line x1="74" y1="320" x2="446" y2="320" />
            <line x1="74" y1="315" x2="74" y2="325" />
            <line x1="446" y1="315" x2="446" y2="325" />
            <text x="260" y="335" text-anchor="middle" data-mw-dim>Made-to-measure elevation, surveyed from Hilltown</text>
          </g>
        </svg>

        <div class="mw-stage-bar">
          <strong data-mw-active-label>Heritage sliding sash, Anthracite grey</strong>
          <span data-mw-active-note>Balanced vertical sash with deep bottom rail and tilt-in easy clean.</span>
        </div>
      </div>

      <div class="mw-studio-controls">
        <fieldset class="mw-ctrl-group">
          <legend class="mw-ctrl-label">Profile style</legend>
          <div class="mw-seg-track">
            {profiles.map((p, i) => (
              <label class="mw-seg-option">
                <input
                  type="radio"
                  name="mw-profile"
                  value={p.id}
                  checked={i === 0}
                  data-mw-prof={p.id}
                  data-mw-prof-label={p.label}
                  data-mw-prof-product={p.productValue}
                  data-mw-prof-note={p.note}
                />
                <span>{p.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="mw-ctrl-group">
          <legend class="mw-ctrl-label">Frame colour finish</legend>
          <div class="mw-swatch-row">
            {finishes.map((f, i) => (
              <label class="mw-fin-option">
                <input
                  type="radio"
                  name="mw-finish"
                  value={f.id}
                  checked={i === 0}
                  data-mw-fin={f.name}
                  data-mw-hex={f.hex}
                  data-mw-sash={f.sash}
                />
                <span class="mw-fin-ui">
                  <span class="mw-fin-dot" style={`background:${f.hex}`} aria-hidden="true"></span>
                  <span>{f.name}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="mw-ctrl-group">
          <span class="mw-ctrl-label">Approximate openings</span>
          <div class="mw-openings-bar">
            <button type="button" class="mw-count-btn" data-mw-step="-1" aria-label="Decrease openings">−</button>
            <span class="mw-count-val" data-mw-count>6 openings</span>
            <button type="button" class="mw-count-btn" data-mw-step="1" aria-label="Increase openings">+</button>
          </div>
        </div>

        <button type="button" class="mw-btn mw-btn--steel mw-btn--full" data-mw-apply>
          Load this spec into my free survey
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .mw-studio {
    padding: 88px 0;
    background: var(--mw-stone);
  }

  .mw-studio-head {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: 24px 48px;
    align-items: end;
    margin-bottom: 36px;
  }

  .mw-studio-head h2 {
    margin: 0;
    font-family: var(--mw-display);
    font-size: var(--text-heading);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--mw-anthracite);
  }

  .mw-studio-sub {
    margin: 0;
    font-size: var(--text-body);
    color: var(--mw-muted);
  }

  .mw-studio-grid {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    border: 1px solid var(--mw-line);
    background: var(--mw-white);
  }

  .mw-studio-stage {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--mw-line);
  }

  .mw-elev-svg {
    display: block;
    width: 100%;
    height: auto;
    flex: 1;
  }

  .mw-stage-bar {
    padding: 16px 22px;
    border-top: 1px solid var(--mw-line);
    background: var(--mw-white);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mw-stage-bar strong {
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--mw-anthracite);
  }

  .mw-stage-bar span {
    font-size: var(--text-sm);
    color: var(--mw-muted);
  }

  .mw-studio-controls {
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
  }

  .mw-ctrl-group {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mw-ctrl-label {
    padding: 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--mw-ink);
  }

  .mw-seg-track {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid rgba(19, 26, 33, 0.24);
    background: var(--mw-stone);
  }

  .mw-seg-option {
    position: relative;
    cursor: pointer;
    border-right: 1px solid rgba(19, 26, 33, 0.16);
  }

  .mw-seg-option:last-child {
    border-right: 0;
  }

  .mw-seg-option input,
  .mw-fin-option input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .mw-seg-option span {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 44px;
    padding: 8px 10px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--mw-ink);
    transition: background-color 160ms cubic-bezier(0.22, 1, 0.36, 1),
      color 160ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mw-seg-option input:checked + span {
    background: var(--mw-anthracite);
    color: #ffffff;
  }

  .mw-seg-option input:focus-visible + span,
  .mw-fin-option input:focus-visible + .mw-fin-ui {
    outline: 3px solid var(--mw-steel);
    outline-offset: -3px;
  }

  .mw-swatch-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .mw-fin-option {
    position: relative;
    cursor: pointer;
  }

  .mw-fin-ui {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid rgba(19, 26, 33, 0.22);
    background: #ffffff;
    color: var(--mw-ink);
    font-size: var(--text-sm);
    font-weight: 500;
    transition: background-color 160ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 160ms cubic-bezier(0.22, 1, 0.36, 1),
      color 160ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mw-fin-option input:checked + .mw-fin-ui {
    background: var(--mw-anthracite);
    border-color: var(--mw-anthracite);
    color: #ffffff;
  }

  .mw-fin-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.26);
    flex: none;
  }

  .mw-openings-bar {
    display: grid;
    grid-template-columns: 44px 1fr 44px;
    border: 1px solid rgba(19, 26, 33, 0.24);
    height: 44px;
  }

  .mw-count-btn {
    border: 0;
    background: transparent;
    color: var(--mw-ink);
    font-size: var(--text-body);
    font-weight: 600;
    cursor: pointer;
    transition: background-color 140ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mw-count-btn:hover {
    background: rgba(19, 26, 33, 0.06);
  }

  .mw-count-val {
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: var(--text-body);
    font-variant-numeric: tabular-nums;
    border-left: 1px solid var(--mw-line);
    border-right: 1px solid var(--mw-line);
  }

  @media (max-width: 960px) {
    .mw-studio-head,
    .mw-studio-grid {
      grid-template-columns: 1fr;
    }
    .mw-studio-stage {
      border-right: 0;
      border-bottom: 1px solid var(--mw-line);
    }
  }

  @media (max-width: 600px) {
    .mw-studio-controls {
      padding: 24px 20px;
    }
    .mw-seg-track {
      grid-template-columns: 1fr;
    }
    .mw-seg-option {
      border-right: 0;
      border-bottom: 1px solid rgba(19, 26, 33, 0.16);
    }
    .mw-seg-option:last-child {
      border-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mw-seg-option span,
    .mw-fin-ui,
    .mw-count-btn {
      transition: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-mw-studio]");
  if (root) {
    const state = {
      profile: "sash",
      profileLabel: "Heritage sliding sash",
      productValue: "Heritage sliding sash",
      profileNote: "Balanced vertical sash with deep bottom rail and tilt-in easy clean.",
      finish: "Anthracite grey",
      hex: "#2f363d",
      sash: "#3c454e",
      openings: 6,
    };

    const svg = root.querySelector<SVGElement>(".mw-elev-svg");
    const activeLabel = root.querySelector<HTMLElement>("[data-mw-active-label]");
    const activeNote = root.querySelector<HTMLElement>("[data-mw-active-note]");
    const countEl = root.querySelector<HTMLElement>("[data-mw-count]");

    const sync = () => {
      if (svg) {
        svg.style.setProperty("--mw-frame", state.hex);
        svg.style.setProperty("--mw-sash", state.sash);
        svg.querySelectorAll<SVGGElement>("[data-mw-elev]").forEach((g) => {
          g.style.display = g.dataset.mwElev === state.profile ? "" : "none";
        });
      }
      if (activeLabel) activeLabel.textContent = `${state.profileLabel}, ${state.finish}`;
      if (activeNote) activeNote.textContent = state.profileNote;
      if (countEl) countEl.textContent = `${state.openings} ${state.openings === 1 ? "opening" : "openings"}`;
    };

    root.querySelectorAll<HTMLInputElement>("[data-mw-prof]").forEach((input) => {
      input.addEventListener("change", () => {
        if (!input.checked) return;
        state.profile = input.dataset.mwProf || "sash";
        state.profileLabel = input.dataset.mwProfLabel || "";
        state.productValue = input.dataset.mwProfProduct || "Heritage sliding sash";
        state.profileNote = input.dataset.mwProfNote || "";
        sync();
      });
    });

    root.querySelectorAll<HTMLInputElement>("[data-mw-fin]").forEach((input) => {
      input.addEventListener("change", () => {
        if (!input.checked) return;
        state.finish = input.dataset.mwFin || "Anthracite grey";
        state.hex = input.dataset.mwHex || "#2f363d";
        state.sash = input.dataset.mwSash || "#3c454e";
        sync();
      });
    });

    root.querySelectorAll<HTMLButtonElement>("[data-mw-step]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const delta = Number(btn.dataset.mwStep || 0);
        state.openings = Math.max(1, Math.min(20, state.openings + delta));
        sync();
      });
    });

    root.querySelector<HTMLButtonElement>("[data-mw-apply]")?.addEventListener("click", () => {
      const productSelect = document.getElementById("mw-product") as HTMLSelectElement | null;
      const notesField = document.querySelector<HTMLTextAreaElement>('#mw-form textarea[name="notes"]');
      if (productSelect) {
        productSelect.value = state.productValue;
        productSelect.dispatchEvent(new Event("change", { bubbles: true }));
      }
      if (notesField) {
        notesField.value = `${state.openings} ${state.openings === 1 ? "opening" : "openings"}: ${state.profileLabel} in ${state.finish}.`;
      }
      document.getElementById("survey")?.scrollIntoView({ behavior: "smooth" });
    });

    sync();
  }
</script>
