---
/* Chestnutt Holiday Parks — Interactive Four Mourne Coast Parks Stage.
   Compares Cranfield, Annalong, Loughside, and Sandilands, synced with the header dropdown. */
interface Props {
  bookingHref: string;
}
const { bookingHref } = Astro.props;

const parks = [
  {
    id: "cranfield",
    label: "Cranfield",
    fullName: "Chestnutt, Cranfield Beach",
    summary: "Steps from Blue Flag Cranfield Beach with the Mourne Mountains rising behind.",
    stayStyle: "Hire, touring, camping, and static ownership",
    setting: "Direct footpath to the Cranfield West shoreline and Carlingford Lough",
    details: "Static caravan hire, touring stances, tent pitches, ownership plots, and Cranfield Sands Cottage",
    ctaLabel: "Book holiday dates online ↗",
    ctaHref: bookingHref,
    external: true,
  },
  {
    id: "annalong",
    label: "Annalong",
    fullName: "Annalong Holiday Park",
    summary: "Quiet Mourne coast village park beside Annalong harbour and corn mill.",
    stayStyle: "Hire, touring, and static ownership",
    setting: "Overlooking the Irish Sea, minutes from Carrick Little and Silent Valley walks",
    details: "Static holiday home hire, touring stances, and peaceful coastal ownership pitches",
    ctaLabel: "Book holiday dates online ↗",
    ctaHref: bookingHref,
    external: true,
  },
  {
    id: "loughside",
    label: "Loughside",
    fullName: "Loughside Holiday Park, Kilkeel",
    summary: "Peaceful owners-only retreat along Carlingford Lough near Kilkeel.",
    stayStyle: "Static holiday home ownership only",
    setting: "Sheltered loughside aspect looking toward the Cooley Peninsula, close to Kilkeel Harbour",
    details: "Dedicated holiday home ownership community with private park viewings by appointment",
    ctaLabel: "Enquire about ownership",
    ctaHref: "#ownership",
    external: false,
  },
  {
    id: "sandilands",
    label: "Sandilands",
    fullName: "Sandilands Holiday Park",
    summary: "Open coastal skies for tourers, family tents, and holiday home owners near Cranfield.",
    stayStyle: "Touring, camping, and static ownership",
    setting: "Mourne coast location within easy reach of Cranfield Point and Kilkeel",
    details: "Touring caravan and motorhome stances, family camping pitches, and ownership plots",
    ctaLabel: "Book holiday dates online ↗",
    ctaHref: bookingHref,
    external: true,
  },
];
---

<section class="chp-section chp-parks" id="parks" aria-labelledby="chp-finder-title">
  <div class="chp-wrap">
    <div class="chp-parks-head">
      <h2 id="chp-finder-title">Compare our four Mourne coast parks.</h2>
      <p class="chp-parks-intro">
        Choose a shoreline to compare stay formats, coastal setting, and direct booking or ownership options.
      </p>
    </div>

    <div class="chp-parks-stage" data-chp-finder>
      <div class="chp-parks-body">
        <div class="chp-tabs" role="tablist" aria-label="Compare our four parks">
          {parks.map((p, idx) => (
            <button
              type="button"
              role="tab"
              id={`chp-tab-${p.id}`}
              aria-selected={idx === 0 ? "true" : "false"}
              aria-controls={`chp-panel-${p.id}`}
              class:list={["chp-tab", idx === 0 && "is-active"]}
              data-chp-tab={p.id}
            >
              {p.label}
            </button>
          ))}
        </div>

        {parks.map((p, idx) => (
          <div
            class="chp-panel"
            role="tabpanel"
            id={`chp-panel-${p.id}`}
            aria-labelledby={`chp-tab-${p.id}`}
            data-chp-panel={p.id}
            hidden={idx !== 0}
          >
            <h3 class="chp-panel-title">{p.fullName}</h3>
            <p class="chp-panel-summary">{p.summary}</p>
            <dl class="chp-ledger chp-ledger--dark">
              <div class="chp-ledger-row">
                <dt>Ways to stay</dt>
                <dd>{p.stayStyle}</dd>
              </div>
              <div class="chp-ledger-row">
                <dt>Coastal setting</dt>
                <dd>{p.setting}</dd>
              </div>
              <div class="chp-ledger-row">
                <dt>On site</dt>
                <dd>{p.details}</dd>
              </div>
            </dl>
            <div class="chp-panel-foot">
              <a
                class="chp-btn chp-btn--light"
                href={p.ctaHref}
                target={p.external ? "_blank" : undefined}
                rel={p.external ? "noopener noreferrer" : undefined}
              >
                {p.ctaLabel}
              </a>
            </div>
          </div>
        ))}
      </div>

      <figure class="chp-plate">
        <picture>
          <source
            srcset="/media/concepts/chestnutt-holiday-parks/chestnutt-lodge-deck-640.webp 640w, /media/concepts/chestnutt-holiday-parks/chestnutt-lodge-deck-1265.webp 1265w"
            sizes="(max-width: 900px) 100vw, 46vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/chestnutt-holiday-parks/chestnutt-lodge-deck.jpg"
            alt="Sunlit cedar coastal lodge timber deck with woven armchairs looking out across Carlingford Lough"
            width="1408"
            height="768"
            loading="lazy"
          />
        </picture>
        <figcaption>Coastal lodge deck overlooking Carlingford Lough. Indicative visualisation.</figcaption>
      </figure>
    </div>
  </div>
</section>
