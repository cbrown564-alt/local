---
/* DigiTech Repairs: Component-Level Fault Triage and Route Picker.
   Matches equipment and symptom to workshop drop-off or local van collection
   and pre-fills the repair intake form cleanly. */
const categories = [
  {
    id: "tv",
    name: "Television / OLED",
    equipment: "Television",
    route: "Drop off at Ballykinlar workshop (BT30 8DD)",
    routeValue: "Drop off at Ballykinlar workshop",
    symptoms: [
      "Sound plays fine but screen goes dark or dim",
      "Standby light flashes and TV will not power on",
      "HDMI port loose or intermittent signal",
      "Vertical lines or power-board click",
    ],
  },
  {
    id: "washer",
    name: "Washer / tumble dryer",
    equipment: "Washing Machine / Tumble Dryer",
    route: "Arrange collection across BT30, BT33, BT31, or BT24",
    routeValue: "Arrange collection (BT30/BT33/BT31/BT24)",
    symptoms: [
      "Drum will not spin or stops mid-cycle",
      "Water not draining or filter error code",
      "Dryer tumbles but produces no heat",
      "Door interlock jammed after wash",
    ],
  },
  {
    id: "cooker",
    name: "Electric cooker / oven",
    equipment: "Electric Cooker / Oven / Hob",
    route: "Arrange collection across BT30, BT33, BT31, or BT24",
    routeValue: "Arrange collection (BT30/BT33/BT31/BT24)",
    symptoms: [
      "Fan runs but main oven stays cold",
      "Trips main fuseboard when switched on",
      "Ceramic or induction hob zone dead",
      "Grill element not heating evenly",
    ],
  },
  {
    id: "audio",
    name: "Audio hi-fi / DJ gear",
    equipment: "Audio Hi-Fi / DJ Equipment",
    route: "Drop off at Ballykinlar workshop (BT30 8DD)",
    routeValue: "Drop off at Ballykinlar workshop",
    symptoms: [
      "Amplifier channel crackling or silent",
      "Turntable speed drift or motor fault",
      "DJ mixer fader or jack board repair",
      "Vintage receiver recap and bench service",
    ],
  },
];
---

<section class="dt-section dt-triage" id="triage" aria-labelledby="dt-triage-title">
  <div class="dt-wrap" data-dt-triage>
    <div class="dt-triage-head">
      <div>
        <h2 id="dt-triage-title">Pinpoint the fault before you bring it in.</h2>
        <p class="dt-triage-intro">
          Select your equipment and closest symptom to see whether we recommend bench drop-off in Ballykinlar or local collection, then load it directly into the repair form.
        </p>
      </div>
      <div class="dt-route-readout">
        <span class="dt-route-label">Recommended route</span>
        <strong data-dt-route-out>{categories[0].route}</strong>
      </div>
    </div>

    <div class="dt-seg" role="tablist" aria-label="Equipment category">
      {categories.map((cat, idx) => (
        <button
          type="button"
          role="tab"
          id={`dt-triage-tab-${cat.id}`}
          aria-selected={idx === 0 ? "true" : "false"}
          aria-controls={`dt-triage-panel-${cat.id}`}
          tabindex={idx === 0 ? "0" : "-1"}
          class:list={["dt-seg-item", { "is-active": idx === 0 }]}
          data-dt-cat={cat.id}
          data-dt-eq={cat.equipment}
          data-dt-route={cat.route}
          data-dt-route-val={cat.routeValue}
        >
          {cat.name}
        </button>
      ))}
    </div>

    {categories.map((cat, idx) => (
      <div
        id={`dt-triage-panel-${cat.id}`}
        role="tabpanel"
        aria-labelledby={`dt-triage-tab-${cat.id}`}
        class:list={["dt-triage-panel", { "is-active": idx === 0 }]}
        data-dt-triage-panel={cat.id}
        hidden={idx !== 0}
      >
        <div class="dt-symptom-list" role="radiogroup" aria-label={`${cat.name} symptoms`}>
          {cat.symptoms.map((sym, sIdx) => (
            <button
              type="button"
              role="radio"
              aria-checked={sIdx === 0 ? "true" : "false"}
              class:list={["dt-symptom-row", { "is-selected": sIdx === 0 }]}
              data-dt-sym={sym}
            >
              <span class="dt-radio-mark" aria-hidden="true"></span>
              <span>{sym}</span>
            </button>
          ))}
        </div>
      </div>
    ))}

    <div class="dt-triage-foot">
      <p>Bench diagnostics open Monday to Friday until 8:00pm and Saturday until 3:00pm.</p>
      <button type="button" class="dt-btn dt-btn--teal" data-dt-load-ticket>
        Load into repair ticket
      </button>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-dt-triage]");
    if (!root) return;

    const tabs = Array.from(root.querySelectorAll("[data-dt-cat]"));
    const panels = Array.from(root.querySelectorAll("[data-dt-triage-panel]"));
    const routeOut = root.querySelector("[data-dt-route-out]");

    let activeEq = tabs[0]?.getAttribute("data-dt-eq") || "Television";
    let activeRouteVal = tabs[0]?.getAttribute("data-dt-route-val") || "Drop off at Ballykinlar workshop";
    let activeSym =
      root.querySelector(".dt-symptom-row.is-selected")?.getAttribute("data-dt-sym") ||
      "Sound plays fine but screen goes dark or dim";

    const activateCategory = (id, moveFocus = false) => {
      tabs.forEach((tab) => {
        const active = tab.getAttribute("data-dt-cat") === id;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-selected", active ? "true" : "false");
        tab.setAttribute("tabindex", active ? "0" : "-1");
        if (active) {
          activeEq = tab.getAttribute("data-dt-eq") || activeEq;
          activeRouteVal = tab.getAttribute("data-dt-route-val") || activeRouteVal;
          if (routeOut) routeOut.textContent = tab.getAttribute("data-dt-route") || "";
          if (moveFocus && tab instanceof HTMLElement) tab.focus();
        }
      });

      panels.forEach((panel) => {
        const active = panel.getAttribute("data-dt-triage-panel") === id;
        panel.classList.toggle("is-active", active);
        panel.hidden = !active;
        if (active) {
          const sel = panel.querySelector(".dt-symptom-row.is-selected") || panel.querySelector(".dt-symptom-row");
          if (sel) activeSym = sel.getAttribute("data-dt-sym") || "";
        }
      });
    };

    tabs.forEach((tab, idx) => {
      tab.addEventListener("click", () => {
        const id = tab.getAttribute("data-dt-cat");
        if (id) activateCategory(id);
      });
      tab.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft" && e.key !== "Home" && e.key !== "End") return;
        e.preventDefault();
        let next = idx;
        if (e.key === "ArrowRight") next = (idx + 1) % tabs.length;
        if (e.key === "ArrowLeft") next = (idx - 1 + tabs.length) % tabs.length;
        if (e.key === "Home") next = 0;
        if (e.key === "End") next = tabs.length - 1;
        const nextId = tabs[next]?.getAttribute("data-dt-cat");
        if (nextId) activateCategory(nextId, true);
      });
    });

    root.querySelectorAll("[data-dt-sym]").forEach((row) => {
      row.addEventListener("click", () => {
        const panel = row.closest("[data-dt-triage-panel]");
        panel?.querySelectorAll("[data-dt-sym]").forEach((item) => {
          const on = item === row;
          item.classList.toggle("is-selected", on);
          item.setAttribute("aria-checked", on ? "true" : "false");
        });
        activeSym = row.getAttribute("data-dt-sym") || "";
      });
    });

    root.querySelector("[data-dt-load-ticket]")?.addEventListener("click", () => {
      const eqSel = document.querySelector('#dt-form select[name="equipment"]');
      const svcSel = document.querySelector('#dt-form select[name="service"]');
      const faultField = document.querySelector('#dt-form textarea[name="fault"]');
      if (eqSel instanceof HTMLSelectElement) {
        eqSel.value = activeEq;
        eqSel.dispatchEvent(new Event("change", { bubbles: true }));
      }
      if (svcSel instanceof HTMLSelectElement && activeRouteVal) {
        svcSel.value = activeRouteVal;
        svcSel.dispatchEvent(new Event("change", { bubbles: true }));
      }
      if (faultField instanceof HTMLTextAreaElement) {
        faultField.value = activeSym;
      }
      document.getElementById("ticket")?.scrollIntoView({ behavior: "smooth" });
    });
  })();
</script>
