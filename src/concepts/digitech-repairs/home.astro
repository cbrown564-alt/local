---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import DtFaultTriage from "./DtFaultTriage.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";

/* DigiTech Repairs: 8 Carrickinab Road, Ballykinlar, Downpatrick, BT30 8DD.
   Sources (live-fetched 26 Nov 2026): digitech-repairs.co.uk (/, /about/, /contact/).
   - Family-run since 2000; component-level fault finding to extend appliance life.
   - Member of a European-wide network of 1,000+ service engineers across 30+ countries.
   - Repairs: Televisions, Washing Machines, Tumble Dryers, Electric Cookers & Ovens,
     Microwave Ovens, Electric Hobs, Audio Hi-Fi, Dishwashers, DJ Equipment, Satellite.
   - Postcodes covered: BT30, BT33, BT31 & BT24 (Downpatrick, Dundrum, Newcastle,
     Killyleagh, Castlewellan, Ardglass, Ballynahinch, Drumaness, Clough, Ballykinlar,
     Tyrella, Loughinisland, Kilcoo, Crossgar, Saintfield, Killough, Strangford).
     Collection available or customer drop-off at Ballykinlar workshop.
   - Hours: Mon to Fri 9:00am to 8:00pm, Sat 9:00am to 3:00pm.
   - Phone: 07887 501827 · Email: digitech.repairs@btinternet.com. */

const phone = "07887 501827";
const phoneHref = "tel:+447887501827";
const email = "digitech.repairs@btinternet.com";
const facebook = "https://www.facebook.com/digitechrepairs";
const mapHref =
  "https://www.google.com/maps/search/?api=1&query=8+Carrickinab+Road+Ballykinlar+Downpatrick+BT30+8DD";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap";

const tvItems = [
  { name: "Televisions", detail: "Power-board faults, dim or dark backlights, standby loops, and HDMI input repair." },
  { name: "Satellite receivers", detail: "Signal and power-stage diagnostics tested on the Ballykinlar bench." },
  { name: "Typical route", detail: "Workshop drop-off at 8 Carrickinab Road or local collection by arrangement." },
];

const kitchenItems = [
  { name: "Washing machines and tumble dryers", detail: "Spin, drain, heating, and door interlock faults repaired at component level." },
  { name: "Electric cookers, ovens, and hobs", detail: "Oven heating elements, fans, thermostats, and electric hob zones." },
  { name: "Dishwashers and microwave ovens", detail: "Pump, heating, control-board, and power faults across major domestic makes." },
];

const hifiItems = [
  { name: "Audio hi-fi and amplifiers", detail: "Channel drop-outs, noise, power-stage faults, and classic amplifier bench servicing." },
  { name: "DJ equipment", detail: "Mixers, turntables, faders, input jacks, and power-supply repairs." },
  { name: "Specialist electronics", detail: "Backed by direct parts suppliers and a network of 1,000+ European service engineers." },
];

const brands = [
  "AEG", "Beko", "Blomberg", "Bose", "Bosch", "Candy", "Dyson", "Hitachi",
  "Hoover", "Hotpoint", "Indesit", "JVC", "LG", "Miele", "Neff", "Panasonic",
  "Philips", "Samsung", "Sanyo",
];

const coverageZones = [
  {
    code: "BT30",
    towns: "Downpatrick, Ballykinlar, Ardglass, Killough, Strangford, Tyrella, Killyleagh, Crossgar, Clough, Loughinisland",
  },
  {
    code: "BT33",
    towns: "Newcastle, Dundrum",
  },
  {
    code: "BT31",
    towns: "Castlewellan, Kilcoo",
  },
  {
    code: "BT24",
    towns: "Ballynahinch, Drumaness, Saintfield",
  },
];
---

<ConceptLayout
  title="DigiTech Repairs: TV, Appliance and Audio Workshop, Downpatrick BT30"
  slug="digitech-repairs"
  bodyClass="concept-page concept-digitech"
  lang="en-GB"
  businessName="DigiTech Repairs"
  town="Downpatrick / Ballykinlar"
  fontHref={fontHref}
  bannerNote="The repair workbench and classic hi-fi amplifier studies are indicative visualisations. Repair tickets compose an email directly to digitech.repairs@btinternet.com or call 07887 501827."
>
  <header class="dt-header" data-dt-header>
    <div class="dt-header-inner">
      <a class="dt-brand" href="#top">DigiTech Repairs</a>
      <nav class="dt-nav" aria-label="Primary">
        <a href="#bench">What we repair</a>
        <a href="#triage">Fault triage</a>
        <a href="#ticket">Log a repair</a>
        <a href="#coverage">Coverage area</a>
      </nav>
      <div class="dt-header-actions">
        <a class="dt-header-tel" href={phoneHref}>{phone}</a>
      </div>
    </div>
  </header>

  <main id="top" class="dt-main">
    <section class="dt-hero" aria-labelledby="dt-hero-title">
      <div class="dt-hero-sentinel" data-dt-sentinel aria-hidden="true"></div>

      <div class="dt-hero-media">
        <ResponsiveImage
          src="/media/concepts/digitech-repairs/digitech-repairs-workbench.jpg"
          alt="Electronics repair workbench with circuit board under warm task lamp, soldering iron and bench oscilloscope"
          width={1376}
          height={768}
          loading="eager"
          sizes="100vw"
          class="dt-hero-img"
        />
      </div>

      <div class="dt-hero-scrim" aria-hidden="true"></div>

      <div class="dt-wrap dt-hero-content">
        <div class="dt-hero-copy">
          <h1 id="dt-hero-title">Component-level repair for TVs, appliances, and hi-fi.</h1>
          <p class="dt-hero-sub">
            Family-run Ballykinlar workshop since 2000, open until 8pm weekdays for local collection or direct bench drop-off.
          </p>
          <a class="dt-btn dt-btn--teal" href="#ticket">Log a repair</a>
        </div>

        <div class="dt-hero-foot">
          <p class="dt-hero-meta">Mon to Fri 9:00am to 8:00pm · Sat 9:00am to 3:00pm · Ballykinlar BT30 8DD</p>
          <p class="dt-hero-caption">Indicative component-level electronics workbench visualisation.</p>
        </div>
      </div>
    </section>

    <section class="dt-section dt-bench" id="bench" aria-labelledby="dt-bench-title">
      <div class="dt-wrap">
        <div class="dt-section-head">
          <h2 id="dt-bench-title">Extending appliance life from domestic kitchens to vintage hi-fi.</h2>
          <p class="dt-section-copy">
            Family-run since 2000 and connected to a European-wide network of over 1,000 service engineers across 30+ countries, rescuing equipment many shops write off.
          </p>
        </div>

        <div class="dt-bench-grid">
          <div class="dt-bench-explore">
            <div class="dt-tabs" role="tablist" aria-label="What we repair">
              <button
                type="button"
                role="tab"
                id="dt-tab-tv"
                aria-selected="true"
                aria-controls="dt-panel-tv"
                tabindex="0"
                class="dt-tab is-active"
                data-dt-tab="tv"
              >
                TVs and screens
              </button>
              <button
                type="button"
                role="tab"
                id="dt-tab-kitchen"
                aria-selected="false"
                aria-controls="dt-panel-kitchen"
                tabindex="-1"
                class="dt-tab"
                data-dt-tab="kitchen"
              >
                Kitchen appliances
              </button>
              <button
                type="button"
                role="tab"
                id="dt-tab-hifi"
                aria-selected="false"
                aria-controls="dt-panel-hifi"
                tabindex="-1"
                class="dt-tab"
                data-dt-tab="hifi"
              >
                Hi-fi and DJ kit
              </button>
            </div>

            <article
              id="dt-panel-tv"
              role="tabpanel"
              aria-labelledby="dt-tab-tv"
              class="dt-panel is-active"
              data-dt-panel="tv"
            >
              <dl class="dt-ledger">
                {tvItems.map((item) => (
                  <div class="dt-ledger-row">
                    <dt>{item.name}</dt>
                    <dd>{item.detail}</dd>
                  </div>
                ))}
              </dl>
              <div class="dt-panel-links">
                <a class="dt-text-link" href="#ticket" data-dt-select-eq="Television">
                  Log a TV or satellite repair
                </a>
              </div>
            </article>

            <article
              id="dt-panel-kitchen"
              role="tabpanel"
              aria-labelledby="dt-tab-kitchen"
              class="dt-panel"
              data-dt-panel="kitchen"
              hidden
            >
              <dl class="dt-ledger">
                {kitchenItems.map((item) => (
                  <div class="dt-ledger-row">
                    <dt>{item.name}</dt>
                    <dd>{item.detail}</dd>
                  </div>
                ))}
              </dl>
              <div class="dt-panel-links">
                <a class="dt-text-link" href="#ticket" data-dt-select-eq="Washing Machine / Tumble Dryer">
                  Log a domestic appliance repair
                </a>
              </div>
            </article>

            <article
              id="dt-panel-hifi"
              role="tabpanel"
              aria-labelledby="dt-tab-hifi"
              class="dt-panel"
              data-dt-panel="hifi"
              hidden
            >
              <dl class="dt-ledger">
                {hifiItems.map((item) => (
                  <div class="dt-ledger-row">
                    <dt>{item.name}</dt>
                    <dd>{item.detail}</dd>
                  </div>
                ))}
              </dl>
              <div class="dt-panel-links">
                <a class="dt-text-link" href="#ticket" data-dt-select-eq="Audio Hi-Fi / DJ Equipment">
                  Log a hi-fi or DJ equipment repair
                </a>
              </div>
            </article>
          </div>

          <figure class="dt-plate">
            <ResponsiveImage
              src="/media/concepts/digitech-repairs/digitech-repairs-hifi-detail.jpg"
              alt="Brushed aluminium stereo amplifier knobs and amber meter beside brass multimeter probes on a dark workshop bench"
              width={1200}
              height={896}
              sizes="(max-width: 960px) 100vw, 44vw"
              class="dt-plate-img"
            />
            <figcaption>Indicative audio hi-fi and precision testing bench visualisation.</figcaption>
          </figure>
        </div>

        <div class="dt-brands-strip">
          <span class="dt-brands-label">Makes regularly repaired</span>
          <p class="dt-brands-list">{brands.join(", ")}, and more.</p>
        </div>
      </div>
    </section>

    <DtFaultTriage />

    <section class="dt-section dt-ticket" id="ticket" aria-labelledby="dt-ticket-title">
      <div class="dt-wrap dt-ticket-grid">
        <div class="dt-ticket-info">
          <h2 id="dt-ticket-title">Log your make, model, and fault.</h2>
          <p>
            Fill out the intake sheet to prepare a clean job brief for{" "}
            <a href={`mailto:${email}`}>{email}</a>, or call{" "}
            <a href={phoneHref}>{phone}</a>. Having the make and model number ready speeds up parts lookup.
          </p>

          <dl class="dt-info-ledger">
            <div class="dt-info-row">
              <dt>Hours</dt>
              <dd class="dt-mono-val">Mon to Fri 9:00am to 8:00pm · Sat 9:00am to 3:00pm</dd>
            </div>
            <div class="dt-info-row">
              <dt>Telephone</dt>
              <dd class="dt-mono-val">
                <a href={phoneHref}>{phone}</a>
              </dd>
            </div>
            <div class="dt-info-row">
              <dt>Email</dt>
              <dd>
                <a href={`mailto:${email}`}>{email}</a>
              </dd>
            </div>
            <div class="dt-info-row">
              <dt>Engineer network</dt>
              <dd>1,000+ European service engineers across 30+ countries</dd>
            </div>
          </dl>
        </div>

        <form class="dt-form" id="dt-form" data-email={email}>
          <div class="dt-form-row">
            <label>
              <span>Equipment type</span>
              <select name="equipment">
                <option value="Television">Television</option>
                <option value="Washing Machine / Tumble Dryer">Washing machine / tumble dryer</option>
                <option value="Electric Cooker / Oven / Hob">Electric cooker / oven / hob</option>
                <option value="Dishwasher / Microwave">Dishwasher / microwave</option>
                <option value="Audio Hi-Fi / DJ Equipment">Audio hi-fi / DJ equipment</option>
                <option value="Satellite / Other Electronics">Satellite / other electronics</option>
              </select>
            </label>
            <label>
              <span>Service preference</span>
              <select name="service" id="dt-service">
                <option value="Arrange collection (BT30/BT33/BT31/BT24)">Arrange collection (BT30, BT33, BT31, BT24)</option>
                <option value="Drop off at Ballykinlar workshop">Workshop drop-off (Ballykinlar BT30 8DD)</option>
              </select>
            </label>
          </div>

          <div class="dt-form-row">
            <label>
              <span>Make and model number</span>
              <input name="model" placeholder="e.g. Bosch Serie 4 / LG 55-inch OLED" required />
            </label>
            <label>
              <span>Your town or postcode</span>
              <input name="postcode" placeholder="e.g. Downpatrick BT30" required />
            </label>
          </div>

          <div class="dt-form-row">
            <label>
              <span>Your name</span>
              <input name="name" autocomplete="name" required />
            </label>
            <label>
              <span>Phone number</span>
              <input name="phone" type="tel" autocomplete="tel" required />
            </label>
          </div>

          <label>
            <span>Symptom or fault description</span>
            <textarea
              name="fault"
              rows="3"
              placeholder="e.g. Sound plays with no picture, not heating, error code showing"
            ></textarea>
          </label>

          <div class="dt-form-foot">
            <button class="dt-btn dt-btn--teal" type="submit">Open repair ticket email</button>
            <p>Prepares an email addressed to {email}.</p>
          </div>
        </form>
      </div>
    </section>

    <section class="dt-section dt-coverage" id="coverage" aria-labelledby="dt-cov-title">
      <div class="dt-wrap">
        <div class="dt-cov-head">
          <div>
            <h2 id="dt-cov-title">Workshop drop-off and collection across four postcodes.</h2>
            <p class="dt-cov-sub">
              Based at 8 Carrickinab Road, Ballykinlar, Downpatrick, BT30 8DD. Outside these postcodes? If you can bring it to the workshop, we will gladly look at it.
            </p>
          </div>
          <div class="dt-cov-links">
            <a class="dt-text-link dt-text-link--light" href={mapHref} rel="noopener noreferrer">Workshop directions</a>
            <a class="dt-text-link dt-text-link--light" href={facebook} rel="noopener noreferrer">Facebook</a>
          </div>
        </div>

        <dl class="dt-zone-ledger">
          {coverageZones.map((zone) => (
            <div class="dt-zone-row">
              <dt>{zone.code}</dt>
              <dd>{zone.towns}</dd>
            </div>
          ))}
        </dl>

        <LocalAreaMap
          id="digitech-map"
          kicker=""
          businessName="DigiTech Repairs"
          address="8 Carrickinab Road, Ballykinlar, Downpatrick, BT30 8DD"
          lon={-5.774}
          lat={54.262}
          spanKm={19}
          radiusKm={14}
          radiusLabel="BT30, BT33, BT31, BT24 collection"
          tone="dark"
          mapHref={mapHref}
          markers={[
            { name: "Downpatrick", lon: -5.716, lat: 54.328, note: "BT30", side: "r" },
            { name: "Newcastle", lon: -5.891, lat: 54.212, note: "BT33", side: "l" },
            { name: "Castlewellan", lon: -5.939, lat: 54.259, note: "BT31", side: "l" },
            { name: "Ballynahinch", lon: -5.899, lat: 54.402, note: "BT24", side: "l" },
            { name: "Dundrum", lon: -5.844, lat: 54.259, note: "5 mins", side: "t" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="dt-footer">
    <div class="dt-wrap dt-footer-inner">
      <div class="dt-footer-brand">
        <strong>DigiTech Repairs</strong>
        <p>8 Carrickinab Road, Ballykinlar, Downpatrick, BT30 8DD</p>
      </div>
      <div class="dt-footer-links">
        <span>Mon to Fri 9:00am to 8:00pm · Sat 9:00am to 3:00pm</span>
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-dt-header]");
      const sentinel = document.querySelector("[data-dt-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            header.classList.toggle("is-scrolled", !entries[0].isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      const tabs = Array.from(document.querySelectorAll("[data-dt-tab]"));
      const panels = Array.from(document.querySelectorAll("[data-dt-panel]"));

      const activateTab = (id, moveFocus = false) => {
        tabs.forEach((tab) => {
          const active = tab.getAttribute("data-dt-tab") === id;
          tab.classList.toggle("is-active", active);
          tab.setAttribute("aria-selected", active ? "true" : "false");
          tab.setAttribute("tabindex", active ? "0" : "-1");
          if (active && moveFocus && tab instanceof HTMLElement) tab.focus();
        });
        panels.forEach((panel) => {
          const active = panel.getAttribute("data-dt-panel") === id;
          panel.classList.toggle("is-active", active);
          panel.hidden = !active;
        });
      };

      tabs.forEach((tab, idx) => {
        tab.addEventListener("click", () => {
          const id = tab.getAttribute("data-dt-tab");
          if (id) activateTab(id);
        });
        tab.addEventListener("keydown", (e) => {
          if (e.key !== "ArrowRight" && e.key !== "ArrowLeft" && e.key !== "Home" && e.key !== "End") return;
          e.preventDefault();
          let next = idx;
          if (e.key === "ArrowRight") next = (idx + 1) % tabs.length;
          if (e.key === "ArrowLeft") next = (idx - 1 + tabs.length) % tabs.length;
          if (e.key === "Home") next = 0;
          if (e.key === "End") next = tabs.length - 1;
          const nextId = tabs[next]?.getAttribute("data-dt-tab");
          if (nextId) activateTab(nextId, true);
        });
      });

      document.querySelectorAll("[data-dt-select-eq]").forEach((link) => {
        link.addEventListener("click", () => {
          const eq = link.getAttribute("data-dt-select-eq");
          const eqSel = document.querySelector('#dt-form select[name="equipment"]');
          if (eq && eqSel instanceof HTMLSelectElement) {
            eqSel.value = eq;
            eqSel.dispatchEvent(new Event("change", { bubbles: true }));
          }
        });
      });

      const form = document.getElementById("dt-form");
      if (form instanceof HTMLFormElement) {
        form.addEventListener("submit", (event) => {
          event.preventDefault();
          const d = new FormData(form);
          const body = [
            `Equipment: ${d.get("equipment") || ""}`,
            `Make and model: ${d.get("model") || ""}`,
            `Service: ${d.get("service") || ""}`,
            `Location / postcode: ${d.get("postcode") || ""}`,
            `Name: ${d.get("name") || ""}`,
            `Phone: ${d.get("phone") || ""}`,
            "",
            `Fault: ${d.get("fault") || ""}`,
          ].join("\n");
          const to = form.dataset.email || "";
          const subject = `Repair ticket: ${d.get("equipment")} (${d.get("model")})`;
          const url = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
          if (window.dispatchEvent(new CustomEvent("mm:enquiry", { cancelable: true, detail: { to, subject, body, url } }))) {
            window.location.href = url;
          }
        });
      }
    })();
  </script>
</ConceptLayout>
