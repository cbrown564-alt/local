---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";

/* DigiTech Repairs — 8 Carrickinab Road, Ballykinlar, Downpatrick, BT30 8DD.
   Sources (live-fetched 26 Nov 2026): digitech-repairs.co.uk (/, /about/, /contact/).
   - Family-run since 2000; component-level fault finding to extend appliance life.
   - Member of a European-wide network of 1,000+ service engineers across 30+ countries.
   - Repairs: Televisions, Washing Machines, Tumble Dryers, Electric Cookers & Ovens,
     Microwave Ovens, Electric Hobs, Audio Hi-Fi, Dishwashers, DJ Equipment, Satellite.
   - Postcodes covered: BT30, BT33, BT31 & BT24 (Downpatrick, Dundrum, Newcastle,
     Killyleagh, Castlewellan, Ardglass, Ballynahinch, Drumaness, Clough, Ballykinlar,
     Tyrella, Loughinisland, Kilcoo, Crossgar, Saintfield, Killough, Strangford).
     Collection available or customer drop-off at Ballykinlar workshop.
   - Hours: Mon–Fri 9:00am – 8:00pm · Sat 9:00am – 3:00pm.
   - Phone: 07887 501827 · Email: digitech.repairs@btinternet.com.
   Brief: research/concepts/digitech-repairs/digitech-repairs-elevation-brief.md */

const phone = "07887 501827";
const phoneHref = "tel:+447887501827";
const email = "digitech.repairs@btinternet.com";
const facebook = "https://www.facebook.com/digitechrepairs";
const mapHref = "https://www.google.com/maps/search/?api=1&query=8+Carrickinab+Road+Ballykinlar+Downpatrick+BT30+8DD";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap";

const appliances = [
  "Televisions & Satellite",
  "Washing Machines & Tumble Dryers",
  "Electric Cookers, Ovens & Hobs",
  "Dishwashers & Microwave Ovens",
  "Audio Hi-Fi & Amplifiers",
  "DJ Equipment & Specialist Electronics",
];

const brands = [
  "AEG", "Beko", "Blomberg", "Bose", "Bosch", "Candy", "Dyson", "Hitachi",
  "Hoover", "Hotpoint", "Indesit", "JVC", "LG", "Miele", "Neff", "Panasonic",
  "Philips", "Samsung", "Sanyo",
];

const towns = [
  "Downpatrick", "Dundrum", "Newcastle", "Killyleagh", "Castlewellan",
  "Ardglass", "Ballynahinch", "Drumaness", "Clough", "Ballykinlar",
  "Tyrella", "Loughinisland", "Kilcoo", "Crossgar", "Saintfield",
  "Killough", "Strangford",
];
---

<ConceptLayout
  title="DigiTech Repairs — TV, Appliance & Audio Workshop, Downpatrick BT30"
  slug="digitech-repairs"
  bodyClass="concept-page concept-digitech"
  lang="en-GB"
  businessName="DigiTech Repairs"
  town="Downpatrick / Ballykinlar"
  fontHref={fontHref}
  bannerNote="The repair workbench and classic hi-fi amplifier studies are AI-generated visualisations. Repair tickets compose an email directly to digitech.repairs@btinternet.com or call 07887 501827."
>
  <div class="dt-status">
    <div class="dt-wrap dt-status-inner">
      <span>EST. 2000 · BALLYKINLAR WORKSHOP · BT30 / BT33 / BT31 / BT24</span>
      <span>MON–FRI 9AM–8PM · SAT 9AM–3PM · <a href={phoneHref}>{phone}</a></span>
    </div>
  </div>

  <header class="dt-header">
    <div class="dt-wrap dt-header-inner">
      <a class="dt-brand" href="#top">
        <span class="dt-led" aria-hidden="true"></span>
        <strong>DigiTech Repairs</strong>
      </a>
      <nav class="dt-nav" aria-label="DigiTech Repairs">
        <a href="#ticket">Log a Repair</a>
        <a href="#bench">What We Repair</a>
        <a href="#coverage">Coverage Area</a>
      </nav>
      <a class="dt-header-cta" href={phoneHref}>Call {phone}</a>
    </div>
  </header>

  <main id="top" class="dt-main">
    <section class="dt-hero" aria-labelledby="dt-hero-title">
      <div class="dt-wrap dt-hero-grid">
        <div class="dt-hero-copy">
          <p class="dt-mono-tag">COMPONENT-LEVEL DIAGNOSTICS · SINCE 2000</p>
          <h1 id="dt-hero-title">Getting you back in the picture — without replacing what can be fixed.</h1>
          <p class="dt-lede">
            Family-run electronics and home appliance repair workshop outside
            Downpatrick. We diagnose down to component level on TVs, cookers,
            washers, dryers, dishwashers, hi-fi and DJ kit — open until 8pm
            weekdays for collection or drop-off.
          </p>
          <div class="dt-hero-actions">
            <a class="dt-btn dt-btn--teal" href="#ticket">Start a bench repair ticket</a>
            <a class="dt-btn dt-btn--ghost" href={phoneHref}>Ring {phone}</a>
          </div>
          <p class="dt-tip">Tip: Having the <strong>Make &amp; Model Number</strong> ready speeds up parts lookup.</p>
        </div>

        <figure class="dt-hero-plate">
          <ResponsiveImage
            src="/media/concepts/digitech-repairs/digitech-repairs-workbench.jpg"
            alt="Electronics repair workbench with circuit board under warm task lamp, soldering iron and bench oscilloscope"
            width={1376}
            height={768}
            loading="eager"
            sizes="(max-width: 960px) 100vw, 52vw"
            class="dt-hero-img"
          />
          <figcaption>Component-level electronics bench mood. Visualisation (AI-generated).</figcaption>
        </figure>
      </div>
    </section>

    <section class="dt-ticket-section" id="ticket" aria-labelledby="dt-ticket-title">
      <div class="dt-wrap dt-ticket-grid">
        <div class="dt-ticket-info">
          <p class="dt-mono-tag dt-mono-tag--dark">JOB INTAKE · COLLECTION OR DROP-OFF</p>
          <h2 id="dt-ticket-title">Log your make, model &amp; fault in 30 seconds.</h2>
          <p>
            Fill out the repair sheet to prepare a clean job ticket for{" "}
            <a href={`mailto:${email}`}>{email}</a> — or copy the summary before
            calling <a href={phoneHref}><strong>{phone}</strong></a>. Collection
            covers BT30, BT33, BT31 &amp; BT24, or drop directly to our
            Ballykinlar workshop at your convenience.
          </p>

          <div class="dt-network-box">
            <strong>1,000+ European Engineer Network</strong>
            <p>
              Connected directly to parts suppliers and a European-wide network
              of over 1,000 service engineers across 30 countries — rescuing
              appliances many shops write off.
            </p>
          </div>
        </div>

        <form class="dt-ticket-form" id="dt-form" data-email={email}>
          <div class="dt-ticket-bar">
            <span>WORKSHOP TICKET // BT30 8DD</span>
            <span id="dt-mode-badge">COLLECTION</span>
          </div>

          <div class="dt-row">
            <label>
              <span>Equipment type</span>
              <select name="equipment">
                <option value="Television">Television</option>
                <option value="Washing Machine / Tumble Dryer">Washing Machine / Tumble Dryer</option>
                <option value="Electric Cooker / Oven / Hob">Electric Cooker / Oven / Hob</option>
                <option value="Dishwasher / Microwave">Dishwasher / Microwave</option>
                <option value="Audio Hi-Fi / DJ Equipment">Audio Hi-Fi / DJ Equipment</option>
                <option value="Satellite / Other Electronics">Satellite / Other Electronics</option>
              </select>
            </label>
            <label>
              <span>Service preference</span>
              <select name="service" id="dt-service">
                <option value="Arrange collection (BT30/BT33/BT31/BT24)">Arrange collection</option>
                <option value="Drop off at Ballykinlar workshop">Workshop drop-off</option>
              </select>
            </label>
          </div>

          <div class="dt-row">
            <label>
              <span>Make &amp; Model No.</span>
              <input name="model" placeholder="e.g. Bosch Serie 4 / LG 55” OLED" required />
            </label>
            <label>
              <span>Your town / postcode</span>
              <input name="postcode" placeholder="e.g. Downpatrick BT30" required />
            </label>
          </div>

          <div class="dt-row">
            <label>
              <span>Your name</span>
              <input name="name" autocomplete="name" required />
            </label>
            <label>
              <span>Phone number</span>
              <input name="phone" type="tel" autocomplete="tel" required />
            </label>
          </div>

          <label>
            <span>Symptom or fault description</span>
            <textarea name="fault" rows="2" placeholder="e.g. No picture with sound, not heating, error code showing"></textarea>
          </label>

          <button class="dt-btn dt-btn--teal dt-btn--full" type="submit">Open repair ticket email →</button>
        </form>
      </div>
    </section>

    <section class="dt-bench" id="bench" aria-labelledby="dt-bench-title">
      <div class="dt-wrap dt-bench-grid">
        <div class="dt-bench-copy">
          <p class="dt-mono-tag">ALL MAJOR MAKES &amp; MODELS</p>
          <h2 id="dt-bench-title">From domestic kitchens to vintage hi-fi &amp; DJ rigs.</h2>
          <ul class="dt-app-grid">
            {appliances.map((item) => <li>{item}</li>)}
          </ul>

          <div class="dt-brands">
            <span>Makes regularly repaired include:</span>
            <p>{brands.join(" · ")} — and more.</p>
          </div>
        </div>

        <figure class="dt-hifi-plate">
          <ResponsiveImage
            src="/media/concepts/digitech-repairs/digitech-repairs-hifi-detail.jpg"
            alt="Brushed aluminium stereo amplifier knobs and amber meter beside brass multimeter probes on a dark workshop bench"
            width={1200}
            height={896}
            sizes="(max-width: 960px) 100vw, 44vw"
            class="dt-hifi-img"
          />
          <figcaption>Audio hi-fi &amp; precision testing bench feel. Visualisation (AI-generated).</figcaption>
        </figure>
      </div>
    </section>

    <section class="dt-coverage" id="coverage" aria-labelledby="dt-cov-title">
      <div class="dt-wrap dt-cov-inner">
        <div>
          <p class="dt-mono-tag dt-mono-tag--dark">BT30 · BT33 · BT31 · BT24 &amp; ALL ROADS IN BETWEEN</p>
          <h2 id="dt-cov-title">Based at 8 Carrickinab Road, Ballykinlar, BT30 8DD.</h2>
          <p class="dt-towns">{towns.join(" · ")}</p>
          <p class="dt-drop-note">Outside those postcodes? If you can bring it to the workshop, we will gladly look at it.</p>
        </div>
        <div class="dt-cov-actions">
          <a class="dt-btn dt-btn--dark" href={mapHref} rel="noopener noreferrer">Workshop Directions ↗</a>
          <a class="dt-btn dt-btn--outline" href={facebook} rel="noopener noreferrer">Facebook ↗</a>
          <a class="dt-btn dt-btn--outline" href={phoneHref}>Call {phone}</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="dt-footer">
    <div class="dt-wrap dt-footer-inner">
      <span><strong>DigiTech Repairs</strong> · 8 Carrickinab Road, Ballykinlar, Downpatrick, BT30 8DD</span>
      <span>Mon–Fri 9am–8pm · Sat 9am–3pm · <a href={phoneHref}>{phone}</a> · <a href={`mailto:${email}`}>{email}</a></span>
    </div>
  </footer>

  <script>
    const svc = document.getElementById("dt-service") as HTMLSelectElement | null;
    const badge = document.getElementById("dt-mode-badge");
    svc?.addEventListener("change", () => {
      if (badge) badge.textContent = svc.value.includes("Drop off") ? "WORKSHOP DROP-OFF" : "COLLECTION";
    });

    const form = document.getElementById("dt-form") as HTMLFormElement | null;
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const d = new FormData(form);
      const body = [
        `Equipment: ${d.get("equipment") || ""}`,
        `Make & Model: ${d.get("model") || ""}`,
        `Service: ${d.get("service") || ""}`,
        `Location / Postcode: ${d.get("postcode") || ""}`,
        `Name: ${d.get("name") || ""}`,
        `Phone: ${d.get("phone") || ""}`,
        "",
        `Fault: ${d.get("fault") || ""}`,
      ].join("\n");
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`Repair Ticket: ${d.get("equipment")} (${d.get("model")})`)}&body=${encodeURIComponent(body)}`;
    });
  </script>
</ConceptLayout>
