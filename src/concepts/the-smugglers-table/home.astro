---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import "./styles.css";

/* The Smugglers Table — 4 Bridge Street / Shore Street, Killyleagh BT30 9QN.
   Verified live 26 Nov 2026: No standalone owned website (Facebook & directories only), FSA verified.
   Waterside seafood restaurant & bar by Strangford Lough, Chef Roy Abrahams, signature seafood chowder
   with homemade wheaten bread, open prawn sandwiches, locally caught fish & Sunday roasts.
   Direct phone reservations: 028 4482 8158. */
const phone = "028 4482 8158";
const phoneHref = "tel:+442844828158";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=The+Smugglers+Table+Killyleagh+BT30+9QN";

const menuGroups = [
  {
    id: "lough",
    label: "Strangford Seafood",
    items: [
      { name: "Signature Seafood Chowder", note: "Rich creamy chowder brimming with smoked haddock, white fish and prawns, served with homemade dark wheaten bread", meta: "House favourite" },
      { name: "Open Prawn Sandwich", note: "Plump chilled prawns on thick home-baked wheaten bread with Marie Rose and lemon", meta: "Lunch & Day" },
      { name: "Fresh Locally Caught Fish", note: "Daily Strangford & Irish Sea fish cooked simply in Chef Roy Abrahams' kitchen", meta: "Daily board" },
    ],
  },
  {
    id: "sunday",
    label: "Sunday Roasts & Sweets",
    items: [
      { name: "Traditional Sunday Roasts", note: "Proper Sunday plates by the water — ring ahead to reserve your sitting", meta: "Advance booking advised" },
      { name: "House-Made Desserts", note: "Freshly baked puddings, tarts and coffee after a walk along the Killyleagh shore", meta: "Made in-house" },
    ],
  },
];
---

<ConceptLayout
  title="The Smugglers Table — Seafood Restaurant & Bar, Killyleagh"
  slug="the-smugglers-table"
  bodyClass="concept-page concept-smugglers"
  businessName="The Smugglers Table"
  town="Killyleagh"
  bannerNote="Imagery comprises indicative Strangford seafood chowder and waterside dining-room visualisations."
>
  <header class="st-header">
    <div class="st-header-inner">
      <a class="st-brand" href="#top">
        <strong>The Smugglers Table</strong>
        <span>Strangford Lough · Killyleagh</span>
      </a>
      <nav class="st-nav" aria-label="Primary">
        <a href="#chowder">The Kitchen</a>
        <a href="#room">By the Water</a>
        <a href="#book">Reserve a Table</a>
        <a href="#location">Find Us</a>
      </nav>
      <div class="st-header-actions">
        <a class="st-header-tel" href={phoneHref}>{phone}</a>
        <a class="st-header-cta" href={phoneHref}>Call to Book</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="st-hero" aria-labelledby="st-hero-title">
      <div class="st-wrap st-hero-grid">
        <div class="st-hero-copy">
          <p class="st-kicker">Shore Street &amp; Bridge Street · Killyleagh · BT30 9QN</p>
          <h1 id="st-hero-title">Strangford Lough chowder, fresh catch and warm wheaten bread.</h1>
          <p class="st-lead">
            A cosy waterside seafood restaurant and bar in the heart of Killyleagh — headed by Chef Roy
            Abrahams, serving freshly landed local fish, open prawn sandwiches and Sunday roasts steps
            from the lough.
          </p>
          <div class="st-actions">
            <a class="st-btn st-btn--primary" href={phoneHref}>Ring for a Table · {phone}</a>
            <SpecimenSheet
              id="st-menu-sheet"
              triggerLabel="See House Favourites"
              kicker="The Smugglers Table · Killyleagh"
              title="Chowder, Local Catch & Sunday Roasts"
              subtitle="Seasonal openings vary across the year — always ring 028 4482 8158 ahead to book."
              groups={menuGroups}
              ctaLabel={`Call ${phone}`}
              ctaHref={phoneHref}
              secondaryLabel="Google Maps ↗"
              secondaryHref={mapsHref}
              buttonClass="st-btn st-btn--outline"
            />
          </div>
        </div>
        <figure class="st-hero-plate">
          <picture>
            <source srcset="/media/concepts/the-smugglers-table/smugglers-strangford-chowder-640.webp 640w, /media/concepts/the-smugglers-table/smugglers-strangford-chowder-1265.webp 1265w" sizes="(max-width: 900px) 100vw, 52vw" type="image/webp" />
            <img src="/media/concepts/the-smugglers-table/smugglers-strangford-chowder.jpg" alt="Rustic bowl of creamy Irish seafood chowder with dark homemade wheaten bread and butter on driftwood oak" width="1408" height="960" loading="eager" />
          </picture>
          <figcaption>Signature seafood chowder &amp; dark wheaten bread. Indicative dish visualisation.</figcaption>
        </figure>
      </div>
    </section>

    <section class="st-section st-chowder" id="chowder" aria-labelledby="st-ch-title">
      <div class="st-wrap st-three">
        <article>
          <span>From the Pot</span>
          <h2 id="st-ch-title">Seafood Chowder &amp; Homemade Wheaten</h2>
          <p>The dish travellers drive the length of Strangford Lough for — thick, deeply savoury and served piping hot with fresh-baked bread.</p>
        </article>
        <article>
          <span>From the Lough</span>
          <h3>Locally Landed Fish &amp; Prawn Plates</h3>
          <p>Seasonal coastal landings cooked plainly so the fish speaks for itself, alongside open prawn sandwiches and crisp salads.</p>
        </article>
        <article>
          <span>Sundays</span>
          <h3>Roasts &amp; House Desserts</h3>
          <p>Proper family Sunday tables followed by homemade puddings and a walk under Killyleagh Castle along the shore.</p>
        </article>
      </div>
    </section>

    <section class="st-section st-room" id="room" aria-labelledby="st-room-title">
      <div class="st-wrap st-split">
        <figure class="st-plate">
          <picture>
            <source srcset="/media/concepts/the-smugglers-table/smugglers-waterside-tables-640.webp 640w, /media/concepts/the-smugglers-table/smugglers-waterside-tables-1265.webp 1265w" sizes="(max-width: 860px) 100vw, 48vw" type="image/webp" />
            <img src="/media/concepts/the-smugglers-table/smugglers-waterside-tables.jpg" alt="Cosy whitewashed coastal Irish restaurant dining room with sea-teal wainscoting overlooking Strangford Lough" width="1408" height="960" loading="lazy" />
          </picture>
          <figcaption>Waterside dining room in Killyleagh. Indicative room visualisation.</figcaption>
        </figure>
        <div id="book">
          <p class="st-kicker">Reservations &amp; Seasonal Hours</p>
          <h2 id="st-room-title">Small room, fresh kitchen — always call ahead to book.</h2>
          <p>
            Because seating is intimate and kitchen hours shift gently with the Strangford seasons, the
            surest way to hold a table for lunch, evening seafood or Sunday roast is a quick call to the
            restaurant before you travel.
          </p>
          <div class="st-call-box">
            <p class="st-call-label">Direct Table Reservations</p>
            <a class="st-call-num" href={phoneHref}>{phone}</a>
            <p class="st-call-addr">4 Bridge Street / Shore Street · Killyleagh · BT30 9QN</p>
          </div>
        </div>
      </div>
    </section>

    <section class="st-section st-map-band" id="location" aria-label="Killyleagh Strangford Lough map">
      <div class="st-wrap">
        <LocalAreaMap
          id="st-map"
          kicker="Killyleagh & Strangford Lough"
          businessName="The Smugglers Table"
          address="4 Bridge Street / Shore Street, Killyleagh, BT30 9QN"
          lon={-5.6463647}
          lat={54.3982881}
          spanKm={18}
          showFerry={true}
          mapHref={mapsHref}
          markers={[
            { name: "Downpatrick", lon: -5.7168, lat: 54.3286, note: "10 mins south", side: "b" },
            { name: "Crossgar", lon: -5.7644, lat: 54.4021, note: "9 mins west", side: "l" },
            { name: "Strangford Ferry", lon: -5.5546, lat: 54.3712, note: "16 mins south-east", side: "r" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="st-footer">
    <div class="st-wrap st-footer-inner">
      <div>
        <strong>The Smugglers Table</strong>
        <p>Shore Street &amp; Bridge Street, Killyleagh, Co. Down, BT30 9QN</p>
      </div>
      <div class="st-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={mapsHref} target="_blank" rel="noopener noreferrer">Directions ↗</a>
      </div>
    </div>
  </footer>
</ConceptLayout>
