---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import "./styles.css";

/* The Smugglers Table, 4 Bridge Street / Shore Street, Killyleagh BT30 9QN.
   Verified live 26 Nov 2026: FSA verified. Waterside seafood restaurant & bar by Strangford Lough,
   Chef Roy Abrahams, signature seafood chowder with homemade wheaten bread, open prawn sandwiches,
   locally caught fish & Sunday roasts. Direct phone reservations: 028 4482 8158. */
const phone = "028 4482 8158";
const phoneHref = "tel:+442844828158";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=The+Smugglers+Table+Killyleagh+BT30+9QN";

const menuGroups = [
  {
    id: "lough",
    label: "Strangford seafood",
    items: [
      {
        name: "Signature seafood chowder",
        note: "Rich creamy chowder brimming with smoked haddock, white fish, and prawns, served with homemade dark wheaten bread.",
        meta: "House favourite",
      },
      {
        name: "Open prawn sandwich",
        note: "Plump chilled prawns on thick home-baked wheaten bread with Marie Rose and lemon.",
        meta: "Lunch and day",
      },
      {
        name: "Fresh locally caught fish",
        note: "Daily Strangford and Irish Sea fish cooked simply in Chef Roy Abrahams' kitchen.",
        meta: "Daily board",
      },
    ],
  },
  {
    id: "sunday",
    label: "Sunday roasts and sweets",
    items: [
      {
        name: "Traditional Sunday roasts",
        note: "Proper Sunday plates by the water. Ring ahead to reserve your sitting.",
        meta: "Advance booking advised",
      },
      {
        name: "House-made desserts",
        note: "Freshly baked puddings, tarts, and coffee after a walk along the Killyleagh shore.",
        meta: "Made in-house",
      },
    ],
  },
];
---

<ConceptLayout
  title="The Smugglers Table, Seafood Restaurant & Bar, Killyleagh"
  slug="the-smugglers-table"
  bodyClass="concept-page concept-smugglers"
  businessName="The Smugglers Table"
  town="Killyleagh"
  bannerNote="Imagery comprises indicative Strangford seafood chowder and waterside dining-room visualisations."
>
  <header class="st-header" data-st-header>
    <div class="st-header-inner">
      <a class="st-brand" href="#top">The Smugglers Table</a>
      <nav class="st-nav" aria-label="Primary">
        <a href="#kitchen">Kitchen and shore</a>
        <a href="#room">By the water</a>
        <a href="#book">Reserve a table</a>
        <a href="#location">Find us</a>
      </nav>
      <div class="st-header-actions">
        <a class="st-header-tel" href={phoneHref}>{phone}</a>
        <a class="st-header-cta" href={phoneHref}>Call to book</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="st-hero" aria-labelledby="st-hero-title">
      <div class="st-hero-sentinel" data-st-sentinel aria-hidden="true"></div>
      <div class="st-hero-media">
        <picture>
          <source
            srcset="/media/concepts/the-smugglers-table/smugglers-waterside-tables-640.webp 640w, /media/concepts/the-smugglers-table/smugglers-waterside-tables-1265.webp 1265w"
            sizes="100vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/the-smugglers-table/smugglers-waterside-tables.jpg"
            alt="Cosy whitewashed coastal Irish restaurant dining room with sea-teal wainscoting overlooking Strangford Lough"
            width="1408"
            height="960"
            loading="eager"
          />
        </picture>
        <div class="st-hero-scrim" aria-hidden="true"></div>
      </div>

      <div class="st-wrap st-hero-foot">
        <div class="st-hero-title-col">
          <h1 id="st-hero-title">Strangford chowder and fresh local catch.</h1>
        </div>
        <div class="st-hero-copy-col">
          <p class="st-hero-lead">
            Chef Roy Abrahams' waterside seafood kitchen in Killyleagh, serving daily local fish, warm wheaten bread, and Sunday roasts.
          </p>
          <a class="st-btn st-btn--primary" href="#book">Reserve a table</a>
          <p class="st-hero-caption">Indicative Killyleagh waterside dining room visualisation.</p>
        </div>
      </div>
    </section>

    <section class="st-section st-stage" id="kitchen" aria-labelledby="st-kit-title">
      <div class="st-wrap st-stage-grid">
        <div class="st-stage-copy">
          <h2 id="st-kit-title">The kitchen and shore in Killyleagh.</h2>

          <div class="st-tabs" role="tablist" aria-label="The kitchen and shore" data-st-tabs>
            <button
              type="button"
              class="st-tab"
              role="tab"
              id="st-tab-chowder"
              aria-selected="true"
              aria-controls="st-panel-chowder"
            >
              Chowder and shellfish
            </button>
            <button
              type="button"
              class="st-tab"
              role="tab"
              id="st-tab-allday"
              aria-selected="false"
              aria-controls="st-panel-allday"
              tabindex="-1"
            >
              All-day kitchen
            </button>
            <button
              type="button"
              class="st-tab"
              role="tab"
              id="st-tab-tables"
              aria-selected="false"
              aria-controls="st-panel-tables"
              tabindex="-1"
            >
              Shore Street tables
            </button>
          </div>

          <div class="st-panel" role="tabpanel" id="st-panel-chowder" aria-labelledby="st-tab-chowder">
            <p>
              The pot people drive the length of Strangford Lough for, cooked piping hot alongside fresh Irish Sea landings and crisp salads.
            </p>
            <dl class="st-stage-ledger">
              <div>
                <dt>Signature seafood chowder</dt>
                <dd>Smoked haddock, white fish, and prawns with homemade dark wheaten bread</dd>
              </div>
              <div>
                <dt>Open prawn sandwich</dt>
                <dd>Chilled prawns on thick home-baked wheaten bread with Marie Rose and lemon</dd>
              </div>
              <div>
                <dt>Fresh local catch</dt>
                <dd>Daily Strangford and Irish Sea fish cooked simply in Chef Roy Abrahams' kitchen</dd>
              </div>
            </dl>
          </div>

          <div class="st-panel" role="tabpanel" id="st-panel-allday" aria-labelledby="st-tab-allday" hidden>
            <p>
              From daytime prawn sandwiches and coffee after a shore walk to unhurried family Sunday roasts by the water.
            </p>
            <dl class="st-stage-ledger">
              <div>
                <dt>Traditional Sunday roasts</dt>
                <dd>Proper Sunday plates overlooking the lough; advance booking advised</dd>
              </div>
              <div>
                <dt>House-made desserts</dt>
                <dd>Freshly baked puddings, tarts, and hot coffee made in-house</dd>
              </div>
              <div>
                <dt>Seasonal hours</dt>
                <dd>Kitchen sittings shift gently with the Strangford seasons; ring <a href={phoneHref}>{phone}</a> ahead</dd>
              </div>
            </dl>
          </div>

          <div class="st-panel" role="tabpanel" id="st-panel-tables" aria-labelledby="st-tab-tables" hidden>
            <p>
              An intimate waterside dining room and bar steps from the shoreline, beneath Killyleagh Castle.
            </p>
            <dl class="st-stage-ledger">
              <div>
                <dt>Address</dt>
                <dd>4 Bridge Street / Shore Street, Killyleagh, BT30 9QN</dd>
              </div>
              <div>
                <dt>Direct reservations</dt>
                <dd><a href={phoneHref}>{phone}</a></dd>
              </div>
              <div>
                <dt>Directions</dt>
                <dd><a href={mapsHref} target="_blank" rel="noopener noreferrer">Open in Google Maps ↗</a></dd>
              </div>
            </dl>
          </div>

          <div class="st-stage-sheet">
            <SpecimenSheet
              id="st-menu-sheet"
              triggerLabel="See house favourites guide"
              kicker="The Smugglers Table, Killyleagh"
              title="Chowder, local catch, and Sunday roasts"
              subtitle="Seasonal openings vary across the year. Always ring 028 4482 8158 ahead to book."
              groups={menuGroups}
              ctaLabel={`Call ${phone}`}
              ctaHref={phoneHref}
              secondaryLabel="Google Maps ↗"
              secondaryHref={mapsHref}
              buttonClass="st-link-trigger"
            />
          </div>
        </div>

        <div class="st-stage-media">
          <figure class="st-plate">
            <picture>
              <source
                srcset="/media/concepts/the-smugglers-table/smugglers-strangford-chowder-640.webp 640w, /media/concepts/the-smugglers-table/smugglers-strangford-chowder-1265.webp 1265w"
                sizes="(max-width: 860px) 100vw, 48vw"
                type="image/webp"
              />
              <img
                src="/media/concepts/the-smugglers-table/smugglers-strangford-chowder.jpg"
                alt="Rustic bowl of creamy Irish seafood chowder with dark homemade wheaten bread and butter on driftwood oak"
                width="1408"
                height="960"
                loading="lazy"
              />
            </picture>
            <figcaption>Signature seafood chowder and dark wheaten bread. Indicative dish visualisation.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="st-section st-room" id="room" aria-labelledby="st-room-title">
      <div class="st-wrap st-split">
        <div class="st-copy-col">
          <h2 id="st-room-title">Small room, fresh kitchen by the lough.</h2>
          <p>
            Headed by Chef Roy Abrahams, our dining room sits right on the water at Bridge Street and Shore Street, ready for unhurried lunches, evening fish plates, and Sunday family tables.
          </p>
          <p>
            Because seating is cosy and opening hours follow the Strangford seasons, ringing ahead before you travel is always the surest way to hold your table.
          </p>
        </div>
        <div class="st-ledger-col">
          <dl class="st-ledger">
            <div>
              <dt>Kitchen</dt>
              <dd>Chef Roy Abrahams, daily coastal landings and homemade wheaten</dd>
            </div>
            <div>
              <dt>Location</dt>
              <dd>4 Bridge Street / Shore Street, Killyleagh, BT30 9QN</dd>
            </div>
            <div>
              <dt>Table desk</dt>
              <dd><a href={phoneHref}>{phone}</a></dd>
            </div>
            <div>
              <dt>Sunday sittings</dt>
              <dd>Advance telephone booking advised for lunch and Sunday roasts</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="st-section st-book" id="book" aria-labelledby="st-book-title">
      <div class="st-wrap st-split">
        <div class="st-copy-col">
          <h2 id="st-book-title">Always call ahead to reserve your table.</h2>
          <p>
            Ring the restaurant directly on <a href={phoneHref}>{phone}</a> for live table availability, or prepare your date, party size, and sitting note below before calling the desk.
          </p>
        </div>
        <div class="st-form-col">
          <form class="st-form" data-st-form>
            <div class="st-row">
              <label>
                <span>Your name</span>
                <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
              </label>
              <label>
                <span>Telephone</span>
                <input name="phone" type="tel" required autocomplete="tel" placeholder="028 or 07..." />
              </label>
            </div>
            <div class="st-row">
              <label>
                <span>Preferred date</span>
                <input name="date" type="date" required />
              </label>
              <label>
                <span>Party size</span>
                <input name="guests" type="number" min="1" max="20" value="4" required />
              </label>
            </div>
            <label>
              <span>Sitting</span>
              <select name="sitting">
                <option value="Lunch and chowder table">Lunch and chowder table</option>
                <option value="Evening seafood dinner">Evening seafood dinner</option>
                <option value="Sunday roast sitting">Sunday roast sitting</option>
              </select>
            </label>
            <label>
              <span>Dietary or seating notes</span>
              <textarea name="notes" rows="3" placeholder="Preferred time, dietary notes, or window table request"></textarea>
            </label>
            <button class="st-btn st-btn--primary" type="submit">Prepare reservation note</button>
          </form>
        </div>
      </div>
    </section>

    <section class="st-section st-map-band" id="location" aria-label="Killyleagh Strangford Lough map">
      <div class="st-wrap">
        <LocalAreaMap
          id="st-map"
          kicker=""
          businessName="The Smugglers Table"
          address="4 Bridge Street / Shore Street, Killyleagh, BT30 9QN"
          lon={-5.6463647}
          lat={54.3982881}
          spanKm={18}
          showFerry={true}
          mapHref={mapsHref}
          markers={[
            { name: "Downpatrick", lon: -5.7168, lat: 54.3286, note: "10 mins south", side: "b" },
            { name: "Crossgar", lon: -5.7644, lat: 54.4021, note: "9 mins west", side: "l" },
            { name: "Strangford Ferry", lon: -5.5546, lat: 54.3712, note: "16 mins south-east", side: "r" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="st-footer">
    <div class="st-wrap st-footer-inner">
      <div>
        <strong>The Smugglers Table</strong>
        <p>4 Bridge Street / Shore Street, Killyleagh, Co. Down, BT30 9QN</p>
      </div>
      <div class="st-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={mapsHref} target="_blank" rel="noopener noreferrer">Directions ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-st-header]");
      const sentinel = document.querySelector("[data-st-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            const entry = entries[0];
            if (!entry) return;
            header.classList.toggle("is-scrolled", !entry.isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      const tablist = document.querySelector("[data-st-tabs]");
      if (tablist) {
        const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
        const activate = (tab, moveFocus) => {
          tabs.forEach((t) => {
            const selected = t === tab;
            t.setAttribute("aria-selected", String(selected));
            t.tabIndex = selected ? 0 : -1;
            const panelId = t.getAttribute("aria-controls");
            const panel = panelId ? document.getElementById(panelId) : null;
            if (panel) panel.hidden = !selected;
          });
          if (moveFocus) tab.focus();
        };
        tabs.forEach((tab, idx) => {
          tab.addEventListener("click", () => activate(tab, false));
          tab.addEventListener("keydown", (e) => {
            if (e.key === "ArrowRight") {
              e.preventDefault();
              activate(tabs[(idx + 1) % tabs.length], true);
            } else if (e.key === "ArrowLeft") {
              e.preventDefault();
              activate(tabs[(idx - 1 + tabs.length) % tabs.length], true);
            } else if (e.key === "Home") {
              e.preventDefault();
              activate(tabs[0], true);
            } else if (e.key === "End") {
              e.preventDefault();
              activate(tabs[tabs.length - 1], true);
            }
          });
        });
      }

      const form = document.querySelector("[data-st-form]");
      if (form) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;
          const fd = new FormData(form);
          const subject = `Table reservation: ${fd.get("sitting")} for ${fd.get("guests")} (${fd.get("date")})`;
          const body = [
            `Name: ${fd.get("name")}`,
            `Telephone: ${fd.get("phone")}`,
            `Preferred date: ${fd.get("date")}`,
            `Party size: ${fd.get("guests")}`,
            `Sitting: ${fd.get("sitting")}`,
            `Notes: ${fd.get("notes") || "None"}`,
          ].join("\n");
          const ev = new CustomEvent("mm:enquiry", {
            cancelable: true,
            detail: {
              to: "The Smugglers Table desk (028 4482 8158)",
              subject,
              body,
              url: "tel:+442844828158",
            },
          });
          if (window.dispatchEvent(ev)) {
            window.location.href = "tel:+442844828158";
          }
        });
      }
    })();
  </script>
</ConceptLayout>
