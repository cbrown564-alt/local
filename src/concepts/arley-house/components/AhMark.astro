---
/**
 * Arley House — bespoke line monogram / mark.
 * Sourced to the house's architectural gable, front door and 14 Belfast Road setting.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className = "" } = Astro.props;
---

<svg
  class:list={["ah-mark", className]}
  width={size}
  height={Math.round(size * 1.15)}
  viewBox="0 0 32 37"
  fill="none"
  aria-hidden="true"
>
  <!-- Architectural gable roofline -->
  <path
    d="M3 15L16 3.5L29 15"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <!-- House frame -->
  <path
    d="M6 14.5V33.5H26V14.5"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <!-- Intertwined 'A' crossbar and hearth threshold -->
  <path
    d="M10 24.5H22"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
  />
  <!-- Central doorway / path -->
  <path
    d="M13 33.5V20.5H19V33.5"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <!-- Chimney stack -->
  <path
    d="M22 8.5V4.5H25V11"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>

<style>
  .ah-mark {
    display: inline-block;
    vertical-align: middle;
    color: currentColor;
    flex-shrink: 0;
  }
</style>
