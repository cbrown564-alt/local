---
/** Arley House — the village and the bay, with generated artwork as scenery. */
import GeneratedMapPlate from "../../_shell/GeneratedMapPlate.astro";

interface Props { headingId?: string; }
const { headingId } = Astro.props;
---

<GeneratedMapPlate
  id="ah-map"
  src="/media/maps/arley-house-village-generated.png"
  width={1536}
  height={1344}
  title="Dundrum and the bay, illustrated"
  desc="An indicative north-up map of Dundrum and its bay: Arley House on Belfast Road north of the village, Dundrum Castle on its hill to the west, the bay and beaches to the east, Newcastle down the coast road, and the Mournes along the southern edge."
  headingId={headingId}
>
  <span class="ah-generated-map-label ah-generated-map-label--title">Wake in Dundrum<small>the village and the bay</small></span>
  <span class="ah-generated-map-label ah-generated-map-label--arley">Arley House<small>14 Belfast Road</small></span>
  <span class="ah-generated-map-label ah-generated-map-label--castle">Dundrum Castle<small>a short walk</small></span>
  <span class="ah-generated-map-label ah-generated-map-label--village">Dundrum</span>
  <span class="ah-generated-map-label ah-generated-map-label--newcastle">Newcastle</span>
  <span class="ah-generated-map-label ah-generated-map-label--road">Belfast Road</span>
  <span class="ah-generated-map-label ah-generated-map-label--bay">DUNDRUM BAY<small>beaches either side</small></span>
  <span class="ah-generated-map-label ah-generated-map-label--mournes">the Mournes</span>

  <span slot="caption">A drawn view of the village and the bay as we describe them to guests — indicative, not a survey.</span>
</GeneratedMapPlate>
