---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

const phone = "028 4375 0949";
const phoneHref = "tel:+442843750949";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,500;0,600;1,500&family=Source+Sans+3:wght@400;600&display=swap";
---

<ConceptLayout
  title={"Arley House — independent concept"}
  slug="arley-house"
  bodyClass="concept-page concept-arley"
  businessName="Arley House"
  town="Dundrum"
  fontHref={fontHref}
  bannerNote="The village plate is a drawn illustration, not a photograph of the house."
>
  <header class="ah-header">
    <a class="ah-brand" href="/concepts/arley-house/">
      <span class="ah-name">Arley House</span>
      <span class="ah-sub">Bed and breakfast · Dundrum</span>
    </a>
    <nav class="ah-nav">
      <a href="#place">The house</a>
      <a href="#stay">A stay</a>
      <a href="#enquire">Enquire</a>
    </nav>
    <a class="ah-phone" href={phoneHref}>{phone}</a>
  </header>
  <main class="ah-main">
    <section class="ah-hero">
      <p class="ah-eyebrow">14 Belfast Road · the A24/A2</p>
      <h1>Two beaches either side. The castle a short walk.</h1>
      <p class="ah-lead">A family-run bed and breakfast in picturesque Dundrum, on the main Belfast to Newcastle road. Perfectly placed for a rest, a walk, or just passing through.</p>
      <p class="ah-cta">
        <a class="ah-btn" href="#enquire">Ask about nights</a>
        <a class="ah-quiet" href={phoneHref}>Call {phone}</a>
      </p>
    </section>
    <blockquote class="ah-voice">
      <p>“If it's the beach you like, we have 2 award winning beaches on either side of us… climbing the historic Dundrum Castle gives you a bird's eye view of how the land lies all the way up to where the Mountains of Mourne sweep down to the sea.”</p>
      <footer>Arley House · Visit Mourne Gullion Strangford</footer>
    </blockquote>
    <figure class="ah-plate">
      <svg viewBox="0 0 720 260" role="img" aria-label="Drawn plate of Dundrum: castle, bay, Belfast Road, two beaches">
        <rect width="720" height="260" fill="#efe6d4"/>
        <path d="M0 150 Q180 120 360 150 T720 140 L720 260 L0 260 Z" fill="#c9d6c2"/>
        <path d="M40 200 Q200 170 380 195 T700 180" fill="none" stroke="#6b8a7a" stroke-width="8"/>
        <rect x="300" y="88" width="70" height="52" fill="#7a5a3a"/>
        <polygon points="300,88 335,58 370,88" fill="#5a3f28"/>
        <text x="335" y="155" text-anchor="middle" font-size="12" fill="#3d2a18">Castle</text>
        <text x="120" y="230" font-size="12" fill="#3d2a18">beach</text>
        <text x="560" y="230" font-size="12" fill="#3d2a18">beach</text>
        <text x="360" y="40" text-anchor="middle" font-size="13" fill="#3d2a18">A24 / A2 · Belfast Road</text>
        <line x1="80" y1="48" x2="640" y2="48" stroke="#8a7355" stroke-width="3"/>
      </svg>
      <figcaption>Drawn plate: the house sits on the road between two beaches, with the castle in the village.</figcaption>
    </figure>
    <section class="ah-place" id="place">
      <p class="ah-eyebrow">Where you are</p>
      <h2>Dundrum first. Newcastle when you want it.</h2>
      <p>14 Belfast Road, Dundrum, BT33 0NG. Restaurants and pubs a short walk. Walking with the Mournes as the backdrop. Central to Ardglass, Kilkeel and Royal County Down if you came to play golf.</p>
    </section>
    <section class="ah-stay" id="stay">
      <p class="ah-eyebrow">What the house holds</p>
      <h2>Dogs inside. A games room. A ground-floor bedroom if you need one.</h2>
      <ul>
        <li>Dogs welcome inside and outside</li>
        <li>TV and games room</li>
        <li>Ground-floor bedrooms</li>
        <li>Cot and highchair</li>
        <li>On-site parking, wifi, laundry</li>
        <li>Tea and coffee in the rooms</li>
      </ul>
      <p class="ah-note">Facilities as published on the official Visit Mourne listing.</p>
    </section>
    <form class="ah-form" id="enquire">
      <h2>Have your nights ready, then ring the house.</h2>
      <p>We have not put rates or a diary here. Write what you need, then call.</p>
      <label>Your name <input id="ah-name" required autocomplete="name" /></label>
      <label>Nights you have in mind <input id="ah-when" placeholder="12–14 September" /></label>
      <label>Anything we should know <textarea id="ah-notes" rows="3"></textarea></label>
      <button class="ah-btn" type="submit">Show me what to say</button>
      <div class="ah-handoff" data-ah-handoff hidden>
        <strong>Ring {phone} and say:</strong>
        <pre data-ah-script></pre>
        <a class="ah-btn" href={phoneHref}>Call now</a>
      </div>
    </form>
  </main>
  <script is:inline>
    (function () {
      var form = document.getElementById("enquire");
      if (!form) return;
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        if (!form.reportValidity()) return;
        var name = document.getElementById("ah-name").value.trim();
        var when = document.getElementById("ah-when").value.trim();
        var notes = document.getElementById("ah-notes").value.trim();
        form.querySelector("[data-ah-script]").textContent = [
          "Hello, my name is " + name + ".",
          when ? "I am hoping to stay " + when + "." : "I would like to ask about a stay.",
          notes || ""
        ].filter(Boolean).join("\n");
        form.querySelector("[data-ah-handoff]").hidden = false;
      });
    })();
  </script>
</ConceptLayout>
