---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

const phone = "028 4375 0949";
const phoneHref = "tel:+442843750949";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,500;0,600;0,700;1,500&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap";

const walk = [
  {
    mark: "I",
    place: "The road",
    line: "You are already on the A24/A2 — the main Belfast to Newcastle road. The house is 14 Belfast Road, Dundrum.",
  },
  {
    mark: "II",
    place: "The village",
    line: "A family-run bed and breakfast, perfectly placed for a rest, a walk, or just passing through. Restaurants and locally owned pubs are a short walk.",
  },
  {
    mark: "III",
    place: "Beaches and castle",
    line: "Two award-winning beaches sit on either side of Dundrum. Climb Dundrum Castle for a bird’s-eye view of how the land lies, all the way to where the Mountains of Mourne sweep down to the sea.",
  },
  {
    mark: "IV",
    place: "The golf coasts",
    line: "Ardglass, Kilkeel, and Royal County Down. Newcastle when you want it — not before.",
  },
];

const holds = [
  { name: "Dogs", line: "Welcome inside and outside." },
  { name: "TV and games room", line: "A room in the house for an evening in." },
  { name: "Ground-floor bedrooms", line: "If the stairs are not for you." },
  { name: "Cot and highchair", line: "For a stay with a very small guest." },
  { name: "Parking, wifi, laundry", line: "On site, as listed." },
  { name: "Tea and coffee", line: "In the rooms." },
];
---

<ConceptLayout
  title={"Arley House — independent concept"}
  slug="arley-house"
  bodyClass="concept-page concept-arley"
  businessName="Arley House"
  town="Dundrum"
  fontHref={fontHref}
  bannerNote="The village plate is drawn."
>
  <main class="ah-page">
    <section class="ah-plate" aria-label="Dundrum">
      <svg class="ah-plate-draw" viewBox="0 0 1200 780" role="img" aria-label="Drawn map of Dundrum: A24/A2, two beaches, Dundrum Castle, house at 14 Belfast Road">
        <defs>
          <linearGradient id="ah-sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#c9d6cf"/>
            <stop offset="1" stop-color="#e4dcc8"/>
          </linearGradient>
          <linearGradient id="ah-bay" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#7d9a98"/>
            <stop offset=".7" stop-color="#6b8a86"/>
            <stop offset="1" stop-color="#5d7a74"/>
          </linearGradient>
        </defs>
        <rect width="1200" height="780" fill="url(#ah-sky)"/>
        <path d="M0 168 Q90 92 210 128 T430 108 T680 148 T960 96 T1200 140 L1200 230 L0 230 Z" fill="#8ea08c"/>
        <path d="M0 148 Q140 78 280 118 T560 98 T860 136 T1200 88 L1200 168 L0 188 Z" fill="#6f826c"/>
        <text x="600" y="72" text-anchor="middle" font-size="15" letter-spacing="4" fill="#2c3528" font-family="Georgia, serif">MOUNTAINS OF MOURNE</text>

        <path d="M0 430 Q180 360 360 410 T720 380 T1200 430 L1200 780 L0 780 Z" fill="#d8c8a6"/>
        <path d="M0 540 Q220 500 480 560 T1200 520 L1200 780 L0 780 Z" fill="#c4b48c"/>

        <path d="M0 610 C160 560 280 640 420 600 C560 560 640 680 820 620 C980 568 1080 660 1200 610 L1200 780 L0 780 Z" fill="url(#ah-bay)"/>
        <ellipse cx="210" cy="628" rx="168" ry="36" fill="#9bb8a8"/>
        <ellipse cx="990" cy="636" rx="168" ry="36" fill="#9bb8a8"/>
        <text x="210" y="634" text-anchor="middle" font-size="14" fill="#1f2c28" font-family="Georgia, serif">beach</text>
        <text x="990" y="642" text-anchor="middle" font-size="14" fill="#1f2c28" font-family="Georgia, serif">beach</text>

        <path d="M40 368 L1160 368" stroke="#6b5340" stroke-width="22"/>
        <path d="M40 368 L1160 368" stroke="#cbb48a" stroke-width="4" stroke-dasharray="18 16"/>
        <text x="88" y="354" font-size="13" fill="#3a3228" font-family="Georgia, serif">Belfast</text>
        <text x="1112" y="354" text-anchor="end" font-size="13" fill="#3a3228" font-family="Georgia, serif">Newcastle</text>
        <text x="600" y="338" text-anchor="middle" font-size="16" letter-spacing="3" fill="#3a3228" font-family="Georgia, serif">A24 / A2  ·  BELFAST ROAD</text>

        <g transform="translate(568 286)">
          <rect x="0" y="18" width="64" height="48" fill="#6a4632"/>
          <polygon points="0,18 32,-8 64,18" fill="#4a3020"/>
          <rect x="26" y="38" width="12" height="28" fill="#241810"/>
          <circle cx="32" cy="-18" r="10" fill="#8a3a2a"/>
          <path d="M32 -28 L32 -42" stroke="#8a3a2a" stroke-width="2"/>
        </g>
        <text x="600" y="414" text-anchor="middle" font-size="14" fill="#2c2418" font-family="Georgia, serif">14 Belfast Road</text>

        <g transform="translate(820 250)">
          <path d="M0 48 L22 0 L44 48 Z" fill="#4e3a2c"/>
          <rect x="12" y="48" width="20" height="32" fill="#6a5340"/>
          <rect x="28" y="28" width="18" height="52" fill="#5a4434"/>
        </g>
        <text x="854" y="348" text-anchor="middle" font-size="13" fill="#2c2418" font-family="Georgia, serif">Castle</text>

        <text x="80" y="250" font-size="12" fill="#3a4034" font-family="Georgia, serif">DUNDRUM</text>
      </svg>

      <div class="ah-plate-copy">
        <p class="ah-plate-name">Arley House · Dundrum</p>
        <h1>Dundrum first.<br />Newcastle when you want it.</h1>
        <p class="ah-plate-say">Two beaches either side. The castle a short walk. The house on the A24/A2.</p>
        <nav class="ah-plate-nav" aria-label="On this page">
          <a href="#walk">Walk the village</a>
          <a href="#house">What the house holds</a>
          <a href="#enquire">Ring the house</a>
        </nav>
      </div>
    </section>

    <figure class="ah-pull">
      <blockquote>
        <p>
          If it's the beach you like, we have 2 award winning beaches on either
          side of us… climbing the historic Dundrum Castle gives you a bird's
          eye view of how the land lies all the way up to where the Mountains
          of Mourne sweep down to the sea.
        </p>
      </blockquote>
      <figcaption>Visit Mourne Gullion Strangford · Arley House</figcaption>
    </figure>

    <section class="ah-walk" id="walk" aria-labelledby="ah-walk-title">
      <p class="ah-kicker">A walk from the road</p>
      <h2 id="ah-walk-title">Down the village, then out if you choose.</h2>
      <ol class="ah-path">
        {walk.map((stop) => (
          <li class="ah-stop">
            <span class="ah-stop-mark" aria-hidden="true">{stop.mark}</span>
            <div class="ah-stop-body">
              <h3>{stop.place}</h3>
              <p>{stop.line}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="ah-holds" id="house" aria-labelledby="ah-holds-title">
      <p class="ah-kicker">At the end of the walk</p>
      <h2 id="ah-holds-title">What the house holds</h2>
      <ul class="ah-inventory">
        {holds.map((item) => (
          <li>
            <span>{item.name}</span>
            <span>{item.line}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="ah-pad" id="enquire" aria-labelledby="ah-pad-title">
      <p class="ah-kicker">The number</p>
      <h2 id="ah-pad-title">Ring the house.</h2>
      <p class="ah-pad-lead">
        14 Belfast Road, Dundrum, BT33 0NG. Write the words, then call.
        This page does not send a message.
      </p>

      <div class="ah-phone-face">
        <a class="ah-dial" href={phoneHref}>{phone}</a>
        <p class="ah-dial-hint">Family-run bed and breakfast</p>

        <form class="ah-script-form" data-ah-request>
          <label for="ah-who">Your name</label>
          <input id="ah-who" name="name" type="text" autocomplete="name" required />

          <label for="ah-when">Nights you have in mind</label>
          <input id="ah-when" name="when" type="text" placeholder="12–14 September" />

          <fieldset>
            <legend>Who is coming</legend>
            <label><input type="radio" name="ah-who-with" value="just us" checked /> Just us</label>
            <label><input type="radio" name="ah-who-with" value="with a dog" /> With a dog</label>
            <label><input type="radio" name="ah-who-with" value="with a child" /> With a child</label>
          </fieldset>

          <label for="ah-notes">Anything we should know</label>
          <textarea id="ah-notes" name="notes" rows="3"></textarea>

          <button type="submit">Write the words for the call</button>

          <div class="ah-handoff" data-ah-handoff role="status" hidden tabindex="-1">
            <strong>Say this when they answer:</strong>
            <pre data-ah-script></pre>
            <a href={phoneHref}>Call {phone}</a>
          </div>
        </form>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      var form = document.querySelector("[data-ah-request]");
      if (!form) return;
      var handoff = form.querySelector("[data-ah-handoff]");
      var scriptEl = form.querySelector("[data-ah-script]");
      if (!handoff || !scriptEl) return;

      form.addEventListener("submit", function (event) {
        event.preventDefault();
        if (!form.reportValidity()) return;
        var name = form.querySelector("#ah-who").value.trim();
        var when = form.querySelector("#ah-when").value.trim();
        var notes = form.querySelector("#ah-notes").value.trim();
        var chosen = form.querySelector('input[name="ah-who-with"]:checked');
        var who = chosen ? chosen.value : "just us";
        scriptEl.textContent = [
          "Hello, my name is " + name + ".",
          when ? "I am hoping to stay " + when + "." : "I would like to ask about a stay.",
          "It would be " + who + ".",
          notes || ""
        ].filter(Boolean).join("\n");
        handoff.hidden = false;
        handoff.focus();
      });
    })();
  </script>
</ConceptLayout>
