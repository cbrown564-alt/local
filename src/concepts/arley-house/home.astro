---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

const phone = "028 4375 0949";
const phoneHref = "tel:+442843750949";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,500;0,600;1,500&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap";

const ritual = [
  {
    when: "On the road",
    do: "You are already on the A24/A2 — the Belfast to Newcastle road. The house is 14 Belfast Road, Dundrum.",
  },
  {
    when: "In the village",
    do: "Perfectly placed for a rest, a walk, or just passing through. Restaurants and pubs are a short walk.",
  },
  {
    when: "Either side of the house",
    do: "Two award-winning beaches sit on either side of Dundrum. Climb Dundrum Castle for a bird’s-eye view of how the land lies, all the way to where the Mountains of Mourne sweep down to the sea.",
  },
  {
    when: "When you want the rest of the coast",
    do: "Golf at Ardglass, Kilkeel and Royal County Down. Newcastle when you want it — not before.",
  },
];

const facilities = [
  { name: "Dogs", line: "Welcome inside and outside." },
  { name: "TV and games room", line: "A room in the house for an evening in." },
  { name: "Ground-floor bedrooms", line: "If the stairs are not for you." },
  { name: "Cot and highchair", line: "For a stay with a very small guest." },
  { name: "Parking, wifi, laundry", line: "On site, as listed." },
  { name: "Tea and coffee", line: "In the rooms." },
];
---

<ConceptLayout
  title={"Arley House — independent concept"}
  slug="arley-house"
  bodyClass="concept-page concept-arley"
  businessName="Arley House"
  town="Dundrum"
  fontHref={fontHref}
  bannerNote="The village plate is drawn, not a photo."
>
  <div class="ah-strip">
    <span>14 Belfast Road, Dundrum, BT33 0NG · A24/A2</span>
    <span class="ah-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="ah-header">
    <a class="ah-brand" href="/concepts/arley-house/">
      <span class="ah-brand-mark" aria-hidden="true">
        <svg width="28" height="30" viewBox="0 0 28 30" fill="none">
          <path d="M4 26V14L14 6l10 8v12H4Z" stroke="currentColor" stroke-width="1.6"/>
          <path d="M11 26v-7h6v7" stroke="currentColor" stroke-width="1.6"/>
        </svg>
      </span>
      <span class="ah-brand-text">
        <span class="ah-brand-name">Arley House</span>
        <span class="ah-brand-sub">Bed and breakfast · Dundrum</span>
      </span>
    </a>
    <nav class="ah-nav" aria-label="Concept navigation">
      <a href="#village">The village</a>
      <a href="#house">The house</a>
      <a href="#enquire">Enquire</a>
    </nav>
    <a class="ah-book" href="#enquire">Ask about nights</a>
  </header>

  <main class="ah-main">
    <div class="ah-top">
      <section class="ah-lede">
        <p class="ah-eyebrow">Family-run B&amp;B on the A24/A2</p>
        <h1>Dundrum first.<br />Newcastle when you want it.</h1>
        <p class="ah-say">Two beaches either side. The castle a short walk.</p>
        <p class="ah-body">
          A family-run bed and breakfast at 14 Belfast Road, Dundrum, on the
          main Belfast to Newcastle road. Perfectly placed for a rest, a walk,
          or just passing through.
        </p>
        <p class="ah-lede-cta">
          <a class="ah-book ah-book--inline" href="#enquire">Ask about nights</a>
          <a class="ah-phone-link" href={phoneHref}>Or call {phone}</a>
        </p>
      </section>

      <form class="ah-request" id="enquire" data-ah-request aria-labelledby="ah-request-title">
        <h2 id="ah-request-title">Ask about a stay</h2>
        <p class="ah-request-sub">
          Write what you need, then ring the house. We have not put rates or
          a diary here.
        </p>

        <div class="ah-field">
          <label for="ah-who">Your name</label>
          <input id="ah-who" name="name" type="text" autocomplete="name" placeholder="First and last" required />
        </div>
        <div class="ah-field">
          <label for="ah-when">Nights you have in mind</label>
          <input id="ah-when" name="when" type="text" placeholder="12–14 September" />
        </div>
        <fieldset class="ah-field ah-field--choice">
          <legend>Who is coming</legend>
          <label><input type="radio" name="ah-who-with" value="just us" checked /> <span>Just us</span></label>
          <label><input type="radio" name="ah-who-with" value="with a dog" /> <span>With a dog</span></label>
          <label><input type="radio" name="ah-who-with" value="with a child" /> <span>With a child</span></label>
        </fieldset>
        <div class="ah-field">
          <label for="ah-notes">Anything we should know</label>
          <textarea id="ah-notes" name="notes" rows="3"></textarea>
        </div>

        <button class="ah-submit" type="submit">Prepare my request</button>

        <div class="ah-handoff" data-ah-handoff role="status" hidden tabindex="-1">
          <strong>Ring {phone} and say:</strong>
          <pre data-ah-script></pre>
          <a href={phoneHref}>Call now</a>
        </div>
        <p class="ah-stale" data-ah-stale role="status" hidden>
          Your details changed. Press <strong>Prepare my request</strong> again so
          the words match what you typed.
        </p>

        <p class="ah-request-foot">
          This page does not send a message. It only writes the words for the
          call. Ring <a href={phoneHref}>{phone}</a>.
        </p>
      </form>
    </div>

    <blockquote class="ah-voice">
      <p>
        “If it's the beach you like, we have 2 award winning beaches on either
        side of us… climbing the historic Dundrum Castle gives you a bird's
        eye view of how the land lies all the way up to where the Mountains
        of Mourne sweep down to the sea.”
      </p>
      <footer>Arley House · Visit Mourne Gullion Strangford</footer>
    </blockquote>

    <section class="ah-ritual" id="village" aria-labelledby="ah-ritual-title">
      <div class="ah-section-head">
        <p class="ah-eyebrow">A stay in the village</p>
        <h2 id="ah-ritual-title">The road, the beaches, the castle — then the coast if you want it.</h2>
        <p class="ah-intro">
          Dundrum is the place. Newcastle is a later choice. That is the order
          they write.
        </p>
      </div>
      <ol class="ah-steps">
        {ritual.map((entry) => (
          <li class="ah-step">
            <p class="ah-step-when">{entry.when}</p>
            <p class="ah-step-do">{entry.do}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="ah-house" id="house" aria-labelledby="ah-house-title">
      <div class="ah-section-head">
        <p class="ah-eyebrow">What the house holds</p>
        <h2 id="ah-house-title">Dogs inside. A games room. A ground-floor bedroom if you need one.</h2>
        <p class="ah-intro">Facilities as listed on the official Visit Mourne page.</p>
      </div>
      <ul class="ah-hold">
        {facilities.map((item) => (
          <li class="ah-hold-item">
            <p class="ah-hold-name">{item.name}</p>
            <p class="ah-hold-line">{item.line}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="ah-plate-wrap" aria-labelledby="ah-plate-title">
      <div class="ah-section-head">
        <p class="ah-eyebrow">How the land lies</p>
        <h2 id="ah-plate-title">A24/A2, two beaches, the castle.</h2>
        <p class="ah-intro">
          A drawn plate of the village — not a photograph of the house.
        </p>
      </div>
      <figure class="ah-plate">
        <svg viewBox="0 0 920 340" role="img" aria-label="Drawn plate of Dundrum: A24/A2, two beaches, Dundrum Castle">
          <rect width="920" height="340" fill="#e8dfc8"/>
          <rect x="0" y="0" width="920" height="92" fill="#c5d4c8"/>
          <path d="M0 78 Q160 48 320 70 T640 56 T920 68 L920 120 L0 120 Z" fill="#9bb3a4"/>
          <text x="460" y="36" text-anchor="middle" font-size="13" fill="#3a4034" font-family="Georgia, serif">Mountains of Mourne</text>
          <path d="M0 196 Q220 168 460 198 T920 176 L920 340 L0 340 Z" fill="#d4c4a4"/>
          <path d="M0 248 Q180 228 360 252 T920 236 L920 340 L0 340 Z" fill="#b9c9b8"/>
          <ellipse cx="150" cy="268" rx="118" ry="28" fill="#7a9a9a"/>
          <ellipse cx="780" cy="272" rx="118" ry="28" fill="#7a9a9a"/>
          <text x="150" y="274" text-anchor="middle" font-size="12" fill="#f4efe4">beach</text>
          <text x="780" y="278" text-anchor="middle" font-size="12" fill="#f4efe4">beach</text>
          <rect x="40" y="148" width="840" height="14" fill="#8a7358"/>
          <rect x="40" y="152" width="840" height="4" fill="#c4b08a"/>
          <text x="460" y="142" text-anchor="middle" font-size="13" fill="#3a4034">A24 / A2 · Belfast Road</text>
          <rect x="430" y="108" width="56" height="40" fill="#6a4a32"/>
          <polygon points="430,108 458,86 486,108" fill="#4e3424"/>
          <rect x="448" y="124" width="12" height="24" fill="#2c2218"/>
          <text x="458" y="196" text-anchor="middle" font-size="12" fill="#3a4034">14 Belfast Road</text>
          <path d="M620 118 L638 78 L656 118 Z" fill="#5c4634"/>
          <rect x="628" y="118" width="20" height="28" fill="#6e5340"/>
          <text x="638" y="162" text-anchor="middle" font-size="11" fill="#3a4034">Castle</text>
          <text x="80" y="164" font-size="11" fill="#f4efe4">Belfast</text>
          <text x="820" y="164" text-anchor="end" font-size="11" fill="#f4efe4">Newcastle</text>
        </svg>
        <figcaption>
          Drawn geography of Dundrum: the road through the village, beaches
          either side, the castle above the inlet.
        </figcaption>
      </figure>
    </section>

    <section class="ah-close" aria-labelledby="ah-close-title">
      <div class="ah-section-head">
        <p class="ah-eyebrow">The door</p>
        <h2 id="ah-close-title">The house answers the phone.</h2>
      </div>
      <ul class="ah-close-list">
        <li>14 Belfast Road, Dundrum, BT33 0NG</li>
        <li><a href={phoneHref}>{phone}</a></li>
        <li>Family-run bed and breakfast on the A24/A2</li>
      </ul>
    </section>
  </main>

  <script is:inline>
    (function () {
      var form = document.querySelector("[data-ah-request]");
      if (!form) return;

      var handoff = form.querySelector("[data-ah-handoff]");
      var stale = form.querySelector("[data-ah-stale]");
      var scriptEl = form.querySelector("[data-ah-script]");
      if (!handoff || !scriptEl) return;

      form.addEventListener("input", function () {
        if (handoff.hidden) return;
        handoff.hidden = true;
        if (stale) stale.hidden = false;
      });

      form.addEventListener("submit", function (event) {
        event.preventDefault();
        if (!form.reportValidity()) return;

        var name = form.querySelector("#ah-who").value.trim();
        var when = form.querySelector("#ah-when").value.trim();
        var notes = form.querySelector("#ah-notes").value.trim();
        var chosen = form.querySelector('input[name="ah-who-with"]:checked');
        var who = chosen ? chosen.value : "just us";

        scriptEl.textContent = [
          "Hello, my name is " + name + ".",
          when ? "I am hoping to stay " + when + "." : "I would like to ask about a stay.",
          "It would be " + who + ".",
          notes || ""
        ].filter(Boolean).join("\n");

        handoff.hidden = false;
        if (stale) stale.hidden = true;
        handoff.focus();
      });
    })();
  </script>
</ConceptLayout>
