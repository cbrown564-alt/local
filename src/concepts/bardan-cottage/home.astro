---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import HousePlan from "./HousePlan.astro";

/* Bardan Cottage Newcastle — day care on Bryansford Avenue.
   12 Bryansford Avenue, Newcastle, BT33 0AX.
   Phone: 028 4372 3853 · Email: newcastle@bardancottage.com.
   Five areas plus a garden, as published on bardancottage.com/newcastle/. */

const phone = "028 4372 3853";
const phoneHref = "tel:+442843723853";
const email = "newcastle@bardancottage.com";
const mailto = `mailto:${email}`;
const site = "https://www.bardancottage.com/newcastle/";
const maps =
  "https://www.google.com/maps/search/?api=1&query=12+Bryansford+Avenue+Newcastle+BT33+0AX";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,400;0,6..12,600;0,6..12,700;1,6..12,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,500;0,8..60,600;1,8..60,500&display=swap";

const rooms = [
  {
    name: "Main Lounge",
    focus: "Company",
    desc: "A comfortable lounge where guests can socialise and enjoy the craic with their new friends.",
  },
  {
    name: "Dining Room",
    focus: "Home-cooked food",
    desc: "A spacious dining room for home-cooked food, a choice of drinks, and company at the table.",
  },
  {
    name: "Library",
    focus: "A quiet room",
    desc: "The tranquil library — a quiet room with a selection of literature, or simply a place to take some time out.",
  },
  {
    name: "Wet Activity Room",
    focus: "Making things",
    desc: "Outcome-based activities including beauty sessions, painting, jewellery making, seasonal card making and decorations, and craft work.",
  },
  {
    name: "Dry Activity Room",
    focus: "Film and computers",
    desc: "The dry activity and movie room, for a film on the big screen or brushing up on computer skills.",
  },
  {
    name: "Garden",
    focus: "Raised flower beds",
    desc: "A garden with raised flower beds, where guests can get their green fingers going, weather permitting.",
  },
];

const carePillars = [
  {
    title: "Independence and company",
    desc: "The centre is planned around encouraging independence, combating isolation and promoting early intervention.",
  },
  {
    title: "A house planned for the people in it",
    desc: "Layout, decoration, lighting and orientation were chosen to help, rather than aggravate, guests who live with dementia, poor eyesight, poor hearing and other conditions.",
  },
  {
    title: "Five areas and a garden",
    desc: "The building is split into five areas — wet and dry activity rooms, lounge, library and dining room — plus a garden, so the day has more than one place to be.",
  },
];
---

<ConceptLayout
  title={"Bardan Cottage Newcastle — independent concept"}
  slug="bardan-cottage"
  bodyClass="concept-page concept-bardan-cottage"
  lang="en-GB"
  businessName="Bardan Cottage"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The house plan is a drawing."
>
  <div class="bc-strip">
    <span>12 Bryansford Avenue, Newcastle · BT33 0AX · Day care</span>
    <span class="bc-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="bc-header">
    <a class="bc-brand" href="/concepts/bardan-cottage/">
      <span class="bc-brand-mark" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 44 44" fill="none">
          <rect width="44" height="44" rx="4" fill="#f3ebe1"/>
          <path d="M6 28 L22 12 L38 28" fill="none" stroke="#5a4638" stroke-width="1.8"/>
          <rect x="11" y="28" width="22" height="10" rx="1" fill="#7a9a78" stroke="#5a4638" stroke-width="1.2"/>
          <rect x="19" y="31" width="6" height="7" fill="#f3ebe1"/>
          <circle cx="33" cy="18" r="3" fill="#c4a574" opacity="0.8"/>
        </svg>
      </span>
      <span class="bc-brand-text">
        <span class="bc-brand-name">Bardan Cottage</span>
        <span class="bc-brand-sub">Newcastle · Day care</span>
      </span>
    </a>
    <nav class="bc-nav" aria-label="Bardan Cottage">
      <a href="#plan">House Plan</a>
      <a href="#rooms">Rooms &amp; Garden</a>
      <a href="#care">Our Approach</a>
      <a href="#visit">Visit Us</a>
    </nav>
    <a class="bc-call-btn" href={phoneHref}>Call the Cottage</a>
  </header>

  <main class="bc-main">
    <section class="bc-hero" aria-labelledby="bc-name">
      <div class="bc-hero-copy">
        <span class="bc-kicker">Day care · Bryansford Avenue</span>
        <h1 id="bc-name">Bardan Cottage</h1>
        <p class="bc-place">12 Bryansford Avenue · Newcastle · BT33 0AX</p>
        <p class="bc-say">A day care centre that feels like a house.</p>
        <p class="bc-lede">
          Day care on Bryansford Avenue — five activity areas, a dining room for home-cooked food, and a garden with raised beds.
          The house was planned around independence, company, and the needs of older people in the community, including people with dementia.
        </p>
        <div class="bc-hero-actions">
          <a class="bc-btn bc-btn--primary" href={phoneHref}>Telephone {phone}</a>
          <a class="bc-btn bc-btn--outline" href={mailto}>Email the Newcastle house</a>
        </div>
      </div>

      <div class="bc-hero-plan">
        <HousePlan headingId="bc-name" />
      </div>
    </section>

    <section class="bc-plan-section" id="plan" aria-labelledby="bc-plan-title">
      <div class="bc-section-head">
        <span class="bc-kicker">The Layout</span>
        <h2 id="bc-plan-title">Five areas and a garden</h2>
        <p class="bc-section-intro">
          The layout and decoration of the Newcastle house were planned with older people and people with dementia in mind — environment, lighting and orientation first.
        </p>
      </div>

      <div class="bc-rooms-grid" id="rooms">
        {rooms.map((room) => (
          <article class="bc-room-card">
            <span class="bc-room-focus">{room.focus}</span>
            <h3>{room.name}</h3>
            <p>{room.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="bc-care-section" id="care" aria-labelledby="bc-care-title">
      <div class="bc-care-wrapper">
        <div class="bc-section-head">
          <span class="bc-kicker bc-kicker--gold">The house</span>
          <h2 id="bc-care-title">Independence, company, and a house that helps</h2>
          <p class="bc-section-intro">
            What the Newcastle page publishes about the house, in the house's own words and rooms.
          </p>
        </div>

        <div class="bc-care-grid">
          {carePillars.map((pillar) => (
            <div class="bc-care-card">
              <h3>{pillar.title}</h3>
              <p>{pillar.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bc-visit-section" id="visit" aria-labelledby="bc-visit-title">
      <div class="bc-visit-card">
        <div class="bc-visit-info">
          <span class="bc-kicker">Get in touch</span>
          <h2 id="bc-visit-title">Ring or write to the Newcastle house</h2>
          <p class="bc-visit-intro">
            To ask about a day at the Newcastle house, telephone or email. Fees and referral are best taken up directly with the team.
          </p>

          <div class="bc-visit-steps">
            <div class="bc-visit-step">
              <span class="bc-step-num">01</span>
              <div>
                <h4>Telephone</h4>
                <p>Ring the Newcastle house on {phone}.</p>
              </div>
            </div>
            <div class="bc-visit-step">
              <span class="bc-step-num">02</span>
              <div>
                <h4>Email</h4>
                <p>Write to {email}.</p>
              </div>
            </div>
            <div class="bc-visit-step">
              <span class="bc-step-num">03</span>
              <div>
                <h4>Find us</h4>
                <p>12 Bryansford Avenue, Newcastle, BT33 0AX. There are also houses in Dunmurry and Newry.</p>
              </div>
            </div>
          </div>

          <div class="bc-visit-actions">
            <a class="bc-btn bc-btn--primary" href={phoneHref}>Call {phone}</a>
            <a class="bc-btn bc-btn--outline" href={mailto}>{email}</a>
          </div>
        </div>

        <address class="bc-address-card">
          <strong>Bardan Cottage Newcastle</strong>
          <span>12 Bryansford Avenue</span>
          <span>Newcastle, County Down</span>
          <span>BT33 0AX</span>
          <a class="bc-phone-link" href={phoneHref}>{phone}</a>
          <a class="bc-email-link" href={mailto}>{email}</a>
          <p class="bc-sister-note">
            Sister day care locations also open in Dunmurry and Newry.
          </p>
          <a class="bc-site-link" href={maps} rel="noopener noreferrer">Find 12 Bryansford Avenue</a>
          <a class="bc-site-link" href={site} rel="noopener noreferrer">bardancottage.com/newcastle</a>
        </address>
      </div>
    </section>
  </main>

  <footer class="bc-footer">
    <p class="bc-footer-name">Bardan Cottage Newcastle</p>
    <p>12 Bryansford Avenue, Newcastle · Day care</p>
  </footer>
</ConceptLayout>
