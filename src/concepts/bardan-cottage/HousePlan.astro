---
/* Drawn five-room + garden house plan for 12 Bryansford Avenue.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
interface Props {
  headingId?: string;
}
const { headingId = "bc-plan-title" } = Astro.props;
---

<figure class="bc-plan-fig" aria-labelledby={headingId}>
  <svg
    class="bc-plan-svg"
    viewBox="0 0 640 420"
    role="img"
    aria-label="Drawn house plan of Bardan Cottage Newcastle showing wet and dry activity rooms, lounge, library, dining room and garden with raised beds"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect width="640" height="420" fill="#f7f1ea"/>
    <rect x="24" y="24" width="592" height="372" fill="#fff" stroke="#5a4638" stroke-width="2" rx="2"/>

    <!-- Outer rooms -->
    <g fill="#f3ebe1" stroke="#5a4638" stroke-width="1.4">
      <rect x="40" y="40" width="170" height="140"/>
      <rect x="210" y="40" width="200" height="140"/>
      <rect x="410" y="40" width="190" height="140"/>
      <rect x="40" y="180" width="170" height="120"/>
      <rect x="210" y="180" width="200" height="120"/>
      <rect x="410" y="180" width="190" height="200"/>
    </g>

    <!-- Garden hatch -->
    <defs>
      <pattern id="bc-beds" width="28" height="16" patternUnits="userSpaceOnUse">
        <rect width="28" height="16" fill="#dce8d4"/>
        <path d="M0 16h28M14 0v16" stroke="#7a9a78" stroke-width="0.8" opacity="0.6"/>
      </pattern>
    </defs>
    <rect x="40" y="300" width="370" height="80" fill="url(#bc-beds)" stroke="#5a4638" stroke-width="1.4"/>

    <g fill="#5a4638" font-family="Source Serif 4, Georgia, serif" font-size="15" font-weight="600">
      <text x="125" y="110" text-anchor="middle">Wet Activity</text>
      <text x="310" y="110" text-anchor="middle">Dry Activity</text>
      <text x="505" y="110" text-anchor="middle">Main Lounge</text>
      <text x="125" y="245" text-anchor="middle">Library</text>
      <text x="310" y="245" text-anchor="middle">Dining</text>
      <text x="505" y="270" text-anchor="middle">Hall</text>
      <text x="225" y="345" text-anchor="middle">Garden · raised beds</text>
    </g>

    <g fill="#7a6a5c" font-family="Nunito Sans, Segoe UI, sans-serif" font-size="10" font-weight="700" letter-spacing="1.2">
      <text x="125" y="128" text-anchor="middle">HANDS-ON</text>
      <text x="310" y="128" text-anchor="middle">MOVIE / MAKING</text>
      <text x="505" y="128" text-anchor="middle">COMPANY</text>
      <text x="125" y="262" text-anchor="middle">QUIET</text>
      <text x="310" y="262" text-anchor="middle">HOME-COOKED</text>
    </g>

    <!-- Door tick on dining -->
    <path d="M300 300 v-12" stroke="#c4a574" stroke-width="3"/>
    <text x="520" y="390" text-anchor="middle" fill="#7a6a5c" font-family="Nunito Sans, Segoe UI, sans-serif" font-size="11" font-weight="700" letter-spacing="1.5">12 BRYANSFORD AVENUE</text>
  </svg>
</figure>
