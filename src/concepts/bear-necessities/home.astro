---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

const phone = "07887 905 025";
const phoneHref = "tel:+447887905025";
const email = "bearnecessitieskids@gmail.com";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&display=swap";

const beats = [
  {
    id: "choose",
    beat: "I",
    title: "Choose",
    line: "Little Ted (10\"), Big Ted (16\"), or a licensed Care Bear — one for each child.",
  },
  {
    id: "machine",
    beat: "II",
    title: "Machine",
    line: "They are not hand stuffed. The stuffing machine is the experience.",
  },
  {
    id: "heart",
    beat: "III",
    title: "Heart",
    line: "A heart insert goes in before the bear is closed.",
  },
  {
    id: "certificate",
    beat: "IV",
    title: "Certificate",
    line: "An adoption certificate leaves with the bear and its name.",
  },
];

const tickets = [
  {
    pack: "Little Ted",
    size: "10-inch",
    price: "£10.50",
    per: "per child",
    hole: "A",
  },
  {
    pack: "Big Ted",
    size: "16-inch",
    price: "£15.99",
    per: "per child",
    hole: "B",
  },
  {
    pack: "Care Bear",
    size: "licensed 16-inch",
    price: "£16.99",
    per: "per child",
    hole: "C",
  },
];
---

<ConceptLayout
  title={"Bear Necessities — independent concept"}
  slug="bear-necessities"
  bodyClass="concept-page concept-bear"
  businessName="Bear Necessities"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The machine on this first screen is a drawn SVG. Siobhan's prices as published August 2026."
>
  <div class="bn-wonder" id="top">
    <p class="bn-wonder-mark">
      <a href="/concepts/bear-necessities/">Bear Necessities</a>
      <span>Siobhan Rice · since 2016 · Newcastle, County Down</span>
    </p>
    <a class="bn-wonder-ring" href={phoneHref}>{phone}</a>

    <div class="bn-wonder-stage" aria-hidden="false">
      <svg class="bn-wonder-svg" viewBox="0 0 1440 820" role="img" aria-label="Drawn stuffing machine, an open teddy, and a heart dropping in">
        <defs>
          <linearGradient id="bnHoney" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#fff3c4"/>
            <stop offset="55%" stop-color="#f6c85c"/>
            <stop offset="100%" stop-color="#e89a2a"/>
          </linearGradient>
          <pattern id="bnHex" width="48" height="42" patternUnits="userSpaceOnUse">
            <path d="M24 1l20 10.5v21L24 43 4 32.5v-21Z" fill="none" stroke="#c9842a" stroke-opacity=".18" stroke-width="1.4"/>
          </pattern>
        </defs>
        <rect width="1440" height="820" fill="url(#bnHoney)"/>
        <rect width="1440" height="820" fill="url(#bnHex)"/>

        <!-- machine body -->
        <g transform="translate(780,210)">
          <rect x="0" y="40" width="380" height="340" rx="18" fill="#6b3f1a" stroke="#3a1f0c" stroke-width="6"/>
          <rect x="28" y="70" width="324" height="180" rx="10" fill="#f2d48a" stroke="#3a1f0c" stroke-width="4"/>
          <circle cx="190" cy="160" r="62" fill="#fff8e4" stroke="#3a1f0c" stroke-width="5"/>
          <path d="M160 160h60M190 130v60" stroke="#3a1f0c" stroke-width="8" stroke-linecap="round"/>
          <rect x="48" y="270" width="80" height="28" rx="6" fill="#d9480f"/>
          <rect x="148" y="270" width="80" height="28" rx="6" fill="#2b8a3e"/>
          <rect x="248" y="270" width="80" height="28" rx="6" fill="#1c7ed6"/>
          <rect x="40" y="390" width="70" height="90" rx="8" fill="#4a2a12"/>
          <rect x="270" y="390" width="70" height="90" rx="8" fill="#4a2a12"/>
          <path d="M-40 120h40" stroke="#3a1f0c" stroke-width="14" stroke-linecap="round"/>
          <circle cx="-52" cy="120" r="22" fill="#c92a2a" stroke="#3a1f0c" stroke-width="4"/>
        </g>

        <!-- open bear -->
        <g transform="translate(220,250)">
          <ellipse cx="210" cy="280" rx="150" ry="170" fill="#c9842a" stroke="#5a3a16" stroke-width="6"/>
          <circle cx="120" cy="120" r="68" fill="#c9842a" stroke="#5a3a16" stroke-width="6"/>
          <circle cx="300" cy="120" r="68" fill="#c9842a" stroke="#5a3a16" stroke-width="6"/>
          <ellipse cx="210" cy="200" rx="118" ry="108" fill="#e8b86d" stroke="#5a3a16" stroke-width="5"/>
          <ellipse cx="210" cy="300" rx="70" ry="86" fill="#f6e3b8"/>
          <circle cx="168" cy="188" r="10" fill="#3a1f0c"/>
          <circle cx="252" cy="188" r="10" fill="#3a1f0c"/>
          <ellipse cx="210" cy="228" rx="18" ry="12" fill="#8a4b12"/>
        </g>

        <!-- dropping heart -->
        <g class="bn-heart-drop">
          <path d="M720 90c-28 0-48 22-48 48 0 46 48 78 48 78s48-32 48-78c0-26-20-48-48-48z" fill="#b42318" stroke="#5a1010" stroke-width="4"/>
        </g>

        <!-- title as the machine, not a clinic h1 -->
        <text x="72" y="118" font-family="Baloo 2, cursive" font-size="86" font-weight="800" fill="#3a1f0c">STUFFING</text>
        <text x="72" y="198" font-family="Baloo 2, cursive" font-size="86" font-weight="800" fill="#3a1f0c">MACHINE</text>
      </svg>
    </div>

    <p class="bn-wonder-line">
      Siobhan brings the machine, the hearts, and the certificates — a birthday hall, a school, a living-room floor.
    </p>
    <p class="bn-wonder-jump">
      <a href="#storyboard">Play the four beats</a>
      <a href="#invite">Ask for a Saturday</a>
    </p>
  </div>

  <section class="bn-storyboard" id="storyboard" aria-labelledby="bn-story-title">
    <header class="bn-story-head">
      <p class="bn-kicker">The stuffing ritual</p>
      <h2 id="bn-story-title">Four beats. One bear.</h2>
      <p>
        Are bears are all stuffed with the use of our teddy bear stuffing machine.
        <strong>THEY ARE NOT HAND STUFFED.</strong>
        Interactive: a heart insert and an adoption certificate for your bear.
      </p>
    </header>
    <div class="bn-reel" tabindex="0" role="region" aria-label="Scrollable stuffing storyboard">
      {beats.map((b) => (
        <article class={`bn-cell bn-cell-${b.id}`} id={`beat-${b.id}`}>
          <p class="bn-roman">{b.beat}</p>
          <h3>{b.title}</h3>
          <svg viewBox="0 0 280 160" aria-hidden="true">
            {b.id === "choose" && (
              <g>
                <ellipse cx="70" cy="100" rx="36" ry="42" fill="#c9842a" stroke="#5a3a16" stroke-width="3"/>
                <ellipse cx="140" cy="88" rx="48" ry="56" fill="#c9842a" stroke="#5a3a16" stroke-width="3"/>
                <ellipse cx="220" cy="88" rx="48" ry="56" fill="#5c7cfa" stroke="#2b3a8a" stroke-width="3"/>
              </g>
            )}
            {b.id === "machine" && (
              <g>
                <rect x="80" y="28" width="120" height="110" rx="8" fill="#6b3f1a" stroke="#3a1f0c" stroke-width="3"/>
                <circle cx="140" cy="78" r="28" fill="#f2d48a" stroke="#3a1f0c" stroke-width="3"/>
              </g>
            )}
            {b.id === "heart" && (
              <path d="M140 36c-22 0-38 18-38 38 0 36 38 62 38 62s38-26 38-62c0-20-16-38-38-38z" fill="#b42318"/>
            )}
            {b.id === "certificate" && (
              <g>
                <rect x="70" y="28" width="140" height="104" rx="4" fill="#fffaf0" stroke="#5a3a16" stroke-width="3"/>
                <text x="140" y="78" text-anchor="middle" font-size="14" fill="#5a3a16">ADOPTION</text>
                <text x="140" y="100" text-anchor="middle" font-size="12" fill="#8a6230">certificate</text>
              </g>
            )}
          </svg>
          <p>{b.line}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bn-counter" id="packs" aria-labelledby="bn-counter-title">
    <p class="bn-kicker">Party packs</p>
    <h2 id="bn-counter-title">Tear a ticket.</h2>
    <p class="bn-counter-note">Package prices as published on Bear Necessities' own pages, August 2026.</p>
    <ul class="bn-tickets">
      {tickets.map((t) => (
        <li class="bn-ticket">
          <span class="bn-punch" aria-hidden="true">{t.hole}</span>
          <div class="bn-ticket-body">
            <h3>{t.pack}</h3>
            <p class="bn-ticket-size">{t.size}</p>
            <p class="bn-ticket-price">{t.price}</p>
            <p class="bn-ticket-per">{t.per}</p>
          </div>
          <span class="bn-perf" aria-hidden="true" />
        </li>
      ))}
    </ul>
    <p class="bn-extra">
      Sand art can ride with the bear: from £10 a child for an A4, or £3.50 as a small oval extra.
    </p>
  </section>

  <section class="bn-road" id="travel" aria-labelledby="bn-road-title">
    <div class="bn-tarmac">
      <svg class="bn-van" viewBox="0 0 220 90" aria-hidden="true">
        <rect x="8" y="28" width="130" height="42" rx="8" fill="#fff3c4" stroke="#3a1f0c" stroke-width="3"/>
        <path d="M138 36h42l18 20v14h-60z" fill="#f6c85c" stroke="#3a1f0c" stroke-width="3"/>
        <circle cx="48" cy="74" r="12" fill="#3a1f0c"/>
        <circle cx="168" cy="74" r="12" fill="#3a1f0c"/>
        <text x="70" y="54" font-size="11" fill="#3a1f0c">BN</text>
      </svg>
      <div class="bn-road-copy">
        <p class="bn-kicker">We travel</p>
        <h2 id="bn-road-title">Did you know we travel, to your choice of venue!</h2>
        <p>
          That line is Siobhan's. Groups need twelve guests or more. A local call-out starts at £35.
          Offers and competitions live on Facebook — that is her ask.
        </p>
        <p>
          <a href="https://www.facebook.com/Bearnecessitiespartyvenue">Today's offers on Facebook</a>
        </p>
      </div>
    </div>
  </section>

  <section class="bn-invite" id="invite" aria-labelledby="bn-invite-title">
    <div class="bn-envelope">
      <p class="bn-kicker">You're invited</p>
      <h2 id="bn-invite-title">A Saturday, a count, a hall.</h2>
      <p>
        This is a party invitation to Siobhan, not a booking engine. There is no live diary on this page.
        Opens a draft to {email}.
      </p>
      <form class="bn-rsvp" id="book">
        <label>Your name
          <input id="bn-name" required autocomplete="name" />
        </label>
        <label>What you need
          <select id="bn-kind">
            <option>A party we travel to</option>
            <option>A school or church group</option>
            <option>A party-at-home pack</option>
            <option>Bears and outfits from the shop</option>
          </select>
        </label>
        <label>Date you have in mind
          <input id="bn-date" type="text" placeholder="e.g. Saturday 12 September" />
        </label>
        <label>About how many children
          <input id="bn-count" type="text" inputmode="numeric" />
        </label>
        <button type="submit">Write the invitation</button>
      </form>
      <div class="bn-sealed" data-bn-handoff hidden>
        <strong>Your invitation is ready.</strong>
        <a data-bn-mail href={`mailto:${email}`}>Open the draft to Siobhan</a>
        <span>Or ring <a href={phoneHref}>{phone}</a>.</span>
      </div>
    </div>
  </section>
  <script is:inline>
    (function () {
      var form = document.getElementById("book");
      if (!form) return;
      var handoff = document.querySelector("[data-bn-handoff]");
      var link = document.querySelector("[data-bn-mail]");
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        if (!form.reportValidity()) return;
        var name = document.getElementById("bn-name").value.trim();
        var kind = document.getElementById("bn-kind").value;
        var date = document.getElementById("bn-date").value.trim();
        var count = document.getElementById("bn-count").value.trim();
        var body = [
          "Hello Siobhan,",
          "",
          "I would like to book: " + kind + ".",
          "Name: " + name,
          date ? "Date: " + date : "",
          count ? "Children: " + count : "",
          "",
          "Please tell me if that Saturday is free.",
        ].filter(Boolean).join("\n");
        link.href =
          "mailto:bearnecessitieskids@gmail.com?subject=" +
          encodeURIComponent("Bear Necessities — " + kind) +
          "&body=" +
          encodeURIComponent(body);
        handoff.hidden = false;
      });
    })();
  </script>
</ConceptLayout>
