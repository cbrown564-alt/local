---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

const phone = "07887 905 025";
const phoneHref = "tel:+447887905025";
const email = "bearnecessitieskids@gmail.com";
const facebook = "https://www.facebook.com/Bearnecessitiespartyvenue";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&display=swap";

const tickets = [
  { pack: "Little Ted", size: "10-inch", price: "£10.50", per: "per child" },
  { pack: "Big Ted", size: "16-inch", price: "£15.99", per: "per child" },
  { pack: "Care Bear", size: "licensed 16-inch", price: "£16.99", per: "per child" },
];
---

<ConceptLayout
  title={"Bear Necessities — Newcastle"}
  slug="bear-necessities"
  bodyClass="concept-page concept-bear"
  businessName="Bear Necessities"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The stuffing machine plate is a generated image, not a photograph of Siobhan's machine. Pack prices as published August 2026."
>
  <main class="bn-page">
    <section class="bn-first" aria-labelledby="bn-name">
      <h1 id="bn-name">Bear Necessities</h1>
      <p class="bn-moment">
        A Saturday, a hall, a count of children — then the machine, the heart,
        the certificate. Siobhan Rice, since 2016. She comes to you.
      </p>
      <p class="bn-price-after">
        Little Ted, Big Ted, Care Bear. Today's offers are on
        <a href={facebook}>Facebook</a>.
      </p>
    </section>

    <figure class="bn-stage">
      <img
        src="/media/concepts/bear-necessities/machine.jpg"
        alt="A teddy on a workbench beside a stuffing machine, a felt heart ready to go in"
        width="1536"
        height="1024"
      />
      <figcaption>The stuffing moment.</figcaption>
    </figure>

    <section class="bn-how" aria-labelledby="bn-how-title">
      <p class="bn-kicker">Machine · heart · certificate</p>
      <h2 id="bn-how-title">They are not hand stuffed.</h2>
      <p>
        The stuffing machine is the experience. A heart goes in before the bear
        is closed. An adoption certificate leaves with the name.
      </p>
    </section>

    <section class="bn-packs" id="packs" aria-labelledby="bn-packs-title">
      <p class="bn-kicker">The packs</p>
      <h2 id="bn-packs-title">Little Ted, Big Ted, Care Bear.</h2>
      <ul>
        {tickets.map((t) => (
          <li>
            <strong>{t.pack}</strong>
            <span>{t.size}</span>
            <span>{t.price} {t.per}</span>
          </li>
        ))}
      </ul>
      <p>Sand art can ride with the bear. Groups need twelve or more.</p>
    </section>

    <section class="bn-find" aria-labelledby="bn-find-title">
      <p class="bn-kicker">We travel</p>
      <h2 id="bn-find-title">She comes to you.</h2>
      <p>
        A local call-out starts at £35. A birthday hall, a school, a living-room
        floor. Offers and competitions live on the Facebook feed.
      </p>
      <p><a href={facebook}>Today's offers on Facebook</a></p>
    </section>

    <section class="bn-invite" id="invite" aria-labelledby="bn-invite-title">
      <p class="bn-kicker">Saturday and a count</p>
      <h2 id="bn-invite-title">Ask for a Saturday.</h2>
      <p>
        Write the day and how many children. We'll make a note to Siobhan at
        {email} — you send it.
      </p>
      <form class="bn-rsvp" id="book">
        <label>Your name
          <input id="bn-name" required autocomplete="name" />
        </label>
        <label>Saturday you have in mind
          <input id="bn-date" type="text" placeholder="Saturday 12 September" required />
        </label>
        <label>How many children
          <input id="bn-count" type="text" inputmode="numeric" required />
        </label>
        <label>Where she should come
          <input id="bn-where" type="text" placeholder="Hall, school, or home" />
        </label>
        <button type="submit">Write the invitation</button>
      </form>
      <div class="bn-sealed" data-bn-handoff hidden>
        <strong>Your invitation is ready.</strong>
        <a data-bn-mail href={`mailto:${email}`}>Open the draft to Siobhan</a>
        <span>Or ring <a href={phoneHref}>{phone}</a>.</span>
      </div>
    </section>
  </main>
  <script is:inline>
    (function () {
      var form = document.getElementById("book");
      if (!form) return;
      var handoff = document.querySelector("[data-bn-handoff]");
      var link = document.querySelector("[data-bn-mail]");
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        if (!form.reportValidity()) return;
        var name = document.getElementById("bn-name").value.trim();
        var date = document.getElementById("bn-date").value.trim();
        var count = document.getElementById("bn-count").value.trim();
        var where = document.getElementById("bn-where").value.trim();
        var body = [
          "Hello Siobhan,",
          "",
          "I would like you to come to us.",
          "Name: " + name,
          "Saturday: " + date,
          "Children: " + count,
          where ? "Venue: " + where : "",
          "",
          "Please tell me if that Saturday is free.",
        ].filter(Boolean).join("\n");
        link.href =
          "mailto:bearnecessitieskids@gmail.com?subject=" +
          encodeURIComponent("Bear Necessities — Saturday " + date) +
          "&body=" +
          encodeURIComponent(body);
        handoff.hidden = false;
      });
    })();
  </script>
</ConceptLayout>
