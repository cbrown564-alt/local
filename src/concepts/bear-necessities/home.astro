---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

const phone = "07887 905 025";
const phoneHref = "tel:+447887905025";
const email = "bearnecessitieskids@gmail.com";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&display=swap";

const ritual = [
  {
    when: "First",
    title: "Choose your bear",
    line: "Little Ted at 10 inches, Big Ted at 16 inches, or a licensed Care Bear — one for each child.",
  },
  {
    when: "Then",
    title: "The stuffing machine",
    line: "The machine is the experience. They are not hand stuffed.",
  },
  {
    when: "Next",
    title: "A heart goes in",
    line: "Every bear gets a heart insert before it is closed.",
  },
  {
    when: "Last",
    title: "Adoption certificate",
    line: "The bear leaves with a name and a paper that says it is theirs.",
  },
];

const packs = [
  {
    name: "Little Ted",
    size: "10-inch",
    price: "£10.50",
    note: "Per child — the smaller bear, sized for little hands.",
  },
  {
    name: "Big Ted",
    size: "16-inch",
    price: "£15.99",
    note: "Per child — the larger bear for a bigger celebration.",
  },
  {
    name: "Care Bear",
    size: "Licensed 16-inch",
    price: "£16.99",
    note: "Per child — licensed Care Bear, heart and certificate included.",
  },
];
---

<ConceptLayout
  title={"Bear Necessities — independent concept"}
  slug="bear-necessities"
  bodyClass="concept-page concept-bear"
  businessName="Bear Necessities"
  town=""
  fontHref={fontHref}
  bannerNote="The heart plate is a drawn illustration."
>
  <div class="bn-strip">
    <span>Since 2016 · Siobhan Rice · we travel to your venue</span>
    <span class="bn-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="bn-header">
    <a class="bn-brand" href="/concepts/bear-necessities/">
      <span class="bn-brand-mark" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
          <circle cx="8" cy="9" r="4.2" stroke="currentColor" stroke-width="1.7"/>
          <circle cx="20" cy="9" r="4.2" stroke="currentColor" stroke-width="1.7"/>
          <ellipse cx="14" cy="16" rx="8" ry="7.2" stroke="currentColor" stroke-width="1.7"/>
          <path d="M14 13.2c-2.4 0-3.6 2-3.6 3.4 0 2.6 3.6 4.6 3.6 4.6s3.6-2 3.6-4.6c0-1.4-1.2-3.4-3.6-3.4z" fill="currentColor"/>
        </svg>
      </span>
      <span class="bn-brand-text">
        <span class="bn-brand-name">Bear Necessities</span>
        <span class="bn-brand-sub">Teddy bear parties · since 2016</span>
      </span>
    </a>
    <nav class="bn-nav" aria-label="On this page">
      <a href="#ritual">The stuffing</a>
      <a href="#parties">Parties</a>
      <a href="#book">Ask for a date</a>
    </nav>
    <a class="bn-book" href="#book">Ask for a date</a>
  </header>

  <main class="bn-main">
    <div class="bn-top">
      <section class="bn-lede">
        <p class="bn-eyebrow">Siobhan Rice · teddy bear stuffing</p>
        <h1>The machine comes to you.</h1>
        <p class="bn-say">Did you know we travel, to your choice of venue!</p>
        <p class="bn-body">
          A birthday hall, a school, a church hall, a living-room floor. Siobhan
          brings the stuffing machine, the hearts, and the certificates. Twelve
          guests or more. You pick the Saturday.
        </p>
        <p class="bn-lede-cta">
          <a class="bn-book bn-book--inline" href="#book">Ask for a date</a>
          <a class="bn-phone-link" href={phoneHref}>Or call {phone}</a>
        </p>
      </section>

      <form class="bn-request" id="book" data-bn-request aria-labelledby="bn-request-title">
        <h2 id="bn-request-title">Ask about a date</h2>
        <p class="bn-request-sub">Siobhan will come back to you. There is no live diary on this page.</p>

        <div class="bn-field">
          <label for="bn-who">Your name</label>
          <input id="bn-who" name="name" type="text" autocomplete="name" placeholder="First and last" required />
        </div>
        <div class="bn-field">
          <label for="bn-tel">Best number</label>
          <input id="bn-tel" name="tel" type="tel" autocomplete="tel" placeholder="Mobile" required />
        </div>
        <fieldset class="bn-field bn-field--choice">
          <legend>What you need</legend>
          <label><input type="radio" name="bn-kind" value="A party we travel to" checked /> <span>We travel to you</span></label>
          <label><input type="radio" name="bn-kind" value="A school, church or community group" /> <span>School / group</span></label>
          <label><input type="radio" name="bn-kind" value="A party-at-home pack" /> <span>Party at home</span></label>
        </fieldset>
        <div class="bn-field">
          <label for="bn-date">Saturday you have in mind</label>
          <input id="bn-date" name="date" type="text" placeholder="e.g. Saturday 12 September" />
        </div>
        <div class="bn-field">
          <label for="bn-count">About how many children</label>
          <input id="bn-count" name="count" type="text" inputmode="numeric" placeholder="12 or more" />
        </div>

        <button class="bn-submit" type="submit">Prepare my message</button>

        <div class="bn-handoff" data-bn-handoff role="status" hidden tabindex="-1">
          <strong>Your message is ready.</strong>
          <span>Open the draft, check it, then press send in your email app.</span>
          <a data-bn-email-link href={`mailto:${email}`}>Open email draft</a>
        </div>
        <p class="bn-stale" data-bn-stale role="status" hidden>
          Your details changed. Press <strong>Prepare my message</strong> again so
          the draft matches what you typed.
        </p>

        <p class="bn-request-foot">
          Opens as a draft in your email app. Or ring <a href={phoneHref}>{phone}</a>.
        </p>
      </form>
    </div>

    <figure class="bn-voice">
      <blockquote>
        <p>
          “Bear Necessities was founded by Siobhan Rice in 2016. Siobhan's love
          for creativity and making children happy led her to create a unique
          interactive kid's experience, with a special focus on teddy bears.”
        </p>
      </blockquote>
      <figcaption>Siobhan Rice · bearnecessitieskids.co.uk</figcaption>
    </figure>

    <section class="bn-ritual" id="ritual" aria-labelledby="bn-ritual-title">
      <div class="bn-section-head">
        <p class="bn-eyebrow">The stuffing</p>
        <h2 id="bn-ritual-title">Not a soft-play hour. A stuffing.</h2>
        <p class="bn-section-intro">
          Bears are stuffed with the teddy bear stuffing machine.
          <strong>They are not hand stuffed.</strong> A heart insert and an
          adoption certificate go with every bear.
        </p>
      </div>
      <ol class="bn-steps">
        {ritual.map((step) => (
          <li class="bn-step">
            <p class="bn-step-when">{step.when}</p>
            <h3 class="bn-step-title">{step.title}</h3>
            <p class="bn-step-do">{step.line}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="bn-parties" id="parties" aria-labelledby="bn-parties-title">
      <div class="bn-section-head">
        <p class="bn-eyebrow">Parties</p>
        <h2 id="bn-parties-title">The machine arrives. You keep the Saturday.</h2>
        <p class="bn-section-intro">
          Groups need twelve guests or more. A local call-out starts at £35.
          Schools, church and community groups are welcome.
        </p>
      </div>
      <ul class="bn-packs">
        {packs.map((pack) => (
          <li class="bn-pack">
            <p class="bn-pack-size">{pack.size}</p>
            <h3 class="bn-pack-name">{pack.name}</h3>
            <p class="bn-pack-price">{pack.price}</p>
            <p class="bn-pack-note">{pack.note}</p>
          </li>
        ))}
      </ul>
      <ul class="bn-extras">
        <li>
          <h3>Party at home</h3>
          <p>The same ritual in the living room — bear, stuffing and supplies, if you would rather stay put.</p>
        </li>
        <li>
          <h3>Sand art, with the bear</h3>
          <p>From £10 for A4, or £3.50 as a small oval extra. Not stand-alone without the bear.</p>
        </li>
      </ul>
    </section>

    <section class="bn-plate-block" aria-labelledby="bn-plate-heading">
      <div class="bn-section-head">
        <p class="bn-eyebrow">The heart of it</p>
        <h2 id="bn-plate-heading">A heart goes in. A certificate comes out.</h2>
        <p class="bn-section-intro">That is how the bear becomes theirs.</p>
      </div>
      <figure class="bn-plate">
        <svg viewBox="0 0 920 360" role="img" aria-label="Drawn plate: an open teddy, a stuffing machine, a heart, and an adoption certificate">
          <rect width="920" height="360" fill="#fff4d8"/>
          <ellipse cx="200" cy="220" rx="88" ry="108" fill="#c9842a" stroke="#5a3a16" stroke-width="3.2"/>
          <circle cx="164" cy="154" r="34" fill="#c9842a" stroke="#5a3a16" stroke-width="3.2"/>
          <circle cx="236" cy="154" r="34" fill="#c9842a" stroke="#5a3a16" stroke-width="3.2"/>
          <circle cx="178" cy="210" r="6" fill="#3a2412"/>
          <circle cx="222" cy="210" r="6" fill="#3a2412"/>
          <path d="M200 188c-22 0-34 20-34 34 0 26 34 48 34 48s34-22 34-48c0-14-12-34-34-34z" fill="#b42318"/>
          <rect x="430" y="88" width="168" height="184" rx="10" fill="#6b4f2a" stroke="#3a2812" stroke-width="3.2"/>
          <circle cx="514" cy="162" r="34" fill="#f2d48a" stroke="#3a2812" stroke-width="3.2"/>
          <path d="M496 162h36M514 144v36" stroke="#3a2812" stroke-width="3.2"/>
          <rect x="680" y="118" width="168" height="124" rx="8" fill="#fffaf0" stroke="#5a3a16" stroke-width="2.4"/>
          <text x="764" y="168" text-anchor="middle" font-size="16" fill="#5a3a16" font-family="Georgia, serif">ADOPTION</text>
          <text x="764" y="196" text-anchor="middle" font-size="14" fill="#8a6230" font-family="Georgia, serif">certificate</text>
        </svg>
        <figcaption>Drawn plate of the ritual: bear, machine, heart, certificate.</figcaption>
      </figure>
    </section>

    <section class="bn-online" aria-labelledby="bn-online-title">
      <div class="bn-section-head">
        <p class="bn-eyebrow">When it is not a party Saturday</p>
        <h2 id="bn-online-title">The cart is for rainy days. The date is for a party.</h2>
        <p class="bn-section-intro">
          Offers and competitions live on Facebook. There is an online cart for
          rainy-day shop days. What this page holds is the thing a cart cannot:
          lock a Saturday.
        </p>
      </div>
      <p class="bn-online-links">
        <a class="bn-quiet" href="https://www.facebook.com/Bearnecessitiespartyvenue">Today's offers on Facebook</a>
        <a class="bn-phone-link" href={`mailto:${email}`}>{email}</a>
      </p>
    </section>
  </main>

  <script is:inline>
    (function () {
      var recipient = "bearnecessitieskids@gmail.com";
      var form = document.querySelector("[data-bn-request]");
      if (!form) return;

      var handoff = form.querySelector("[data-bn-handoff]");
      var stale = form.querySelector("[data-bn-stale]");
      var link = form.querySelector("[data-bn-email-link]");
      if (!handoff || !link) return;

      form.addEventListener("input", function () {
        if (handoff.hidden) return;
        handoff.hidden = true;
        if (stale) stale.hidden = false;
      });

      form.addEventListener("submit", function (event) {
        event.preventDefault();
        if (!form.reportValidity()) return;

        var name = form.querySelector("#bn-who").value.trim();
        var tel = form.querySelector("#bn-tel").value.trim();
        var chosen = form.querySelector('input[name="bn-kind"]:checked');
        var kind = chosen ? chosen.value : "A party we travel to";
        var date = form.querySelector("#bn-date").value.trim();
        var count = form.querySelector("#bn-count").value.trim();

        var query = new URLSearchParams({
          subject: "Bear Necessities — " + kind,
          body: [
            "Hello Siobhan,",
            "",
            "I would like to book: " + kind + ".",
            "Name: " + name,
            "Best number: " + tel,
            date ? "Date: " + date : "",
            count ? "Children: " + count : "",
            "",
            "Please tell me if that Saturday is free.",
          ].filter(Boolean).join("\n"),
        });

        link.href = "mailto:" + recipient + "?" + query;
        handoff.hidden = false;
        if (stale) stale.hidden = true;
        handoff.focus();
      });
    })();
  </script>
</ConceptLayout>
