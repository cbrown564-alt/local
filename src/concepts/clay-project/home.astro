---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import KilnTicket from "./KilnTicket.astro";

/* The Clay Project — jar (you leave with a piece) with a café shelf.
   Speak as the studio. No published phone — do not invent click-to-call.
   Do not clone their Squarespace cart. Do not print 5 Sep Flora (dropped
   from live workshops as of 26 Aug 2026). Charcuterie is 26 September;
   do not reprint leftover Valentines/Galentines CMS copy. Google hour
   table omitted; IG open line may print. No bake menu. No Birch. */
const email = "hello@theclay-project.com";
const workshops = "https://www.theclay-project.com/workshops";
const site = "https://www.theclay-project.com";
const instagram = "https://www.instagram.com/theclay_project/";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;0,6..96,700;1,6..96,400;1,6..96,500&family=Figtree:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap";

const diary = [
  {
    date: "19 September",
    title: "Make a Mug",
    price: "£55",
    detail: "10am–12.30pm · porcelain mug, glazed and fired, ready in 3 weeks",
  },
  {
    date: "26 September",
    title: "Charcuterie Night",
    price: "£60",
    detail: "6.30pm–9pm · ceramic charcuterie board, BYOB",
  },
  {
    date: "13th Oct",
    title: "Pumpkin Patch",
    price: "£50",
    detail: "",
  },
  {
    date: "07 November",
    title: "Autumn Flora Pressed Porcelain",
    price: "£55",
    detail: "",
  },
];
---

<ConceptLayout
  title={"The Clay Project — independent concept"}
  slug="clay-project"
  bodyClass="concept-page concept-clay"
  lang="en-GB"
  businessName="The Clay Project"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The kiln ticket is a drawing."
>
  <div class="cp-strip">
    <span>85 Central Promenade, Newcastle · BT33 0HH · overlooking the sea</span>
    <span class="cp-strip-r">Open Wednesday to Monday</span>
  </div>

  <header class="cp-header">
    <a class="cp-brand" href="/concepts/clay-project/">
      <span class="cp-brand-mark" aria-hidden="true">
        <KilnTicket compact />
      </span>
      <span class="cp-brand-text">
        <span class="cp-brand-name">The Clay Project</span>
        <span class="cp-brand-sub">85 Central Promenade · Newcastle</span>
      </span>
    </a>
    <nav class="cp-nav" aria-label="Concept navigation">
      <a href="#workshops">Workshops</a>
      <a href="#porcelain">Porcelain</a>
      <a href="#studio">The studio</a>
      <a href={workshops} rel="noopener noreferrer">Book a date</a>
    </nav>
    <a class="cp-book" href={workshops} rel="noopener noreferrer">Book a date</a>
  </header>

  <main class="cp-main">
    <section class="cp-mast" aria-labelledby="cp-name">
      <p class="cp-kicker">Pottery painting café + studio</p>
      <h1 id="cp-name">The Clay Project</h1>
      <p class="cp-number">85 Central Promenade.</p>
      <p class="cp-say">Overlooking the sea.</p>
      <p class="cp-lede">
        A pottery painting café on the promenade. We make the porcelain
        here. You leave with a piece.
      </p>
      <p class="cp-shelf">Coffee and bakes on the shelf.</p>
      <p class="cp-cta">
        <a class="cp-book cp-book--inline" href={workshops} rel="noopener noreferrer">Book a date</a>
        <a class="cp-mail" href={`mailto:${email}`}>{email}</a>
      </p>
      <span class="cp-horizon" aria-hidden="true"></span>
    </section>

    <section class="cp-magazine" id="workshops" aria-labelledby="cp-diary-title">
      <div class="cp-ledger-wrap">
        <p class="cp-kicker">The diary</p>
        <h2 id="cp-diary-title">Book a date on our site.</h2>
        <p class="cp-ledger-lede">
          Remaining places live on theclay-project.com/workshops. These
          are our dates.
        </p>
        <ol class="cp-ledger">
          {diary.map((row) => (
            <li>
              <a class="cp-row" href={workshops} rel="noopener noreferrer">
                <span class="cp-row-date">{row.date}</span>
                <span class="cp-row-body">
                  <span class="cp-row-title">{row.title}</span>
                  {row.detail && <span class="cp-row-detail">{row.detail}</span>}
                </span>
                <span class="cp-row-price">{row.price}</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="cp-quiet">
          Paint-on-pottery, monthly · £5.
        </p>
      </div>

      <blockquote class="cp-pull" id="porcelain">
        <p>
          We proudly make all our porcelain in-house and source everything
          as locally as possible.
        </p>
      </blockquote>
    </section>

    <section class="cp-studio" id="studio" aria-labelledby="cp-studio-title">
      <p class="cp-kicker">The studio</p>
      <h2 id="cp-studio-title">Rebecca Killen &amp; Laureanne Kootstra.</h2>
      <p class="cp-studio-lede">
        The Clay Project is the brainchild of local ceramicists Rebecca
        Killen &amp; Laureanne Kootstra. Founded late 2021.
      </p>
      <p>
        Our pottery painting café + studio is based in Newcastle (County
        Down) overlooking the sea. We are currently working with local
        potter Adrian McColgan who creates the beautiful bisc ware for our
        decorating workshops.
      </p>
      <p class="cp-open">Open Wednesday to Monday.</p>
    </section>

    <section class="cp-ritual" id="book" aria-labelledby="cp-book-title">
      <div class="cp-ritual-copy">
        <p class="cp-kicker">The kiln ticket</p>
        <h2 id="cp-book-title">Leave with a piece.</h2>
        <p class="cp-ritual-lede">
          Dates, remaining places, hens and kids’ parties — on our site.
          Write to us if you need the studio.
        </p>
        <p class="cp-chips" aria-label="Workshop dates">
          {diary.map((row) => (
            <a class="cp-chip" href={workshops} rel="noopener noreferrer">
              <span class="cp-chip-date">{row.date}</span>
              <span class="cp-chip-title">{row.title}</span>
              <span class="cp-chip-price">{row.price}</span>
            </a>
          ))}
        </p>
        <p class="cp-artefact-cta">
          <a class="cp-book cp-book--inline" href={workshops} rel="noopener noreferrer">Book a date</a>
          <a class="cp-mail" href={`mailto:${email}`}>{email}</a>
        </p>
      </div>

      <figure class="cp-artefact">
        <KilnTicket />
        <figcaption>The kiln ticket for 85.</figcaption>
      </figure>

      <address class="cp-address">
        <strong>The Clay Project</strong>
        <span>85 Central Promenade</span>
        <span>Newcastle, County Down</span>
        <span>BT33 0HH</span>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={instagram} rel="noopener noreferrer">Instagram · @theclay_project</a>
        <a href={workshops} rel="noopener noreferrer">Workshops · theclay-project.com</a>
        <a href={site} rel="noopener noreferrer">theclay-project.com</a>
      </address>
    </section>
  </main>
</ConceptLayout>
