---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import ChairCard from "./ChairCard.astro";

/* KD Hair — relief at 16 Mourne Rise. Speak as the salon.
   Distinct from Deja Vu (33 Promenade). Ring to book — no Timely.
   Hours omitted. Free parking for appointments (first-party). */

const phone = "07549 958 060";
const phoneHref = "tel:+447549958060";
const handoff = "https://www.kdhair16.co.uk/";
const maps = "https://www.google.com/maps/search/?api=1&query=16+Mourne+Rise+Newcastle+BT33+0HE";
const fontHref = "https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Outfit:wght@400;500;600;700;800&display=swap";
const stock = [
  { kicker: "Cut", title: "Shape for the rise.", body: "Cuts that hold — tell us how you wear it, we cut to that." },
  { kicker: "Colour", title: "L’Oréal in the chair.", body: "Colour mixed for the chair at 16 — roots through to a full change." },
  { kicker: "Styling", title: "Weddings & finish.", body: "Wedding hair, styling, GHD and L’Oréal products. Free parking for appointments." },
];
---
<ConceptLayout title={"KD Hair — independent concept"} slug="kd-hair" bodyClass="concept-page concept-kd-hair" lang="en-GB" businessName="KD Hair" town="Newcastle" fontHref={fontHref} bannerNote="AI-generated illustrations imagine the salon and setting; they are not photographs of the business.">
  <div class="kd-strip"><span>16 Mourne Rise, Newcastle · BT33 0HE · L’Oréal accredited</span><span class="kd-strip-r"><a href={phoneHref}>{phone}</a></span></div>
  <header class="kd-header"><div class="kd-header-inner">
    <a class="kd-brand" href="/concepts/kd-hair/"><span class="kd-brand-name">KD Hair</span><span class="kd-brand-sub">16 Mourne Rise · Newcastle</span></a>
    <nav class="kd-nav" aria-label="Concept navigation"><a href="#stock">The chair</a><a href="#book">Book</a><a href="#door">Find 16</a></nav>
    <a class="kd-walk" href={phoneHref}>Ring to book</a>
  </div></header>
  <main class="kd-main">
    <section class="kd-hero" aria-labelledby="kd-name">
      <div class="kd-mast-copy">
        <p class="kd-kicker">Hair salon · Mourne Rise</p>
        <h1 id="kd-name">KD Hair</h1>
        <p class="kd-number">16 Mourne Rise · Newcastle</p>
        <p class="kd-say">The chair on Mourne Rise.</p>
        <p class="kd-lede">L’Oréal accredited cuts, colour, styling and wedding hair. Quiet residential door — ring to book, or pop in. Free parking for appointments.</p>
        <div class="kd-hero-actions">
          <a class="kd-btn-primary" href={phoneHref}>Ring to book: {phone}</a>
          <a class="kd-btn-secondary" href="#door">Find 16 Mourne Rise</a>
        </div>
      </div>
      <figure class="kd-theatre">
        <img src="/media/concepts/kd-hair/kd-hair-hero-mourne-rise.jpg" alt="Quiet residential salon frontage on Mourne Rise Newcastle" width="1200" height="675" loading="eager" />
        <figcaption>16 Mourne Rise · L’Oréal accredited salon</figcaption>
      </figure>
    </section>
    <section class="kd-folio" id="stock" aria-labelledby="kd-stock-title">
      <div class="kd-folio-head"><p class="kd-kicker">The chair</p><h2 id="kd-stock-title">Cut, colour, care.</h2>
        <p class="kd-folio-lede">Soft rose and ink — a residential rise salon, not promenade chrome.</p></div>
      <div class="kd-mag-grid">{stock.map((item) => (<article class="kd-mag-cell"><p class="kd-mag-kicker">{item.kicker}</p><h3>{item.title}</h3><p>{item.body}</p></article>))}</div>
    </section>
    <section class="kd-ritual" id="book" aria-labelledby="kd-ticket-title">
      <div>
        <p class="kd-kicker">Book</p>
        <h2 id="kd-ticket-title">Ring for the chair.</h2>
        <p class="kd-ritual-lede">No app invent — ring 07549 958 060, or pop in at 16. Free parking when you come.</p>
        <ol class="kd-beats">
          <li><span class="kd-beat-n">01</span><span class="kd-beat-t">Ring or pop in</span></li>
          <li><span class="kd-beat-n">02</span><span class="kd-beat-t">Take the chair</span></li>
          <li><span class="kd-beat-n">03</span><span class="kd-beat-t">Leave sorted</span></li>
        </ol>
        <div class="kd-cta"><a class="kd-walk kd-walk--inline" href={phoneHref}>Ring to book</a></div>
      </div>
      <ChairCard headingId="kd-ticket-title" />
    </section>
    <section class="kd-section" id="colour" aria-labelledby="kd-colour-title">
      <div class="kd-section-copy">
        <p class="kd-kicker">Colour</p><h2 id="kd-colour-title">Swatches for the rise.</h2>
        <p class="kd-lead">L’Oréal colour mixed in the chair — ask when you ring.</p>
        <div class="kd-inline-action"><a class="kd-btn-primary" href={handoff} rel="noopener noreferrer">kdhair16.co.uk →</a></div>
      </div>
      <figure class="kd-photo-card"><img src="/media/concepts/kd-hair/kd-hair-colour-swatches.jpg" alt="Soft rose and ink colour swatches on a salon desk" width="1200" height="800" loading="lazy" /><figcaption>Colour swatches · Mixed for the chair</figcaption></figure>
    </section>
    <section class="kd-section kd-section--alt" id="seat" aria-labelledby="kd-seat-title">
      <figure class="kd-photo-card"><img src="/media/concepts/kd-hair/kd-hair-salon-chair.jpg" alt="Salon chair and mirror in soft rose light" width="1200" height="800" loading="lazy" /><figcaption>The chair · Quiet light on Mourne Rise</figcaption></figure>
      <div class="kd-section-copy">
        <p class="kd-kicker">Mourne Rise</p><h2 id="kd-seat-title">A residential door.</h2>
        <p class="kd-lead">Not the promenade salon — this is 16 Mourne Rise. Ring 07549 958 060.</p>
        <div class="kd-inline-action"><a class="kd-btn-secondary" href={phoneHref}>Ring: {phone}</a></div>
      </div>
    </section>
    <section class="kd-door-section" id="door" aria-labelledby="kd-door-title">
      <div class="kd-door-card">
        <p class="kd-kicker">The door</p><h2 id="kd-door-title">16 Mourne Rise.</h2>
        <p class="kd-door-desc">Ring to book or pop in. Free parking for appointments. What is current lives on kdhair16.co.uk.</p>
        <div class="kd-door-actions">
          <a class="kd-door-btn kd-door-btn--tel" href={phoneHref}><span class="kd-door-label">Telephone</span><span class="kd-door-val">Ring {phone} →</span></a>
          <a class="kd-door-btn" href={maps} rel="noopener noreferrer"><span class="kd-door-label">Directions</span><span class="kd-door-val">Open in Google Maps →</span></a>
          <a class="kd-door-btn" href={handoff} rel="noopener noreferrer"><span class="kd-door-label">Salon site</span><span class="kd-door-val">kdhair16.co.uk →</span></a>
        </div>
        <address class="kd-address"><strong>KD Hair</strong><span>16 Mourne Rise</span><span>Newcastle, Co. Down · BT33 0HE</span><a href={phoneHref}>{phone}</a></address>
      </div>
    </section>
  </main>
</ConceptLayout>
