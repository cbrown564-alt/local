---
/* Salon chair consultation card for 16 Mourne Rise.
   Honesty lives in bannerNote — caption stays guest voice. */
interface Props {
  headingId?: string;
}
const { headingId = "kd-chair-heading" } = Astro.props;
---

<figure class="kd-card-figure" aria-labelledby={headingId}>
  <svg
    class="kd-card-svg"
    viewBox="0 0 420 540"
    role="img"
    aria-label="KD Hair Design salon chair card for 16 Mourne Rise, Newcastle, detailing cut, bespoke colour, and styling appointment"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern id="kd-pattern" width="12" height="12" patternUnits="userSpaceOnUse">
        <circle cx="2" cy="2" r="1" fill="#e0c2c8" opacity="0.4"/>
      </pattern>
      <filter id="kd-shadow" x="-8%" y="-8%" width="116%" height="116%">
        <feDropShadow dx="0" dy="5" stdDeviation="7" flood-color="#2a1f28" flood-opacity="0.12"/>
      </filter>
    </defs>

    <rect width="420" height="540" fill="#f8f1f2"/>
    <rect width="420" height="540" fill="url(#kd-pattern)"/>

    <!-- Gold foil salon header bar -->
    <g transform="translate(180 18)">
      <rect x="0" y="0" width="60" height="38" rx="4" fill="#a44c5d"/>
      <rect x="4" y="4" width="52" height="30" rx="3" fill="#e8a8b2"/>
      <circle cx="30" cy="19" r="4" fill="#f8f1f2"/>
    </g>

    <!-- Main Card Body -->
    <g filter="url(#kd-shadow)">
      <rect x="56" y="42" width="308" height="460" rx="6" fill="#fffdfd" stroke="#8a3c4c" stroke-width="1.4"/>
      <line x1="56" y1="112" x2="364" y2="112" stroke="#ebd6da" stroke-width="1.2"/>
    </g>

    <!-- Brand Header -->
    <text x="210" y="78" text-anchor="middle" fill="#2d1c23" font-family="'Cormorant Garamond', Georgia, serif" font-size="24" font-weight="600">KD Hair Design</text>
    <text x="210" y="98" text-anchor="middle" fill="#a44c5d" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="9" font-weight="700" letter-spacing="2">16 MOURNE RISE · PRIVATE SALON</text>

    <!-- Salon services list -->
    <g font-family="'Plus Jakarta Sans', system-ui, sans-serif" fill="#2d1c23">
      <text x="78" y="146" font-size="9.5" font-weight="700" letter-spacing="1.4" fill="#a44c5d">APPOINTMENT</text>
      <text x="342" y="146" text-anchor="end" font-size="11" font-weight="600" fill="#7a5862">1-on-1</text>

      <text x="78" y="174" font-size="14" font-weight="600">Cut &amp; Precision Styling</text>
      <text x="342" y="174" text-anchor="end" font-size="12" fill="#7a5862">Finish</text>
      <line x1="78" y1="186" x2="342" y2="186" stroke="#f0dee2" stroke-width="1"/>

      <text x="78" y="218" font-size="14" font-weight="600">Custom Colour &amp; Balayage</text>
      <text x="342" y="218" text-anchor="end" font-size="12" fill="#7a5862">Gloss &amp; Tone</text>
      <line x1="78" y1="230" x2="342" y2="230" stroke="#f0dee2" stroke-width="1"/>

      <text x="78" y="262" font-size="14" font-weight="600">Foils &amp; Highlights</text>
      <text x="342" y="262" text-anchor="end" font-size="12" fill="#7a5862">Full / Half Head</text>
      <line x1="78" y1="274" x2="342" y2="274" stroke="#f0dee2" stroke-width="1"/>

      <text x="78" y="306" font-size="14" font-weight="600">Treatment &amp; Blow Dry</text>
      <text x="342" y="306" text-anchor="end" font-size="12" fill="#7a5862">Hydration</text>
      <line x1="78" y1="318" x2="342" y2="318" stroke="#f0dee2" stroke-width="1"/>

      <text x="78" y="352" font-size="9.5" font-weight="700" letter-spacing="1.4" fill="#a44c5d">STYLIST</text>
      <text x="78" y="378" font-size="14" font-weight="600">Kerry-Dawn</text>
      <text x="342" y="378" text-anchor="end" font-size="12" fill="#7a5862">Private Chair</text>
      <line x1="78" y1="390" x2="342" y2="390" stroke="#f0dee2" stroke-width="1"/>
    </g>

    <!-- Salon seal -->
    <g transform="translate(210 436)">
      <circle r="36" fill="none" stroke="#a44c5d" stroke-width="1.2" opacity="0.8"/>
      <circle r="30" fill="none" stroke="#e8a8b2" stroke-width="0.8" stroke-dasharray="2 2"/>
      <text y="-6" text-anchor="middle" fill="#2d1c23" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="7.5" font-weight="700" letter-spacing="1.2">MOURNE RISE</text>
      <text y="8" text-anchor="middle" fill="#a44c5d" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="8" font-weight="700">BT33 0HE</text>
      <text y="20" text-anchor="middle" fill="#7a5862" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="7" font-weight="600">NEWCASTLE</text>
    </g>

    <text x="210" y="490" text-anchor="middle" fill="#a44c5d" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="10" font-weight="600">Ring or message · 07549 958 060</text>
  </svg>
  <figcaption class="kd-card-caption">Salon chair card · 16 Mourne Rise</figcaption>
</figure>
