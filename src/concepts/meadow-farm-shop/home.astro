---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import "./styles.css";

/* Meadow Farm Shop, 123 Downpatrick Road, Crossgar / Downpatrick BT30 9EH.
   Verified live 27 Nov 2026: meadowfarmpotatoes.com/farm-shop blocks automated requests and link previews
   behind a hard Cloudflare 403 challenge.
   Contacts: 028 4483 1543, 123 Downpatrick Road, Crossgar / Downpatrick BT30 9EH. */
const phone = "028 4483 1543";
const phoneHref = "tel:+442844831543";
const siteHref = "https://meadowfarmpotatoes.com/farm-shop";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Meadow+Farm+Shop+123+Downpatrick+Road+Crossgar+BT30+9EH";

const counterTabs = [
  {
    id: "farm-shop",
    label: "Farm shop",
    intro: "Stocked daily on the Downpatrick Road with County Down soil produce and regional Northern Ireland makers.",
    items: [
      {
        title: "Meadow Farm County Down potatoes",
        detail: "Freshly lifted seasonal varieties grown in County Down soil and bagged straight from the farm.",
        meta: "Grown on site",
      },
      {
        title: "Seasonal vegetables and fruit",
        detail: "Crisp greens, root vegetables, orchard fruit and free-range local eggs stocked every morning.",
        meta: "Fresh daily",
      },
      {
        title: "Artisan Northern Ireland larder",
        detail: "Small-batch jams, chutneys, honey, home-baked traybakes and farm-reared meats.",
        meta: "Local makers",
      },
    ],
  },
  {
    id: "tearoom",
    label: "Tearoom",
    intro: "Settle beside the window overlooking Mid-Down fields for home baking and proper pots of tea.",
    items: [
      {
        title: "Warm buttermilk scones and baking",
        detail: "Freshly baked scones, wheaten bread and cakes served warm with butter, cream and berry jam.",
        meta: "Baked daily",
      },
      {
        title: "Light farm lunches and soup",
        detail: "Hearty seasonal vegetable soups and fresh sandwiches overlooking the County Down countryside.",
        meta: "Tearoom tables",
      },
      {
        title: "Easy A7 roadside stop",
        detail: "Generous off-road parking between Crossgar and Downpatrick for morning coffee or a relaxed lunch.",
        meta: "Free parking",
      },
    ],
  },
  {
    id: "seasonal-harvest",
    label: "Seasonal harvest",
    intro: "From floury maincrops to bespoke local hampers, our counters follow the County Down growing calendar.",
    items: [
      {
        title: "Floury maincrops and baby potatoes",
        detail: "Seasonal varieties lifted to match the time of year, ready for roasting, mashing or boiling.",
        meta: "Lifted in season",
      },
      {
        title: "Regional gift hampers",
        detail: "Packed to order with Northern Ireland preserves, chutneys, honey and home-baked treats.",
        meta: "Call to reserve",
      },
      {
        title: "Direct farm desk advice",
        detail: "Ring 028 4483 1543 ahead of your visit to check current potato lifts or hold a hamper.",
        meta: "028 4483 1543",
      },
    ],
  },
];

const farmGroups = [
  {
    id: "produce",
    label: "Home-Grown Potatoes and Local Produce",
    items: [
      { name: "Meadow Farm County Down Potatoes", note: "Freshly lifted seasonal varieties grown in County Down soil, bagged straight from the farm", meta: "Grown on site" },
      { name: "Seasonal Vegetables and Fruit", note: "Crisp greens, root vegetables, orchard fruit and free-range local eggs stocked daily", meta: "Fresh daily" },
      { name: "Artisan Northern Ireland Larder", note: "Local chutneys, preserves, honey, home-baked traybakes and farm-reared meats", meta: "Downpatrick Road" },
    ],
  },
  {
    id: "tearoom",
    label: "Country Tearoom and Bakery",
    items: [
      { name: "Freshly Baked Scones and Home Baking", note: "Warm buttermilk scones, wheaten bread and cakes served with proper tea and coffee", meta: "Tearoom tables" },
      { name: "Light Farm Lunches and Soup", note: "Hearty seasonal vegetable soups and sandwiches overlooking the County Down countryside", meta: "Easy roadside stop" },
    ],
  },
];
---

<ConceptLayout
  title="Meadow Farm Shop | Potatoes, Local Produce and Tearoom, Crossgar"
  slug="meadow-farm-shop"
  bodyClass="concept-page concept-meadowfarm"
  businessName="Meadow Farm Shop"
  town="Crossgar"
  bannerNote="Imagery comprises indicative County Down farm shop harvest and countryside tearoom visualisations."
>
  <header class="mfs-header" data-mfs-header>
    <div class="mfs-header-inner">
      <a class="mfs-brand" href="#top">Meadow Farm Shop</a>

      <nav class="mfs-nav" aria-label="Primary">
        <a class="mfs-nav-link" href="#produce">Farm shop</a>
        <a class="mfs-nav-link" href="#tearoom" data-mfs-jump="tearoom">Tearoom</a>
        <a class="mfs-nav-link" href="#enquire">Enquire</a>
        <a class="mfs-nav-link" href="#location">Crossgar</a>
      </nav>

      <div class="mfs-header-actions">
        <a class="mfs-header-tel" href={phoneHref}>{phone}</a>
        <a class="mfs-header-cta" href={mapsHref} target="_blank" rel="noopener noreferrer">Directions</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="mfs-hero" aria-labelledby="mfs-hero-title">
      <span class="mfs-hero-sentinel" aria-hidden="true" data-mfs-sentinel></span>
      <div class="mfs-hero-media">
        <picture>
          <source srcset="/media/concepts/meadow-farm-shop/meadow-farm-harvest-640.webp 640w, /media/concepts/meadow-farm-shop/meadow-farm-harvest-1265.webp 1265w" sizes="100vw" type="image/webp" />
          <img
            src="/media/concepts/meadow-farm-shop/meadow-farm-harvest.jpg"
            alt="Sunlit County Down farm shop wooden harvest crates overflowing with brushed potatoes, heirloom carrots, fresh greens and preserve jars"
            width="1408"
            height="768"
            loading="eager"
          />
        </picture>
        <div class="mfs-hero-scrim" aria-hidden="true"></div>
      </div>

      <div class="mfs-wrap mfs-hero-stage">
        <div class="mfs-hero-lockup">
          <h1 id="mfs-hero-title" class="mfs-reveal mfs-reveal-1">
            County Down harvest and a warm tearoom.
          </h1>
          <div class="mfs-hero-foot mfs-reveal mfs-reveal-2">
            <div class="mfs-hero-copy">
              <p>
                Home-grown County Down potatoes, local larder produce and warm scones on the Downpatrick Road.
              </p>
              <a class="mfs-primary-btn" href={mapsHref} target="_blank" rel="noopener noreferrer">
                Get directions
              </a>
            </div>
            <p class="mfs-hero-caption">Indicative harvest counter visualisation.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="mfs-band mfs-band--linen" id="produce" aria-labelledby="mfs-p-title">
      <div class="mfs-wrap mfs-split">
        <div class="mfs-col">
          <h2 id="mfs-p-title">Lifted from County Down soil, stocked fresh every day.</h2>

          <div class="mfs-tabs" role="tablist" aria-label="Farm shop, tearoom and seasonal harvest">
            {counterTabs.map((tab, idx) => (
              <button
                type="button"
                role="tab"
                id={`mfs-tab-${tab.id}`}
                aria-selected={idx === 0 ? "true" : "false"}
                aria-controls={`mfs-panel-${tab.id}`}
                tabindex={idx === 0 ? 0 : -1}
                class:list={["mfs-tab", idx === 0 && "is-active"]}
                data-mfs-tab={tab.id}
              >
                {tab.label}
              </button>
            ))}
          </div>

          {counterTabs.map((tab, idx) => (
            <div
              id={`mfs-panel-${tab.id}`}
              role="tabpanel"
              aria-labelledby={`mfs-tab-${tab.id}`}
              hidden={idx !== 0}
              class="mfs-panel"
              data-mfs-panel={tab.id}
            >
              <p class="mfs-panel-intro">{tab.intro}</p>
              <ul class="mfs-ledger">
                {tab.items.map((item) => (
                  <li class="mfs-ledger-row">
                    <div class="mfs-ledger-main">
                      <h3>{item.title}</h3>
                      <p>{item.detail}</p>
                    </div>
                    <span class="mfs-ledger-meta">{item.meta}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}

          <div class="mfs-sheet-row">
            <SpecimenSheet
              id="mf-shop-sheet"
              triggerLabel="Browse shop and tearoom guide"
              kicker="Meadow Farm Shop, Crossgar"
              title="Potatoes, Local Larder and Tearoom"
              subtitle="Easy parking off the Downpatrick Road. Ring 028 4483 1543 for seasonal potato varieties or hampers."
              groups={farmGroups}
              ctaLabel={`Call ${phone}`}
              ctaHref={phoneHref}
              secondaryLabel="Google Maps ↗"
              secondaryHref={mapsHref}
              buttonClass="mfs-sheet-trigger"
            />
          </div>
        </div>

        <div class="mfs-col mfs-media-col" id="tearoom">
          <figure class="mfs-plate">
            <picture>
              <source srcset="/media/concepts/meadow-farm-shop/meadow-farm-tearoom-640.webp 640w, /media/concepts/meadow-farm-shop/meadow-farm-tearoom-1265.webp 1265w" sizes="(max-width: 900px) 100vw, 46vw" type="image/webp" />
              <img
                src="/media/concepts/meadow-farm-shop/meadow-farm-tearoom.jpg"
                alt="Sunlit country farm tearoom table set with golden buttermilk scones, clotted cream, berry jam and stoneware teapot overlooking green County Down fields"
                width="1408"
                height="768"
                loading="lazy"
              />
            </picture>
            <figcaption>Indicative country tearoom visualisation.</figcaption>
          </figure>

          <dl class="mfs-details">
            <div>
              <dt>Shop and tearoom</dt>
              <dd><a href={phoneHref}>{phone}</a></dd>
            </div>
            <div>
              <dt>Address</dt>
              <dd>123 Downpatrick Road, Crossgar, BT30 9EH</dd>
            </div>
            <div>
              <dt>Website</dt>
              <dd><a href={siteHref} target="_blank" rel="noopener noreferrer">meadowfarmpotatoes.com ↗</a></dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="mfs-band mfs-band--olive" id="enquire" aria-labelledby="mfs-enq-title">
      <div class="mfs-wrap mfs-split mfs-split--enquire">
        <div class="mfs-col">
          <h2 id="mfs-enq-title">Ask about potato varieties, hampers or tearoom visits.</h2>
          <p class="mfs-dark-copy">
            Planning a hamper order, checking which County Down potato varieties are freshly lifted,
            or stopping in with family along the A7? Send a quick note below or call the shop
            directly on <a href={phoneHref}>{phone}</a>.
          </p>
        </div>

        <div class="mfs-col">
          <form class="mfs-form" data-mfs-form>
            <div class="mfs-form-row">
              <label>
                <span>Your name</span>
                <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
              </label>
              <label>
                <span>Telephone</span>
                <input name="phone" type="tel" required autocomplete="tel" placeholder="028 or 07..." />
              </label>
            </div>
            <div class="mfs-form-row">
              <label>
                <span>Enquiry topic</span>
                <select name="topic">
                  <option value="Seasonal potato varieties">Seasonal potato varieties</option>
                  <option value="Local larder gift hamper">Local larder gift hamper</option>
                  <option value="Tearoom group visit">Tearoom group visit</option>
                  <option value="General farm shop question">General farm shop question</option>
                </select>
              </label>
              <label>
                <span>Preferred visit day</span>
                <input name="day" type="text" placeholder="e.g. Friday morning" />
              </label>
            </div>
            <label>
              <span>Message</span>
              <textarea name="notes" rows="3" placeholder="Let us know what produce, hamper items or table numbers you have in mind."></textarea>
            </label>
            <button class="mfs-submit-btn" type="submit">Send shop enquiry</button>
          </form>
        </div>
      </div>
    </section>

    <section class="mfs-band mfs-band--linen mfs-map-band" id="location" aria-label="Crossgar Downpatrick Road map">
      <div class="mfs-wrap">
        <LocalAreaMap
          id="mf-map"
          kicker=""
          businessName="Meadow Farm Shop"
          address="123 Downpatrick Road, Crossgar, Downpatrick, BT30 9EH"
          lon={-5.7401}
          lat={54.3708}
          spanKm={16}
          mapHref={mapsHref}
          markers={[
            { name: "Crossgar", lon: -5.7662, lat: 54.4004, note: "4 mins north-west", side: "t" },
            { name: "Downpatrick", lon: -5.7168, lat: 54.3286, note: "6 mins south-east", side: "b" },
            { name: "Killyleagh", lon: -5.6524, lat: 54.4017, note: "10 mins east", side: "r" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="mfs-footer">
    <div class="mfs-wrap mfs-footer-inner">
      <div>
        <strong class="mfs-footer-brand">Meadow Farm Shop</strong>
        <p>123 Downpatrick Road, Crossgar, Downpatrick, Co. Down, BT30 9EH</p>
      </div>
      <div class="mfs-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={siteHref} target="_blank" rel="noopener noreferrer">Official website ↗</a>
        <a href={mapsHref} target="_blank" rel="noopener noreferrer">Directions ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-mfs-header]");
      const sentinel = document.querySelector("[data-mfs-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            header.classList.toggle("is-scrolled", !entries[0].isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      const tabs = [...document.querySelectorAll("[data-mfs-tab]")];
      const panels = [...document.querySelectorAll("[data-mfs-panel]")];
      const activateTab = (id, focusTab = false) => {
        tabs.forEach((btn) => {
          const active = btn.dataset.mfsTab === id;
          btn.classList.toggle("is-active", active);
          btn.setAttribute("aria-selected", active ? "true" : "false");
          btn.tabIndex = active ? 0 : -1;
          if (active && focusTab) btn.focus();
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.mfsPanel !== id;
        });
      };

      tabs.forEach((btn, idx) => {
        btn.addEventListener("click", () => activateTab(btn.dataset.mfsTab));
        btn.addEventListener("keydown", (e) => {
          if (e.key === "ArrowRight") {
            e.preventDefault();
            activateTab(tabs[(idx + 1) % tabs.length].dataset.mfsTab, true);
          } else if (e.key === "ArrowLeft") {
            e.preventDefault();
            activateTab(tabs[(idx - 1 + tabs.length) % tabs.length].dataset.mfsTab, true);
          }
        });
      });

      document.querySelectorAll("[data-mfs-jump]").forEach((link) => {
        link.addEventListener("click", () => {
          const id = link.dataset.mfsJump;
          if (id) activateTab(id);
        });
      });

      const form = document.querySelector("[data-mfs-form]");
      if (form) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;
          const fd = new FormData(form);
          const subject = `Shop enquiry: ${fd.get("topic")} (${fd.get("name")})`;
          const body = [
            `Name: ${fd.get("name")}`,
            `Phone: ${fd.get("phone")}`,
            `Topic: ${fd.get("topic")}`,
            `Preferred day: ${fd.get("day") || "Flexible"}`,
            `Message: ${fd.get("notes") || "None"}`,
          ].join("\n");
          const ev = new CustomEvent("mm:enquiry", {
            cancelable: true,
            detail: {
              to: "Meadow Farm Shop (028 4483 1543)",
              subject,
              body,
              url: "tel:+442844831543",
            },
          });
          if (window.dispatchEvent(ev)) {
            window.location.href = "tel:+442844831543";
          }
        });
      }
    })();
  </script>
</ConceptLayout>
