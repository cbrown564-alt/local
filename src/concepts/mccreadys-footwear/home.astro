---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import ShoeTicket from "./ShoeTicket.astro";

/* McCready's Footwear — independent shoe shop at 85 Main Street.
   Quality mens and womens footwear, measured and fitted on the bench since 1936.
   Phone: 028 4372 3491 · Web: https://www.mccreadysfootwear.com/
   No web forms. Walk in to try the pair. */
const phone = "028 4372 3491";
const phoneHref = "tel:+442843723491";
const handoff = "https://www.mccreadysfootwear.com/";
const maps = "https://www.google.com/maps/search/?api=1&query=85+Main+Street+Newcastle+BT33+0AE";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Albert+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500;1,9..144,600&display=swap";

const departments = [
  {
    kicker: "Fitting Bench",
    title: "Proper foot measurement",
    body: "Length, width, and arch support measured properly before you try a pair. Half sizes and wide fittings so your shoes feel right from the first step.",
  },
  {
    kicker: "Everyday Walking",
    title: "Quality leather for town",
    body: "Classic brogues, comfortable loafers, supportive lace-ups, and timeless everyday shoes selected for durability and genuine all-day comfort.",
  },
  {
    kicker: "Mourne Walking",
    title: "Weatherproof walking boots",
    body: "Sturdy gripped boots and waterproof outdoor footwear prepared for the stony tracks of the Mournes and wet coastal pavements.",
  },
  {
    kicker: "Care & Polish",
    title: "Leather creams, waxes & laces",
    body: "Caring for good leather pays back for decades. Dubbin, beeswax polishes, brass horn shoehorns, and replacement cotton laces.",
  },
];
---

<ConceptLayout
  title={"McCready's Footwear — 85 Main Street, Newcastle"}
  slug="mccreadys-footwear"
  bodyClass="concept-page concept-mccreadys-footwear"
  lang="en-GB"
  businessName="McCready's Footwear"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="AI-generated illustrations imagine the setting, spaces and products; they are not photographs of the business."
>
  <!-- Shop top notice -->
  <div class="mcf-topbar">
    <span class="mcf-topbar-addr">85 Main Street, Newcastle · BT33 0AE · Independent since 1936</span>
    <a class="mcf-topbar-tel" href={phoneHref}>Call the shop: {phone}</a>
  </div>

  <!-- Header -->
  <header class="mcf-store-header">
    <div class="mcf-header-frame">
      <a class="mcf-brand-link" href="/concepts/mccreadys-footwear/">
        <span class="mcf-brand-name">McCready’s Footwear</span>
        <span class="mcf-brand-sub">85 Main Street · Newcastle · Est. 1936</span>
      </a>
      <nav class="mcf-store-nav" aria-label="Footwear shop navigation">
        <a href="#bench">Fitting Bench</a>
        <a href="#ranges">Footwear Ranges</a>
        <a href="#ticket">The Fit Ticket</a>
        <a href="#counter">Visit 85</a>
      </nav>
      <a class="mcf-header-btn" href="#counter">Walk in to 85</a>
    </div>
  </header>

  <main class="mcf-content-flow">
    <!-- Fitting Bench Hero -->
    <section class="mcf-bench-hero" aria-labelledby="mcf-hero-title">
      <div class="mcf-hero-story">
        <p class="mcf-kicker-wood">Independent Shoe Shop · Newcastle</p>
        <h1 id="mcf-hero-title" class="mcf-hero-heading">The fit on Main Street since 1936.</h1>
        <p class="mcf-hero-intro">
          Quality mens and womens footwear fitted in person on our wooden bench at 85 Main Street.
          Take the time to try both shoes, walk the floorboards, and leave with a pair that truly fits.
        </p>
        <div class="mcf-hero-buttons">
          <a class="mcf-btn-cordovan" href="#counter">Walk in to 85 Main Street</a>
          <a class="mcf-btn-outline" href={phoneHref}>Ring the shop: {phone}</a>
        </div>
      </div>
      <figure class="mcf-hero-window">
        <img
          src="/media/concepts/mccreadys-footwear/mccreadys-footwear-hero-main-street.jpg"
          alt="McCready's Footwear shopfront at 85 Main Street Newcastle"
          width="1200"
          height="675"
          loading="eager"
        />
        <figcaption class="mcf-img-caption">85 Main Street · Quality independent footwear</figcaption>
      </figure>
    </section>

    <!-- Ranges Grid -->
    <section class="mcf-ranges-section" id="ranges" aria-labelledby="mcf-ranges-heading">
      <div class="mcf-section-mast">
        <p class="mcf-kicker-wood">Traditional Standards</p>
        <h2 id="mcf-ranges-heading" class="mcf-section-title">Fitted for real walking.</h2>
        <p class="mcf-mast-lead">
          We believe in shoes made to be worn every day. Measured properly so you don’t spend weeks breaking them in.
        </p>
      </div>

      <div class="mcf-ranges-grid">
        {departments.map((dept) => (
          <article class="mcf-range-box">
            <span class="mcf-range-tag">{dept.kicker}</span>
            <h3 class="mcf-range-title">{dept.title}</h3>
            <p class="mcf-range-body">{dept.body}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Ticket & Ritual Section -->
    <section class="mcf-fitting-ritual" id="ticket" aria-labelledby="mcf-ticket-title">
      <div class="mcf-ritual-narrative">
        <p class="mcf-kicker-wood">The Fitting Bench</p>
        <h2 id="mcf-ticket-title" class="mcf-section-title">How we fit your pair.</h2>
        <p class="mcf-ritual-lead">
          Buying shoes should never be guesswork through a screen. Sit down, let us measure your feet,
          and find the right width and leather grade.
        </p>
        <ol class="mcf-ritual-steps">
          <li>
            <span class="mcf-step-num">1</span>
            <div>
              <strong>Both Feet Measured</strong>
              <p>Because feet are rarely identical, we measure both for accurate length and joint width.</p>
            </div>
          </li>
          <li>
            <span class="mcf-step-num">2</span>
            <div>
              <strong>Bench Try-On</strong>
              <p>Laced up properly, checked at the heel slip, and tested with a stroll across the shop.</p>
            </div>
          </li>
          <li>
            <span class="mcf-step-num">3</span>
            <div>
              <strong>Leather &amp; Care Advice</strong>
              <p>We show you how to condition and care for the pair so they last for years.</p>
            </div>
          </li>
        </ol>
        <div class="mcf-ritual-cta">
          <a class="mcf-btn-cordovan" href={handoff} rel="noopener noreferrer">
            Explore styles on mccreadysfootwear.com &rarr;
          </a>
        </div>
      </div>
      <div class="mcf-ticket-frame">
        <ShoeTicket headingId="mcf-ticket-title" />
      </div>
    </section>

    <!-- Photography Gallery -->
    <section class="mcf-gallery-section" id="bench" aria-labelledby="mcf-bench-heading">
      <div class="mcf-gallery-pair">
        <figure class="mcf-gallery-item">
          <img
            src="/media/concepts/mccreadys-footwear/mccreadys-footwear-fit-bench.jpg"
            alt="Wooden shoe fitting bench and brass measuring gauges in the shop"
            width="1200"
            height="800"
            loading="lazy"
          />
          <figcaption class="mcf-img-caption">The fitting bench · Taking time with every customer</figcaption>
        </figure>
        <div class="mcf-gallery-notes">
          <p class="mcf-kicker-wood">The Shop Floor</p>
          <h2 id="mcf-bench-heading" class="mcf-section-title">Seated fitting on Main Street.</h2>
          <p class="mcf-gallery-text">
            Old-fashioned customer care that hasn’t changed since Edna and Joanne’s door opened in 1936.
            Knowledgeable advice on arch support, bunion-friendly leather, and school shoe sizing.
          </p>
          <a class="mcf-text-btn" href={phoneHref}>Ring for size availability: {phone}</a>
        </div>
      </div>

      <div class="mcf-gallery-pair mcf-gallery-pair--reverse">
        <figure class="mcf-gallery-item">
          <img
            src="/media/concepts/mccreadys-footwear/mccreadys-footwear-leather-fit.jpg"
            alt="Hand-stitched leather shoes and traditional leather polish tins"
            width="1200"
            height="800"
            loading="lazy"
          />
          <figcaption class="mcf-img-caption">Leather craft · Supple uppers and durable welted soles</figcaption>
        </figure>
        <div class="mcf-gallery-notes">
          <p class="mcf-kicker-wood">Lasting Quality</p>
          <h3 class="mcf-section-title">Supple leathers that age gracefully.</h3>
          <p class="mcf-gallery-text">
            From soft calfskin town brogues to weather-treated oiled nubuck walking shoes,
            we stock makers who build shoes that can be resoled and enjoyed season after season.
          </p>
          <a class="mcf-text-btn" href={handoff} rel="noopener noreferrer">
            Visit official site (mccreadysfootwear.com) &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Shop Counter & Door -->
    <section class="mcf-counter-section" id="counter" aria-labelledby="mcf-counter-heading">
      <div class="mcf-counter-card">
        <div class="mcf-counter-info">
          <p class="mcf-kicker-wood">Visit 85</p>
          <h2 id="mcf-counter-heading" class="mcf-counter-title">Our Main Street shop.</h2>
          <p class="mcf-counter-lead">
            Centrally located on Newcastle’s Main Street. Walk in at any time to try on pairs,
            ask about sizing, or pick up polishes and accessories.
          </p>
          <div class="mcf-counter-buttons">
            <a class="mcf-counter-btn mcf-counter-btn--tel" href={phoneHref}>
              <span class="mcf-btn-label">Telephone</span>
              <span class="mcf-btn-val">028 4372 3491</span>
            </a>
            <a class="mcf-counter-btn" href={handoff} rel="noopener noreferrer">
              <span class="mcf-btn-label">Website</span>
              <span class="mcf-btn-val">mccreadysfootwear.com &rarr;</span>
            </a>
            <a class="mcf-counter-btn" href={maps} rel="noopener noreferrer">
              <span class="mcf-btn-label">Map</span>
              <span class="mcf-btn-val">Directions on Google Maps &rarr;</span>
            </a>
          </div>
        </div>

        <address class="mcf-shop-address">
          <span class="mcf-addr-firm">McCready’s Footwear</span>
          <span class="mcf-addr-line">85 Main Street</span>
          <span class="mcf-addr-line">Newcastle, Co. Down</span>
          <span class="mcf-addr-line">BT33 0AE</span>
          <span class="mcf-addr-tel"><a href={phoneHref}>{phone}</a></span>
        </address>
      </div>
    </section>
  </main>
</ConceptLayout>
