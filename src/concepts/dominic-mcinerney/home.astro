---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import DeskBlotter from "./DeskBlotter.astro";

/* Dominic McInerney Solicitors — rebuilt as a letterhead document: centred
   measure, hairline rules, ink on paper. No stage/veil hero.
   123A Main Street, Newcastle · BT33 0AE.
   Established 1998. All cases handled personally by Dominic McInerney.
   Sourced from dominicmcinerney.co.uk, LSNI records, and Google Business.
   No hours printed (Google-only). No Facebook (unavailable). No © 2013. */

const phone = "028 4372 5238";
const phoneHref = "tel:+442843725238";
const email = "dmcinerney@btconnect.com";
const mailto = `mailto:${email}`;
const site = "https://www.dominicmcinerney.co.uk";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Castoro:ital@0;1&family=Castoro+Titling&display=swap";
---

<ConceptLayout
  title={"Dominic McInerney Solicitors — 123A Main Street, Newcastle"}
  slug="dominic-mcinerney"
  bodyClass="concept-page concept-dominic"
  lang="en-GB"
  businessName="Dominic McInerney Solicitors"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="Chamber photography and consultation desk scenes are AI-generated illustrative visualisations of 123A Main Street."
>
  <main class="dm-folio">
    <!-- Letterhead -->
    <header class="dm-letterhead">
      <p class="dm-strapline">Solicitors · Established 1998</p>
      <h1 class="dm-principal">Dominic McInerney</h1>
      <p class="dm-premises">123A Main Street · Newcastle · County Down · BT33 0AE</p>
      <p class="dm-motto">All cases handled personally.</p>
      <hr class="dm-rule" />
      <nav class="dm-index" aria-label="Page index">
        <a href="#firm">The Firm</a>
        <a href="#schedule">Schedule of Practice</a>
        <a href="#undertaking">Our Undertaking</a>
        <a href="#consultation">Consultation</a>
      </nav>
    </header>

    <article class="dm-recto">
      <!-- Recital: who the firm is, in its own words -->
      <section class="dm-recital" id="firm" aria-labelledby="dm-firm-heading">
        <h2 id="dm-firm-heading">A private firm on Main Street.</h2>
        <p class="dm-opening">
          We are a private firm of solicitors based in Newcastle, County Down, serving Newcastle and surrounding areas.
        </p>
        <blockquote class="dm-covenant">
          <p>“We offer our clients a personal service, where all cases are handled personally by Dominic McInerney.”</p>
        </blockquote>
        <p class="dm-recital-body">
          Established in 1998, the practice has stood on Main Street for over twenty-eight years, advising generations of local families and businesses with discretion, depth of local knowledge, and careful legal precision.
        </p>
      </section>

      <figure class="dm-frontispiece">
        <img
          src="/media/concepts/dominic-mcinerney/dominic-mcinerney-hero-chamber.jpg"
          alt="AI-generated illustrative view of the quiet consultation room at 123A Main Street, Newcastle"
          width="1376"
          height="768"
          loading="eager"
        />
        <figcaption>The consultation room at 123A Main Street. AI-generated illustrative visualisation.</figcaption>
      </figure>

      <!-- Schedule of practice, set as a numbered instrument -->
      <section class="dm-schedule" id="schedule" aria-labelledby="dm-schedule-heading">
        <h2 id="dm-schedule-heading">Schedule of practice.</h2>
        <p class="dm-preamble">Matters undertaken directly from this office include:</p>
        <ol class="dm-matters">
          <li class="dm-matter">
            <h3 class="dm-matter-name">Property &amp; Conveyancing</h3>
            <p class="dm-matter-note">Residential house sales, purchases, remortgages, and commercial property transfers across Newcastle and the Mourne region.</p>
          </li>
          <li class="dm-matter">
            <h3 class="dm-matter-name">Wills, Probate &amp; Estates</h3>
            <p class="dm-matter-note">Will drafting, Enduring Powers of Attorney, estate administration, and protecting family assets with complete confidentiality.</p>
          </li>
          <li class="dm-matter">
            <h3 class="dm-matter-name">Personal Injury &amp; Medical Negligence</h3>
            <p class="dm-matter-note">Experienced representation for road traffic accidents, workplace injuries, and clinical negligence claims.</p>
          </li>
          <li class="dm-matter">
            <h3 class="dm-matter-name">Family Law &amp; Civil Litigation</h3>
            <p class="dm-matter-note">Discreet guidance on matrimonial separation, divorce, financial arrangements, debt recovery, and court dispute litigation.</p>
          </li>
        </ol>
        <p class="dm-handoff">
          Fuller notes on each area, and the forms, live on our site at
          <a href={site} rel="noopener noreferrer">dominicmcinerney.co.uk</a>.
        </p>
      </section>

      <!-- Undertaking: the personal-counsel covenant made plain -->
      <section class="dm-undertaking" id="undertaking" aria-labelledby="dm-undertaking-heading">
        <h2 id="dm-undertaking-heading">Our undertaking to every client.</h2>
        <p>
          When you entrust your legal affairs to this office, your case is not passed down to junior staff or anonymous case managers. Dominic McInerney advises, drafts, negotiates, and represents you directly, at every stage of the matter.
        </p>
        <p>
          Every conversation in this office is held in complete confidence, from the first telephone call to the conclusion of your affairs.
        </p>
        <figure class="dm-enclosure">
          <img
            src="/media/concepts/dominic-mcinerney/dominic-mcinerney-desk-detail.jpg"
            alt="AI-generated illustrative close-up of a solicitor's desk with a parchment document, fountain pen, and embossed seal"
            width="1200"
            height="896"
            loading="lazy"
          />
          <figcaption>Confidential legal consultation. AI-generated illustrative visualisation.</figcaption>
        </figure>
      </section>

      <!-- Consultation: ring or write, as plain correspondence -->
      <section class="dm-attendance" id="consultation" aria-labelledby="dm-consultation-heading">
        <h2 id="dm-consultation-heading">Arrange a consultation.</h2>
        <p>
          To discuss your legal requirements in confidence, ring or write to the office directly. Telephone lines are attended during business hours.
        </p>
        <p class="dm-channels">
          Telephone — <a href={phoneHref}>{phone}</a><br />
          Email — <a href={mailto}>{email}</a>
        </p>
        <figure class="dm-desk">
          <DeskBlotter />
          <figcaption>The desk at 123A.</figcaption>
        </figure>
      </section>
    </article>

    <!-- Colophon -->
    <footer class="dm-colophon">
      <hr class="dm-rule" />
      <p class="dm-imprint">Dominic McInerney Solicitors</p>
      <p class="dm-geo">123A Main Street · Newcastle · County Down · BT33 0AE · Established 1998</p>
      <p class="dm-correspondence">
        <a href={site} rel="noopener noreferrer">dominicmcinerney.co.uk</a> ·
        <a href={phoneHref}>{phone}</a> ·
        <a href={mailto}>{email}</a>
      </p>
    </footer>
  </main>
</ConceptLayout>
