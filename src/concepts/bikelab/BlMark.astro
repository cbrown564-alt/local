---
/* BikeLab house mark: a lab flask whose liquid line is a shock spring.
   Drawn for the concept. */
interface Props { size?: number; tone?: "ink" | "paper" }
const { size = 40, tone = "ink" } = Astro.props;
const ink = tone === "ink" ? "#151515" : "#f1efe9";
---
<svg class="bl-mark" width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false">
  <path d="M18 5h12M20 5v13L9 39a3 3 0 0 0 2.7 4.4h24.6A3 3 0 0 0 39 39L28 18V5" stroke={ink} stroke-width="2.6" stroke-linejoin="round"/>
  <path d="M13.5 31h21L39 39a3 3 0 0 1-2.7 4.4H11.7A3 3 0 0 1 9 39z" fill="#ff5b14"/>
  <path d="M14 31 l3 -3 l3 3 l3 -3 l3 3 l3 -3 l3 3 l3 -3" stroke={ink} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
