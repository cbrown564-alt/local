---
/* Maguire Law house mark: a folded brief tied in pink tape, the oldest
   sign of a solicitor's work. Drawn for the concept. */
interface Props { size?: number }
const { size = 44 } = Astro.props;
---
<svg class="ml-mark" width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false">
  <rect x="7" y="5" width="34" height="38" rx="1.5" fill="#fbf7ee" stroke="#1d2b3a" stroke-width="1.6"/>
  <path d="M7 15h34" stroke="#1d2b3a" stroke-width="0.9"/>
  <path d="M12 21h18M12 26h22M12 31h14" stroke="#1d2b3a" stroke-width="1" stroke-linecap="round" opacity=".55"/>
  <path d="M4 30 L44 18" stroke="#c4506a" stroke-width="3.2" stroke-linecap="round"/>
  <path d="M24 24.2 l-5 9 M24 24.2 l6 8.4" stroke="#c4506a" stroke-width="2.4" stroke-linecap="round"/>
  <circle cx="24" cy="24.2" r="2.6" fill="#a63c56"/>
</svg>
