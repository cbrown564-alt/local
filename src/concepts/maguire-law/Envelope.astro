---
/* The page's one fixed object: a letter addressed to the practice, the
   address exactly as the Law Society lists it. Drawn for the concept. */
---
<svg class="ml-envelope" viewBox="0 0 640 400" role="img" aria-label="An envelope addressed to Maguire Law, 21E Dundrum Road, Newcastle, BT33 0BG, tied with pink legal tape">
  <rect x="24" y="34" width="592" height="340" rx="4" fill="#1d2b3a" opacity=".12" transform="translate(8 10)"/>
  <rect x="24" y="34" width="592" height="340" rx="4" fill="#fbf7ee" stroke="#cfc4ac" stroke-width="1.5"/>
  <path d="M24 38 L320 214 L616 38" fill="none" stroke="#e3d9c3" stroke-width="2"/>
  <rect x="520" y="58" width="68" height="80" fill="none" stroke="#c4506a" stroke-width="1.5" stroke-dasharray="4 3"/>
  <text x="554" y="104" text-anchor="middle" font-family="'Instrument Sans', Arial, sans-serif" font-size="11" letter-spacing="1.5" fill="#c4506a">BT33</text>
  <g font-family="'Young Serif', Georgia, serif" fill="#1d2b3a">
    <text x="200" y="246" font-size="30">Maguire Law</text>
    <text x="200" y="282" font-size="21">21E Dundrum Road</text>
    <text x="200" y="312" font-size="21">Newcastle, Co Down</text>
    <text x="200" y="342" font-size="21" letter-spacing="3">BT33 0BG</text>
