---
/* Drawn deli ticket / kitchen pass for 18 Main Street.
   Honesty lives in bannerNote — caption stays guest voice. */
interface Props {
  headingId?: string;
}
const { headingId = "ff-ticket-title" } = Astro.props;
---

<figure class="ff-ticket" aria-labelledby={headingId}>
  <svg
    class="ff-ticket-svg"
    viewBox="0 0 420 560"
    role="img"
    aria-label="Fish and Farm deli ticket for 18 Main Street, Newcastle, with take-home lines for chowder, pie, and fresh fish"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern id="ff-ticket-dots" width="8" height="8" patternUnits="userSpaceOnUse">
        <circle cx="1.2" cy="1.2" r="0.7" fill="#c4b8a8" opacity="0.45"/>
      </pattern>
      <filter id="ff-ticket-soft" x="-8%" y="-8%" width="116%" height="116%">
        <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#1a2f3a" flood-opacity="0.14"/>
      </filter>
    </defs>

    <!-- Desk surface -->
    <rect width="420" height="560" fill="#e8e0d4"/>
    <rect width="420" height="560" fill="url(#ff-ticket-dots)"/>

    <!-- Copper clip -->
    <g transform="translate(188 18)">
      <rect x="8" y="0" width="28" height="52" rx="4" fill="#8a5a2b"/>
      <rect x="11" y="4" width="22" height="44" rx="3" fill="#c4843a"/>
      <rect x="14" y="10" width="16" height="8" rx="1.5" fill="#e8b56a" opacity="0.7"/>
      <circle cx="22" cy="40" r="3.5" fill="#6e4420"/>
    </g>

    <!-- Ticket body -->
    <g filter="url(#ff-ticket-soft)">
      <path
        d="M72 48h276c8 0 14 6 14 14v400c0 8-6 14-14 14H72c-8 0-14-6-14-14V62c0-8 6-14 14-14Z"
        fill="#f7f2ea"
        stroke="#2a3f48"
        stroke-width="1.6"
      />
      <!-- Perforation -->
      <path
        d="M70 118h280"
        stroke="#2a3f48"
        stroke-width="1.2"
        stroke-dasharray="3 5"
        opacity="0.55"
      />
      <!-- Side notches -->
      <circle cx="58" cy="200" r="10" fill="#e8e0d4"/>
      <circle cx="362" cy="200" r="10" fill="#e8e0d4"/>
      <circle cx="58" cy="320" r="10" fill="#e8e0d4"/>
      <circle cx="362" cy="320" r="10" fill="#e8e0d4"/>
    </g>

    <!-- Header -->
    <text
      x="210"
      y="78"
      text-anchor="middle"
      fill="#1a2f3a"
      font-family="Fraunces, Georgia, serif"
      font-size="28"
      font-weight="600"
    >Fish &amp; Farm</text>
    <text
      x="210"
      y="100"
      text-anchor="middle"
      fill="#5a7a68"
      font-family="DM Sans, Segoe UI, sans-serif"
      font-size="10"
      font-weight="700"
      letter-spacing="2.4"
    >18 MAIN STREET · NEWCASTLE</text>

    <!-- Ticket no -->
    <text
      x="92"
      y="148"
      fill="#8a5a2b"
      font-family="DM Sans, Segoe UI, sans-serif"
      font-size="9"
      font-weight="700"
      letter-spacing="1.8"
    >COUNTER TICKET</text>
    <text
      x="328"
      y="148"
      text-anchor="end"
      fill="#1a2f3a"
      font-family="DM Sans, Segoe UI, sans-serif"
      font-size="12"
      font-weight="700"
    >№ 18</text>

    <!-- Lines -->
    <g font-family="DM Sans, Segoe UI, sans-serif" fill="#1a2f3a">
      <text x="92" y="188" font-size="11" font-weight="700" letter-spacing="1.2" fill="#5a7a68">TAKE HOME</text>
      <text x="92" y="214" font-size="15" font-weight="600">Chowder</text>
      <text x="328" y="214" text-anchor="end" font-size="13" fill="#6b7c84">wrap</text>
      <line x1="92" y1="224" x2="328" y2="224" stroke="#d4c8b8" stroke-width="1"/>

      <text x="92" y="254" font-size="15" font-weight="600">Farm pie</text>
      <text x="328" y="254" text-anchor="end" font-size="13" fill="#6b7c84">wrap</text>
      <line x1="92" y1="264" x2="328" y2="264" stroke="#d4c8b8" stroke-width="1"/>

      <text x="92" y="294" font-size="15" font-weight="600">Fresh fish</text>
      <text x="328" y="294" text-anchor="end" font-size="13" fill="#6b7c84">today</text>
      <line x1="92" y1="304" x2="328" y2="304" stroke="#d4c8b8" stroke-width="1"/>

      <text x="92" y="338" font-size="11" font-weight="700" letter-spacing="1.2" fill="#5a7a68">DELI</text>
      <text x="92" y="364" font-size="15" font-weight="600">Scone &amp; tea</text>
      <text x="328" y="364" text-anchor="end" font-size="13" fill="#6b7c84">sit-in</text>
      <line x1="92" y1="374" x2="328" y2="374" stroke="#d4c8b8" stroke-width="1"/>
    </g>

    <!-- Footer stamp -->
    <g transform="translate(210 430)">
      <circle r="48" fill="none" stroke="#5a7a68" stroke-width="1.4" opacity="0.85"/>
      <circle r="40" fill="none" stroke="#5a7a68" stroke-width="0.8" stroke-dasharray="2 3" opacity="0.7"/>
      <!-- tiny fish -->
      <path
        d="M-18 0c8-10 20-10 28 0-8 10-20 10-28 0Z"
        fill="none"
        stroke="#1a2f3a"
        stroke-width="1.6"
      />
      <circle cx="6" cy="-2" r="1.6" fill="#1a2f3a"/>
      <!-- tiny leaf -->
      <path
        d="M12 8c8-2 14-10 12-16-8 2-14 10-12 16Z"
        fill="#5a7a68"
        opacity="0.85"
      />
      <text
        y="28"
        text-anchor="middle"
        fill="#1a2f3a"
        font-family="DM Sans, Segoe UI, sans-serif"
        font-size="7"
        font-weight="800"
        letter-spacing="1.6"
      >BT33 0AD</text>
    </g>

    <text
      x="210"
      y="508"
      text-anchor="middle"
      fill="#6b7c84"
      font-family="DM Sans, Segoe UI, sans-serif"
      font-size="10"
      font-weight="600"
      letter-spacing="0.4"
    >Walk in · Ring 028 4379 8550</text>
  </svg>
  <figcaption class="ff-ticket-cap">The ticket at 18.</figcaption>
</figure>
