---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import CounterTicket from "./CounterTicket.astro";

/* Fish & Farm — jar on Main Street. Speak as the shop.
   Prepared take-home + 2024 deli sit-in. Sister to Buck's Head.
   fishandfarm.co.uk is a dead Hostinger stub — hand off to
   chefalexgreene.co.uk. Hours omitted (not first-party locked).
   Phone is directory/leadquest; best ring mechanism available.
   No form. No cart. FSA kept off guest chrome. */

const phone = "028 4379 8550";
const phoneHref = "tel:+442843798550";
const handoff = "https://chefalexgreene.co.uk/";
const maps =
  "https://www.google.com/maps/search/?api=1&query=18+Main+Street+Newcastle+BT33+0AD";
const fontHref =
  "https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,600;0,9..40,700;1,9..40,400&family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500;1,9..144,600&display=swap";

const stock = [
  {
    kicker: "Take home",
    title: "From our kitchen.",
    body: "Locally sourced fresh fish, lasagnes, pies, chowder, soups, sausage rolls and breads — prepared in-house for your table.",
  },
  {
    kicker: "Deli sit-in",
    title: "Sit with us.",
    body: "Homemade scones, salad bowls, breakfast toasties, croissants, mini pies and tray bakes, with tea and coffee — in-house or takeaway.",
  },
  {
    kicker: "Same family",
    title: "Sister to Buck’s Head.",
    body: "Gift vouchers are shared with our restaurant door in Dundrum. This door is the take-home kitchen on Main Street.",
  },
];
---

<ConceptLayout
  title={"Fish & Farm — independent concept"}
  slug="fish-and-farm"
  bodyClass="concept-page concept-fish-and-farm"
  lang="en-GB"
  businessName="Fish & Farm"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The counter ticket is a drawing of the 18 Main Street plate."
>
  <div class="ff-strip">
    <span>18 Main Street, Newcastle · BT33 0AD</span>
    <span class="ff-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="ff-header">
    <a class="ff-brand" href="/concepts/fish-and-farm/">
      <span class="ff-brand-mark" aria-hidden="true">
        <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
          <rect width="44" height="44" fill="#1a2f3a"/>
          <rect x="1.5" y="1.5" width="41" height="41" stroke="#c4843a" stroke-width="1.4"/>
          <path
            d="M8 22c6-9 14-9 20 0-6 9-14 9-20 0Z"
            fill="none"
            stroke="#f4efe6"
            stroke-width="1.7"
          />
          <circle cx="24.5" cy="20.2" r="1.5" fill="#f4efe6"/>
          <path
            d="M26 27c7-2 12-9 10-14-7 2-12 9-10 14Z"
            fill="#5a7a68"
          />
          <path
            d="M29 20.5c1.2 2.2 1.6 4.2 1.2 6"
            stroke="#3f5a4a"
            stroke-width="1"
            fill="none"
          />
        </svg>
      </span>
      <span class="ff-brand-text">
        <span class="ff-brand-name">Fish &amp; Farm</span>
        <span class="ff-brand-sub">18 Main Street · Newcastle</span>
      </span>
    </a>
    <nav class="ff-nav" aria-label="Concept navigation">
      <a href="#counter">The counter</a>
      <a href="#ticket">The ticket</a>
      <a href="#door">The door</a>
    </nav>
    <a class="ff-walk" href="#door">Walk in</a>
  </header>

  <main class="ff-main">
    <section class="ff-mast" aria-labelledby="ff-name">
      <div class="ff-mast-copy">
        <p class="ff-kicker">Take-home kitchen · Main Street</p>
        <h1 id="ff-name">Fish &amp; Farm</h1>
        <p class="ff-number">18 Main Street · Newcastle</p>
        <p class="ff-say">Prepared for your table.</p>
        <p class="ff-lede">
          Locally sourced fresh fish, lasagnes, pies, chowder, soups,
          sausage rolls and breads from our kitchen. Deli scones, salad
          bowls, toasties and tray bakes to sit with or take away.
        </p>
        <p class="ff-cta">
          <a class="ff-walk ff-walk--inline" href="#door">Walk in</a>
          <a class="ff-ring" href={phoneHref}>{phone}</a>
        </p>
      </div>
      <div class="ff-mast-aside" aria-hidden="true">
        <svg viewBox="0 0 120 120" fill="none">
          <path
            d="M22 60c18-28 42-28 60 0-18 28-42 28-60 0Z"
            stroke="#1a2f3a"
            stroke-width="2.2"
          />
          <circle cx="68" cy="54" r="3.2" fill="#1a2f3a"/>
          <path
            d="M72 72c22-6 36-26 30-42-22 6-36 26-30 42Z"
            fill="#5a7a68"
          />
          <text
            x="60"
            y="108"
            text-anchor="middle"
            fill="#8a5a2b"
            font-family="DM Sans, Segoe UI, sans-serif"
            font-size="9"
            font-weight="800"
            letter-spacing="2"
          >EST. 2019</text>
        </svg>
        <span class="ff-mast-aside-label">Fish and farm mark</span>
      </div>
    </section>

    <section class="ff-folio" id="counter" aria-labelledby="ff-counter-title">
      <p class="ff-folio-mark">Fish &amp; Farm · 18 Main Street · Newcastle</p>
      <div class="ff-folio-head">
        <p class="ff-kicker">The counter</p>
        <h2 id="ff-counter-title">What goes home with you.</h2>
        <p>
          Alex and Bronagh’s retail kitchen on Main Street — take-home
          dishes from the chefs, and a deli seat since the 2024 relaunch.
        </p>
      </div>
      <div class="ff-mag-grid">
        {stock.map((item) => (
          <article class="ff-mag-cell">
            <p class="ff-mag-kicker">{item.kicker}</p>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ff-ritual" id="ticket" aria-labelledby="ff-ticket-title">
      <div class="ff-ritual-copy">
        <p class="ff-kicker">The ticket</p>
        <h2 id="ff-ticket-title">Point at the counter.</h2>
        <p class="ff-ritual-lede">
          You choose what goes on the ticket. We wrap it for home — or
          pour the coffee at the deli seat.
        </p>
        <ol class="ff-beats">
          <li>
            <span class="ff-beat-n">01</span>
            <span class="ff-beat-t">Walk in at 18</span>
          </li>
          <li>
            <span class="ff-beat-n">02</span>
            <span class="ff-beat-t">Choose from the counter</span>
          </li>
          <li>
            <span class="ff-beat-n">03</span>
            <span class="ff-beat-t">Take it home</span>
          </li>
        </ol>
        <p class="ff-cta">
          <a class="ff-walk ff-walk--inline" href="#door">Walk in</a>
          <a class="ff-ring" href={phoneHref}>{phone}</a>
        </p>
      </div>
      <CounterTicket headingId="ff-ticket-title" />
    </section>

    <section class="ff-door" id="door" aria-labelledby="ff-door-title">
      <div class="ff-door-head">
        <p class="ff-kicker">The door</p>
        <h2 id="ff-door-title">18 Main Street.</h2>
        <p class="ff-door-lede">
          The ticket is at the counter. Walk in. Ring if you like. What
          is current lives with us on Chef Alex Greene.
        </p>
      </div>
      <div class="ff-door-grid">
        <address class="ff-address">
          <strong>Fish &amp; Farm</strong>
          <span>18 Main Street</span>
          <span>Newcastle, Co. Down</span>
          <span>BT33 0AD</span>
          <a href={phoneHref}>{phone}</a>
          <a href={maps} rel="noopener noreferrer">Map</a>
        </address>
        <div class="ff-handoff">
          <h3>Visit Fish &amp; Farm</h3>
          <p>
            Our live door online is with Chef Alex Greene — Bronagh and
            Alex. Start there for Fish &amp; Farm and the wider kitchen
            family.
          </p>
          <a href={handoff} rel="noopener noreferrer">chefalexgreene.co.uk</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="ff-footer">
    <p class="ff-footer-name">Fish &amp; Farm</p>
    <p>18 Main Street, Newcastle · Take-home kitchen · Est. 2019</p>
  </footer>
</ConceptLayout>
