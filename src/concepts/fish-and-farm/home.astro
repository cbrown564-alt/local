---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

/* Fish & Farm — jar on Main Street. Speak as the shop.
   Prepared take-home + 2024 deli sit-in. Sister to Buck's Head.
   fishandfarm.co.uk is a dead Hostinger stub — hand off to
   chefalexgreene.co.uk. Hours omitted (not first-party locked).
   Phone is directory/leadquest; best ring mechanism available.
   No form. No cart. FSA kept off guest chrome. */

const phone = "028 4379 8550";
const phoneHref = "tel:+442843798550";
const handoff = "https://chefalexgreene.co.uk/";
const maps =
  "https://www.google.com/maps/search/?api=1&query=18+Main+Street+Newcastle+BT33+0AD";
const fontHref =
  "https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,600;0,9..40,700;1,9..40,400&family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500;1,9..144,600&display=swap";

const stock = [
  {
    kicker: "Take home",
    title: "From our kitchen.",
    body: "Locally sourced fresh fish, lasagnes, pies, chowder, soups, sausage rolls and breads — prepared in-house for your table.",
  },
  {
    kicker: "Deli sit-in",
    title: "Sit with us.",
    body: "Homemade scones, salad bowls, breakfast toasties, croissants, mini pies and tray bakes, with tea and coffee — in-house or takeaway.",
  },
  {
    kicker: "Same family",
    title: "Sister to Buck’s Head.",
    body: "Gift vouchers are shared with our restaurant door in Dundrum. This door is the take-home kitchen on Main Street.",
  },
];
---

<ConceptLayout
  title={"Fish & Farm — independent concept"}
  slug="fish-and-farm"
  bodyClass="concept-page concept-fish-and-farm"
  lang="en-GB"
  businessName="Fish & Farm"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="AI-generated illustrations imagine the setting, spaces and dishes; they are not photographs of the business."
>
  <div class="ff-strip">
    <span>18 Main Street, Newcastle · BT33 0AD</span>
    <span class="ff-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="ff-header">
    <div class="ff-header-inner">
      <a class="ff-brand" href="/concepts/fish-and-farm/">
        <span class="ff-brand-name">Fish &amp; Farm</span>
        <span class="ff-brand-sub">18 Main Street · Newcastle</span>
      </a>
      <nav class="ff-nav" aria-label="Concept navigation">
        <a href="#counter">The counter</a>
        <a href="#sit-in">Deli sit-in</a>
        <a href="#door">Find 18</a>
      </nav>
      <a class="ff-walk" href="#door">Walk in</a>
    </div>
  </header>

  <main class="ff-main">
    <section class="ff-hero" aria-labelledby="ff-name">
      <div class="ff-mast-copy">
        <p class="ff-kicker">Take-home kitchen &amp; deli · Main Street</p>
        <h1 id="ff-name">Fish &amp; Farm</h1>
        <p class="ff-number">18 Main Street · Newcastle</p>
        <p class="ff-say">Prepared for your table.</p>
        <p class="ff-lede">
          Locally sourced fresh fish, chef-prepared meals, chowder, pies,
          and artisan breads from our kitchen. Deli scones, toasties, and
          coffee to sit with or take away.
        </p>
        <div class="ff-hero-actions">
          <a class="ff-btn-primary" href="#door">Walk in to 18</a>
          <a class="ff-btn-secondary" href={phoneHref}>Ring {phone}</a>
        </div>
      </div>

      <figure class="ff-theatre">
        <img
          src="/media/concepts/fish-and-farm/fish-and-farm-hero-main-street.jpg"
          alt="Fish and Farm food boutique and kitchen shopfront at 18 Main Street Newcastle"
          width="1200"
          height="675"
          loading="eager"
        />
        <figcaption>18 Main Street · Chef-prepared kitchen &amp; fresh counter</figcaption>
      </figure>
    </section>

    <section class="ff-folio" id="counter" aria-labelledby="ff-counter-title">
      <div class="ff-folio-head">
        <p class="ff-kicker">The counter</p>
        <h2 id="ff-counter-title">What goes home with you.</h2>
        <p class="ff-folio-lede">
          Alex and Bronagh’s retail kitchen on Main Street — take-home
          dishes from the chefs, and a deli seat since the 2024 relaunch.
        </p>
      </div>
      <div class="ff-mag-grid">
        {stock.map((item) => (
          <article class="ff-mag-cell">
            <p class="ff-mag-kicker">{item.kicker}</p>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ff-section" id="kitchen" aria-labelledby="ff-kitchen-title">
      <div class="ff-section-copy">
        <p class="ff-kicker">The kitchen</p>
        <h2 id="ff-kitchen-title">Chowder, pies &amp; fresh bake.</h2>
        <p class="ff-lead">
          Rich seafood chowder, hot fish pies, golden homemade sausage rolls, and freshly baked crusty wheaten loaves. Made daily by the culinary team behind the Buck's Head.
        </p>
        <div class="ff-inline-action">
          <a class="ff-btn-primary" href={handoff} rel="noopener noreferrer">Alex Greene &amp; Buck’s Head Story →</a>
        </div>
      </div>

      <figure class="ff-photo-card">
        <img
          src="/media/concepts/fish-and-farm/fish-and-farm-take-home-counter.jpg"
          alt="Steaming pot of fresh seafood chowder, golden fish pies and artisan bread on counter"
          width="1200"
          height="800"
          loading="lazy"
        />
        <figcaption>Prepared for your table · Fresh take-home meals and artisan bakes</figcaption>
      </figure>
    </section>

    <section class="ff-section ff-section--alt" id="sit-in" aria-labelledby="ff-sit-title">
      <figure class="ff-photo-card">
        <img
          src="/media/concepts/fish-and-farm/fish-and-farm-deli-table.jpg"
          alt="Warm breakfast toasties, flat white coffee and fresh scones on a wooden cafe table"
          width="1200"
          height="800"
          loading="lazy"
        />
        <figcaption>Deli Sit-In · Freshly baked scones, toasted sandwiches and hot coffee</figcaption>
      </figure>

      <div class="ff-section-copy">
        <p class="ff-kicker">Sit with us</p>
        <h2 id="ff-sit-title">Coffee, scones &amp; toasties.</h2>
        <p class="ff-lead">
          Take a seat inside or grab and go. Warm breakfast sourdough toasties, fruit scones with clotted cream and jam, and espresso coffees served throughout the day.
        </p>
        <div class="ff-inline-action">
          <a class="ff-btn-secondary" href={phoneHref}>Ring the deli: {phone}</a>
        </div>
      </div>
    </section>

    <section class="ff-door-section" id="door" aria-labelledby="ff-door-title">
      <div class="ff-door-card">
        <p class="ff-kicker">The door</p>
        <h2 id="ff-door-title">18 Main Street.</h2>
        <p class="ff-door-desc">
          On Newcastle's Main Street. Walk in to browse today's fresh counter dishes, or ring to reserve dinner packs.
        </p>

        <div class="ff-door-actions">
          <a class="ff-door-btn ff-door-btn--tel" href={phoneHref}>
            <span class="ff-door-label">Telephone</span>
            <span class="ff-door-val">Ring {phone} →</span>
          </a>
          <a class="ff-door-btn" href={maps} rel="noopener noreferrer">
            <span class="ff-door-label">Directions</span>
            <span class="ff-door-val">Open in Google Maps →</span>
          </a>
          <a class="ff-door-btn" href={handoff} rel="noopener noreferrer">
            <span class="ff-door-label">Executive Chef</span>
            <span class="ff-door-val">chefalexgreene.co.uk →</span>
          </a>
        </div>

        <address class="ff-address">
          <strong>Fish &amp; Farm</strong>
          <span>18 Main Street</span>
          <span>Newcastle, Co. Down · BT33 0AD</span>
          <a href={phoneHref}>{phone}</a>
        </address>
      </div>
    </section>
  </main>
</ConceptLayout>
