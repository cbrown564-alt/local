---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import DualBay from "./DualBay.astro";

/* Dacara Guesthouse — Victorian seaside bed & breakfast at 47 South Promenade.
   47 South Promenade, Newcastle, BT33 0EY.
   Phone: 028 4372 6745 · Email: info@dacaraguesthouse.com.
   Dual bay windows over Dundrum Bay, three ensuite rooms, cooked Irish breakfasts. */

const phone = "028 4372 6745";
const phoneHref = "tel:+442843726745";
const email = "info@dacaraguesthouse.com";
const mailto = `mailto:${email}`;
const site = "https://www.dacaraguesthouse.com/";
const maps =
  "https://www.google.com/maps/search/?api=1&query=47+South+Promenade+Newcastle+BT33+0EY";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Raleway:wght@400;500;600;700&display=swap";

const guestRooms = [
  {
    title: "Bay-Window Seaview Ensuite",
    feature: "Uninterrupted Bay Views",
    desc: "First-floor double room set within the Victorian bay window, offering panoramic morning sunrises across the Irish Sea.",
  },
  {
    title: "Ground-Floor Garden Ensuite",
    feature: "Step-Free Accessibility",
    desc: "Spacious ensuite double room located on the ground floor, ideal for guests seeking quiet convenience without stairs.",
  },
  {
    title: "Twin / Family Ensuite",
    feature: "Flexible Comfort",
    desc: "Comfortable ensuite room featuring twin beds, digital television, Wi-Fi, hairdryer, trouser press, and tea and coffee facilities.",
  },
];
---

<ConceptLayout
  title={"Dacara Guesthouse — independent concept"}
  slug="dacara"
  bodyClass="concept-page concept-dacara"
  lang="en-GB"
  businessName="Dacara Guesthouse"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The bay window is a drawing."
>
  <div class="dc-strip">
    <span>47 South Promenade, Newcastle · BT33 0EY · Victorian Seaside Guesthouse</span>
    <span class="dc-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="dc-header">
    <a class="dc-brand" href="/concepts/dacara/">
      <span class="dc-brand-mark" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 44 44" fill="none">
          <rect width="44" height="44" rx="4" fill="#1c2e3a"/>
          <path d="M4 30h36" stroke="#7aa0b4" stroke-width="1.2"/>
          <path d="M8 30 V16 Q14 10 22 10 Q30 10 36 16 V30" fill="none" stroke="#e8dcc8" stroke-width="1.6"/>
          <path d="M14 30 V18 Q18 14 22 14 Q26 14 30 18 V30" fill="#c9b8a0" opacity="0.35"/>
          <rect x="18" y="20" width="8" height="10" fill="#f0e6d6" stroke="#1c2e3a" stroke-width="0.8"/>
        </svg>
      </span>
      <span class="dc-brand-text">
        <span class="dc-brand-name">Dacara Guesthouse</span>
        <span class="dc-brand-sub">South Promenade · Newcastle</span>
      </span>
    </a>
    <nav class="dc-nav" aria-label="Concept navigation">
      <a href="#rooms">Rooms</a>
      <a href="#breakfast">Breakfast</a>
      <a href="#location">Harbour Setting</a>
      <a href="#enquiries">Check Dates</a>
    </nav>
    <a class="dc-enquire-btn" href={phoneHref}>Enquire Now</a>
  </header>

  <main class="dc-main">
    <section class="dc-hero" aria-labelledby="dc-name">
      <div class="dc-hero-copy">
        <span class="dc-kicker">Victorian B&amp;B · South Promenade</span>
        <h1 id="dc-name">Dacara Guesthouse</h1>
        <p class="dc-place">47 South Promenade · Harbour Quarter · Dundrum Bay</p>
        <p class="dc-say">Wake to undisturbed sea light across Dundrum Bay.</p>
        <p class="dc-lede">
          A distinguished Victorian seaside residence featuring dual bay windows overlooking the waters of Dundrum Bay.
          Offering three comfortable ensuite bedrooms, including a ground-floor suite, and hearty home-cooked Irish breakfasts.
        </p>
        <div class="dc-hero-actions">
          <a class="dc-btn dc-btn--primary" href={phoneHref}>Call the House {phone}</a>
          <a class="dc-btn dc-btn--outline" href={mailto}>Email info@dacaraguesthouse.com</a>
        </div>
      </div>

      <div class="dc-hero-art">
        <DualBay headingId="dc-name" />
      </div>
    </section>

    <section class="dc-rooms-section" id="rooms" aria-labelledby="dc-rooms-title">
      <div class="dc-section-head">
        <span class="dc-kicker">Accommodation</span>
        <h2 id="dc-rooms-title">Three Individual Ensuite Rooms</h2>
        <p class="dc-section-intro">
          We maintain an intimate, restful atmosphere with just three guest rooms, ensuring attentive personal hospitality throughout your stay.
        </p>
      </div>

      <div class="dc-rooms-grid">
        {guestRooms.map((room) => (
          <article class="dc-room-card">
            <span class="dc-card-tag">{room.feature}</span>
            <h3>{room.title}</h3>
            <p>{room.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="dc-breakfast-section" id="breakfast" aria-labelledby="dc-breakfast-title">
      <div class="dc-breakfast-wrapper">
        <div class="dc-breakfast-copy">
          <span class="dc-kicker dc-kicker--gold">Morning Hospitality</span>
          <h2 id="dc-breakfast-title">Traditional Cooked Irish Breakfast</h2>
          <p>
            Served each morning in our dining room overlooking the bay, breakfast at Dacara is prepared freshly to order.
            Enjoy local County Down bacon and sausages, free-range eggs, grilled tomatoes, and warm toasted soda and wheaten farls,
            accompanied by pots of freshly brewed tea and ground coffee.
          </p>
          <div class="dc-breakfast-notes">
            <span>✓ Vegetarian and lighter options available on request</span>
            <span>✓ Early breakfasts arranged for golfers and mountain walkers</span>
          </div>
        </div>

        <div class="dc-location-callout" id="location">
          <h3>The Harbour Setting</h3>
          <p>
            Situated on peaceful South Promenade in Newcastle’s historic harbour area.
            Only a pleasant five-minute seaside walk to the bustling central promenade, sandy beach, and town centre.
          </p>
          <ul class="dc-near-list">
            <li>Royal County Down Golf Club · 1 mile</li>
            <li>Donard Park &amp; Mourne Trails · 0.5 miles</li>
            <li>Silent Valley Mountain Park · 15 mins drive</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="dc-enquiry-section" id="enquiries" aria-labelledby="dc-enquiries-title">
      <div class="dc-enquiry-card">
        <div class="dc-enquiry-info">
          <span class="dc-kicker">Reservations</span>
          <h2 id="dc-enquiries-title">Enquire About Your Stay</h2>
          <p class="dc-enquiry-lede">
            As a small independent guesthouse, we manage room reservations personally.
            Contact us by telephone or email with your preferred dates, and we will confirm availability and current seasonal rates.
          </p>
          <div class="dc-enquiry-actions">
            <a class="dc-btn dc-btn--primary" href={phoneHref}>Ring {phone}</a>
            <a class="dc-btn dc-btn--outline" href={mailto}>Send Email Enquiry</a>
          </div>
        </div>

        <address class="dc-address-card">
          <strong>Dacara Guesthouse</strong>
          <span>47 South Promenade</span>
          <span>Newcastle, County Down</span>
          <span>BT33 0EY</span>
          <a class="dc-phone-link" href={phoneHref}>{phone}</a>
          <a class="dc-mail-link" href={mailto}>{email}</a>
          <a class="dc-map-link" href={maps} rel="noopener noreferrer">View on Google Maps</a>
        </address>
      </div>
    </section>
  </main>

  <footer class="dc-footer">
    <p class="dc-footer-name">Dacara Guesthouse</p>
    <p>47 South Promenade, Newcastle · Victorian Bed &amp; Breakfast · Dundrum Bay</p>
  </footer>
</ConceptLayout>
