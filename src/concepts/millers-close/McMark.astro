---
interface Props {
  size?: number;
  tone?: "copper" | "forest" | "parchment";
}
const { size = 40, tone = "copper" } = Astro.props;
const stroke = tone === "forest" ? "#1d2b24" : tone === "parchment" ? "#f6f2ea" : "#b87246";
---
<svg width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <circle cx="24" cy="24" r="20.5" stroke={stroke} stroke-width="1.5" />
  <circle cx="24" cy="24" r="10.5" stroke={stroke} stroke-width="1.5" />
  <circle cx="24" cy="24" r="3" stroke={stroke} stroke-width="1.4" />
  <path d="M24 3.5V13.5M24 34.5V44.5M3.5 24H13.5M34.5 24H44.5M9.5 9.5L16.5 16.5M31.5 31.5L38.5 38.5M38.5 9.5L31.5 16.5M16.5 31.5L9.5 38.5" stroke={stroke} stroke-width="1.3" />
</svg>
