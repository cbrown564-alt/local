---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";
import McMark from "./McMark.astro";

/* Millers Close Holiday Accommodation — 167 Bryansford Road, Kilcoo, Co. Down, BT34 5LW.
   Sources (live-fetched 26 Nov 2026): millersclose.com (/, /contactus).
   - Certified Tourist Establishment in the foothills of the Mourne Mountains,
     on the edge of Tollymore Forest Park.
   - Named stays on site: Thrashing Mill, The Haystacks (Haystack E is the
     only exclusive pet-friendly accommodation), The Paddy Wagon,
     Jimmy's Cottage, Pat's Cottage.
   - Direct booking portal:
     https://booking-directly.com/widgets/zSnGuXLhWNezOp6F9XbxwozaOZazm2TPG2z7TLCzYRwQNOqvODx8dMxXMLSLt/properties
   - Gift Cards: https://www.millersclose.com/giftcards
   - On-site beauty: Miella Makeup & Beauty (https://www.millersclose.com/miellamakeupandbeauty)
   - Contact: enquiries@millersclose.com · 07562 419693 (WhatsApp Message Only).
   Brief: research/concepts/millers-close/millers-close-elevation-brief.md */

const bookingUrl = "https://booking-directly.com/widgets/zSnGuXLhWNezOp6F9XbxwozaOZazm2TPG2z7TLCzYRwQNOqvODx8dMxXMLSLt/properties";
const giftCardsUrl = "https://www.millersclose.com/giftcards";
const beautyUrl = "https://www.millersclose.com/miellamakeupandbeauty";
const email = "enquiries@millersclose.com";
const whatsappNum = "07562 419693";
const whatsappHref = "https://wa.me/447562419693";
const facebook = "https://www.facebook.com/Millers.Close/";
const instagram = "https://www.instagram.com/millersclose/";
const mapHref = "https://www.google.co.uk/maps/place/Millers+Close+Holiday+Cottages/@54.2189972,-5.9932053,17z";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600;700&display=swap";

const stays = [
  {
    no: "01",
    name: "Thrashing Mill",
    tag: "Heritage Conversion",
    note: "Characterful self-catering stay rooted in the working history of Millers Close.",
    href: "https://www.millersclose.com/thrashingmill",
  },
  {
    no: "02",
    name: "The Haystacks",
    tag: "Haystack E — Exclusive Pet-Friendly Stay",
    note: "Countryside retreat nestled in the Mourne foothills. Bringing a dog? Book Haystack E.",
    href: "https://www.millersclose.com/haystacks",
  },
  {
    no: "03",
    name: "The Paddy Wagon",
    tag: "Unique Stay",
    note: "A memorable escape on the edge of Tollymore Forest Park for couples and outdoor breaks.",
    href: "https://www.millersclose.com/paddywagon",
  },
  {
    no: "04",
    name: "Jimmy's Cottage",
    tag: "Holiday Cottage",
    note: "Self-catering cottage looking out to the surrounding hills and minutes from Tollymore trails.",
    href: "https://www.millersclose.com/jimmyscottage",
  },
  {
    no: "05",
    name: "Pat's Cottage",
    tag: "Holiday Cottage",
    note: "Cosy self-catering base for families and friends exploring the Mourne Mountains.",
    href: "https://www.millersclose.com/patscottage",
  },
];
---

<ConceptLayout
  title="Millers Close Holiday Accommodation — Kilcoo, Foothills of the Mournes"
  slug="millers-close"
  bodyClass="concept-page concept-millers"
  lang="en-GB"
  businessName="Millers Close Holiday Accommodation"
  town="Kilcoo / Castlewellan"
  fontHref={fontHref}
  bannerNote="The granite cottages at dawn and Haystack retreat views are AI-generated visualisations. Live availability opens Millers Close's own booking-directly.com calendar; questions go via WhatsApp 07562 419693 or enquiries@millersclose.com."
>
  <header class="mc-header">
    <div class="mc-header-inner">
      <a class="mc-brand" href="#top">
        <McMark size={34} tone="copper" />
        <span>
          <strong>Millers Close</strong>
          <small>167 Bryansford Road, Kilcoo · Tollymore Edge</small>
        </span>
      </a>
      <nav class="mc-nav" aria-label="Millers Close">
        <a href="#stays">Five Stays</a>
        <a href="#haystack-e">Haystack E (Pets)</a>
        <a href="#extras">Gift Cards &amp; Beauty</a>
        <a href="#enquire">WhatsApp &amp; Contact</a>
      </nav>
      <a class="mc-header-cta" href={bookingUrl} rel="noopener noreferrer">Live Calendar ↗</a>
    </div>
  </header>

  <main id="top" class="mc-main">
    <section class="mc-split-hero" aria-labelledby="mc-hero-title">
      <figure class="mc-hero-visual">
        <ResponsiveImage
          src="/media/concepts/millers-close/millers-close-forest-edge.jpg"
          alt="Granite stone cottages with warm windows tucked beside pine trees beneath misty Mourne Mountain foothills at dawn"
          width={1376}
          height={768}
          loading="eager"
          sizes="(max-width: 960px) 100vw, 50vw"
          class="mc-hero-img"
        />
        <figcaption>Mourne foothills &amp; Tollymore forest edge atmosphere. Visualisation (AI-generated).</figcaption>
      </figure>

      <div class="mc-hero-canvas">
        <p class="mc-seal">Certified Tourist Establishment · Kilcoo, BT34 5LW</p>
        <h1 id="mc-hero-title">Tucked against Tollymore Forest, <em>under the Mourne foothills.</em></h1>
        <p class="mc-lede">
          Five character self-catering stays — from the heritage Thrashing Mill
          and The Paddy Wagon to Jimmy's Cottage, Pat's Cottage and The
          Haystacks — all booked directly with zero third-party commission.
        </p>

        <div class="mc-hero-actions">
          <a class="mc-btn mc-btn--forest" href={bookingUrl} rel="noopener noreferrer">Check live availability ↗</a>
          <a class="mc-btn mc-btn--outline" href={whatsappHref} rel="noopener noreferrer">WhatsApp {whatsappNum} ↗</a>
        </div>

        <p class="mc-hero-note">
          WhatsApp Message Only ({whatsappNum}) ·{" "}
          <a href={`mailto:${email}`}>{email}</a>
        </p>
      </div>
    </section>

    <section class="mc-pet-plate" id="haystack-e" aria-labelledby="mc-pet-title">
      <div class="mc-wrap mc-pet-grid">
        <div class="mc-pet-copy">
          <p class="mc-kicker">Bringing Your Dog?</p>
          <h2 id="mc-pet-title">Haystack E is our exclusive pet-friendly retreat.</h2>
          <p>
            So that guests with allergies and guests bringing a four-legged
            companion are both properly looked after,{" "}
            <strong>Haystack E is the only pet-friendly accommodation at Millers Close</strong>.
            Check Haystack E straight on our live calendar or drop us a quick
            WhatsApp message before you book.
          </p>
          <div class="mc-pet-actions">
            <a class="mc-btn mc-btn--copper" href={bookingUrl} rel="noopener noreferrer">Check Haystack E dates ↗</a>
            <a class="mc-btn mc-btn--ghost-light" href={whatsappHref} rel="noopener noreferrer">Message on WhatsApp ↗</a>
          </div>
        </div>

        <figure class="mc-pet-figure">
          <ResponsiveImage
            src="/media/concepts/millers-close/millers-close-haystack-retreat.jpg"
            alt="Cosy timber retreat interior looking through glazed doors onto a private gravel firepit garden and Mourne foothills"
            width={1376}
            height={768}
            sizes="(max-width: 960px) 100vw, 52vw"
            class="mc-pet-img"
          />
          <figcaption>Foothills cabin &amp; private garden mood. Visualisation (AI-generated).</figcaption>
        </figure>
      </div>
    </section>

    <section class="mc-section mc-stays" id="stays" aria-labelledby="mc-stays-title">
      <div class="mc-wrap">
        <div class="mc-stays-head">
          <div>
            <p class="mc-kicker mc-kicker--dark">The Five Stays</p>
            <h2 id="mc-stays-title">Choose your corner of Millers Close.</h2>
          </div>
          <a class="mc-btn mc-btn--forest" href={bookingUrl} rel="noopener noreferrer">Open full direct calendar ↗</a>
        </div>

        <ol class="mc-ledger">
          {stays.map((s) => (
            <li class="mc-ledger-item">
              <span class="mc-ledger-no">{s.no}</span>
              <div class="mc-ledger-body">
                <span class="mc-ledger-tag">{s.tag}</span>
                <h3>{s.name}</h3>
                <p>{s.note}</p>
              </div>
              <div class="mc-ledger-actions">
                <a class="mc-link-primary" href={bookingUrl} rel="noopener noreferrer">Book direct ↗</a>
                <a class="mc-link-sub" href={s.href} rel="noopener noreferrer">Stay details ↗</a>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="mc-extras" id="extras" aria-labelledby="mc-extras-title">
      <div class="mc-wrap mc-extras-grid">
        <article class="mc-extra-panel">
          <p class="mc-kicker mc-kicker--dark">Gifting a Mourne Break</p>
          <h2 id="mc-extras-title">Millers Close Gift Cards</h2>
          <p>
            Give someone a quiet weekend on the edge of Tollymore Forest Park —
            gift cards are ready to order directly online.
          </p>
          <a class="mc-btn mc-btn--forest" href={giftCardsUrl} rel="noopener noreferrer">Order a Gift Card ↗</a>
        </article>

        <article class="mc-extra-panel mc-extra-panel--tinted">
          <p class="mc-kicker mc-kicker--dark">Right On Site</p>
          <h2>Miella Makeup &amp; Beauty</h2>
          <p>
            Staying for a wedding or family celebration in County Down? Explore
            Miella Makeup &amp; Beauty right here at Millers Close.
          </p>
          <a class="mc-btn mc-btn--outline" href={beautyUrl} rel="noopener noreferrer">Visit Miella Makeup &amp; Beauty ↗</a>
        </article>
      </div>
    </section>

    <section class="mc-section mc-contact" id="enquire" aria-labelledby="mc-contact-title">
      <div class="mc-wrap mc-contact-grid">
        <div>
          <p class="mc-kicker mc-kicker--dark">Questions &amp; Multi-Cottage Stays</p>
          <h2 id="mc-contact-title">Message on WhatsApp or write directly.</h2>
          <p>
            For instant dates use our{" "}
            <a href={bookingUrl} rel="noopener noreferrer">live booking calendar ↗</a>.
            For questions about Haystack E, family group bookings or arrival
            details, WhatsApp us on <strong>{whatsappNum} (Message Only)</strong>{" "}
            or compose an email straight to{" "}
            <a href={`mailto:${email}`}>{email}</a>.
          </p>
          <p class="mc-addr">
            167 Bryansford Road, Kilcoo, Co. Down, BT34 5LW ·{" "}
            <a href={mapHref} rel="noopener noreferrer">Google Maps ↗</a>
          </p>
        </div>

        <form class="mc-form" id="mc-form" data-email={email}>
          <div class="mc-row">
            <label>
              <span>Which stay?</span>
              <select name="stay">
                <option value="Any available stay">Any available stay</option>
                <option value="Haystack E (Pet Friendly)">Haystack E (Pet Friendly)</option>
                <option value="Thrashing Mill">Thrashing Mill</option>
                <option value="The Haystacks">The Haystacks</option>
                <option value="The Paddy Wagon">The Paddy Wagon</option>
                <option value="Jimmy's Cottage">Jimmy's Cottage</option>
                <option value="Pat's Cottage">Pat's Cottage</option>
              </select>
            </label>
            <label>
              <span>Preferred dates</span>
              <input name="dates" placeholder="e.g. 2 nights in May" />
            </label>
          </div>
          <div class="mc-row">
            <label>
              <span>Your name</span>
              <input name="name" autocomplete="name" required />
            </label>
            <label>
              <span>Phone or WhatsApp</span>
              <input name="phone" type="tel" autocomplete="tel" />
            </label>
          </div>
          <label>
            <span>Your question</span>
            <textarea name="query" rows="2"></textarea>
          </label>
          <button class="mc-btn mc-btn--forest mc-btn--full" type="submit">Open enquiry email →</button>
        </form>
      </div>
    </section>
  </main>

  <footer class="mc-footer">
    <div class="mc-wrap mc-footer-inner">
      <div class="mc-footer-brand">
        <McMark size={30} tone="parchment" />
        <span><strong>Millers Close Holiday Accommodation</strong> · 167 Bryansford Road, Kilcoo, BT34 5LW</span>
      </div>
      <p class="mc-footer-right">
        <a href={whatsappHref} rel="noopener noreferrer">WhatsApp {whatsappNum}</a> · <a href={`mailto:${email}`}>{email}</a> · <a href={facebook} rel="noopener noreferrer">Facebook</a> · <a href={instagram} rel="noopener noreferrer">Instagram</a>
      </p>
    </div>
  </footer>

  <script>
    const form = document.getElementById("mc-form") as HTMLFormElement | null;
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const d = new FormData(form);
      const stay = String(d.get("stay") || "Millers Close");
      const body = [
        `Stay: ${stay}`,
        `Preferred dates: ${d.get("dates") || ""}`,
        `Name: ${d.get("name") || ""}`,
        `Phone / WhatsApp: ${d.get("phone") || ""}`,
        "",
        String(d.get("query") || ""),
      ].join("\n");
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`Enquiry: ${stay} — Millers Close`)}&body=${encodeURIComponent(body)}`;
    });
  </script>
</ConceptLayout>
