---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import McMark from "./McMark.astro";

/* Millers Close Holiday Accommodation: 167 Bryansford Road, Kilcoo, Co. Down, BT34 5LW.
   Sources (live-fetched 26 Nov 2026): millersclose.com (/, /contactus).
   - Certified Tourist Establishment in the foothills of the Mourne Mountains,
     on the edge of Tollymore Forest Park.
   - Named stays on site: Thrashing Mill, The Paddy Wagon, Jimmy's Cottage,
     Pat's Cottage, The Haystacks (Haystack E is the only exclusive pet-friendly
     accommodation).
   - Direct booking portal:
     https://booking-directly.com/widgets/zSnGuXLhWNezOp6F9XbxwozaOZazm2TPG2z7TLCzYRwQNOqvODx8dMxXMLSLt/properties
   - Gift Cards: https://www.millersclose.com/giftcards
   - On-site beauty: Miella Makeup & Beauty (https://www.millersclose.com/miellamakeupandbeauty)
   - Contact: enquiries@millersclose.com, 07562 419693 (WhatsApp Message Only). */

const bookingUrl =
  "https://booking-directly.com/widgets/zSnGuXLhWNezOp6F9XbxwozaOZazm2TPG2z7TLCzYRwQNOqvODx8dMxXMLSLt/properties";
const giftCardsUrl = "https://www.millersclose.com/giftcards";
const beautyUrl = "https://www.millersclose.com/miellamakeupandbeauty";
const email = "enquiries@millersclose.com";
const whatsappNum = "07562 419693";
const whatsappHref = "https://wa.me/447562419693";
const facebook = "https://www.facebook.com/Millers.Close/";
const instagram = "https://www.instagram.com/millersclose/";
const mapHref =
  "https://www.google.co.uk/maps/place/Millers+Close+Holiday+Cottages/@54.2189972,-5.9932053,17z";

const stays = [
  {
    id: "thrashing-mill",
    name: "Thrashing Mill",
    selectValue: "Thrashing Mill",
    character: "Heritage conversion",
    summary:
      "Characterful self-catering stay rooted in the working history of Millers Close, set quietly in the Mourne foothills with direct access to Tollymore Forest Park.",
    petPolicy: "Pet-free stay (for dogs, choose Haystack E)",
    bookingNote: "Booked directly on our live calendar with zero agency commission",
    href: "https://www.millersclose.com/thrashingmill",
  },
  {
    id: "paddy-wagon",
    name: "The Paddy Wagon",
    selectValue: "The Paddy Wagon",
    character: "Unique stay",
    summary:
      "A distinctive self-catering escape on the edge of Tollymore Forest Park, made for couples and outdoor breaks exploring the Mourne Mountains.",
    petPolicy: "Pet-free stay (for dogs, choose Haystack E)",
    bookingNote: "Booked directly on our live calendar with zero agency commission",
    href: "https://www.millersclose.com/paddywagon",
  },
  {
    id: "jimmys-cottage",
    name: "Jimmy's Cottage",
    selectValue: "Jimmy's Cottage",
    character: "Holiday cottage",
    summary:
      "Self-catering stone cottage looking out across the surrounding County Down hills, minutes from Tollymore trails, Castlewellan, and Newcastle.",
    petPolicy: "Pet-free stay (for dogs, choose Haystack E)",
    bookingNote: "Booked directly on our live calendar with zero agency commission",
    href: "https://www.millersclose.com/jimmyscottage",
  },
  {
    id: "pats-cottage",
    name: "Pat's Cottage",
    selectValue: "Pat's Cottage",
    character: "Holiday cottage",
    summary:
      "A cosy self-catering base for families and friends gathering in the foothills of the Mourne Mountains, right off Bryansford Road in Kilcoo.",
    petPolicy: "Pet-free stay (for dogs, choose Haystack E)",
    bookingNote: "Booked directly on our live calendar with zero agency commission",
    href: "https://www.millersclose.com/patscottage",
  },
  {
    id: "haystacks",
    name: "The Haystacks",
    selectValue: "Haystack E (Pet Friendly)",
    character: "Countryside retreats including pet-friendly Haystack E",
    summary:
      "Countryside retreats nestled in the Mourne foothills. Travelling with a dog? Haystack E is our exclusive pet-friendly accommodation at Millers Close.",
    petPolicy: "Haystack E is our sole pet-friendly stay; other Haystacks remain pet-free",
    bookingNote: "Check Haystack E directly on our live calendar or message us on WhatsApp first",
    href: "https://www.millersclose.com/haystacks",
  },
];
---

<ConceptLayout
  title="Millers Close Holiday Accommodation, Kilcoo, Foothills of the Mournes"
  slug="millers-close"
  bodyClass="concept-page concept-millers"
  lang="en-GB"
  businessName="Millers Close Holiday Accommodation"
  town="Kilcoo / Castlewellan"
  bannerNote="The granite cottages at dawn and Haystack retreat views are indicative visualisations. Live availability opens Millers Close's own booking-directly.com calendar; questions go via WhatsApp 07562 419693 or enquiries@millersclose.com."
>
  <header class="mc-header" data-mc-header>
    <div class="mc-header-inner">
      <a class="mc-brand" href="#top">
        <McMark size={28} tone="copper" />
        <span>Millers Close</span>
      </a>
      <nav class="mc-nav" aria-label="Primary">
        <a href="#stays">Five stays</a>
        <a href="#haystack-e">Haystack E</a>
        <a href="#extras">Gift cards and beauty</a>
        <a href="#location">Kilcoo</a>
      </nav>
      <div class="mc-header-actions">
        <a class="mc-header-cta" href={bookingUrl} rel="noopener noreferrer">Live calendar</a>
      </div>
    </div>
  </header>

  <main id="top" class="mc-main">
    <section class="mc-hero" aria-labelledby="mc-hero-title">
      <div class="mc-hero-sentinel" data-mc-sentinel aria-hidden="true"></div>

      <div class="mc-hero-media">
        <picture>
          <source
            srcset="/media/concepts/millers-close/millers-close-forest-edge-640.webp 640w, /media/concepts/millers-close/millers-close-forest-edge-1265.webp 1265w"
            sizes="100vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/millers-close/millers-close-forest-edge.jpg"
            alt="Granite stone cottages with warm windows tucked beside pine trees beneath misty Mourne Mountain foothills at dawn"
            width="1376"
            height="768"
            loading="eager"
          />
        </picture>
      </div>

      <div class="mc-hero-scrim" aria-hidden="true"></div>

      <div class="mc-wrap mc-hero-content">
        <div class="mc-hero-copy">
          <h1 id="mc-hero-title">Stone cottages tucked against Tollymore Forest.</h1>
          <p class="mc-hero-sub">
            Five self-catering stays in the Mourne foothills, certified for tourism and booked
            directly with zero commission.
          </p>
          <div class="mc-hero-foot">
            <a class="mc-btn mc-btn--light" href={bookingUrl} rel="noopener noreferrer">
              Check live availability
            </a>
            <p class="mc-hero-caption">
              Mourne foothills and Tollymore forest edge atmosphere. Indicative visualisation.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="mc-section mc-stays" id="stays" aria-labelledby="mc-stays-title">
      <div class="mc-wrap">
        <div class="mc-stays-head">
          <div>
            <h2 id="mc-stays-title">Choose your corner of Millers Close.</h2>
            <p class="mc-section-copy">
              A Certified Tourist Establishment on Bryansford Road in Kilcoo. Browse each of our
              five named stays and book straight on our live calendar with zero commission.
            </p>
          </div>
          <a class="mc-text-link" href={bookingUrl} rel="noopener noreferrer">
            Open full live calendar
          </a>
        </div>

        <div class="mc-tabs" role="tablist" aria-label="Five stays at Millers Close">
          {stays.map((stay, idx) => (
            <button
              type="button"
              role="tab"
              id={`mc-tab-${stay.id}`}
              aria-selected={idx === 0 ? "true" : "false"}
              aria-controls={`mc-panel-${stay.id}`}
              tabindex={idx === 0 ? "0" : "-1"}
              class={`mc-tab${idx === 0 ? " is-active" : ""}`}
              data-mc-tab={stay.id}
            >
              {stay.name}
            </button>
          ))}
        </div>

        <div class="mc-stay-stage">
          {stays.map((stay, idx) => (
            <article
              id={`mc-panel-${stay.id}`}
              role="tabpanel"
              aria-labelledby={`mc-tab-${stay.id}`}
              class={`mc-stay-panel${idx === 0 ? " is-active" : ""}`}
              data-mc-panel={stay.id}
              hidden={idx !== 0}
            >
              <div class="mc-stay-story">
                <h3>{stay.name}</h3>
                <p>{stay.summary}</p>
                <div class="mc-stay-actions">
                  <a class="mc-btn mc-btn--forest" href={bookingUrl} rel="noopener noreferrer">
                    Check live dates
                  </a>
                  <a class="mc-text-link" href={stay.href} rel="noopener noreferrer">
                    Read stay details
                  </a>
                  <a class="mc-text-link" href="#enquire" data-mc-select-stay={stay.selectValue}>
                    Ask about this stay
                  </a>
                </div>
              </div>

              <dl class="mc-spec-list">
                <div class="mc-spec-row">
                  <dt>Stay style</dt>
                  <dd>{stay.character}</dd>
                </div>
                <div class="mc-spec-row">
                  <dt>Pet policy</dt>
                  <dd>{stay.petPolicy}</dd>
                </div>
                <div class="mc-spec-row">
                  <dt>Direct booking</dt>
                  <dd>{stay.bookingNote}</dd>
                </div>
                <div class="mc-spec-row">
                  <dt>WhatsApp desk</dt>
                  <dd>
                    <a href={whatsappHref} rel="noopener noreferrer">{whatsappNum}</a>
                    {" (message only)"}
                  </dd>
                </div>
              </dl>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mc-section mc-pet-stage" id="haystack-e" aria-labelledby="mc-pet-title">
      <div class="mc-wrap mc-pet-grid">
        <div class="mc-pet-copy">
          <h2 id="mc-pet-title">Haystack E is our exclusive pet-friendly retreat.</h2>
          <p>
            So that guests with allergies and guests bringing a four-legged companion are both
            properly looked after, Haystack E is the only pet-friendly accommodation at Millers
            Close. Check Haystack E directly on our live calendar or drop us a quick WhatsApp
            message before you book.
          </p>

          <dl class="mc-pet-ledger">
            <div>
              <dt>Exclusive stay</dt>
              <dd>Haystack E (pet-friendly); all other cottages kept pet-free</dd>
            </div>
            <div>
              <dt>Commission</dt>
              <dd>Zero agency fees when booking direct</dd>
            </div>
            <div>
              <dt>WhatsApp</dt>
              <dd>
                <a href={whatsappHref} rel="noopener noreferrer">{whatsappNum}</a>
                {" (message only)"}
              </dd>
            </div>
          </dl>

          <a class="mc-btn mc-btn--copper" href={bookingUrl} rel="noopener noreferrer">
            Check Haystack E dates
          </a>
        </div>

        <figure class="mc-plate">
          <picture>
            <source
              srcset="/media/concepts/millers-close/millers-close-haystack-retreat-640.webp 640w, /media/concepts/millers-close/millers-close-haystack-retreat-1265.webp 1265w"
              sizes="(max-width: 960px) 100vw, 52vw"
              type="image/webp"
            />
            <img
              src="/media/concepts/millers-close/millers-close-haystack-retreat.jpg"
              alt="Cosy timber retreat interior looking through glazed doors onto a private gravel firepit garden and Mourne foothills"
              width="1376"
              height="768"
              loading="lazy"
            />
          </picture>
          <figcaption>Foothills cabin and private garden mood. Indicative visualisation.</figcaption>
        </figure>
      </div>
    </section>

    <section class="mc-section mc-extras" id="extras" aria-labelledby="mc-extras-title">
      <div class="mc-wrap mc-extras-grid">
        <div class="mc-extra-col">
          <h2 id="mc-extras-title">Millers Close gift cards.</h2>
          <p>
            Give someone a quiet weekend on the edge of Tollymore Forest Park. Millers Close
            gift cards can be ordered directly online for any of our five stays.
          </p>
          <a class="mc-btn mc-btn--forest" href={giftCardsUrl} rel="noopener noreferrer">
            Order a gift card
          </a>
        </div>

        <div class="mc-extra-col mc-extra-col--divided">
          <h2>Miella Makeup and Beauty on site.</h2>
          <p>
            Staying for a wedding or family celebration in County Down? Miella Makeup and Beauty
            operates right here at Millers Close.
          </p>
          <a class="mc-text-link" href={beautyUrl} rel="noopener noreferrer">
            Visit Miella Makeup and Beauty
          </a>
        </div>
      </div>
    </section>

    <section class="mc-section mc-contact" id="enquire" aria-labelledby="mc-contact-title">
      <div class="mc-wrap mc-contact-grid">
        <div class="mc-contact-intro">
          <h2 id="mc-contact-title">Message on WhatsApp or write directly.</h2>
          <p>
            For instant dates use our live booking calendar. For questions about Haystack E,
            multi-cottage family stays, or arrival details, message us on WhatsApp or send an
            enquiry straight to Kilcoo.
          </p>

          <dl class="mc-contact-list">
            <div class="mc-contact-row">
              <dt>WhatsApp</dt>
              <dd>
                <a href={whatsappHref} rel="noopener noreferrer">{whatsappNum}</a>
                {" (message only)"}
              </dd>
            </div>
            <div class="mc-contact-row">
              <dt>Email</dt>
              <dd><a href={`mailto:${email}`}>{email}</a></dd>
            </div>
            <div class="mc-contact-row">
              <dt>Address</dt>
              <dd>167 Bryansford Road, Kilcoo, Co. Down, BT34 5LW</dd>
            </div>
            <div class="mc-contact-row">
              <dt>Social</dt>
              <dd>
                <a href={facebook} rel="noopener noreferrer">Facebook</a>
                {" · "}
                <a href={instagram} rel="noopener noreferrer">Instagram</a>
              </dd>
            </div>
          </dl>
        </div>

        <form class="mc-form" id="mc-form" data-email={email}>
          <div class="mc-row">
            <label>
              <span>Which stay</span>
              <select name="stay" data-mc-stay-select>
                <option value="Any available stay">Any available stay</option>
                <option value="Haystack E (Pet Friendly)">Haystack E (Pet Friendly)</option>
                <option value="Thrashing Mill">Thrashing Mill</option>
                <option value="The Paddy Wagon">The Paddy Wagon</option>
                <option value="Jimmy's Cottage">Jimmy's Cottage</option>
                <option value="Pat's Cottage">Pat's Cottage</option>
                <option value="The Haystacks">The Haystacks</option>
              </select>
            </label>
            <label>
              <span>Preferred dates</span>
              <input name="dates" placeholder="e.g. 2 nights in May" />
            </label>
          </div>
          <div class="mc-row">
            <label>
              <span>Your name</span>
              <input name="name" autocomplete="name" required placeholder="Full name" />
            </label>
            <label>
              <span>Phone or WhatsApp</span>
              <input name="phone" type="tel" autocomplete="tel" placeholder="07..." />
            </label>
          </div>
          <label>
            <span>Your question</span>
            <textarea name="query" rows="3" placeholder="Tell us about your group, dog details for Haystack E, or preferred arrival..."></textarea>
          </label>
          <p class="mc-form-echo" data-mc-echo aria-live="polite">
            Enquiry for Any available stay
          </p>
          <button class="mc-btn mc-btn--forest" type="submit">Send direct enquiry</button>
        </form>
      </div>
    </section>

    <section class="mc-section mc-map-band" id="location" aria-labelledby="mc-location-title">
      <div class="mc-wrap">
        <div class="mc-location-head">
          <h2 id="mc-location-title">On Bryansford Road at the edge of Tollymore.</h2>
          <p class="mc-section-copy">
            Set in Kilcoo at the foot of the Mourne Mountains, a short drive from Tollymore
            Forest Park, Castlewellan Forest Park, and Newcastle seafront.
          </p>
        </div>

        <LocalAreaMap
          id="millers-close-map"
          kicker=""
          businessName="Millers Close"
          address="167 Bryansford Road, Kilcoo, Co. Down, BT34 5LW"
          lon={-5.9932053}
          lat={54.2189972}
          spanKm={16}
          mapHref={mapHref}
          markers={[
            { name: "Tollymore Park", lon: -5.945, lat: 54.222, note: "5 mins east", side: "r" },
            { name: "Castlewellan", lon: -5.941, lat: 54.258, note: "7 mins north", side: "t" },
            { name: "Newcastle", lon: -5.889, lat: 54.214, note: "10 mins east", side: "b" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="mc-footer">
    <div class="mc-wrap mc-footer-inner">
      <div class="mc-footer-brand">
        <McMark size={24} tone="parchment" />
        <div>
          <strong>Millers Close Holiday Accommodation</strong>
          <p>167 Bryansford Road, Kilcoo, Co. Down, BT34 5LW</p>
        </div>
      </div>
      <div class="mc-footer-links">
        <a href={whatsappHref} rel="noopener noreferrer">WhatsApp {whatsappNum}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={facebook} rel="noopener noreferrer">Facebook</a>
        <a href={instagram} rel="noopener noreferrer">Instagram</a>
        <a href="#top">Back to top</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      // Sticky header surface separation once scrolled past hero top edge
      const header = document.querySelector("[data-mc-header]");
      const sentinel = document.querySelector("[data-mc-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            header.classList.toggle("is-scrolled", !entries[0].isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      // Five Stays Explorer segmented tablist
      const tabs = Array.from(document.querySelectorAll("[data-mc-tab]"));
      const panels = Array.from(document.querySelectorAll("[data-mc-panel]"));

      const activateTab = (targetId, moveFocus = false) => {
        tabs.forEach((tab) => {
          const active = tab.getAttribute("data-mc-tab") === targetId;
          tab.classList.toggle("is-active", active);
          tab.setAttribute("aria-selected", active ? "true" : "false");
          tab.setAttribute("tabindex", active ? "0" : "-1");
          if (active && moveFocus && tab instanceof HTMLElement) tab.focus();
        });
        panels.forEach((panel) => {
          const active = panel.getAttribute("data-mc-panel") === targetId;
          panel.classList.toggle("is-active", active);
          panel.hidden = !active;
        });
      };

      tabs.forEach((tab, idx) => {
        tab.addEventListener("click", () => {
          const id = tab.getAttribute("data-mc-tab");
          if (id) activateTab(id);
        });
        tab.addEventListener("keydown", (e) => {
          if (e.key !== "ArrowRight" && e.key !== "ArrowLeft" && e.key !== "Home" && e.key !== "End") return;
          e.preventDefault();
          let next = idx;
          if (e.key === "ArrowRight") next = (idx + 1) % tabs.length;
          if (e.key === "ArrowLeft") next = (idx - 1 + tabs.length) % tabs.length;
          if (e.key === "Home") next = 0;
          if (e.key === "End") next = tabs.length - 1;
          const nextId = tabs[next]?.getAttribute("data-mc-tab");
          if (nextId) activateTab(nextId, true);
        });
      });

      // Pre-select stay when jumping from Five Stays Explorer to form
      const staySelect = document.querySelector("[data-mc-stay-select]");
      const echo = document.querySelector("[data-mc-echo]");
      const form = document.getElementById("mc-form");

      const updateEcho = () => {
        if (!form || !echo) return;
        const stayLabel =
          staySelect instanceof HTMLSelectElement
            ? staySelect.value
            : "Any available stay";
        const datesInput = form.querySelector('input[name="dates"]');
        const dates = datesInput instanceof HTMLInputElement ? datesInput.value.trim() : "";
        echo.textContent = dates ? `Enquiry for ${stayLabel}, ${dates}` : `Enquiry for ${stayLabel}`;
      };

      document.querySelectorAll("[data-mc-select-stay]").forEach((link) => {
        link.addEventListener("click", () => {
          const val = link.getAttribute("data-mc-select-stay");
          if (staySelect instanceof HTMLSelectElement && val) {
            staySelect.value = val;
            staySelect.dispatchEvent(new Event("change", { bubbles: true }));
            updateEcho();
          }
        });
      });

      if (form instanceof HTMLFormElement) {
        form.addEventListener("input", updateEcho);
        form.addEventListener("change", updateEcho);
        updateEcho();

        form.addEventListener("submit", (event) => {
          event.preventDefault();
          if (!form.reportValidity()) return;
          const d = new FormData(form);
          const stay = String(d.get("stay") || "Millers Close");
          const body = [
            `Stay: ${stay}`,
            `Preferred dates: ${d.get("dates") || "Flexible"}`,
            `Name: ${d.get("name") || ""}`,
            `Phone / WhatsApp: ${d.get("phone") || ""}`,
            "",
            String(d.get("query") || ""),
          ].join("\n");
          const to = form.dataset.email || "enquiries@millersclose.com";
          const subject = `Stay enquiry: ${stay}, Millers Close`;
          const url = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
          const ev = new CustomEvent("mm:enquiry", {
            cancelable: true,
            detail: { to, subject, body, url },
          });
          if (window.dispatchEvent(ev)) {
            window.location.href = url;
          }
        });
      }
    })();
  </script>
</ConceptLayout>
