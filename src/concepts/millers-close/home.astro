---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import McMark from "./McMark.astro";

/* Millers Close Holiday Accommodation — 167 Bryansford Road, Kilcoo, Co. Down, BT34 5LW.
   Sources (live-fetched 26 Nov 2026): millersclose.com (/, /contactus).
   - Certified Tourist Establishment in the foothills of the Mourne Mountains,
     on the edge of Tollymore Forest Park.
   - Named stays on site: Thrashing Mill, The Haystacks (Haystack E is the
     only exclusive pet-friendly accommodation), The Paddy Wagon,
     Jimmy's Cottage, Pat's Cottage.
   - Direct booking portal:
     https://booking-directly.com/widgets/zSnGuXLhWNezOp6F9XbxwozaOZazm2TPG2z7TLCzYRwQNOqvODx8dMxXMLSLt/properties
   - Gift Cards: https://www.millersclose.com/giftcards
   - On-site beauty: Miella Makeup & Beauty (https://www.millersclose.com/miellamakeupandbeauty)
   - Contact: enquiries@millersclose.com · 07562 419693 (WhatsApp Message Only).
   Brief: research/concepts/millers-close/millers-close-elevation-brief.md */

const bookingUrl = "https://booking-directly.com/widgets/zSnGuXLhWNezOp6F9XbxwozaOZazm2TPG2z7TLCzYRwQNOqvODx8dMxXMLSLt/properties";
const giftCardsUrl = "https://www.millersclose.com/giftcards";
const beautyUrl = "https://www.millersclose.com/miellamakeupandbeauty";
const email = "enquiries@millersclose.com";
const whatsappNum = "07562 419693";
const whatsappHref = "https://wa.me/447562419693";
const facebook = "https://www.facebook.com/Millers.Close/";
const instagram = "https://www.instagram.com/millersclose/";
const mapHref = "https://www.google.co.uk/maps/place/Millers+Close+Holiday+Cottages/@54.2189972,-5.9932053,17z";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;600;700&display=swap";

const stays = [
  {
    name: "Thrashing Mill",
    tag: "Heritage Conversion",
    note: "Characterful self-catering stay rooted in the working history of Millers Close.",
    href: "https://www.millersclose.com/thrashingmill",
  },
  {
    name: "The Haystacks",
    tag: "Haystack E — Pet Friendly",
    note: "Countryside retreat nestled in the Mourne foothills. Bringing a dog? Haystack E is our exclusive pet-friendly accommodation.",
    href: "https://www.millersclose.com/haystacks",
  },
  {
    name: "The Paddy Wagon",
    tag: "Unique Stay",
    note: "A memorable escape on the edge of Tollymore Forest Park for couples or outdoor breaks.",
    href: "https://www.millersclose.com/paddywagon",
  },
  {
    name: "Jimmy's Cottage",
    tag: "Holiday Cottage",
    note: "Self-catering cottage with views of the surrounding hills and easy access to Tollymore trails.",
    href: "https://www.millersclose.com/jimmyscottage",
  },
  {
    name: "Pat's Cottage",
    tag: "Holiday Cottage",
    note: "Cosy self-catering base for families and friends exploring the Mourne Mountains.",
    href: "https://www.millersclose.com/patscottage",
  },
];
---

<ConceptLayout
  title="Millers Close Holiday Accommodation — Kilcoo, Foothills of the Mournes"
  slug="millers-close"
  bodyClass="concept-page concept-millers"
  lang="en-GB"
  businessName="Millers Close Holiday Accommodation"
  town="Kilcoo / Castlewellan"
  fontHref={fontHref}
  bannerNote="The millwheel emblem is drawn for this page. Live availability hands straight to Millers Close's own booking-directly.com engine; enquiries open an email to enquiries@millersclose.com or WhatsApp 07562 419693."
>
  <div class="mc-strip">
    <span>167 Bryansford Road, Kilcoo, Co. Down BT34 5LW · Certified Tourist Establishment</span>
    <span class="mc-strip-r">
      <a href={whatsappHref} rel="noopener noreferrer">WhatsApp {whatsappNum}</a> · <a href={`mailto:${email}`}>{email}</a>
    </span>
  </div>

  <header class="mc-header">
    <a class="mc-brand" href="#top">
      <McMark size={38} tone="copper" />
      <span class="mc-brand-text">
        <strong>Millers Close</strong>
        <small>Mourne Foothills · Tollymore Edge</small>
      </span>
    </a>
    <nav class="mc-nav" aria-label="Millers Close">
      <a href="#stays">The Stays</a>
      <a href="#pets">Pets &amp; Extras</a>
      <a href="#enquire">Contact</a>
    </nav>
    <a class="mc-header-cta" href={bookingUrl} rel="noopener noreferrer">Book Direct ↗</a>
  </header>

  <main id="top">
    <section class="mc-hero" aria-labelledby="mc-hero-title">
      <div class="mc-wrap mc-hero-grid">
        <div>
          <p class="mc-kicker">Kilcoo · Edge of Tollymore Forest Park</p>
          <h1 id="mc-hero-title">Your countryside escape <em>in the heart of the Mourne Mountains.</em></h1>
          <p class="mc-lede">
            Certified self-catering cottages and unique stays tucked into the
            Mourne foothills — built for quiet romantic getaways, breaks with
            friends, and mornings straight onto the forest and mountain trails.
          </p>
          <div class="mc-hero-actions">
            <a class="mc-btn mc-btn--copper" href={bookingUrl} rel="noopener noreferrer">Check live availability &amp; book direct ↗</a>
            <a class="mc-btn mc-btn--ghost" href={giftCardsUrl} rel="noopener noreferrer">Gift Cards ↗</a>
          </div>
        </div>

        <aside class="mc-quick" aria-label="Direct booking summary">
          <p class="mc-kicker mc-kicker--dark">Why book direct</p>
          <h2>Five character stays, one direct calendar.</h2>
          <ul>
            <li><strong>Instant live dates</strong> across Thrashing Mill, The Haystacks, The Paddy Wagon, Jimmy's Cottage &amp; Pat's Cottage.</li>
            <li><strong>Bringing a pet?</strong> Haystack E is our exclusive pet-friendly accommodation — check it straight on the calendar.</li>
            <li><strong>On the doorstep:</strong> Tollymore Forest Park, Castlewellan and the Mourne foothills.</li>
          </ul>
          <a class="mc-btn mc-btn--forest mc-btn--full" href={bookingUrl} rel="noopener noreferrer">Open live booking calendar ↗</a>
        </aside>
      </div>
    </section>

    <section class="mc-section mc-stays" id="stays" aria-labelledby="mc-stays-title">
      <div class="mc-wrap">
        <div class="mc-head">
          <div>
            <p class="mc-kicker mc-kicker--dark">Accommodation</p>
            <h2 id="mc-stays-title">Choose your stay at Millers Close.</h2>
          </div>
          <p>
            Every stay has its own character and opens directly into our live
            booking calendar — no third-party booking mark-up.
          </p>
        </div>

        <div class="mc-stay-grid">
          {stays.map((s) => (
            <article class="mc-stay-card">
              <span class="mc-stay-tag">{s.tag}</span>
              <h3>{s.name}</h3>
              <p>{s.note}</p>
              <div class="mc-stay-links">
                <a href={bookingUrl} rel="noopener noreferrer">Check dates ↗</a>
                <a href={s.href} rel="noopener noreferrer">Details ↗</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mc-section mc-extras" id="pets" aria-labelledby="mc-extras-title">
      <div class="mc-wrap mc-extras-grid">
        <article class="mc-extra-box">
          <p class="mc-kicker mc-kicker--dark">Pet Policy</p>
          <h2 id="mc-extras-title">Bringing a dog? Book Haystack E.</h2>
          <p>
            So that guests with allergies and guests with dogs are both looked
            after properly, <strong>Haystack E is our only exclusive pet-friendly accommodation</strong>.
            Select Haystack E on the live booking calendar or message us on
            WhatsApp to check dates.
          </p>
        </article>

        <article class="mc-extra-box">
          <p class="mc-kicker mc-kicker--dark">On Site &amp; Gifting</p>
          <h2>Gift Cards &amp; Miella Makeup &amp; Beauty.</h2>
          <p>
            Treating someone to a Mourne escape or staying for a local wedding?
            Order a Millers Close Gift Card online or explore{" "}
            <a href={beautyUrl} rel="noopener noreferrer">Miella Makeup &amp; Beauty ↗</a>{" "}
            right on site.
          </p>
          <div class="mc-extra-actions">
            <a class="mc-btn mc-btn--forest" href={giftCardsUrl} rel="noopener noreferrer">Order a Gift Card ↗</a>
            <a class="mc-btn mc-btn--outline" href={whatsappHref} rel="noopener noreferrer">WhatsApp {whatsappNum} ↗</a>
          </div>
        </article>
      </div>
    </section>

    <section class="mc-section mc-contact" id="enquire" aria-labelledby="mc-contact-title">
      <div class="mc-wrap mc-contact-grid">
        <div>
          <p class="mc-kicker mc-kicker--dark">Questions &amp; Group Stays</p>
          <h2 id="mc-contact-title">Ask us about dates, Haystack E or multiple cottages.</h2>
          <p>
            For instant availability use our{" "}
            <a href={bookingUrl} rel="noopener noreferrer">live booking calendar ↗</a>.
            For questions, message us on WhatsApp (<strong>{whatsappNum} — WhatsApp Message Only</strong>)
            or compose an email below straight to{" "}
            <a href={`mailto:${email}`}>{email}</a>.
          </p>
          <p class="mc-addr">
            <strong>Address:</strong> 167 Bryansford Road, Kilcoo, Co. Down, BT34 5LW ·{" "}
            <a href={mapHref} rel="noopener noreferrer">Open Map ↗</a>
          </p>
        </div>

        <form class="mc-form" id="mc-form" data-email={email}>
          <div class="mc-row">
            <label>
              <span>Which stay?</span>
              <select name="stay">
                <option value="Any available stay">Any available stay</option>
                <option value="Haystack E (Pet Friendly)">Haystack E (Pet Friendly)</option>
                <option value="Thrashing Mill">Thrashing Mill</option>
                <option value="The Haystacks">The Haystacks</option>
                <option value="The Paddy Wagon">The Paddy Wagon</option>
                <option value="Jimmy's Cottage">Jimmy's Cottage</option>
                <option value="Pat's Cottage">Pat's Cottage</option>
              </select>
            </label>
            <label>
              <span>Preferred dates</span>
              <input name="dates" placeholder="e.g. 2 nights in May" />
            </label>
          </div>
          <div class="mc-row">
            <label>
              <span>Your name</span>
              <input name="name" autocomplete="name" required />
            </label>
            <label>
              <span>Phone or WhatsApp</span>
              <input name="phone" type="tel" autocomplete="tel" />
            </label>
          </div>
          <label>
            <span>Your question</span>
            <textarea name="query" rows="2"></textarea>
          </label>
          <button class="mc-btn mc-btn--forest mc-btn--full" type="submit">Open enquiry email →</button>
        </form>
      </div>
    </section>
  </main>

  <footer class="mc-footer">
    <div class="mc-wrap mc-footer-inner">
      <div class="mc-footer-brand">
        <McMark size={32} tone="parchment" />
        <div>
          <strong>Millers Close Holiday Accommodation</strong>
          <span>167 Bryansford Road, Kilcoo, Co. Down, BT34 5LW</span>
        </div>
      </div>
      <p class="mc-footer-right">
        <a href={whatsappHref} rel="noopener noreferrer">WhatsApp {whatsappNum}</a> · <a href={`mailto:${email}`}>{email}</a> · <a href={facebook} rel="noopener noreferrer">Facebook</a> · <a href={instagram} rel="noopener noreferrer">Instagram</a>
      </p>
    </div>
  </footer>

  <script>
    const form = document.getElementById("mc-form") as HTMLFormElement | null;
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const d = new FormData(form);
      const stay = String(d.get("stay") || "Millers Close");
      const body = [
        `Stay: ${stay}`,
        `Preferred dates: ${d.get("dates") || ""}`,
        `Name: ${d.get("name") || ""}`,
        `Phone / WhatsApp: ${d.get("phone") || ""}`,
        "",
        String(d.get("query") || ""),
      ].join("\n");
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`Enquiry: ${stay} — Millers Close`)}&body=${encodeURIComponent(body)}`;
    });
  </script>
</ConceptLayout>
