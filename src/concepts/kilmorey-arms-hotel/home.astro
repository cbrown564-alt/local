---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";

/* Kilmorey Arms Hotel — 41–43 Greencastle Street, Kilkeel, County Down, BT34 4BH.
   Sources (live-fetched 26 Nov 2026): kilmoreyarmshotel.co.uk (/, /rooms/,
   /dining/, /weddings/, /contact/) and FSA FHRS register (inspected 2026-07-06).
   - Historic family-run hotel in the Kingdom of Mourne & Northern Ireland's
     largest fishing port: ALL fish & shellfish sourced from less than a mile away.
   - 24 recently refurbished en-suite bedrooms (Single, Double, King, Family &
     Executive Suite) — full Irish breakfast included, pillow menu, free parking,
     dedicated desk, luxury toiletries, Wi-Fi.
   - Golden Years Getaway (over 60s): from £140pps — 2-night midweek B&B + 2-course dinner.
   - Meetings & Conferences: up to 300 delegates from £35 per room per hour.
   - Weddings: dedicated Wedding Planner & brochure; Kingdom of Mourne setting.
   - Live room bookings: https://kilmoreyarmshotel.co.uk/bookings/
   - Live Gift Vouchers: http://secure.kilmoreyarmshotel.co.uk/bookings/vouchers
   - Phone: +44 28 4176 2220 · Email: info@kilmoreyarmshotel.co.uk.
   Brief: research/concepts/kilmorey-arms-hotel/kilmorey-arms-hotel-elevation-brief.md */

const phone = "028 4176 2220";
const phoneIntl = "+44 28 4176 2220";
const phoneHref = "tel:+442841762220";
const email = "info@kilmoreyarmshotel.co.uk";
const bookUrl = "https://kilmoreyarmshotel.co.uk/bookings/";
const vouchersUrl = "http://secure.kilmoreyarmshotel.co.uk/bookings/vouchers";
const facebook = "https://www.facebook.com/kilmoreyarmshotelkilkeel/";
const instagram = "https://www.instagram.com/kilmoreyarmshotel/";
const mapHref = "https://www.google.com/maps/search/?api=1&query=41-43+Greencastle+Street+Kilkeel+BT34+4BH";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Marcellus&family=Nunito+Sans:wght@400;500;600;700&display=swap";

const doors = [
  {
    eyebrow: "24 En-Suite Bedrooms",
    title: "Stay in the Kingdom of Mourne",
    detail: "Single, Double, King, Family & Executive Suites — all including a full Irish breakfast, pillow menu and free car parking. Best rates direct.",
    cta: "Check live room rates ↗",
    href: bookUrl,
  },
  {
    eyebrow: "Over-60s Midweek Break",
    title: "Golden Years Getaway from £140pps",
    detail: "Two relaxed midweek nights on Greencastle Street with full Irish breakfasts and a two-course evening dinner.",
    cta: "Ask about Golden Years dates →",
    href: "#enquire",
  },
  {
    eyebrow: "Weddings & Conferences",
    title: "Up to 300 Delegates · From £35/hr",
    detail: "Dedicated Wedding Planner for bespoke Mourne receptions, plus flexible meeting & conference suites from £35 per room per hour.",
    cta: "Enquire with our events team →",
    href: "#enquire",
  },
];
---

<ConceptLayout
  title="Kilmorey Arms Hotel — Kingdom of Mourne, Kilkeel, County Down"
  slug="kilmorey-arms-hotel"
  bodyClass="concept-page concept-kilmorey"
  lang="en-GB"
  businessName="Kilmorey Arms Hotel"
  town="Kilkeel"
  fontHref={fontHref}
  bannerNote="The coastal hotel dining lounge and Kilkeel seafood plate are AI-generated visualisations. Room bookings and gift vouchers hand straight to Kilmorey Arms Hotel's own portals; wedding and event enquiries compose an email to info@kilmoreyarmshotel.co.uk."
>
  <header class="ka-header">
    <div class="ka-wrap ka-header-inner">
      <a class="ka-brand" href="#top">
        <strong>Kilmorey Arms Hotel</strong>
        <small>41–43 Greencastle Street · Kilkeel · Kingdom of Mourne</small>
      </a>
      <nav class="ka-nav" aria-label="Kilmorey Arms Hotel">
        <a href="#doors">Rooms &amp; Offers</a>
        <a href="#harbour">Under One Mile Seafood</a>
        <a href="#enquire">Weddings &amp; Events</a>
      </nav>
      <div class="ka-header-right">
        <a class="ka-tel" href={phoneHref}>{phone}</a>
        <a class="ka-book" href={bookUrl} rel="noopener noreferrer">Book Direct ↗</a>
      </div>
    </div>
  </header>

  <main id="top" class="ka-main">
    <section class="ka-hero" aria-labelledby="ka-hero-title">
      <figure class="ka-hero-media">
        <ResponsiveImage
          src="/media/concepts/kilmorey-arms-hotel/kilmorey-arms-coastal-lounge.jpg"
          alt="Refined coastal Irish hotel dining room with white-linen tables and brass lamps overlooking blue Atlantic harbour waters and Mourne peaks"
          width={1376}
          height={768}
          loading="eager"
          sizes="100vw"
          class="ka-hero-img"
        />
        <figcaption class="ka-hero-cap">Kingdom of Mourne coastal hotel atmosphere. Visualisation (AI-generated).</figcaption>
      </figure>
      <div class="ka-hero-scrim" aria-hidden="true"></div>

      <div class="ka-wrap ka-hero-inner">
        <p class="ka-kicker">Kilkeel · Northern Ireland's Largest Fishing Port</p>
        <h1 id="ka-hero-title">Family-run hospitality where the Mournes meet the harbour.</h1>
        <p class="ka-lede">
          Twenty-four refurbished en-suite bedrooms with full Irish breakfast,
          fish and shellfish landed less than a mile from our kitchen, Golden
          Years midweek breaks from £140pps, and weddings &amp; conferences up
          to 300 guests.
        </p>
        <div class="ka-hero-actions">
          <a class="ka-btn ka-btn--gold" href={bookUrl} rel="noopener noreferrer">Book direct for best rates ↗</a>
          <a class="ka-btn ka-btn--ghost" href={vouchersUrl} rel="noopener noreferrer">Order a Gift Voucher ↗</a>
          <a class="ka-btn ka-btn--ghost" href={phoneHref}>Call {phone}</a>
        </div>
      </div>
    </section>

    <section class="ka-doors" id="doors" aria-labelledby="ka-doors-title">
      <div class="ka-wrap">
        <p class="ka-kicker ka-kicker--dark">Concierge · 41–43 Greencastle Street</p>
        <h2 class="ka-section-h2" id="ka-doors-title">Rooms, Golden Years breaks &amp; Mourne celebrations.</h2>

        <div class="ka-door-grid">
          {doors.map((d) => (
            <article class="ka-door">
              <span class="ka-door-eyebrow">{d.eyebrow}</span>
              <h3>{d.title}</h3>
              <p>{d.detail}</p>
              <a class="ka-door-link" href={d.href} rel={d.href.startsWith("http") ? "noopener noreferrer" : undefined}>{d.cta}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ka-harbour" id="harbour" aria-labelledby="ka-harbour-title">
      <div class="ka-wrap ka-harbour-grid">
        <div class="ka-harbour-copy">
          <p class="ka-kicker">Kilkeel Harbour Provenance</p>
          <h2 id="ka-harbour-title">All fish &amp; shellfish sourced from less than a mile away.</h2>
          <p>
            Sitting right beside Northern Ireland's largest fishing port gives
            the Kilmorey Arms kitchen a genuine coastal edge. Our chefs pair
            daily Kilkeel landings with County Down farm produce across both the
            restaurant and our relaxed licensed bar lounge — recognised with a
            <strong>2026 Restaurant Guru</strong> award.
          </p>
          <div class="ka-harbour-actions">
            <a class="ka-btn ka-btn--gold" href={phoneHref}>Book a dining table · {phone}</a>
            <SpecimenSheet
              id="kilmorey-dossier"
              triggerLabel="Open Rooms & Offers Dossier"
              kicker="Kilmorey Arms Hotel · 41–43 Greencastle Street, Kilkeel"
              title="Rooms, Golden Years Breaks & Functions"
              subtitle="24 recently refurbished en-suite bedrooms, Kilkeel harbour dining, and celebrations up to 300 guests."
              groups={[
                {
                  id: "stays",
                  label: "Bedrooms & Direct Breaks",
                  items: [
                    { name: "24 Refurbished En-Suite Bedrooms", note: "Single, Double, King, Family & Executive Suites with full Irish breakfast, pillow menu & free parking" },
                    { name: "Golden Years Midweek Getaway", note: "Popular midweek coastal break with dining & full Irish breakfast", meta: "From £140pps" },
                  ],
                },
                {
                  id: "events",
                  label: "Dining, Weddings & Conferences",
                  items: [
                    { name: "Kilkeel Harbour Restaurant & Bar", note: "2026 Restaurant Guru award — all fish & shellfish sourced less than a mile from our kitchen" },
                    { name: "Conference & Meeting Suites", note: "Flexible setups for up to 300 delegates with catering & parking", meta: "From £35/hr" },
                    { name: "Mourne Weddings & Banquets", note: "Dedicated family-run events team for coastal ceremonies & receptions" },
                  ],
                },
              ]}
              ctaLabel="Book direct for best rates ↗"
              ctaHref={bookUrl}
              ctaExternal={true}
              secondaryLabel="Enquire below →"
              secondaryHref="#enquire"
            />
            <a class="ka-btn ka-btn--ghost" href={vouchersUrl} rel="noopener noreferrer">Dining &amp; Stay Vouchers ↗</a>
          </div>
        </div>

        <figure class="ka-seafood-plate">
          <ResponsiveImage
            src="/media/concepts/kilmorey-arms-hotel/kilmorey-arms-kilkeel-seafood.jpg"
            alt="Pan-roasted local white fish fillet and glossy roasted langoustines with lemon herb butter on pale porcelain"
            width={1200}
            height={896}
            sizes="(max-width: 960px) 100vw, 48vw"
            class="ka-seafood-img"
          />
          <figcaption>Kilkeel fishing-port seafood dining mood. Visualisation (AI-generated).</figcaption>
        </figure>
      </div>
    </section>

    <section class="ka-enquire" id="enquire" aria-labelledby="ka-enquire-title">
      <div class="ka-wrap ka-enquire-grid">
        <div>
          <p class="ka-kicker ka-kicker--dark">Weddings, Conferences &amp; Breaks</p>
          <h2 id="ka-enquire-title">Speak with our Wedding Planner or front desk.</h2>
          <p>
            Whether you are requesting our Wedding Brochure, booking our
            conference suite (up to 300 delegates, from £35/hr), or reserving a
            £140pps Golden Years midweek getaway, send your note straight to{" "}
            <a href={`mailto:${email}`}>{email}</a> or call{" "}
            <a href={phoneHref}><strong>{phoneIntl}</strong></a>.
          </p>
          <p class="ka-addr">
            <strong>41–43 Greencastle Street, Kilkeel, County Down, BT34 4BH</strong><br />
            <a href={mapHref} rel="noopener noreferrer">Google Maps ↗</a> ·{" "}
            <a href={facebook} rel="noopener noreferrer">Facebook ↗</a> ·{" "}
            <a href={instagram} rel="noopener noreferrer">Instagram ↗</a>
          </p>
        </div>

        <form class="ka-form" id="ka-form" data-email={email}>
          <div class="ka-row">
            <label>
              <span>Enquiry type</span>
              <select name="kind">
                <option value="Wedding Brochure & Date">Wedding Brochure &amp; Date</option>
                <option value="Golden Years Getaway (£140pps)">Golden Years Getaway (£140pps)</option>
                <option value="Conference / Meeting Suite">Conference / Meeting Suite (from £35/hr)</option>
                <option value="Dining / Group Booking">Dining or Group Stay</option>
              </select>
            </label>
            <label>
              <span>Preferred date or month</span>
              <input name="date" placeholder="e.g. Autumn 2027" />
            </label>
          </div>
          <div class="ka-row">
            <label>
              <span>Your name</span>
              <input name="name" autocomplete="name" required />
            </label>
            <label>
              <span>Phone number</span>
              <input name="phone" type="tel" autocomplete="tel" required />
            </label>
          </div>
          <label>
            <span>Estimated guests or notes</span>
            <textarea name="notes" rows="2"></textarea>
          </label>
          <button class="ka-btn ka-btn--navy ka-btn--full" type="submit">Open enquiry email →</button>
        </form>
      </div>

      <div class="ka-wrap" style="margin-top: 44px;">
        <LocalAreaMap
          id="kilmorey-map"
          businessName="Kilmorey Arms Hotel"
          address="41–43 Greencastle Street, Kilkeel, BT34 4BH"
          lon={-6.002}
          lat={54.060}
          spanKm={16}
          radiusKm={2.2}
          radiusLabel="Kilkeel Harbour · < 1 mile"
          mapHref={mapHref}
          kicker="Kingdom of Mourne & Kilkeel Harbour"
          markers={[
            { name: "Kilkeel Harbour", lon: -5.993, lat: 54.055, note: "< 1 mile", side: "r" },
            { name: "Cranfield Point", lon: -6.045, lat: 54.022, note: "7 mins", side: "l" },
            { name: "Annalong", lon: -5.903, lat: 54.109, note: "10 mins", side: "r" },
            { name: "Rostrevor", lon: -6.197, lat: 54.102, note: "18 mins", side: "l" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="ka-footer">
    <div class="ka-wrap ka-footer-inner">
      <span><strong>Kilmorey Arms Hotel</strong> · 41–43 Greencastle Street, Kilkeel, County Down, BT34 4BH</span>
      <span><a href={phoneHref}>{phoneIntl}</a> · <a href={`mailto:${email}`}>{email}</a> · <a href={bookUrl} rel="noopener noreferrer">Book Direct ↗</a></span>
    </div>
  </footer>

  <script>
    const form = document.getElementById("ka-form") as HTMLFormElement | null;
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const d = new FormData(form);
      const kind = String(d.get("kind") || "Enquiry");
      const body = [
        `Enquiry: ${kind}`,
        `Date / month: ${d.get("date") || "To confirm"}`,
        `Name: ${d.get("name") || ""}`,
        `Phone: ${d.get("phone") || ""}`,
        "",
        String(d.get("notes") || ""),
      ].join("\n");
      const to = form.dataset.email ?? "";
      const subject = `${kind} — Kilmorey Arms Hotel, Kilkeel`;
      const url = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      if (window.dispatchEvent(new CustomEvent("mm:enquiry", { cancelable: true, detail: { to, subject, body, url } }))) {
        window.location.href = url;
      }
    });
  </script>
</ConceptLayout>
