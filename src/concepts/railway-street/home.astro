---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import StreetPlate from "./StreetPlate.astro";
import BrewBarGuide from "./BrewBarGuide.astro";

/* Railway Street Café & Brew Bar — meal, with the roast as a jar on the side.
   Speak as the café. No standalone café site: Facebook/Instagram hold today;
   groupworkcoffee.com holds the bag. Do not clone the Shopify. Do not invent
   a booking form. Barker names stay off this guest chrome (Groupwork About
   names them; the café has no first-party About). Postcode 0AJ vs 0AL
   unresolved — omit. Hours are Google-only (8:30–4:30) — omit rather than
   date a clock on the door. Kitchen-stop ~3pm is AI Overview — omit. */
const phone = "028 4372 5620";
const phoneHref = "tel:+442843725620";
const email = "railwaystcoffee@gmail.com";
const facebook = "https://www.facebook.com/railwaystcoffee";
const instagram = "https://www.instagram.com/railwaystcoffee/";
const groupwork = "https://groupworkcoffee.com/";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@400;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,500&display=swap";
---

<ConceptLayout
  title={"Railway Street Café & Brew Bar — independent concept"}
  slug="railway-street"
  bodyClass="concept-page concept-railway"
  lang="en-GB"
  businessName="Railway Street Café & Brew Bar"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The coffee hero plate and street fascia are concept visualisations."
>
  <div class="rs-strip">
    <span>2 Railway Street, Newcastle · Speciality coffee</span>
    <span class="rs-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="rs-header">
    <a class="rs-brand" href="/concepts/railway-street/">
      <span class="rs-brand-mark" aria-hidden="true">
        <svg width="46" height="46" viewBox="0 0 46 46" fill="none">
          <rect x="1.5" y="1.5" width="43" height="43" fill="#24362e"/>
          <rect x="1.5" y="1.5" width="43" height="43" stroke="#c9a06a" stroke-width="1.6"/>
          <text
            x="23"
            y="22"
            text-anchor="middle"
            fill="#f3ead8"
            font-size="8"
            font-family="Big Shoulders Display, Arial Narrow, sans-serif"
            font-weight="800"
            letter-spacing="0.8"
          >RAILWAY</text>
          <text
            x="23"
            y="32"
            text-anchor="middle"
            fill="#c9a06a"
            font-size="11"
            font-family="Big Shoulders Display, Arial Narrow, sans-serif"
            font-weight="800"
          >ST.</text>
        </svg>
      </span>
      <span class="rs-brand-text">
        <span class="rs-brand-name">Railway St.</span>
        <span class="rs-brand-sub">Café &amp; Brew Bar · Newcastle</span>
      </span>
    </a>
    <nav class="rs-nav" aria-label="Concept navigation">
      <a href="#brewbar">Brew Bar</a>
      <a href="#saturday">Saturday</a>
      <a href="#bag">The bag</a>
      <a href="#door">The door</a>
    </nav>
    <a class="rs-walk" href="#door">Walk in</a>
  </header>

  <main class="rs-main">
    <section class="rs-hero" aria-labelledby="rs-name">
      <div class="rs-mast">
        <p class="rs-kicker">Café &amp; Brew Bar</p>
        <h1 id="rs-name">RAILWAY ST.</h1>
        <p class="rs-number">2 Railway Street · Newcastle</p>
        <p class="rs-say">No bad days.</p>
        <p class="rs-lede">
          Speciality coffee, single origins, and slow mornings on Railway Street. Walk in for the cup.
        </p>
        <p class="rs-cta">
          <a class="rs-walk rs-walk--inline" href="#door">Walk in</a>
          <a class="rs-ring" href={phoneHref}>{phone}</a>
        </p>
      </div>

      <figure class="rs-theatre">
        <img
          src="/media/concepts/railway-street/railway-street-hero.jpg"
          alt="Freshly poured Kalita Wave filter brew and flat white on Mourne slate"
          class="rs-theatre-img"
          loading="eager"
        />
        <figcaption class="rs-theatre-cap">
          Single origin pour-over &amp; flat white · Roasted with Groupwork
        </figcaption>
      </figure>
    </section>

    <section class="rs-brewbar" id="brewbar" aria-labelledby="rs-brewbar-title">
      <div class="rs-section-head">
        <p class="rs-kicker">The Counter</p>
        <h2 id="rs-brewbar-title">Brew Bar &amp; Extraction</h2>
        <p class="rs-section-intro">
          Dialled in daily on 2 Railway Street. Single origins, batch brews, and precision espresso.
        </p>
      </div>

      <BrewBarGuide headingId="rs-brewbar-title" />
    </section>

    <section class="rs-saturday" id="saturday" aria-labelledby="rs-saturday-title">
      <div class="rs-paper">
        <p class="rs-kicker">Saturday</p>
        <h2 id="rs-saturday-title">That's what Saturdays are for!</h2>
        <p class="rs-tiramisu">TIRAMISU iced lattes on repeat.</p>
        <p class="rs-bio">
          Speciality Coffee Shop · Roastery @groupworkcoffeeroasters
          <span class="rs-hash">#nobaddays</span>
        </p>
      </div>
      <aside class="rs-today">
        <p class="rs-today-kicker">Today's cup</p>
        <p>
          What we are pouring lives on Facebook and Instagram. That is today's
          board.
        </p>
        <p class="rs-today-links">
          <a href={facebook} rel="noopener noreferrer">Facebook</a>
          <a href={instagram} rel="noopener noreferrer">Instagram · @railwaystcoffee</a>
        </p>
      </aside>
    </section>

    <section class="rs-bag" id="bag" aria-labelledby="rs-bag-title">
      <p class="rs-kicker rs-kicker--on-dark">The bag</p>
      <h2 id="rs-bag-title">The roast is Groupwork.</h2>
      <p>
        We brew it on Railway Street. The bag is at groupworkcoffee.com —
        that is the roastery shop, not a second café.
      </p>
      <p class="rs-bag-cta">
        <a class="rs-bag-link" href={groupwork} rel="noopener noreferrer">groupworkcoffee.com</a>
      </p>
    </section>

    <section class="rs-street" id="door" aria-labelledby="rs-door-title">
      <div class="rs-street-copy">
        <p class="rs-kicker">The door</p>
        <h2 id="rs-door-title">2 Railway Street.</h2>
        <p class="rs-street-lede">
          Walk in. Ring if you like.
        </p>
        <p class="rs-artefact-cta">
          <span class="rs-walk rs-walk--inline">Walk in</span>
          <a class="rs-ring" href={phoneHref}>{phone}</a>
        </p>
      </div>

      <figure class="rs-artefact">
        <StreetPlate />
        <figcaption>The fascia on Railway Street.</figcaption>
      </figure>

      <address class="rs-address">
        <strong>Railway Street Café &amp; Brew Bar</strong>
        <span>2 Railway Street</span>
        <span>Newcastle</span>
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={facebook} rel="noopener noreferrer">Facebook · railwaystcoffee</a>
        <a href={instagram} rel="noopener noreferrer">Instagram · @railwaystcoffee</a>
        <a href={groupwork} rel="noopener noreferrer">The bag · groupworkcoffee.com</a>
      </address>
    </section>
  </main>
</ConceptLayout>
