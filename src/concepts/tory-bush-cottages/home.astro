---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import "./styles.css";

/* Tory Bush Cottages — 79 Tullyree Road, Kilcoo, Newry BT34 5LD.
   Verified live 26 Nov 2026: torybush.com prints raw --> leak & lists "2024 Prices" in main menu,
   despite live SuperControl calendar (ownerID=173&siteID=243). Eco Loft + Houses 1–8, bring your own horse!
   Phone: 028 4372 4348. */
const phone = "028 4372 4348";
const phoneHref = "tel:+442843724348";
const availHref = "https://secure.supercontrol.co.uk/availability/availability_grid.asp?ownerID=173&siteID=243";
const enquiryHref = "https://secure.supercontrol.co.uk/availability/enquiry_form.asp?se=55492151B1EF1F60813D532B8F60E300D9AA5C5D816FB047";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Tory+Bush+Cottages+79+Tullyree+Road+Kilcoo+BT34+5LD";

const cottageGroups = [
  {
    id: "cottages",
    label: "Cottages & Eco Loft",
    items: [
      { name: "The Eco Loft", note: "Elevated timber-and-stone hideaway looking across forested Mourne foothills", meta: "Couples & retreats" },
      { name: "Cottages 1 – 8", note: "Restored stone self-catering houses with wood-burning stoves, full kitchens & quiet gardens", meta: "Families & groups" },
      { name: "Live Direct Availability", note: "Real-time weekly and short-break dates direct through our SuperControl booking grid", meta: "Book direct" },
    ],
  },
  {
    id: "activities",
    label: "Mournes & Equestrian",
    items: [
      { name: "Bring Your Own Horse", note: "On-site equestrian welcome so you can ride straight into Tollymore Forest and Mourne bridleways", meta: "Signature feature" },
      { name: "Hiking & MTB Base", note: "Minutes from Tollymore Forest Park, Castlewellan MTB trails and High Mourne climbs", meta: "Tullyree Road" },
      { name: "Royal County Down & Golf", note: "Short drive to Newcastle's world-ranked links and coastal beaches", meta: "10 mins to Newcastle" },
    ],
  },
];
---

<ConceptLayout
  title="Tory Bush Cottages — Self-Catering in the Mourne Mountains"
  slug="tory-bush-cottages"
  bodyClass="concept-page concept-torybush"
  businessName="Tory Bush Cottages"
  town="Kilcoo"
  bannerNote="Imagery comprises indicative Mourne stone cottage exterior and hearth interior visualisations."
>
  <header class="tb-header">
    <div class="tb-header-inner">
      <a class="tb-brand" href="#top">
        <strong>Tory Bush Cottages</strong>
        <span>Mourne Mountains · Tollymore</span>
      </a>
      <nav class="tb-nav" aria-label="Primary">
        <a href="#stays">The Cottages</a>
        <a href="#activities">Mournes &amp; Riding</a>
        <a href="#location">Tullyree Road</a>
      </nav>
      <div class="tb-header-actions">
        <a class="tb-header-tel" href={phoneHref}>{phone}</a>
        <a class="tb-header-cta" href={availHref} target="_blank" rel="noopener noreferrer">Check Dates ↗</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="tb-hero" aria-labelledby="tb-hero-title">
      <figure class="tb-hero-media">
        <picture>
          <source srcset="/media/concepts/tory-bush-cottages/tory-bush-cottages-hero-640.webp 640w, /media/concepts/tory-bush-cottages/tory-bush-cottages-hero-1265.webp 1265w" sizes="100vw" type="image/webp" />
          <img src="/media/concepts/tory-bush-cottages/tory-bush-cottages-hero.jpg" alt="Restored County Down stone holiday cottage with glowing windows and drystone wall beneath Mourne peaks" width="1408" height="768" loading="eager" />
        </picture>
        <figcaption class="tb-hero-cap">Indicative Mourne stone cottage visualisation.</figcaption>
      </figure>
      <div class="tb-hero-scrim" aria-hidden="true"></div>
      <div class="tb-hero-content">
        <p class="tb-eyebrow">79 Tullyree Road · Kilcoo · Beside Tollymore Forest Park</p>
        <h1 id="tb-hero-title">Stone cottages &amp; an Eco Loft under the Mourne peaks.</h1>
        <p class="tb-hero-lead">
          Eight self-catering granite cottages and an elevated Eco Loft nestled below the mountains —
          for hillwalkers, cyclists, golfers, and riders bringing their own horses on holiday.
        </p>
        <div class="tb-hero-actions">
          <a class="tb-btn tb-btn--primary" href={availHref} target="_blank" rel="noopener noreferrer">View Live Availability Grid ↗</a>
          <SpecimenSheet
            id="tb-guide-sheet"
            triggerLabel="Cottages & Riding Guide"
            kicker="Tory Bush Cottages · 79 Tullyree Road"
            title="Eco Loft, Eight Cottages & Mourne Trails"
            subtitle="Check live dates online via SuperControl or ring 028 4372 4348."
            groups={cottageGroups}
            ctaLabel="Check Live Dates ↗"
            ctaHref={availHref}
            ctaExternal={true}
            secondaryLabel={`Call ${phone}`}
            secondaryHref={phoneHref}
            buttonClass="tb-btn tb-btn--ghost"
          />
        </div>
      </div>
    </section>

    <section class="tb-section tb-stays" id="stays" aria-labelledby="tb-stays-title">
      <div class="tb-wrap tb-split">
        <figure class="tb-plate">
          <picture>
            <source srcset="/media/concepts/tory-bush-cottages/tory-bush-hearth-interior-640.webp 640w, /media/concepts/tory-bush-cottages/tory-bush-hearth-interior-1265.webp 1265w" sizes="(max-width: 860px) 100vw, 48vw" type="image/webp" />
            <img src="/media/concepts/tory-bush-cottages/tory-bush-hearth-interior.jpg" alt="Stone cottage living room with oak beams, glowing wood-burning stove and views to green Mourne hills" width="1408" height="768" loading="lazy" />
          </picture>
          <figcaption>Cottage hearth &amp; mountain outlook. Indicative interior visualisation.</figcaption>
        </figure>
        <div>
          <p class="tb-kicker">Nine Places to Stay</p>
          <h2 id="tb-stays-title">Wood stoves, stone walls and silence after the hill.</h2>
          <p>
            Choose from Houses 1 through 8 or our secluded Eco Loft — each set along quiet Tullyree Road
            with direct access to Tollymore Forest trails, mountain bike loops, and ten-minute drives down
            to Newcastle beach and Royal County Down.
          </p>
          <div class="tb-inline-actions">
            <a class="tb-btn tb-btn--primary" href={availHref} target="_blank" rel="noopener noreferrer">Live Booking Calendar ↗</a>
            <a class="tb-btn tb-btn--outline" href={enquiryHref} target="_blank" rel="noopener noreferrer">Send Direct Question ↗</a>
          </div>
        </div>
      </div>
    </section>

    <section class="tb-section tb-activities" id="activities" aria-labelledby="tb-act-title">
      <div class="tb-wrap">
        <p class="tb-kicker">From Your Doorstep</p>
        <h2 id="tb-act-title">Built for walkers, riders, cyclists and golfers.</h2>
        <div class="tb-four">
          <article>
            <h3>Bring Your Own Horse</h3>
            <p>A rare Mourne base welcoming travelling horses, with direct forest bridleways nearby.</p>
          </article>
          <article>
            <h3>Climbing the Mournes</h3>
            <p>Step straight onto the foothills for Slieve Bearnagh, Meelmore and Donard ridge days.</p>
          </article>
          <article>
            <h3>Castlewellan MTB</h3>
            <p>Ten minutes to Castlewellan Forest Park red and black mountain bike singletrack.</p>
          </article>
          <article>
            <h3>Golfing County Down</h3>
            <p>Easy base for tee times at Royal County Down, Kilkeel and Ardglass links.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="tb-section" id="location" aria-label="Kilcoo Mourne map">
      <div class="tb-wrap">
        <LocalAreaMap
          id="tb-map"
          kicker="79 Tullyree Road · Kilcoo & Tollymore"
          businessName="Tory Bush Cottages"
          address="79 Tullyree Road, Kilcoo, Newry, BT34 5LD"
          lon={-5.9805131}
          lat={54.2240953}
          spanKm={18}
          mapHref={mapsHref}
          markers={[
            { name: "Tollymore Forest", lon: -5.9465, lat: 54.2227, note: "5 mins east", side: "r" },
            { name: "Castlewellan", lon: -5.9442, lat: 54.2596, note: "8 mins north", side: "t" },
            { name: "Newcastle", lon: -5.8902, lat: 54.2121, note: "10 mins east", side: "r" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="tb-footer">
    <div class="tb-wrap tb-footer-inner">
      <div>
        <strong>Tory Bush Cottages</strong>
        <p>79 Tullyree Road, Kilcoo, Newry, Co. Down, BT34 5LD</p>
      </div>
      <div class="tb-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={availHref} target="_blank" rel="noopener noreferrer">Availability ↗</a>
        <a href={enquiryHref} target="_blank" rel="noopener noreferrer">Enquire ↗</a>
      </div>
    </div>
  </footer>
</ConceptLayout>
