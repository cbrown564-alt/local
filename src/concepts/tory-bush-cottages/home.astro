---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import "./styles.css";

/* Tory Bush Cottages, 79 Tullyree Road, Kilcoo, Newry BT34 5LD.
   Verified live 26 Nov 2026: Live SuperControl calendar (ownerID=173&siteID=243),
   Eco Loft plus Houses 1 to 8, bring your own horse welcome. Phone: 028 4372 4348. */
const phone = "028 4372 4348";
const phoneHref = "tel:+442843724348";
const availHref = "https://secure.supercontrol.co.uk/availability/availability_grid.asp?ownerID=173&siteID=243";
const enquiryHref = "https://secure.supercontrol.co.uk/availability/enquiry_form.asp?se=55492151B1EF1F60813D532B8F60E300D9AA5C5D816FB047";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Tory+Bush+Cottages+79+Tullyree+Road+Kilcoo+BT34+5LD";

const cottageGroups = [
  {
    id: "cottages",
    label: "Cottages and Eco Loft",
    items: [
      {
        name: "The Eco Loft",
        note: "Elevated timber-and-stone hideaway looking across forested Mourne foothills.",
        meta: "Couples and retreats",
      },
      {
        name: "Cottages 1 to 8",
        note: "Restored stone self-catering houses with wood-burning stoves, full kitchens, and quiet gardens.",
        meta: "Families and groups",
      },
      {
        name: "Live direct availability",
        note: "Real-time weekly and short-break dates direct through our SuperControl booking grid.",
        meta: "Book direct",
      },
    ],
  },
  {
    id: "activities",
    label: "Mournes and equestrian",
    items: [
      {
        name: "Bring your own horse",
        note: "On-site equestrian welcome so you can ride straight into Tollymore Forest and Mourne bridleways.",
        meta: "Signature feature",
      },
      {
        name: "Hiking and MTB base",
        note: "Minutes from Tollymore Forest Park, Castlewellan MTB trails, and High Mourne climbs.",
        meta: "Tullyree Road",
      },
      {
        name: "Royal County Down and golf",
        note: "Short drive to Newcastle's world-ranked links and coastal beaches.",
        meta: "10 mins to Newcastle",
      },
    ],
  },
];
---

<ConceptLayout
  title="Tory Bush Cottages, Self-Catering in the Mourne Mountains"
  slug="tory-bush-cottages"
  bodyClass="concept-page concept-torybush"
  businessName="Tory Bush Cottages"
  town="Kilcoo"
  bannerNote="Imagery comprises indicative Mourne stone cottage exterior and hearth interior visualisations."
>
  <header class="tb-header" data-tb-header>
    <div class="tb-header-inner">
      <a class="tb-brand" href="#top">Tory Bush Cottages</a>
      <nav class="tb-nav" aria-label="Primary">
        <a href="#stays">The cottages</a>
        <a href="#activities">Mournes and riding</a>
        <a href="#enquire">Enquire</a>
        <a href="#location">Tullyree Road</a>
      </nav>
      <div class="tb-header-actions">
        <a class="tb-header-tel" href={phoneHref}>{phone}</a>
        <a class="tb-header-cta" href={availHref} target="_blank" rel="noopener noreferrer">Check dates</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="tb-hero" aria-labelledby="tb-hero-title">
      <div class="tb-hero-sentinel" data-tb-sentinel aria-hidden="true"></div>
      <div class="tb-hero-media">
        <picture>
          <source
            srcset="/media/concepts/tory-bush-cottages/tory-bush-cottages-hero-640.webp 640w, /media/concepts/tory-bush-cottages/tory-bush-cottages-hero-1265.webp 1265w"
            sizes="100vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/tory-bush-cottages/tory-bush-cottages-hero.jpg"
            alt="Restored County Down stone holiday cottage with glowing windows and drystone wall beneath Mourne peaks"
            width="1408"
            height="768"
            loading="eager"
          />
        </picture>
        <div class="tb-hero-scrim" aria-hidden="true"></div>
      </div>

      <div class="tb-wrap tb-hero-foot">
        <div class="tb-hero-title-col">
          <h1 id="tb-hero-title">Stone cottages under the Mournes.</h1>
        </div>
        <div class="tb-hero-copy-col">
          <p class="tb-hero-lead">
            Eight granite self-catering houses and an elevated Eco Loft beside Tollymore Forest, welcoming walkers, cyclists, and travelling horses.
          </p>
          <a class="tb-btn tb-btn--primary" href={availHref} target="_blank" rel="noopener noreferrer">View live availability</a>
          <p class="tb-hero-caption">Indicative Mourne stone cottage outlook visualisation.</p>
        </div>
      </div>
    </section>

    <section class="tb-section tb-stage" id="stays" aria-labelledby="tb-stays-title">
      <div class="tb-wrap tb-stage-grid">
        <div class="tb-stage-copy">
          <h2 id="tb-stays-title">Wood stoves, granite walls, and quiet after the hill.</h2>

          <div class="tb-tabs" role="tablist" aria-label="Cottages, Eco Loft, and horse riding" data-tb-tabs>
            <button
              type="button"
              class="tb-tab"
              role="tab"
              id="tb-tab-cottages"
              aria-selected="true"
              aria-controls="tb-panel-cottages"
            >
              Eight granite cottages
            </button>
            <button
              type="button"
              class="tb-tab"
              role="tab"
              id="tb-tab-ecoloft"
              aria-selected="false"
              aria-controls="tb-panel-ecoloft"
              tabindex="-1"
            >
              The Eco Loft
            </button>
            <button
              type="button"
              class="tb-tab"
              role="tab"
              id="tb-tab-horses"
              aria-selected="false"
              aria-controls="tb-panel-horses"
              tabindex="-1"
            >
              Bring your own horses
            </button>
          </div>

          <div class="tb-panel" role="tabpanel" id="tb-panel-cottages" aria-labelledby="tb-tab-cottages">
            <p>
              Choose from Houses 1 through 8 along quiet Tullyree Road, restored granite self-catering cottages with wood-burning stoves, full kitchens, and peaceful gardens.
            </p>
            <dl class="tb-stage-ledger">
              <div>
                <dt>Accommodation</dt>
                <dd>Houses 1 to 8 for families, hiking parties, and County Down golf groups</dd>
              </div>
              <div>
                <dt>Direct calendar</dt>
                <dd><a href={availHref} target="_blank" rel="noopener noreferrer">Check live SuperControl dates ↗</a></dd>
              </div>
              <div>
                <dt>Direct telephone</dt>
                <dd><a href={phoneHref}>{phone}</a></dd>
              </div>
            </dl>
          </div>

          <div class="tb-panel" role="tabpanel" id="tb-panel-ecoloft" aria-labelledby="tb-tab-ecoloft" hidden>
            <p>
              An elevated timber-and-stone hideaway looking across forested Mourne foothills, built for couples and unhurried mountain retreats beside Tollymore.
            </p>
            <dl class="tb-stage-ledger">
              <div>
                <dt>Outlook</dt>
                <dd>Raised views across woodland and granite drystone walls towards the foothills</dd>
              </div>
              <div>
                <dt>Best suited for</dt>
                <dd>Couples, solo walkers, and peaceful weekend escapes</dd>
              </div>
              <div>
                <dt>Live dates</dt>
                <dd><a href={availHref} target="_blank" rel="noopener noreferrer">View Eco Loft availability ↗</a></dd>
              </div>
            </dl>
          </div>

          <div class="tb-panel" role="tabpanel" id="tb-panel-horses" aria-labelledby="tb-tab-horses" hidden>
            <p>
              A rare Mourne holiday base that welcomes your own horses on site, letting you hack directly into Tollymore Forest and neighbouring mountain bridleways.
            </p>
            <dl class="tb-stage-ledger">
              <div>
                <dt>Equestrian welcome</dt>
                <dd>Bring your own horses for forest hacking and mountain trail days</dd>
              </div>
              <div>
                <dt>Bridleway access</dt>
                <dd>Five minutes east to Tollymore Forest Park riding routes</dd>
              </div>
              <div>
                <dt>Arrange stabling</dt>
                <dd>Ring <a href={phoneHref}>{phone}</a> or send your riding dates below</dd>
              </div>
            </dl>
          </div>

          <div class="tb-stage-sheet">
            <SpecimenSheet
              id="tb-guide-sheet"
              triggerLabel="Open cottages and riding guide"
              kicker="Tory Bush Cottages, 79 Tullyree Road"
              title="Eco Loft, eight cottages, and Mourne trails"
              subtitle="Check live dates online via SuperControl or ring 028 4372 4348."
              groups={cottageGroups}
              ctaLabel="Check live dates ↗"
              ctaHref={availHref}
              ctaExternal={true}
              secondaryLabel={`Call ${phone}`}
              secondaryHref={phoneHref}
              buttonClass="tb-link-trigger"
            />
          </div>
        </div>

        <div class="tb-stage-media">
          <figure class="tb-plate">
            <picture>
              <source
                srcset="/media/concepts/tory-bush-cottages/tory-bush-hearth-interior-640.webp 640w, /media/concepts/tory-bush-cottages/tory-bush-hearth-interior-1265.webp 1265w"
                sizes="(max-width: 960px) 100vw, 48vw"
                type="image/webp"
              />
              <img
                src="/media/concepts/tory-bush-cottages/tory-bush-hearth-interior.jpg"
                alt="Stone cottage living room with oak beams, glowing wood-burning stove, and views to green Mourne hills"
                width="1408"
                height="768"
                loading="lazy"
              />
            </picture>
            <figcaption>Cottage hearth and mountain outlook. Indicative interior visualisation.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="tb-section tb-activities" id="activities" aria-labelledby="tb-act-title">
      <div class="tb-wrap tb-split">
        <div class="tb-copy-col">
          <h2 id="tb-act-title">Built for walkers, riders, cyclists, and golfers.</h2>
          <p>
            Set along quiet Tullyree Road in Kilcoo, Tory Bush puts Tollymore Forest, High Mourne ridges, Castlewellan singletrack, and Newcastle links all within ten minutes of your cottage door.
          </p>
        </div>
        <div class="tb-ledger-col">
          <dl class="tb-ledger">
            <div>
              <dt>Bring your own horse</dt>
              <dd>On-site equestrian welcome with direct Tollymore Forest bridleways nearby</dd>
            </div>
            <div>
              <dt>Climbing the Mournes</dt>
              <dd>Foothill access for Slieve Bearnagh, Meelmore, and Slieve Donard ridge days</dd>
            </div>
            <div>
              <dt>Castlewellan MTB</dt>
              <dd>Eight minutes north to Castlewellan Forest Park red and black singletrack</dd>
            </div>
            <div>
              <dt>Golfing County Down</dt>
              <dd>Ten minutes east to Newcastle beach, Royal County Down, Kilkeel, and Ardglass links</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="tb-section tb-enquire" id="enquire" aria-labelledby="tb-enquire-title">
      <div class="tb-wrap tb-split">
        <div class="tb-copy-col">
          <h2 id="tb-enquire-title">Ask about dates, group stays, or bringing horses.</h2>
          <p>
            Check real-time availability on our <a href={availHref} target="_blank" rel="noopener noreferrer">live booking calendar ↗</a>, call <a href={phoneHref}>{phone}</a>, or prepare a stay enquiry below for Tullyree Road.
          </p>
          <dl class="tb-ledger">
            <div>
              <dt>Address</dt>
              <dd>79 Tullyree Road, Kilcoo, Newry, BT34 5LD</dd>
            </div>
            <div>
              <dt>Direct booking</dt>
              <dd class="tb-inline-links">
                <a href={availHref} target="_blank" rel="noopener noreferrer">Live availability ↗</a>
                <a href={enquiryHref} target="_blank" rel="noopener noreferrer">SuperControl enquiry ↗</a>
              </dd>
            </div>
          </dl>
        </div>

        <div class="tb-form-col">
          <form class="tb-form" data-tb-form>
            <div class="tb-row">
              <label>
                <span>Your name</span>
                <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
              </label>
              <label>
                <span>Telephone</span>
                <input name="phone" type="tel" required autocomplete="tel" placeholder="028 or 07..." />
              </label>
            </div>
            <div class="tb-row">
              <label>
                <span>Preferred arrival date</span>
                <input name="arrival" type="date" required />
              </label>
              <label>
                <span>Guests</span>
                <input name="guests" type="number" min="1" max="24" value="4" required />
              </label>
            </div>
            <label>
              <span>Accommodation interest</span>
              <select name="stay">
                <option value="Cottages 1 to 8">Cottages 1 to 8</option>
                <option value="The Eco Loft">The Eco Loft</option>
                <option value="Cottage stay with own horses">Cottage stay with own horses</option>
                <option value="Multiple cottages for a group">Multiple cottages for a group</option>
              </select>
            </label>
            <label>
              <span>Stay notes or equestrian details</span>
              <textarea name="notes" rows="3" placeholder="Number of nights, horse count if riding, or golf and walking plans"></textarea>
            </label>
            <button class="tb-btn tb-btn--primary" type="submit">Prepare stay enquiry</button>
          </form>
        </div>
      </div>
    </section>

    <section class="tb-section tb-map-band" id="location" aria-label="Kilcoo Mourne map">
      <div class="tb-wrap">
        <LocalAreaMap
          id="tb-map"
          kicker=""
          businessName="Tory Bush Cottages"
          address="79 Tullyree Road, Kilcoo, Newry, BT34 5LD"
          lon={-5.9805131}
          lat={54.2240953}
          spanKm={18}
          mapHref={mapsHref}
          markers={[
            { name: "Tollymore Forest", lon: -5.9465, lat: 54.2227, note: "5 mins east", side: "r" },
            { name: "Castlewellan", lon: -5.9442, lat: 54.2596, note: "8 mins north", side: "t" },
            { name: "Newcastle", lon: -5.8902, lat: 54.2121, note: "10 mins east", side: "r" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="tb-footer">
    <div class="tb-wrap tb-footer-inner">
      <div>
        <strong>Tory Bush Cottages</strong>
        <p>79 Tullyree Road, Kilcoo, Newry, Co. Down, BT34 5LD</p>
      </div>
      <div class="tb-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={availHref} target="_blank" rel="noopener noreferrer">Availability ↗</a>
        <a href={enquiryHref} target="_blank" rel="noopener noreferrer">Enquire ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-tb-header]");
      const sentinel = document.querySelector("[data-tb-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            const entry = entries[0];
            if (!entry) return;
            header.classList.toggle("is-scrolled", !entry.isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      const tablist = document.querySelector("[data-tb-tabs]");
      if (tablist) {
        const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
        const activate = (tab, moveFocus) => {
          tabs.forEach((t) => {
            const selected = t === tab;
            t.setAttribute("aria-selected", String(selected));
            t.tabIndex = selected ? 0 : -1;
            const panelId = t.getAttribute("aria-controls");
            const panel = panelId ? document.getElementById(panelId) : null;
            if (panel) panel.hidden = !selected;
          });
          if (moveFocus) tab.focus();
        };
        tabs.forEach((tab, idx) => {
          tab.addEventListener("click", () => activate(tab, false));
          tab.addEventListener("keydown", (e) => {
            if (e.key === "ArrowRight") {
              e.preventDefault();
              activate(tabs[(idx + 1) % tabs.length], true);
            } else if (e.key === "ArrowLeft") {
              e.preventDefault();
              activate(tabs[(idx - 1 + tabs.length) % tabs.length], true);
            } else if (e.key === "Home") {
              e.preventDefault();
              activate(tabs[0], true);
            } else if (e.key === "End") {
              e.preventDefault();
              activate(tabs[tabs.length - 1], true);
            }
          });
        });
      }

      const form = document.querySelector("[data-tb-form]");
      if (form) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;
          const fd = new FormData(form);
          const stay = String(fd.get("stay") || "Cottage stay");
          const arrival = String(fd.get("arrival") || "Flexible");
          const guests = String(fd.get("guests") || "2");
          const subject = `Stay enquiry: ${stay} for ${guests} (${arrival})`;
          const body = [
            `Name: ${fd.get("name")}`,
            `Telephone: ${fd.get("phone")}`,
            `Preferred arrival: ${arrival}`,
            `Guests: ${guests}`,
            `Accommodation: ${stay}`,
            `Notes: ${fd.get("notes") || "None"}`,
          ].join("\n");
          const ev = new CustomEvent("mm:enquiry", {
            cancelable: true,
            detail: {
              to: "Tory Bush Cottages (028 4372 4348)",
              subject,
              body,
              url: "tel:+442843724348",
            },
          });
          if (window.dispatchEvent(ev)) {
            window.location.href = "tel:+442843724348";
          }
        });
      }
    })();
  </script>
</ConceptLayout>
