---
interface Props {
  phone: string;
  phoneHref: string;
}

const { phone, phoneHref } = Astro.props;
---

<div class="ve-map-wrap">
  <svg
    class="ve-map"
    viewBox="0 0 720 420"
    role="img"
    aria-label="Plan of Vintage etc.: street door into the front room, arch into the middle arcade, passage into the back room"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect width="720" height="420" fill="#efe4cc"/>
    <text x="28" y="36" fill="#6a5c4a" font-size="11" font-family="Sora, sans-serif" letter-spacing="2">6 MAIN STREET · NEWCASTLE</text>

    <rect x="28" y="56" width="208" height="300" fill="#f8f1e2" stroke="#3d5344" stroke-width="2"/>
    <rect x="248" y="56" width="228" height="300" fill="#f3ead8" stroke="#3d5344" stroke-width="2"/>
    <rect x="488" y="56" width="204" height="300" fill="#e8dcc4" stroke="#3d5344" stroke-width="2"/>

    <path d="M28 356 H692" stroke="#3d5344" stroke-width="8"/>
    <rect x="96" y="348" width="54" height="22" fill="#f3ead8" stroke="#3d5344" stroke-width="2"/>
    <path d="M236 120 v170" stroke="#3d5344" stroke-width="2" stroke-dasharray="4 6"/>
    <path d="M476 120 v170" stroke="#3d5344" stroke-width="2" stroke-dasharray="4 6"/>

    <text x="132" y="200" text-anchor="middle" fill="#2a3b30" font-size="16" font-family="Libre Caslon Text, serif">Front</text>
    <text x="362" y="200" text-anchor="middle" fill="#2a3b30" font-size="16" font-family="Libre Caslon Text, serif">Middle</text>
    <text x="590" y="200" text-anchor="middle" fill="#2a3b30" font-size="16" font-family="Libre Caslon Text, serif">Back</text>
    <text x="132" y="222" text-anchor="middle" fill="#8c3b2a" font-size="10" font-family="Sora, sans-serif" letter-spacing="1.4">STREET DOOR</text>
    <text x="362" y="222" text-anchor="middle" fill="#8c3b2a" font-size="10" font-family="Sora, sans-serif" letter-spacing="1.4">30+ STALLS</text>
    <text x="590" y="222" text-anchor="middle" fill="#8c3b2a" font-size="10" font-family="Sora, sans-serif" letter-spacing="1.4">THE LONGER LOOK</text>

    <circle cx="118" cy="280" r="4" fill="#3d5344"/>
    <circle cx="160" cy="268" r="4" fill="#3d5344"/>
    <circle cx="310" cy="150" r="4" fill="#3d5344"/>
    <circle cx="348" cy="270" r="4" fill="#3d5344"/>
    <circle cx="402" cy="188" r="4" fill="#3d5344"/>
    <circle cx="540" cy="160" r="4" fill="#3d5344"/>
    <circle cx="620" cy="290" r="4" fill="#3d5344"/>

    <text x="28" y="400" fill="#6a5c4a" font-size="11" font-family="Sora, sans-serif">Joe's Quality Meats keeps its own counter in the building.</text>
  </svg>

  <aside class="ve-stall">
    <p class="ve-stall-kicker">Stall card</p>
    <h3>Walk the rooms.</h3>
    <div class="ve-stall-actions">
      <a href="#rooms">Walk in</a>
      <a href={phoneHref}>{phone}</a>
    </div>
  </aside>
</div>
