---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import TrovePlate from "./TrovePlate.astro";

/* Vintage etc. — 4 Main Street, Newcastle · County Down.
   Curated mid-century teak, brass curios, maritime antiques & vintage vinyl.
   Stock is the live feed. "Hold a Piece" direct line: 07584 034590. */

const phone = "07584 034590";
const phoneHref = "tel:+447584034590";
const facebook = "https://www.facebook.com/magsvintageetc/";
const instagram = "https://www.instagram.com/_vintage_etc/";
const maps = "https://maps.google.com/?q=4+Main+Street+Newcastle+BT33+0AD";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Libre+Bodoni:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Manrope:wght@400;500;600;700;800&display=swap";

const eras = [
  {
    tag: "1950s – 1970s",
    title: "Mid-Century Teak & Furniture",
    desc: "Authentic Danish and British teak sideboards (G-Plan, McIntosh), circular dining sets, nesting tables, and restored cocktail bars.",
  },
  {
    tag: "Nautical & Architectural",
    title: "Brass, Clocks & Maritime Curios",
    desc: "Reclaimed ship's brass lanterns, heavy maritime bells, mechanical wall clocks, barometer dials, and antique architectural hardware.",
  },
  {
    tag: "The Crate",
    title: "Vintage Vinyl & Turntable Vault",
    desc: "Crates of original pressing LPs spanning classic rock, jazz, soul, folk, and blues alongside vintage audio components and record players.",
  },
  {
    tag: "Eclectic Discovery",
    title: "Retro Barware & Studio Pottery",
    desc: "Smoked glass decanter sets, 1960s ceramic vases, vintage advertising tin signs, and tactile curios for home and studio.",
  },
];
---

<ConceptLayout
  title={"Vintage etc. — Mid-Century Teak, Curios & Vinyl, Newcastle"}
  slug="vintage-etc"
  bodyClass="concept-page concept-vintage-etc"
  lang="en-GB"
  businessName="Vintage etc."
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="Atmospheric antiques scenes and furniture details are AI-generated illustrative visualisations of 4 Main Street."
>
  <div class="ve-strip">
    <span>4 Main Street, Newcastle · BT33 0AD · Mid-Century · Antiques · Vinyl Crates</span>
    <span class="ve-strip-r">
      <a href={phoneHref}>{phone}</a>
      <span aria-hidden="true"> · </span>
      <a href={facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
      <span aria-hidden="true"> · </span>
      <a href={instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
    </span>
  </div>

  <header class="ve-header">
    <a class="ve-brand" href="/concepts/vintage-etc/">
      <span class="ve-brand-mark" aria-hidden="true">
        <svg width="40" height="36" viewBox="0 0 40 36" fill="none">
          <path d="M6 14h28v12H6Z" stroke="currentColor" stroke-width="1.5"/>
          <path d="M6 14h28v3.2H6Z" fill="currentColor" opacity=".18"/>
          <path d="M15.2 14v12M24.8 14v12" stroke="currentColor" stroke-width="1.2"/>
          <circle cx="10.6" cy="22.4" r="1.05" fill="currentColor"/>
          <circle cx="20" cy="22.4" r="1.05" fill="currentColor"/>
          <circle cx="29.4" cy="22.4" r="1.05" fill="currentColor"/>
          <path d="M8.2 26L6.4 33.2M31.8 26l1.8 7.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M4 33.2h32" stroke="currentColor" stroke-width="1.2"/>
        </svg>
      </span>
      <span class="ve-brand-text">
        <span class="ve-brand-name">Vintage etc.</span>
        <span class="ve-brand-sub">4 Main Street · Newcastle</span>
      </span>
    </a>
    <nav class="ve-nav" aria-label="Concept navigation">
      <a href="#trove">The Trove</a>
      <a href="#index">Collector’s Index</a>
      <a href="#hold">Hold a Piece</a>
      <a href="#door">The Door</a>
    </nav>
    <a class="ve-hold-btn" href={phoneHref}>Hold a Piece</a>
  </header>

  <main class="ve-main">
    <!-- Hero Trove Section -->
    <section class="ve-hero" id="trove" aria-labelledby="ve-hero-title">
      <div class="ve-hero-grid">
        <div class="ve-hero-copy">
          <p class="ve-eyebrow">Treasure Trove · 4 Main Street</p>
          <h1 id="ve-hero-title">A treasure trove of all things vintage, mid century and more.</h1>
          <p class="ve-say">Come in. Do not wait for a grid. The piece you saw this morning lives on the floor.</p>
          <p class="ve-lede">
            Step inside our Main Street shop floor to discover curated mid-century teak sideboards,
            burnished maritime brass, vintage vinyl crates, and eclectic retro curios.
            Every piece is individual — once it’s gone, it’s gone.
          </p>
          <div class="ve-hero-actions">
            <a class="ve-btn-primary" href={phoneHref}>Ring {phone} to Hold</a>
            <a class="ve-btn-secondary" href="#index">Explore Eras & Stock</a>
          </div>
          <div class="ve-live-wire">
            <span class="ve-wire-badge">Live Feed Wire</span>
            <p>New discoveries arrive daily and are showcased live on our social feeds.</p>
          </div>
        </div>

        <div class="ve-hero-visual">
          <figure class="ve-figure">
            <picture>
              <source
                type="image/webp"
                srcset="/media/concepts/vintage-etc/vintage-etc-hero-trove-640.webp 640w, /media/concepts/vintage-etc/vintage-etc-hero-trove-1265.webp 1265w"
                sizes="(max-width: 800px) 100vw, 50vw"
              />
              <img
                src="/media/concepts/vintage-etc/vintage-etc-hero-trove.jpg"
                alt="Atmospheric vintage antiques trove interior with teak credenza, glowing brass lamps, and vinyl crates"
                width="1600"
                height="900"
                loading="eager"
              />
            </picture>
            <figcaption>The Main Street antique trove interior at 4 Main Street.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Curated Era & Collector's Index -->
    <section class="ve-index" id="index" aria-labelledby="ve-index-title">
      <div class="ve-section-head">
        <p class="ve-eyebrow">Curated Collections</p>
        <h2 id="ve-index-title">The Collector’s Index</h2>
        <p class="ve-section-intro">
          We hand-select statement pieces with character, patina, and history.
          Our inventory spans four distinct collectible disciplines.
        </p>
      </div>

      <div class="ve-index-layout">
        <div class="ve-eras-grid">
          {eras.map((era) => (
            <article class="ve-era-card">
              <span class="ve-era-tag">{era.tag}</span>
              <h3>{era.title}</h3>
              <p>{era.desc}</p>
            </article>
          ))}
        </div>

        <div class="ve-index-gallery">
          <figure class="ve-figure ve-figure--compact">
            <picture>
              <source
                type="image/webp"
                srcset="/media/concepts/vintage-etc/vintage-etc-teak-credenza-640.webp 640w, /media/concepts/vintage-etc/vintage-etc-teak-credenza-1265.webp 1265w"
                sizes="(max-width: 800px) 100vw, 40vw"
              />
              <img
                src="/media/concepts/vintage-etc/vintage-etc-teak-credenza.jpg"
                alt="Mid-century Danish teak credenza sideboard with turntable and brass curios"
                width="1200"
                height="900"
                loading="lazy"
              />
            </picture>
            <figcaption>1950s–1970s mid-century teak furniture & audio setup.</figcaption>
          </figure>

          <figure class="ve-figure ve-figure--compact">
            <picture>
              <source
                type="image/webp"
                srcset="/media/concepts/vintage-etc/vintage-etc-vinyl-crates-640.webp 640w, /media/concepts/vintage-etc/vintage-etc-vinyl-crates-1265.webp 1265w"
                sizes="(max-width: 800px) 100vw, 40vw"
              />
              <img
                src="/media/concepts/vintage-etc/vintage-etc-vinyl-crates.jpg"
                alt="Weathered timber crates filled with classic vintage LP vinyl records"
                width="1200"
                height="800"
                loading="lazy"
              />
            </picture>
            <figcaption>The vinyl vault: collector LP crates & original pressings.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Hold a Piece Dock & Live Feeds -->
    <section class="ve-hold" id="hold" aria-labelledby="ve-hold-title">
      <div class="ve-hold-wrap">
        <div class="ve-hold-copy">
          <p class="ve-eyebrow">Same-Day Telephone Reservation</p>
          <h2 id="ve-hold-title">Hold a Piece Before It Leaves the Floor</h2>
          <p>
            Spot something on our morning Facebook or Instagram feed?
            Because vintage pieces are strictly one-of-a-kind, we hold items over the phone
            for customer collection. Ring our shop line directly.
          </p>
          <div class="ve-hold-callout">
            <p class="ve-hold-label">Direct Reservation Line</p>
            <a class="ve-hold-phone" href={phoneHref}>{phone}</a>
            <p class="ve-hold-sub">Call ahead to secure furniture, brass, or vinyl items.</p>
          </div>
          <div class="ve-social-bar">
            <a class="ve-social-btn" href={instagram} target="_blank" rel="noopener noreferrer">
              <span>Instagram:</span> @_vintage_etc
            </a>
            <a class="ve-social-btn" href={facebook} target="_blank" rel="noopener noreferrer">
              <span>Facebook:</span> Vintage etc. Newcastle
            </a>
          </div>
        </div>

        <div class="ve-hold-artefact">
          <TrovePlate />
        </div>
      </div>
    </section>

    <!-- The Door / Find Us Block -->
    <section class="ve-door" id="door" aria-labelledby="ve-door-title">
      <div class="ve-door-head">
        <p class="ve-eyebrow">Visit Newcastle Main Street</p>
        <h2 id="ve-door-title">4 Main Street, Newcastle</h2>
      </div>
      <div class="ve-door-grid">
        <div class="ve-door-col">
          <h3>The Shop Door</h3>
          <p>
            Vintage etc.<br />
            4 Main Street<br />
            Newcastle, County Down<br />
            BT33 0AD
          </p>
          <a class="ve-link" href={maps} target="_blank" rel="noopener noreferrer">Open in Google Maps →</a>
        </div>
        <div class="ve-door-col">
          <h3>Floor Stock</h3>
          <p>
            Walk in anytime during trading hours. New furniture and collectibles
            are uncrated and staged throughout the week.
          </p>
          <p>Local furniture delivery arranged upon request.</p>
        </div>
        <div class="ve-door-col">
          <h3>Enquiries & Holds</h3>
          <p>Telephone: <a href={phoneHref}><strong>{phone}</strong></a></p>
          <p>
            Instagram: <a href={instagram} target="_blank" rel="noopener noreferrer">@_vintage_etc</a><br />
            Facebook: <a href={facebook} target="_blank" rel="noopener noreferrer">magsvintageetc</a>
          </p>
        </div>
      </div>
    </section>
  </main>
</ConceptLayout>
