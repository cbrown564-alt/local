---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import CounterBridge from "./CounterBridge.astro";
import CustomerVoice from "./CustomerVoice.astro";
import {
  ADDRESS,
  HOURS,
  INDICATIVE,
  NAME_COUNTER,
  PHONE,
  PHONE_HREF,
  PLACE,
  POSTCODE,
  askAtTheCounter,
  hire,
  hireIsConfirmed,
  hireStanding,
} from "./record";

/* One icon per verified category, keyed by id so a category cannot silently
   lose its mark when the sheet is replaced by the shop's own. */
const icons: Record<string, string> = {
  power:
    '<rect x="2" y="12" width="16" height="4" rx="1" fill="currentColor" opacity=".25"/><path d="M6 12 L8 4 H14 L12 12 Z" fill="currentColor"/>',
  garden:
    '<circle cx="5" cy="15" r="2.5" stroke="currentColor" stroke-width="1.5"/><circle cx="15" cy="15" r="2.5" stroke="currentColor" stroke-width="1.5"/><path d="M3 14 L7 6 H17 L17 14" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>',
  plant:
    '<rect x="1" y="12" width="18" height="5" rx="1" fill="currentColor" opacity=".2"/><path d="M4 12 V7 H10 V12" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><rect x="11" y="9" width="6" height="3" rx=".5" stroke="currentColor" stroke-width="1.5"/><circle cx="5" cy="16" r="1.5" fill="currentColor"/><circle cx="15" cy="16" r="1.5" fill="currentColor"/>',
  access:
    '<rect x="7" y="2" width="6" height="14" rx="1" stroke="currentColor" stroke-width="1.5"/><path d="M4 6 H7 M13 6 H16 M4 10 H7 M13 10 H16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><rect x="6" y="16" width="8" height="2" rx=".5" fill="currentColor" opacity=".4"/>',
};
---

<ConceptLayout title={"Hire price list — The Tool Centre concept"} slug="tool-centre" bodyClass="concept-page concept-tool-centre" lang="en-GB">
<div class="tc-strip">
      <span><strong>{ADDRESS}</strong> · {PLACE} · {POSTCODE}</span>
      <span>{HOURS} · <a href={PHONE_HREF}>{PHONE}</a></span>
    </div>
    <header class="tc-header">
      <a class="tc-brand" href="/concepts/tool-centre/">
        <svg class="tc-mark" width="42" height="42" viewBox="0 0 42 42" fill="none" aria-hidden="true">
          <circle cx="21" cy="21" r="20" fill="#0e0e0e" />
          <path d="M10 28 L16 8 H32 L26 28 Z" fill="#f0d000" />
          <path d="M12 24 H28 V28 H12 Z" fill="#0e0e0e" />
        </svg>
        <span class="tc-brand-text">
          <span class="tc-brand-name">{NAME_COUNTER}</span>
          <span class="tc-brand-sub">Hardware · Hire</span>
        </span>
      </a>
      <nav class="tc-nav" aria-label="Concept navigation">
        <a href="/concepts/tool-centre/#tc-counter">The shop</a><a href="/concepts/tool-centre/hire-list/" aria-current="page">Hire</a>
      </nav>
      <a class="tc-call" href={PHONE_HREF}>Call {PHONE}</a>
    </header>

    <main>
      <section class="tc-hl-page">
        <div class="tc-hl-page-inner">
          <p class="tc-kicker">{PLACE}</p>
          <h1>Hire price list.</h1>
          <p class="tc-hl-sub">
            Day rates for plant, power tools, garden machinery and access
            equipment — collected out the back at {ADDRESS}.
          </p>
        </div>
        <div class="tc-hl-notice" aria-label="Pricing notice">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/>
            <path d="M9 5v4M9 12v.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <span class="tc-indicative">{INDICATIVE}</span>
        </div>
      </section>

      <div class="tc-hl-body">
        <div class="tc-hl-main">
          <div class="tc-hl-cats">
            {hire.map((category) => (
              <article class="tc-hl-cat">
                <header class="tc-hl-cat-head">
                  <span class="tc-hl-cat-icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" set:html={icons[category.id] ?? ""} />
                  </span>
                  <h2>{category.name}</h2>
                  <span class="tc-hl-cat-note">{hireIsConfirmed ? "Day hire" : "Suggested"}</span>
                </header>
                <ul class="tc-hl-items">
                  {category.items.map((item) => (
                    <li class="tc-hl-item">
                      <span class="tc-hl-item-name">{item.name}</span>
                      <span class="tc-hl-item-rate">{item.rate}</span>
                    </li>
                  ))}
                  <li class="tc-hl-item tc-hl-item--week">
                    <span class="tc-hl-item-name">{category.extra}</span>
                  </li>
                </ul>
              </article>
            ))}
          </div>
          <CustomerVoice which="hire" />
        </div>

        <aside class="tc-hl-sidebar">
          <div class="tc-hl-panel">
            <p class="tc-desk-kicker">Hire desk</p>
            <h2>Ready to hire?</h2>
            <p class="tc-hl-panel-body">Ring the yard — seven days, same number as the shop.</p>
            <a class="tc-desk-cta" href={PHONE_HREF}>Call {PHONE}</a>
            <small>{HOURS}</small>
          </div>

          <div class="tc-hl-conditions">
            <p class="tc-hl-cond-head">What to ask when you ring</p>
            <ul>
              {askAtTheCounter.map((question) => <li>{question}</li>)}
            </ul>
            <p class="tc-hl-standing">{hireStanding}</p>
          </div>

          <div class="tc-hl-also">
            <p class="tc-hl-cond-head">Also at the counter</p>
            <a class="tc-hl-also-link" href="/concepts/tool-centre/#tc-counter">Hardware &amp; trade counter →</a>
            <a class="tc-hl-also-link" href="/concepts/tool-centre/#tc-counter">Calor bottled gas →</a>
          </div>
        </aside>
      </div>

      <CounterBridge />
    </main>
</ConceptLayout>
