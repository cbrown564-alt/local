---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import CounterBridge from "./CounterBridge.astro";
import CustomerVoice from "./CustomerVoice.astro";
import {
  ADDRESS,
  HOURS,
  INDICATIVE,
  NAME_COUNTER,
  PHONE,
  PHONE_HREF,
  PLACE,
  POSTCODE,
} from "./record";
---

<ConceptLayout title={"The Tool Centre — independent concept"} slug="tool-centre" bodyClass="concept-page concept-tool-centre" lang="en-GB">
<div class="tc-strip">
      <span><strong>{ADDRESS}</strong> · {PLACE} · {POSTCODE}</span>
      <span>{HOURS} · <a href={PHONE_HREF}>{PHONE}</a></span>
    </div>
    <header class="tc-header">
      <a class="tc-brand" href="/concepts/tool-centre/">
        <svg class="tc-mark" width="42" height="42" viewBox="0 0 42 42" fill="none" aria-hidden="true">
          <circle cx="21" cy="21" r="20" fill="#0e0e0e" />
          <path d="M10 28 L16 8 H32 L26 28 Z" fill="#f0d000" />
          <path d="M12 24 H28 V28 H12 Z" fill="#0e0e0e" />
        </svg>
        <span class="tc-brand-text">
          <span class="tc-brand-name">{NAME_COUNTER}</span>
          <span class="tc-brand-sub">Hardware · Hire</span>
        </span>
      </a>
      <nav class="tc-nav" aria-label="Concept navigation">
        <a href="#tc-counter">The shop</a><a href="/concepts/tool-centre/hire-list/">Hire</a>
      </nav>
      <a class="tc-call" href={PHONE_HREF}>Call {PHONE}</a>
    </header>
    <main class="tc-hero">
      <section class="tc-story">
        <p class="tc-kicker">{PLACE}</p>
        <h1>Hardware on the shelf.<br aria-hidden="true" /><em>Hire on the yard.</em></h1>
        <p class="tc-lede">
          Tools, gas and day hire on Main Street — Newcastle under the Mournes,
          Co. Down. Ring us for today's rate.
        </p>
        <CustomerVoice which="shop" />
        <div class="tc-actions">
          <a class="tc-cta" href={PHONE_HREF}>Call for hire rates</a>
          <a class="tc-link" href="/concepts/tool-centre/hire-list/">See the hire list →</a>
        </div>
      </section>
      <aside class="tc-panel">
        <article class="tc-desk">
          <p class="tc-desk-kicker">Hire desk</p>
          <h2>Today's rates — ask us.</h2>
          <ul class="tc-rates">
            <li><span class="tc-rate-item">Power tools</span><span class="tc-rate-ask">Day rate on request</span></li>
            <li><span class="tc-rate-item">Garden machinery</span><span class="tc-rate-ask">Day rate on request</span></li>
            <li><span class="tc-rate-item">Plant &amp; site gear</span><span class="tc-rate-ask">Day rate on request</span></li>
            <li><span class="tc-rate-item">Access equipment</span><span class="tc-rate-ask">Day rate on request</span></li>
          </ul>
          <a class="tc-desk-cta" href={PHONE_HREF}>Call {PHONE}</a>
          <small class="tc-indicative">{INDICATIVE}</small>
        </article>
      </aside>
      <CounterBridge />
    </main>
</ConceptLayout>
