---
/* Shelf and yard — the two offers, side by side.
   ============================================================
   Guests care that the shop sells hardware and hires plant, not which
   Facebook trading name covers which half. Co. Down stays in the strip and
   lede; the Plant Hire name lives once, quietly, on the Facebook link. */
import { FACEBOOK, NAME_YARD, PHONE, PHONE_HREF, shelf, yard } from "./record";
---

<section class="tc-offer" id="tc-counter" aria-label="Hardware and hire">
  <div class="tc-offer-pair">
    <article class="tc-offer-side tc-offer-side--shelf">
      <p class="tc-offer-label">{shelf.label}</p>
      <h2 class="tc-offer-name">{shelf.name}</h2>
      <ul class="tc-offer-lines">
        {shelf.lines.map((line) => (
          <li>{line.name}{line.note ? ` — ${line.note}` : ""}</li>
        ))}
      </ul>
    </article>

    <article class="tc-offer-side tc-offer-side--yard">
      <p class="tc-offer-label">{yard.label}</p>
      <h2 class="tc-offer-name">{yard.name}</h2>
      <ul class="tc-offer-lines">
        {yard.lines.map((line) => (
          <li>{line.name}{line.note ? ` — ${line.note}` : ""}</li>
        ))}
      </ul>
      <a class="tc-offer-more" href="/concepts/tool-centre/hire-list/">See the hire list →</a>
    </article>
  </div>

  <div class="tc-offer-foot">
    <a class="tc-offer-call" href={PHONE_HREF}>Call {PHONE}</a>
    <a class="tc-offer-fb" href={FACEBOOK}>{NAME_YARD} on Facebook →</a>
  </div>
</section>
