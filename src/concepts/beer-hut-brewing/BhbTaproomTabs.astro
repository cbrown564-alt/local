---
/* Beer Hut Brewing: Small-Batch Cans, Taproom, and Pizza segmented tablist paired with fermenters pour plate */
const shopHref = "https://beerhutbrewing.co.uk/";
const phone = "07885 566599";

const tabs = [
  {
    id: "cans",
    label: "Small-batch cans",
    summary: "Unfiltered flavour brewed below Slieve Binnian, cold-conditioned in Kilkeel and packed fresh to order.",
    rows: [
      {
        title: "Rotating 440ml brewery releases",
        detail: "Hazy pale ales, hop-forward IPAs, crisp lagers and dark stouts straight from cold storage.",
        meta: "beerhutbrewing.co.uk",
      },
      {
        title: "Beer Hut Sub Club",
        detail: "Curated monthly boxes of our newest Kilkeel small-batch brews delivered across the UK and Ireland.",
        meta: "Monthly boxes",
      },
      {
        title: "Online shop and local pickup",
        detail: "Order mixed packs, gift packs and brewery merch online with local click-and-collect in Kilkeel.",
        meta: "Kilkeel collection",
      },
    ],
    ctaLabel: "Shop fresh cans online",
  },
  {
    id: "taproom",
    label: "Taproom",
    summary: "Fresh pours straight from the bright tanks beside the stainless fermenters every Saturday.",
    rows: [
      {
        title: "Saturday brewhouse pours",
        detail: "Hazy IPAs, crisp pilsners, rich stouts and seasonal sours served fresh off the Kilkeel lines.",
        meta: "Saturdays",
      },
      {
        title: "Minutes from the Mournes and harbour",
        detail: "Relaxed coastal atmosphere at Binnian Enterprise Park after a day on the Mourne trails.",
        meta: "Kilkeel BT34",
      },
      {
        title: "Beer Hut Running Club",
        detail: "Friendly local social runs across South Down finishing back at the brewhouse taproom.",
        meta: "All welcome",
      },
    ],
    ctaLabel: "Check taproom releases",
  },
  {
    id: "pizza",
    label: "Pizza",
    summary: "Artisan wood-fired pizza served right beside the tanks to match Saturday taproom pours.",
    rows: [
      {
        title: "Served hot beside the fermenters",
        detail: "Freshly baked artisan pizza pairing directly with cold-conditioned lagers, pale ales and IPAs.",
        meta: "Taproom Saturdays",
      },
      {
        title: "Built for groups off the trails",
        detail: "Gather around timber tables in Kilkeel with friends, walkers and visiting brewery fans.",
        meta: "Walk-ins and groups",
      },
      {
        title: "Seasonal hours and updates",
        detail: "Check beerhutbrewing.co.uk or ring the brewhouse desk directly ahead of your Saturday visit.",
        meta: phone,
      },
    ],
    ctaLabel: "See Saturday updates",
  },
];
---

<section class="bhb-section bhb-bone" id="taproom" aria-labelledby="bhb-tabs-title">
  <div class="bhb-wrap bhb-stage-grid">
    <div class="bhb-stage-main" data-bhb-tabs>
      <h2 id="bhb-tabs-title">Fresh off the Kilkeel tanks, in cans or at the bar.</h2>

      <div class="bhb-tabs" role="tablist" aria-label="Small-batch cans, taproom and pizza">
        {tabs.map((tab, idx) => (
          <button
            type="button"
            role="tab"
            id={`bhb-tab-${tab.id}`}
            aria-controls={`bhb-panel-${tab.id}`}
            aria-selected={idx === 0 ? "true" : "false"}
            class:list={["bhb-tab", idx === 0 && "is-active"]}
            data-bhb-tab={tab.id}
          >
            {tab.label}
          </button>
        ))}
      </div>

      {tabs.map((tab, idx) => (
        <div
          class="bhb-panel"
          role="tabpanel"
          id={`bhb-panel-${tab.id}`}
          aria-labelledby={`bhb-tab-${tab.id}`}
          data-bhb-panel={tab.id}
          hidden={idx !== 0}
        >
          <p class="bhb-panel-summary">{tab.summary}</p>
          <dl class="bhb-ledger">
            {tab.rows.map((row) => (
              <div class="bhb-ledger-row">
                <dt>{row.title}</dt>
                <dd>
                  <span class="bhb-ledger-detail">{row.detail}</span>
                  <span class="bhb-ledger-meta">{row.meta}</span>
                </dd>
              </div>
            ))}
          </dl>
          <div class="bhb-panel-foot">
            <a class="bhb-obsidian-btn" href={shopHref} target="_blank" rel="noopener noreferrer">
              {tab.ctaLabel}
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="bhb-stage-visual">
      <figure class="bhb-plate">
        <picture>
          <source
            srcset="/media/concepts/beer-hut-brewing/beer-hut-fermenters-pour-640.webp 640w, /media/concepts/beer-hut-brewing/beer-hut-fermenters-pour-1265.webp 1265w"
            sizes="(max-width: 960px) 100vw, 44vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/beer-hut-brewing/beer-hut-fermenters-pour.jpg"
            alt="Golden hazy IPA pouring from a brushed steel tap into a stemmed tasting glass against dark slate and stainless steel tanks"
            width="1408"
            height="768"
            loading="lazy"
          />
        </picture>
        <figcaption>Indicative small-batch hazy IPA tap pour visualisation.</figcaption>
      </figure>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-bhb-tabs]");
    if (!root) return;
    const tabs = [...root.querySelectorAll("[data-bhb-tab]")];
    const panels = [...root.querySelectorAll("[data-bhb-panel]")];

    const activateTab = (id) => {
      if (!id) return;
      tabs.forEach((t) => {
        const active = t.getAttribute("data-bhb-tab") === id;
        t.classList.toggle("is-active", active);
        t.setAttribute("aria-selected", active ? "true" : "false");
      });
      panels.forEach((p) => {
        p.hidden = p.getAttribute("data-bhb-panel") !== id;
      });
    };

    tabs.forEach((btn) => {
      btn.addEventListener("click", () => activateTab(btn.getAttribute("data-bhb-tab")));
    });

    document.querySelectorAll("[data-bhb-nav-tab]").forEach((link) => {
      link.addEventListener("click", () => activateTab(link.getAttribute("data-bhb-nav-tab")));
    });
  })();
</script>
