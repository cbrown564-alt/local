---
/* Beer Hut Brewing — Interactive Taproom, Shop & Community Guide.
   Unpacks Kilkeel's Saturday taproom & pizza, online cans, Sub Club, Running Club & Trade stockists. */
const channels = [
  {
    id: "taproom",
    label: "Saturday Taproom",
    title: "Fresh pours from the bright tanks alongside artisan pizza every Saturday.",
    points: [
      "Hazy IPAs, crisp pilsners, rich stouts and seasonal sours straight off the lines",
      "Wood-fired artisan pizza served beside the brewhouse tanks in Kilkeel",
      "Relaxed coastal atmosphere minutes from Kilkeel harbour and the Mournes",
    ],
    note: "Bring friends straight off the Mourne trails — check our online shop or ring 07885 566599 for seasonal taproom times.",
  },
  {
    id: "shop",
    label: "Online Shop",
    title: "Small-batch cans, mixed packs and fresh brewery releases delivered to your door.",
    points: [
      "Direct-from-brewery cold-stored cans packed in Kilkeel",
      "Rotating small-batch hazy pale ales, IPAs and dark releases",
      "Gift packs and brewery merch ready to order at beerhutbrewing.co.uk",
    ],
    note: "Fresh releases drop regularly through our online store alongside click-and-collect in Kilkeel.",
  },
  {
    id: "clubs",
    label: "Sub Club & Running Club",
    title: "Monthly brewery subscriptions and social Mourne running meet-ups.",
    points: [
      "Beer Hut Sub Club: curated monthly boxes of our newest Kilkeel brews",
      "Beer Hut Running Club: friendly local runs finishing back at the taproom",
      "First access to limited small-batch collaborations and taproom nights",
    ],
    note: "Both clubs are open to locals and weekend visitors across South Down.",
  },
  {
    id: "trade",
    label: "Trade Stockists",
    title: "Kegs and cans supplied to independent bars, restaurants and bottle shops.",
    points: [
      "Reliable independent Northern Ireland craft beer range",
      "Fresh kegs and eye-catching 440ml cans brewed at Binnian Enterprise Park",
      "Direct trade support from our Kilkeel brewery team on 07885 566599",
    ],
    note: "Ring the brewery directly to discuss tap lines, mixed cases or seasonal pours.",
  },
];
---

<section class="bhb-tabs-band" id="taproom" aria-labelledby="bhb-tabs-title">
  <div class="bhb-wrap">
    <div class="bhb-tabs-card" data-bhb-tabs>
      <div class="bhb-tabs-head">
        <div>
          <p class="bhb-kicker">Kilkeel Brewhouse · Taproom &amp; Community</p>
          <h2 id="bhb-tabs-title">Four ways to experience Beer Hut.</h2>
        </div>
        <div class="bhb-tab-list" role="tablist" aria-label="Choose Beer Hut section">
          {channels.map((ch, idx) => (
            <button
              type="button"
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
              class:list={["bhb-tab", idx === 0 && "is-active"]}
              data-bhb-tab={ch.id}
            >
              {ch.label}
            </button>
          ))}
        </div>
      </div>

      {channels.map((ch, idx) => (
        <div class="bhb-panel" role="tabpanel" data-bhb-panel={ch.id} hidden={idx !== 0}>
          <h3>{ch.title}</h3>
          <ul class="bhb-points">
            {ch.points.map((pt) => <li>{pt}</li>)}
          </ul>
          <div class="bhb-panel-foot">
            <p class="bhb-note"><strong>Brewhouse note:</strong> {ch.note}</p>
            <a class="bhb-btn bhb-btn--primary" href="https://beerhutbrewing.co.uk/" target="_blank" rel="noopener noreferrer">Visit Online Shop ↗</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .bhb-tabs-band { padding: clamp(46px, 6vw, 76px) 0; }
  .bhb-tabs-card {
    background: #1b2025;
    border: 1px solid rgba(243, 244, 246, 0.14);
    border-top: 3px solid #e39a2b;
    padding: clamp(24px, 4vw, 40px);
    border-radius: 2px;
  }
  .bhb-tabs-head {
    display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 18px;
    padding-bottom: 22px; border-bottom: 1px solid rgba(243, 244, 246, 0.12);
  }
  .bhb-tabs-head h2 { margin: 0; font-family: var(--bhb-display); font-size: clamp(1.65rem, 3vw, 2.35rem); font-weight: 700; color: #f3f4f6; }
  .bhb-tab-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .bhb-tab {
    padding: 9px 14px; border: 1px solid rgba(243, 244, 246, 0.22); background: #14171a; color: #f3f4f6;
    font-family: var(--bhb-sans); font-size: 0.86rem; font-weight: 600; border-radius: 2px; cursor: pointer;
  }
  .bhb-tab.is-active { background: #e39a2b; border-color: #e39a2b; color: #111417; }
  .bhb-panel { padding-top: 24px; }
  .bhb-panel h3 { margin: 0 0 18px; font-family: var(--bhb-display); font-size: 1.32rem; font-weight: 600; color: #f3f4f6; }
  .bhb-points {
    list-style: none; padding: 0; margin: 0 0 24px;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px;
  }
  .bhb-points li {
    background: #14171a; border: 1px solid rgba(243, 244, 246, 0.1);
    padding: 14px 16px; font-size: 0.92rem; color: rgba(243, 244, 246, 0.88); border-radius: 2px;
  }
  .bhb-panel-foot { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; }
  .bhb-note { margin: 0; font-size: 0.9rem; color: rgba(243, 244, 246, 0.72); max-width: 54ch; }
  .bhb-note strong { color: #f3f4f6; }
  @media (max-width: 780px) { .bhb-points { grid-template-columns: minmax(0, 1fr); } }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-bhb-tabs]");
    if (!root) return;
    const tabs = [...root.querySelectorAll("[data-bhb-tab]")];
    const panels = [...root.querySelectorAll("[data-bhb-panel]")];
    tabs.forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-bhb-tab");
        tabs.forEach((t) => {
          const active = t === btn;
          t.classList.toggle("is-active", active);
          t.setAttribute("aria-selected", active ? "true" : "false");
        });
        panels.forEach((p) => { p.hidden = p.getAttribute("data-bhb-panel") !== id; });
      });
    });
  })();
</script>
