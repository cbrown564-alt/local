---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import BhbTaproomTabs from "./BhbTaproomTabs.astro";
import "./styles.css";

/* Beer Hut Brewing — 32A Greencastle Street / Unit 14 Binnian Enterprise Park, Kilkeel BT34 4BH.
   Verified live 27 Nov 2026: beerhutbrewing.co.uk duplicates its 10-item Shopify nav bar twice, obscuring
   its Saturday Kilkeel taproom (fresh IPAs, stouts, sours + artisan pizza), Sub Club, and Running Club.
   Contacts: 07885 566599, https://beerhutbrewing.co.uk/. */
const phone = "07885 566599";
const phoneHref = "tel:+447885566599";
const shopHref = "https://beerhutbrewing.co.uk/";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Beer+Hut+Brewing+Unit+14+Binnian+Enterprise+Park+Kilkeel+BT34+4BH";
---

<ConceptLayout
  title="Beer Hut Brewing — Small-Batch Craft Brewery & Taproom, Kilkeel"
  slug="beer-hut-brewing"
  bodyClass="concept-page concept-beerhut"
  businessName="Beer Hut Brewing"
  town="Kilkeel"
  bannerNote="Imagery comprises indicative Kilkeel craft brewery taproom and small-batch hazy IPA pour visualisations."
>
  <header class="bhb-header" data-bhb-header>
    <div class="bhb-header-inner">
      <a class="bhb-brand" href="#top">
        <span class="bhb-mark" aria-hidden="true"></span>
        <span>Beer Hut Brewing</span>
      </a>

      <nav class="bhb-nav" aria-label="Primary">
        <a class="bhb-nav-link" href="#taproom">Taproom</a>
        <a class="bhb-nav-link" href="#brews">Small-Batch</a>
        <a class="bhb-nav-link" href="#location">Kilkeel</a>
      </nav>

      <div class="bhb-header-actions">
        <a class="bhb-header-tel" href={phoneHref}>{phone}</a>
        <a class="bhb-pill-cta" href={shopHref} target="_blank" rel="noopener noreferrer">Shop beers</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="bhb-hero" aria-labelledby="bhb-hero-title">
      <figure class="bhb-hero-media">
        <picture>
          <source srcset="/media/concepts/beer-hut-brewing/beer-hut-taproom-evening-640.webp 640w, /media/concepts/beer-hut-brewing/beer-hut-taproom-evening-1265.webp 1265w" sizes="100vw" type="image/webp" />
          <img src="/media/concepts/beer-hut-brewing/beer-hut-taproom-evening.jpg" alt="Moody Saturday craft brewery taproom under warm festoon bulbs with stainless steel fermenters and poured hazy IPA and stout" width="1408" height="768" loading="eager" />
        </picture>
        <div class="bhb-hero-scrim" aria-hidden="true"></div>
      </figure>

      <div class="bhb-wrap bhb-hero-stage">
        <div class="bhb-hero-headline">
          <h1 id="bhb-hero-title" class="bhb-reveal bhb-reveal-1">
            Small-batch Mourne<br /><span>pours on Saturdays.</span>
          </h1>
        </div>

        <div class="bhb-hero-foot">
          <div class="bhb-hero-copy bhb-reveal bhb-reveal-2">
            <p>
              Independent Kilkeel microbrewery crafting hazy IPAs, lagers and rich stouts, poured
              beside the tanks with artisan pizza.
            </p>
            <div class="bhb-hero-actions">
              <a class="bhb-arrow-btn" href={shopHref} target="_blank" rel="noopener noreferrer">
                <span class="bhb-arrow-label">Shop fresh cans</span>
                <span class="bhb-arrow-circle" aria-hidden="true">
                  <svg class="bhb-arrow bhb-arrow--primary" width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  <svg class="bhb-arrow bhb-arrow--clone" width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
              </a>
              <a class="bhb-ghost-link" href={phoneHref}>Call {phone}</a>
            </div>
          </div>

          <div class="bhb-hero-meta bhb-reveal bhb-reveal-3">
            <a class="bhb-scroll-cue" href="#taproom">
              <span>Scroll down</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M6 2.5v7M3 6.5L6 9.5l3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
            <p class="bhb-visual-note">Kilkeel taproom · indicative visualisation</p>
          </div>
        </div>
      </div>
    </section>

    <BhbTaproomTabs />

    <section class="bhb-section bhb-brews" id="brews" aria-labelledby="bhb-br-title">
      <div class="bhb-wrap bhb-split">
        <figure class="bhb-plate">
          <picture>
            <source srcset="/media/concepts/beer-hut-brewing/beer-hut-fermenters-pour-640.webp 640w, /media/concepts/beer-hut-brewing/beer-hut-fermenters-pour-1265.webp 1265w" sizes="(max-width: 860px) 100vw, 48vw" type="image/webp" />
            <img src="/media/concepts/beer-hut-brewing/beer-hut-fermenters-pour.jpg" alt="Golden hazy IPA pouring from a brushed steel tap into a stemmed tasting glass against dark slate and stainless steel tanks" width="1408" height="768" loading="lazy" />
          </picture>
          <figcaption>Small-batch tap pour · indicative brewery visualisation.</figcaption>
        </figure>
        <div>
          <p class="bhb-eyebrow">Brewed below Slieve Binnian</p>
          <h2 id="bhb-br-title">Unfiltered flavour, brewed in small runs on the Mourne coast.</h2>
          <p class="bhb-body">
            Every batch leaves our Kilkeel tanks cold-conditioned and packed with aroma. Drop into
            our Saturday taproom for pizza and pints beside the stainless fermenters, or join our
            monthly Sub Club anywhere in the UK and Ireland.
          </p>
          <dl class="bhb-contact-list">
            <div><dt>Taproom &amp; Trade Desk</dt><dd><a href={phoneHref}>{phone}</a></dd></div>
            <div><dt>Address</dt><dd>Unit 14 Binnian Enterprise Park, Kilkeel</dd></div>
            <div><dt>Online Store</dt><dd><a href={shopHref} target="_blank" rel="noopener noreferrer">beerhutbrewing.co.uk ↗</a></dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section class="bhb-section bhb-map-band" id="location" aria-label="Kilkeel brewery location map">
      <div class="bhb-wrap">
        <LocalAreaMap
          id="bhb-map"
          tone="dark"
          kicker="Binnian Enterprise Park · Kilkeel"
          businessName="Beer Hut Brewing"
          address="Unit 14 Binnian Enterprise Park, Kilkeel, BT34 4BH"
          lon={-5.9941}
          lat={54.0615}
          spanKm={16}
          mapHref={mapsHref}
          markers={[
            { name: "Kilkeel Harbour", lon: -5.9904, lat: 54.0548, note: "3 mins south", side: "b" },
            { name: "Cranfield Beach", lon: -6.0684, lat: 54.0218, note: "9 mins south-west", side: "l" },
            { name: "Silent Valley", lon: -5.9926, lat: 54.1399, note: "12 mins north", side: "t" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="bhb-footer">
    <div class="bhb-wrap bhb-footer-inner">
      <div>
        <strong>Beer Hut Brewing</strong>
        <p>Unit 14 Binnian Enterprise Park / 32A Greencastle St, Kilkeel, BT34 4BH</p>
      </div>
      <div class="bhb-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={shopHref} target="_blank" rel="noopener noreferrer">Online Shop ↗</a>
        <a href={mapsHref} target="_blank" rel="noopener noreferrer">Directions ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-bhb-header]");
      if (!header) return;
      const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 40);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    })();
  </script>
</ConceptLayout>
