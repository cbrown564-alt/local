---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

/* Harbour House Newcastle — meal on the sea wall. Speak as Harbour House.
   Kind: meal. Rooms = named stock + Accommodation handoff.
   First-party home re-read 13 Sep 2026 Europe/London.
   Do not invent kitchen hours or a live specials board.
   Door = harbour / sea wall at 4–8 South Promenade. */

const phone = "028 4372 3445";
const phoneHref = "tel:+442843723445";
const email = "harbourhousenewcastle@gmail.com";
const mailto = `mailto:${email}`;
const site = "https://www.harbourhousenewcastle.com/";
const bookTable = "https://www.harbourhousenewcastle.com/book-a-table/";
const accommodation = "https://www.harbourhousenewcastle.com/accommodation/";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Manrope:wght@400;500;600;700;800&display=swap";

const houseParts = [
  {
    id: "brew",
    kicker: "South Prom Brew Bar",
    title: "Coffee looking at the Irish Sea.",
    body: "Breakfast and brunch needs, looking out to the water. Freshly made morning fare by the harbour.",
  },
  {
    id: "terrace",
    kicker: "Water Edge Terrace",
    title: "Unwind at the edge.",
    body: "Our Water Edge Terrace & Cocktail Bar sits where the promenade meets the harbour. Drink in hand, water below.",
  },
  {
    id: "pantry",
    kicker: "The Pantry",
    title: "Family get-togethers.",
    body: "The Pantry is for gatherings, with one of the best beer-garden views for miles across Dundrum Bay.",
  },
];
---

<ConceptLayout
  title={"Harbour House Newcastle — independent concept"}
  slug="harbour-house"
  bodyClass="concept-page concept-harbour-house"
  lang="en-GB"
  businessName="Harbour House Newcastle"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="AI-generated illustrations imagine the setting, spaces and products; they are not photographs of the business."
>
  <div class="hh-strip">
    <span>4–8 South Promenade, Newcastle · BT33 0EX · On the sea wall</span>
    <span class="hh-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="hh-header">
    <div class="hh-header-inner">
      <a class="hh-brand" href="/concepts/harbour-house/">
        <span class="hh-brand-name">Harbour House</span>
        <span class="hh-brand-sub">Newcastle · South Promenade</span>
      </a>
      <nav class="hh-nav" aria-label="Concept navigation">
        <a href="#table">The Table</a>
        <a href="#house">The House</a>
        <a href="#rooms">Rooms</a>
        <a href="#find">Find Us</a>
      </nav>
      <a class="hh-book" href={bookTable} rel="noopener noreferrer">Book Table</a>
    </div>
  </header>

  <main class="hh-main">
    <section class="hh-hero" id="table" aria-labelledby="hh-name">
      <div class="hh-hero-copy">
        <p class="hh-kicker">Seafood · Sea Wall · Dundrum Bay</p>
        <h1 id="hh-name">Harbour House</h1>
        <p class="hh-place">4–8 South Promenade · Newcastle · BT33 0EX</p>
        <p class="hh-say">Built on the sea wall overlooking the harbour.</p>
        <p class="hh-lede">
          A family-run house on the South Promenade — Connolly second
          generation, more than forty years of welcome. Freshly
          caught seafood and shellfish specials, a bistro for all tastes,
          and panoramic views of Dundrum Bay.
        </p>
        <div class="hh-hero-actions">
          <a class="hh-btn-primary" href={bookTable} rel="noopener noreferrer">Book a Table</a>
          <a class="hh-btn-secondary" href={phoneHref}>Ring {phone}</a>
        </div>
      </div>

      <figure class="hh-hero-theatre">
        <img
          src="/media/concepts/harbour-house/harbour-house-hero-sea-wall.jpg"
          alt="Harbour House situated prominently on the stone sea wall of Newcastle harbour"
          width="1200"
          height="800"
          loading="eager"
        />
        <figcaption>4–8 South Promenade · Historic harbour setting on the sea wall</figcaption>
      </figure>
    </section>

    <section class="hh-section" id="plate" aria-labelledby="hh-appetite-title">
      <div class="hh-section-copy">
        <p class="hh-kicker">The Plate</p>
        <h2 id="hh-appetite-title">Fruits of the sea, daily.</h2>
        <p class="hh-lead">
          Seasonal menus with fresh, local, sustainable produce at their heart.
          Seafood and shellfish specials changing with the daily catch.
        </p>
        <blockquote class="hh-pull">
          <p>
            "Where the Mountains o’ Mourne sweep down to the sea."
          </p>
          <footer>— Over forty years of family welcome</footer>
        </blockquote>
      </div>

      <figure class="hh-photo-card">
        <img
          src="/media/concepts/harbour-house/harbour-house-seafood-platter.jpg"
          alt="Platter of fresh locally landed seafood and shellfish served overlooking the bay"
          width="1200"
          height="800"
          loading="lazy"
        />
        <figcaption>Fresh local catch · Landed and prepared right by the harbour</figcaption>
      </figure>
    </section>

    <section class="hh-section hh-section--house" id="house" aria-labelledby="hh-house-title">
      <figure class="hh-photo-card">
        <img
          src="/media/concepts/harbour-house/harbour-house-bay-terrace.jpg"
          alt="Water Edge Terrace with drinks overlooking Newcastle harbour and Dundrum Bay"
          width="1200"
          height="800"
          loading="lazy"
        />
        <figcaption>Water Edge Terrace · Unwind directly over the water</figcaption>
      </figure>

      <div class="hh-section-copy">
        <p class="hh-kicker">The House</p>
        <h2 id="hh-house-title">Named spaces of the house.</h2>
        <div class="hh-house-grid">
          {houseParts.map((part) => (
            <div class="hh-part" id={part.id}>
              <p class="hh-part-kicker">{part.kicker}</p>
              <h3>{part.title}</h3>
              <p>{part.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="hh-rooms" id="rooms" aria-labelledby="hh-rooms-title">
      <div class="hh-rooms-card">
        <div class="hh-rooms-copy">
          <p class="hh-kicker">Upstairs</p>
          <h2 id="hh-rooms-title">Eight en suites over Dundrum Bay.</h2>
          <p class="hh-lead">
            If your evening runs long, we keep eight en suite bedrooms with panoramic views of Dundrum Bay — modern amenities, calm coastal decor, and breakfasts our guests praise.
          </p>
          <div class="hh-hero-actions">
            <a class="hh-btn-primary" href={accommodation} rel="noopener noreferrer">View Accommodation →</a>
            <a class="hh-btn-secondary" href={phoneHref}>Enquire by Phone</a>
          </div>
        </div>

        <aside class="hh-stock" aria-label="Bedroom stock">
          <p class="hh-stock-num">8</p>
          <p class="hh-stock-label">En Suite Bedrooms</p>
          <p class="hh-stock-view">Panoramic Dundrum Bay views</p>
        </aside>
      </div>
    </section>

    <section class="hh-door-section" id="find" aria-labelledby="hh-find-title">
      <div class="hh-door-card">
        <p class="hh-kicker">Visit Us</p>
        <h2 id="hh-find-title">On the sea wall.</h2>
        <p class="hh-door-desc">
          Built on the sea wall overlooking the working harbour — Newcastle’s most historic coastal quarter.
        </p>

        <div class="hh-door-actions">
          <a class="hh-door-btn hh-door-btn--table" href={bookTable} rel="noopener noreferrer">
            <span class="hh-door-label">Reserve</span>
            <span class="hh-door-val">Book a Table →</span>
          </a>
          <a class="hh-door-btn" href={phoneHref}>
            <span class="hh-door-label">Telephone</span>
            <span class="hh-door-val">{phone}</span>
          </a>
          <a class="hh-door-btn" href={mailto}>
            <span class="hh-door-label">Email</span>
            <span class="hh-door-val">{email}</span>
          </a>
        </div>

        <address class="hh-address">
          <strong>Harbour House Newcastle</strong>
          <span>4–8 South Promenade</span>
          <span>Newcastle, Co. Down · BT33 0EX</span>
          <a href={site} rel="noopener noreferrer">Official site: harbourhousenewcastle.com</a>
        </address>
      </div>
    </section>
  </main>
</ConceptLayout>

