---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import SeaWallDoor from "./SeaWallDoor.astro";

/* Harbour House Newcastle — meal on the sea wall. Speak as Harbour House.
   Kind: meal. Rooms = named stock + Accommodation handoff, not hotel
   reserve theatre. First-party home re-read 13 Sep 2026 Europe/London.
   Do not invent kitchen hours or a live specials board. Do not clone
   Buck's Head / Enniskeen / Dundrum Inn. Door = harbour / sea wall. */

const phone = "028 4372 3445";
const phoneHref = "tel:+442843723445";
const email = "harbourhousenewcastle@gmail.com";
const mailto = `mailto:${email}`;
const site = "https://www.harbourhousenewcastle.com/";
const bookTable = "https://www.harbourhousenewcastle.com/book-a-table/";
const accommodation = "https://www.harbourhousenewcastle.com/accommodation/";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Manrope:wght@400;500;600;700;800&display=swap";

const houseParts = [
  {
    id: "brew",
    kicker: "South Prom Brew Bar",
    title: "Coffee looking at the Irish Sea.",
    body: "Breakfast and brunch needs, looking out to the water. Newly opened on our first-party home — ask us what’s on the board today.",
  },
  {
    id: "terrace",
    kicker: "Water Edge Terrace",
    title: "Unwind at the edge.",
    body: "Our Water Edge Terrace & Cocktail Bar sits where the promenade meets the harbour. Come for a drink after the plate, or before.",
  },
  {
    id: "pantry",
    kicker: "The Pantry",
    title: "Family get-togethers.",
    body: "The Pantry is for gatherings, with one of the best beer-garden views for miles. Lounge, bar with food, and a pool room are part of the house.",
  },
];
---

<ConceptLayout
  title={"Harbour House Newcastle — independent concept"}
  slug="harbour-house"
  bodyClass="concept-page concept-harbour-house"
  lang="en-GB"
  businessName="Harbour House Newcastle"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The harbour door on the sea wall is a drawing."
>
  <div class="hh-strip">
    <span>4–8 South Promenade, Newcastle · BT33 0EX · On the sea wall</span>
    <span class="hh-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="hh-header">
    <a class="hh-brand" href="/concepts/harbour-house/">
      <span class="hh-brand-mark" aria-hidden="true">
        <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
          <rect width="44" height="44" rx="2" fill="#1e3a42"/>
          <rect x="6" y="10" width="32" height="26" fill="#c9b8a0"/>
          <rect x="10" y="14" width="14" height="18" fill="#f3ebe0" stroke="#1a2e34" stroke-width="1.2"/>
          <text
            x="17"
            y="27"
            text-anchor="middle"
            fill="#1a2e34"
            font-size="11"
            font-family="Crimson Pro, Georgia, serif"
            font-weight="700"
          >HH</text>
          <path d="M28 22h8M28 26h6" stroke="#5a8a96" stroke-width="1.4"/>
          <rect x="0" y="36" width="44" height="8" fill="#3d5a48"/>
        </svg>
      </span>
      <span class="hh-brand-text">
        <span class="hh-brand-name">Harbour House</span>
        <span class="hh-brand-sub">Newcastle · South Promenade</span>
      </span>
    </a>
    <nav class="hh-nav" aria-label="Concept navigation">
      <a href="#table">The table</a>
      <a href="#house">The house</a>
      <a href="#rooms">Rooms</a>
      <a href="#find">Find us</a>
    </nav>
    <a class="hh-book" href={bookTable} rel="noopener noreferrer">Book Table</a>
  </header>

  <main class="hh-main">
    <section class="hh-hero" id="table" aria-labelledby="hh-name">
      <div class="hh-hero-copy">
        <p class="hh-kicker">Seafood · Sea wall · Dundrum Bay</p>
        <h1 id="hh-name">Harbour House</h1>
        <p class="hh-place">4–8 South Promenade · Newcastle · BT33 0EX</p>
        <p class="hh-say">Built on the sea wall overlooking the harbour.</p>
        <p class="hh-lede">
          We are a family-run house on the South Promenade — Connolly second
          generation, more than forty years of welcome. Come for freshly
          caught seafood and shellfish specials, a bistro that names vegans
          and vegetarians, then stay for the view of Dundrum Bay if the
          evening runs long.
        </p>
        <p class="hh-cta">
          <a class="hh-book hh-book--inline" href={bookTable} rel="noopener noreferrer">Book Table</a>
          <a class="hh-ring" href={phoneHref}>{phone}</a>
          <a class="hh-write" href={mailto}>Write to us</a>
        </p>
        <p class="hh-hand">
          Today’s catch lives with us — ring, write, or
          <a href={bookTable} rel="noopener noreferrer">Book Table</a>
          for what’s on tonight.
        </p>
      </div>

      <figure class="hh-artefact">
        <SeaWallDoor />
        <figcaption>The harbour door on the sea wall.</figcaption>
      </figure>
    </section>

    <section class="hh-appetite" aria-labelledby="hh-appetite-title">
      <p class="hh-kicker">The plate</p>
      <h2 id="hh-appetite-title">Fruits of the sea, daily.</h2>
      <p class="hh-appetite-lede">
        Seasonal menus with fresh, local, sustainable produce at their heart.
        We have a great appetite for showcasing the fruits of the sea —
        seafood and shellfish specials change with the catch.
      </p>
      <blockquote class="hh-pull">
        <p>
          “Where the Mountains o’ Mourne sweep down to the sea.”
        </p>
      </blockquote>
    </section>

    <section class="hh-house" id="house" aria-labelledby="hh-house-title">
      <div class="hh-house-head">
        <p class="hh-kicker">The house</p>
        <h2 id="hh-house-title">Named rooms of the house.</h2>
        <p>
          Each name is ours — reasons to come, as our site carries them.
        </p>
      </div>
      <div class="hh-house-grid">
        {houseParts.map((part) => (
          <article class="hh-part" id={part.id}>
            <p class="hh-part-kicker">{part.kicker}</p>
            <h3>{part.title}</h3>
            <p>{part.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="hh-connolly" aria-labelledby="hh-connolly-title">
      <p class="hh-kicker">The Connollys</p>
      <h2 id="hh-connolly-title">Second generation. Over forty years.</h2>
      <p>
        Harbour House Newcastle is owned by the Connolly family, who have been
        serving customers from near and far for over forty years. As a second
        generation business, we strive to provide a warm, friendly welcome —
        something that sets the tone for the visit and stays in the memory.
      </p>
      <p class="hh-connolly-close">
        The Connolly family extend a warm Irish welcome to you at the Harbour
        House Newcastle, Co. Down.
      </p>
    </section>

    <section class="hh-rooms" id="rooms" aria-labelledby="hh-rooms-title">
      <div class="hh-rooms-copy">
        <p class="hh-kicker">Upstairs</p>
        <h2 id="hh-rooms-title">Eight en suites over Dundrum Bay.</h2>
        <p class="hh-rooms-lede">
          If the evening runs long, we keep eight en suite bedrooms with
          panoramic views of Dundrum Bay — free Wi-Fi, modern amenities, and
          breakfasts our guests praise. A range of tastes, styles and budgets;
          rich, elegant colours and fabrics.
        </p>
        <p class="hh-rooms-note">
          Rooms sit upstairs from the table. Ask us, or open Accommodation
          on our site.
        </p>
        <p class="hh-cta">
          <a class="hh-accom" href={accommodation} rel="noopener noreferrer">Accommodation</a>
          <a class="hh-ring" href={phoneHref}>{phone}</a>
        </p>
      </div>
      <aside class="hh-stock" aria-label="Bedroom stock">
        <p class="hh-stock-mark">Stock</p>
        <p class="hh-stock-num">8</p>
        <p class="hh-stock-label">en suite bedrooms</p>
        <p class="hh-stock-view">Dundrum Bay views</p>
        <a class="hh-stock-link" href={accommodation} rel="noopener noreferrer">
          Open Accommodation →
        </a>
      </aside>
    </section>

    <section class="hh-find" id="find" aria-labelledby="hh-find-title">
      <p class="hh-kicker">The door</p>
      <h2 id="hh-find-title">On the sea wall.</h2>
      <p class="hh-find-lede">
        We are built on the sea wall overlooking the harbour — the most
        historic area of Newcastle. Home to many longstanding families, the
        harbour is still used for small-scale commercial fishing.
      </p>
      <address class="hh-address">
        <strong>Harbour House Newcastle</strong>
        <span>4–8 South Promenade</span>
        <span>Newcastle, Co. Down</span>
        <span>BT33 0EX</span>
        <a href={phoneHref}>{phone}</a>
        <a href={mailto}>{email}</a>
        <a href={site} rel="noopener noreferrer">harbourhousenewcastle.com</a>
      </address>
      <p class="hh-chips" aria-label="Honest actions">
        <a class="hh-chip" href={bookTable} rel="noopener noreferrer">
          <span class="hh-chip-k">Table</span>
          <span class="hh-chip-v">Book Table</span>
        </a>
        <a class="hh-chip" href={accommodation} rel="noopener noreferrer">
          <span class="hh-chip-k">Stay</span>
          <span class="hh-chip-v">Accommodation</span>
        </a>
        <a class="hh-chip" href={phoneHref}>
          <span class="hh-chip-k">Ring</span>
          <span class="hh-chip-v">{phone}</span>
        </a>
        <a class="hh-chip" href={mailto}>
          <span class="hh-chip-k">Write</span>
          <span class="hh-chip-v">{email}</span>
        </a>
      </p>
      <p class="hh-hours-note">
        For tonight’s sitting, ring or Book Table.
      </p>
    </section>
  </main>
</ConceptLayout>
