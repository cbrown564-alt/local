---
/* Drawn harbour door on the sea wall at 4–8 South Promenade.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
---

<svg
  class="hh-door-svg"
  viewBox="0 0 920 640"
  role="img"
  aria-label="Harbour House on the sea wall at 4–8 South Promenade: stone wall, harbour door, Dundrum Bay and working harbour beyond"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="hh-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#c5d6de"/>
      <stop offset="0.55" stop-color="#a8c0cc"/>
      <stop offset="1" stop-color="#8eacba"/>
    </linearGradient>
    <linearGradient id="hh-bay" x1="0" y1="0" x2="0.2" y2="1">
      <stop offset="0" stop-color="#4a7a88"/>
      <stop offset="0.45" stop-color="#2f5a66"/>
      <stop offset="1" stop-color="#1e3a42"/>
    </linearGradient>
    <linearGradient id="hh-stone" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#d4c4ae"/>
      <stop offset="1" stop-color="#b09a82"/>
    </linearGradient>
    <linearGradient id="hh-door" x1="0" y1="0" x2="1" y2="0.15">
      <stop offset="0" stop-color="#1a2e34"/>
      <stop offset="0.4" stop-color="#243e46"/>
      <stop offset="1" stop-color="#15262c"/>
    </linearGradient>
    <linearGradient id="hh-rope" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#c4844a"/>
      <stop offset="1" stop-color="#8a5a28"/>
    </linearGradient>
    <pattern id="hh-coursing" width="48" height="22" patternUnits="userSpaceOnUse">
      <rect width="48" height="22" fill="#c9b8a0"/>
      <path d="M0 22h48M24 0v22" stroke="#9a8870" stroke-width="0.9"/>
      <path d="M0 11h48" stroke="#a8947c" stroke-width="0.6" opacity="0.55"/>
    </pattern>
  </defs>

  <!-- Sky and Mournes silhouette inland -->
  <rect width="920" height="640" fill="url(#hh-sky)"/>
  <path
    d="M0 210 L80 168 L140 188 L210 142 L280 178 L360 128 L440 165 L520 118 L600 158 L680 132 L760 170 L840 148 L920 175 L920 250 L0 250 Z"
    fill="#5a6e78"
    opacity="0.45"
  />
  <path
    d="M0 230 L90 198 L160 214 L240 176 L320 208 L400 162 L490 196 L580 154 L670 188 L760 168 L860 198 L920 186 L920 260 L0 260 Z"
    fill="#3d525c"
    opacity="0.55"
  />

  <!-- Dundrum Bay / Irish Sea -->
  <rect x="0" y="248" width="920" height="180" fill="url(#hh-bay)"/>
  <path d="M0 268 Q80 258 160 272 T320 266 T480 278 T640 270 T800 282 T920 274" fill="none" stroke="#7ab0bc" stroke-width="2" opacity="0.35"/>
  <path d="M0 298 Q100 288 200 304 T400 296 T600 310 T800 300 T920 308" fill="none" stroke="#9ec8d2" stroke-width="1.4" opacity="0.28"/>
  <path d="M0 340 Q120 328 240 348 T480 338 T720 352 T920 342" fill="none" stroke="#6a9aaa" stroke-width="1.6" opacity="0.22"/>

  <!-- Working harbour mouth — small boats -->
  <g opacity="0.7">
    <ellipse cx="620" cy="320" rx="28" ry="7" fill="#1a2e34"/>
    <path d="M598 320 L620 292 L642 320 Z" fill="#f3ebe0"/>
    <rect x="616" y="278" width="2.5" height="28" fill="#2a1810"/>
    <ellipse cx="740" cy="336" rx="22" ry="5.5" fill="#1a2e34"/>
    <path d="M724 336 L740 314 L756 336 Z" fill="#c9b8a0"/>
  </g>

  <!-- Sea wall mass -->
  <polygon points="0,400 920,380 920,640 0,640" fill="url(#hh-stone)"/>
  <polygon points="0,400 920,380 920,640 0,640" fill="url(#hh-coursing)" opacity="0.85"/>
  <path d="M0 400 L920 380" fill="none" stroke="#8a7660" stroke-width="4"/>
  <path d="M0 418 L920 398" fill="none" stroke="#e8dcc8" stroke-width="2" opacity="0.5"/>

  <!-- Capstones -->
  <g fill="#a8947c" stroke="#7a6854" stroke-width="1">
    <rect x="40" y="388" width="72" height="18" transform="skewX(-4)"/>
    <rect x="130" y="386" width="68" height="18" transform="skewX(-4)"/>
    <rect x="220" y="384" width="70" height="18" transform="skewX(-4)"/>
    <rect x="680" y="372" width="70" height="18" transform="skewX(-4)"/>
    <rect x="770" y="370" width="72" height="18" transform="skewX(-4)"/>
    <rect x="860" y="368" width="50" height="18" transform="skewX(-4)"/>
  </g>

  <!-- House mass on the wall -->
  <rect x="268" y="168" width="384" height="268" fill="#8a7460"/>
  <rect x="268" y="168" width="384" height="12" fill="#6a5848"/>
  <rect x="280" y="188" width="360" height="236" fill="#c9b8a0"/>

  <!-- Upper windows — bay views -->
  <g fill="#dce8ec" stroke="#1a2e34" stroke-width="2">
    <rect x="304" y="208" width="56" height="70"/>
    <rect x="384" y="208" width="56" height="70"/>
    <rect x="480" y="208" width="56" height="70"/>
    <rect x="560" y="208" width="56" height="70"/>
  </g>
  <g stroke="#1a2e34" stroke-width="1.2">
    <path d="M332 208v70M304 243h56M412 208v70M384 243h56M508 208v70M480 243h56M588 208v70M560 243h56"/>
  </g>

  <!-- Fascia -->
  <rect x="268" y="292" width="384" height="52" fill="#1e3a42"/>
  <rect x="268" y="292" width="384" height="4" fill="#c4844a"/>
  <rect x="268" y="340" width="384" height="4" fill="#5a8a96"/>
  <text
    x="460"
    y="318"
    text-anchor="middle"
    fill="#f3ebe0"
    font-family="Crimson Pro, Georgia, serif"
    font-size="22"
    font-weight="700"
    letter-spacing="4"
  >HARBOUR HOUSE</text>
  <text
    x="460"
    y="336"
    text-anchor="middle"
    fill="#a8c0cc"
    font-family="Manrope, Segoe UI, sans-serif"
    font-size="9"
    font-weight="700"
    letter-spacing="3.2"
  >NEWCASTLE · SOUTH PROMENADE</text>

  <!-- Harbour door -->
  <rect x="400" y="356" width="120" height="148" fill="url(#hh-door)" stroke="#0e1c20" stroke-width="3"/>
  <rect x="412" y="368" width="96" height="72" fill="#3d5a48" stroke="#1a2e34" stroke-width="1.4"/>
  <path d="M460 368v72M412 404h96" stroke="#1a2e34" stroke-width="1.2"/>
  <text
    x="460"
    y="478"
    text-anchor="middle"
    fill="#f3ebe0"
    font-family="Crimson Pro, Georgia, serif"
    font-size="36"
    font-weight="700"
  >4–8</text>
  <circle cx="498" cy="430" r="4.5" fill="url(#hh-rope)"/>
  <circle cx="498" cy="430" r="1.8" fill="#1a2e34"/>

  <!-- Side lights / terrace suggestion -->
  <rect x="292" y="360" width="88" height="100" fill="#a8c0cc" stroke="#1a2e34" stroke-width="2" opacity="0.55"/>
  <rect x="540" y="360" width="88" height="100" fill="#a8c0cc" stroke="#1a2e34" stroke-width="2" opacity="0.55"/>
  <path d="M292 410h88M540 410h88" stroke="#1e3a42" stroke-width="1" opacity="0.4"/>

  <!-- Rope bollard on the wall -->
  <g transform="translate(180 470)">
    <ellipse cx="24" cy="48" rx="22" ry="8" fill="#1a2e34" opacity="0.25"/>
    <rect x="14" y="8" width="20" height="42" rx="3" fill="#6a5848"/>
    <ellipse cx="24" cy="10" rx="14" ry="6" fill="#8a7660"/>
    <path d="M8 22 Q24 12 40 22 Q24 32 8 22" fill="none" stroke="url(#hh-rope)" stroke-width="3.5"/>
    <path d="M10 28 Q24 20 38 28" fill="none" stroke="url(#hh-rope)" stroke-width="2.5"/>
  </g>

  <!-- Promenade pavement -->
  <rect x="0" y="560" width="920" height="80" fill="#9a8e7c"/>
  <rect x="0" y="556" width="920" height="6" fill="#7a6e5c"/>
  <g fill="#8a7e6c" opacity="0.5">
    <rect x="40" y="580" width="120" height="4"/>
    <rect x="200" y="600" width="90" height="4"/>
    <rect x="520" y="586" width="140" height="4"/>
    <rect x="720" y="608" width="110" height="4"/>
  </g>

  <!-- Tide line mark -->
  <text
    x="780"
    y="530"
    text-anchor="middle"
    fill="#1e3a42"
    font-family="Manrope, Segoe UI, sans-serif"
    font-size="11"
    font-weight="700"
    letter-spacing="2"
    opacity="0.55"
  >SEA WALL</text>
</svg>
