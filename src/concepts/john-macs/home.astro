---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

/* John Mac's — meal. Speak as the chippy.
   Locked Day 8 facts 14 Sep 2026 (Europe/London). Prefer 9 Central Promenade
   over conflicting 7. No own website — handoff tel only. Do not invent
   Facebook. Hours conflict across directories — omit. No delivery claim.
   Action: walk up / ring. */
const phone = "028 4372 6119";
const phoneHref = "tel:+442843726119";
const maps =
  "https://www.google.com/maps/search/?api=1&query=9+Central+Promenade+Newcastle+BT33+0AA";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,500&display=swap";

const board = [
  {
    kicker: "The fry",
    title: "Battered haddock",
    body: "The classic on the Central Promenade — crisp batter, hot from the fryer, wrapped for the walk.",
  },
  {
    kicker: "The chips",
    title: "Hand-cut chips",
    body: "Cut here, fried here. Salt and vinegar at the counter — take them to the sea wall.",
  },
  {
    kicker: "The board",
    title: "Sausage, fish cakes, scampi",
    body: "The rest of the board sits beside the haddock. Ask at the counter for today's run.",
  },
];
---

<ConceptLayout
  title={"John Mac's — independent concept"}
  slug="john-macs"
  bodyClass="concept-page concept-john-macs"
  lang="en-GB"
  businessName="John Mac's"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="AI-generated illustrations imagine the setting, fryers and suppers; they are not photographs of the business."
>
  <div class="jm-strip">
    <span>9 Central Promenade, Newcastle · BT33 0AA</span>
    <span class="jm-strip-r">
      <a href={phoneHref}>{phone}</a>
    </span>
  </div>

  <header class="jm-header">
    <div class="jm-header-inner">
      <a class="jm-brand" href="/concepts/john-macs/">
        <span class="jm-brand-name">John Mac's</span>
        <span class="jm-brand-sub">Traditional Fish &amp; Chips · Newcastle</span>
      </a>
      <nav class="jm-nav" aria-label="Concept navigation">
        <a href="#board">The board</a>
        <a href="#fryers">The fryers</a>
        <a href="#supper">The supper</a>
        <a href="#door">Find 9</a>
      </nav>
      <a class="jm-walk" href="#door">Walk up</a>
    </div>
  </header>

  <main class="jm-main">
    <section class="jm-hero" aria-labelledby="jm-name">
      <div class="jm-mast">
        <p class="jm-kicker">Traditional fish &amp; chips · Central Promenade</p>
        <h1 id="jm-name">John Mac's</h1>
        <p class="jm-number">9 Central Promenade · Newcastle</p>
        <p class="jm-say">Battered haddock on the prom.</p>
        <p class="jm-lede">
          Hand-cut chips, sausage, fish cakes, scampi. Crisp batter hot from
          the fryer, salt and vinegar at the counter, paper in hand right by
          the sea. Walk up, or ring.
        </p>
        <div class="jm-hero-actions">
          <a class="jm-btn-primary" href="#door">Walk up to 9</a>
          <a class="jm-btn-secondary" href={phoneHref}>Ring {phone}</a>
        </div>
      </div>

      <figure class="jm-theatre">
        <img
          src="/media/concepts/john-macs/john-macs-hero-promenade.jpg"
          alt="John Mac's traditional fish and chip shop frontage at 9 Central Promenade at evening dusk"
          width="1200"
          height="675"
          loading="eager"
        />
        <figcaption>9 Central Promenade · Traditional takeaway facing the Irish Sea</figcaption>
      </figure>
    </section>

    <section class="jm-board" id="board" aria-labelledby="jm-board-title">
      <div class="jm-section-head">
        <p class="jm-kicker">The board</p>
        <h2 id="jm-board-title">Classic takeaway on the Central Promenade.</h2>
        <p class="jm-section-intro">
          What we fry is on the board. What you wait with is the sea.
        </p>
      </div>

      <div class="jm-cards" role="list">
        {board.map((item) => (
          <article class="jm-card" role="listitem">
            <p class="jm-card-kicker">{item.kicker}</p>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="jm-section" id="fryers" aria-labelledby="jm-fryer-title">
      <div class="jm-section-copy">
        <p class="jm-kicker">The fryers</p>
        <h2 id="jm-fryer-title">Golden haddock &amp; hand-cut chips.</h2>
        <p class="jm-lead">
          Hot fat, crisp golden batter, and potatoes chipped in house. Straight onto the draining rack, salted, wrapped, and handed over hot across the counter.
        </p>
        <div class="jm-inline-action">
          <a class="jm-btn-primary" href={phoneHref}>Call the counter: {phone}</a>
        </div>
      </div>

      <figure class="jm-photo-card">
        <img
          src="/media/concepts/john-macs/john-macs-fryer-counter.jpg"
          alt="Golden battered haddock and chunky chips hot from the fryers at John Mac's"
          width="1200"
          height="800"
          loading="lazy"
        />
        <figcaption>Hot from the fryer · Crisp batter and hand-cut chips</figcaption>
      </figure>
    </section>

    <section class="jm-section jm-section--alt" id="supper" aria-labelledby="jm-supper-title">
      <figure class="jm-photo-card">
        <img
          src="/media/concepts/john-macs/john-macs-paper-supper.jpg"
          alt="Steaming fish and chips wrapped in white paper on a wooden sea wall bench overlooking Newcastle bay"
          width="1200"
          height="800"
          loading="lazy"
        />
        <figcaption>The Promenade Supper · Eat on the sea wall facing the Mournes</figcaption>
      </figure>

      <div class="jm-section-copy">
        <p class="jm-kicker">The supper</p>
        <h2 id="jm-supper-title">Wrapped in paper for the walk.</h2>
        <p class="jm-lead">
          Nothing beats eating hot fish and chips straight from the paper by the sea. Walk across the road, sit on the sea wall, and let the salt air cool the vinegar.
        </p>
        <div class="jm-pager-steps">
          <div class="jm-step-cell">
            <span class="jm-step-num">01</span>
            <strong>Walk up</strong>
            <span>Order at the counter</span>
          </div>
          <div class="jm-step-cell">
            <span class="jm-step-num">02</span>
            <strong>Hot wrap</strong>
            <span>Salt &amp; vinegar on</span>
          </div>
          <div class="jm-step-cell">
            <span class="jm-step-num">03</span>
            <strong>The sea wall</strong>
            <span>Eat facing the bay</span>
          </div>
        </div>
      </div>
    </section>

    <section class="jm-door-section" id="door" aria-labelledby="jm-door-title">
      <div class="jm-door-card">
        <p class="jm-kicker">The door</p>
        <h2 id="jm-door-title">9 Central Promenade.</h2>
        <p class="jm-door-desc">
          Right on Newcastle's promenade. Walk up to the hatch, or ring the counter if you're collecting supper on your way through town.
        </p>

        <div class="jm-door-actions">
          <a class="jm-door-btn jm-door-btn--tel" href={phoneHref}>
            <span class="jm-door-label">Telephone</span>
            <span class="jm-door-val">Ring {phone} →</span>
          </a>
          <a class="jm-door-btn" href={maps} rel="noopener noreferrer">
            <span class="jm-door-label">Directions</span>
            <span class="jm-door-val">Open in Google Maps →</span>
          </a>
        </div>

        <address class="jm-address">
          <strong>John Mac's</strong>
          <span>9 Central Promenade</span>
          <span>Newcastle, Co. Down · BT33 0AA</span>
          <a href={phoneHref}>{phone}</a>
        </address>
      </div>
    </section>
  </main>
</ConceptLayout>
