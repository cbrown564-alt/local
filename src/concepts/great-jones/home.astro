---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import TableTicket from "./TableTicket.astro";

/* Great Jones — craft kitchen & bar at 73 Main Street.
   Seasonal small plates, local seafood, chargrilled mains, and copper counter pours.
   Phone: 028 4379 8275 · Online: https://www.greatjones.co.uk/
   Walk-ins welcome, tables by phone or official site.
   No form elements. No ResDiary/OpenTable third-party booking. */
const phone = "028 4379 8275";
const phoneHref = "tel:+442843798275";
const handoff = "https://www.greatjones.co.uk/";
const maps = "https://www.google.com/maps/search/?api=1&query=73+Main+Street+Newcastle+BT33+0AE";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,500;0,7..72,600;0,7..72,700;1,7..72,400&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap";

const kitchenBoards = [
  {
    kicker: "Small Plates & Sharing",
    title: "Crispy squid, wings & seasonal bites",
    body: "Freshly tossed salt & chilli squid with lime aioli, crispy buttermilk fried wings drizzled in hot Mourne honey, and charred seasonal veg.",
  },
  {
    kicker: "From the Harbour & Farm",
    title: "Kilkeel catch & chargrilled Mourne beef",
    body: "Day-boat fish landed down the coast in Kilkeel, alongside prime dry-aged Mourne beef burgers and tender butcher steaks cooked over high heat.",
  },
  {
    kicker: "The Copper Counter",
    title: "Craft taps, local gins & shaken pours",
    body: "Rotating local craft beers on tap, Irish whiskeys, crisp botanical gin serves, and house-infused cocktails mixed at the copper bar.",
  },
  {
    kicker: "Desserts & Comfort",
    title: "Warm sticky toffee & local dairy",
    body: "House-baked sticky toffee pudding with rich butterscotch, seasonal fruit crumbles, and velvety local cream.",
  },
];
---

<ConceptLayout
  title={"Great Jones — Craft Kitchen & Bar, 73 Main Street"}
  slug="great-jones"
  bodyClass="concept-page concept-great-jones"
  lang="en-GB"
  businessName="Great Jones"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="AI-generated illustrations imagine the kitchen and bar interior; they are not photographs of the business."
>
  <!-- Notice Bar -->
  <div class="gj-copper-notice">
    <span class="gj-notice-loc">73 Main Street, Newcastle · BT33 0AE</span>
    <a class="gj-notice-tel" href={phoneHref}>Tables &amp; Walk-ins: {phone}</a>
  </div>

  <!-- Kitchen & Bar Header -->
  <header class="gj-bar-header">
    <div class="gj-header-frame">
      <a class="gj-brand-mark" href="/concepts/great-jones/">
        <span class="gj-brand-title">Great Jones</span>
        <span class="gj-brand-sub">Craft Kitchen &amp; Bar · Main Street</span>
      </a>
      <nav class="gj-bar-nav" aria-label="Restaurant navigation">
        <a href="#plates">The Kitchen</a>
        <a href="#docket">Table Docket</a>
        <a href="#counter">Copper Bar</a>
        <a href="#tables">Find 73</a>
      </nav>
      <a class="gj-call-pill" href={phoneHref}>Ring to book</a>
    </div>
  </header>

  <main class="gj-dining-flow">
    <!-- Kitchen Hero -->
    <section class="gj-kitchen-hero" aria-labelledby="gj-kitchen-title">
      <div class="gj-hero-copy">
        <p class="gj-kicker-copper">Craft Kitchen &amp; Bar · Newcastle</p>
        <h1 id="gj-kitchen-title" class="gj-hero-heading">Honest plates, cold craft pours, and warm hospitality.</h1>
        <p class="gj-hero-lead">
          Gather around the copper counter at 73 Main Street. From Kilkeel fish and chargrilled Mourne steaks
          to creative small plates and great drinks, cooked fresh with real fire and local produce.
        </p>
        <div class="gj-hero-actions">
          <a class="gj-btn-copper" href="#tables">Walk In · 73 Main Street</a>
          <a class="gj-btn-hollow" href={phoneHref}>Ring {phone}</a>
        </div>
      </div>
      <figure class="gj-hero-frame">
        <img
          src="/media/concepts/great-jones/great-jones-hero-main-street.jpg"
          alt="Great Jones restaurant and bar exterior at 73 Main Street Newcastle"
          width="1200"
          height="675"
          loading="eager"
        />
        <figcaption class="gj-visual-caption">73 Main Street · Casual craft dining in Newcastle</figcaption>
      </figure>
    </section>

    <!-- Kitchen Plates Grid -->
    <section class="gj-plates-section" id="plates" aria-labelledby="gj-plates-heading">
      <div class="gj-plates-mast">
        <p class="gj-kicker-copper">The Kitchen Board</p>
        <h2 id="gj-plates-heading" class="gj-section-title">What’s coming off the pass.</h2>
        <p class="gj-mast-lead">
          Carefully sourced ingredients prepared simply. Designed for sharing across the table or enjoying at the bar.
        </p>
      </div>

      <div class="gj-plates-grid">
        {kitchenBoards.map((item) => (
          <article class="gj-plate-card">
            <span class="gj-plate-tag">{item.kicker}</span>
            <h3 class="gj-plate-title">{item.title}</h3>
            <p class="gj-plate-desc">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Table Docket & Artefact -->
    <section class="gj-docket-section" id="docket" aria-labelledby="gj-docket-heading">
      <div class="gj-docket-narrative">
        <p class="gj-kicker-copper">Table Order</p>
        <h2 id="gj-docket-heading" class="gj-section-title">The kitchen docket at 73.</h2>
        <p class="gj-docket-lead">
          Whether you’re popping in for a quick craft pint and crispy wings or settling in for three courses
          with friends, our team takes pride in every order that leaves the pass.
        </p>
        <div class="gj-kitchen-notes">
          <div class="gj-note-item">
            <span class="gj-note-icon">🔥</span>
            <div>
              <strong>High-Heat Cooking</strong>
              <p>Bold seasonings, caramelised chargrill, and crispy textures made to order.</p>
            </div>
          </div>
          <div class="gj-note-item">
            <span class="gj-note-icon">⚓</span>
            <div>
              <strong>Harbour Sourcing</strong>
              <p>Fresh coastal catches delivered from nearby fishing ports along the County Down coastline.</p>
            </div>
          </div>
          <div class="gj-note-item">
            <span class="gj-note-icon">🍸</span>
            <div>
              <strong>Craft Drinks</strong>
              <p>Independent Irish craft beers, curated wine list, and house cocktails.</p>
            </div>
          </div>
        </div>
        <div class="gj-docket-cta">
          <a class="gj-btn-copper" href={handoff} rel="noopener noreferrer">
            View menus on greatjones.co.uk &rarr;
          </a>
        </div>
      </div>
      <div class="gj-docket-slot">
        <TableTicket headingId="gj-docket-heading" />
      </div>
    </section>

    <!-- Copper Bar & Craft Plates Photography -->
    <section class="gj-gallery-showcase" id="counter" aria-labelledby="gj-counter-heading">
      <div class="gj-showcase-duo">
        <figure class="gj-showcase-fig">
          <img
            src="/media/concepts/great-jones/great-jones-craft-plates.jpg"
            alt="Artisanal food plates served at Great Jones kitchen"
            width="1200"
            height="800"
            loading="lazy"
          />
          <figcaption class="gj-visual-caption">Craft kitchen plates · Seasonal small plates and sharing bowls</figcaption>
        </figure>
        <div class="gj-showcase-text">
          <p class="gj-kicker-copper">Craft Kitchen</p>
          <h2 id="gj-counter-heading" class="gj-section-title">Plates built for sharing.</h2>
          <p class="gj-text-body">
            Vibrant flavours, fresh herbs, and homemade sauces. Order a spread of small plates for the table
            or pair a classic main with one of our house sides.
          </p>
          <a class="gj-inline-link" href={phoneHref}>Ring to check table availability: {phone}</a>
        </div>
      </div>

      <div class="gj-showcase-duo gj-showcase-duo--reverse">
        <figure class="gj-showcase-fig">
          <img
            src="/media/concepts/great-jones/great-jones-bar-copper.jpg"
            alt="Warm polished copper bar counter with cocktail shakers and glassware"
            width="1200"
            height="800"
            loading="lazy"
          />
          <figcaption class="gj-visual-caption">The Copper Counter · Beers, local spirits, and classic pours</figcaption>
        </figure>
        <div class="gj-showcase-text">
          <p class="gj-kicker-copper">The Bar</p>
          <h3 class="gj-section-title">Pull up a stool at the copper counter.</h3>
          <p class="gj-text-body">
            No booking required for bar counter seating. Stop by for an aperitif before dinner,
            sample regional craft beers, or chat with our team over evening drinks.
          </p>
          <a class="gj-inline-link" href={handoff} rel="noopener noreferrer">
            Visit official site (greatjones.co.uk) &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Tables & Door Card -->
    <section class="gj-visit-section" id="tables" aria-labelledby="gj-tables-heading">
      <div class="gj-visit-box">
        <div class="gj-visit-details">
          <p class="gj-kicker-copper">Dining at 73</p>
          <h2 id="gj-tables-heading" class="gj-visit-heading">Join us on Main Street.</h2>
          <p class="gj-visit-lead">
            Walk-ins are warmly welcomed for dining and drinks. For groups or weekend tables,
            ring us ahead or view current opening times online.
          </p>
          <div class="gj-visit-buttons">
            <a class="gj-button-card gj-button-card--tel" href={phoneHref}>
              <span class="gj-btn-tag">Telephone</span>
              <span class="gj-btn-name">028 4379 8275</span>
            </a>
            <a class="gj-button-card" href={handoff} rel="noopener noreferrer">
              <span class="gj-btn-tag">Online Menus</span>
              <span class="gj-btn-name">greatjones.co.uk &rarr;</span>
            </a>
            <a class="gj-button-card" href={maps} rel="noopener noreferrer">
              <span class="gj-btn-tag">Location</span>
              <span class="gj-btn-name">Open in Google Maps &rarr;</span>
            </a>
          </div>
        </div>

        <address class="gj-restaurant-address">
          <span class="gj-addr-title">Great Jones</span>
          <span class="gj-addr-street">73 Main Street</span>
          <span class="gj-addr-town">Newcastle, Co. Down</span>
          <span class="gj-addr-postcode">BT33 0AE</span>
          <span class="gj-addr-tel"><a href={phoneHref}>028 4379 8275</a></span>
        </address>
      </div>
    </section>
  </main>
</ConceptLayout>
