---
/* Drawn plate of 6 Main Street: street door, shop depth, wee deli
   at the back, a pasty on the counter. Honesty lives in bannerNote. */
---

<svg
  class="jq-plate"
  viewBox="0 0 920 620"
  role="img"
  aria-label="Joe's Quality Meats at 6 Main Street: the shop looking through to the wee deli at the back, a pasty on the counter"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="jq-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e8eee6"/>
      <stop offset="1" stop-color="#d5ddd2"/>
    </linearGradient>
    <linearGradient id="jq-tile" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f7f3ec"/>
      <stop offset="1" stop-color="#ebe4d6"/>
    </linearGradient>
    <linearGradient id="jq-glass" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f8fcf8" stop-opacity="0.38"/>
      <stop offset="0.5" stop-color="#d5e0d6" stop-opacity="0.1"/>
      <stop offset="1" stop-color="#c4d0c4" stop-opacity="0.28"/>
    </linearGradient>
    <linearGradient id="jq-room" x1="0" y1="0" x2="0.4" y2="1">
      <stop offset="0" stop-color="#f4efe6"/>
      <stop offset="1" stop-color="#e2d6c4"/>
    </linearGradient>
    <pattern id="jq-metro" width="22" height="12" patternUnits="userSpaceOnUse">
      <rect width="22" height="12" fill="#f3eee4"/>
      <path d="M0 12h22M11 0v12" stroke="#d8d0c2" stroke-width="0.7"/>
    </pattern>
    <pattern id="jq-pave" width="42" height="16" patternUnits="userSpaceOnUse">
      <rect width="42" height="16" fill="#cfc6b6"/>
      <rect y="14" width="42" height="2" fill="#b9b09e"/>
      <rect x="20" width="1" height="16" fill="#b9b09e"/>
    </pattern>
  </defs>

  <rect width="920" height="620" fill="url(#jq-sky)"/>

  <!-- Upper storey -->
  <rect x="72" y="28" width="776" height="132" fill="#c4b29a"/>
  <rect x="72" y="28" width="776" height="8" fill="#9a8870"/>
  <g fill="#f4efe6" stroke="#6a5a48" stroke-width="2">
    <rect x="148" y="52" width="78" height="80"/>
    <rect x="268" y="52" width="78" height="80"/>
    <rect x="574" y="52" width="78" height="80"/>
    <rect x="694" y="52" width="78" height="80"/>
  </g>
  <g stroke="#6a5a48" stroke-width="1.2">
    <path d="M187 52v80M148 92h78M307 52v80M268 92h78M613 52v80M574 92h78M733 52v80M694 92h78"/>
  </g>

  <!-- Enamel fascia: JOE'S · 6 -->
  <rect x="52" y="156" width="816" height="86" fill="#2c241c"/>
  <rect x="52" y="156" width="816" height="5" fill="#3d5a3a"/>
  <rect x="52" y="237" width="816" height="5" fill="#c45a28"/>
  <text
    x="460"
    y="202"
    text-anchor="middle"
    fill="#f4efe6"
    font-family="Fraunces, Georgia, serif"
    font-size="46"
    font-weight="700"
    letter-spacing="6"
  >JOE'S</text>
  <text
    x="460"
    y="226"
    text-anchor="middle"
    fill="#d4a574"
    font-family="Karla, Segoe UI, sans-serif"
    font-size="12"
    font-weight="700"
    letter-spacing="5.5"
  >QUALITY MEATS · 6 MAIN STREET</text>

  <!-- Shop body -->
  <rect x="52" y="242" width="816" height="286" fill="#3d3228"/>

  <!-- Interior recess — depth toward the deli -->
  <polygon points="88,258 700,258 660,488 128,488" fill="url(#jq-room)"/>
  <polygon points="88,258 700,258 660,488 128,488" fill="url(#jq-metro)" opacity="0.45"/>

  <!-- Receding floor -->
  <polygon points="128,488 660,488 700,520 88,520" fill="#8a6e52"/>
  <polygon points="140,430 648,430 660,488 128,488" fill="#6e5642"/>

  <!-- Front case (meats) — nearer -->
  <rect x="148" y="348" width="168" height="92" rx="3" fill="#efe6d6" stroke="#6a5a48" stroke-width="1.6"/>
  <ellipse cx="184" cy="388" rx="22" ry="12" fill="#c45a28"/>
  <ellipse cx="228" cy="384" rx="20" ry="14" fill="#8a3a28"/>
  <ellipse cx="270" cy="390" rx="18" ry="11" fill="#a05038"/>
  <rect x="148" y="348" width="168" height="92" fill="url(#jq-glass)"/>

  <!-- Back deli case — smaller, further -->
  <rect x="392" y="292" width="196" height="78" rx="2" fill="#f7f1e4" stroke="#6a5a48" stroke-width="1.4"/>
  <rect x="404" y="304" width="52" height="28" rx="2" fill="#e8d4a8"/>
  <rect x="464" y="304" width="52" height="28" rx="2" fill="#d4c090"/>
  <rect x="524" y="304" width="50" height="28" rx="2" fill="#c8b078"/>
  <circle cx="430" cy="348" r="8" fill="#7a9a5a"/>
  <circle cx="458" cy="346" r="7" fill="#6a8a4a"/>
  <circle cx="490" cy="349" r="8" fill="#c45a28"/>
  <circle cx="520" cy="347" r="7" fill="#d4a574"/>
  <circle cx="548" cy="348" r="6" fill="#3d5a3a"/>
  <rect x="392" y="292" width="196" height="78" fill="url(#jq-glass)"/>
  <text
    x="490"
    y="286"
    text-anchor="middle"
    fill="#3d5a3a"
    font-family="Karla, Segoe UI, sans-serif"
    font-size="9"
    font-weight="700"
    letter-spacing="2.4"
  >DELI</text>

  <!-- Back counter with pasty -->
  <rect x="380" y="368" width="220" height="22" fill="#5a4636"/>
  <rect x="380" y="368" width="220" height="5" fill="#c45a28"/>
  <g transform="translate(448 352)">
    <ellipse cx="36" cy="48" rx="38" ry="8" fill="#3d3228" opacity="0.28"/>
    <path d="M8 36c6-16 18-24 28-24s22 8 28 24c1 6-4 12-12 14H20c-8-2-13-8-12-14Z" fill="#e8c98a" stroke="#8a6a3c" stroke-width="1.4"/>
    <path d="M16 30c8-4 16-6 20-6s12 2 20 6" fill="none" stroke="#c45a28" stroke-width="1.4"/>
    <path d="M36 14v36" stroke="#8a6a3c" stroke-width="1.1"/>
  </g>

  <!-- Glass on the street window -->
  <rect x="88" y="258" width="612" height="262" fill="url(#jq-glass)"/>
  <path d="M108 268l42 240" stroke="#ffffff" stroke-opacity="0.28" stroke-width="9"/>
  <path d="M168 266l22 242" stroke="#ffffff" stroke-opacity="0.1" stroke-width="5"/>
  <rect x="88" y="258" width="612" height="262" fill="none" stroke="#2c241c" stroke-width="3"/>

  <!-- Door with 6 -->
  <rect x="716" y="258" width="132" height="270" fill="#f4efe6" stroke="#2c241c" stroke-width="3"/>
  <rect x="732" y="274" width="100" height="168" fill="#d5ddd2" stroke="#3d5a3a" stroke-width="1.6"/>
  <text
    x="782"
    y="378"
    text-anchor="middle"
    fill="#2c241c"
    font-family="Fraunces, Georgia, serif"
    font-size="72"
    font-weight="700"
  >6</text>
  <circle cx="832" cy="412" r="4" fill="#c45a28"/>
  <rect x="732" y="454" width="100" height="26" fill="#3d3228"/>

  <!-- Pavement -->
  <rect x="0" y="528" width="920" height="92" fill="url(#jq-pave)"/>
  <rect x="0" y="524" width="920" height="6" fill="#9a8e7a"/>
  <rect x="64" y="582" width="110" height="7" rx="1" fill="#3d5a3a" opacity="0.28"/>
</svg>
