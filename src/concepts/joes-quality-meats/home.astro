---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import DeliPlate from "./DeliPlate.astro";

/* Joe's Quality Meats — jar / counter, take-home. Speak as the shop.
   No owned website. Owner unnamed. Hours not locked 29 Aug 2026
   (directories disagree 8–6 vs 9–5; live Google table unread) — omit.
   Not Smalls (shopping centre). Not Vintage etc (4 Main Street).
   Do not print “inside Vintage etc”. Not a café. No farm story.
   Action: walk-in / ring. Handoff: Facebook. */
const phone = "028 4372 2221";
const phoneHref = "tel:+442843722221";
const facebook = "https://www.facebook.com/joesqualitymeats.newcastle";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=Karla:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap";
---

<ConceptLayout
  title={"Joe's Quality Meats — independent concept"}
  slug="joes-quality-meats"
  bodyClass="concept-page concept-joes"
  lang="en-GB"
  businessName="Joe's Quality Meats"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The deli plate is a drawing."
>
  <div class="jq-strip">
    <span>6 Main Street, Newcastle · BT33 0AD</span>
    <span class="jq-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="jq-header">
    <a class="jq-brand" href="/concepts/joes-quality-meats/">
      <span class="jq-brand-mark" aria-hidden="true">
        <svg width="46" height="46" viewBox="0 0 46 46" fill="none">
          <rect x="1.5" y="1.5" width="43" height="43" fill="#f4efe6"/>
          <rect x="1.5" y="1.5" width="43" height="43" stroke="#2c241c" stroke-width="1.6"/>
          <rect x="5" y="5" width="36" height="36" fill="none" stroke="#3d5a3a" stroke-width="0.8"/>
          <text
            x="23"
            y="29"
            text-anchor="middle"
            fill="#2c241c"
            font-size="20"
            font-family="Fraunces, Georgia, serif"
            font-weight="700"
          >6</text>
        </svg>
      </span>
      <span class="jq-brand-text">
        <span class="jq-brand-name">Joe's</span>
        <span class="jq-brand-sub">Quality Meats · 6 Main Street</span>
      </span>
    </a>
    <nav class="jq-nav" aria-label="Concept navigation">
      <a href="#shop">The shop</a>
      <a href="#deli">The deli</a>
      <a href="#door">The door</a>
    </nav>
    <a class="jq-walk" href="#door">Walk in</a>
  </header>

  <main class="jq-main">
    <section class="jq-mast" aria-labelledby="jq-name">
      <p class="jq-kicker">Butcher &amp; deli</p>
      <h1 id="jq-name">Joe's</h1>
      <p class="jq-fascia">Quality Meats</p>
      <p class="jq-number">6 Main Street · Newcastle · BT33 0AD</p>
      <p class="jq-say">Meats on Main Street. A wee deli at the back.</p>
      <p class="jq-lede">
        Walk in for the case. Keep going for the deli. Take it home.
      </p>
      <p class="jq-cta">
        <a class="jq-walk jq-walk--inline" href="#door">Walk in</a>
        <a class="jq-ring" href={phoneHref}>{phone}</a>
      </p>
    </section>

    <section class="jq-through" id="shop" aria-labelledby="jq-through-title">
      <p class="jq-kicker">The shop</p>
      <h2 id="jq-through-title">You walk through.</h2>
      <div class="jq-depth">
        <article class="jq-depth-front">
          <p class="jq-depth-mark">At the front</p>
          <h3>The meats.</h3>
          <p>
            Six Main Street. The case is here. Point at what you want,
            or ring and we will put it aside.
          </p>
        </article>
        <article class="jq-depth-back">
          <p class="jq-depth-mark">At the back</p>
          <h3>The wee deli.</h3>
          <p>
            Keep going. The deli is at the back of the shop.
            Take it with you.
          </p>
        </article>
      </div>
    </section>

    <section class="jq-heard" id="deli" aria-labelledby="jq-heard-title">
      <p class="jq-kicker">Reviews</p>
      <h2 id="jq-heard-title">What people wrote.</h2>
      <ul class="jq-reviews">
        <li>
          <blockquote>
            <p>Fabulous wee deli at back of shop.</p>
          </blockquote>
          <cite>Kim · a review</cite>
        </li>
        <li>
          <blockquote>
            <p>Cornish pasties.</p>
          </blockquote>
          <cite>Josephine · a review</cite>
        </li>
      </ul>
    </section>

    <section class="jq-ritual" id="door" aria-labelledby="jq-door-title">
      <div class="jq-ritual-copy">
        <p class="jq-kicker">The counter</p>
        <h2 id="jq-door-title">Walk in. Ring if you like.</h2>
        <p class="jq-ritual-lede">
          Today's tray lives on Facebook. The door is 6 Main Street.
        </p>
        <p class="jq-chips" aria-label="How to get it">
          <a class="jq-chip" href="#door">
            <span class="jq-chip-k">The door</span>
            <span class="jq-chip-v">Walk in</span>
          </a>
          <a class="jq-chip" href={phoneHref}>
            <span class="jq-chip-k">Ring</span>
            <span class="jq-chip-v">{phone}</span>
          </a>
          <a class="jq-chip" href={facebook} rel="noopener noreferrer">
            <span class="jq-chip-k">Today's tray</span>
            <span class="jq-chip-v">Facebook</span>
          </a>
        </p>
        <p class="jq-artefact-cta">
          <a class="jq-walk jq-walk--inline" href="#door">Walk in</a>
          <a class="jq-ring" href={phoneHref}>{phone}</a>
        </p>
      </div>

      <figure class="jq-artefact">
        <DeliPlate />
        <figcaption>The deli at the back of 6.</figcaption>
      </figure>

      <address class="jq-address">
        <strong>Joe's Quality Meats</strong>
        <span>6 Main Street</span>
        <span>Newcastle</span>
        <span>BT33 0AD</span>
        <a href={phoneHref}>{phone}</a>
        <a href={facebook} rel="noopener noreferrer">Facebook · joesqualitymeats.newcastle</a>
      </address>
    </section>
  </main>
</ConceptLayout>
