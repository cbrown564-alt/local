---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

/* Joe's Quality Meats — jar / counter, take-home. Speak as the shop.
   No owned website. Owner unnamed. Hours not locked 29 Aug 2026
   (directories disagree 8–6 vs 9–5; live Google table unread) — omit.
   Not Smalls (shopping centre). Not Vintage etc (4 Main Street).
   Do not print “inside Vintage etc”. Not a café. No farm story.
   Action: walk-in / ring. Handoff: Facebook. */
const phone = "028 4372 2221";
const phoneHref = "tel:+442843722221";
const facebook = "https://www.facebook.com/joesqualitymeats.newcastle";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=Karla:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap";
---

<ConceptLayout
  title={"Joe's Quality Meats — independent concept"}
  slug="joes-quality-meats"
  bodyClass="concept-page concept-joes"
  lang="en-GB"
  businessName="Joe's Quality Meats"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="Photography comprises illustrative visualisations of 6 Main Street."
>
  <div class="jq-strip">
    <div class="jq-strip-inner">
      <span>6 Main Street, Newcastle · BT33 0AD</span>
      <a class="jq-strip-tel" href={phoneHref}>{phone}</a>
    </div>
  </div>

  <header class="jq-header">
    <div class="jq-header-inner">
      <a class="jq-brand" href="/concepts/joes-quality-meats/">
        <span class="jq-brand-name">Joe's</span>
        <span class="jq-brand-sub">Quality Meats · 6 Main Street</span>
      </a>
      <nav class="jq-nav" aria-label="Concept navigation">
        <a href="#meats">The Meats</a>
        <a href="#deli">The Wee Deli</a>
        <a href="#counter">The Counter</a>
      </nav>
      <a class="jq-walk" href="#counter">Walk in</a>
    </div>
  </header>

  <main class="jq-main">
    <section class="jq-hero" aria-labelledby="jq-name">
      <div class="jq-hero-copy">
        <p class="jq-kicker">Butcher &amp; Deli · Newcastle</p>
        <h1 id="jq-name">Joe's</h1>
        <p class="jq-fascia">Quality Meats</p>
        <p class="jq-number">6 Main Street · Newcastle · BT33 0AD</p>
        <p class="jq-say">Meats on Main Street. A wee deli at the back.</p>
        <p class="jq-lede">
          Walk in for the case. Keep going for the deli. Take it home.
        </p>
        <div class="jq-cta">
          <a class="jq-walk-btn" href="#counter">Walk in</a>
          <a class="jq-ring-btn" href={phoneHref}>Ring {phone}</a>
        </div>
      </div>

      <figure class="jq-theatre">
        <img
          src="/media/concepts/joes-quality-meats/joes-quality-meats-hero-main-street.jpg"
          alt="Illustrative view of a traditional butcher shopfront on Main Street in soft morning light with white-tiled interior"
          width="1536"
          height="1024"
          loading="eager"
        />
        <figcaption class="jq-theatre-cap">
          6 Main Street · Traditional counter and deli on the street
        </figcaption>
      </figure>
    </section>

    <section class="jq-section jq-section--meats" id="meats" aria-labelledby="jq-meats-title">
      <div class="jq-section-copy">
        <p class="jq-kicker">At the front</p>
        <h2 id="jq-meats-title">The meats.</h2>
        <p class="jq-body-lead">
          Six Main Street. The case is here at the front of the shop.
        </p>
        <p>
          Point at what you want, or ring ahead and we will put it aside under your name for collection on your way home.
          Fresh prime cuts, rolled roasts, and artisan links prepared right here.
        </p>
        <div class="jq-aside-card">
          <h3>Put-aside order</h3>
          <p>Ring {phone} in the morning and your parcel is wrapped and waiting at the counter.</p>
        </div>
      </div>

      <figure class="jq-photo">
        <img
          src="/media/concepts/joes-quality-meats/joes-quality-meats-counter-case.jpg"
          alt="Illustrative photograph of butcher display case with fresh cuts laid on enamel trays against white metro tiles"
          width="1200"
          height="900"
          loading="lazy"
        />
        <figcaption>The case at the front · Fresh cuts prepared daily on Main Street</figcaption>
      </figure>
    </section>

    <section class="jq-section jq-section--deli" id="deli" aria-labelledby="jq-deli-title">
      <figure class="jq-photo">
        <img
          src="/media/concepts/joes-quality-meats/joes-quality-meats-deli-pasties.jpg"
          alt="Illustrative photograph of freshly baked golden Cornish pasties and savoury pies on greaseproof paper on a timber deli counter"
          width="1200"
          height="900"
          loading="lazy"
        />
        <figcaption>The deli counter at the back · Flaky hot bakes fresh from the oven</figcaption>
      </figure>

      <div class="jq-section-copy">
        <p class="jq-kicker">At the back</p>
        <h2 id="jq-deli-title">The wee deli.</h2>
        <p class="jq-body-lead">
          Keep going. The deli is at the back of the shop. Take it with you.
        </p>
        <p>
          Hot golden Cornish pasties, savoury sausage rolls, and daily counter bakes.
          What is fresh on today goes on Facebook.
        </p>

        <div class="jq-reviews-card">
          <p class="jq-reviews-title">What people wrote.</p>
          <ul class="jq-reviews-list">
            <li>
              <blockquote>“Fabulous wee deli at back of shop.”</blockquote>
              <cite>Kim · a review</cite>
            </li>
            <li>
              <blockquote>“Cornish pasties.”</blockquote>
              <cite>Josephine · a review</cite>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="jq-counter-section" id="counter" aria-labelledby="jq-counter-title">
      <div class="jq-counter-card">
        <p class="jq-kicker">The Counter</p>
        <h2 id="jq-counter-title">Walk in. Ring if you like.</h2>
        <p class="jq-counter-desc">
          Today's tray lives on Facebook. The door is 6 Main Street.
        </p>

        <div class="jq-chips">
          <a class="jq-chip jq-chip--primary" href="#counter">
            <span class="jq-chip-k">The door</span>
            <span class="jq-chip-v">Walk in</span>
          </a>
          <a class="jq-chip" href={phoneHref}>
            <span class="jq-chip-k">Ring</span>
            <span class="jq-chip-v">{phone}</span>
          </a>
          <a class="jq-chip" href={facebook} rel="noopener noreferrer">
            <span class="jq-chip-k">Today's tray</span>
            <span class="jq-chip-v">Facebook</span>
          </a>
        </div>

        <address class="jq-address">
          <strong>Joe's Quality Meats</strong>
          <span>6 Main Street · Newcastle · BT33 0AD</span>
          <span>Telephone: <a href={phoneHref}>{phone}</a></span>
          <span>Updates: <a href={facebook} rel="noopener noreferrer">facebook.com/joesqualitymeats.newcastle</a></span>
        </address>
      </div>
    </section>
  </main>
</ConceptLayout>
