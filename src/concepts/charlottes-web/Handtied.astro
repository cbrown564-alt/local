---
/* Drawn handtied bouquet / wrapped stem for Savoy Lane.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
interface Props {
  headingId?: string;
}
const { headingId = "cw-hand-title" } = Astro.props;
---

<figure class="cw-hand" aria-labelledby={headingId}>
  <svg
    class="cw-hand-svg"
    viewBox="0 0 400 520"
    role="img"
    aria-label="Drawn handtied bouquet wrapped in paper for Charlotte's Web on Savoy Lane, Newcastle"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="cw-paper" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f3ebe3"/>
        <stop offset="1" stop-color="#e4d5c6"/>
      </linearGradient>
      <filter id="cw-soft" x="-8%" y="-8%" width="116%" height="116%">
        <feDropShadow dx="0" dy="8" stdDeviation="10" flood-color="#3a1f2e" flood-opacity="0.2"/>
      </filter>
    </defs>

    <rect width="400" height="520" fill="#2a1822"/>
    <rect x="24" y="24" width="352" height="472" fill="#3a1f2e" rx="4"/>

    <!-- Wrap -->
    <g filter="url(#cw-soft)">
      <path d="M120 250 L200 140 L280 250 L260 460 L140 460 Z" fill="url(#cw-paper)" stroke="#c4a890" stroke-width="1.5"/>
      <path d="M200 140 L200 250" stroke="#c4a890" stroke-width="1" opacity="0.5"/>
      <!-- Twine -->
      <path d="M145 320 Q200 300 255 320" fill="none" stroke="#8a5a40" stroke-width="3"/>
      <path d="M145 332 Q200 312 255 332" fill="none" stroke="#c4843a" stroke-width="1.5"/>
    </g>

    <!-- Blooms -->
    <g>
      <circle cx="170" cy="168" r="28" fill="#d4a0b8"/>
      <circle cx="200" cy="148" r="32" fill="#e8b8cc"/>
      <circle cx="232" cy="170" r="26" fill="#c4849a"/>
      <circle cx="188" cy="198" r="18" fill="#f0d0dc"/>
      <circle cx="218" cy="200" r="16" fill="#b87088"/>
      <!-- centres -->
      <circle cx="200" cy="150" r="8" fill="#c4843a"/>
      <circle cx="170" cy="170" r="6" fill="#e8d4c0"/>
      <circle cx="232" cy="172" r="5" fill="#e8d4c0"/>
    </g>

    <!-- Greenery -->
    <g fill="#7a9a6a">
      <ellipse cx="148" cy="200" rx="14" ry="28" transform="rotate(-30 148 200)"/>
      <ellipse cx="252" cy="198" rx="12" ry="26" transform="rotate(28 252 198)"/>
      <ellipse cx="200" cy="220" rx="10" ry="22"/>
    </g>

    <text x="200" y="70" text-anchor="middle" fill="#e8d4c0" font-family="Cormorant Infant, Georgia, serif" font-size="30" font-weight="600">Handtied</text>
    <text x="200" y="96" text-anchor="middle" fill="#d4a0b8" font-family="Red Hat Text, Segoe UI, sans-serif" font-size="10" font-weight="700" letter-spacing="2.6">SAVOY LANE · SEASONS</text>
    <text x="200" y="490" text-anchor="middle" fill="#c4a890" font-family="Red Hat Text, Segoe UI, sans-serif" font-size="12" font-weight="600">3 · BT33 0SJ</text>
  </svg>
</figure>
