---
/* Drawn Brunel name-plate for Downs Road.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

{compact ? (
  <svg
    class="br-mark"
    width="44"
    height="44"
    viewBox="0 0 44 44"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <rect width="44" height="44" fill="#1a2430"/>
    <path d="M6 28 C12 18, 20 14, 28 16 C32 17, 36 20, 38 24 L38 30 L6 30 Z" fill="#c4a574"/>
    <path d="M10 24 L14 20 L18 24 L22 18 L26 24 L30 21 L34 26" stroke="#1a2430" stroke-width="1.2" fill="none"/>
    <text
      x="22"
      y="39"
      text-anchor="middle"
      fill="#f4efe6"
      font-family="Libre Baskerville, Georgia, serif"
      font-size="6"
      font-weight="700"
      letter-spacing="1.4"
    >BRUNEL</text>
  </svg>
) : (
  <svg
    class="br-nameplate"
    viewBox="0 0 960 560"
    role="img"
    aria-label="Brunel's name-plate: a drawn ship silhouette over Downs Road with the Brunel wordmark"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="br-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e8eef4"/>
        <stop offset="1" stop-color="#d5dde6"/>
      </linearGradient>
      <linearGradient id="br-plate" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#243040"/>
        <stop offset="1" stop-color="#1a2430"/>
      </linearGradient>
      <linearGradient id="br-brass" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#e0c48a"/>
        <stop offset="1" stop-color="#b8924a"/>
      </linearGradient>
    </defs>

    <rect width="960" height="560" fill="url(#br-sky)"/>
    <rect x="0" y="420" width="960" height="140" fill="#c8b8a4"/>
    <rect x="0" y="420" width="960" height="8" fill="#a89480"/>

    <!-- Downs Road facade hint -->
    <rect x="80" y="180" width="800" height="240" fill="#8a7464"/>
    <rect x="100" y="200" width="760" height="180" fill="#f4efe6"/>
    <rect x="120" y="220" width="200" height="140" fill="#dce6ee" opacity="0.7"/>
    <rect x="360" y="220" width="240" height="140" fill="#dce6ee" opacity="0.55"/>
    <rect x="640" y="220" width="200" height="140" fill="#dce6ee" opacity="0.7"/>

    <!-- Name-plate -->
    <rect x="200" y="60" width="560" height="130" rx="4" fill="url(#br-plate)"/>
    <rect x="210" y="70" width="540" height="110" rx="2" stroke="url(#br-brass)" stroke-width="2.5" fill="none"/>

    <text
      x="480"
      y="112"
      text-anchor="middle"
      fill="#f4efe6"
      font-family="Libre Baskerville, Georgia, serif"
      font-size="42"
      font-weight="700"
      letter-spacing="6"
    >BRUNEL'S</text>
    <text
      x="480"
      y="148"
      text-anchor="middle"
      fill="#c4a574"
      font-family="Plus Jakarta Sans, system-ui, sans-serif"
      font-size="14"
      font-weight="600"
      letter-spacing="3.2"
    >32 DOWNS ROAD · NEWCASTLE</text>

    <!-- Ship silhouette (SS Great Britain story cue) -->
    <g transform="translate(480 340)" opacity="0.9">
      <path d="M-140 20 C-100 -10, -40 -30, 20 -28 C70 -26, 120 -8, 150 18 L150 36 L-140 36 Z" fill="#1a2430"/>
      <path d="M-40 -28 L-40 -70 M20 -28 L20 -78 M80 -26 L80 -62" stroke="#1a2430" stroke-width="3"/>
      <path d="M-48 -70 L-20 -50 L-40 -50 Z" fill="#c4a574"/>
      <path d="M12 -78 L48 -52 L20 -52 Z" fill="#c4a574"/>
      <path d="M72 -62 L100 -44 L80 -44 Z" fill="#c4a574"/>
      <ellipse cx="10" cy="40" rx="160" ry="14" fill="#5a7088" opacity="0.35"/>
    </g>

    <text
      x="480"
      y="500"
      text-anchor="middle"
      fill="#1a2430"
      font-family="Plus Jakarta Sans, system-ui, sans-serif"
      font-size="13"
      font-weight="600"
      letter-spacing="2"
    >NAMED FOR THE MAN · SHIP IN THE BAY · 1846</text>
  </svg>
)}
