---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import BrunelNameplate from "./BrunelNameplate.astro";

/* Brunel's — modern European fine dining on Downs Road.
   32 Downs Road, Newcastle, BT33 0AG.
   Phone: 028 4379 8277 · Email: info@brunelsrestaurant.co.uk.
   Chef Paul Cunningham, wild-foraged Mourne botanicals, local artisan producers. */

const phone = "028 4379 8277";
const phoneHref = "tel:+442843798277";
const email = "info@brunelsrestaurant.co.uk";
const mailto = `mailto:${email}`;
const site = "https://www.brunelsrestaurant.co.uk/";
const book = "https://www.brunelsrestaurant.co.uk/book-now";
const maps =
  "https://www.google.com/maps/search/?api=1&query=32+Downs+Road+Newcastle+BT33+0AG";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap";

const diningPillars = [
  {
    title: "Wild Foraged & Mountain Flora",
    kicker: "Mourne Botanicals",
    desc: "Wild mountain herbs, sea buckthorn, forest fungi, and coastal flora foraged daily by Chef Paul Cunningham across South Down.",
  },
  {
    title: "Artisan Farmers & Day-Boats",
    kicker: "Local Provenance",
    desc: "South Down game, Mourne lamb, and fresh fish landed along the coast, paired with heritage vegetables from smallholder farms.",
  },
  {
    title: "Gastronomic Tasting Menus",
    kicker: "Evening Experience",
    desc: "Thoughtfully choreographed multi-course tasting journeys accompanied by sommelier wine pairings and craft cocktails.",
  },
];

const sittingsSchedule = [
  {
    kicker: "Lunch Service",
    title: "Daylight on Downs Road",
    body: "Refined modern European dining featuring vibrant seasonal dishes, available during daytime weekend services.",
  },
  {
    kicker: "Dinner Service",
    title: "The Evening Experience",
    body: "Our signature dinner service celebrating deep local flavours, curated cellar selections, and intimate dining room ambience.",
  },
  {
    kicker: "Special Evenings",
    title: "Chef Paul Cunningham Sittings",
    body: "Exclusive seasonal tasting events and guest collaboration evenings exploring avant-garde culinary techniques.",
  },
];
---

<ConceptLayout
  title={"Brunel's — independent concept"}
  slug="brunels"
  bodyClass="concept-page concept-brunels"
  lang="en-GB"
  businessName="Brunel's"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The Brunel name-plate is a drawing."
>
  <div class="br-strip">
    <span>32 Downs Road, Newcastle · BT33 0AG · Creative Modern European Dining</span>
    <span class="br-strip-r">
      <a href={phoneHref}>{phone}</a>
    </span>
  </div>

  <header class="br-header">
    <a class="br-brand" href="/concepts/brunels/">
      <span class="br-brand-mark" aria-hidden="true">
        <BrunelNameplate compact />
      </span>
      <span class="br-brand-text">
        <span class="br-brand-name">Brunel's</span>
        <span class="br-brand-sub">32 Downs Road · Newcastle</span>
      </span>
    </a>
    <nav class="br-nav" aria-label="Concept navigation">
      <a href="#produce">The Produce</a>
      <a href="#heritage">Our Namesake</a>
      <a href="#sittings">Sittings</a>
      <a href="#reservations">Reservations</a>
    </nav>
    <a class="br-book-btn" href={book} rel="noopener noreferrer">Book a Table</a>
  </header>

  <main class="br-main">
    <section class="br-hero" aria-labelledby="br-name">
      <div class="br-hero-content">
        <span class="br-kicker">Fine Dining · Modern European</span>
        <h1 id="br-name">Brunel's</h1>
        <p class="br-location-tag">32 Downs Road · Newcastle · BT33 0AG</p>
        <p class="br-say">Creative modern European gastronomy rooted in wild Mourne produce.</p>
        <p class="br-lede">
          Led by Executive Chef Paul Cunningham, Brunel’s celebrates the natural larder of County Down.
          Just a short stroll from the Slieve Donard hotel, we transform wild mountain foragings, day-boat catches,
          and heritage livestock into memorable modern dishes.
        </p>
        <div class="br-hero-actions">
          <a class="br-btn br-btn--primary" href={book} rel="noopener noreferrer">Reserve a Table</a>
          <a class="br-btn br-btn--outline" href={phoneHref}>Call Front of House {phone}</a>
        </div>
      </div>

      <div class="br-hero-art">
        <BrunelNameplate />
      </div>
    </section>

    <section class="br-produce-section" id="produce" aria-labelledby="br-produce-title">
      <div class="br-section-head">
        <span class="br-kicker">Culinary Creed</span>
        <h2 id="br-produce-title">Produce of Mountain, Forest &amp; Coast</h2>
        <p class="br-section-intro">
          Our kitchen works in constant harmony with local micro-seasons, crafting menus that express the authentic terroir of South Down.
        </p>
      </div>

      <div class="br-produce-grid">
        {diningPillars.map((pillar) => (
          <article class="br-produce-card">
            <span class="br-card-kicker">{pillar.kicker}</span>
            <h3>{pillar.title}</h3>
            <p>{pillar.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="br-heritage-section" id="heritage" aria-labelledby="br-heritage-title">
      <div class="br-heritage-wrapper">
        <span class="br-kicker br-kicker--gold">Historic Inspiration</span>
        <h2 id="br-heritage-title">The Legend of Isambard Kingdom Brunel</h2>
        <p class="br-heritage-text">
          Our restaurant draws its name from the legendary Victorian engineer Isambard Kingdom Brunel.
          When his revolutionary iron steamship, the SS Great Britain, ran aground on the sands of Dundrum Bay in 1846,
          Brunel’s ingenious salvage operation made history along this coast. We channel that same spirit of innovation,
          rigour, and craftsmanship into every plate we serve.
        </p>
      </div>
    </section>

    <section class="br-sittings-section" id="sittings" aria-labelledby="br-sittings-title">
      <div class="br-sittings-wrapper">
        <div class="br-section-head">
          <span class="br-kicker">Dining Experience</span>
          <h2 id="br-sittings-title">Lunch, Dinner &amp; Tasting Sittings</h2>
          <p class="br-section-intro">
            We welcome guests for relaxed daylight dining and comprehensive multi-course evening tasting menus.
          </p>
        </div>

        <div class="br-sittings-grid">
          {sittingsSchedule.map((s) => (
            <div class="br-sitting-card">
              <span class="br-sitting-badge">{s.kicker}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="br-reservations-section" id="reservations" aria-labelledby="br-door-title">
      <div class="br-reservations-card">
        <div class="br-reservations-copy">
          <span class="br-kicker">Table Bookings</span>
          <h2 id="br-door-title">Join Us on Downs Road</h2>
          <p class="br-reservations-intro">
            Due to our intimate dining room capacity, advance reservations are strongly recommended for all evening services.
            Book securely online or telephone our front of house team.
          </p>
          <div class="br-reservations-actions">
            <a class="br-btn br-btn--primary" href={book} rel="noopener noreferrer">Book Online via Official Portal</a>
            <a class="br-btn br-btn--outline" href={phoneHref}>Telephone {phone}</a>
            <a class="br-btn br-btn--outline" href={mailto}>Email info@brunelsrestaurant.co.uk</a>
          </div>
        </div>

        <address class="br-address-box">
          <strong>Brunel's Restaurant</strong>
          <span>32 Downs Road</span>
          <span>Newcastle, County Down</span>
          <span>BT33 0AG</span>
          <a class="br-phone-link" href={phoneHref}>{phone}</a>
          <a class="br-email-link" href={mailto}>{email}</a>
          <a class="br-site-link" href={site} rel="noopener noreferrer">brunelsrestaurant.co.uk</a>
          <a class="br-map-link" href={maps} rel="noopener noreferrer">View Location on Map</a>
        </address>
      </div>
    </section>
  </main>

  <footer class="br-footer">
    <p class="br-footer-name">Brunel's Restaurant</p>
    <p>32 Downs Road, Newcastle · Modern European Dining &amp; Chef Paul Cunningham</p>
  </footer>
</ConceptLayout>
