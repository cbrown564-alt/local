---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import BrunelNameplate from "./BrunelNameplate.astro";

/* Brunel's — meal on Downs Road. Speak as the restaurant.
   First-party brunelsrestaurant.co.uk live-read 15 Sep 2026 (Europe/London).
   Hours conflict contact body vs footer — omit gospel hours; hand off Contact.
   Book / ring ritual. No OpenTable rebuild. Not Savoy counter, not Harbour sea wall. */
const phone = "028 4379 8277";
const phoneHref = "tel:+442843798277";
const email = "info@brunelsrestaurant.co.uk";
const mailto = `mailto:${email}`;
const site = "https://www.brunelsrestaurant.co.uk/";
const book = "https://www.brunelsrestaurant.co.uk/book-now";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap";

const sittings = [
  {
    kicker: "Lunch",
    title: "Daylight on Downs Road.",
    body: "A modern European lunch grounded in local producers and suppliers — ask us what the kitchen is running.",
  },
  {
    kicker: "Evening",
    title: "The longer sitting.",
    body: "Cocktails, wine, and a plate that stays with the produce creed. Book ahead when you can.",
  },
  {
    kicker: "Invitation",
    title: "An evening with Paul Cunningham.",
    body: "When we announce it on the site, come for the chef’s mark — not a biography, an invitation.",
  },
];
---

<ConceptLayout
  title={"Brunel's — independent concept"}
  slug="brunels"
  bodyClass="concept-page concept-brunels"
  lang="en-GB"
  businessName="Brunel's"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The Brunel name-plate is a drawing."
>
  <div class="br-strip">
    <span>32 Downs Road, Newcastle · BT33 0AG · Modern European</span>
    <span class="br-strip-r">
      <a href={phoneHref}>{phone}</a>
    </span>
  </div>

  <header class="br-header">
    <a class="br-brand" href="/concepts/brunels/">
      <span class="br-brand-mark" aria-hidden="true">
        <BrunelNameplate compact />
      </span>
      <span class="br-brand-text">
        <span class="br-brand-name">Brunel's</span>
        <span class="br-brand-sub">32 Downs Road · Newcastle</span>
      </span>
    </a>
    <nav class="br-nav" aria-label="Concept navigation">
      <a href="#plate">The plate</a>
      <a href="#name">The name</a>
      <a href="#sittings">Sittings</a>
      <a href="#door">Book / ring</a>
    </nav>
    <a class="br-book" href={book} rel="noopener noreferrer">Book a table</a>
  </header>

  <main class="br-main">
    <section class="br-hero" aria-labelledby="br-name">
      <div class="br-mast">
        <p class="br-kicker">Downs Road · Local produce</p>
        <h1 id="br-name">Brunel's</h1>
        <p class="br-number">32 Downs Road · Newcastle · BT33 0AG</p>
        <p class="br-say">Modern European — rich in local produce.</p>
        <p class="br-lede">
          We cook a creative modern European menu from local producers and
          suppliers, on Downs Road a stroll from Slieve Donard. Book a table,
          ring us, or read the week on our site — hours live on Contact, not
          guessed here.
        </p>
        <p class="br-cta">
          <a class="br-book br-book--inline" href={book} rel="noopener noreferrer">Book a table</a>
          <a class="br-ring" href={phoneHref}>Ring {phone}</a>
          <a class="br-site" href={site} rel="noopener noreferrer">brunelsrestaurant.co.uk</a>
        </p>
      </div>

      <aside class="br-appetite" aria-label="Plate creed">
        <p class="br-appetite-kicker">On the plate</p>
        <p class="br-appetite-quote">
          “Creative modern European cuisine… rich in local produce.”
        </p>
        <p class="br-appetite-source">From our home page · brunelsrestaurant.co.uk</p>
        <ul class="br-appetite-list">
          <li>Local producers &amp; suppliers</li>
          <li>Lunch and evening sittings</li>
          <li>Cocktail bar &amp; wine list</li>
        </ul>
      </aside>
    </section>

    <section class="br-plate" id="plate" aria-labelledby="br-plate-title">
      <div class="br-section-head">
        <p class="br-kicker">The plate</p>
        <h2 id="br-plate-title">Produce made visible.</h2>
        <p class="br-section-intro">
          The kitchen creed is local first. We do not invent farm names for a
          screen — tonight’s plate is ours to tell when you book or walk in.
        </p>
      </div>
      <div class="br-editorial">
        <article class="br-ed-col">
          <h3>Appetite, not a directory.</h3>
          <p>
            Come for the sitting: steam, wine, and a menu that changes with what
            our suppliers bring. Instagram and Facebook carry live specials;
            the permanence is Downs Road and the produce line.
          </p>
        </article>
        <article class="br-ed-col">
          <h3>From Bryansford to Downs Road.</h3>
          <p>
            We opened in 2014 above the Anchor Bar on Bryansford Road, then
            relocated in 2017 to 32 Downs Road — larger covers, same name,
            still trading on our own site.
          </p>
        </article>
      </div>
    </section>

    <section class="br-name-band" id="name" aria-labelledby="br-arc-title">
      <p class="br-kicker br-kicker--on-dark">The man behind our name</p>
      <h2 id="br-arc-title">Brunel — and a ship in Dundrum Bay.</h2>
      <p>
        We take our name from Isambard Kingdom Brunel after SS Great Britain
        went aground in Dundrum Bay in 1846. The shipwreck story is geography
        as much as brand — bay, engineer, and a Newcastle table.
      </p>
      <p class="br-source">From “The man behind our name” on our home page</p>
    </section>

    <section class="br-sittings" id="sittings" aria-labelledby="br-sit-title">
      <div class="br-section-head">
        <p class="br-kicker">Sittings</p>
        <h2 id="br-sit-title">Lunch, evening, invitation.</h2>
      </div>
      <div class="br-cards" role="list">
        {sittings.map((item) => (
          <article class="br-card" role="listitem">
            <p class="br-card-kicker">{item.kicker}</p>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
      <p class="br-hand">
        For the exact week — including any Paul Cunningham evening — start on
        <a href={site} rel="noopener noreferrer">brunelsrestaurant.co.uk</a>
        or ring {phone}.
      </p>
    </section>

    <section class="br-door" id="door" aria-labelledby="br-door-title">
      <div class="br-door-copy">
        <p class="br-kicker">Book / ring</p>
        <h2 id="br-door-title">32 Downs Road.</h2>
        <p class="br-door-lede">
          Reserve on our Book Now page, ring the restaurant, or write to us.
          Hours and sittings live on first-party Contact — we hand them off
          rather than reprint a conflict.
        </p>
        <p class="br-artefact-cta">
          <a class="br-book br-book--inline" href={book} rel="noopener noreferrer">Book a table</a>
          <a class="br-ring" href={phoneHref}>{phone}</a>
          <a class="br-write" href={mailto}>{email}</a>
        </p>
      </div>

      <figure class="br-artefact">
        <BrunelNameplate />
        <figcaption>The Brunel name-plate on Downs Road.</figcaption>
      </figure>

      <address class="br-address">
        <strong>Brunel's Restaurant</strong>
        <span>32 Downs Road</span>
        <span>Newcastle</span>
        <span>County Down</span>
        <span>BT33 0AG</span>
        <a href={phoneHref}>{phone}</a>
        <a href={mailto}>{email}</a>
        <a href={site} rel="noopener noreferrer">brunelsrestaurant.co.uk</a>
        <span>Hours · see Contact on our site</span>
      </address>
    </section>
  </main>
</ConceptLayout>
