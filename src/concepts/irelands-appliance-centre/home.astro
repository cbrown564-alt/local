---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

const phone = "028 4372 4717";
const phoneHref = "tel:+442843724717";
const email = "sales@irelandsappliances.com";
const catalogue = "https://www.irelandsappliances.com/catalogue/index.php";
const fontHref =
  "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap";

const record = [
  { year: "1975", line: "Tom starts from a garage — electrical engineering, then TV and refrigeration." },
  { year: "1984", line: "The shop opens on the harbour. Still this door: 67–69 The Harbour." },
  { year: "2017", line: "Thomas, trained by Tom then the makers, is the main engineer. Two vans." },
  { year: "2021", line: "Oran on the floor. Siobhan on communications." },
];
---

<ConceptLayout
  title={"Ireland's Appliance Centre — Newcastle"}
  slug="irelands-appliance-centre"
  bodyClass="concept-page concept-ireland"
  businessName="Ireland's Appliance Centre"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The kitchen plate is a generated image of a working kitchen, not a photograph of a customer's house or the harbour shop."
>
  <main class="ia-page">
    <section class="ia-first" aria-labelledby="ia-name">
      <p class="ia-record-kicker">The record · since 1975 / harbour shop since 1984</p>
      <h1 id="ia-name">Ireland's Appliance Centre</h1>
      <p class="ia-fix">
        Can they fix mine? Family on the harbour — Tom, Thomas, Oran, Siobhan.
        Repair at the house or on the bench. Hold and store. Price match if you
        have seen it cheaper. Two vans.
      </p>
      <p class="ia-hours">
        Mon–Sat 08:30–17:00 · Sunday closed ·
        <a href={phoneHref}>{phone}</a>
      </p>
      <p class="ia-stock">
        Live stock is their catalogue, not this page:
        <a href={catalogue}>irelandsappliances.com/catalogue</a>
      </p>
    </section>

    <ol class="ia-years">
      {record.map((row) => (
        <li>
          <time>{row.year}</time>
          <span>{row.line}</span>
        </li>
      ))}
    </ol>

    <section class="ia-job" id="job" aria-labelledby="ia-job-title">
      <p class="ia-kicker">The job and the week</p>
      <h2 id="ia-job-title">Write the job. Say the week you need it.</h2>
      <p>
        Opens a draft to {email}. You check it and press send. Or ring the desk.
        The queue lives at the counter.
      </p>
      <form class="ia-docket" data-ia-request>
        <label>
          <span>Name</span>
          <input id="ia-who" name="name" type="text" autocomplete="name" required />
        </label>
        <label>
          <span>Best number</span>
          <input id="ia-tel" name="tel" type="tel" autocomplete="tel" required />
        </label>
        <fieldset>
          <legend>The job</legend>
          <label><input type="radio" name="ia-kind" value="A repair at the house" checked /> Repair at the house</label>
          <label><input type="radio" name="ia-kind" value="A repair on the bench" /> Repair on the bench</label>
          <label><input type="radio" name="ia-kind" value="A machine" /> A machine</label>
          <label><input type="radio" name="ia-kind" value="A price match" /> Price match</label>
        </fieldset>
        <label>
          <span>The week you need it</span>
          <input id="ia-week" name="week" type="text" placeholder="This week / next week" required />
        </label>
        <label>
          <span>What broke, or the cheaper sighting</span>
          <textarea id="ia-notes" name="notes" rows="3"></textarea>
        </label>
        <button type="submit">Prepare the docket</button>
        <div class="ia-handoff" data-ia-handoff role="status" hidden tabindex="-1">
          <strong>Docket ready.</strong>
          <a data-ia-email-link href={`mailto:${email}`}>Open email draft</a>
        </div>
      </form>
    </section>

    <figure class="ia-stage">
      <img
        src="/media/concepts/irelands-appliance-centre/kitchen.jpg"
        alt="Generated image of a kitchen working again — not a photograph of a customer's house"
        width="1536"
        height="1024"
      />
      <figcaption>Generated image — the kitchen working again. Not a photograph of the shop or a customer's house.</figcaption>
    </figure>

    <p class="ia-foot">
      67–69 The Harbour, Newcastle, BT33 0EY.
      Hours from their live site: Mon–Sat 08:30–17:00, Sunday closed.
    </p>
  </main>

  <script is:inline>
    (function () {
      var recipient = "sales@irelandsappliances.com";
      var form = document.querySelector("[data-ia-request]");
      if (!form) return;
      var handoff = form.querySelector("[data-ia-handoff]");
      var link = form.querySelector("[data-ia-email-link]");
      if (!handoff || !link) return;

      form.addEventListener("submit", function (event) {
        event.preventDefault();
        if (!form.reportValidity()) return;
        var name = form.querySelector("#ia-who").value.trim();
        var tel = form.querySelector("#ia-tel").value.trim();
        var week = form.querySelector("#ia-week").value.trim();
        var notes = form.querySelector("#ia-notes").value.trim();
        var chosen = form.querySelector('input[name="ia-kind"]:checked');
        var kind = chosen ? chosen.value : "A repair";
        var query = new URLSearchParams({
          subject: "Job — " + kind + " — " + week,
          body: [
            "Hello Ireland's Appliance Centre,",
            "",
            "I need: " + kind + ".",
            "The week I need it: " + week + ".",
            "Name: " + name,
            "Best number: " + tel,
            notes ? "Notes: " + notes : "",
            "",
            "Please ring me back.",
          ].filter(Boolean).join("\n"),
        });
        link.href = "mailto:" + recipient + "?" + query;
        handoff.hidden = false;
        handoff.focus();
      });
    })();
  </script>
</ConceptLayout>
