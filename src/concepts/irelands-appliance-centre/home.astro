---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

const phone = "028 4372 4717";
const phoneHref = "tel:+442843724717";
const email = "sales@irelandsappliances.com";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Oswald:wght@500;600&family=Noto+Sans:wght@400;600;700&display=swap";
---

<ConceptLayout
  title={"Ireland's Appliance Centre — independent concept"}
  slug="irelands-appliance-centre"
  bodyClass="concept-page concept-ireland"
  businessName="Ireland's Appliance Centre"
  town="Newcastle"
  fontHref={fontHref}
>
  <header class="ia-header">
    <a class="ia-brand" href="/concepts/irelands-appliance-centre/">
      <span class="ia-name">Ireland's Appliance Centre</span>
      <span class="ia-sub">The Harbour · Newcastle · since 1984</span>
    </a>
    <nav class="ia-nav">
      <a href="#job">What do you need</a>
      <a href="#story">From the garage</a>
      <a href="#hours">Hours</a>
    </nav>
    <a class="ia-phone" href={phoneHref}>{phone}</a>
  </header>

  <main class="ia-main">
    <section class="ia-hero">
      <p class="ia-eyebrow">We all live here</p>
      <h1>When the cooker goes cold, the van is already in town.</h1>
      <p class="ia-lead">
        A family-run shop on the harbour. Two vans for delivery, repair and
        servicing. Honest advice, and a price we will match if you have seen
        it cheaper.
      </p>
    </section>

    <section class="ia-jobs" id="job">
      <h2>What do you need today?</h2>
      <div class="ia-grid">
        <article>
          <h3>A repair</h3>
          <p>Large appliances at home. Small ones and TVs of all sizes in the shop.</p>
          <a class="ia-btn" href="#enquire">Ask for a call-back</a>
        </article>
        <article>
          <h3>A machine</h3>
          <p>Walk the showroom or the catalogue. We can hold a price on a small deposit and store it until delivery.</p>
          <a class="ia-btn ia-btn--ghost" href="https://www.irelandsappliances.com/catalogue/index.php">Open the live catalogue</a>
        </article>
        <article>
          <h3>A price match</h3>
          <p>Call or email the cheaper sighting. Let us work our magic.</p>
          <a class="ia-btn ia-btn--ghost" href={phoneHref}>Call {phone}</a>
        </article>
      </div>
    </section>

    <blockquote class="ia-voice">
      <p>“We don't just operate in Newcastle, we all live here. We are locals.”</p>
      <footer>Ireland's Appliance Centre · irelandsappliances.com</footer>
    </blockquote>

    <section class="ia-story" id="story">
      <p class="ia-eyebrow">How the shop got here</p>
      <h2>Garage behind Central Promenade. Then the harbour.</h2>
      <ol>
        <li><span>1975</span> Tom does not go to catering college. Electrical engineering, then TV and refrigeration, then the Albion clothing machines.</li>
        <li><span>1980</span> Albion closes. Appliances out of a garage behind Central Promenade, then a larger garage on Valencia Place.</li>
        <li><span>1984</span> The South Promenade shop — once a supermarket and butchery — becomes Ireland's Appliance Centre.</li>
        <li><span>2017</span> Thomas, trained by Tom then Whirlpool, Hoover and Hotpoint, becomes the main engineer.</li>
        <li><span>2021–22</span> Oran takes the retail floor. Siobhan takes the modern world of communication — and the coffee.</li>
      </ol>
    </section>

    <section class="ia-hours" id="hours">
      <h2>The harbour, Monday to Saturday.</h2>
      <p>67–69 The Harbour, Newcastle, BT33 0EY</p>
      <p>Monday–Saturday 8:30am–5:00pm. Sunday closed.</p>
      <p>Free local delivery on most larger purchases. Two vans.</p>
    </section>

    <form class="ia-form" id="enquire">
      <h2>Ask us to ring you.</h2>
      <p>Opens a draft to sales@irelandsappliances.com. We usually answer within the hour in working hours.</p>
      <label>Your name <input id="ia-name" required autocomplete="name" /></label>
      <label>What you need
        <select id="ia-kind">
          <option>A repair</option>
          <option>A machine</option>
          <option>A price match</option>
        </select>
      </label>
      <label>Details <textarea id="ia-notes" rows="3"></textarea></label>
      <button class="ia-btn" type="submit">Prepare my message</button>
      <div class="ia-handoff" data-ia-handoff hidden>
        <a data-ia-mail href={`mailto:${email}`}>Open email draft</a>
        <span>Or call <a href={phoneHref}>{phone}</a>.</span>
      </div>
    </form>
  </main>
  <script is:inline>
    (function () {
      var form = document.getElementById("enquire");
      if (!form) return;
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        if (!form.reportValidity()) return;
        var name = document.getElementById("ia-name").value.trim();
        var kind = document.getElementById("ia-kind").value;
        var notes = document.getElementById("ia-notes").value.trim();
        var body = ["Hello Ireland's,", "", "I need: " + kind + ".", "Name: " + name, notes, ""].filter(Boolean).join("\n");
        form.querySelector("[data-ia-mail]").href =
          "mailto:sales@irelandsappliances.com?subject=" + encodeURIComponent("Enquiry — " + kind) +
          "&body=" + encodeURIComponent(body);
        form.querySelector("[data-ia-handoff]").hidden = false;
      });
    })();
  </script>
</ConceptLayout>
