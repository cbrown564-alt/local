---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import SeasonPanel from "./SeasonPanel.astro";
import {
  ADDRESS,
  AVOCA,
  BBC_ARCHIVE,
  FACEBOOK,
  INSTAGRAM,
  PHONE,
  PHONE_HREF,
  READ_ON,
  arc,
  avoca,
  changeMemory,
  visit,
} from "./record";

/* The elevation of this page follows
   research/concepts/kent-amusements/kent-amusements-elevation-brief.md.

   The essence: the same summer for over fifty years — the machines change,
   the summer doesn't. The paradox is two dates on one frontage, the newest
   attraction on the seafront inside the oldest thing on it.

   The arcade has no first-party voice on the open web, so the voice here is
   the town's: two BBC memories, quoted with their era and their archive. Every
   fact and every borrowed sentence lives in ./record.ts with its source. The
   one rule that overrides everything else on this page: no time of day, ever
   — see rule 1 in record.ts.

   Move 5 (the drawn promenade-at-dusk plate, and the day/dusk clock swap that
   would ride on it) is not built. It needs its own drawing session; the
   withdrawn 2023 exterior photograph stays withdrawn until then, and the page
   carries no depiction of the frontage. */
---

<ConceptLayout
  title={"Kent Amusements — independent concept"}
  slug="kent-amusements"
  bodyClass="concept-page concept-kent"
  lang="en-GB"
  bannerNote="The quoted memories are other people's, carried with their era and their source; the arcade's own hours live on its Facebook page."
>
  <div class="ka-strip">
    <span><strong>{ADDRESS}</strong> · Newcastle, Co. Down</span>
    <span>Seasonal hours on <a href={FACEBOOK}>Facebook</a></span>
  </div>

  <header class="ka-header">
    <a class="ka-brand" href="/concepts/kent-amusements/">
      <svg class="ka-mark" width="42" height="42" viewBox="0 0 42 42" fill="none" aria-hidden="true">
        <rect x="1.5" y="1.5" width="39" height="39" rx="4" stroke="currentColor" stroke-width="2.2" />
        <path d="M8 28 V14 H14.5 C17.8 14 20 16 20 18.8 C20 21.6 17.8 23.6 14.5 23.6 H11.2 V28 Z M11.2 20.6 H14.2 C15.7 20.6 16.7 19.7 16.7 18.8 C16.7 17.9 15.7 17 14.2 17 H11.2 Z" fill="currentColor" />
        <circle cx="29.5" cy="18" r="5.2" stroke="currentColor" stroke-width="2.2" />
        <path d="M26.2 28 L29.5 21.2 L32.8 28" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="29.5" cy="18" r="1.6" fill="currentColor" />
      </svg>
      <span class="ka-brand-text">
        <span class="ka-brand-name">Kent Amusements</span>
        <span class="ka-brand-sub">Central Promenade · Newcastle</span>
      </span>
    </a>
    <nav class="ka-nav" aria-label="Concept navigation">
      <a href="#summers">Fifty summers</a><a href="#afternoon">An afternoon</a><a href="#season">Hours &amp; offers</a><a href="/concepts/kent-amusements/attractions/">Attractions</a>
    </nav>
    <a class="ka-call" href={PHONE_HREF}>Call {PHONE}</a>
  </header>

  <main>
    <div class="ka-hero">
      <section class="ka-story">
        <p class="ka-kicker">{ADDRESS} · Newcastle</p>
        <h1>Kent <em>Amusements</em></h1>
        <p class="ka-thesis">The machines change.<br />The summer doesn't.</p>
        <p class="ka-lede">
          Over fifty summers on the same stretch of the Central Promenade. The
          jukebox has become a VR zone and the seafront around us has changed
          out of recognition — and every summer the doors open on the same
          afternoon.
        </p>
        <div class="ka-actions">
          <a class="ka-cta" href="#season">Hours &amp; family offers</a>
          <a class="ka-link" href={INSTAGRAM}>Follow @kentamusementsnewcastle →</a>
        </div>
      </section>

      <!-- Move 1. No sentence the arcade wrote about itself exists on the open
           web — its channels are all behind Meta's login. So the town speaks
           instead, verbatim, dated, and unmistakably about the sixties. -->
      <section class="ka-remember" aria-labelledby="ka-remember-heading">
        <div class="ka-remember-head">
          <span id="ka-remember-heading">Newcastle remembers the change booth</span>
          <span class="ka-era-tag">A memory of the late 1960s</span>
        </div>
        <figure class="ka-memory">
          <blockquote>
            <p>{changeMemory.quote}</p>
          </blockquote>
          <figcaption>
            <strong>{changeMemory.who}.</strong>
            <span>{changeMemory.source} · read {READ_ON} · quoted with its shift hours left out</span>
            <a href={BBC_ARCHIVE} rel="external">Read the rest of the archive <span aria-hidden="true">→</span></a>
          </figcaption>
        </figure>
        <figure class="ka-avoca">
          <blockquote>
            <p>{avoca.quote}</p>
          </blockquote>
          <figcaption>
            <strong>{avoca.who}</strong> · {avoca.source}.
            <a href={AVOCA} rel="external">See their listing <span aria-hidden="true">→</span></a>
          </figcaption>
        </figure>
      </section>

      <nav class="ka-rail" aria-label="Sections and contact">
        <a class="ka-rail-cell" href="#summers"><span class="ka-ride">Fifty summers</span><span class="ka-ride-note">Late 1960s to 2026</span></a>
        <a class="ka-rail-cell" href="#afternoon"><span class="ka-ride">An afternoon</span><span class="ka-ride-note">Six steps, in order</span></a>
        <a class="ka-rail-cell" href="#season"><span class="ka-ride">Hours</span><span class="ka-ride-note">They move with the season</span></a>
        <a class="ka-rail-cell" href={PHONE_HREF}><span class="ka-ride">Call us</span><span class="ka-ride-note">{PHONE} →</span></a>
      </nav>
    </div>

    <!-- Move 2. The jukebox-to-VR line in one glance, dated at both ends.
         Every entry carries its source; an undated milestone does not appear. -->
    <section class="ka-summers" id="summers" aria-labelledby="ka-summers-heading">
      <div class="ka-summers-intro">
        <p class="ka-kicker">Fifty summers</p>
        <h2 id="ka-summers-heading">Same promenade. <em>Different machines.</em></h2>
        <p class="ka-summers-lede">
          Four dates we can prove. Everything between them is summers.
        </p>
      </div>
      <ol class="ka-arc">
        {arc.map((entry) => (
          <li class="ka-arc-entry" id={`summer-${entry.id}`}>
            <span class="ka-arc-when">{entry.when}</span>
            <p class="ka-arc-line">{entry.line}</p>
            {entry.quote && (
              <figure class="ka-arc-quote">
                <blockquote><p>{entry.quote.quote}</p></blockquote>
                <figcaption>{entry.quote.who} · {entry.quote.source}</figcaption>
              </figure>
            )}
            <span class="ka-arc-source">{entry.source}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- Move 3. The ritual staged in the order it happens, using only verified
         material. Step 02 is the hinge: the change is where the sixties memory
         and this afternoon are the same afternoon. -->
    <section class="ka-afternoon" id="afternoon" aria-labelledby="ka-afternoon-heading">
      <div class="ka-afternoon-intro">
        <p class="ka-kicker">An afternoon here</p>
        <h2 id="ka-afternoon-heading">How it goes.</h2>
        <p class="ka-afternoon-lede">
          Six steps, the same six for fifty summers.
        </p>
      </div>
      <ol class="ka-visit">
        {visit.map((step) => (
          <li class:list={["ka-visit-step", step.id === "change" && "ka-visit-step--hinge"]}>
            <span class="ka-visit-num">{step.step}</span>
            <strong class="ka-visit-name">{step.name}</strong>
            <span class="ka-visit-line">{step.line}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- Move 4. The ritual is the information; today's answer belongs to the
         page the arcade actually updates. -->
    <section class="ka-season-band" id="season" aria-labelledby="ka-season-heading">
      <div class="ka-season-intro">
        <p class="ka-kicker">Before you come</p>
        <p class="ka-season-lede">
          A seaside arcade opens to the season, not to a timetable. Ours is
          posted where it can be kept true.
        </p>
        <a class="ka-link" href="/concepts/kent-amusements/attractions/">
          What's inside, attraction by attraction →
        </a>
      </div>
      <SeasonPanel variant="compact" />
    </section>
  </main>
</ConceptLayout>
