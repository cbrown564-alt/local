---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import PromPlate from "./PromPlate.astro";

/* Morelli's @ Newcastle — jar: a scoop you take to the prom.
   Speak as the Newcastle door. Not Portrush HQ. Not Café Mauds.
   First-party door: 73 Central Promenade, BT33 0HH (buy.php, 13 Sep 2026).
   Prefer 73 over directory 75. No Newcastle till phone. HQ Coleraine phone
   is not the till. Hours third-party only — omit. No fake order form.
   Brand handoff: morellisices.com. One heritage line max. */

const brand = "https://www.morellisices.com/";
const buy = "https://www.morellisices.com/buy.php";
const maps =
  "https://www.google.com/maps/search/?api=1&query=73+Central+Promenade+Newcastle+BT33+0HH";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,500;0,6..96,600;0,6..96,700;1,6..96,500;1,6..96,600&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap";

const ritual = [
  {
    kicker: "The door",
    title: "Find 73.",
    body: "Central Promenade, Newcastle. Walk up to the awning — that is the shop.",
  },
  {
    kicker: "The scoop",
    title: "Choose at the counter.",
    body: "A cone or a cup. Same famous ice cream, this seafront till.",
  },
  {
    kicker: "The walk",
    title: "Take it to the prom.",
    body: "Sea on one side, Mournes behind. The melt is the theatre.",
  },
];
---

<ConceptLayout
  title={"Morelli's @ Newcastle — independent concept"}
  slug="morellis"
  bodyClass="concept-page concept-morellis"
  lang="en-GB"
  businessName="Morelli's @ Newcastle"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The promenade scoop plate is a drawing."
>
  <div class="mo-strip">
    <span>73 Central Promenade, Newcastle · BT33 0HH</span>
    <span class="mo-strip-r">
      <a href={brand} rel="noopener noreferrer">morellisices.com</a>
    </span>
  </div>

  <header class="mo-header">
    <a class="mo-brand" href="/concepts/morellis/">
      <span class="mo-brand-mark" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
          <circle cx="20" cy="20" r="18.5" stroke="currentColor" stroke-width="1.6"/>
          <path d="M12 26c2.5-8 5-14 8-18 3 4 5.5 10 8 18" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>
          <circle cx="16" cy="14" r="3.2" fill="currentColor" opacity="0.35"/>
          <circle cx="24" cy="12" r="2.8" fill="currentColor" opacity="0.55"/>
          <circle cx="20" cy="9" r="2.4" fill="currentColor"/>
        </svg>
      </span>
      <span class="mo-brand-text">
        <span class="mo-brand-name">Morelli's</span>
        <span class="mo-brand-sub">@ Newcastle · Central Promenade</span>
      </span>
    </a>
    <nav class="mo-nav" aria-label="Concept navigation">
      <a href="#scoop">The scoop</a>
      <a href="#walk">The walk</a>
      <a href="#door">The door</a>
    </nav>
    <a class="mo-walk" href="#door">Find the door</a>
  </header>

  <main class="mo-main">
    <section class="mo-hero" aria-labelledby="mo-name">
      <div class="mo-mast">
        <p class="mo-kicker">Ice cream · Central Promenade</p>
        <h1 id="mo-name">
          <span class="mo-name-brand">Morelli's</span>
          <span class="mo-name-door">@ Newcastle</span>
        </h1>
        <p class="mo-number">73 Central Promenade · BT33 0HH</p>
        <p class="mo-say">A scoop you take to the prom.</p>
        <p class="mo-lede">
          Walk in at 73. Choose a cone or a cup. Carry it along the Central
          Promenade — sea beside, Mournes behind.
        </p>
        <p class="mo-heritage">
          Morelli's ice cream — the family name since 1911.
          <a href={brand} rel="noopener noreferrer">Brand story on morellisices.com</a>
        </p>
        <p class="mo-cta">
          <a class="mo-walk mo-walk--inline" href="#door">Find the door</a>
          <a class="mo-map" href={maps} rel="noopener noreferrer">Map · 73 Central Promenade</a>
        </p>
      </div>

      <figure class="mo-theatre">
        <PromPlate />
        <figcaption>73 on the door. The cone toward the prom.</figcaption>
      </figure>
    </section>

    <section class="mo-melt" id="scoop" aria-labelledby="mo-melt-title">
      <div class="mo-melt-copy">
        <p class="mo-kicker">The scoop</p>
        <h2 id="mo-melt-title">The product at the moment it is for.</h2>
        <p class="mo-melt-lede">
          Not a table. Not a booking. A scoop leaving the counter, already on
          its way to the promenade — soft light, sea air, the first melt.
        </p>
      </div>
      <aside class="mo-melt-note" aria-label="Brand handoff">
        <p class="mo-melt-note-kicker">Same ice cream</p>
        <p>
          Flavours, awards, and the full where-to-buy list live on the brand
          site. This page is only the Newcastle door.
        </p>
        <p>
          <a href={buy} rel="noopener noreferrer">Where to buy · morellisices.com</a>
        </p>
      </aside>
    </section>

    <section class="mo-ritual" id="walk" aria-labelledby="mo-ritual-title">
      <div class="mo-ritual-head">
        <p class="mo-kicker">The walk</p>
        <h2 id="mo-ritual-title">Walk up. Scoop. Promenade.</h2>
        <p class="mo-ritual-lead">
          That is the visit. No form. No delivery widget. Come to the door.
        </p>
      </div>
      <div class="mo-ritual-grid">
        {ritual.map((step) => (
          <article class="mo-ritual-cell">
            <p class="mo-ritual-kicker">{step.kicker}</p>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mo-door" id="door" aria-labelledby="mo-door-title">
      <div class="mo-door-copy">
        <p class="mo-kicker mo-kicker--on-dark">The door</p>
        <h2 id="mo-door-title">73 Central Promenade.</h2>
        <p class="mo-door-lede">
          Find the door. Walk in. Take the scoop to the prom.
        </p>
        <p class="mo-door-cta">
          <a class="mo-walk mo-walk--on-dark" href={maps} rel="noopener noreferrer">Open the map</a>
          <a class="mo-brand-link" href={brand} rel="noopener noreferrer">morellisices.com</a>
        </p>
      </div>

      <address class="mo-address">
        <strong>Morelli's @ Newcastle</strong>
        <span>73 Central Promenade</span>
        <span>Newcastle, Co. Down</span>
        <span>BT33 0HH</span>
        <a href={maps} rel="noopener noreferrer">Map</a>
        <a href={brand} rel="noopener noreferrer">Brand · morellisices.com</a>
        <a href={buy} rel="noopener noreferrer">Other shops · where to buy</a>
      </address>
    </section>
  </main>
</ConceptLayout>
