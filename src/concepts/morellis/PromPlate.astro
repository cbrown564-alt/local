---
/* Drawn plate: 73 on the Central Promenade door, cone in motion toward the sea.
   Honesty that it is a drawing lives in bannerNote — caption stays guest voice. */
---

<svg
  class="mo-plate"
  viewBox="0 0 720 860"
  role="img"
  aria-label="Morelli's door at 73 Central Promenade with a cone held toward the Newcastle promenade and sea"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="mo-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#cfe4ef"/>
      <stop offset="0.42" stop-color="#e8f1f4"/>
      <stop offset="1" stop-color="#f4ebe0"/>
    </linearGradient>
    <linearGradient id="mo-sea" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#6a9eb8"/>
      <stop offset="1" stop-color="#3f6f88"/>
    </linearGradient>
    <linearGradient id="mo-cream" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff8ee"/>
      <stop offset="1" stop-color="#f0d8b0"/>
    </linearGradient>
    <linearGradient id="mo-berry" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f2b3a4"/>
      <stop offset="1" stop-color="#d97868"/>
    </linearGradient>
    <linearGradient id="mo-cone" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e8c48a"/>
      <stop offset="1" stop-color="#c9964a"/>
    </linearGradient>
    <linearGradient id="mo-glass" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f7fcfb" stop-opacity="0.45"/>
      <stop offset="1" stop-color="#c5d9e0" stop-opacity="0.22"/>
    </linearGradient>
  </defs>

  <rect width="720" height="860" fill="url(#mo-sky)"/>

  <!-- Distant Mournes suggestion -->
  <path d="M0 268 L88 210 L156 248 L240 188 L318 236 L410 176 L498 228 L590 198 L720 252 L720 300 L0 300 Z" fill="#9bb5c4" opacity="0.55"/>
  <path d="M0 300 L720 300 L720 360 L0 360 Z" fill="url(#mo-sea)" opacity="0.85"/>
  <path d="M0 348 Q180 330 360 352 T720 340 L720 380 L0 380 Z" fill="#f4ebe0" opacity="0.9"/>

  <!-- Promenade paving -->
  <rect x="0" y="380" width="720" height="480" fill="#e8ddd0"/>
  <g stroke="#d4c5b4" stroke-width="2">
    <path d="M0 440h720M0 520h720M0 600h720M0 680h720M0 760h720"/>
  </g>
  <g stroke="#cfc0ae" stroke-width="1.4" opacity="0.7">
    <path d="M120 380v480M240 380v480M360 380v480M480 380v480M600 380v480"/>
  </g>

  <!-- Sea rail -->
  <rect x="0" y="368" width="720" height="6" fill="#5a7f92"/>
  <g fill="#5a7f92">
    <rect x="48" y="340" width="6" height="34"/>
    <rect x="168" y="340" width="6" height="34"/>
    <rect x="288" y="340" width="6" height="34"/>
    <rect x="408" y="340" width="6" height="34"/>
    <rect x="528" y="340" width="6" height="34"/>
    <rect x="648" y="340" width="6" height="34"/>
  </g>

  <!-- Shop front -->
  <rect x="96" y="248" width="380" height="420" fill="#f7f1e8" stroke="#2a4554" stroke-width="3"/>
  <rect x="96" y="248" width="380" height="78" fill="#1f3a48"/>
  <rect x="96" y="320" width="380" height="6" fill="#d4a574"/>
  <text
    x="286"
    y="288"
    text-anchor="middle"
    fill="#f7f1e8"
    font-family="Bodoni Moda, Georgia, serif"
    font-size="36"
    font-style="italic"
  >Morelli's</text>
  <text
    x="286"
    y="312"
    text-anchor="middle"
    fill="#d4a574"
    font-family="DM Sans, Segoe UI, sans-serif"
    font-size="11"
    font-weight="700"
    letter-spacing="3.2"
  >@ NEWCASTLE</text>

  <!-- Window -->
  <rect x="118" y="348" width="220" height="200" fill="#dce9ef"/>
  <rect x="118" y="348" width="220" height="200" fill="url(#mo-glass)"/>
  <path d="M130 360l36 176" stroke="#ffffff" stroke-opacity="0.35" stroke-width="8"/>

  <!-- Scoop tubs suggestion behind glass -->
  <g opacity="0.85">
    <ellipse cx="158" cy="500" rx="18" ry="10" fill="#fff8ee"/>
    <ellipse cx="198" cy="500" rx="18" ry="10" fill="#f2b3a4"/>
    <ellipse cx="238" cy="500" rx="18" ry="10" fill="#b8d4a8"/>
    <ellipse cx="278" cy="500" rx="18" ry="10" fill="#c9e0f0"/>
    <rect x="140" y="470" width="156" height="14" rx="2" fill="#2a4554" opacity="0.35"/>
  </g>

  <!-- Door with 73 -->
  <rect x="356" y="348" width="96" height="288" fill="#efe6d8" stroke="#2a4554" stroke-width="2.5"/>
  <rect x="368" y="366" width="72" height="110" fill="#c5d9e0" stroke="#2a4554" stroke-width="1.6"/>
  <text
    x="404"
    y="434"
    text-anchor="middle"
    fill="#1f3a48"
    font-family="Bodoni Moda, Georgia, serif"
    font-size="42"
  >73</text>
  <circle cx="434" cy="560" r="5" fill="#d4a574"/>
  <rect x="356" y="636" width="96" height="12" fill="#2a4554"/>

  <!-- Promenade lamp suggestion -->
  <g transform="translate(560 300)">
    <rect x="18" y="40" width="8" height="220" fill="#5a7f92"/>
    <ellipse cx="22" cy="36" rx="22" ry="10" fill="#1f3a48"/>
    <ellipse cx="22" cy="28" rx="14" ry="16" fill="#f4ebe0" opacity="0.75"/>
  </g>

  <!-- Foreground cone — the scoop you take to the prom -->
  <g transform="translate(420 560)">
    <ellipse cx="86" cy="210" rx="54" ry="12" fill="#2a4554" opacity="0.18"/>
    <!-- cone -->
    <path d="M40 92 L86 236 L132 92 Z" fill="url(#mo-cone)"/>
    <path d="M52 120 L120 120 M46 148 L126 148 M54 176 L118 176 M64 204 L108 204" stroke="#a87838" stroke-width="2" opacity="0.55"/>
    <path d="M58 100 L114 160 M70 92 L126 148" stroke="#fff8ee" stroke-width="1.4" opacity="0.35"/>
    <!-- scoops -->
    <circle cx="68" cy="78" r="34" fill="url(#mo-cream)"/>
    <circle cx="104" cy="72" r="30" fill="url(#mo-berry)"/>
    <circle cx="86" cy="48" r="26" fill="#fff8ee"/>
    <ellipse cx="74" cy="62" rx="8" ry="5" fill="#ffffff" opacity="0.55"/>
    <ellipse cx="112" cy="60" rx="6" ry="4" fill="#ffffff" opacity="0.4"/>
    <!-- soft melt drip -->
    <path d="M58 104c4 14 2 22-2 30" fill="none" stroke="#f0d8b0" stroke-width="5" stroke-linecap="round" opacity="0.85"/>
    <path d="M118 96c-2 12 2 20 6 28" fill="none" stroke="#d97868" stroke-width="4" stroke-linecap="round" opacity="0.75"/>
  </g>

  <!-- Small address plate -->
  <g transform="translate(118 568)">
    <rect width="168" height="44" rx="2" fill="#1f3a48"/>
    <text
      x="84"
      y="18"
      text-anchor="middle"
      fill="#d4a574"
      font-family="DM Sans, Segoe UI, sans-serif"
      font-size="8"
      font-weight="700"
      letter-spacing="1.8"
    >CENTRAL PROMENADE</text>
    <text
      x="84"
      y="34"
      text-anchor="middle"
      fill="#f7f1e8"
      font-family="DM Sans, Segoe UI, sans-serif"
      font-size="11"
      font-weight="700"
      letter-spacing="1.2"
    >NEWCASTLE · BT33 0HH</text>
  </g>
</svg>
