---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";
import MtMark from "./MtMark.astro";

/* The Mulberry Tree — 2 Main Street, Seaforde, Downpatrick, Co. Down, BT30 8PA.
   Sources (live-fetched 26 Nov 2026): restaurantseaforde.co.uk (/, /about-us/,
   /outside-catering/) and FSA FHRS register (Authority 145, inspected 2025-03-11).
   - Owned & led by fully qualified chef George Hanna.
   - Setting: main Belfast–Newcastle road in Seaforde, with woodland views.
     Intimate downstairs café + modern, spacious upstairs restaurant.
   - Unlicensed: Bring Your Own Wine with NO corkage charge.
   - Provenance named on site: Downpatrick Finnebrogue Meats venison, fresh
     fish from Ardglass, locally grown vegetables, homemade desserts, morning
     coffees, A La Carte lunches, evening dinner menu, children's menu.
   - Outside catering: business lunches, private functions & special occasions
     across Seaforde, Downpatrick, Newcastle & County Down — George attends in
     person with his staff.
   - Hours: Tuesday–Thursday 10am–4pm · Friday & Saturday 10am–8pm.
   - Phone: 028 4481 2085 · Email (from live header): g.hanna43@yahoo.com.
   Brief: research/concepts/mulberry-tree-seaforde/mulberry-tree-seaforde-elevation-brief.md */

const phone = "028 4481 2085";
const phoneHref = "tel:+442844812085";
const email = "g.hanna43@yahoo.com";
const facebook = "https://www.facebook.com/Mulberry-Tree-Restaurant-340619866057042/";
const lunchUrl = "https://www.restaurantseaforde.co.uk/lunch-menu/";
const dinnerUrl = "https://www.restaurantseaforde.co.uk/dinner-menu/";
const mapHref = "https://maps.app.goo.gl/UrGgAtzbZZWvVrYf7";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Public+Sans:wght@400;500;600;700&display=swap";

const trace = [
  {
    step: "01 · Downpatrick",
    source: "Finnebrogue Meats",
    detail: "Local speciality venison brought straight from Finnebrogue in Downpatrick to Seaforde.",
  },
  {
    step: "02 · The Coast",
    source: "Ardglass Boats",
    detail: "Daily fresh fish dishes cooked by Chef George Hanna from local Ardglass landings.",
  },
  {
    step: "03 · 2 Main Street",
    source: "Seaforde Kitchen",
    detail: "Locally grown vegetables, A La Carte lunches, steak dishes, homemade desserts & children's choices.",
  },
];

const hours = [
  { day: "Tue – Thu", time: "10:00am – 4:00pm" },
  { day: "Fri & Sat", time: "10:00am – 8:00pm" },
  { day: "Sun & Mon", time: "Closed · Catering by arrangement" },
];
---

<ConceptLayout
  title="The Mulberry Tree — Restaurant, Café & Outside Catering, Seaforde"
  slug="mulberry-tree-seaforde"
  bodyClass="concept-page concept-mulberry"
  lang="en-GB"
  businessName="The Mulberry Tree"
  town="Seaforde"
  fontHref={fontHref}
  bannerNote="The upstairs woodland dining table and County Down larder plate are AI-generated visualisations. Table and outside-catering enquiries compose an email to g.hanna43@yahoo.com or call 028 4481 2085."
>
  <header class="mt-masthead">
    <div class="mt-wrap">
      <div class="mt-dateline">
        <span>2 Main Street, Seaforde, BT30 8PA · Belfast – Newcastle Road</span>
        <span><strong>Bring Your Own Wine · Zero Corkage</strong></span>
        <span>Chef-Owner George Hanna · <a href={phoneHref}>{phone}</a></span>
      </div>

      <div class="mt-titleplate">
        <a class="mt-flag" href="#top">
          <MtMark size={38} tone="plum" />
          <span>The Mulberry Tree</span>
        </a>
        <nav class="mt-subnav" aria-label="The Mulberry Tree">
          <a href="#larder">County Down Larder</a>
          <a href="#two-floors">Café &amp; Upstairs Dining</a>
          <a href="#catering">Outside Catering</a>
          <a href="#enquire">Book or Enquire</a>
        </nav>
      </div>
    </div>
  </header>

  <main id="top" class="mt-main">
    <section class="mt-frontpage" aria-labelledby="mt-hero-title">
      <div class="mt-wrap mt-broadsheet-grid">
        <div class="mt-lead-story">
          <p class="mt-kicker">Seaforde, County Down · Unlicensed Dining Room</p>
          <h1 id="mt-hero-title">Woodland views, Finnebrogue venison, <em>and bring your own wine with no corkage.</em></h1>

          <figure class="mt-lead-plate">
            <ResponsiveImage
              src="/media/concepts/mulberry-tree-seaforde/mulberry-tree-woodland-table.jpg"
              alt="Sunlit upstairs bistro table by a tall window looking into green woodland with unlabelled wine bottle, crystal glasses and seared local fish"
              width={1376}
              height={768}
              loading="eager"
              sizes="(max-width: 960px) 100vw, 66vw"
              class="mt-lead-img"
            />
            <figcaption>Upstairs woodland window table &amp; BYOB dining mood. Visualisation (AI-generated).</figcaption>
          </figure>
        </div>

        <aside class="mt-gazette-col" aria-label="Hours, menus and quick bookings">
          <div class="mt-byob-seal">
            <span>UNLICENSED · BYOB</span>
            <strong>Zero Corkage Charge</strong>
            <p>Bring your favourite bottle to pair with lunch or Friday &amp; Saturday dinner.</p>
          </div>

          <div class="mt-hours-block">
            <p class="mt-kicker">Opening Times</p>
            <dl class="mt-hours">
              {hours.map((h) => (
                <div>
                  <dt>{h.day}</dt>
                  <dd>{h.time}</dd>
                </div>
              ))}
            </dl>
          </div>

          <div class="mt-gazette-actions">
            <a class="mt-btn mt-btn--plum" href="#enquire" data-mt-kind="Table Booking">Book a table</a>
            <a class="mt-btn mt-btn--moss" href="#enquire" data-mt-kind="Outside Catering">Outside catering quote</a>
            <div class="mt-menu-pair">
              <a href={lunchUrl} rel="noopener noreferrer">Lunch Menu ↗</a>
              <a href={dinnerUrl} rel="noopener noreferrer">Dinner Menu ↗</a>
            </div>
            <p class="mt-tel-line">Direct desk: <a href={phoneHref}>{phone}</a></p>
          </div>
        </aside>
      </div>
    </section>

    <section class="mt-larder" id="larder" aria-labelledby="mt-larder-title">
      <div class="mt-wrap">
        <div class="mt-larder-head">
          <div>
            <p class="mt-kicker">Provenance Trace · County Down</p>
            <h2 id="mt-larder-title">From Downpatrick estates and Ardglass boats straight to Seaforde.</h2>
          </div>
          <p>
            Chef-owner George Hanna cooks hands-on from the County Down larder —
            morning coffees, A La Carte lunches, evening dinners and homemade
            desserts, all prepared fresh on Main Street.
          </p>
        </div>

        <div class="mt-larder-split">
          <ol class="mt-trace-list">
            {trace.map((t) => (
              <li class="mt-trace-stop">
                <span class="mt-trace-step">{t.step}</span>
                <h3>{t.source}</h3>
                <p>{t.detail}</p>
              </li>
            ))}
          </ol>

          <figure class="mt-larder-plate">
            <ResponsiveImage
              src="/media/concepts/mulberry-tree-seaforde/mulberry-tree-larder-plate.jpg"
              alt="Overhead editorial culinary plate of rosy roasted venison medallions, heritage root vegetables and rustic homemade pear tart on linen"
              width={1200}
              height={896}
              sizes="(max-width: 960px) 100vw, 48vw"
              class="mt-larder-img"
            />
            <figcaption>County Down venison, root vegetables &amp; homemade tart mood. Visualisation (AI-generated).</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="mt-floors" id="two-floors" aria-labelledby="mt-floors-title">
      <div class="mt-wrap">
        <p class="mt-kicker mt-kicker--center">Two Floors Under One Roof</p>
        <h2 class="mt-floors-title" id="mt-floors-title">Intimate downstairs café, spacious upstairs dining room.</h2>

        <div class="mt-floors-grid">
          <article class="mt-floor">
            <span class="mt-floor-tag">Ground Floor</span>
            <h3>The Downstairs Café</h3>
            <p>
              Warm, unhurried room on Main Street for morning coffees, homemade
              desserts, children's choices and midday A La Carte lunches — an
              easy stop right on the Belfast–Newcastle road.
            </p>
          </article>

          <article class="mt-floor mt-floor--up">
            <span class="mt-floor-tag">First Floor · Woodland Views</span>
            <h3>The Upstairs Restaurant</h3>
            <p>
              Modern, airy dining room looking straight out across the Seaforde
              trees — ideal for Friday &amp; Saturday evening menus (10am – 8pm),
              seasonal celebrations, and private group bookings with BYOB and no
              corkage.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="mt-catering" id="catering" aria-labelledby="mt-catering-title">
      <div class="mt-wrap mt-catering-grid">
        <div>
          <p class="mt-kicker mt-kicker--light">Outside Catering · County Down</p>
          <h2 id="mt-catering-title">Chef George Hanna attends your event in person.</h2>
          <p>
            Beyond Seaforde, George personally oversees outside catering with
            his own staff across Downpatrick, Newcastle and surrounding County
            Down — from corporate business lunches to private family occasions
            and seasonal dinners for Easter, Valentine's Day and Christmas.
          </p>
        </div>

        <div class="mt-catering-dispatch">
          <h3>Events we cater</h3>
          <ul>
            <li>Business lunches &amp; corporate meetings</li>
            <li>Private family functions &amp; milestone dinners</li>
            <li>Seasonal menus (Easter, Valentine's &amp; Christmas)</li>
            <li>Private upstairs restaurant bookings in Seaforde</li>
          </ul>
          <a class="mt-btn mt-btn--cream" href="#enquire" data-mt-kind="Outside Catering">Request an outside catering quote →</a>
        </div>
      </div>
    </section>

    <section class="mt-enquire" id="enquire" aria-labelledby="mt-enquire-title">
      <div class="mt-wrap mt-enquire-grid">
        <div class="mt-enquire-copy">
          <p class="mt-kicker">Chef's Desk · Seaforde</p>
          <h2 id="mt-enquire-title">Book lunch, dinner or outside catering.</h2>
          <p>
            Send your preferred date and numbers below to compose a direct email
            to <a href={`mailto:${email}`}>{email}</a>, or call the restaurant
            on <a href={phoneHref}><strong>{phone}</strong></a>.
          </p>
          <div class="mt-find-block" id="find">
            <p><strong>2 Main Street, Seaforde, Downpatrick, BT30 8PA</strong></p>
            <p>Right on the main Belfast–Newcastle road between Ballynahinch, Clough and Downpatrick.</p>
            <p>
              <a href={mapHref} rel="noopener noreferrer">Open Google Maps ↗</a> ·{" "}
              <a href={facebook} rel="noopener noreferrer">Facebook ↗</a>
            </p>
          </div>
        </div>

        <form class="mt-form" id="mt-form" data-email={email}>
          <div class="mt-row">
            <label>
              <span>Enquiry type</span>
              <select name="kind" id="mt-kind">
                <option value="Table Booking">Table Booking (Lunch / Dinner)</option>
                <option value="Outside Catering">Outside Catering</option>
                <option value="Private Function">Private Function at The Mulberry Tree</option>
              </select>
            </label>
            <label>
              <span>Preferred date</span>
              <input type="date" name="date" required />
            </label>
          </div>
          <div class="mt-row">
            <label>
              <span>Time &amp; number of guests</span>
              <input name="guests" placeholder="e.g. 6:30pm, 4 guests or 40 for catering" />
            </label>
            <label>
              <span>Phone number</span>
              <input name="phone" type="tel" autocomplete="tel" required />
            </label>
          </div>
          <label>
            <span>Your name &amp; notes</span>
            <textarea name="notes" rows="2" placeholder="Name, location (if outside catering) and any dietary needs"></textarea>
          </label>
          <button class="mt-btn mt-btn--plum mt-btn--full" type="submit">Open enquiry email to George →</button>
        </form>
      </div>
    </section>
  </main>

  <footer class="mt-footer">
    <div class="mt-wrap mt-footer-inner">
      <span><strong>The Mulberry Tree</strong> · 2 Main Street, Seaforde, Downpatrick, BT30 8PA</span>
      <span><a href={phoneHref}>{phone}</a> · <a href={`mailto:${email}`}>{email}</a> · <a href={facebook} rel="noopener noreferrer">Facebook</a></span>
    </div>
  </footer>

  <script>
    const kindSelect = document.getElementById("mt-kind") as HTMLSelectElement | null;
    document.querySelectorAll<HTMLElement>("[data-mt-kind]").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (kindSelect && btn.dataset.mtKind) kindSelect.value = btn.dataset.mtKind;
      });
    });

    const form = document.getElementById("mt-form") as HTMLFormElement | null;
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const d = new FormData(form);
      const kind = String(d.get("kind") || "Enquiry");
      const body = [
        `Type: ${kind}`,
        `Date: ${d.get("date") || ""}`,
        `Time & guests: ${d.get("guests") || ""}`,
        `Phone: ${d.get("phone") || ""}`,
        "",
        String(d.get("notes") || ""),
      ].join("\n");
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`${kind} — The Mulberry Tree, Seaforde`)}&body=${encodeURIComponent(body)}`;
    });
  </script>
</ConceptLayout>
