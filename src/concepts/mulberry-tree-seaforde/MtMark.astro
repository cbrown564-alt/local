---
interface Props {
  size?: number;
  tone?: "plum" | "gold" | "linen";
}
const { size = 40, tone = "plum" } = Astro.props;
const stroke = tone === "linen" ? "#f7f3ee" : tone === "gold" ? "#c79a56" : "#3d1b30";
---
<svg width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <rect x="3" y="3" width="42" height="42" rx="8" stroke={stroke} stroke-width="1.5" />
  <path d="M24 36V19" stroke={stroke} stroke-width="1.7" stroke-linecap="round" />
  <path d="M24 23C18 22 14.5 18 15 13C20 13 23.5 16.5 24 23Z" stroke={stroke} stroke-width="1.5" stroke-linejoin="round" />
  <path d="M24 20C29.5 19 33 15.5 32.5 11C28 11 24.5 14.5 24 20Z" stroke={stroke} stroke-width="1.5" stroke-linejoin="round" />
  <circle cx="19" cy="29" r="2" fill={stroke} />
  <circle cx="29" cy="28" r="2" fill={stroke} />
  <circle cx="24" cy="31.5" r="2" fill={stroke} />
</svg>
