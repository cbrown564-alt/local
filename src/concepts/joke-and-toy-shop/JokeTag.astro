---
/* Seaside novelty tag for 43 Central Promenade.
   Honesty lives in bannerNote — caption stays guest voice. */
interface Props {
  headingId?: string;
}
const { headingId = "jts-tag-heading" } = Astro.props;
---

<figure class="jts-tag-figure" aria-labelledby={headingId}>
  <svg
    class="jts-tag-svg"
    viewBox="0 0 420 540"
    role="img"
    aria-label="The Joke and Toy Shop novelty souvenir tag for 43 Central Promenade, Newcastle, with prank gags, fancy dress masks, and beach toys"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern id="jts-stripes" width="24" height="24" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
        <line x1="0" y1="0" x2="0" y2="24" stroke="#f05438" stroke-width="4" opacity="0.08" />
      </pattern>
      <filter id="jts-shadow" x="-8%" y="-8%" width="116%" height="116%">
        <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#1b2a4a" flood-opacity="0.18"/>
      </filter>
    </defs>

    <rect width="420" height="540" fill="#fff9eb"/>
    <rect width="420" height="540" fill="url(#jts-stripes)"/>

    <!-- Tag cord / string -->
    <path d="M210 12 C210 -4, 210 -4, 210 32" stroke="#d9822b" stroke-width="3" fill="none" stroke-linecap="round"/>
    <circle cx="210" cy="40" r="14" fill="#ffffff" stroke="#e04028" stroke-width="3"/>
    <circle cx="210" cy="40" r="6" fill="#fff9eb" stroke="#1b2a4a" stroke-width="1.5"/>

    <!-- Main Tag Body (chamfered luggage/novelty tag) -->
    <g filter="url(#jts-shadow)">
      <path
        d="M90 60 L180 60 L210 40 L240 60 L330 60 Q346 60 346 76 L346 470 Q346 486 330 486 L90 486 Q74 486 74 470 L74 76 Q74 60 90 60 Z"
        fill="#ffffff"
        stroke="#1b2a4a"
        stroke-width="2.5"
      />
      <!-- Dashed inner border -->
      <rect x="84" y="72" width="252" height="402" rx="6" fill="none" stroke="#f05438" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.8"/>
    </g>

    <!-- Header title -->
    <text x="210" y="112" text-anchor="middle" fill="#1b2a4a" font-family="'Fredoka', system-ui, sans-serif" font-size="22" font-weight="700">The Joke &amp; Toy Shop</text>
    <text x="210" y="132" text-anchor="middle" fill="#e04028" font-family="'Nunito', system-ui, sans-serif" font-size="9.5" font-weight="800" letter-spacing="2">43 CENTRAL PROMENADE · NEWCASTLE</text>

    <!-- Section items -->
    <g font-family="'Nunito', system-ui, sans-serif" fill="#1b2a4a">
      <text x="100" y="172" font-size="9.5" font-weight="800" letter-spacing="1.2" fill="#008a90">PRANKS &amp; GAGS</text>
      <text x="320" y="172" text-anchor="end" font-size="11" font-weight="700" fill="#e04028">Classic Fun</text>
      <text x="100" y="196" font-size="13.5" font-weight="700">Whoopee cushions &amp; tricks</text>
      <line x1="100" y1="208" x2="320" y2="208" stroke="#f0e2d0" stroke-width="1.2"/>

      <text x="100" y="238" font-size="9.5" font-weight="800" letter-spacing="1.2" fill="#008a90">FANCY DRESS</text>
      <text x="320" y="238" text-anchor="end" font-size="11" font-weight="700" fill="#e04028">All Ages</text>
      <text x="100" y="262" font-size="13.5" font-weight="700">Disguise masks, wigs &amp; capes</text>
      <line x1="100" y1="274" x2="320" y2="274" stroke="#f0e2d0" stroke-width="1.2"/>

      <text x="100" y="304" font-size="9.5" font-weight="800" letter-spacing="1.2" fill="#008a90">PROMENADE &amp; BEACH</text>
      <text x="320" y="304" text-anchor="end" font-size="11" font-weight="700" fill="#e04028">Seaside</text>
      <text x="100" y="328" font-size="13.5" font-weight="700">Buckets, kites &amp; beach toys</text>
      <line x1="100" y1="340" x2="320" y2="340" stroke="#f0e2d0" stroke-width="1.2"/>
    </g>

    <!-- Seaside stamp -->
    <g transform="translate(210 405)">
      <circle r="38" fill="#fff9eb" stroke="#f05438" stroke-width="1.8"/>
      <circle r="33" fill="none" stroke="#008a90" stroke-width="1" stroke-dasharray="3 2"/>
      <!-- Small smile mask icon -->
      <path d="M-14 -6 Q0 8 14 -6" stroke="#1b2a4a" stroke-width="2" fill="none" stroke-linecap="round"/>
      <circle cx="-8" cy="-10" r="2.5" fill="#1b2a4a"/>
      <circle cx="8" cy="-10" r="2.5" fill="#1b2a4a"/>
      <text y="16" text-anchor="middle" fill="#e04028" font-family="'Fredoka', system-ui, sans-serif" font-size="9" font-weight="700">PROMENADE</text>
      <text y="27" text-anchor="middle" fill="#1b2a4a" font-family="'Nunito', system-ui, sans-serif" font-size="7.5" font-weight="800">BT33 0DJ</text>
    </g>

    <text x="210" y="468" text-anchor="middle" fill="#1b2a4a" font-family="'Nunito', system-ui, sans-serif" font-size="10.5" font-weight="700">Walk in · Ring 028 4372 4147</text>
  </svg>
  <figcaption class="jts-tag-caption">Souvenir joke tag · 43 Central Promenade</figcaption>
</figure>
