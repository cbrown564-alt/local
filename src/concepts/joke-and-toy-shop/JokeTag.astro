---
/* Drawn fit ticket for 43 Central Promenade.
   Honesty lives in bannerNote — caption stays guest voice. */
interface Props {
  headingId?: string;
}
const { headingId = "jts-ticket-title" } = Astro.props;
---

<figure class="jts-ticket" aria-labelledby={headingId}>
  <svg
    class="jts-ticket-svg"
    viewBox="0 0 420 560"
    role="img"
    aria-label="Joke & Toy Footwear fit ticket for 43 Central Promenade, Newcastle, with lines for jokes, fancy dress, and toys"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern id="jts-ticket-dots" width="8" height="8" patternUnits="userSpaceOnUse">
        <circle cx="1.2" cy="1.2" r="0.7" fill="#c4b8a8" opacity="0.45"/>
      </pattern>
      <filter id="jts-ticket-soft" x="-8%" y="-8%" width="116%" height="116%">
        <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#1a2a4a" flood-opacity="0.16"/>
      </filter>
    </defs>

    <rect width="420" height="560" fill="#e8dfd2"/>
    <rect width="420" height="560" fill="url(#jts-ticket-dots)"/>

    <!-- Brass clip -->
    <g transform="translate(188 18)">
      <rect x="8" y="0" width="28" height="52" rx="4" fill="#b03028"/>
      <rect x="11" y="4" width="22" height="44" rx="3" fill="#f0b429"/>
      <rect x="14" y="10" width="16" height="8" rx="1.5" fill="#ffe080" opacity="0.7"/>
      <circle cx="22" cy="40" r="3.5" fill="#5a3818"/>
    </g>

    <g filter="url(#jts-ticket-soft)">
      <path
        d="M72 48h276c8 0 14 6 14 14v400c0 8-6 14-14 14H72c-8 0-14-6-14-14V62c0-8 6-14 14-14Z"
        fill="#faf6f0"
        stroke="#1a2a4a"
        stroke-width="1.6"
      />
      <path d="M70 118h280" stroke="#1a2a4a" stroke-width="1.2" stroke-dasharray="3 5" opacity="0.55"/>
      <circle cx="58" cy="200" r="10" fill="#e8dfd2"/>
      <circle cx="362" cy="200" r="10" fill="#e8dfd2"/>
      <circle cx="58" cy="320" r="10" fill="#e8dfd2"/>
      <circle cx="362" cy="320" r="10" fill="#e8dfd2"/>
    </g>

    <text x="210" y="78" text-anchor="middle" fill="#1a2a4a" font-family="Fraunces, Georgia, serif" font-size="22" font-weight="600">Joke & Toy</text>
    <text x="210" y="100" text-anchor="middle" fill="#e04a3a" font-family="DM Sans, Segoe UI, sans-serif" font-size="10" font-weight="700" letter-spacing="2.4">43 CENTRAL PROMENADE</text>

    <text x="92" y="148" fill="#e04a3a" font-family="DM Sans, Segoe UI, sans-serif" font-size="9" font-weight="700" letter-spacing="1.8">JOKE TAG</text>
    <text x="328" y="148" text-anchor="end" fill="#1a2a4a" font-family="DM Sans, Segoe UI, sans-serif" font-size="12" font-weight="700">№ 43</text>

    <g font-family="DM Sans, Segoe UI, sans-serif" fill="#1a2a4a">
      <text x="92" y="188" font-size="11" font-weight="700" letter-spacing="1.2" fill="#e04a3a">PROMENADE</text>
      <text x="92" y="214" font-size="15" font-weight="600">Jokes & gags</text>
      <text x="328" y="214" text-anchor="end" font-size="13" fill="#6b5c52">fit</text>
      <line x1="92" y1="224" x2="328" y2="224" stroke="#d4c8b8" stroke-width="1"/>
      <text x="92" y="254" font-size="15" font-weight="600">Fancy dress</text>
      <text x="328" y="254" text-anchor="end" font-size="13" fill="#6b5c52">try on</text>
      <line x1="92" y1="264" x2="328" y2="264" stroke="#d4c8b8" stroke-width="1"/>
      <text x="92" y="294" font-size="15" font-weight="600">Toys & masks</text>
      <text x="328" y="294" text-anchor="end" font-size="13" fill="#6b5c52">polish</text>
      <line x1="92" y1="304" x2="328" y2="304" stroke="#d4c8b8" stroke-width="1"/>
      <text x="92" y="338" font-size="11" font-weight="700" letter-spacing="1.2" fill="#e04a3a">SINCE</text>
      <text x="92" y="364" font-size="15" font-weight="600">Since 1996</text>
      <text x="328" y="364" text-anchor="end" font-size="13" fill="#6b5c52">Main St</text>
      <line x1="92" y1="374" x2="328" y2="374" stroke="#d4c8b8" stroke-width="1"/>
    </g>

    <g transform="translate(210 430)">
      <circle r="48" fill="none" stroke="#e04a3a" stroke-width="1.4" opacity="0.85"/>
      <circle r="40" fill="none" stroke="#e04a3a" stroke-width="0.8" stroke-dasharray="2 3" opacity="0.7"/>
      <!-- tiny mask -->
      <ellipse cx="0" cy="-2" rx="22" ry="14" fill="none" stroke="#1a2a4a" stroke-width="1.8"/>
      <circle cx="-8" cy="-4" r="3" fill="#1a2a4a"/>
      <circle cx="8" cy="-4" r="3" fill="#1a2a4a"/>
      <text y="28" text-anchor="middle" fill="#1a2a4a" font-family="DM Sans, Segoe UI, sans-serif" font-size="7" font-weight="800" letter-spacing="1.6">BT33 0DJ</text>
    </g>

    <text x="210" y="508" text-anchor="middle" fill="#6b5c52" font-family="DM Sans, Segoe UI, sans-serif" font-size="10" font-weight="600" letter-spacing="0.4">Walk in · Ring 028 4372 4147</text>
  </svg>
  <figcaption class="jts-ticket-cap">The tag at 43.</figcaption>
</figure>
