---
import "../../site/styles/global.css";
import "./styles.css";
const instagram = "https://www.instagram.com/cuplabrewbar/";
const facebook = "https://www.facebook.com/p/C%C3%BApla-61565293502528/";
import ConceptLayout from "../_shell/ConceptLayout.astro";
---

<ConceptLayout title={"Cúpla — independent concept"} slug="cupla" bodyClass="concept-page concept-cupla" lang="en-GB">
<div class="cp-strip">
      <span>105 Main Street, Dundrum, Co. Down · <em lang="ga">ar an bpríomhshráid</em></span>
      <span>Today's hours on <a href={instagram}>Instagram</a></span>
    </div>
    <header class="cp-header">
      <a class="cp-brand" href="/concepts/cupla/">
        <svg class="cp-rings" width="46" height="34" viewBox="0 0 46 34" fill="none" aria-hidden="true">
          <circle cx="16" cy="17" r="13.5" stroke="#1d4e54" stroke-width="2.4" />
          <circle cx="30" cy="17" r="13.5" stroke="#c98a3b" stroke-width="2.4" />
        </svg>
        <span class="cp-brand-text">
          <span class="cp-brand-name">Cúpla</span>
          <span class="cp-brand-sub">Brews · Bakes · Bowls</span>
        </span>
      </a>
      <nav class="cp-nav" aria-label="Concept navigation">
        <a href="/concepts/cupla/menu/"><span lang="ga">An biachlár</span> <span aria-hidden="true">·</span> Menu</a><a href="#" data-concept-placeholder><span lang="ga">Ár scéal</span> <span aria-hidden="true">·</span> Our story</a><a href="#" data-concept-placeholder><span lang="ga">Aimsigh sinn</span> <span aria-hidden="true">·</span> Find us</a>
      </nav>
      <a class="cp-follow" href={instagram}>Follow @cuplabrewbar</a>
    </header>
    <main class="cp-hero">
      <section class="cp-story">
        <p class="cp-kicker" lang="ga">Caife · Bácús · Babhlaí</p>
        <h1>Cúpla</h1>
        <p class="cp-thesis"><span lang="ga">Fáilte isteach.</span> <em>Come on in.</em></p>
        <p class="cp-lede">
          <strong>Cúpla — the Irish for twins</strong> — is the café twin owners opened on
          the main street of Dundrum, Co. Down in 2024: specialty coffee, bakes from the
          counter and brunch bowls. Irish and English sit side by side here, as they do
          in the café's own name and branding.
        </p>
        <div class="cp-actions">
          <a class="cp-cta" href={instagram}>See today's counter</a>
          <a class="cp-link" href={facebook}>Find us on Facebook →</a>
        </div>
      </section>
      <section class="cp-counter-panel" aria-labelledby="cp-counter-heading">
        <div class="cp-counter-head">
          <span lang="ga">Ag an gcuntar</span>
          <span>At the counter</span>
        </div>
        <div class="cp-counter-body">
          <svg class="cp-counter-rings" viewBox="0 0 180 110" fill="none" aria-hidden="true">
            <circle cx="66" cy="55" r="48" stroke="currentColor" stroke-width="4" />
            <circle cx="114" cy="55" r="48" stroke="#c98a3b" stroke-width="4" />
          </svg>
          <p class="cp-counter-kicker" lang="ga">Caife · Bácús · Babhlaí</p>
          <h2 id="cp-counter-heading">Brews, bakes and bowls.</h2>
          <ul class="cp-counter-list">
            <li><span lang="ga">Caife</span><span>Coffee</span></li>
            <li><span lang="ga">Bácús</span><span>Morning bakes</span></li>
            <li><span lang="ga">Babhlaí</span><span>Brunch bowls</span></li>
          </ul>
        </div>
        <div class="cp-counter-actions">
          <a href="/concepts/cupla/menu/"><span lang="ga">Féach ar an mbiachlár</span> · See the menu <span aria-hidden="true">→</span></a>
          <a href={instagram}>Today on Instagram</a>
        </div>
        <p class="cp-counter-note">Menu on this site is a sample — see Instagram for what's on the counter today.</p>
      </section>
      <nav class="cp-rail" aria-label="Bilingual site sections">
        <a class="cp-rail-cell" href="#" data-concept-placeholder><span class="cp-rail-ga" lang="ga">Maidin</span><span class="cp-rail-en">Morning</span></a>
        <a class="cp-rail-cell" href="#" data-concept-placeholder><span class="cp-rail-ga" lang="ga">Lón</span><span class="cp-rail-en">Lunch</span></a>
        <a class="cp-rail-cell" href="#" data-concept-placeholder><span class="cp-rail-ga" lang="ga">Le tabhairt leat</span><span class="cp-rail-en">Takeaway</span></a>
        <a class="cp-rail-cell" href={instagram}><span class="cp-rail-ga" lang="ga">Ar oscailt</span><span class="cp-rail-en">Today's hours →</span></a>
      </nav>
    </main>
</ConceptLayout>
