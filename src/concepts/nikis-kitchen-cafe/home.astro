---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import WeekdayBoard from "./WeekdayBoard.astro";
import SeasideKitchenPass from "./SeasideKitchenPass.astro";

/* Niki's Kitchen Café — promenade kitchen. Speak as the café.
   Owner unnamed: "Niki" is the shop name, not a proprietor.
   Hours conflict (Google 8–3 seven days vs IG Mon–Fri from 8 vs May 4
   closed Monday) — date both, never pick a winner. No clock in the strip.
   Weekday Wonders is a dated Facebook board, not a live tariff.
   No booking form. No owned site. Facebook for today. */

const phone = "028 4372 6777";
const phoneHref = "tel:+442843726777";
const facebook = "https://www.facebook.com/NikisKitchenCafe";
const instagram = "https://www.instagram.com/nikiskitchencafe/";
const maps =
  "https://www.google.com/maps/search/?api=1&query=107+Central+Promenade+Newcastle+BT33+0EU";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Calistoga&family=Nunito+Sans:ital,wght@0,400;0,600;0,700;0,800;1,400&display=swap";
---

<ConceptLayout
  title={"Niki's Kitchen Café — independent concept"}
  slug="nikis-kitchen-cafe"
  bodyClass="concept-page concept-nikis"
  lang="en-GB"
  businessName="Niki's Kitchen Café"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The skillet breakfast hero plate is a concept visualisation. Weekday Wonders is staged from a Facebook poster (August 2026)."
>
  <div class="nk-strip">
    <span>107 Central Promenade, Newcastle · BT33 0EU</span>
    <span class="nk-strip-r">
      <a href={phoneHref}>{phone}</a>
      <span aria-hidden="true"> · </span>
      <a href={facebook} rel="external">Facebook for today</a>
    </span>
  </div>

  <header class="nk-header">
    <a class="nk-brand" href="/concepts/nikis-kitchen-cafe/">
      <span class="nk-brand-mark" aria-hidden="true">
        <svg width="46" height="46" viewBox="0 0 46 46" fill="none">
          <circle cx="23" cy="23" r="21.2" fill="currentColor" />
          <circle cx="23" cy="23" r="18.4" fill="none" stroke="#f4efe6" stroke-width="1.2" />
          <text
            x="23"
            y="29"
            text-anchor="middle"
            fill="#f4efe6"
            font-family="Calistoga, Georgia, serif"
            font-size="16"
          >107</text>
        </svg>
      </span>
      <span class="nk-brand-text">
        <span class="nk-brand-name">Niki's Kitchen Café</span>
        <span class="nk-brand-sub">107 Central Promenade · Newcastle</span>
      </span>
    </a>
    <nav class="nk-nav" aria-label="Concept navigation">
      <a href="#door">The door</a>
      <a href="#kitchen">Kitchen Pass</a>
      <a href="#wonders">Weekday Wonders</a>
      <a href="#find">Find us</a>
    </nav>
    <a class="nk-walk" href="#find">Walk in</a>
  </header>

  <main class="nk-main">
    <section class="nk-hero" id="door" aria-labelledby="nk-name">
      <div class="nk-lede">
        <p class="nk-kicker">Promenade kitchen · 107</p>
        <h1 id="nk-name">Niki's Kitchen Café</h1>
        <p class="nk-say">
          A quick, fulfilling bite mid-week without splashing out — then the sea.
        </p>
        <p class="nk-body">
          Walk in at 107 Central Promenade. Sizzling skillet breakfasts, homemade soda farls, fresh chowder and hearty midday bakes looking right over the bay. For today's specials, look at
          <a href={facebook} rel="external">Facebook</a>.
        </p>
        <p class="nk-cta">
          <a class="nk-walk nk-walk--inline" href="#find">Walk in</a>
          <a class="nk-ring" href={phoneHref}>Ring {phone}</a>
        </p>
      </div>

      <figure class="nk-theatre">
        <img
          src="/media/concepts/nikis-kitchen-cafe/nikis-kitchen-hero.jpg"
          alt="Cast-iron skillet breakfast with homemade soda farls and tea overlooking the Newcastle promenade and Irish Sea"
          class="nk-theatre-img"
          loading="eager"
        />
        <figcaption class="nk-theatre-cap">
          Cast-iron morning skillet &amp; soda farl · 107 Central Promenade
        </figcaption>
      </figure>
    </section>

    <section class="nk-kitchen-pass-section" id="kitchen" aria-labelledby="nk-kitchen-title">
      <div class="nk-section-head">
        <p class="nk-kicker">The Pass</p>
        <h2 id="nk-kitchen-title">Coastal Comfort Cooking.</h2>
        <p class="nk-section-intro">
          From sunrise fry-ups to midday chowder bowls, cooked fresh on Central Promenade.
        </p>
      </div>
      <SeasideKitchenPass headingId="nk-kitchen-title" />
    </section>

    <section class="nk-spread" id="wonders" aria-labelledby="nk-wonders-title">
      <div class="nk-spread-copy">
        <p class="nk-kicker">Facebook · August 2026</p>
        <h2 id="nk-wonders-title">Weekday Wonders.</h2>
        <p class="nk-pull">
          Want to grab a quick, fulfilling bite to eat mid week without
          splashing out?
        </p>
        <p class="nk-spread-lead">
          Introducing our Weekday Wonders — great, hearty meals cooked fresh on the promenade. Five plates. All £12.50. That is the board we printed; Facebook holds today's counter.
        </p>
        <ol class="nk-plates">
          <li>Beef burger, bacon &amp; cheese</li>
          <li>Battered haddock &amp; mushy peas</li>
          <li>Homemade beef lasagne</li>
          <li>Crispy halloumi wrap</li>
          <li>Chicken tikka masala with rice &amp; naan</li>
        </ol>
        <p class="nk-spread-foot">
          If a plate has moved, the board on the wall will say so.
        </p>
      </div>
      <WeekdayBoard />
    </section>

    <section class="nk-sea" id="sea" aria-labelledby="nk-sea-title">
      <div class="nk-horizon" aria-hidden="true"></div>
      <div class="nk-sea-copy">
        <p class="nk-kicker nk-kicker--foam">After the plate</p>
        <h2 id="nk-sea-title">Then the sea.</h2>
        <p>
          Eat, then step out onto Central Promenade. The bay is the rest of
          the sitting. Walk in. There is no booking to make.
        </p>
      </div>
    </section>

    <section class="nk-find" id="find" aria-labelledby="nk-find-title">
      <p class="nk-kicker">The door</p>
      <h2 id="nk-find-title">107 Central Promenade.</h2>
      <div class="nk-find-grid">
        <div>
          <h3>Walk in</h3>
          <p>
            Niki's Kitchen Café<br />
            107 Central Promenade<br />
            Newcastle, Co. Down<br />
            BT33 0EU
          </p>
          <p>
            <a href={maps} rel="external">Directions on Google Maps →</a>
          </p>
        </div>
        <div>
          <h3>Ring</h3>
          <p>
            <a href={phoneHref}>{phone}</a>
          </p>
          <p>Walk in needs none of this. Ring if you want us first.</p>
        </div>
        <div>
          <h3>Today</h3>
          <p>
            Hours move. Google lists 8 until 3, seven days. Our Instagram
            says Monday to Friday from 8. On 4 May 2026 we were not open May Day
            Monday — back Tuesday to Friday that week.
          </p>
          <p>
            For today, look at
            <a href={facebook} rel="external">Facebook</a>.
          </p>
          <p>
            Reviews live on
            <a href={maps} rel="external">Google</a>.
          </p>
        </div>
      </div>
      <p class="nk-find-ig">
        Instagram
        <a href={instagram} rel="external">@nikiskitchencafe</a>
      </p>
    </section>
  </main>

  <footer class="nk-footer">
    <p class="nk-footer-name">Niki's Kitchen Café</p>
    <p class="nk-footer-line">107 Central Promenade, Newcastle BT33 0EU · {phone}</p>
  </footer>
</ConceptLayout>
