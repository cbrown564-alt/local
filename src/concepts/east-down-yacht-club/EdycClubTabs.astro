---
/* East Down Yacht Club — Editorial Club & Lough Guide (Unslopped). */
const sections = [
  {
    id: "sailing",
    label: "Sailing & racing",
    title: "Active dinghy, keelboat and cruiser racing on sheltered Strangford Lough.",
    points: [
      "Club racing series across spring, summer and autumn tides from Moymore slipway",
      "Welcoming mixed fleet for seasoned racers, cruising families and returning sailors",
      "Direct sheltered launch access onto Strangford Lough minutes from Killyleagh",
    ],
    note: "Visiting boats and prospective sailing members are always welcome — call 028 4482 8375 for fixture dates.",
  },
  {
    id: "caravan",
    label: "Caravan & camping",
    title: "Peaceful waterside touring caravan and camping pitches overlooking the lough.",
    points: [
      "Grassy shoreline pitches with wide views across Strangford Lough's drumlin islands",
      "Quiet club-run setting on Comber Road with easy access to Killyleagh and Delamont",
      "Ideal weekend base for sailing families, kayakers and coastal walkers",
    ],
    note: "Call the clubhouse on 028 4482 8375 or check edyc.co.uk ahead of seasonal weekend bookings.",
  },
  {
    id: "training",
    label: "RYA training",
    title: "RYA-recognised sailing and powerboat courses for juniors and adults.",
    points: [
      "Structured beginner and improver dinghy courses taught by qualified local instructors",
      "Summer junior sailing weeks building real confidence on the water",
      "Safety-boat and powerboat handling courses supporting club racing",
    ],
    note: "No boat ownership needed to start — club training dinghies are available for beginner sessions.",
  },
  {
    id: "clubhouse",
    label: "Clubhouse",
    title: "Friendly shore-side clubhouse bringing sailors and families together year-round.",
    points: [
      "Post-race bar, lounge and lough-view deck at 62 Comber Road, Moymore",
      "Family, adult, cadet and social membership categories open to newcomers",
      "Regular seasonal suppers, regatta weekends and winter shore talks",
    ],
    note: "Drop by on a club weekend or call 028 4482 8375 to meet the committee and tour the slipway.",
  },
];
---

<section class="edyc-section edyc-tabs-band" id="club" aria-labelledby="edyc-tabs-title">
  <div class="edyc-wrap">
    <div class="edyc-tabs-shell" data-edyc-tabs>
      <div class="edyc-tabs-head">
        <div>
          <p class="edyc-eyebrow">Strangford Lough · Moymore, Killyleagh</p>
          <h2 id="edyc-tabs-title">Life on the water at East Down.</h2>
        </div>
        <div class="edyc-tab-list" role="tablist" aria-label="Explore club sections">
          {sections.map((sec, idx) => (
            <button
              type="button"
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
              class:list={["edyc-tab", idx === 0 && "is-active"]}
              data-edyc-tab={sec.id}
            >
              {sec.label}
            </button>
          ))}
        </div>
      </div>

      {sections.map((sec, idx) => (
        <div class="edyc-panel" role="tabpanel" data-edyc-panel={sec.id} hidden={idx !== 0}>
          <h3>{sec.title}</h3>
          <ul class="edyc-points">
            {sec.points.map((pt, pIdx) => (
              <li>
                <span class="edyc-pt-num">0{pIdx + 1}</span>
                <span>{pt}</span>
              </li>
            ))}
          </ul>
          <div class="edyc-panel-foot">
            <p class="edyc-note"><strong>Club note:</strong> {sec.note}</p>
            <a class="edyc-arrow-btn edyc-arrow-btn--dark" href="https://edyc.co.uk/" target="_blank" rel="noopener noreferrer">
              <span class="edyc-arrow-label">Visit member portal</span>
              <span class="edyc-arrow-circle" aria-hidden="true">
                <svg class="edyc-arrow edyc-arrow--primary" width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <svg class="edyc-arrow edyc-arrow--clone" width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .edyc-tabs-shell { border-top: 1px solid var(--edyc-line); padding-top: clamp(32px, 4.5vw, 52px); }
  .edyc-tabs-head {
    display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 24px;
    padding-bottom: 28px; border-bottom: 1px solid var(--edyc-line);
  }
  .edyc-tabs-head h2 {
    margin: 0; font-family: var(--edyc-display); font-size: clamp(2rem, 3.6vw, 2.95rem);
    font-weight: 500; letter-spacing: -0.02em; line-height: 1.05;
  }
  .edyc-tab-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .edyc-tab {
    padding: 9px 16px; border: 1px solid var(--edyc-line); background: transparent; color: var(--edyc-muted);
    font-family: var(--edyc-sans); font-size: 0.86rem; font-weight: 500; border-radius: 999px; cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
  }
  .edyc-tab:hover { color: var(--edyc-ink); border-color: rgba(19, 40, 64, 0.34); }
  .edyc-tab.is-active { background: var(--edyc-accent); border-color: var(--edyc-accent); color: #ffffff; }
  .edyc-panel { padding-top: 32px; }
  .edyc-panel h3 {
    margin: 0 0 26px; font-family: var(--edyc-display); font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    font-weight: 500; line-height: 1.25; max-width: 48ch;
  }
  .edyc-points {
    list-style: none; padding: 0; margin: 0 0 32px;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 3vw, 36px);
  }
  .edyc-points li {
    padding-top: 16px; border-top: 1px solid var(--edyc-line); display: grid; gap: 8px;
    font-size: 0.94rem; line-height: 1.6; color: var(--edyc-muted);
  }
  .edyc-pt-num { font-size: 0.74rem; font-variant-numeric: tabular-nums; color: var(--edyc-accent); font-weight: 600; }
  .edyc-panel-foot { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 18px; }
  .edyc-note { margin: 0; font-size: 0.9rem; color: var(--edyc-muted); max-width: 54ch; line-height: 1.55; }
  .edyc-note strong { color: var(--edyc-ink); font-weight: 600; }
  @media (max-width: 820px) { .edyc-points { grid-template-columns: minmax(0, 1fr); } }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-edyc-tabs]");
    if (!root) return;
    const tabs = [...root.querySelectorAll("[data-edyc-tab]")];
    const panels = [...root.querySelectorAll("[data-edyc-panel]")];
    tabs.forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-edyc-tab");
        tabs.forEach((t) => {
          const active = t === btn;
          t.classList.toggle("is-active", active);
          t.setAttribute("aria-selected", active ? "true" : "false");
        });
        panels.forEach((p) => { p.hidden = p.getAttribute("data-edyc-panel") !== id; });
      });
    });
  })();
</script>
