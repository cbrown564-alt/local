---
/* East Down Yacht Club: Sailing, RYA Courses, and Caravan Park segmented tablist paired with shoreline plate */
const clubHref = "https://edyc.co.uk/";
const phone = "028 4482 8375";

const sections = [
  {
    id: "sailing",
    label: "Sailing",
    summary: "Active dinghy, keelboat and cruiser racing on sheltered Strangford Lough from Moymore slipway.",
    rows: [
      {
        title: "Spring, summer and autumn racing series",
        detail: "Welcoming mixed fleet for seasoned racers, cruising families and returning sailors.",
        meta: "Moymore slipway",
      },
      {
        title: "Direct sheltered launch access",
        detail: "Launch straight onto Strangford Lough on the western shore, minutes north of Killyleagh.",
        meta: "Strangford Lough",
      },
      {
        title: "Shore-side clubhouse and membership",
        detail: "Post-race lounge, lough-view deck, seasonal suppers and family, adult, cadet or social membership.",
        meta: phone,
      },
    ],
    ctaLabel: "Visit club portal",
  },
  {
    id: "training",
    label: "RYA Courses",
    summary: "RYA-recognised sailing and powerboat courses for juniors and adults with club training dinghies available.",
    rows: [
      {
        title: "Beginner and improver dinghy courses",
        detail: "Structured on-water tuition led by qualified local instructors; no boat ownership required to start.",
        meta: "RYA recognised",
      },
      {
        title: "Summer junior sailing weeks",
        detail: "Practical confidence-building sessions for young sailors across sheltered lough waters.",
        meta: "Junior sailing",
      },
      {
        title: "Powerboat and safety-boat handling",
        detail: "Hands-on powerboat training supporting club racing and safe shoreline operations.",
        meta: "Adult courses",
      },
    ],
    ctaLabel: "See RYA training portal",
  },
  {
    id: "caravan",
    label: "Caravan Park",
    summary: "Peaceful waterside touring caravan and camping pitches overlooking Strangford Lough's drumlin islands.",
    rows: [
      {
        title: "Grassy shoreline touring pitches",
        detail: "Wake beside the tide in a quiet club-run meadow off Comber Road with wide lough views.",
        meta: "Waterside meadow",
      },
      {
        title: "Minutes from Killyleagh and Delamont",
        detail: "Easy coastal access for sailing families, kayakers and weekend walkers across County Down.",
        meta: "3 mins to Killyleagh",
      },
      {
        title: "Seasonal weekend bookings",
        detail: "Ring the clubhouse desk on 028 4482 8375 or check edyc.co.uk ahead of weekend arrivals.",
        meta: phone,
      },
    ],
    ctaLabel: "Check caravan park portal",
  },
];
---

<section class="edyc-section edyc-salt" id="club" aria-labelledby="edyc-tabs-title">
  <div class="edyc-wrap edyc-club-grid">
    <div class="edyc-club-main" data-edyc-tabs>
      <h2 id="edyc-tabs-title">Launch from Moymore slipway or wake beside the tide.</h2>

      <div class="edyc-tabs" role="tablist" aria-label="Sailing, RYA courses and caravan park">
        {sections.map((sec, idx) => (
          <button
            type="button"
            role="tab"
            id={`edyc-tab-${sec.id}`}
            aria-controls={`edyc-panel-${sec.id}`}
            aria-selected={idx === 0 ? "true" : "false"}
            class:list={["edyc-tab", idx === 0 && "is-active"]}
            data-edyc-tab={sec.id}
          >
            {sec.label}
          </button>
        ))}
      </div>

      {sections.map((sec, idx) => (
        <div
          class="edyc-panel"
          role="tabpanel"
          id={`edyc-panel-${sec.id}`}
          aria-labelledby={`edyc-tab-${sec.id}`}
          data-edyc-panel={sec.id}
          hidden={idx !== 0}
        >
          <p class="edyc-panel-summary">{sec.summary}</p>
          <dl class="edyc-ledger">
            {sec.rows.map((row) => (
              <div class="edyc-ledger-row">
                <dt>{row.title}</dt>
                <dd>
                  <span class="edyc-ledger-detail">{row.detail}</span>
                  <span class="edyc-ledger-meta">{row.meta}</span>
                </dd>
              </div>
            ))}
          </dl>
          <div class="edyc-panel-foot">
            <a class="edyc-navy-btn" href={clubHref} target="_blank" rel="noopener noreferrer">
              {sec.ctaLabel}
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="edyc-club-visual">
      <figure class="edyc-plate">
        <picture>
          <source
            srcset="/media/concepts/east-down-yacht-club/east-down-lough-shore-640.webp 640w, /media/concepts/east-down-yacht-club/east-down-lough-shore-1265.webp 1265w"
            sizes="(max-width: 960px) 100vw, 44vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/east-down-yacht-club/east-down-lough-shore.jpg"
            alt="Peaceful golden-hour sailing club slipway and waterside touring caravan meadow overlooking calm waters of Strangford Lough"
            width="1408"
            height="768"
            loading="lazy"
          />
        </picture>
        <figcaption>Indicative Moymore slipway and waterside caravan meadow visualisation.</figcaption>
      </figure>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-edyc-tabs]");
    if (!root) return;
    const tabs = [...root.querySelectorAll("[data-edyc-tab]")];
    const panels = [...root.querySelectorAll("[data-edyc-panel]")];

    const activateTab = (id) => {
      if (!id) return;
      tabs.forEach((t) => {
        const active = t.getAttribute("data-edyc-tab") === id;
        t.classList.toggle("is-active", active);
        t.setAttribute("aria-selected", active ? "true" : "false");
      });
      panels.forEach((p) => {
        p.hidden = p.getAttribute("data-edyc-panel") !== id;
      });
    };

    tabs.forEach((btn) => {
      btn.addEventListener("click", () => activateTab(btn.getAttribute("data-edyc-tab")));
    });

    window.addEventListener("edyc:select-tab", (e) => {
      const id = e.detail?.id;
      if (id) activateTab(id);
    });
  })();
</script>
