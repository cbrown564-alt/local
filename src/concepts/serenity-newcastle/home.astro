---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import HourPlate from "./HourPlate.astro";

/* Serenity Day Spa — book the hour on the Promenade.
   Brochure site; no invented calendar. Offers live on Facebook / their site.
   Not the gift shop on Main Street. Not Serenity Room Dundrum. Not Tyne. */

const phone = "028 4372 6768";
const phoneHref = "tel:02843726768";
const site = "https://serenitynewcastle.com";
const facebook = "https://www.facebook.com/search/top/?q=Serenity%20Day%20Spa%20Newcastle";
const maps = "https://maps.google.com/?q=55-57+Central+Promenade+Newcastle+BT33+0HH";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Cormorant+Infant:ital,wght@0,500;0,600;1,500;1,600&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap";
---

<ConceptLayout
  title={"Serenity — independent concept"}
  slug="serenity-newcastle"
  bodyClass="concept-page concept-serenity"
  lang="en-GB"
  businessName="Serenity"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The hour plate is a drawn appointment slip."
>
  <div class="se-strip">
    <span>55–57 Central Promenade, Newcastle · BT33 0HH · Mon–Sat 9–6</span>
    <span class="se-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="se-header">
    <a class="se-brand" href="/concepts/serenity-newcastle/">
      <span class="se-brand-mark" aria-hidden="true">
        <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
          <circle cx="18" cy="18" r="16.2" stroke="currentColor" stroke-width="1.2"/>
          <path d="M18 7.5v21M10 12.5c3.4 2.4 4.8 5.2 8 11.8C21.2 17.7 22.6 14.9 26 12.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <circle cx="18" cy="18" r="2.2" fill="currentColor"/>
        </svg>
      </span>
      <span class="se-brand-text">
        <span class="se-brand-name">Serenity</span>
        <span class="se-brand-sub">Day spa · the Promenade</span>
      </span>
    </a>
    <nav class="se-nav" aria-label="Concept navigation">
      <a href="#hour">The hour</a>
      <a href="#ritual">The ritual</a>
      <a href="#door">Find us</a>
    </nav>
    <a class="se-book" href={phoneHref}>Book the hour</a>
  </header>

  <main class="se-main">
    <div class="se-hero" id="hour">
      <section class="se-lede" aria-labelledby="se-name">
        <p class="se-eyebrow">On the Promenade · Newcastle</p>
        <h1 id="se-name">An hour, held for you.</h1>
        <p class="se-say">Come off the sea path. Sit. Let the hour be yours.</p>
        <p class="se-body">
          We are Serenity, the day spa at 55–57 Central Promenade. Ring us and
          we will find you a time — manicure, pedicure, Dermalogica, CND Shellac,
          waxing, massage, spray tan. Parking is at the rear.
        </p>
        <p class="se-cta">
          <a class="se-book se-book--inline" href={phoneHref}>Ring {phone}</a>
          <a class="se-quiet" href="#door">Find the door</a>
        </p>
      </section>
    </div>

    <section class="se-magazine" id="ritual" aria-labelledby="se-ritual-title">
      <div class="se-mag-copy">
        <p class="se-eyebrow">The ritual of the hour</p>
        <h2 id="se-ritual-title">You book the hour. We keep it quiet.</h2>
        <p class="se-column">
          The Promenade is busy. The room is not. You come in from the sea wall,
          leave the hour on the slip, and we work — nails, skin, wax, massage,
          tan — until the time is yours again.
        </p>
        <p class="se-column">
          There is no diary on this page. The live list of times is the one we
          keep at the desk. Ring, tell us what you would like, and we will hold
          the hour.
        </p>
        <ol class="se-steps">
          <li>
            <p class="se-when">Ring</p>
            <p class="se-do">Call <a href={phoneHref}>{phone}</a> and ask for the treatment you want.</p>
          </li>
          <li>
            <p class="se-when">Arrive</p>
            <p class="se-do">55–57 Central Promenade. Park at the rear. We are open Monday to Saturday, nine until six.</p>
          </li>
          <li>
            <p class="se-when">The hour</p>
            <p class="se-do">Sit. The Promenade stays outside.</p>
          </li>
        </ol>
      </div>

      <figure class="se-artefact">
        <HourPlate />
        <figcaption>The hour, written on the slip.</figcaption>
      </figure>
    </section>

    <section class="se-offers" aria-labelledby="se-offers-title">
      <p class="se-eyebrow">This week</p>
      <h2 id="se-offers-title">Current offers live with us, not on this page.</h2>
      <p class="se-offers-body">
        What is on this week is on Facebook — Serenity Day Spa Newcastle — and
        on our site. Come back there for the latest, then ring to book the hour.
      </p>
      <p class="se-offers-cta">
        <a class="se-quiet" href={facebook} rel="external">Facebook</a>
        <a class="se-quiet" href={site} rel="external">serenitynewcastle.com</a>
      </p>
    </section>

    <section class="se-door" id="door" aria-labelledby="se-door-title">
      <p class="se-eyebrow">The door</p>
      <h2 id="se-door-title">55–57 Central Promenade.</h2>
      <div class="se-door-grid">
        <div>
          <h3>Where</h3>
          <p>
            Serenity<br />
            55–57 Central Promenade<br />
            Newcastle<br />
            BT33 0HH
          </p>
          <p>Parking at the rear.</p>
          <a class="se-quiet" href={maps} rel="external">Map</a>
        </div>
        <div>
          <h3>When</h3>
          <p>Monday to Saturday, 9 until 6.<br />Sunday closed.</p>
        </div>
        <div>
          <h3>Book the hour</h3>
          <p><a href={phoneHref}>{phone}</a></p>
          <p>
            <a href={site} rel="external">serenitynewcastle.com</a>
            · Facebook: Serenity Day Spa Newcastle
          </p>
        </div>
      </div>
    </section>
  </main>
</ConceptLayout>
