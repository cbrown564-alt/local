---
/* Appointment slip / hour plate. Drawn. Studio honesty in bannerNote. */
const phone = "028 4372 6768";
const phoneHref = "tel:02843726768";

const chips = [
  "Manicure",
  "Pedicure",
  "Dermalogica",
  "CND Shellac",
  "Waxing",
  "Massage",
  "Spray tan",
];
---

<div class="se-plate" role="img" aria-label="Appointment slip for an hour on the Promenade">
  <svg class="se-plate-svg" viewBox="0 0 420 560" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="se-linen" width="8" height="8" patternUnits="userSpaceOnUse">
        <rect width="8" height="8" fill="#f6efe4"/>
        <path d="M0 8L8 0" stroke="#eadfce" stroke-width=".4"/>
      </pattern>
    </defs>
    <rect x="18" y="22" width="384" height="516" fill="#c9b8a0" opacity=".18"/>
    <rect x="12" y="16" width="384" height="516" fill="url(#se-linen)" stroke="#c4b39a" stroke-width="1.2"/>
    <path d="M12 78h384" stroke="#c4b39a" stroke-width="1" stroke-dasharray="3 5"/>
    <circle cx="12" cy="78" r="7" fill="#f3eee6"/>
    <circle cx="396" cy="78" r="7" fill="#f3eee6"/>
    <text x="204" y="52" text-anchor="middle" fill="#5a6a58" font-family="Cormorant Infant, Georgia, serif" font-size="13" letter-spacing="4">THE HOUR</text>
    <text x="204" y="128" text-anchor="middle" fill="#2c3530" font-family="Cormorant Infant, Georgia, serif" font-style="italic" font-size="42">Serenity</text>
    <text x="204" y="154" text-anchor="middle" fill="#6b5a48" font-family="Plus Jakarta Sans, sans-serif" font-size="10" font-weight="600" letter-spacing="3.2">DAY SPA · NEWCASTLE</text>
    <text x="204" y="188" text-anchor="middle" fill="#7a6a58" font-family="Plus Jakarta Sans, sans-serif" font-size="11">55–57 Central Promenade</text>
    <line x1="72" y1="210" x2="336" y2="210" stroke="#d4c4ae"/>
    <text x="48" y="242" fill="#8a7a66" font-family="Plus Jakarta Sans, sans-serif" font-size="9" letter-spacing="2">NAME</text>
    <line x1="48" y1="268" x2="372" y2="268" stroke="#c4b39a"/>
    <text x="48" y="300" fill="#8a7a66" font-family="Plus Jakarta Sans, sans-serif" font-size="9" letter-spacing="2">TREATMENT</text>
    <line x1="48" y1="326" x2="372" y2="326" stroke="#c4b39a"/>
    <text x="48" y="358" fill="#8a7a66" font-family="Plus Jakarta Sans, sans-serif" font-size="9" letter-spacing="2">WHEN</text>
    <line x1="48" y1="384" x2="220" y2="384" stroke="#c4b39a"/>
    <text x="236" y="358" fill="#8a7a66" font-family="Plus Jakarta Sans, sans-serif" font-size="9" letter-spacing="2">HOUR</text>
    <line x1="236" y1="384" x2="372" y2="384" stroke="#c4b39a"/>
    <text x="204" y="430" text-anchor="middle" fill="#5a6a58" font-family="Cormorant Infant, Georgia, serif" font-style="italic" font-size="18">We hold the hour when you ring.</text>
    <text x="204" y="462" text-anchor="middle" fill="#2c3530" font-family="Plus Jakarta Sans, sans-serif" font-size="13" font-weight="700">{phone}</text>
    <text x="204" y="492" text-anchor="middle" fill="#8a7a66" font-family="Plus Jakarta Sans, sans-serif" font-size="10">Mon–Sat 9–6 · Sunday closed</text>
  </svg>

  <div class="se-plate-live">
    <p class="se-plate-kicker">Ask for the hour</p>
    <ul class="se-chips">
      {chips.map((chip) => (
        <li><span>{chip}</span></li>
      ))}
    </ul>
    <a class="se-ring" href={phoneHref}>Ring {phone}</a>
  </div>
</div>
