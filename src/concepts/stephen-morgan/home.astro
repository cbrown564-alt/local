---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

/* Stephen Morgan Funeral Directors — relief. Speak as the firm.
   Live facts re-read 29 August 2026: Funeral Times listing + Google
   (Open 24 hours). No owned website. Phone and email are the mechanism.
   No contact-form theatre. No recent-funeral list (privacy). Handoff is
   Funeral Times for current notices. Do not invent chapel hours. Do not
   invent “established”. Do not claim NAFD/SAIF. Do not confuse with
   McKeague Morgan or Stephen Magee Electrical. Distinct from Dominic
   McInerney at 123A — this is 14 Main Street, funerals. No EssenceMedia.
   No rasters. No stock hearse. No named deceased. Theatre is none. */
const phone = "028 4375 8323";
const phoneHref = "tel:+442843758323";
const email = "smorganfunerals@gmail.com";
const mailto = `mailto:${email}`;
const notices = "https://www.funeraltimes.com/stephen-morgan-funeral-directors";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400;0,500;0,700;1,400&family=Alegreya+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap";

const held = [
  "Pre arranged funerals",
  "Coffin ranges",
  "Floral tributes",
  "Order of service",
  "Newspaper notices",
  "Modern fleet of vehicles",
  "Highly qualified staff",
];
---

<ConceptLayout
  title={"Stephen Morgan Funeral Directors — independent concept"}
  slug="stephen-morgan"
  bodyClass="concept-page concept-stephen-morgan"
  lang="en-GB"
  businessName="Stephen Morgan Funeral Directors"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="Photography comprises illustrative visualisations of 14 Main Street and Newcastle at twilight."
>
  <header class="sm-letterhead">
    <p class="sm-availability">Open 24 hours · 24 hour personal service</p>
    <h1 class="sm-firm">Stephen Morgan</h1>
    <p class="sm-practice">Funeral Directors</p>
    <hr class="sm-letterhead-rule" />
    <p class="sm-address-line">14 Main Street · Newcastle · BT33 0AD</p>
  </header>

  <main class="sm-column">
    <section class="sm-opening" aria-labelledby="sm-opening-heading">
      <h2 class="sm-opening-heading" id="sm-opening-heading">
        A dignified, professional and caring service.
      </h2>
      <p class="sm-opening-words">
        When someone dies, there is much to attend to, and it can be difficult to know
        where to begin. We are available every hour of the day or night to provide
        quiet, supportive advice and to take care of every detail with dignity and
        discretion.
      </p>
      <p class="sm-opening-words">
        If you need us tonight, ring
        <a class="sm-inline-tel" href={phoneHref}>{phone}</a>.
      </p>
    </section>

    <figure class="sm-photograph">
      <img
        src="/media/concepts/stephen-morgan/stephen-morgan-hero-main-street.jpg"
        alt="Dignified independent funeral home exterior on Main Street in Newcastle during quiet blue hour twilight with a warm glowing lamp behind frosted windows"
        width="1376"
        height="768"
        loading="eager"
      />
      <figcaption class="sm-photograph-note">
        14 Main Street — attended any hour of the day or night.
      </figcaption>
    </figure>

    <section class="sm-held" id="arrangements" aria-labelledby="sm-held-heading">
      <h2 class="sm-held-heading" id="sm-held-heading">Held at 14.</h2>
      <p class="sm-held-intro">
        We offer a 24 hour personal service, guiding families through the practical
        and legal requirements of a funeral.
      </p>
      <ul class="sm-held-list" aria-label="Services provided">
        {held.map((item) => (
          <li class="sm-held-item">{item}</li>
        ))}
      </ul>
    </section>

    <section class="sm-sitting" aria-labelledby="sm-sitting-heading">
      <h2 class="sm-sitting-heading" id="sm-sitting-heading">A calm space to talk.</h2>
      <p class="sm-sitting-copy">
        We welcome families into our quiet consultation rooms on Main Street, or we
        can visit you in the comfort of your own home. Every arrangement is handled
        personally, with all the time and care needed to honour your family's wishes.
      </p>
    </section>

    <figure class="sm-photograph">
      <img
        src="/media/concepts/stephen-morgan/stephen-morgan-consultation-room.jpg"
        alt="Quiet private family consultation room with muted linen armchairs and warm reading lamp"
        width="1200"
        height="896"
        loading="lazy"
      />
      <figcaption class="sm-photograph-note">
        The consultation room at 14 Main Street.
      </figcaption>
    </figure>

    <figure class="sm-photograph">
      <img
        src="/media/concepts/stephen-morgan/stephen-morgan-coastal-twilight.jpg"
        alt="Quiet Newcastle shoreline and silhouette of Slieve Donard at peaceful twilight"
        width="1200"
        height="896"
        loading="lazy"
      />
      <figcaption class="sm-photograph-note">
        Newcastle, a peaceful evening under the Mournes.
      </figcaption>
    </figure>

    <section class="sm-listings" aria-labelledby="sm-listings-heading">
      <h2 class="sm-listings-heading" id="sm-listings-heading">Family notices.</h2>
      <p class="sm-listings-copy">
        Current funeral arrangements and family notices live on Funeral Times.
      </p>
      <p class="sm-listings-copy">
        <a class="sm-listings-link" href={notices} rel="noopener noreferrer">
          View notices on Funeral Times
        </a>
      </p>
    </section>
  </main>

  <footer class="sm-correspondence" aria-labelledby="sm-correspondence-heading">
    <h2 class="sm-correspondence-heading" id="sm-correspondence-heading">
      The door is attended.
    </h2>
    <p class="sm-reach-line">
      Telephone, at any hour —
      <a class="sm-reach-link" href={phoneHref}>{phone}</a>
    </p>
    <p class="sm-reach-line">
      Write to us —
      <a class="sm-reach-link" href={mailto}>{email}</a>
    </p>
    <address class="sm-postal">
      Stephen Morgan Funeral Directors<br />
      14 Main Street · Newcastle · BT33 0AD
    </address>
  </footer>
</ConceptLayout>
