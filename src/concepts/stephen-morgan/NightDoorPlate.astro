---
/* Drawn night door at 14 Main Street.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
---

<svg
  class="sm-door-plate"
  viewBox="0 0 1000 640"
  role="img"
  aria-label="Drawn night door at 14 Main Street: a dark door under a wall lamp, brass plate reading 14, and a 24-hour plate with the telephone number"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="sm-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#141820"/>
      <stop offset="1" stop-color="#0e1016"/>
    </linearGradient>
    <linearGradient id="sm-render" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2a2622"/>
      <stop offset="1" stop-color="#1e1a16"/>
    </linearGradient>
    <linearGradient id="sm-door-g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2c241c"/>
      <stop offset="1" stop-color="#16120e"/>
    </linearGradient>
    <linearGradient id="sm-pavement" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2a2c30"/>
      <stop offset="1" stop-color="#1c1e22"/>
    </linearGradient>
    <linearGradient id="sm-brass-g" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#d4b46a"/>
      <stop offset="1" stop-color="#8a6a34"/>
    </linearGradient>
    <radialGradient id="sm-cone" cx="50%" cy="0%" r="80%">
      <stop offset="0" stop-color="#f0d48a" stop-opacity="0.38"/>
      <stop offset="0.45" stop-color="#c4a056" stop-opacity="0.12"/>
      <stop offset="1" stop-color="#c4a056" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="sm-bulb" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#fff4c8"/>
      <stop offset="0.55" stop-color="#e0b24a"/>
      <stop offset="1" stop-color="#e0b24a" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <rect width="1000" height="640" fill="url(#sm-sky)"/>

  <!-- Opposite street — windows, not a portrait -->
  <path d="M0 210h1000v90H0Z" fill="#1a1c22"/>
  <path d="M0 210l80-44h140l50 44H0Z" fill="#242028"/>
  <path d="M270 210l90-50h160l70 50H270Z" fill="#201c24"/>
  <path d="M590 210l70-36h160l90 36H590Z" fill="#26222a"/>
  <g fill="#c4a056" opacity=".55">
    <rect x="48" y="228" width="18" height="26"/>
    <rect x="78" y="228" width="18" height="26"/>
    <rect x="330" y="224" width="20" height="30"/>
    <rect x="362" y="224" width="20" height="30"/>
    <rect x="394" y="224" width="20" height="30"/>
    <rect x="680" y="226" width="16" height="24"/>
    <rect x="706" y="226" width="16" height="24"/>
    <rect x="732" y="226" width="16" height="24"/>
  </g>
  <rect x="0" y="298" width="1000" height="8" fill="#12141a"/>

  <!-- Facade -->
  <rect x="0" y="306" width="1000" height="262" fill="url(#sm-render)"/>
  <rect x="0" y="306" width="1000" height="10" fill="#3a342c"/>

  <!-- Recess -->
  <rect x="318" y="168" width="364" height="400" fill="#16120e"/>
  <rect x="332" y="182" width="336" height="386" fill="url(#sm-door-g)"/>

  <!-- Fanlight with 14 -->
  <rect x="348" y="196" width="304" height="64" fill="#1c222c"/>
  <rect x="356" y="204" width="140" height="48" fill="#2a3240"/>
  <rect x="504" y="204" width="140" height="48" fill="#2a3240"/>
  <line x1="500" y1="204" x2="500" y2="252" stroke="#3a342c" stroke-width="4"/>
  <text
    x="500"
    y="238"
    text-anchor="middle"
    fill="#c4a056"
    font-family="Spectral, Georgia, serif"
    font-size="28"
    font-weight="700"
  >14</text>

  <!-- Panels -->
  <g fill="none" stroke="#3a3228" stroke-width="3">
    <rect x="360" y="276" width="128" height="110"/>
    <rect x="512" y="276" width="128" height="110"/>
    <rect x="360" y="404" width="128" height="128"/>
    <rect x="512" y="404" width="128" height="128"/>
  </g>
  <g fill="#0e0c0a" opacity=".35">
    <rect x="368" y="284" width="112" height="94"/>
    <rect x="520" y="284" width="112" height="94"/>
    <rect x="368" y="412" width="112" height="112"/>
    <rect x="520" y="412" width="112" height="112"/>
  </g>

  <!-- Lamp -->
  <g transform="translate(500 132)">
    <rect x="-6" y="0" width="12" height="18" fill="#3a342c"/>
    <path d="M-28 18h56l-10 22h-36Z" fill="#8a6a34"/>
    <path d="M-28 18h56l-10 22h-36Z" fill="url(#sm-brass-g)"/>
    <ellipse cx="0" cy="28" rx="36" ry="18" fill="url(#sm-bulb)"/>
  </g>
  <polygon points="500,170 720,568 280,568" fill="url(#sm-cone)"/>

  <!-- Brass number plate -->
  <g transform="translate(430 292)">
    <rect x="0" y="0" width="140" height="72" rx="3" fill="url(#sm-brass-g)"/>
    <rect x="6" y="6" width="128" height="60" rx="2" fill="none" stroke="#5a4020" stroke-width="1.4"/>
    <text
      x="70"
      y="50"
      text-anchor="middle"
      fill="#1a140c"
      font-family="Spectral, Georgia, serif"
      font-size="36"
      font-weight="700"
    >14</text>
  </g>

  <!-- 24-hour plate -->
  <g transform="translate(392 378)">
    <rect x="0" y="0" width="216" height="92" rx="2" fill="#c4b089"/>
    <rect x="5" y="5" width="206" height="82" rx="1" fill="none" stroke="#6e5428" stroke-width="1.2"/>
    <text
      x="108"
      y="24"
      text-anchor="middle"
      fill="#1a140c"
      font-family="Public Sans, Segoe UI, sans-serif"
      font-size="9"
      font-weight="700"
      letter-spacing="2.2"
    >STEPHEN MORGAN</text>
    <text
      x="108"
      y="40"
      text-anchor="middle"
      fill="#6e5428"
      font-family="Public Sans, Segoe UI, sans-serif"
      font-size="8"
      font-weight="700"
      letter-spacing="1.6"
    >FUNERAL DIRECTORS</text>
    <text
      x="108"
      y="60"
      text-anchor="middle"
      fill="#1a140c"
      font-family="Public Sans, Segoe UI, sans-serif"
      font-size="8"
      font-weight="700"
      letter-spacing="1.4"
    >24 HOUR PERSONAL SERVICE</text>
    <text
      x="108"
      y="78"
      text-anchor="middle"
      fill="#1a140c"
      font-family="Spectral, Georgia, serif"
      font-size="13"
      font-weight="700"
    >028 4375 8323</text>
  </g>

  <!-- Knocker — quiet, not theatre -->
  <g transform="translate(618 330)">
    <circle cx="0" cy="0" r="7" fill="url(#sm-brass-g)"/>
    <path d="M-10 8c0 14 20 14 20 0" fill="none" stroke="#8a6a34" stroke-width="3.5"/>
  </g>

  <!-- Step -->
  <rect x="300" y="568" width="400" height="18" fill="#3a3834"/>
  <rect x="280" y="586" width="440" height="22" fill="url(#sm-pavement)"/>
  <text
    x="500"
    y="602"
    text-anchor="middle"
    fill="#c4a056"
    font-family="Spectral, Georgia, serif"
    font-size="11"
    font-weight="700"
  >14 MAIN STREET</text>

  <!-- Pavement -->
  <rect x="0" y="608" width="1000" height="32" fill="#242628"/>
  <rect x="0" y="608" width="1000" height="4" fill="#3a3c40"/>
</svg>
