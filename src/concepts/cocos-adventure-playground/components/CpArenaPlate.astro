---
interface Props {
  headingId?: string;
}

const { headingId = "arena-plate-title" } = Astro.props;

const keypoints = [
  {
    num: "01",
    name: "Multi-Level Adventure Kingdom",
    desc: "Giant spiral slides, padded climbing towers, ball pools, rope bridges, and tunnels for ages up to 14.",
  },
  {
    num: "02",
    name: "Soft Sensory Toddler Zone",
    desc: "Enclosed, gentle play space with foam shapes, mini-slides, and sensory mats designed specially for babies and toddlers under 3.",
  },
  {
    num: "03",
    name: "Mezzanine Viewing Café",
    desc: "Comfortable seating with barista-brewed coffee, hot food, and snacks with an unobstructed view across the whole play frame.",
  },
  {
    num: "04",
    name: "Dedicated Party Rooms",
    desc: "Private celebration spaces hosting the Coco and Bumper birthday parties with hot food, drinks, and party bags.",
  },
];
---

<div class="cp-plate" aria-labelledby={headingId}>
  <div class="cp-plate-head">
    <span class="cp-plate-kicker">Play Arena &amp; Location Schematic · 27A Central Promenade</span>
    <h3 id={headingId} class="cp-plate-title">Inside Coco's: Two floors of family adventure.</h3>
    <p class="cp-plate-intro">
      Located directly opposite the Newcastle Centre on Central Promenade.
      Designed with clear sightlines so parents can relax in the café while kids explore the frame.
    </p>
  </div>

  <div class="cp-plate-stage">
    <svg
      class="cp-plate-svg"
      viewBox="0 0 900 480"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-label="Schematic floorplan and arena layout of Coco's Adventure Playground Newcastle"
    >
      <defs>
        <linearGradient id="cpFloorGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#fff8e8" />
          <stop offset="100%" stop-color="#faeed4" />
        </linearGradient>
        <linearGradient id="cpPlayGrad" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#e2f5ec" />
          <stop offset="100%" stop-color="#c5edd7" />
        </linearGradient>
        <linearGradient id="cpCafeGrad" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#fdf0dd" />
          <stop offset="100%" stop-color="#fae2be" />
        </linearGradient>
      </defs>

      <!-- Outer Building Boundary -->
      <rect width="900" height="480" fill="url(#cpFloorGrad)" rx="12" />
      <rect x="20" y="20" width="860" height="440" rx="8" fill="#ffffff" stroke="#142c4b" stroke-width="2" />

      <!-- Promenade Frontage Banner -->
      <rect x="20" y="20" width="860" height="36" rx="6" fill="#142c4b" />
      <text x="40" y="44" fill="#ffd13b" font-size="14" font-weight="700" letter-spacing="1">
        27A CENTRAL PROMENADE (OPPOSITE NEWCASTLE CENTRE)
      </text>
      <text x="730" y="44" fill="#ffffff" font-size="12" font-weight="600" opacity="0.9">
        WALK-IN PLAY · 0–14 YRS
      </text>

      <!-- Zone 1: Main Multi-Level Play Frame -->
      <rect x="50" y="80" width="480" height="260" rx="8" fill="url(#cpPlayGrad)" stroke="#2ebb77" stroke-width="2" />
      <text x="70" y="110" fill="#0f5933" font-size="15" font-weight="700">
        MAIN ADVENTURE PLAY FRAME (AGES 4–14)
      </text>

      <!-- Multi-tier Frame Graphics -->
      <rect x="70" y="130" width="130" height="180" rx="6" fill="#ffffff" stroke="#142c4b" stroke-width="1.5" stroke-dasharray="4 4" />
      <text x="95" y="225" fill="#142c4b" font-size="12" font-weight="600">3-TIER CLIMB</text>

      <rect x="220" y="130" width="140" height="180" rx="6" fill="#ffffff" stroke="#142c4b" stroke-width="1.5" stroke-dasharray="4 4" />
      <text x="250" y="225" fill="#142c4b" font-size="12" font-weight="600">ROPE BRIDGES</text>

      <!-- Ball Pit Graphic -->
      <circle cx="430" cy="180" r="45" fill="#ffd13b" fill-opacity="0.3" stroke="#e85a12" stroke-width="2" />
      <circle cx="420" cy="175" r="7" fill="#e85a12" />
      <circle cx="440" cy="170" r="7" fill="#3b82f6" />
      <circle cx="435" cy="190" r="7" fill="#2ebb77" />
      <text x="395" y="240" fill="#e85a12" font-size="11" font-weight="700">BALL POOL</text>

      <!-- Spiral Slide Curve -->
      <path
        d="M135 150 C180 150 210 200 170 260 C145 295 190 310 260 300"
        stroke="#e85a12"
        stroke-width="8"
        stroke-linecap="round"
        fill="none"
      />
      <text x="145" y="285" fill="#e85a12" font-size="11" font-weight="700">SPIRAL SLIDE</text>

      <!-- Zone 2: Toddler Soft Sensory Zone -->
      <rect x="50" y="360" width="300" height="80" rx="6" fill="#fff1f2" stroke="#f43f5e" stroke-width="1.8" />
      <text x="70" y="390" fill="#be123c" font-size="13" font-weight="700">
        TODDLER &amp; BABY SENSORY ZONE
      </text>
      <text x="70" y="415" fill="#881337" font-size="11" font-weight="500">
        Padded shapes, mini-slides &amp; sensory mats (Under 3s)
      </text>

      <!-- Zone 3: Mezzanine Family Viewing Café -->
      <rect x="560" y="80" width="290" height="200" rx="8" fill="url(#cpCafeGrad)" stroke="#c48b3c" stroke-width="2" />
      <text x="580" y="110" fill="#78350f" font-size="14" font-weight="700">
        MEZZANINE VIEWING CAFÉ
      </text>
      <text x="580" y="132" fill="#92400e" font-size="11" font-weight="600">
        Barista Coffee · Hot Food · Full Sightline
      </text>

      <!-- Café Tables -->
      <circle cx="610" cy="180" r="20" fill="#ffffff" stroke="#c48b3c" stroke-width="1.5" />
      <circle cx="610" cy="180" r="4" fill="#c48b3c" />
      <circle cx="680" cy="180" r="20" fill="#ffffff" stroke="#c48b3c" stroke-width="1.5" />
      <circle cx="680" cy="180" r="4" fill="#c48b3c" />
      <circle cx="750" cy="180" r="20" fill="#ffffff" stroke="#c48b3c" stroke-width="1.5" />
      <circle cx="750" cy="180" r="4" fill="#c48b3c" />

      <circle cx="645" cy="235" r="20" fill="#ffffff" stroke="#c48b3c" stroke-width="1.5" />
      <circle cx="645" cy="235" r="4" fill="#c48b3c" />
      <circle cx="715" cy="235" r="20" fill="#ffffff" stroke="#c48b3c" stroke-width="1.5" />
      <circle cx="715" cy="235" r="4" fill="#c48b3c" />

      <!-- Zone 4: Dedicated Birthday Party Suites -->
      <rect x="560" y="300" width="290" height="140" rx="8" fill="#eef2ff" stroke="#4338ca" stroke-width="2" />
      <text x="580" y="330" fill="#312e81" font-size="14" font-weight="700">
        PARTY ROOMS &amp; CELEBRATION SUITE
      </text>
      <rect x="580" y="350" width="120" height="70" rx="4" fill="#ffffff" stroke="#4338ca" stroke-width="1.2" />
      <text x="590" y="380" fill="#3730a3" font-size="11" font-weight="700">COCO ROOM</text>
      <text x="590" y="400" fill="#4f46e5" font-size="10">Hot meals &amp; cake</text>

      <rect x="715" y="350" width="120" height="70" rx="4" fill="#ffffff" stroke="#4338ca" stroke-width="1.2" />
      <text x="725" y="380" fill="#3730a3" font-size="11" font-weight="700">BUMPER ROOM</text>
      <text x="725" y="400" fill="#4f46e5" font-size="10">Bags &amp; Ice cream</text>

      <!-- Pins -->
      <!-- Pin 01: Adventure Frame -->
      <g class="cp-svg-pin" transform="translate(190, 95)">
        <circle cx="0" cy="0" r="14" fill="#142c4b" stroke="#ffd13b" stroke-width="2" />
        <text x="0" y="4" fill="#ffd13b" font-size="10" font-weight="700" text-anchor="middle">01</text>
      </g>

      <!-- Pin 02: Toddler Zone -->
      <g class="cp-svg-pin" transform="translate(370, 395)">
        <circle cx="0" cy="0" r="14" fill="#142c4b" stroke="#ffd13b" stroke-width="2" />
        <text x="0" y="4" fill="#ffd13b" font-size="10" font-weight="700" text-anchor="middle">02</text>
      </g>

      <!-- Pin 03: Mezzanine Café -->
      <g class="cp-svg-pin" transform="translate(820, 95)">
        <circle cx="0" cy="0" r="14" fill="#142c4b" stroke="#ffd13b" stroke-width="2" />
        <text x="0" y="4" fill="#ffd13b" font-size="10" font-weight="700" text-anchor="middle">03</text>
      </g>

      <!-- Pin 04: Party Rooms -->
      <g class="cp-svg-pin" transform="translate(820, 315)">
        <circle cx="0" cy="0" r="14" fill="#142c4b" stroke="#ffd13b" stroke-width="2" />
        <text x="0" y="4" fill="#ffd13b" font-size="10" font-weight="700" text-anchor="middle">04</text>
      </g>
    </svg>
  </div>

  <!-- Keypoint Cards -->
  <div class="cp-plate-grid" role="list">
    {keypoints.map((pt) => (
      <article class="cp-plate-card" role="listitem">
        <span class="cp-plate-num">{pt.num}</span>
        <div class="cp-plate-card-body">
          <h4 class="cp-plate-card-title">{pt.name}</h4>
          <p class="cp-plate-card-desc">{pt.desc}</p>
        </div>
      </article>
    ))}
  </div>
</div>
