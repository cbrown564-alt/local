---
interface Props {
  size?: number;
  class?: string;
}

const { size = 36, class: className = "" } = Astro.props;
---

<svg
  class={`cp-brand-mark ${className}`}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <!-- Castle / Tower Base -->
  <path
    d="M8 20V42H40V20L36 16V10H32V16L24 8L16 16V10H12V16L8 20Z"
    fill="currentColor"
    fill-opacity="0.15"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linejoin="round"
  />
  <!-- Tower Battlements -->
  <path
    d="M12 10H16M32 10H36"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
  />
  <!-- Spiral Slide Curve -->
  <path
    d="M24 16C28 16 34 19 32 26C30 33 16 30 14 37C13 41 17 42 22 42"
    stroke="#e85a12"
    stroke-width="3"
    stroke-linecap="round"
  />
  <!-- Playful Flag atop peak -->
  <path
    d="M24 8V3M24 3L30 5.5L24 8"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <!-- Play Star Sparkle -->
  <circle cx="36" cy="24" r="2" fill="#ffd13b" />
  <circle cx="12" cy="28" r="2" fill="#ffd13b" />
</svg>
