---
/* Woodhill Kitchens, Interactive Kitchens, Sliderobes, and Joinery stage.
   Guides Ballynahinch and County Down homeowners across Kitchens, Sliderobes, and Joinery. */
interface Props {
  phone: string;
  phoneHref: string;
}
const { phone, phoneHref } = Astro.props;

const tabs = [
  {
    id: "kitchens",
    label: "Kitchens",
    summary:
      "Made-to-measure shaker, painted, and contemporary kitchens built around real cooking, with quartz, solid wood, and hard-wearing worktops fitted across County Down.",
    rows: [
      { term: "Design and fitting", detail: "Home measure, practical layout planning, and full County Down installation from Cumber Road" },
      { term: "Materials", detail: "Painted shaker, timber joinery, quartz, and solid wood worktops" },
      { term: "First step", detail: "Bring rough wall measurements or new-build plans to our Drumaness showroom" },
    ],
  },
  {
    id: "sliderobes",
    label: "Sliderobes",
    summary:
      "Floor-to-ceiling sliding wardrobes engineered cleanly into chimney breasts, sloping eaves, and alcoves so doors glide cleanly and every inch works properly.",
    rows: [
      { term: "Internal layout", detail: "Custom hanging rails, drawer stacks, shelving, and shoe storage" },
      { term: "Doors and tracks", detail: "Soft-close sliding tracks in mirrored, matte putty, or timber panels" },
      { term: "First step", detail: "Note your alcove width and ceiling height; we measure accurately on site before manufacture" },
    ],
  },
  {
    id: "joinery",
    label: "Joinery",
    summary:
      "Coordinated fitted bedrooms, bedside joinery, dressing tables, and full-wall storage in calm finishes across Ballynahinch, Drumaness, Downpatrick, and Saintfield.",
    rows: [
      { term: "Room fit", detail: "Built-in storage tailored to room proportions with minimal disruption during fitting" },
      { term: "Finishes", detail: "Soft-touch painted doors, warm smoked-oak accents, and solid internal carcasses" },
      { term: "Showroom desk", detail: phone, href: phoneHref },
    ],
  },
];
---

<section class="wh-section wh-stage" id="craft" aria-labelledby="wh-craft-title">
  <div class="wh-wrap wh-stage-grid">
    <div class="wh-stage-copy">
      <h2 id="wh-craft-title">Wall-to-wall storage and kitchens fitted to the millimetre.</h2>

      <div class="wh-tabs" role="tablist" aria-label="Kitchens, sliderobes, and joinery" data-wh-tabs>
        {tabs.map((item, idx) => (
          <button
            type="button"
            class="wh-tab"
            role="tab"
            id={`wh-tab-${item.id}`}
            aria-selected={idx === 0 ? "true" : "false"}
            aria-controls={`wh-panel-${item.id}`}
            tabindex={idx === 0 ? 0 : -1}
          >
            {item.label}
          </button>
        ))}
      </div>

      {tabs.map((item, idx) => (
        <div
          class="wh-panel"
          role="tabpanel"
          id={`wh-panel-${item.id}`}
          aria-labelledby={`wh-tab-${item.id}`}
          hidden={idx !== 0}
        >
          <p>{item.summary}</p>
          <dl class="wh-stage-ledger">
            {item.rows.map((row) => (
              <div>
                <dt>{row.term}</dt>
                <dd>
                  {row.href ? <a href={row.href}>{row.detail}</a> : row.detail}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
    </div>

    <div class="wh-stage-media" id="sliderobes">
      <figure class="wh-plate">
        <picture>
          <source
            srcset="/media/concepts/woodhill-kitchens/woodhill-sliderobe-bedroom-640.webp 640w, /media/concepts/woodhill-kitchens/woodhill-sliderobe-bedroom-1265.webp 1265w"
            sizes="(max-width: 960px) 100vw, 48vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/woodhill-kitchens/woodhill-sliderobe-bedroom.jpg"
            alt="Calm contemporary fitted bedroom with floor-to-ceiling sliding wardrobes in muted putty linen and oak trim"
            width="1408"
            height="768"
            loading="lazy"
          />
        </picture>
        <figcaption>Floor-to-ceiling fitted sliderobes. Indicative bedroom visualisation.</figcaption>
      </figure>
    </div>
  </div>
</section>
