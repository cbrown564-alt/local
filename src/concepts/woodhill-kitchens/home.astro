---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import WhkProjectBrief from "./WhkProjectBrief.astro";
import "./styles.css";

/* Woodhill Kitchens, 6 Cumber Road, Drumaness, Ballynahinch BT24 8SG.
   Verified live 26 Nov 2026: Fitted kitchens, sliderobes, and bespoke bedrooms
   across Ballynahinch and County Down. Phone: 028 9756 2727. */
const phone = "028 9756 2727";
const phoneHref = "tel:+442897562727";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Woodhill+Kitchens+6+Cumber+Road+Drumaness+BT24+8SG";
---

<ConceptLayout
  title="Woodhill Kitchens, Fitted Kitchens and Sliderobes, Drumaness"
  slug="woodhill-kitchens"
  bodyClass="concept-page concept-woodhill"
  businessName="Woodhill Kitchens"
  town="Drumaness"
  bannerNote="Imagery comprises indicative bespoke shaker kitchen and fitted sliderobe visualisations."
>
  <header class="wh-header" data-wh-header>
    <div class="wh-header-inner">
      <a class="wh-brand" href="#top">Woodhill Kitchens</a>
      <nav class="wh-nav" aria-label="Primary">
        <a href="#craft">Kitchens and sliderobes</a>
        <a href="#enquire">Home measure</a>
        <a href="#location">Drumaness</a>
      </nav>
      <div class="wh-header-actions">
        <a class="wh-header-tel" href={phoneHref}>{phone}</a>
        <a class="wh-header-cta" href="#enquire">Home measure</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="wh-hero" aria-labelledby="wh-hero-title">
      <div class="wh-hero-sentinel" data-wh-sentinel aria-hidden="true"></div>
      <div class="wh-wrap">
        <div class="wh-hero-top">
          <div class="wh-hero-title-col">
            <h1 id="wh-hero-title">Fitted kitchens and sliderobes built to last.</h1>
          </div>
          <div class="wh-hero-copy-col">
            <p class="wh-hero-lead">
              Personal design, painted and timber joinery, and millimetre-accurate installation from our Drumaness showroom across County Down.
            </p>
            <a class="wh-btn wh-btn--primary" href="#enquire">Arrange a home measure</a>
          </div>
        </div>

        <figure class="wh-hero-plate">
          <picture>
            <source
              srcset="/media/concepts/woodhill-kitchens/woodhill-fitted-kitchen-640.webp 640w, /media/concepts/woodhill-kitchens/woodhill-fitted-kitchen-1265.webp 1265w"
              sizes="100vw"
              type="image/webp"
            />
            <img
              src="/media/concepts/woodhill-kitchens/woodhill-fitted-kitchen.jpg"
              alt="Handmade sage-charcoal shaker kitchen with honed quartz island, brass handles, and smoked oak shelving"
              width="1408"
              height="768"
              loading="eager"
            />
          </picture>
          <figcaption>6 Cumber Road, Drumaness. Indicative bespoke kitchen joinery visualisation.</figcaption>
        </figure>
      </div>
    </section>

    <WhkProjectBrief phone={phone} phoneHref={phoneHref} />

    <section class="wh-section wh-enquire" id="enquire" aria-labelledby="wh-enq-title">
      <div class="wh-wrap wh-split">
        <div class="wh-copy-col">
          <h2 id="wh-enq-title">Arrange a home measure or Drumaness showroom visit.</h2>
          <p>
            Ring <a href={phoneHref}>{phone}</a> to inspect door finishes and internal carcass samples on Cumber Road, or send your room details below so we can arrange a home measure across Ballynahinch, Drumaness, Downpatrick, and Saintfield.
          </p>
          <dl class="wh-ledger">
            <div>
              <dt>Measure desk</dt>
              <dd><a href={phoneHref}>{phone}</a></dd>
            </div>
            <div>
              <dt>Showroom</dt>
              <dd>6 Cumber Road, Drumaness, Ballynahinch, BT24 8SG</dd>
            </div>
            <div>
              <dt>Directions</dt>
              <dd><a href={mapsHref} target="_blank" rel="noopener noreferrer">Open Google Maps ↗</a></dd>
            </div>
          </dl>
        </div>

        <div class="wh-form-col">
          <form class="wh-form" data-wh-form>
            <div class="wh-row">
              <label>
                <span>Your name</span>
                <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
              </label>
              <label>
                <span>Telephone</span>
                <input name="phone" type="tel" required autocomplete="tel" placeholder="028 or 07..." />
              </label>
            </div>
            <div class="wh-row">
              <label>
                <span>Project type</span>
                <select name="project">
                  <option value="Fitted kitchen">Fitted kitchen</option>
                  <option value="Floor-to-ceiling sliderobes">Floor-to-ceiling sliderobes</option>
                  <option value="Fitted bedroom joinery">Fitted bedroom joinery</option>
                  <option value="Kitchen and bedroom project">Kitchen and bedroom project</option>
                </select>
              </label>
              <label>
                <span>Town or postcode</span>
                <input name="town" type="text" required placeholder="e.g. Ballynahinch or BT24" />
              </label>
            </div>
            <label>
              <span>Preferred appointment</span>
              <select name="appointment">
                <option value="Home measure visit">Home measure visit</option>
                <option value="Drumaness showroom visit">Drumaness showroom visit</option>
                <option value="Phone call with plans">Phone call with plans</option>
              </select>
            </label>
            <label>
              <span>Room dimensions or project notes</span>
              <textarea name="notes" rows="3" placeholder="Rough wall sizes, alcove widths, new-build stage, or preferred finishes"></textarea>
            </label>
            <button class="wh-btn wh-btn--primary" type="submit">Prepare measure request</button>
          </form>
        </div>
      </div>
    </section>

    <section class="wh-section wh-map-band" id="location" aria-label="Drumaness Ballynahinch map">
      <div class="wh-wrap">
        <LocalAreaMap
          id="wh-map"
          kicker=""
          businessName="Woodhill Kitchens"
          address="6 Cumber Road, Drumaness, Ballynahinch, BT24 8SG"
          lon={-5.8555363}
          lat={54.3722951}
          spanKm={18}
          mapHref={mapsHref}
          markers={[
            { name: "Ballynahinch", lon: -5.8971, lat: 54.4011, note: "5 mins north-west", side: "l" },
            { name: "Downpatrick", lon: -5.7168, lat: 54.3286, note: "12 mins south-east", side: "r" },
            { name: "Crossgar", lon: -5.7644, lat: 54.4021, note: "10 mins north-east", side: "t" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="wh-footer">
    <div class="wh-wrap wh-footer-inner">
      <div>
        <strong>Woodhill Kitchens</strong>
        <p>6 Cumber Road, Drumaness, Ballynahinch, Co. Down, BT24 8SG</p>
      </div>
      <div class="wh-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={mapsHref} target="_blank" rel="noopener noreferrer">Directions ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-wh-header]");
      const sentinel = document.querySelector("[data-wh-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            const entry = entries[0];
            if (!entry) return;
            header.classList.toggle("is-scrolled", !entry.isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      const tablist = document.querySelector("[data-wh-tabs]");
      if (tablist) {
        const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
        const activate = (tab, moveFocus) => {
          tabs.forEach((t) => {
            const selected = t === tab;
            t.setAttribute("aria-selected", String(selected));
            t.tabIndex = selected ? 0 : -1;
            const panelId = t.getAttribute("aria-controls");
            const panel = panelId ? document.getElementById(panelId) : null;
            if (panel) panel.hidden = !selected;
          });
          if (moveFocus) tab.focus();
        };
        tabs.forEach((tab, idx) => {
          tab.addEventListener("click", () => activate(tab, false));
          tab.addEventListener("keydown", (e) => {
            if (e.key === "ArrowRight") {
              e.preventDefault();
              activate(tabs[(idx + 1) % tabs.length], true);
            } else if (e.key === "ArrowLeft") {
              e.preventDefault();
              activate(tabs[(idx - 1 + tabs.length) % tabs.length], true);
            } else if (e.key === "Home") {
              e.preventDefault();
              activate(tabs[0], true);
            } else if (e.key === "End") {
              e.preventDefault();
              activate(tabs[tabs.length - 1], true);
            }
          });
        });
      }

      const form = document.querySelector("[data-wh-form]");
      if (form) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;
          const fd = new FormData(form);
          const project = String(fd.get("project") || "Kitchen or sliderobe enquiry");
          const town = String(fd.get("town") || "County Down");
          const appt = String(fd.get("appointment") || "Home measure visit");
          const subject = `${appt}: ${project} (${town})`;
          const body = [
            `Name: ${fd.get("name")}`,
            `Telephone: ${fd.get("phone")}`,
            `Project: ${project}`,
            `Town or postcode: ${town}`,
            `Appointment: ${appt}`,
            `Notes: ${fd.get("notes") || "None"}`,
          ].join("\n");
          const ev = new CustomEvent("mm:enquiry", {
            cancelable: true,
            detail: {
              to: "Woodhill Kitchens showroom (028 9756 2727)",
              subject,
              body,
              url: "tel:+442897562727",
            },
          });
          if (window.dispatchEvent(ev)) {
            window.location.href = "tel:+442897562727";
          }
        });
      }
    })();
  </script>
</ConceptLayout>
