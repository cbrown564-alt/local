---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

const phone = "028 4372 3080";
const phoneHref = "tel:+442843723080";
const site = "https://www.villavinci.co.uk/";
const menu =
  "http://villavinci.co.uk/wp-content/uploads/2024/06/DES01087_VILLA-VINCI-MENU-A3-MAR-24-SAMPLE.pdf";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Italiana&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap";

const week = [
  { d: "Mon", note: "Walk in" },
  { d: "Tue", note: "Walk in" },
  { d: "Wed", note: "Walk in" },
  { d: "Thu", note: "Walk in" },
  { d: "Fri", note: "Walk in" },
  { d: "Sat", note: "Walk in" },
  { d: "Sun", note: "Walk in" },
];
---

<ConceptLayout
  title={"Villa Vinci — Newcastle"}
  slug="villa-vinci"
  bodyClass="concept-page concept-villa"
  businessName="Villa Vinci"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The plate is a generated image of one dish, not a photograph from the kitchen."
>
  <main class="vv-page">
    <section class="vv-first" aria-labelledby="vv-name">
      <figure class="vv-hero">
        <img
          src="/media/concepts/villa-vinci/dish.jpg"
          alt="A steaming Mediterranean pasta and seafood plate"
          width="1536"
          height="1024"
        />
      </figure>
      <div class="vv-hero-copy">
        <p class="vv-open">31 Main Street, Newcastle, BT33 0AD</p>
        <h1 id="vv-name">Villa Vinci</h1>
        <p class="vv-today">
          Pop in for lunch, or ring for a table after a walk on the promenade.
          Hours live at <a href={site}>villavinci.co.uk</a> — or call
          <a href={phoneHref}>{phone}</a> before you set out.
        </p>
        <p class="vv-actions">
          <a class="vv-pill" href={menu}>The menu</a>
          <a href={site}>villavinci.co.uk</a>
          <a href={phoneHref}>{phone}</a>
        </p>
      </div>
    </section>

    <section class="vv-week" id="week" aria-labelledby="vv-week-title">
      <p class="vv-kicker">Walk in</p>
      <h2 id="vv-week-title">Lunch from the street. Dinner after the stroll.</h2>
      <p>
        Pop in for lunch on a day at the seaside, or reserve a table for dinner
        after an evening stroll — by stopping by, or calling. Ring first.
      </p>
      <ol class="vv-board">
        {week.map((row) => (
          <li>
            <span>{row.d}</span>
            <span>{row.note}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="vv-dish" aria-labelledby="vv-dish-title">
      <p class="vv-kicker">From the kitchen</p>
      <h2 id="vv-dish-title">Mediterranean origin. Local sourcing.</h2>
      <blockquote cite="https://www.villavinci.co.uk/about/">
        <p>
          Why not pop in for lunch on a day at the seaside or reserve a table
          for dinner after an evening stroll on along the promenade.
        </p>
      </blockquote>
    </section>

    <footer class="vv-foot">
      <p>
        Villa Vinci, 31 Main Street, Newcastle, BT33 0AD.
        Zio in Portadown and Al Forno in Newry are sister rooms — not this door.
      </p>
      <p>
        Today's board and the menu: <a href={site}>villavinci.co.uk</a>
      </p>
    </footer>
  </main>
</ConceptLayout>
