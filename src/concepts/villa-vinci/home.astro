---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

const phone = "028 4372 3080";
const phoneHref = "tel:+442843723080";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Italiana&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap";
---

<ConceptLayout
  title={"Villa Vinci — independent concept"}
  slug="villa-vinci"
  bodyClass="concept-page concept-villa"
  businessName="Villa Vinci Restaurante"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The Main Street plate is a drawn illustration, not a photograph of the frontage."
>
  <header class="vv-header">
    <a class="vv-brand" href="/concepts/villa-vinci/">
      <span class="vv-name">Villa Vinci</span>
      <span class="vv-sub">Restaurante · Newcastle</span>
    </a>
    <nav class="vv-nav">
      <a href="#place">The street</a>
      <a href="#ritual">The walk</a>
      <a href="#enquire">A table</a>
    </nav>
    <a class="vv-phone" href={phoneHref}>{phone}</a>
  </header>

  <main class="vv-main">
    <section class="vv-hero">
      <p class="vv-eyebrow">31 Main Street · BT33 0AD</p>
      <h1>Great food by the sea.</h1>
      <p class="vv-lead">
        A Mediterranean-origin table on Newcastle Main Street. Regulars and
        people who have come to the coast. Food sourced locally. Staff who
        have been here long enough to make you feel at home.
      </p>
      <p class="vv-cta">
        <a class="vv-btn" href="#enquire">Ask about a table</a>
        <a class="vv-quiet" href={phoneHref}>Call {phone}</a>
      </p>
    </section>

    <blockquote class="vv-voice">
      <p>
        “Why not pop in for lunch on a day at the seaside or reserve a table
        for dinner after an evening stroll on along the promenade.”
      </p>
      <footer>Villa Vinci · villavinci.co.uk/about</footer>
    </blockquote>

    <figure class="vv-plate">
      <svg viewBox="0 0 720 260" role="img" aria-label="Drawn plate of Main Street frontage facing the promenade and sea">
        <rect width="720" height="260" fill="#f3ebe0"/>
        <rect x="0" y="0" width="720" height="118" fill="#c9d8e6"/>
        <path d="M0 118 Q180 98 360 118 T720 108 L720 168 L0 168 Z" fill="#8eb4c8"/>
        <path d="M0 150 Q200 138 400 154 T720 146 L720 168 L0 168 Z" fill="#6d9bb0"/>
        <rect x="0" y="168" width="720" height="28" fill="#d8c9b0"/>
        <rect x="0" y="196" width="720" height="64" fill="#c4b49a"/>
        <rect x="86" y="86" width="132" height="110" fill="#8a4a3a"/>
        <rect x="102" y="108" width="28" height="36" fill="#e8d8c4"/>
        <rect x="174" y="108" width="28" height="36" fill="#e8d8c4"/>
        <rect x="138" y="156" width="28" height="40" fill="#3d2a22"/>
        <rect x="248" y="104" width="88" height="92" fill="#6e4a38"/>
        <rect x="262" y="118" width="22" height="28" fill="#e8d8c4"/>
        <rect x="300" y="118" width="22" height="28" fill="#e8d8c4"/>
        <rect x="368" y="96" width="70" height="100" fill="#7a5340"/>
        <polygon points="86,86 152,58 218,86" fill="#5a3228"/>
        <text x="152" y="78" text-anchor="middle" font-size="11" fill="#f3ebe0">Main St</text>
        <text x="520" y="88" text-anchor="middle" font-size="12" fill="#2c3d4a">promenade</text>
        <text x="620" y="142" text-anchor="middle" font-size="12" fill="#f3ebe0">sea</text>
      </svg>
      <figcaption>Drawn plate: Main Street looking toward the promenade and the sea.</figcaption>
    </figure>

    <section class="vv-place" id="place">
      <p class="vv-eyebrow">Where you are</p>
      <h2>Main Street. The promenade is the next step.</h2>
      <p>
        31 Main Street, Newcastle, BT33 0AD. If a map ever sends you to
        Portadown, stay on this street — that pin is a sister restaurant.
      </p>
    </section>

    <section class="vv-ritual" id="ritual">
      <p class="vv-eyebrow">The day they describe</p>
      <h2>Promenade first. Then lunch, or dinner after the stroll.</h2>
      <p>
        Pop in on a day at the seaside, or reserve after an evening walk.
        There is no diary on the site. You stop by, or you call.
      </p>
    </section>

    <section class="vv-family">
      <p class="vv-eyebrow">Sister tables — not this door</p>
      <h2>The family cooks in more than one town.</h2>
      <ul>
        <li>
          Zio · Millennium Court, William Street, Portadown · 028 3833 7696 ·
          <a href="https://ziorestaurant.com">ziorestaurant.com</a>
        </li>
        <li>
          Al Forno · 3 Francis Street, Newry · 028 3025 7687 ·
          <a href="https://alfornonewry.com">alfornonewry.com</a>
        </li>
      </ul>
      <p class="vv-note">Those streets belong to the sisters. This page is 31 Main Street.</p>
    </section>

    <form class="vv-form" id="enquire">
      <h2>Have the evening ready, then ring.</h2>
      <p>No rates, no diary here. Write what you need, then call {phone}.</p>
      <label>Your name <input id="vv-name" required autocomplete="name" /></label>
      <label>When you have in mind <input id="vv-when" placeholder="Saturday dinner after a walk" /></label>
      <label>Anything we should know <textarea id="vv-notes" rows="3"></textarea></label>
      <button class="vv-btn" type="submit">Show me what to say</button>
      <div class="vv-handoff" data-vv-handoff hidden>
        <strong>Ring {phone} and say:</strong>
        <pre data-vv-script></pre>
        <a class="vv-btn" href={phoneHref}>Call now</a>
      </div>
    </form>
  </main>
  <script is:inline>
    (function () {
      var form = document.getElementById("enquire");
      if (!form) return;
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        if (!form.reportValidity()) return;
        var name = document.getElementById("vv-name").value.trim();
        var when = document.getElementById("vv-when").value.trim();
        var notes = document.getElementById("vv-notes").value.trim();
        form.querySelector("[data-vv-script]").textContent = [
          "Hello, my name is " + name + ".",
          when ? "I would like a table " + when + "." : "I would like to ask about a table.",
          notes || ""
        ].filter(Boolean).join("\n");
        form.querySelector("[data-vv-handoff]").hidden = false;
      });
    })();
  </script>
</ConceptLayout>
