---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

const phone = "028 4372 3080";
const phoneHref = "tel:+442843723080";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Italiana&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap";

const beats = [
  {
    id: "street",
    n: "01",
    name: "The street",
    line: "31 Main Street, Newcastle. A prime frontage for regulars and people who have come to the coast. This door — not Portadown, not Newry.",
  },
  {
    id: "promenade",
    n: "02",
    name: "The promenade",
    line: "A day at the seaside, or an evening stroll. That walk is theirs. The table waits after the sea, not before it.",
  },
  {
    id: "reserve",
    n: "03",
    name: "The reserve",
    line: "Pop in for lunch, or reserve a table for dinner after the stroll. You stop by, or you call — after you have walked.",
  },
];
---

<ConceptLayout
  title={"Villa Vinci — independent concept"}
  slug="villa-vinci"
  bodyClass="concept-page concept-villa"
  businessName="Villa Vinci Restaurante"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The promenade plate is drawn."
>
  <header class="vv-header">
    <a class="vv-brand" href="/concepts/villa-vinci/">
      <span class="vv-brand-name">Villa Vinci</span>
      <span class="vv-brand-sub">Restaurante · 31 Main Street</span>
    </a>
    <nav class="vv-nav" aria-label="Concept navigation">
      <a href="#walk">The walk</a>
      <a href="#voice">Their words</a>
      <a href="#table">The table</a>
    </nav>
    <a class="vv-header-to" href="#table">Reserve after the stroll</a>
  </header>

  <main class="vv-main">
    <section class="vv-open" aria-labelledby="vv-headline">
      <p class="vv-kicker">Main Street · promenade · sea</p>
      <h1 id="vv-headline" class="vv-headline">
        <span>Promenade first.</span>
        <em>Then the table.</em>
      </h1>
      <p class="vv-open-line">
        A Mediterranean-origin restaurant on Newcastle’s Main Street. They
        source locally. Long-serving staff make you feel at home. The page is
        the walk: street, then promenade, then the reserve.
      </p>

      <figure class="vv-promenade">
        <svg viewBox="0 0 1440 420" role="img" aria-label="Drawn promenade: Main Street frontage, the walk, and the sea">
          <defs>
            <linearGradient id="vv-sky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#c9d8e6"/>
              <stop offset="1" stop-color="#9bb8c9"/>
            </linearGradient>
            <linearGradient id="vv-water" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#8eb4c8"/>
              <stop offset="1" stop-color="#4e7f96"/>
            </linearGradient>
          </defs>
          <rect width="1440" height="420" fill="url(#vv-sky)"/>
          <ellipse cx="1180" cy="78" rx="46" ry="46" fill="#f4e6c4" opacity="0.85"/>
          <path d="M0 168 Q220 148 440 166 T880 154 T1440 172 L1440 248 L0 248 Z" fill="#b7c9b4" opacity="0.45"/>
          <path d="M620 210 Q880 188 1440 198 L1440 318 L620 318 Z" fill="url(#vv-water)"/>
          <path d="M700 248 Q980 232 1440 246 L1440 318 L700 318 Z" fill="#3d6d82" opacity="0.55"/>
          <path d="M0 248 L620 248 L620 318 L0 318 Z" fill="#c9b89a"/>
          <path d="M0 318 L1440 318 L1440 420 L0 420 Z" fill="#b39f82"/>
          <path d="M0 248 L620 248" stroke="#8a7358" stroke-width="3"/>
          <path d="M620 248 L1440 246" stroke="#d8c9b0" stroke-width="2" opacity="0.7"/>

          <g>
            <rect x="48" y="148" width="118" height="100" fill="#7a4536"/>
            <polygon points="48,148 107,118 166,148" fill="#4e2c22"/>
            <rect x="64" y="168" width="22" height="28" fill="#ead9c4"/>
            <rect x="128" y="168" width="22" height="28" fill="#ead9c4"/>
            <rect x="94" y="204" width="26" height="44" fill="#2c1c16"/>
            <rect x="186" y="168" width="72" height="80" fill="#6a3f32"/>
            <rect x="200" y="182" width="18" height="22" fill="#ead9c4"/>
            <rect x="226" y="182" width="18" height="22" fill="#ead9c4"/>
            <rect x="278" y="156" width="88" height="92" fill="#8a4a3a"/>
            <polygon points="278,156 322,128 366,156" fill="#5a3228"/>
            <rect x="300" y="198" width="22" height="50" fill="#2c1c16"/>
            <rect x="386" y="176" width="64" height="72" fill="#6e4a38"/>
            <rect x="400" y="190" width="16" height="20" fill="#ead9c4"/>
            <rect x="470" y="164" width="78" height="84" fill="#7a5340"/>
            <rect x="494" y="200" width="20" height="48" fill="#2c1c16"/>
          </g>

          <g fill="#2c3d4a" font-family="Georgia, serif" font-size="15" letter-spacing="2">
            <text x="210" y="136">MAIN STREET</text>
            <text x="760" y="228">PROMENADE</text>
            <text x="1180" y="286" fill="#f6f0e8">SEA</text>
          </g>
          <path d="M210 248 L210 236 M760 248 L760 236 M1180 318 L1180 300" stroke="#2c3d4a" stroke-width="1.4"/>
        </svg>
        <figcaption>Drawn plate: Main Street frontage, the promenade, the sea.</figcaption>
      </figure>
    </section>

    <section class="vv-walk" id="walk" aria-labelledby="vv-walk-title">
      <header class="vv-walk-head">
        <p class="vv-kicker vv-kicker-ink">Three beats</p>
        <h2 id="vv-walk-title">How the day goes.</h2>
      </header>

      {beats.map((beat) => (
        <article class:list={["vv-beat", `vv-beat--${beat.id}`]} id={beat.id} aria-labelledby={`vv-beat-${beat.id}`}>
          <div class="vv-beat-art" aria-hidden="true">
            {beat.id === "street" && (
              <svg viewBox="0 0 1440 320" role="presentation">
                <rect width="1440" height="320" fill="#ebe2d4"/>
                <rect width="1440" height="168" fill="#c9d8e6"/>
                <rect y="210" width="1440" height="110" fill="#b39f82"/>
                <rect y="198" width="1440" height="16" fill="#c9b89a"/>
                <rect x="180" y="88" width="220" height="122" fill="#8a4a3a"/>
                <polygon points="180,88 290,48 400,88" fill="#5a3228"/>
                <rect x="230" y="150" width="36" height="60" fill="#2c1c16"/>
                <rect x="440" y="108" width="140" height="102" fill="#6e4a38"/>
                <rect x="620" y="96" width="160" height="114" fill="#7a5340"/>
                <rect x="840" y="120" width="110" height="90" fill="#6a3f32"/>
                <text x="290" y="78" text-anchor="middle" fill="#f6f0e8" font-size="18" font-family="Georgia, serif">31</text>
              </svg>
            )}
            {beat.id === "promenade" && (
              <svg viewBox="0 0 1440 320" role="presentation">
                <rect width="1440" height="320" fill="#9bb8c9"/>
                <rect y="0" width="1440" height="140" fill="#c9d8e6"/>
                <ellipse cx="1120" cy="70" rx="40" ry="40" fill="#f4e6c4" opacity="0.8"/>
                <path d="M0 150 Q360 128 720 150 T1440 140 L1440 220 L0 220 Z" fill="#8eb4c8"/>
                <path d="M0 188 Q400 170 800 192 T1440 180 L1440 250 L0 250 Z" fill="#4e7f96"/>
                <rect y="220" width="1440" height="36" fill="#d8c9b0"/>
                <rect y="256" width="1440" height="64" fill="#c4b49a"/>
                <circle cx="320" cy="248" r="8" fill="#5a3228"/>
                <circle cx="680" cy="246" r="8" fill="#5a3228"/>
                <circle cx="1040" cy="248" r="8" fill="#5a3228"/>
              </svg>
            )}
            {beat.id === "reserve" && (
              <svg viewBox="0 0 1440 320" role="presentation">
                <rect width="1440" height="320" fill="#2c1c16"/>
                <rect x="80" y="48" width="1280" height="224" fill="#3d2a22"/>
                <rect x="120" y="80" width="360" height="160" fill="#5a3228"/>
                <rect x="540" y="96" width="280" height="128" fill="#8a4a3a"/>
                <rect x="880" y="80" width="400" height="160" fill="#6e4a38"/>
                <ellipse cx="680" cy="210" rx="70" ry="18" fill="#ead9c4" opacity="0.35"/>
                <ellipse cx="300" cy="210" rx="70" ry="18" fill="#ead9c4" opacity="0.2"/>
                <ellipse cx="1080" cy="210" rx="70" ry="18" fill="#ead9c4" opacity="0.2"/>
              </svg>
            )}
          </div>
          <div class="vv-beat-copy">
            <span class="vv-beat-n">{beat.n}</span>
            <h3 id={`vv-beat-${beat.id}`}>{beat.name}</h3>
            <p>{beat.line}</p>
          </div>
        </article>
      ))}
    </section>

    <figure class="vv-voice" id="voice">
      <blockquote cite="https://www.villavinci.co.uk/about/">
        <p>
          “Why not pop in for lunch on a day at the seaside or reserve a table
          for dinner after an evening stroll on along the promenade.”
        </p>
      </blockquote>
      <figcaption>Villa Vinci · villavinci.co.uk/about — the hinge between the walk and the table.</figcaption>
    </figure>

    <section class="vv-table" id="table" aria-labelledby="vv-table-title">
      <p class="vv-kicker vv-kicker-ink">After the stroll</p>
      <h2 id="vv-table-title">Reserve after the stroll.</h2>
      <p class="vv-table-lede">
        There is no diary on this page and no inbox. Write what you need. We
        give you the words. Then you call {phone}.
      </p>
      <form class="vv-script" data-vv-enquire>
        <div class="vv-field">
          <label for="vv-name">Your name</label>
          <input id="vv-name" name="name" required autocomplete="name" />
        </div>
        <div class="vv-field">
          <label for="vv-when">When you have in mind</label>
          <input id="vv-when" name="when" placeholder="Saturday dinner after a walk" />
        </div>
        <div class="vv-field">
          <label for="vv-notes">Anything we should know</label>
          <textarea id="vv-notes" name="notes" rows="3"></textarea>
        </div>
        <button class="vv-submit" type="submit">Show me what to say</button>
        <div class="vv-handoff" data-vv-handoff role="status" hidden tabindex="-1">
          <strong>Ring {phone} and say:</strong>
          <pre data-vv-script></pre>
          <a class="vv-call" href={phoneHref}>Call {phone}</a>
        </div>
        <p class="vv-script-foot">Nothing is sent from this page. The script stays with you.</p>
      </form>
      <p class="vv-map-note">
        Villa Vinci Restaurante, 31 Main Street, Newcastle, BT33 0AD. If a pin
        sends you inland — Portadown, Newry — stay on 31 Main Street. That pin
        is a sister, not this door.
        Their site is live at
        <a href="https://www.villavinci.co.uk/">villavinci.co.uk</a>.
      </p>
    </section>

    <footer class="vv-sisters" aria-labelledby="vv-sisters-title">
      <p id="vv-sisters-title" class="vv-sisters-kicker">Sister rooms — not this door</p>
      <p class="vv-sisters-line">
        <span>Zio · Portadown · ziorestaurant.com</span>
        <span aria-hidden="true"> · </span>
        <span>Al Forno · Newry · alfornonewry.com</span>
      </p>
      <p class="vv-sisters-stay">This page is only 31 Main Street, Newcastle.</p>
    </footer>
  </main>

  <script is:inline>
    (function () {
      var form = document.querySelector("[data-vv-enquire]");
      if (!form) return;
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        if (!form.reportValidity()) return;
        var name = document.getElementById("vv-name").value.trim();
        var when = document.getElementById("vv-when").value.trim();
        var notes = document.getElementById("vv-notes").value.trim();
        form.querySelector("[data-vv-script]").textContent = [
          "Hello, my name is " + name + ".",
          when ? "I would like a table " + when + "." : "I would like to ask about a table.",
          notes || ""
        ].filter(Boolean).join("\n");
        var handoff = form.querySelector("[data-vv-handoff]");
        handoff.hidden = false;
        handoff.focus();
      });
    })();
  </script>
</ConceptLayout>
