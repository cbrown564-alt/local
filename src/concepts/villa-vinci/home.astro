---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

const phone = "028 4372 3080";
const phoneHref = "tel:+442843723080";
const site = "https://www.villavinci.co.uk/";
const menu =
  "http://villavinci.co.uk/wp-content/uploads/2024/06/DES01087_VILLA-VINCI-MENU-A3-MAR-24-SAMPLE.pdf";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Italiana&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap";

const week = [
  { d: "Mon", note: "Walk in — check their site or ring first" },
  { d: "Tue", note: "Walk in — check their site or ring first" },
  { d: "Wed", note: "Walk in — check their site or ring first" },
  { d: "Thu", note: "Walk in — check their site or ring first" },
  { d: "Fri", note: "Walk in — check their site or ring first" },
  { d: "Sat", note: "Walk in — check their site or ring first" },
  { d: "Sun", note: "Walk in — check their site or ring first" },
];
---

<ConceptLayout
  title={"Villa Vinci — Newcastle"}
  slug="villa-vinci"
  bodyClass="concept-page concept-villa"
  businessName="Villa Vinci"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The plate is a generated image of one dish, not a photograph from the kitchen."
>
  <main class="vv-page">
    <section class="vv-first" aria-labelledby="vv-name">
      <p class="vv-open">31 Main Street, Newcastle, BT33 0AD · this door only</p>
      <h1 id="vv-name">Villa Vinci</h1>
      <p class="vv-today">
        What's on today, and until when, lives on their board and on
        <a href={site}>villavinci.co.uk</a>. Hours are not listed on that site.
        Ring <a href={phoneHref}>{phone}</a> before you walk, or open their menu.
      </p>
      <p class="vv-actions">
        <a href={menu}>Menu (March 2024 sample on their site)</a>
        <a href={site}>Today's hours on villavinci.co.uk</a>
        <a href={phoneHref}>{phone}</a>
      </p>
    </section>

    <section class="vv-week" id="week" aria-labelledby="vv-week-title">
      <p class="vv-kicker">The week · walk in</p>
      <h2 id="vv-week-title">There is no reserve form here.</h2>
      <p>
        Their own words: pop in for lunch on a day at the seaside, or reserve
        after an evening stroll — by stopping by, or calling. This page does
        not take a booking. The week is walk-in until they tell you otherwise.
      </p>
      <ol class="vv-board">
        {week.map((row) => (
          <li>
            <span>{row.d}</span>
            <span>{row.note}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="vv-dish" aria-labelledby="vv-dish-title">
      <p class="vv-kicker">One dish</p>
      <h2 id="vv-dish-title">Mediterranean origin. Local sourcing.</h2>
      <figure>
        <img
          src="/media/concepts/villa-vinci/dish.jpg"
          alt="A steaming Mediterranean pasta and seafood plate"
          width="1536"
          height="1024"
        />
        <figcaption>One dish, steaming.</figcaption>
      </figure>
      <blockquote cite="https://www.villavinci.co.uk/about/">
        <p>
          Why not pop in for lunch on a day at the seaside or reserve a table
          for dinner after an evening stroll on along the promenade.
        </p>
      </blockquote>
    </section>

    <footer class="vv-foot">
      <p>
        Villa Vinci, 31 Main Street, Newcastle, BT33 0AD.
        Zio in Portadown and Al Forno in Newry are sister rooms — not this door.
      </p>
      <p>
        Today's board, the live menu and whether they are open:
        <a href={site}>villavinci.co.uk</a>
      </p>
    </footer>
  </main>
</ConceptLayout>
