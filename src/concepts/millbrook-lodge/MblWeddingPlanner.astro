---
/* Millbrook Lodge Hotel — Interactive Rectory, Dining, and Weddings Stage.
   Preserves verified 16 bedrooms, The Gilmore Restaurant, conservatory Afternoon Tea,
   and one-wedding-per-day exclusivity on a deep rectory-forest contrast stage. */
const phone = "028 9756 2828";
const phoneHref = "tel:+442897562828";
const bookHref = "https://book.millbrooklodge.co.uk/";
const voucherHref = "https://millbrook-lodge.host.netaffinity.io/ovs/MILLBROOOVS03#!/voucher/search";

const experiences = [
  {
    id: "bedrooms",
    label: "Sixteen bedrooms",
    heading: "Individually styled Master, Classic, and Rectory rooms",
    copy: "Sixteen en-suite bedrooms inside the former 1800s Georgian rectory, surrounded by mature County Down beech trees and quiet private lawns.",
    details: [
      { term: "Reception", value: "24-hour hotel desk in Ballynahinch" },
      { term: "Arrival and departure", value: "Check-in from 15:00, check-out by 11:00" },
      { term: "Direct bookings", value: "Live hotel room rates via the booking desk" },
    ],
    ctaLabel: "Check room rates",
    ctaHref: bookHref,
    external: true,
  },
  {
    id: "dining",
    label: "The Gilmore restaurant",
    heading: "Breakfast, Sunday carvery, and seasonal evening dining",
    copy: "Dine beside the gardens for hearty breakfasts, weekday lunches, early bird suppers, Sunday carvery, and seasonal County Down evening menus.",
    details: [
      { term: "Dining rooms", value: "The Gilmore Restaurant and sunlit conservatory" },
      { term: "Table sittings", value: "Breakfast, lunch, Sunday carvery, evening dinner" },
      { term: "Gift vouchers", value: "Instant dining and overnight vouchers online" },
    ],
    ctaLabel: "Order gift vouchers",
    ctaHref: voucherHref,
    external: true,
  },
  {
    id: "weddings",
    label: "Afternoon tea and weddings",
    heading: "One wedding per day across the house, Orangerie, and gardens",
    copy: "Exclusive single-wedding hospitality for up to 300 guests, alongside three-tier conservatory afternoon tea with homemade buttermilk scones, finger sandwiches, and County Down traybakes.",
    details: [
      { term: "Exclusivity", value: "One wedding per day, civil ceremony licensed" },
      { term: "Reception suites", value: "The Orangerie, Courtyard and Garden Suites" },
      { term: "Capacity and grounds", value: "Up to 300 guests, Wedding Garden, Bridal Suite" },
    ],
    ctaLabel: "Arrange a private viewing",
    ctaHref: "#enquire",
    external: false,
  },
];
---

<section class="mbl-section mbl-stage" id="estate" aria-labelledby="mbl-stage-title">
  <div class="mbl-wrap mbl-stage-grid">
    <div class="mbl-stage-copy" data-mbl-tabs>
      <h2 id="mbl-stage-title">Rectory, dining, and weddings at Millbrook.</h2>

      <div class="mbl-tabs" role="tablist" aria-label="Explore Millbrook Lodge">
        {experiences.map((item, idx) => (
          <button
            type="button"
            role="tab"
            id={`mbl-tab-${item.id}`}
            aria-controls={`mbl-panel-${item.id}`}
            aria-selected={idx === 0 ? "true" : "false"}
            tabindex={idx === 0 ? "0" : "-1"}
            class:list={["mbl-tab", idx === 0 && "is-active"]}
            data-mbl-tab={item.id}
          >
            {item.label}
          </button>
        ))}
      </div>

      {experiences.map((item, idx) => (
        <div
          class="mbl-panel"
          role="tabpanel"
          id={`mbl-panel-${item.id}`}
          aria-labelledby={`mbl-tab-${item.id}`}
          data-mbl-panel={item.id}
          hidden={idx !== 0}
        >
          <h3>{item.heading}</h3>
          <p>{item.copy}</p>
          <dl class="mbl-ledger">
            {item.details.map((row) => (
              <div class="mbl-ledger-row">
                <dt>{row.term}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>
          <a
            class="mbl-btn mbl-btn--light"
            href={item.ctaHref}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
          >
            {item.ctaLabel}
          </a>
        </div>
      ))}
    </div>

    <div class="mbl-stage-media">
      <figure class="mbl-plate">
        <picture>
          <source
            srcset="/media/concepts/millbrook-lodge/millbrook-afternoon-tea-640.webp 640w, /media/concepts/millbrook-lodge/millbrook-afternoon-tea-1265.webp 1265w"
            sizes="(max-width: 900px) 100vw, 46vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/millbrook-lodge/millbrook-afternoon-tea.jpg"
            alt="Three-tier porcelain afternoon tea stand with finger sandwiches, homemade buttermilk scones, and pastries in a sunlit conservatory"
            width="1408"
            height="768"
            loading="lazy"
          />
        </picture>
        <figcaption>Conservatory afternoon tea at Millbrook Lodge. Indicative visualisation.</figcaption>
      </figure>

      <div class="mbl-stage-aside">
        <a href={voucherHref} target="_blank" rel="noopener noreferrer">Order dining and stay gift vouchers</a>
        <a href={phoneHref}>24-hour reception: {phone}</a>
      </div>
    </div>
  </div>
</section>
