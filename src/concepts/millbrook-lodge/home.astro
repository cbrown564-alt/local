---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import MblWeddingPlanner from "./MblWeddingPlanner.astro";
import "./styles.css";

/* Millbrook Lodge Hotel — 5 Drumaness Road, Ballynahinch BT24 8LS.
   Verified live 26 Nov 2026: apex https://millbrooklodge.co.uk/ fails TLS (ERR_TLS_CERT_ALTNAME_INVALID).
   16 Georgian rectory bedrooms, one-wedding-per-day venue, The Gilmore Restaurant, Afternoon Tea,
   028 9756 2828, enquiries@millbrooklodge.co.uk, live book.millbrooklodge.co.uk & NetAffinity vouchers. */
const phone = "028 9756 2828";
const phoneHref = "tel:+442897562828";
const email = "enquiries@millbrooklodge.co.uk";
const bookHref = "https://book.millbrooklodge.co.uk/";
const voucherHref = "https://millbrook-lodge.host.netaffinity.io/ovs/MILLBROOOVS03#!/voucher/search";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Millbrook+Lodge+Hotel+5+Drumaness+Road+Ballynahinch+BT24+8LS";
---

<ConceptLayout
  title="Millbrook Lodge Hotel — Georgian Country House, Ballynahinch"
  slug="millbrook-lodge"
  bodyClass="concept-page concept-millbrook"
  businessName="Millbrook Lodge Hotel"
  town="Ballynahinch"
  bannerNote="Imagery comprises indicative Georgian country house garden and afternoon tea visualisations."
>
  <header class="mbl-header">
    <div class="mbl-header-inner">
      <a class="mbl-brand" href="#top">
        <strong>Millbrook Lodge</strong>
        <span>Georgian Country Hotel · Ballynahinch</span>
      </a>
      <nav class="mbl-nav" aria-label="Primary">
        <a href="#spaces">Weddings &amp; Rooms</a>
        <a href="#dining">The Gilmore</a>
        <a href="#enquire">Date Enquiry</a>
        <a href="#location">Find Us</a>
      </nav>
      <div class="mbl-header-actions">
        <a class="mbl-header-tel" href={phoneHref}>{phone}</a>
        <a class="mbl-header-cta" href={bookHref} target="_blank" rel="noopener noreferrer">Book Rooms</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="mbl-hero" aria-labelledby="mbl-hero-title">
      <div class="mbl-wrap">
        <div class="mbl-hero-head">
          <p class="mbl-eyebrow">5 Drumaness Road · Ballynahinch · County Down</p>
          <h1 id="mbl-hero-title">An 1800s Georgian rectory in private gardens.</h1>
          <p class="mbl-hero-lead">
            Sixteen individually styled bedrooms, one-wedding-per-day exclusivity, conservatory Afternoon Tea
            and seasonal dining in The Gilmore Restaurant.
          </p>
          <div class="mbl-hero-actions">
            <a class="mbl-btn mbl-btn--primary" href={bookHref} target="_blank" rel="noopener noreferrer">Check Room Rates ↗</a>
            <a class="mbl-link-cta" href={voucherHref} target="_blank" rel="noopener noreferrer">Order Gift Vouchers ↗</a>
          </div>
        </div>

        <figure class="mbl-hero-media">
          <picture>
            <source srcset="/media/concepts/millbrook-lodge/millbrook-georgian-gardens-640.webp 640w, /media/concepts/millbrook-lodge/millbrook-georgian-gardens-1265.webp 1265w" sizes="(max-width: 960px) 100vw, 90vw" type="image/webp" />
            <img src="/media/concepts/millbrook-lodge/millbrook-georgian-gardens.jpg" alt="1800s Georgian country house hotel surrounded by manicured gardens and mature beech trees at dusk" width="1408" height="768" loading="eager" />
          </picture>
          <figcaption class="mbl-hero-cap">Indicative Georgian house and gardens visualisation.</figcaption>
        </figure>
      </div>
    </section>

    <MblWeddingPlanner />

    <section class="mbl-section mbl-dining" id="dining" aria-labelledby="mbl-dining-title">
      <div class="mbl-wrap mbl-split">
        <figure class="mbl-plate">
          <picture>
            <source srcset="/media/concepts/millbrook-lodge/millbrook-afternoon-tea-640.webp 640w, /media/concepts/millbrook-lodge/millbrook-afternoon-tea-1265.webp 1265w" sizes="(max-width: 860px) 100vw, 48vw" type="image/webp" />
            <img src="/media/concepts/millbrook-lodge/millbrook-afternoon-tea.jpg" alt="Three-tier porcelain afternoon tea stand with sandwiches, scones and pastries in a sunlit conservatory" width="1408" height="768" loading="lazy" />
          </picture>
          <figcaption>Conservatory Afternoon Tea at Millbrook Lodge. Indicative visualisation.</figcaption>
        </figure>
        <div>
          <p class="mbl-kicker">The Gilmore Restaurant &amp; Conservatory</p>
          <h2 id="mbl-dining-title">Sunday carvery, evening suppers and signature Afternoon Tea.</h2>
          <p>
            Dine beside the gardens for breakfast, lunch, Sunday carvery or evening dinner, or gather in the
            conservatory for homemade buttermilk scones, finger sandwiches and County Down traybakes.
          </p>
          <div class="mbl-inline-ctas">
            <a class="mbl-btn mbl-btn--primary" href={voucherHref} target="_blank" rel="noopener noreferrer">Dining &amp; Stay Vouchers ↗</a>
            <a class="mbl-btn mbl-btn--outline" href={phoneHref}>Call Reception · {phone}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="mbl-section mbl-enquire" id="enquire" aria-labelledby="mbl-enq-title">
      <div class="mbl-wrap mbl-split">
        <div>
          <p class="mbl-kicker">Weddings, Private Showrounds &amp; Events</p>
          <h2 id="mbl-enq-title">Arrange a private viewing of the house and Wedding Garden.</h2>
          <p>
            Share your preferred season, approximate guest numbers and whether you are considering a civil
            ceremony or reception. Our wedding coordinator will reply directly from Ballynahinch.
          </p>
          <p class="mbl-contact-line">
            24-hour hotel desk: <a href={phoneHref}>{phone}</a> · <a href={`mailto:${email}`}>{email}</a>
          </p>
        </div>
        <form class="mbl-form" data-mbl-form>
          <div class="mbl-row">
            <label>
              <span>Your names</span>
              <input name="name" type="text" required autocomplete="name" placeholder="Full name(s)" />
            </label>
            <label>
              <span>Telephone</span>
              <input name="phone" type="tel" required autocomplete="tel" placeholder="028 / 07..." />
            </label>
          </div>
          <div class="mbl-row">
            <label>
              <span>Target date</span>
              <input name="date" type="date" required />
            </label>
            <label>
              <span>Approximate guests</span>
              <input name="guests" type="number" min="10" max="350" value="120" required />
            </label>
          </div>
          <label>
            <span>Enquiry type</span>
            <select name="eventType">
              <option value="Wedding Showround & Date Check">Wedding Showround &amp; Date Check</option>
              <option value="Afternoon Tea / Sunday Carvery">Afternoon Tea or Sunday Carvery Table</option>
              <option value="Family Celebration / Private Dining">Family Celebration or Private Dining</option>
              <option value="Group Room Allocation">Group Room Allocation</option>
            </select>
          </label>
          <label>
            <span>Notes</span>
            <textarea name="notes" rows="3" placeholder="Outdoor Wedding Garden ceremony, Orangerie reception, or preferred viewing time..."></textarea>
          </label>
          <button class="mbl-btn mbl-btn--primary" type="submit">Send Estate Enquiry</button>
        </form>
      </div>
    </section>

    <section class="mbl-section mbl-map-band" id="location" aria-label="Ballynahinch estate map">
      <div class="mbl-wrap">
        <LocalAreaMap
          id="mbl-map"
          kicker="Ballynahinch & Mid-Down"
          businessName="Millbrook Lodge Hotel"
          address="5 Drumaness Road, Ballynahinch, BT24 8LS"
          lon={-5.8852198}
          lat={54.3911061}
          spanKm={18}
          mapHref={mapsHref}
          markers={[
            { name: "Saintfield", lon: -5.8338, lat: 54.4581, note: "10 mins north", side: "t" },
            { name: "Downpatrick", lon: -5.7168, lat: 54.3286, note: "16 mins south-east", side: "r" },
            { name: "Castlewellan", lon: -5.9442, lat: 54.2596, note: "15 mins south", side: "b" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="mbl-footer">
    <div class="mbl-wrap mbl-footer-inner">
      <div>
        <strong>Millbrook Lodge Hotel</strong>
        <p>5 Drumaness Road, Ballynahinch, Co. Down, BT24 8LS</p>
      </div>
      <div class="mbl-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={bookHref} target="_blank" rel="noopener noreferrer">Rooms ↗</a>
        <a href={voucherHref} target="_blank" rel="noopener noreferrer">Vouchers ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const form = document.querySelector("[data-mbl-form]");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        const subject = `Millbrook Lodge Enquiry — ${fd.get("eventType")} (${fd.get("date")})`;
        const body = [
          `Name: ${fd.get("name")}`,
          `Phone: ${fd.get("phone")}`,
          `Target date: ${fd.get("date")}`,
          `Guests: ${fd.get("guests")}`,
          `Type: ${fd.get("eventType")}`,
          `Notes: ${fd.get("notes") || "None"}`,
        ].join("\n");
        const ev = new CustomEvent("mm:enquiry", {
          cancelable: true,
          detail: { to: "enquiries@millbrooklodge.co.uk", subject, body, phone: "028 9756 2828", phoneHref: "tel:+442897562828" },
        });
        if (window.dispatchEvent(ev)) {
          window.location.href = `mailto:enquiries@millbrooklodge.co.uk?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }
      });
    })();
  </script>
</ConceptLayout>
