---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import MblWeddingPlanner from "./MblWeddingPlanner.astro";
import "./styles.css";

/* Millbrook Lodge Hotel — 5 Drumaness Road, Ballynahinch BT24 8LS.
   Verified live 26 Nov 2026: apex https://millbrooklodge.co.uk/ fails TLS (ERR_TLS_CERT_ALTNAME_INVALID).
   16 Georgian rectory bedrooms, one-wedding-per-day venue, The Gilmore Restaurant, Afternoon Tea,
   028 9756 2828, enquiries@millbrooklodge.co.uk, live book.millbrooklodge.co.uk & NetAffinity vouchers. */
const phone = "028 9756 2828";
const phoneHref = "tel:+442897562828";
const email = "enquiries@millbrooklodge.co.uk";
const bookHref = "https://book.millbrooklodge.co.uk/";
const voucherHref = "https://millbrook-lodge.host.netaffinity.io/ovs/MILLBROOOVS03#!/voucher/search";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Millbrook+Lodge+Hotel+5+Drumaness+Road+Ballynahinch+BT24+8LS";
---

<ConceptLayout
  title="Millbrook Lodge Hotel, Georgian Country House in Ballynahinch"
  slug="millbrook-lodge"
  bodyClass="concept-page concept-millbrook"
  businessName="Millbrook Lodge Hotel"
  town="Ballynahinch"
  bannerNote="Imagery comprises indicative Georgian country house garden and afternoon tea visualisations."
>
  <header class="mbl-header" data-mbl-header>
    <div class="mbl-header-inner">
      <a class="mbl-brand" href="#top">Millbrook Lodge</a>
      <nav class="mbl-nav" aria-label="Primary">
        <a href="#estate" data-mbl-jump="bedrooms">Bedrooms</a>
        <a href="#estate" data-mbl-jump="dining">The Gilmore</a>
        <a href="#estate" data-mbl-jump="weddings">Weddings</a>
        <a href="#enquire">Enquire</a>
        <a href="#location">Find us</a>
      </nav>
      <div class="mbl-header-actions">
        <a class="mbl-header-tel" href={phoneHref}>{phone}</a>
        <a class="mbl-header-cta" href={bookHref} target="_blank" rel="noopener noreferrer">Book rooms</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="mbl-hero" aria-labelledby="mbl-hero-title">
      <div class="mbl-hero-sentinel" data-mbl-sentinel aria-hidden="true"></div>
      <div class="mbl-hero-media">
        <picture>
          <source
            srcset="/media/concepts/millbrook-lodge/millbrook-georgian-gardens-640.webp 640w, /media/concepts/millbrook-lodge/millbrook-georgian-gardens-1265.webp 1265w"
            sizes="100vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/millbrook-lodge/millbrook-georgian-gardens.jpg"
            alt="1800s Georgian country house hotel surrounded by manicured gardens and mature beech trees in warm afternoon light"
            width="1408"
            height="768"
            loading="eager"
          />
        </picture>
      </div>

      <div class="mbl-wrap mbl-hero-inner">
        <div class="mbl-hero-copy">
          <h1 id="mbl-hero-title">An 1800s Georgian rectory in private gardens.</h1>
          <p class="mbl-hero-lead">
            Sixteen bedrooms, seasonal dining in The Gilmore Restaurant, conservatory afternoon tea, and one wedding per day in Ballynahinch.
          </p>
          <a class="mbl-btn mbl-btn--hero" href={bookHref} target="_blank" rel="noopener noreferrer">
            Check room rates
          </a>
        </div>

        <div class="mbl-hero-foot">
          <p class="mbl-hero-caption">Indicative Georgian house and gardens visualisation.</p>
        </div>
      </div>
    </section>

    <MblWeddingPlanner />

    <section class="mbl-section mbl-enquire" id="enquire" aria-labelledby="mbl-enq-title">
      <div class="mbl-wrap mbl-split">
        <div class="mbl-enquire-intro">
          <h2 id="mbl-enq-title">Arrange a private viewing of the house and Wedding Garden.</h2>
          <p>
            Share your preferred season, approximate guest numbers, and whether you are considering a civil
            ceremony, reception, or private dining. Our coordinator replies directly from Ballynahinch.
          </p>
          <dl class="mbl-contact-ledger">
            <div class="mbl-contact-row">
              <dt>Address</dt>
              <dd>5 Drumaness Road, Ballynahinch, BT24 8LS</dd>
            </div>
            <div class="mbl-contact-row">
              <dt>24-hour hotel desk</dt>
              <dd><a href={phoneHref}>{phone}</a></dd>
            </div>
            <div class="mbl-contact-row">
              <dt>Email</dt>
              <dd><a href={`mailto:${email}`}>{email}</a></dd>
            </div>
            <div class="mbl-contact-row">
              <dt>Gift vouchers</dt>
              <dd><a href={voucherHref} target="_blank" rel="noopener noreferrer">Order dining and stay vouchers online</a></dd>
            </div>
          </dl>
        </div>

        <form class="mbl-form" data-mbl-form>
          <div class="mbl-row">
            <label>
              <span>Your names</span>
              <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
            </label>
            <label>
              <span>Telephone</span>
              <input name="phone" type="tel" required autocomplete="tel" placeholder="028 or 07 number" />
            </label>
          </div>
          <div class="mbl-row">
            <label>
              <span>Target date</span>
              <input name="date" type="date" required />
            </label>
            <label>
              <span>Approximate guests</span>
              <input name="guests" type="number" min="10" max="350" value="120" required />
            </label>
          </div>
          <label>
            <span>Enquiry type</span>
            <select name="eventType">
              <option value="Wedding showround and date check">Wedding showround and date check</option>
              <option value="Afternoon tea or Sunday carvery table">Afternoon tea or Sunday carvery table</option>
              <option value="Family celebration or private dining">Family celebration or private dining</option>
              <option value="Group room allocation">Group room allocation</option>
            </select>
          </label>
          <label>
            <span>Notes</span>
            <textarea name="notes" rows="3" placeholder="Outdoor Wedding Garden ceremony, Orangerie reception, or preferred viewing time"></textarea>
          </label>
          <button class="mbl-btn mbl-btn--primary" type="submit">Send estate enquiry</button>
        </form>
      </div>
    </section>

    <section class="mbl-section mbl-map-band" id="location" aria-label="Ballynahinch estate map">
      <div class="mbl-wrap">
        <LocalAreaMap
          id="mbl-map"
          kicker=""
          businessName="Millbrook Lodge"
          address="5 Drumaness Road, Ballynahinch, BT24 8LS"
          lon={-5.8852198}
          lat={54.3911061}
          spanKm={18}
          mapHref={mapsHref}
          markers={[
            { name: "Saintfield", lon: -5.8338, lat: 54.4581, note: "10 mins north", side: "t" },
            { name: "Downpatrick", lon: -5.7168, lat: 54.3286, note: "16 mins south-east", side: "r" },
            { name: "Castlewellan", lon: -5.9442, lat: 54.2596, note: "15 mins south", side: "b" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="mbl-footer">
    <div class="mbl-wrap mbl-footer-inner">
      <div>
        <strong>Millbrook Lodge Hotel</strong>
        <p>5 Drumaness Road, Ballynahinch, Co. Down, BT24 8LS</p>
      </div>
      <div class="mbl-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={bookHref} target="_blank" rel="noopener noreferrer">Book rooms</a>
        <a href={voucherHref} target="_blank" rel="noopener noreferrer">Gift vouchers</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-mbl-header]");
      const sentinel = document.querySelector("[data-mbl-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            header.classList.toggle("is-scrolled", !entries[0].isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      const tabRoot = document.querySelector("[data-mbl-tabs]");
      if (tabRoot) {
        const tabs = [...tabRoot.querySelectorAll("[data-mbl-tab]")];
        const panels = [...tabRoot.querySelectorAll("[data-mbl-panel]")];
        const activate = (id, focusTab = false) => {
          tabs.forEach((t) => {
            const active = t.getAttribute("data-mbl-tab") === id;
            t.classList.toggle("is-active", active);
            t.setAttribute("aria-selected", active ? "true" : "false");
            t.setAttribute("tabindex", active ? "0" : "-1");
            if (active && focusTab) t.focus();
          });
          panels.forEach((p) => {
            p.hidden = p.getAttribute("data-mbl-panel") !== id;
          });
        };

        tabs.forEach((btn, idx) => {
          btn.addEventListener("click", () => activate(btn.getAttribute("data-mbl-tab")));
          btn.addEventListener("keydown", (e) => {
            if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
              e.preventDefault();
              const next = (idx + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
              activate(tabs[next].getAttribute("data-mbl-tab"), true);
            } else if (e.key === "Home") {
              e.preventDefault();
              activate(tabs[0].getAttribute("data-mbl-tab"), true);
            } else if (e.key === "End") {
              e.preventDefault();
              activate(tabs[tabs.length - 1].getAttribute("data-mbl-tab"), true);
            }
          });
        });

        document.querySelectorAll("[data-mbl-jump]").forEach((link) => {
          link.addEventListener("click", () => {
            const targetId = link.getAttribute("data-mbl-jump");
            if (targetId) activate(targetId);
          });
        });
      }

      const form = document.querySelector("[data-mbl-form]");
      if (form) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;
          const fd = new FormData(form);
          const subject = `Millbrook Lodge enquiry: ${fd.get("eventType")} (${fd.get("date")})`;
          const body = [
            `Name: ${fd.get("name")}`,
            `Phone: ${fd.get("phone")}`,
            `Target date: ${fd.get("date")}`,
            `Guests: ${fd.get("guests")}`,
            `Type: ${fd.get("eventType")}`,
            `Notes: ${fd.get("notes") || "None"}`,
          ].join("\n");
          const ev = new CustomEvent("mm:enquiry", {
            cancelable: true,
            detail: {
              to: "enquiries@millbrooklodge.co.uk",
              subject,
              body,
              phone: "028 9756 2828",
              phoneHref: "tel:+442897562828",
            },
          });
          if (window.dispatchEvent(ev)) {
            window.location.href = `mailto:enquiries@millbrooklodge.co.uk?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
          }
        });
      }
    })();
  </script>
</ConceptLayout>
