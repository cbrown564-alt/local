---
import {
  publicTransformationSlugs,
  transformationCandidates,
  transformations,
} from "../../site/data/transformations";
import { OG_IMAGE_SIZE, ogImages, transformationOgImage } from "../../site/data/og-images";
import { siteDetails } from "../../site/data/site";
import "./concept-shell.css";

interface Props {
  title: string;
  slug: string;
  bodyClass: string;
  lang?: string;
  fontHref?: string;
  bannerNote?: string;
  /** A concept with its own house mark can seal the browser tab with it;
      everything else keeps the studio favicon. */
  favicon?: string;
  /** Concepts are now built before their case study exists, so the banner and
      claim link can no longer rely on a published transformation record. */
  businessName?: string;
  town?: string;
}

const conceptFonts: Record<string, string> = {
  "bucks-head": "https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600&family=Lora:ital,wght@0,400;1,400;1,500&display=swap",
  "castle-farm": "https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;700&display=swap",
  "cupla": "https://fonts.googleapis.com/css2?family=Vollkorn:ital,wght@0,500;0,600;1,500;1,600&family=Mulish:wght@400;700&display=swap",
  "donard-veterinary": "https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500&family=Karla:wght@400;700&display=swap",
  "hotel-enniskeen": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Atkinson+Hyperlegible+Next:wght@400;700&display=swap",
  "kent-amusements": "https://fonts.googleapis.com/css2?family=Teko:wght@500;600;700&family=Outfit:wght@400;500;600;700&display=swap",
  "mourne-cycles": "https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;1,600;1,700&family=Barlow:wght@400;600;700&display=swap",
  "newcastle-chamber": "https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,500;0,600;0,700;1,500;1,600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap",
  "scopers": "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;600;700&family=Work+Sans:wght@400;500;600&display=swap",
  "tool-centre": "https://fonts.googleapis.com/css2?family=Chivo:wght@500;700;900&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap",
  // Batch two. No face is reused from batch one, so no two concepts share a voice.
  "dundrum-inn": "https://fonts.googleapis.com/css2?family=Petrona:ital,wght@0,400;0,500;0,600;1,400&family=Hanken+Grotesk:wght@400;500;600;700&display=swap",
  "murdock-brothers": "https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,500;75..125,700;75..125,900&family=DM+Mono:wght@400;500&display=swap",
  "kelly-mcevoy-brown": "https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@500;600;700&family=Martian+Mono:wght@400;600&display=swap",
  "bettys-butters": "https://fonts.googleapis.com/css2?family=Rozha+One&family=Epilogue:ital,wght@0,400;0,600;0,700;1,400&display=swap",
  "douglas-cromie": "https://fonts.googleapis.com/css2?family=Hind:wght@400;500;600;700&display=swap",
  "donard-hotel": "https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap",
  "newcastle-dental": "https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;800&family=Instrument+Serif:ital@0;1&display=swap",
  "hugh-mccanns": "https://fonts.googleapis.com/css2?family=Italiana&family=Lato:ital,wght@0,300;0,400;0,700;1,400&display=swap",
};

const {
  title,
  slug,
  bodyClass,
  lang = "en-GB",
  fontHref = conceptFonts[slug],
  bannerNote,
  favicon = "/favicon.svg",
  businessName: businessNameProp,
  town: townProp,
} = Astro.props;
const transformation = transformations.find((item) => item.slug === slug);
const candidate = transformationCandidates.find((item) => item.slug === slug);
const businessName =
  businessNameProp ?? transformation?.name ?? candidate?.name ?? slug;
const town = townProp ?? transformation?.town ?? candidate?.town ?? "";
const caseStudy = `/transformations/${slug}/`;
const claimUrl = `/request/?business=${encodeURIComponent(businessName)}&town=${encodeURIComponent(town)}&source=concept`;

/**
 * A concept link is shared far more often than it is searched for — it goes
 * into a message to an owner, or into a group chat — and this layout emitted no
 * Open Graph tags at all, so it previewed as a bare URL.
 *
 * The card is the slug's own before-and-after, which is the right image for the
 * job twice over: it shows the change rather than describing it, and its footer
 * already reads "Independent concept study", so the disclosure survives into a
 * preview that has no room for the banner. `noindex` is unaffected — it governs
 * search listings, not link unfurling.
 *
 * Gated on the published-slug list rather than on candidate data, because that
 * is exactly the set `tools/check/check-og-assets.mjs` guarantees a card file
 * for; a concept without one falls back to the studio card instead of naming an
 * image that would 404 in a scraper.
 */
/**
 * Concepts whose own surface publishes no raster imagery cannot advertise a
 * raster share card either. Painted Earth's pages are drawn throughout because
 * the maker's photography is not licensed, and the before panel of a share card
 * is a screenshot of their live shop — a grid of their own product photographs.
 * Publishing that as the preview image for a page that carries none would route
 * around the licensing rule rather than honour it, so these concepts get a
 * text-only preview. Kept as a set here rather than a per-page prop so a new
 * route cannot quietly omit it; `tools/test/test-painted-earth-elevation.mjs`
 * fails the build if a raster reference reaches any of those pages.
 */
const noRasterConcepts = new Set(["painted-earth"]);
const hasOwnCard =
  !noRasterConcepts.has(slug) && new Set<string>(publicTransformationSlugs).has(slug);
const ogImage = noRasterConcepts.has(slug)
  ? null
  : hasOwnCard
    ? transformationOgImage(slug)
    : ogImages.studio;
const description = `Independent, uncommissioned website concept for ${businessName}, clearly labelled and linked to its source-backed case study.`;
/* Phrased without a possessive: trading names ending in s ("Scopers") and in an
   accent ("Cúpla") both read badly with one bolted on. */
const ogImageAlt = hasOwnCard
  ? `Before-and-after share card: the current website for ${businessName} beside the independent Mourne Made concept.`
  : `Mourne Made — free before-and-after concepts for independent businesses around Dundrum and Newcastle.`;
const publicOrigin = Astro.site ?? Astro.url;
const ogUrl = new URL(Astro.url.pathname, publicOrigin).href;
const ogImageUrl = ogImage ? new URL(ogImage, publicOrigin).href : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content={siteDetails.name} />
    <meta property="og:locale" content="en_GB" />
    {ogImageUrl && (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content={String(OG_IMAGE_SIZE.width)} />
        <meta property="og:image:height" content={String(OG_IMAGE_SIZE.height)} />
        <meta property="og:image:alt" content={ogImageAlt} />
      </>
    )}
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && (
      <>
        <meta name="twitter:image" content={ogImageUrl} />
        <meta name="twitter:image:alt" content={ogImageAlt} />
      </>
    )}
    <link rel="icon" href={favicon} type="image/svg+xml" />
    {fontHref && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href={fontHref} rel="stylesheet" />
      </>
    )}
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <aside class="mm-concept-banner" aria-label="About this independent concept">
      <span><strong>Independent concept by Mourne Made.</strong> Not the live {businessName} website. {bannerNote}</span>
      <nav aria-label="Concept actions">
        {transformation && <a href={caseStudy}>See the case study</a>}
        <a class="mm-concept-claim" href={claimUrl}>Is this your business? Claim this concept →</a>
        <button class="mm-concept-back" type="button" data-concept-back>← Back</button>
      </nav>
    </aside>
    <slot />
  </body>
</html>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-concept-placeholder]').forEach((link) => {
    link.removeAttribute("href");
    link.setAttribute("aria-disabled", "true");
    link.setAttribute("title", "Concept preview — this link is not active");
    link.classList.add("concept-link-inert");
  });

  document.querySelectorAll<HTMLButtonElement>("[data-concept-back]").forEach((button) => {
    button.addEventListener("click", () => {
      const previous = document.referrer ? new URL(document.referrer) : null;
      if (previous?.origin === window.location.origin) {
        window.history.back();
      } else {
        window.location.assign("/transformations/");
      }
    });
  });
</script>
