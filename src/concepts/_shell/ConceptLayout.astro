import "./concept-shell.css";
import "./concept-pickers.css";
import "./concept-polish.css";

interface Props {
  title: string;
  slug: string;
  bodyClass: string;
  lang?: string;
  fontHref?: string;
  bannerNote?: string;
  /** A concept with its own house mark can seal the browser tab with it;
      everything else keeps the studio favicon. */
