---
/**
 * SpecimenSheet — Brand-native modal <dialog> dossier for Menus, Room Guides,
 * Drinks Ledgers, and Treatment Guides. Inherits each concept's --cp-* tokens.
 */
import "./specimen-sheet.css";

export interface SpecimenItem {
  name: string;
  note?: string;
  meta?: string;
}

export interface SpecimenGroup {
  id: string;
  label: string;
  items: SpecimenItem[];
}

interface Props {
  id: string;
  triggerLabel: string;
  kicker: string;
  title: string;
  subtitle?: string;
  groups: SpecimenGroup[];
  ctaLabel?: string;
  ctaHref?: string;
  ctaExternal?: boolean;
  secondaryLabel?: string;
  secondaryHref?: string;
  buttonClass?: string;
}

const {
  id,
  triggerLabel,
  kicker,
  title,
  subtitle,
  groups,
  ctaLabel,
  ctaHref,
  ctaExternal = false,
  secondaryLabel,
  secondaryHref,
  buttonClass = "",
} = Astro.props;
---

<button
  type="button"
  class={`mm-specimen-trigger ${buttonClass}`.trim()}
  data-specimen-open={id}
>
  <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <rect x="2.5" y="2" width="11" height="12" rx="1.4" stroke="currentColor" stroke-width="1.4" />
    <path d="M5 5.5h6M5 8h6M5 10.5h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
  </svg>
  <span>{triggerLabel}</span>
</button>

<dialog class="mm-specimen-dialog" id={id} closedby="any" aria-labelledby={`${id}-title`} data-specimen-dialog>
  <div class="mm-spec-head">
    <div>
      <p class="mm-spec-kicker">{kicker}</p>
      <h1 class="mm-spec-title" id={`${id}-title`}>{title}</h1>
      {subtitle && <p class="mm-spec-sub">{subtitle}</p>}
    </div>
    <form method="dialog">
      <button type="submit" class="mm-spec-close" aria-label={`Close ${title}`} autofocus>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
      </button>
    </form>
  </div>

  {groups.length > 1 && (
    <div class="mm-spec-filters" role="group" aria-label="Filter sections">
      <button type="button" class="mm-spec-pill is-active" data-spec-filter="all">All</button>
      {groups.map((g) => (
        <button type="button" class="mm-spec-pill" data-spec-filter={g.id}>{g.label}</button>
      ))}
    </div>
  )}

  <div class="mm-spec-body">
    {groups.map((g) => (
      <section class="mm-spec-group" data-spec-group={g.id}>
        <h2 class="mm-spec-group-title">{g.label}</h2>
        <ul class="mm-spec-list">
          {g.items.map((item) => (
            <li class="mm-spec-row">
              <div>
                <strong>{item.name}</strong>
                {item.note && <p>{item.note}</p>}
              </div>
              {item.meta && <span class="mm-spec-meta">{item.meta}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  {(ctaLabel || secondaryLabel) && (
    <div class="mm-spec-foot">
      {ctaLabel && ctaHref && (
        <a
          class="mm-spec-btn mm-spec-btn--primary"
          href={ctaHref}
          rel={ctaExternal ? "noopener noreferrer" : undefined}
        >
          {ctaLabel}
        </a>
      )}
      {secondaryLabel && secondaryHref && (
        <a class="mm-spec-btn mm-spec-btn--ghost" href={secondaryHref}>
          {secondaryLabel}
        </a>
      )}
    </div>
  )}
</dialog>
