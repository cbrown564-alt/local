---
/** The maker's mountain-ring mark — their real identity, not a studio invention.
 *  Used as a section ornament and footer seal. Decorative only. */
interface Props {
  size?: number;
  class?: string;
}

const { size = 34, class: className } = Astro.props;
---

<img
  class:list={["bb-mark", className]}
  src="/media/concepts/bettys-butters/bettys-butters-brand-mark.png"
  alt=""
  width={size}
  height={size}
  aria-hidden="true"
/>
