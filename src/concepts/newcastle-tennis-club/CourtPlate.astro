---
/* Drawn four-court / floodlight plate for Bryansford Grove.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
interface Props {
  headingId?: string;
}
const { headingId = "ntc-plate-title" } = Astro.props;
---

<figure class="ntc-plate" aria-labelledby={headingId}>
  <svg
    class="ntc-plate-svg"
    viewBox="0 0 420 520"
    role="img"
    aria-label="Drawn plate of four floodlit polytop tennis courts at Bryansford Grove, Newcastle, with Mournes silhouette beyond the pavilion"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="ntc-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1a3d32"/>
        <stop offset="0.55" stop-color="#245544"/>
        <stop offset="1" stop-color="#2f6a52"/>
      </linearGradient>
      <linearGradient id="ntc-court" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#3d8f5c"/>
        <stop offset="1" stop-color="#2a6a44"/>
      </linearGradient>
      <filter id="ntc-soft" x="-6%" y="-6%" width="112%" height="112%">
        <feDropShadow dx="0" dy="8" stdDeviation="10" flood-color="#0c1f18" flood-opacity="0.35"/>
      </filter>
    </defs>

    <rect width="420" height="520" fill="#0f241c"/>
    <rect x="18" y="18" width="384" height="484" fill="url(#ntc-sky)" rx="4"/>

    <!-- Mournes -->
    <path d="M18 168 L70 128 L110 148 L160 110 L210 142 L260 100 L310 138 L360 118 L402 148 L402 200 L18 200 Z" fill="#163528" opacity="0.9"/>
    <path d="M18 188 L80 158 L130 172 L190 140 L250 168 L310 148 L370 170 L402 160 L402 210 L18 210 Z" fill="#0f241c" opacity="0.55"/>

    <!-- Pavilion -->
    <rect x="48" y="198" width="72" height="36" fill="#c8e07a" opacity="0.9"/>
    <path d="M44 198 L84 178 L124 198 Z" fill="#e8f2c4"/>
    <rect x="70" y="210" width="14" height="24" fill="#163528"/>

    <!-- Floodlight poles -->
    <g stroke="#e8f2c4" stroke-width="2">
      <line x1="40" y1="240" x2="40" y2="300"/>
      <line x1="380" y1="240" x2="380" y2="300"/>
    </g>
    <g fill="#f3f6e8" opacity="0.85">
      <rect x="28" y="232" width="24" height="8" rx="2"/>
      <rect x="368" y="232" width="24" height="8" rx="2"/>
    </g>
    <!-- Beams -->
    <path d="M40 240 L100 320 L20 320 Z" fill="#c8e07a" opacity="0.12"/>
    <path d="M380 240 L400 320 L320 320 Z" fill="#c8e07a" opacity="0.12"/>

    <!-- Four courts block -->
    <g filter="url(#ntc-soft)">
      <rect x="56" y="300" width="308" height="168" fill="url(#ntc-court)" stroke="#c8e07a" stroke-width="2"/>
      <!-- court grid 2x2 -->
      <line x1="210" y1="300" x2="210" y2="468" stroke="#e8f2c4" stroke-width="1.5" opacity="0.7"/>
      <line x1="56" y1="384" x2="364" y2="384" stroke="#e8f2c4" stroke-width="1.5" opacity="0.7"/>
      <!-- service lines -->
      <g stroke="#f3f6e8" stroke-width="1" opacity="0.45">
        <line x1="80" y1="320" x2="186" y2="320"/>
        <line x1="234" y1="320" x2="340" y2="320"/>
        <line x1="80" y1="404" x2="186" y2="404"/>
        <line x1="234" y1="404" x2="340" y2="404"/>
        <line x1="133" y1="300" x2="133" y2="384"/>
        <line x1="287" y1="300" x2="287" y2="384"/>
        <line x1="133" y1="384" x2="133" y2="468"/>
        <line x1="287" y1="384" x2="287" y2="468"/>
      </g>
    </g>

    <text x="210" y="70" text-anchor="middle" fill="#e8f2c4" font-family="Instrument Serif, Georgia, serif" font-size="26">Four courts</text>
    <text x="210" y="94" text-anchor="middle" fill="#8bbf5a" font-family="Sora, Segoe UI, sans-serif" font-size="10" font-weight="700" letter-spacing="2.4">BRYANSFORD GROVE · FLOODLIT</text>
    <text x="210" y="500" text-anchor="middle" fill="#c8e07a" font-family="Sora, Segoe UI, sans-serif" font-size="11" font-weight="600">BT33 0DP</text>
  </svg>
</figure>
