---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import CourtPlate from "./CourtPlate.astro";

/* Newcastle Tennis Club — none of the five (club). Speak as the club.
   Four floodlit polytop courts at Bryansford Grove since the 1950s.
   Membership / coaching / Newcastle Centre handoffs. Not a spa.
   No public booking widget. No form. Fees dated 2026–27. */

const email = "info@newcastletennisclubni.com";
const mailto = `mailto:${email}`;
const emailAlt = "Newcastletennisclub@hotmail.com";
const mailtoAlt = `mailto:${emailAlt}`;
const site = "https://newcastletennisclubni.com/";
const coachTel = "07794 452762";
const coachHref = "tel:+447794452762";
const centreTel = "033 137 4026";
const centreHref = "tel:+44331374026";
const maps =
  "https://www.google.com/maps/search/?api=1&query=Bryansford+Grove+Newcastle+BT33+0DP";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Sora:wght@400;500;600;700&display=swap";

const fees = [
  { band: "Senior", price: "£80" },
  { band: "Junior / Student", price: "£40" },
  { band: "Family", price: "£170" },
];

const courts = [
  {
    kicker: "Surface",
    title: "Four polytop courts.",
    body: "All-weather courts with floodlights — play on when the light goes, with the Mournes behind the pavilion.",
  },
  {
    kicker: "Voice",
    title: "Mountains to the sea.",
    body: "Where the mountains sweep down to the sea — that is the setting we play in at Bryansford Grove.",
  },
  {
    kicker: "Arc",
    title: "Since the 1950s.",
    body: "A club established in the 1950s, still on Bryansford Grove — membership year, league play, and a trial session for new members.",
  },
];
---

<ConceptLayout
  title={"Newcastle Tennis Club — independent concept"}
  slug="newcastle-tennis-club"
  bodyClass="concept-page concept-newcastle-tennis-club"
  lang="en-GB"
  businessName="Newcastle Tennis Club"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The court plate is a drawing."
>
  <div class="ntc-strip">
    <span>Bryansford Grove, Newcastle · BT33 0DP · Since the 1950s</span>
    <span class="ntc-strip-r"><a href={mailto}>{email}</a></span>
  </div>

  <header class="ntc-header">
    <a class="ntc-brand" href="/concepts/newcastle-tennis-club/">
      <span class="ntc-brand-mark" aria-hidden="true">
        <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
          <rect width="44" height="44" fill="#163528"/>
          <rect x="6" y="8" width="32" height="28" fill="none" stroke="#c8e07a" stroke-width="1.4"/>
          <path d="M6 22h32M22 8v28" stroke="#c8e07a" stroke-width="1.2" opacity="0.85"/>
          <circle cx="22" cy="22" r="3.2" fill="none" stroke="#f3f6e8" stroke-width="1.3"/>
          <path d="M10 12h6M28 32h6" stroke="#8bbf5a" stroke-width="1.5"/>
        </svg>
      </span>
      <span class="ntc-brand-text">
        <span class="ntc-brand-name">Newcastle Tennis Club</span>
        <span class="ntc-brand-sub">Bryansford Grove · Four courts</span>
      </span>
    </a>
    <nav class="ntc-nav" aria-label="Concept navigation">
      <a href="#courts">The courts</a>
      <a href="#join">Join</a>
      <a href="#plate">The plate</a>
      <a href="#find">Find us</a>
    </nav>
    <a class="ntc-join" href="#join">Join the club</a>
  </header>

  <main class="ntc-main">
    <section class="ntc-hero" aria-labelledby="ntc-name">
      <div class="ntc-hero-copy">
        <p class="ntc-kicker">Four floodlit courts · Bryansford Grove</p>
        <h1 id="ntc-name">Newcastle Tennis Club</h1>
        <p class="ntc-place">Bryansford Grove · Newcastle · BT33 0DP</p>
        <p class="ntc-say">Play under the Mournes.</p>
        <p class="ntc-lede">
          Four polytop all-weather courts with floodlights, a pavilion against
          the mountains, and a trial session before you join.
        </p>
        <p class="ntc-cta">
          <a class="ntc-join ntc-join--inline" href="#join">Join the club</a>
          <a class="ntc-mail" href={mailto}>{email}</a>
        </p>
      </div>
      <div class="ntc-hero-aside" aria-hidden="true">
        <div class="ntc-flood">
          <span class="ntc-flood-beam"></span>
          <span class="ntc-flood-beam ntc-flood-beam--2"></span>
          <span class="ntc-flood-label">Floodlit · Polytop</span>
        </div>
      </div>
    </section>

    <section class="ntc-folio" id="courts" aria-labelledby="ntc-courts-title">
      <p class="ntc-folio-mark">Newcastle Tennis Club · Bryansford Grove</p>
      <div class="ntc-folio-head">
        <p class="ntc-kicker">The courts</p>
        <h2 id="ntc-courts-title">Four courts. Late light.</h2>
        <p>
          Not a leisure-centre brochure — the club at Bryansford Grove, with
          the Mournes behind the pavilion and floodlights for evening play.
        </p>
      </div>
      <div class="ntc-mag">
        {courts.map((item) => (
          <article class="ntc-mag-cell">
            <p class="ntc-mag-kicker">{item.kicker}</p>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ntc-ritual" id="join" aria-labelledby="ntc-join-title">
      <div class="ntc-ritual-copy">
        <p class="ntc-kicker">Membership</p>
        <h2 id="ntc-join-title">Trial first. Then the year.</h2>
        <p class="ntc-ritual-lede">
          Membership runs 1 April to 31 March and is not pro-rated. Come to a
          trial club session, then join for the year.
        </p>
        <ol class="ntc-beats">
          <li>
            <span class="ntc-beat-n">01</span>
            <span class="ntc-beat-t">Come to a trial club session</span>
          </li>
          <li>
            <span class="ntc-beat-n">02</span>
            <span class="ntc-beat-t">Join for the membership year</span>
          </li>
          <li>
            <span class="ntc-beat-n">03</span>
            <span class="ntc-beat-t">Play — members’ court keys (£20 deposit)</span>
          </li>
        </ol>
        <div class="ntc-fees" aria-labelledby="ntc-fees-title">
          <p id="ntc-fees-title" class="ntc-fees-label">2026–27 membership</p>
          <ul>
            {fees.map((f) => (
              <li>
                <span>{f.band}</span>
                <strong>{f.price}</strong>
              </li>
            ))}
          </ul>
          <p class="ntc-fees-note">Renewals via Clubforce on the club site.</p>
        </div>
        <p class="ntc-cta">
          <a class="ntc-join ntc-join--inline" href={site} rel="noopener noreferrer">Club site</a>
          <a class="ntc-mail" href={mailto}>{email}</a>
        </p>
        <p class="ntc-coach">
          Coaching — Sam Clegg <a href={coachHref}>{coachTel}</a>.
          Non-members book courts through Newcastle Centre
          <a href={centreHref}>{centreTel}</a>.
        </p>
      </div>
      <CourtPlate headingId="ntc-join-title" />
    </section>

    <section class="ntc-door" id="find" aria-labelledby="ntc-door-title">
      <div class="ntc-door-head">
        <p class="ntc-kicker">Find us</p>
        <h2 id="ntc-door-title">Bryansford Grove.</h2>
        <p class="ntc-door-lede">
          Pavilion on Bryansford Road — four floodlit courts at Bryansford Grove.
          Write to us, or start on the club site for membership and renewals.
        </p>
      </div>
      <div class="ntc-door-grid">
        <address class="ntc-address">
          <strong>Newcastle Tennis Club</strong>
          <span>Bryansford Grove</span>
          <span>Newcastle, Co. Down</span>
          <span>BT33 0DP</span>
          <a href={mailto}>{email}</a>
          <a href={mailtoAlt}>{emailAlt}</a>
          <a href={maps} rel="noopener noreferrer">Map</a>
        </address>
        <div class="ntc-handoff" id="plate">
          <h3>Club handoff</h3>
          <p>
            Membership packs, court bookings for members, and Clubforce
            renewals live on the club site. Facebook carries club updates.
          </p>
          <a href={site} rel="noopener noreferrer">newcastletennisclubni.com</a>
        </div>
      </div>
      <figure class="ntc-plate-cap">
        <figcaption>The four courts at Bryansford Grove.</figcaption>
      </figure>
    </section>
  </main>

  <footer class="ntc-footer">
    <p class="ntc-footer-name">Newcastle Tennis Club</p>
    <p>Bryansford Grove, Newcastle · Four floodlit courts · Est. 1950s</p>
  </footer>
</ConceptLayout>
