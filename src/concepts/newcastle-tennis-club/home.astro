---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import CourtPlate from "./CourtPlate.astro";

/* Newcastle Tennis Club — established community sports club at Bryansford Grove since the 1950s.
   Bryansford Grove, Newcastle, BT33 0DP.
   Four all-weather floodlit polytop courts under the Mournes. */

const email = "info@newcastletennisclubni.com";
const mailto = `mailto:${email}`;
const emailAlt = "Newcastletennisclub@hotmail.com";
const mailtoAlt = `mailto:${emailAlt}`;
const site = "https://newcastletennisclubni.com/";
const coachTel = "07794 452762";
const coachHref = "tel:+447794452762";
const centreTel = "033 137 4026";
const centreHref = "tel:+44331374026";
const maps =
  "https://www.google.com/maps/search/?api=1&query=Bryansford+Grove+Newcastle+BT33+0DP";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Sora:wght@400;500;600;700&display=swap";

const membershipBands = [
  { band: "Senior Member", price: "£80 / year", note: "Full court access, social club nights, league eligibility" },
  { band: "Junior & Student", price: "£40 / year", note: "Ages under 18 or full-time students, junior coaching access" },
  { band: "Family Package", price: "£170 / year", note: "Two adults and all children under 18 in one household" },
];

const clubSessions = [
  {
    day: "Wed & Fri Evenings",
    title: "Club Social Mix-Ins",
    desc: "Open to all senior members. Turn up, draw partners, and play doubles under the evening floodlights.",
  },
  {
    day: "Saturday Mornings",
    title: "Junior Academy & Coaching",
    desc: "Structured coaching sessions led by Sam Clegg for beginners, improvers, and junior league squads.",
  },
  {
    day: "Weekends & Evenings",
    title: "Belfast & District Leagues",
    desc: "Competitive men's, ladies', and mixed league tennis against visiting clubs across Ulster.",
  },
  {
    day: "Public Court Access",
    title: "Non-Member Bookings",
    desc: "Non-members can book daytime courts directly via Newcastle Centre reception on Central Promenade.",
  },
];
---

<ConceptLayout
  title={"Newcastle Tennis Club — independent concept"}
  slug="newcastle-tennis-club"
  bodyClass="concept-page concept-newcastle-tennis-club"
  lang="en-GB"
  businessName="Newcastle Tennis Club"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The court plate is a drawing."
>
  <div class="ntc-strip">
    <span>Bryansford Grove, Newcastle · BT33 0DP · Established in the 1950s</span>
    <span class="ntc-strip-r"><a href={mailto}>{email}</a></span>
  </div>

  <header class="ntc-header">
    <a class="ntc-brand" href="/concepts/newcastle-tennis-club/">
      <span class="ntc-brand-mark" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 44 44" fill="none">
          <rect width="44" height="44" rx="4" fill="#163528"/>
          <rect x="6" y="8" width="32" height="28" rx="2" fill="none" stroke="#c8e07a" stroke-width="1.4"/>
          <path d="M6 22h32M22 8v28" stroke="#c8e07a" stroke-width="1.2" opacity="0.85"/>
          <circle cx="22" cy="22" r="3.2" fill="none" stroke="#f3f6e8" stroke-width="1.3"/>
          <path d="M10 12h6M28 32h6" stroke="#8bbf5a" stroke-width="1.5"/>
        </svg>
      </span>
      <span class="ntc-brand-text">
        <span class="ntc-brand-name">Newcastle Tennis Club</span>
        <span class="ntc-brand-sub">Bryansford Grove · 4 Floodlit Courts</span>
      </span>
    </a>
    <nav class="ntc-nav" aria-label="Concept navigation">
      <a href="#courts">The Courts</a>
      <a href="#sessions">Club Sessions</a>
      <a href="#membership">Membership</a>
      <a href="#location">Find Us</a>
    </nav>
    <a class="ntc-join-nav" href="#membership">Join the Club</a>
  </header>

  <main class="ntc-main">
    <section class="ntc-hero" aria-labelledby="ntc-name">
      <div class="ntc-hero-content">
        <span class="ntc-kicker">Lawn Tennis · Bryansford Grove</span>
        <h1 id="ntc-name">Newcastle Tennis Club</h1>
        <p class="ntc-hero-location">Bryansford Grove · Newcastle · BT33 0DP</p>
        <p class="ntc-hero-say">Play tennis under the dramatic skyline of the Mourne Mountains.</p>
        <p class="ntc-hero-lede">
          Four tournament-standard all-weather polytop courts with full floodlighting, an active social calendar,
          competitive league play, and junior coaching at the base of the mountains.
        </p>
        <div class="ntc-hero-actions">
          <a class="ntc-btn ntc-btn--primary" href="#membership">View 2026–27 Membership</a>
          <a class="ntc-btn ntc-btn--outline" href={mailto}>Email Club Secretary</a>
        </div>
      </div>

      <div class="ntc-hero-visual">
        <CourtPlate headingId="ntc-name" />
      </div>
    </section>

    <section class="ntc-facilities-section" id="courts" aria-labelledby="ntc-courts-title">
      <div class="ntc-section-header">
        <span class="ntc-kicker">Our Facilities</span>
        <h2 id="ntc-courts-title">Four Floodlit Polytop Courts</h2>
        <p class="ntc-section-lede">
          Maintained year-round for all-weather play, with modern floodlights ensuring uninterrupted evening games.
        </p>
      </div>

      <div class="ntc-facilities-grid">
        <div class="ntc-facility-card">
          <h3>All-Weather Polytop Surface</h3>
          <p>High-traction synthetic surface offering consistent bounce and quick drainage even through autumn and winter conditions.</p>
        </div>
        <div class="ntc-facility-card">
          <h3>Full Court Floodlighting</h3>
          <p>Powerful directional floodlights allow matches and coaching to continue comfortably after dusk throughout the season.</p>
        </div>
        <div class="ntc-facility-card">
          <h3>Clubhouse Pavilion</h3>
          <p>Traditional pavilion overlooking the courts with changing rooms, seating, social kitchen, and member noticeboards.</p>
        </div>
      </div>
    </section>

    <section class="ntc-sessions-section" id="sessions" aria-labelledby="ntc-sessions-title">
      <div class="ntc-section-header">
        <span class="ntc-kicker">Weekly Timetable</span>
        <h2 id="ntc-sessions-title">Club Nights, Match Play &amp; Coaching</h2>
        <p class="ntc-section-lede">
          A welcoming mix of friendly social play, structured skills coaching, and inter-club competition.
        </p>
      </div>

      <div class="ntc-sessions-grid" role="list">
        {clubSessions.map((s) => (
          <article class="ntc-session-card" role="listitem">
            <span class="ntc-session-day">{s.day}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </article>
        ))}
      </div>

      <div class="ntc-coaching-callout">
        <p>
          Individual and group coaching is managed by <strong>Sam Clegg</strong>. Call <a href={coachHref}>{coachTel}</a> for lesson availability.
          Non-members can hire courts through Newcastle Centre on <a href={centreHref}>{centreTel}</a>.
        </p>
      </div>
    </section>

    <section class="ntc-membership-section" id="membership" aria-labelledby="ntc-membership-title">
      <div class="ntc-membership-card">
        <div class="ntc-membership-info">
          <span class="ntc-kicker">Membership Tiers</span>
          <h2 id="ntc-membership-title">2026–27 Annual Subscription</h2>
          <p>
            The club membership season runs from 1 April to 31 March. New members are warmly invited to come along
            for a complimentary trial club night before joining. Member court keys are available for a £20 deposit.
          </p>

          <div class="ntc-pricing-table">
            {membershipBands.map((band) => (
              <div class="ntc-pricing-row">
                <div class="ntc-pricing-name">
                  <strong>{band.band}</strong>
                  <span>{band.note}</span>
                </div>
                <div class="ntc-pricing-amount">{band.price}</div>
              </div>
            ))}
          </div>

          <div class="ntc-membership-actions">
            <a class="ntc-btn ntc-btn--primary" href={site} rel="noopener noreferrer">Register via Clubforce</a>
            <a class="ntc-btn ntc-btn--outline" href={mailto}>Email info@newcastletennisclubni.com</a>
          </div>
        </div>

        <address class="ntc-location-box" id="location">
          <strong>Newcastle Tennis Club</strong>
          <span>Bryansford Grove</span>
          <span>Newcastle, County Down</span>
          <span>BT33 0DP</span>
          <a class="ntc-address-link" href={mailto}>{email}</a>
          <a class="ntc-address-link" href={mailtoAlt}>{emailAlt}</a>
          <a class="ntc-map-btn" href={maps} rel="noopener noreferrer">View on Google Maps</a>
        </address>
      </div>
    </section>
  </main>

  <footer class="ntc-footer">
    <p class="ntc-footer-name">Newcastle Tennis Club</p>
    <p>Bryansford Grove, Newcastle · Lawn Tennis &amp; Floodlit Courts · Est. 1950s</p>
  </footer>
</ConceptLayout>
