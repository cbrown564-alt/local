---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import DoorPlate from "./DoorPlate.astro";

/* Chatterbox Day Nursery — none of the five. Nursery, not a café.
   Speak as the nursery. Organising principle (23 Aug 2026 brief): a place —
   phone / the form they already have. 75 Bryansford Road, Paul and Jane,
   the hours. Do not invent a nursery brand system or a fake tour app.
   Do not invent Instagram. No children’s photographs. Fees live on
   chatterboxkids.co.uk — do not scrape amounts onto this page.
   Re-read About + Contact 29 August 2026, Europe/London. */
const phone = "028 4372 5805";
const phoneHref = "tel:+442843725805";
const email = "info@chatterboxkids.co.uk";
const mailto = `mailto:${email}`;
const contactPage = "https://chatterboxkids.co.uk/contact.php";
const feesPage = "https://chatterboxkids.co.uk/fees.html";
const site = "https://chatterboxkids.co.uk/";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Schibsted+Grotesk:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap";
---

<ConceptLayout
  title={"Chatterbox Day Nursery — independent concept"}
  slug="chatterbox"
  bodyClass="concept-page concept-chatterbox"
  lang="en-GB"
  businessName="Chatterbox Day Nursery"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The hour plate at 75 Bryansford Road is a drawing."
>
  <div class="cbx-strip">
    <span>75 Bryansford Road, Newcastle · BT33 0LE · Day nursery</span>
    <span class="cbx-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="cbx-header">
    <a class="cbx-brand" href="/concepts/chatterbox/">
      <span class="cbx-brand-mark" aria-hidden="true">
        <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
          <circle cx="22" cy="22" r="21" fill="#9a4a38" />
          <circle cx="22" cy="22" r="21" stroke="#c4a35a" stroke-width="1.6" />
          <circle cx="22" cy="22" r="16.5" fill="#f6edd8" />
          <text
            x="22"
            y="27"
            text-anchor="middle"
            fill="#2a1814"
            font-size="16"
            font-family="Instrument Serif, Georgia, serif"
          >75</text>
        </svg>
      </span>
      <span class="cbx-brand-text">
        <span class="cbx-brand-name">Chatterbox</span>
        <span class="cbx-brand-sub">Day Nursery · Newcastle</span>
      </span>
    </a>
    <nav class="cbx-nav" aria-label="Concept navigation">
      <a href="#door">The door</a>
      <a href="#owners">Paul &amp; Jane</a>
      <a href="#hours">Hours</a>
      <a href="#hours">Ring</a>
    </nav>
    <a class="cbx-ring" href={phoneHref}>Ring</a>
  </header>

  <main class="cbx-main">
    <section class="cbx-hero" aria-labelledby="cbx-name">
      <p class="cbx-kicker">Day Nursery · Newcastle</p>
      <h1 id="cbx-name">Chatterbox</h1>
      <p class="cbx-number">75 Bryansford Road · BT33 0LE</p>
      <p class="cbx-say">Family-run since 2004.</p>
      <p class="cbx-lede">
        Care for children aged 0–12 years, on Bryansford Road. Ring, write, or
        use the form on our Contact page.
      </p>
      <p class="cbx-cta">
        <a class="cbx-ring cbx-ring--inline" href={phoneHref}>{phone}</a>
        <a class="cbx-write" href={mailto}>{email}</a>
      </p>
    </section>

    <section class="cbx-spread" id="door" aria-labelledby="cbx-door-title">
      <div class="cbx-spread-copy">
        <p class="cbx-kicker">The door</p>
        <h2 id="cbx-door-title">75 Bryansford Road.</h2>
        <p class="cbx-spread-lede">
          Chatterbox nursery is a family run business located in the seaside
          town of Newcastle.
        </p>
        <p>
          This superb location is close to local amenities such as the town
          library, primary schools, parks and the seaside promenade.
        </p>
        <p>
          Since 2004 Chatterbox has been providing care for hundreds of
          children aged 0–12 years.
        </p>
        <blockquote class="cbx-pull">
          <p>
            “At chatterbox we will provide a warm and welcoming environment
            for you and most importantly your child/ children.”
          </p>
        </blockquote>
      </div>

      <figure class="cbx-artefact">
        <DoorPlate />
        <figcaption>The hour plate at 75 Bryansford Road.</figcaption>
      </figure>
    </section>

    <section class="cbx-owners" id="owners" aria-labelledby="cbx-owners-title">
      <p class="cbx-kicker">Paul &amp; Jane</p>
      <h2 id="cbx-owners-title">Husband and wife. April 2010.</h2>
      <p class="cbx-owners-lede">
        It is owned by husband and wife team Paul and Jane O'Connor who took
        over the business in April 2010.
      </p>
      <div class="cbx-owners-grid">
        <article class="cbx-owner">
          <p class="cbx-owner-name">Paul O'Connor</p>
          <p>
            Since this, Paul who is a local building contractor has carried
            out an entire re-furbishment of the nursery to the highest
            possible standard.
          </p>
        </article>
        <article class="cbx-owner">
          <p class="cbx-owner-name">Jane O'Connor</p>
          <p>
            Jane is a registered nurse and deputy ward manager in the Royal
            Group of hospitals. Jane has previously worked as a part time
            first aid lecturer in the various Further Education colleges.
          </p>
        </article>
      </div>
      <p class="cbx-trust">
        We are registered with the South Eastern Health and Social Care Trust.
      </p>
    </section>

    <section class="cbx-hours" id="hours" aria-labelledby="cbx-hours-title">
      <div class="cbx-hours-object">
        <p class="cbx-kicker cbx-kicker--on-door">The hours</p>
        <h2 id="cbx-hours-title">Monday – Friday 07.30 – 18:00</h2>
        <p class="cbx-hours-note">
          Closed bank holidays and 1 week at Christmas. Closures are subject
          to change.
        </p>
        <p class="cbx-hours-ask">
          Ring. Write. Or the form on our Contact page.
        </p>
        <p class="cbx-chips">
          <a class="cbx-chip cbx-chip--tel" href={phoneHref}>{phone}</a>
          <a class="cbx-chip" href={mailto}>{email}</a>
          <a class="cbx-chip" href={contactPage} rel="noopener noreferrer">Contact page</a>
        </p>
        <p class="cbx-fees">
          Fees live on
          <a href={feesPage} rel="noopener noreferrer">chatterboxkids.co.uk</a>.
        </p>
      </div>
    </section>

    <footer class="cbx-foot">
      <address class="cbx-address">
        <strong>Chatterbox Day Nursery</strong>
        <span>75 Bryansford Road</span>
        <span>Newcastle · BT33 0LE</span>
        <a href={phoneHref}>{phone}</a>
        <a href={mailto}>{email}</a>
        <a href={site} rel="noopener noreferrer">chatterboxkids.co.uk</a>
      </address>
    </footer>
  </main>
</ConceptLayout>
