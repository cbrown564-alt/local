---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

/* Chatterbox Day Nursery — none of the five. Nursery, not a café.
   Speak as the nursery. Organising principle (23 Aug 2026 brief): a place —
   phone / the form they already have. 75 Bryansford Road, Paul and Jane,
   the hours. Do not invent a nursery brand system or a fake tour app.
   Do not invent Instagram. No children’s photographs. Fees live on
   chatterboxkids.co.uk — do not scrape amounts onto this page.
   Re-read About + Contact 29 August 2026, Europe/London. */
const phone = "028 4372 5805";
const phoneHref = "tel:+442843725805";
const email = "info@chatterboxkids.co.uk";
const mailto = `mailto:${email}`;
const contactPage = "https://chatterboxkids.co.uk/contact.php";
const feesPage = "https://chatterboxkids.co.uk/fees.html";
const site = "https://chatterboxkids.co.uk/";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Schibsted+Grotesk:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap";
---

<ConceptLayout
  title={"Chatterbox Day Nursery — independent concept"}
  slug="chatterbox"
  bodyClass="concept-page concept-chatterbox"
  lang="en-GB"
  businessName="Chatterbox Day Nursery"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="Photography comprises illustrative visualisations of 75 Bryansford Road."
>
  <div class="cbx-topbar">
    <div class="cbx-topbar-inner">
      <span>75 Bryansford Road, Newcastle · BT33 0LE</span>
      <a class="cbx-topbar-tel" href={phoneHref}>{phone}</a>
    </div>
  </div>

  <header class="cbx-header">
    <div class="cbx-header-inner">
      <a class="cbx-brand" href="/concepts/chatterbox/">
        <span class="cbx-brand-name">Chatterbox</span>
        <span class="cbx-brand-sub">Day Nursery · Newcastle</span>
      </a>
      <nav class="cbx-nav" aria-label="Concept navigation">
        <a href="#about">About</a>
        <a href="#setting">The Setting</a>
        <a href="#leadership">Paul &amp; Jane</a>
        <a href="#hours">Hours</a>
      </nav>
      <a class="cbx-cta-btn" href={phoneHref}>Ring {phone}</a>
    </div>
  </header>

  <main class="cbx-main">
    <section class="cbx-hero" aria-labelledby="cbx-title">
      <div class="cbx-hero-content">
        <p class="cbx-kicker">Family-Run Day Nursery · Established 2004</p>
        <h1 id="cbx-title">Caring for Newcastle's children since 2004.</h1>
        <p class="cbx-hero-address">75 Bryansford Road · Newcastle · BT33 0LE</p>
        <p class="cbx-hero-lede">
          A calm, nurturing environment providing dedicated care for children aged 0–12 years
          on Bryansford Road. Welcoming, family-centred, and rooted in the seaside town of Newcastle.
        </p>
        <div class="cbx-actions">
          <a class="cbx-btn-primary" href={phoneHref}>Ring {phone}</a>
          <a class="cbx-btn-secondary" href={mailto}>{email}</a>
        </div>
      </div>

      <figure class="cbx-hero-figure">
        <img
          src="/media/concepts/chatterbox/chatterbox-hero-bryansford-road.jpg"
          alt="Illustrative photograph of 75 Bryansford Road in Newcastle County Down with welcoming painted entrance door and garden path"
          width="1536"
          height="1024"
          loading="eager"
        />
        <figcaption>75 Bryansford Road · Morning approach against the Mourne foothills</figcaption>
      </figure>
    </section>

    <section class="cbx-feature-split" id="about" aria-labelledby="cbx-door-title">
      <div class="cbx-feature-copy">
        <p class="cbx-kicker">The Location</p>
        <h2 id="cbx-door-title">75 Bryansford Road.</h2>
        <p class="cbx-feature-lede">
          Chatterbox nursery is a family run business located in the seaside town of Newcastle.
        </p>
        <p>
          This superb location is close to local amenities such as the town library, primary schools,
          parks and the seaside promenade.
        </p>
        <p>
          Since 2004 Chatterbox has been providing care for hundreds of children aged 0–12 years,
          offering peace of mind for families in an enriching, caring daily routine.
        </p>
      </div>

      <figure class="cbx-photo-card">
        <img
          src="/media/concepts/chatterbox/chatterbox-hall-entry.jpg"
          alt="Illustrative interior view of the tranquil entrance hall with wooden coat pegs and timber flooring"
          width="1200"
          height="900"
          loading="lazy"
        />
        <figcaption>The welcoming entrance hall inside 75 Bryansford Road.</figcaption>
      </figure>
    </section>

    <section class="cbx-garden-section" id="setting" aria-labelledby="cbx-garden-title">
      <div class="cbx-garden-head">
        <p class="cbx-kicker">Outdoor Environment</p>
        <h2 id="cbx-garden-title">Space to explore, discover and grow.</h2>
        <blockquote class="cbx-quote">
          <p>
            “At chatterbox we will provide a warm and welcoming environment for you and most importantly your child/ children.”
          </p>
        </blockquote>
      </div>

      <figure class="cbx-garden-photo">
        <img
          src="/media/concepts/chatterbox/chatterbox-garden-play.jpg"
          alt="Illustrative view of the outdoor nature play garden with timber balance beams, herb planters, and Mourne foothills"
          width="1200"
          height="900"
          loading="lazy"
        />
        <figcaption>Outdoor discovery garden at the rear, under the Mourne mountain skyline.</figcaption>
      </figure>
    </section>

    <section class="cbx-owners-section" id="leadership" aria-labelledby="cbx-owners-title">
      <div class="cbx-owners-header">
        <p class="cbx-kicker">Leadership &amp; Care</p>
        <h2 id="cbx-owners-title">Husband and wife. April 2010.</h2>
        <p class="cbx-owners-intro">
          It is owned by husband and wife team Paul and Jane O'Connor who took over the business in April 2010.
        </p>
      </div>

      <div class="cbx-owners-grid">
        <article class="cbx-card">
          <div class="cbx-card-badge">Refurbishment</div>
          <h3>Paul O'Connor</h3>
          <p>
            Since this, Paul who is a local building contractor has carried out an entire re-furbishment
            of the nursery to the highest possible standard.
          </p>
        </article>

        <article class="cbx-card">
          <div class="cbx-card-badge">Clinical Background</div>
          <h3>Jane O'Connor</h3>
          <p>
            Jane is a registered nurse and deputy ward manager in the Royal Group of hospitals.
            Jane has previously worked as a part time first aid lecturer in the various Further Education colleges.
          </p>
        </article>
      </div>

      <div class="cbx-trust-banner">
        <span class="cbx-trust-dot" aria-hidden="true"></span>
        <p>We are registered with the South Eastern Health and Social Care Trust.</p>
      </div>
    </section>

    <section class="cbx-schedule-section" id="hours" aria-labelledby="cbx-hours-title">
      <div class="cbx-schedule-card">
        <div class="cbx-schedule-badge">MON–FRI</div>
        <p class="cbx-kicker">Daily Routine</p>
        <h2 id="cbx-hours-title">Monday – Friday 07.30 – 18:00</h2>
        <p class="cbx-schedule-note">
          Closed bank holidays and 1 week at Christmas. Closures are subject to change.
        </p>

        <div class="cbx-contact-block">
          <p class="cbx-contact-prompt">Ring. Write. Or the form on our Contact page.</p>
          <div class="cbx-contact-links">
            <a class="cbx-pill cbx-pill--call" href={phoneHref}>Ring {phone}</a>
            <a class="cbx-pill" href={mailto}>{email}</a>
            <a class="cbx-pill" href={contactPage} rel="noopener noreferrer">Contact page</a>
          </div>
        </div>

        <p class="cbx-fees-line">
          Fee schedules and care room details live on
          <a href={feesPage} rel="noopener noreferrer">chatterboxkids.co.uk</a>.
        </p>
      </div>
    </section>

    <footer class="cbx-footer">
      <div class="cbx-footer-inner">
        <div>
          <h3 class="cbx-footer-brand">Chatterbox Day Nursery</h3>
          <address class="cbx-footer-address">
            <span>75 Bryansford Road</span>
            <span>Newcastle · BT33 0LE</span>
          </address>
        </div>
        <div class="cbx-footer-contacts">
          <a href={phoneHref}>{phone}</a>
          <a href={mailto}>{email}</a>
          <a href={site} rel="noopener noreferrer">chatterboxkids.co.uk</a>
        </div>
      </div>
    </footer>
  </main>
</ConceptLayout>
