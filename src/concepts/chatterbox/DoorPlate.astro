---
/* Drawn hour plate on the painted door at 75 Bryansford Road.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
---

<svg
  class="cbx-plate-svg"
  viewBox="0 0 280 460"
  role="img"
  aria-labelledby="cbx-plate-title cbx-plate-desc"
>
    <title id="cbx-plate-title">75 Bryansford Road hour plate</title>
    <desc id="cbx-plate-desc">
      Painted door at 75 Bryansford Road with a brass-rimmed enamel plate:
      Chatterbox, Monday to Friday 07.30 to 18.00.
    </desc>
    <defs>
      <linearGradient id="cbx-door-face" x1="0" y1="0" x2="1" y2="0.12">
        <stop offset="0" stop-color="#5e2a22" />
        <stop offset=".18" stop-color="#8a4032" />
        <stop offset=".55" stop-color="#9a4a38" />
        <stop offset="1" stop-color="#6d3328" />
      </linearGradient>
      <linearGradient id="cbx-door-shade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#000" stop-opacity=".08" />
        <stop offset="1" stop-color="#000" stop-opacity=".28" />
      </linearGradient>
      <linearGradient id="cbx-brass" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e4c57a" />
        <stop offset=".45" stop-color="#c4a35a" />
        <stop offset="1" stop-color="#8a6b32" />
      </linearGradient>
      <linearGradient id="cbx-enamel" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fbf6ea" />
        <stop offset="1" stop-color="#efe4cc" />
      </linearGradient>
      <filter id="cbx-soft" x="-8%" y="-8%" width="116%" height="116%">
        <feDropShadow dx="0" dy="6" stdDeviation="7" flood-color="#2a1814" flood-opacity=".28" />
      </filter>
    </defs>

    <!-- Brick reveal either side of the door -->
    <rect x="0" y="0" width="280" height="460" fill="#cbb8a4" />
    <g fill="#b89f88" opacity=".55">
      <rect x="0" y="18" width="28" height="12" />
      <rect x="16" y="36" width="28" height="12" />
      <rect x="0" y="54" width="28" height="12" />
      <rect x="252" y="22" width="28" height="12" />
      <rect x="236" y="40" width="28" height="12" />
      <rect x="252" y="58" width="28" height="12" />
      <rect x="0" y="400" width="28" height="12" />
      <rect x="252" y="412" width="28" height="12" />
    </g>

    <!-- Frame -->
    <rect x="22" y="10" width="236" height="440" rx="3" fill="#3a241c" />
    <rect x="32" y="20" width="216" height="420" rx="2" fill="url(#cbx-door-face)" />
    <rect x="32" y="20" width="216" height="420" rx="2" fill="url(#cbx-door-shade)" />

    <!-- Upper panel -->
    <rect x="48" y="36" width="184" height="132" rx="2" fill="none" stroke="#4a241c" stroke-width="5" />
    <rect x="54" y="42" width="172" height="120" rx="1" fill="none" stroke="#c47a64" stroke-width="1.2" opacity=".35" />

    <!-- Lower panel -->
    <rect x="48" y="286" width="184" height="132" rx="2" fill="none" stroke="#4a241c" stroke-width="5" />
    <rect x="54" y="292" width="172" height="120" rx="1" fill="none" stroke="#c47a64" stroke-width="1.2" opacity=".35" />

    <!-- Letterbox -->
    <rect x="108" y="248" width="64" height="12" rx="1.5" fill="url(#cbx-brass)" />
    <rect x="111" y="251" width="58" height="6" rx="1" fill="#2a1814" />

    <!-- Knocker boss -->
    <circle cx="200" cy="214" r="7" fill="url(#cbx-brass)" />
    <circle cx="200" cy="214" r="3.2" fill="#6a4e24" />

    <!-- Enamel hour plate -->
    <g filter="url(#cbx-soft)">
      <ellipse cx="140" cy="168" rx="78" ry="92" fill="url(#cbx-brass)" />
      <ellipse cx="140" cy="168" rx="71" ry="85" fill="url(#cbx-enamel)" />
      <ellipse cx="140" cy="168" rx="71" ry="85" fill="none" stroke="#d8c49a" stroke-width="1.2" />
    </g>

    <!-- Screws -->
    <circle cx="140" cy="92" r="3.4" fill="url(#cbx-brass)" />
    <circle cx="140" cy="244" r="3.4" fill="url(#cbx-brass)" />
    <path d="M137.4 92h5.2M140 89.4v5.2" stroke="#6a4e24" stroke-width=".6" />
    <path d="M137.4 244h5.2M140 241.4v5.2" stroke="#6a4e24" stroke-width=".6" />

    <text
      x="140"
      y="118"
      text-anchor="middle"
      fill="#6a4e24"
      font-size="8"
      font-family="Schibsted Grotesk, Helvetica, sans-serif"
      font-weight="600"
      letter-spacing="2.4"
    >CHATTERBOX</text>
    <text
      x="140"
      y="168"
      text-anchor="middle"
      fill="#2a1814"
      font-size="52"
      font-family="Instrument Serif, Georgia, serif"
      font-weight="400"
    >75</text>
    <text
      x="140"
      y="188"
      text-anchor="middle"
      fill="#5c4020"
      font-size="8.5"
      font-family="Schibsted Grotesk, Helvetica, sans-serif"
      font-weight="600"
      letter-spacing="1.4"
    >BRYANSFORD ROAD</text>
    <line x1="92" y1="198" x2="188" y2="198" stroke="#c4a35a" stroke-width="1" />
    <text
      x="140"
      y="216"
      text-anchor="middle"
      fill="#2a1814"
      font-size="9"
      font-family="Schibsted Grotesk, Helvetica, sans-serif"
      font-weight="700"
      letter-spacing=".8"
    >MON–FRI 07.30–18:00</text>
    <text
      x="140"
      y="230"
      text-anchor="middle"
      fill="#6a4e24"
      font-size="7"
      font-family="Schibsted Grotesk, Helvetica, sans-serif"
      font-weight="500"
      letter-spacing="1.1"
    >NEWCASTLE · BT33 0LE</text>
  </svg>
