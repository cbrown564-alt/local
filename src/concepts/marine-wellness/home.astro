---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

const booksy =
  "https://booksy.com/en-gb/120760_marine-wellness_massage_1529223_newcastle";
const facebook = "https://www.facebook.com/marinebeauty.haven/";
const phone = "028 4372 6207";
const phoneHref = "tel:+442843726207";
// Move 2: the clinic's Facebook Intro, verbatim. Do not trim inside the quote.
const creed =
  "Marine Wellness is a professional holistic wellness clinic specialising in therapeutic massage, reflexology and restorative treatments designed to support relaxation, recovery and overall wellbeing in a calm, welcoming environment.";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Cormorant+Infant:ital,wght@0,500;0,600;1,500&family=Sora:wght@400;500;600;700&display=swap";

const treatments = [
  { name: "Tailored treatment with Patricia", line: "One hour, or two. Chosen on the day." },
  { name: "Sports massage", line: "Focused 30 minutes, or a full hour." },
  { name: "Wellbeing body massage", line: "An hour." },
  { name: "Dermalogica skin focus 45", line: "Forty-five minutes." },
  { name: "Kinetic Chain Release", line: "An hour." },
];

// Move 4: the weekly hours as the clinic's own site publishes them
// (read 23 August 2026; dated in research and the case study's Sources & limits).
const hours = [
  { day: "Monday", time: "Closed" },
  { day: "Tuesday", time: "10–5" },
  { day: "Wednesday", time: "10–6" },
  { day: "Thursday", time: "10–7" },
  { day: "Friday", time: "10–6" },
  { day: "Saturday", time: "9–3" },
  { day: "Sunday", time: "Closed" },
];

// Move 3: the tenure ladder is the timeline. No biographies beyond this.
const people = [
  { name: "Patricia", tenure: "Over twenty years" },
  { name: "Nicola", tenure: "Over ten" },
  { name: "Emma", tenure: "Three and counting" },
];

// Move 5: the clinic's own Booksy booking terms, set as house rules.
const rules = [
  "A 50% deposit is taken when you book.",
  "The deposit is non-refundable inside 24 hours of the appointment, or for a no-show.",
  "A late arrival means a shorter treatment.",
  "New clients have a consultation before advanced work.",
];
---

<ConceptLayout
  title={"Marine Wellness — Newcastle"}
  slug="marine-wellness"
  bodyClass="concept-page concept-marine"
  businessName="Marine Wellness"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The calm plate is a generated image, not a photograph of the treatment room."
>
  <main class="mw-page">
    <aside class="mw-emergency" id="urgent">
      <p>
        <strong>This is not A&amp;E.</strong>
        Sudden illness or injury: call <a href="tel:999">999</a> or
        <a href="tel:111">111</a>. Do not wait to book a treatment.
      </p>
    </aside>

    <section class="mw-first" aria-labelledby="mw-name">
      <p class="mw-soon">Patricia McGrady · Unit 13, 63A Castlewellan Road</p>
      <h1 id="mw-name">Marine Wellness</h1>
      <p class="mw-reassure">
        Unit 13, 63A Castlewellan Road, Newcastle, BT33 0JX.
        Book on <a href={booksy}>Booksy</a>, or call{" "}
        <a href={phoneHref}>{phone}</a>.
      </p>
      <ul class="mw-two">
        <li>
          <span>Book</span>
          <strong>The diary on Booksy</strong>
          <a href={booksy}>Open Booksy</a>
        </li>
        <li>
          <span>Follow</span>
          <strong>Facebook</strong>
          <a href={facebook}>marinebeauty.haven</a>
        </li>
      </ul>
    </section>

    <section class="mw-continuity" aria-labelledby="mw-continuity-title">
      <h2 id="mw-continuity-title">
        If you knew us as Marine Beauty Haven on the Promenade — same hands,
        same number, new room.
      </h2>
      <p>
        The clinic is now at Unit 13, 63A Castlewellan Road. The phone has not
        changed: <a href={phoneHref}>{phone}</a>. Neither has the diary.
      </p>
    </section>

    <figure class="mw-calm">
      <img
        src="/media/concepts/marine-wellness/calm.jpg"
        alt="An empty treatment room with folded towels and a plant in soft daylight"
        width="940"
        height="627"
      />
      <figcaption>A calm room.</figcaption>
    </figure>

    <figure class="mw-creed">
      <blockquote>
        <p>{creed}</p>
      </blockquote>
      <figcaption>Marine Wellness · Facebook</figcaption>
    </figure>

    <section class="mw-people" aria-labelledby="mw-people-title">
      <p class="mw-kicker">The practice</p>
      <h2 id="mw-people-title">The hands stay the same.</h2>
      <ul class="mw-people-list">
        {people.map((person) => (
          <li>
            <strong>{person.name}</strong>
            <span>{person.tenure}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mw-hours" id="hours" aria-labelledby="mw-hours-title">
      <p class="mw-kicker">Opening hours</p>
      <h2 id="mw-hours-title">When the door is open</h2>
      <table class="mw-hours-table">
        <tbody>
          {hours.map((row) => (
            <tr>
              <th scope="row">{row.day}</th>
              <td>{row.time}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="mw-rules" aria-labelledby="mw-rules-title">
      <p class="mw-kicker">Before you book</p>
      <h2 id="mw-rules-title">Four house rules</h2>
      <ul class="mw-rules-list">
        {rules.map((rule) => (
          <li>{rule}</li>
        ))}
      </ul>
      <p class="mw-rules-diary">
        Prices and slots live in the diary: <a href={booksy}>Open Booksy</a>.
      </p>
    </section>

    <section class="mw-desk" id="desk" aria-labelledby="mw-desk-title">
      <p class="mw-kicker">Who needs seen, and when</p>
      <h2 id="mw-desk-title">Write it. Then open the diary.</h2>
      <p>
        Prices and slots live on Booksy, updated there. A few treatments as
        listed on 23 August 2026 sit below — they move. Take the slot on Booksy.
      </p>
      <ul class="mw-list">
        {treatments.map((t) => (
          <li>
            <strong>{t.name}</strong>
            <span>{t.line}</span>
          </li>
        ))}
      </ul>
      <form class="mw-script" data-mw-script>
        <label>
          <span>Who needs seen</span>
          <input name="who" type="text" required />
        </label>
        <label>
          <span>When you hope to come</span>
          <input name="when" type="text" placeholder="This week if you can" required />
        </label>
        <label>
          <span>What you came for</span>
          <input name="what" type="text" placeholder="Massage, facial, or ask Patricia" />
        </label>
        <button type="submit">Keep the words for Booksy</button>
      </form>
      <div class="mw-ready" data-mw-ready hidden tabindex="-1">
        <p data-mw-ready-script></p>
        <a href={booksy}>Open Booksy</a>
      </div>
    </section>

    <p class="mw-foot">
      Marine Wellness, Unit 13, 63A Castlewellan Road, Newcastle, BT33 0JX.
      The diary:
      <a href={booksy}>Booksy</a>.
    </p>
  </main>

  <script is:inline>
    (function () {
      var form = document.querySelector("[data-mw-script]");
      var ready = document.querySelector("[data-mw-ready]");
      var scriptEl = document.querySelector("[data-mw-ready-script]");
      if (!form || !ready || !scriptEl) return;

      form.addEventListener("submit", function (event) {
        event.preventDefault();
        if (!form.reportValidity()) return;
        var who = form.elements.namedItem("who").value.trim();
        var when = form.elements.namedItem("when").value.trim();
        var what = form.elements.namedItem("what").value.trim();
        scriptEl.textContent =
          who + " hopes to be seen " + when +
          (what ? " for " + what : "") +
          ". Book that on Booksy.";
        ready.hidden = false;
        ready.focus();
      });
    })();
  </script>
</ConceptLayout>
