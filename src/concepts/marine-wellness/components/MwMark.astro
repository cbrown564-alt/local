---
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className = "" } = Astro.props;
---

<svg
  class:list={["mw-mark", className]}
  width={size}
  height={size}
  viewBox="0 0 44 44"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <!-- Outer gentle restorative sanctuary ring -->
  <circle
    cx="22"
    cy="22"
    r="20"
    stroke="currentColor"
    stroke-width="1.2"
    stroke-opacity="0.25"
  />
  <!-- Inner healing hands / calm coastal wave arcs -->
  <path
    d="M10 24.5C10 17.5 15.5 12 22 12C28.5 12 34 17.5 34 24.5C34 29 30.5 32.5 26.5 32.5C23.5 32.5 21.5 30.5 20.5 28C19.5 25.5 18 24 15.5 24C12.5 24 10 26.5 10 29.5"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    d="M14 21C15.5 17 18.5 15 22 15C26 15 29.5 18 30 22"
    stroke="currentColor"
    stroke-width="1.2"
    stroke-linecap="round"
    stroke-opacity="0.6"
  />
  <!-- Centred restorative droplet -->
  <circle cx="22" cy="21" r="2" fill="currentColor" />
</svg>

<style>
  .mw-mark {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
  }
</style>
