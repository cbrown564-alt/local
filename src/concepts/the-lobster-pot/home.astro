---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";
import LpMark from "./LpMark.astro";

/* The Lobster Pot — 7–11 The Square, Strangford, Downpatrick, BT30 7ND.
   Sources (checked 26 Nov 2026):
   - FSA FHRS register (Authority 145, inspected 2026-06-18).
   - Visit Mourne Gullion Strangford, NI Good Food, public listings.
   - Listed domain thelobsterpotstrangford.com is DNS dead.
   - Spaces: Front Bar (wood-burning stove, views over Strangford Lough),
     Front Restaurant, Function Room / Private Dining with double doors to
     the hidden beer garden.
   - Food: local lobster, fresh mussels, seafood chowder, battered cod,
     scampi, steaks, chicken, vegetarian dishes, homemade desserts,
     gluten-free options.
   - Phone: +44 28 4488 1288. No public email is listed, so booking calls
     direct or copies a table note for a quick call/Facebook message.
   Brief: research/concepts/the-lobster-pot/the-lobster-pot-elevation-brief.md */

const phone = "028 4488 1288";
const phoneIntl = "+44 28 4488 1288";
const phoneHref = "tel:+442844881288";
const facebook = "https://en-gb.facebook.com/lobsterpotstrangford/";
const mapHref = "https://www.google.com/maps/search/?api=1&query=7-11+The+Square+Strangford+BT30+7ND";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@400;500;600;700&display=swap";

const spaces = [
  {
    no: "I",
    name: "The Front Bar",
    where: "Looking over Strangford Lough",
    summary: "Cosy traditional village bar in soft green and cream tones — local history on the walls and a wood-burning stove warming you straight off the ferry.",
  },
  {
    no: "II",
    name: "The Front Restaurant",
    where: "Extending from the bar",
    summary: "Relaxed dining room with soft furnishings and warm evening lighting for local shellfish, steaks and unhurried family suppers.",
  },
  {
    no: "III",
    name: "Function Room & Hidden Beer Garden",
    where: "Double doors to the rear courtyard",
    summary: "Light, spacious private dining room opening straight onto our sheltered courtyard beer garden for gatherings and summer evenings.",
  },
];

const seaBoard = [
  "Local Strangford lobster",
  "Fresh local mussels",
  "House seafood chowder",
  "Battered cod & scampi",
];

const landBoard = [
  "Daily selection of steaks",
  "Chicken & vegetarian mains",
  "Homemade desserts including pecan pie",
  "Gluten-free dishes accommodated",
];
---

<ConceptLayout
  title="The Lobster Pot — Seafood Restaurant & Bar, The Square, Strangford"
  slug="the-lobster-pot"
  bodyClass="concept-page concept-lobster"
  lang="en-GB"
  businessName="The Lobster Pot"
  town="Strangford"
  fontHref={fontHref}
  bannerNote="The harbour supper and wood-burning stove scenes are AI-generated visualisations. Table bookings go by phone to 028 4488 1288 or Facebook, matching how The Lobster Pot takes reservations today."
>
  <header class="lp-header">
    <div class="lp-header-inner">
      <a class="lp-brand" href="#top">
        <LpMark size={34} tone="coral" />
        <span>
          <strong>The Lobster Pot</strong>
          <small>7–11 The Square · Strangford</small>
        </span>
      </a>
      <nav class="lp-nav" aria-label="The Lobster Pot">
        <a href="#walk">Three Rooms</a>
        <a href="#chalkboard">The Catch</a>
        <a href="#book">Tables &amp; Garden</a>
        <a href="#find">Slipway &amp; Map</a>
      </nav>
      <a class="lp-header-tel" href={phoneHref}>Call {phone}</a>
    </div>
  </header>

  <main id="top" class="lp-main">
    <section class="lp-hero" aria-labelledby="lp-hero-title">
      <div class="lp-hero-col">
        <p class="lp-kicker">Strangford Lough · Lecale Peninsula</p>
        <h1 id="lp-hero-title">Local lobster, a warm stove, <em>and a pint right off the ferry.</em></h1>
        <p class="lp-lede">
          At 7–11 The Square in Strangford — footsteps from the Portaferry
          slipway. Settle by the wood-burning stove in the front bar, sit down
          for fresh shellfish in the restaurant, or push open the double doors
          to our hidden beer garden.
        </p>

        <div class="lp-hero-actions">
          <a class="lp-btn lp-btn--coral" href={phoneHref}>Book a table · {phone}</a>
          <a class="lp-btn lp-btn--ghost" href={facebook} rel="noopener noreferrer">Today's specials on Facebook ↗</a>
        </div>

        <dl class="lp-ferry-stamp">
          <div>
            <dt>Location</dt>
            <dd>7–11 The Square, BT30 7ND</dd>
          </div>
          <div>
            <dt>Hours</dt>
            <dd>Daily from around 12 noon</dd>
          </div>
        </dl>
      </div>

      <figure class="lp-hero-figure">
        <ResponsiveImage
          src="/media/concepts/the-lobster-pot/lobster-pot-harbour-supper.jpg"
          alt="Candlelit harbour pub table with cooked red lobster, fresh mussels, sourdough bread and a pint overlooking twilight waters"
          width={1376}
          height={768}
          loading="eager"
          sizes="(max-width: 960px) 100vw, 58vw"
          class="lp-hero-img"
        />
        <figcaption>Harbour seafood supper by the lough. Visualisation (AI-generated).</figcaption>
      </figure>
    </section>

    <div class="lp-tide-bar" role="region" aria-label="Ferry and village bearings">
      <div class="lp-wrap lp-tide-inner">
        <span>Strangford ↔ Portaferry Ferry Slipway · 1 min walk</span>
        <span>Front Bar Stove · Restaurant · Hidden Courtyard Garden</span>
        <span>Ring <a href={phoneHref}>{phoneIntl}</a> for current kitchen times</span>
      </div>
    </div>

    <section class="lp-section lp-walk" id="walk" aria-labelledby="lp-walk-title">
      <div class="lp-wrap">
        <div class="lp-walk-grid">
          <figure class="lp-stove-plate">
            <ResponsiveImage
              src="/media/concepts/the-lobster-pot/lobster-pot-stove-garden.jpg"
              alt="Cosy coastal village bar corner with a glowing cast-iron stove and double timber doors opening to a courtyard garden"
              width={1200}
              height={896}
              sizes="(max-width: 960px) 100vw, 48vw"
              class="lp-stove-img"
            />
            <figcaption>Front bar stove &amp; double doors toward the rear garden. Visualisation (AI-generated).</figcaption>
          </figure>

          <div class="lp-walk-copy">
            <p class="lp-kicker lp-kicker--dark">Walk Through the House</p>
            <h2 id="lp-walk-title">Three distinct rooms from the square to the garden.</h2>

            <ol class="lp-room-steps">
              {spaces.map((s) => (
                <li class="lp-room-step">
                  <span class="lp-roman">{s.no}</span>
                  <div>
                    <p class="lp-step-where">{s.where}</p>
                    <h3>{s.name}</h3>
                    <p>{s.summary}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section class="lp-chalk-section" id="chalkboard" aria-labelledby="lp-chalk-title">
      <div class="lp-wrap">
        <div class="lp-chalkboard">
          <div class="lp-chalk-head">
            <div>
              <p class="lp-kicker">The Kitchen Board</p>
              <h2 id="lp-chalk-title">Built around Strangford Lough, welcoming every table.</h2>
            </div>
            <p class="lp-chalk-note">
              Menus move with the local catch and season. Call{" "}
              <a href={phoneHref}>{phone}</a> or check Facebook for what's on the
              board today.
            </p>
          </div>

          <div class="lp-chalk-cols">
            <div class="lp-chalk-col">
              <h3>From the Lough &amp; Local Boats</h3>
              <ul>
                {seaBoard.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class="lp-chalk-col">
              <h3>From the Grill &amp; Kitchen</h3>
              <ul>
                {landBoard.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>

          <div class="lp-chalk-foot">
            <a class="lp-btn lp-btn--coral" href={phoneHref}>Ask about today's catch · {phone}</a>
            <a class="lp-btn lp-btn--ghost" href={facebook} rel="noopener noreferrer">Check Facebook specials ↗</a>
          </div>
        </div>
      </div>
    </section>

    <section class="lp-section lp-book" id="book" aria-labelledby="lp-book-title">
      <div class="lp-wrap lp-book-grid">
        <div class="lp-book-copy">
          <p class="lp-kicker lp-kicker--dark">Tables &amp; Private Gatherings</p>
          <h2 id="lp-book-title">Hold a table or the garden function room.</h2>
          <p>
            Table bookings go directly by phone on{" "}
            <a href={phoneHref}><strong>{phone}</strong></a>. Planning a larger
            family lunch, ferry stopover or private evening in the rear function
            room? Put your details together here to copy straight into Facebook
            Messenger or read out on a quick call.
          </p>
          <div class="lp-find-inline" id="find">
            <p><strong>7–11 The Square, Strangford, Downpatrick, BT30 7ND</strong></p>
            <p>Moments from the Strangford–Portaferry ferry and Castle Ward.</p>
            <div class="lp-inline-links">
              <a href={mapHref} rel="noopener noreferrer">Open Google Maps ↗</a>
              <a href={facebook} rel="noopener noreferrer">Facebook Page ↗</a>
            </div>
          </div>
        </div>

        <form class="lp-note-form" id="lp-note-form">
          <div class="lp-form-row">
            <label>
              <span>Room preference</span>
              <select name="room">
                <option value="Front Restaurant">Front Restaurant</option>
                <option value="Front Bar">Front Bar (by the stove)</option>
                <option value="Function Room &amp; Hidden Beer Garden">Function Room &amp; Beer Garden</option>
              </select>
            </label>
            <label>
              <span>Party size</span>
              <input name="guests" placeholder="e.g. 4 guests" />
            </label>
          </div>
          <div class="lp-form-row">
            <label>
              <span>Preferred date</span>
              <input type="date" name="date" />
            </label>
            <label>
              <span>Time</span>
              <input name="time" placeholder="e.g. 6:30pm" />
            </label>
          </div>
          <label>
            <span>Dietary or occasion notes (optional)</span>
            <input name="notes" placeholder="e.g. Gluten-free, birthday, ferry arrival time" />
          </label>
          <div class="lp-note-actions">
            <button class="lp-btn lp-btn--navy" type="submit">Copy booking note</button>
            <a class="lp-btn lp-btn--coral" href={phoneHref}>Ring {phone}</a>
            <a class="lp-btn lp-btn--outline" href={facebook} rel="noopener noreferrer">Facebook ↗</a>
          </div>
          <p class="lp-copy-status" id="lp-copy-status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="lp-footer">
    <div class="lp-wrap lp-footer-inner">
      <div class="lp-footer-brand">
        <LpMark size={30} tone="cream" />
        <span><strong>The Lobster Pot</strong> · 7–11 The Square, Strangford, BT30 7ND</span>
      </div>
      <p class="lp-footer-right">
        <a href={phoneHref}>{phoneIntl}</a> · <a href={facebook} rel="noopener noreferrer">Facebook</a>
      </p>
    </div>
  </footer>

  <script>
    const form = document.getElementById("lp-note-form") as HTMLFormElement | null;
    const status = document.getElementById("lp-copy-status");
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const d = new FormData(form);
      const summary = [
        "Table enquiry — The Lobster Pot, Strangford",
        `Room: ${d.get("room") || "Front Restaurant"}`,
        `Date: ${d.get("date") || "To confirm"}`,
        `Time: ${d.get("time") || "To confirm"}`,
        `Party size: ${d.get("guests") || "To confirm"}`,
        ...(d.get("notes") ? [`Notes: ${d.get("notes")}`] : []),
      ].join("\n");
      try {
        await navigator.clipboard.writeText(summary);
        if (status) status.textContent = "Booking note copied — paste it into Facebook Messenger or call 028 4488 1288.";
      } catch {
        if (status) status.textContent = summary;
      }
    });
  </script>
</ConceptLayout>
