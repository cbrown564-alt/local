---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LpMark from "./LpMark.astro";

/* The Lobster Pot — 7–11 The Square, Strangford, Downpatrick, BT30 7ND.
   Sources (checked 26 Nov 2026):
   - FSA FHRS register (Authority 145, inspected 2026-06-18).
   - Visit Mourne Gullion Strangford, NI Good Food, public listings.
   - Listed domain thelobsterpotstrangford.com is DNS dead.
   - Spaces: Front Bar (wood-burning stove, views over Strangford Lough),
     Front Restaurant, Function Room / Private Dining with double doors to
     the hidden beer garden.
   - Food: local lobster, fresh mussels, seafood chowder, battered cod,
     scampi, steaks, chicken, vegetarian dishes, homemade desserts,
     gluten-free options.
   - Phone: +44 28 4488 1288. No public email is listed, so booking calls
     direct or copies a table note for a quick call/Facebook message.
   Brief: research/concepts/the-lobster-pot/the-lobster-pot-elevation-brief.md */

const phone = "028 4488 1288";
const phoneIntl = "+44 28 4488 1288";
const phoneHref = "tel:+442844881288";
const facebook = "https://en-gb.facebook.com/lobsterpotstrangford/";
const mapHref = "https://www.google.com/maps/search/?api=1&query=7-11+The+Square+Strangford+BT30+7ND";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@400;500;600;700&display=swap";

const spaces = [
  {
    no: "01",
    name: "The Front Bar",
    summary: "Cosy traditional village bar overlooking Strangford Lough — soft green and cream tones, historical touches and a warm wood-burning stove.",
  },
  {
    no: "02",
    name: "The Front Restaurant",
    summary: "Relaxed dining room extending from the bar with soft furnishings, local historical pictures and warm lighting for lunch or evening dinner.",
  },
  {
    no: "03",
    name: "Private Dining & Hidden Beer Garden",
    summary: "Light, spacious function room at the rear with double doors opening straight onto our sheltered beer garden for family gatherings and celebrations.",
  },
];

const kitchen = [
  {
    title: "From Strangford Lough & local boats",
    items: [
      "Local Strangford lobster",
      "Fresh mussels",
      "House seafood chowder",
      "Battered cod & scampi",
    ],
  },
  {
    title: "From the grill & kitchen",
    items: [
      "Daily selection of steaks",
      "Chicken & vegetarian mains",
      "Homemade desserts including pecan pie",
      "Gluten-free options accommodated",
    ],
  },
];
---

<ConceptLayout
  title="The Lobster Pot — Seafood Restaurant & Bar, The Square, Strangford"
  slug="the-lobster-pot"
  bodyClass="concept-page concept-lobster"
  lang="en-GB"
  businessName="The Lobster Pot"
  town="Strangford"
  fontHref={fontHref}
  bannerNote="The creel mark and tidal line are drawings made for this page. Table bookings go by phone to 028 4488 1288 or Facebook, matching how The Lobster Pot takes reservations today."
>
  <div class="lp-strip">
    <span>7–11 The Square, Strangford, BT30 7ND · Footsteps from the Strangford–Portaferry Ferry</span>
    <a href={phoneHref}>{phoneIntl}</a>
  </div>

  <header class="lp-header">
    <a class="lp-brand" href="#top">
      <LpMark size={38} tone="coral" />
      <span class="lp-brand-text">
        <strong>The Lobster Pot</strong>
        <small>The Square · Strangford</small>
      </span>
    </a>
    <nav class="lp-nav" aria-label="The Lobster Pot">
      <a href="#spaces">Three Rooms</a>
      <a href="#kitchen">The Kitchen</a>
      <a href="#book">Book a Table</a>
      <a href="#find">Find Us</a>
    </nav>
    <a class="lp-header-call" href={phoneHref}>Call {phone}</a>
  </header>

  <main id="top">
    <section class="lp-hero" aria-labelledby="lp-hero-title">
      <svg class="lp-tide" viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 110 Q 180 65 360 100 T 720 96 T 1080 108 T 1440 82 L 1440 160 L 0 160 Z" fill="rgba(247,244,236,0.06)" />
        <path d="M0 128 Q 220 95 440 122 T 880 114 T 1440 124" stroke="rgba(217,91,67,0.45)" stroke-width="1.5" fill="none" />
      </svg>

      <div class="lp-wrap lp-hero-grid">
        <div class="lp-hero-copy">
          <p class="lp-kicker">Strangford Lough · County Down</p>
          <h1 id="lp-hero-title">Fresh local seafood, a warm stove, <em>and a pint on The Square.</em></h1>
          <p class="lp-lede">
            Right beside the Strangford–Portaferry ferry terminal — local
            lobster, mussels and chowder in the restaurant, a wood-burning
            stove in the front bar, and a private dining room opening onto our
            hidden beer garden.
          </p>
          <div class="lp-hero-actions">
            <a class="lp-btn lp-btn--coral" href={phoneHref}>Book a table: {phone}</a>
            <a class="lp-btn lp-btn--ghost" href="#book">Plan a group or private table</a>
          </div>
        </div>

        <aside class="lp-board" aria-label="At a glance">
          <p class="lp-kicker lp-kicker--dark">On The Square</p>
          <h2>Before you cross the lough</h2>
          <dl class="lp-board-list">
            <div>
              <dt>Where</dt>
              <dd>7–11 The Square, Strangford, BT30 7ND</dd>
            </div>
            <div>
              <dt>Ferry terminal</dt>
              <dd>Footsteps from the Strangford–Portaferry slipway</dd>
            </div>
            <div>
              <dt>Opening</dt>
              <dd>Open daily from around 12 noon; call ahead for current kitchen times</dd>
            </div>
            <div>
              <dt>Bookings</dt>
              <dd><a href={phoneHref}>{phoneIntl}</a></dd>
            </div>
          </dl>
          <a class="lp-btn lp-btn--navy lp-board-btn" href={facebook} rel="noopener noreferrer">Latest specials on Facebook ↗</a>
        </aside>
      </div>
    </section>

    <section class="lp-section lp-spaces" id="spaces" aria-labelledby="lp-spaces-title">
      <div class="lp-wrap">
        <div class="lp-head">
          <div>
            <p class="lp-kicker lp-kicker--dark">The House</p>
            <h2 id="lp-spaces-title">Three distinct rooms under one roof.</h2>
          </div>
          <p class="lp-head-note">
            Whether you are stepping off the ferry for a pint by the fire,
            booking a family seafood supper or gathering a private party out
            towards the garden.
          </p>
        </div>

        <div class="lp-spaces-grid">
          {spaces.map((s) => (
            <article class="lp-space-card">
              <span class="lp-space-no">{s.no}</span>
              <h3>{s.name}</h3>
              <p>{s.summary}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="lp-section lp-kitchen" id="kitchen" aria-labelledby="lp-kitchen-title">
      <div class="lp-wrap lp-kitchen-grid">
        <div>
          <p class="lp-kicker">The Kitchen</p>
          <h2 id="lp-kitchen-title">Built around the lough, welcoming every table.</h2>
          <p class="lp-kitchen-intro">
            Fresh local fish and shellfish lead the board, backed up by steaks,
            vegetarian dishes, homemade desserts and gluten-free choices. Menus
            shift with the catch and the season — ring us or check our Facebook
            page for today's specials.
          </p>
          <div class="lp-kitchen-actions">
            <a class="lp-btn lp-btn--coral" href={phoneHref}>Ask about today's catch: {phone}</a>
            <a class="lp-btn lp-btn--ghost" href={facebook} rel="noopener noreferrer">Facebook updates ↗</a>
          </div>
        </div>

        <div class="lp-menu-cards">
          {kitchen.map((col) => (
            <div class="lp-menu-card">
              <h3>{col.title}</h3>
              <ul>
                {col.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="lp-section lp-book" id="book" aria-labelledby="lp-book-title">
      <div class="lp-wrap lp-book-grid">
        <div>
          <p class="lp-kicker lp-kicker--dark">Tables &amp; Private Dining</p>
          <h2 id="lp-book-title">Book a table or the garden function room.</h2>
          <p>
            We take table bookings directly by phone on{" "}
            <a href={phoneHref}><strong>{phone}</strong></a>. Planning a larger
            table, Sunday lunch or a private gathering in the rear function
            room? Put the details together here so you can copy them straight
            into a Facebook message or read them out on a quick call.
          </p>
        </div>

        <form class="lp-note-form" id="lp-note-form">
          <div class="lp-form-row">
            <label>
              <span>Room preference</span>
              <select name="room">
                <option value="Front Restaurant">Front Restaurant</option>
                <option value="Front Bar">Front Bar</option>
                <option value="Function Room &amp; Beer Garden">Function Room &amp; Beer Garden</option>
              </select>
            </label>
            <label>
              <span>Party size</span>
              <input name="guests" placeholder="e.g. 4 guests" />
            </label>
          </div>
          <div class="lp-form-row">
            <label>
              <span>Preferred date</span>
              <input type="date" name="date" />
            </label>
            <label>
              <span>Time</span>
              <input name="time" placeholder="e.g. 6:30pm" />
            </label>
          </div>
          <label>
            <span>Dietary or occasion notes (optional)</span>
            <input name="notes" placeholder="e.g. Gluten-free, birthday, ferry arrival time" />
          </label>
          <div class="lp-note-actions">
            <button class="lp-btn lp-btn--navy" type="submit">Copy booking note</button>
            <a class="lp-btn lp-btn--coral" href={phoneHref}>Ring {phone}</a>
            <a class="lp-btn lp-btn--outline" href={facebook} rel="noopener noreferrer">Message on Facebook ↗</a>
          </div>
          <p class="lp-copy-status" id="lp-copy-status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <section class="lp-section lp-find" id="find" aria-labelledby="lp-find-title">
      <div class="lp-wrap lp-find-grid">
        <div>
          <p class="lp-kicker lp-kicker--dark">Find Us</p>
          <h2 id="lp-find-title">7–11 The Square, Strangford.</h2>
          <p>
            Right in the heart of Strangford village on the Lecale Peninsula —
            moments from the Strangford–Portaferry ferry and Castle Ward, and a
            short drive from Downpatrick.
          </p>
        </div>
        <div class="lp-find-card">
          <p><strong>The Lobster Pot</strong><br />7–11 The Square, Strangford, Downpatrick, BT30 7ND</p>
          <p>Phone: <a href={phoneHref}>{phoneIntl}</a></p>
          <div class="lp-find-links">
            <a class="lp-btn lp-btn--navy" href={mapHref} rel="noopener noreferrer">Open in Google Maps ↗</a>
            <a class="lp-btn lp-btn--outline" href={facebook} rel="noopener noreferrer">Facebook Page ↗</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="lp-footer">
    <div class="lp-wrap lp-footer-inner">
      <div class="lp-footer-brand">
        <LpMark size={32} tone="cream" />
        <div>
          <strong>The Lobster Pot</strong>
          <span>7–11 The Square, Strangford, BT30 7ND</span>
        </div>
      </div>
      <p class="lp-footer-right">
        <a href={phoneHref}>{phoneIntl}</a> · <a href={facebook} rel="noopener noreferrer">Facebook</a>
      </p>
    </div>
  </footer>

  <script>
    const form = document.getElementById("lp-note-form") as HTMLFormElement | null;
    const status = document.getElementById("lp-copy-status");
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const d = new FormData(form);
      const summary = [
        "Table enquiry — The Lobster Pot, Strangford",
        `Room: ${d.get("room") || "Front Restaurant"}`,
        `Date: ${d.get("date") || "To confirm"}`,
        `Time: ${d.get("time") || "To confirm"}`,
        `Party size: ${d.get("guests") || "To confirm"}`,
        ...(d.get("notes") ? [`Notes: ${d.get("notes")}`] : []),
      ].join("\n");
      try {
        await navigator.clipboard.writeText(summary);
        if (status) status.textContent = "Booking note copied — paste it into Facebook Messenger or call 028 4488 1288.";
      } catch {
        if (status) status.textContent = summary;
      }
    });
  </script>
</ConceptLayout>
