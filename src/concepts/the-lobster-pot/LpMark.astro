---
interface Props {
  size?: number;
  tone?: "coral" | "cream" | "navy" | "current";
}
const { size = 40, tone = "coral" } = Astro.props;
const stroke =
  tone === "current"
    ? "currentColor"
    : tone === "cream"
      ? "#f4f6f7"
      : tone === "navy"
        ? "#0b202e"
        : "#b8422b";
---
<svg width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <circle cx="24" cy="24" r="21" stroke={stroke} stroke-width="1.6" />
  <path d="M14 29C17 26.5 21 26.5 24 29C27 31.5 31 31.5 34 29" stroke={stroke} stroke-width="1.6" stroke-linecap="round" />
  <path d="M16 21C16 15.5 20 12 24 12C28 12 32 15.5 32 21V25H16V21Z" stroke={stroke} stroke-width="1.6" stroke-linejoin="round" />
  <path d="M21 12V25M27 12V25M16 19H32" stroke={stroke} stroke-width="1.2" opacity="0.7" />
</svg>
