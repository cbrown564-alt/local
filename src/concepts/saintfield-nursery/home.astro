---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";

/* Saintfield Nursery Centre — 88 Belfast Road, Saintfield, Co. Down, BT24 7HF.
   Sources (live-fetched 26 Nov 2026): saintfieldnurserycentre.co.uk (/, /contact-us).
   - Plant Finder attributes on live site: Season (Spring, Summer, Autumn, Winter),
     Foliage (Evergreen, Semi-Evergreen, Deciduous), Colour palette, Heights.
   - Ranges stocked: plants, garden furniture, garden supplies, seasonal / Christmas
     decorations & lights, Gift Vouchers.
   - Address: 88 Belfast Road, Saintfield, Co. Down, Northern Ireland, BT24 7HF.
   - Phone: 028 9081 4331 · Email: shop@saintfieldnurserycentre.co.uk.
   Brief: research/concepts/saintfield-nursery/saintfield-nursery-elevation-brief.md */

const phone = "028 9081 4331";
const phoneHref = "tel:+442890814331";
const email = "shop@saintfieldnurserycentre.co.uk";
const vouchersUrl = "https://www.saintfieldnurserycentre.co.uk/products/63/gift-vouchers";
const facebook = "https://www.facebook.com/Saintfield-Nursery-Centre-300837443273056";
const mapHref = "https://www.google.com/maps/search/?api=1&query=88+Belfast+Road+Saintfield+BT24+7HF";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap";

const seasons = ["Spring", "Summer", "Autumn", "Winter"];
const foliageTypes = ["Evergreen", "Semi-Evergreen", "Deciduous"];
const colours = [
  { value: "White and cream", label: "White and cream" },
  { value: "Purple and blue", label: "Purple and blue" },
  { value: "Pink and red", label: "Pink and red" },
  { value: "Yellow and green", label: "Yellow and green" },
];

const departments = [
  {
    name: "Hardy plants and perennials",
    detail:
      "Seasonal colour for Spring, Summer, Autumn, and Winter, with evergreen, semi-evergreen, and deciduous varieties suited to County Down gardens.",
  },
  {
    name: "Garden supplies and compost",
    detail:
      "Everyday tools, pots, compost, and plant feeds for borders, containers, and kitchen gardens.",
  },
  {
    name: "Garden furniture and seasonal displays",
    detail:
      "Outdoor furniture for warmer months and a full Christmas shop of decorations and lights each winter.",
  },
  {
    name: "Gift vouchers",
    detail:
      "A practical present for County Down gardeners, available to collect in Saintfield or order online.",
    linkLabel: "Order Saintfield Nursery gift vouchers ↗",
    linkHref: vouchersUrl,
  },
];
---

<ConceptLayout
  title="Saintfield Nursery Centre, 88 Belfast Road, Saintfield"
  slug="saintfield-nursery"
  bodyClass="concept-page concept-saintfieldnursery"
  lang="en-GB"
  businessName="Saintfield Nursery Centre"
  town="Saintfield"
  fontHref={fontHref}
  bannerNote="The glasshouse and potting bench scenes are AI-generated visualisations. Plant stock checks compose an email to shop@saintfieldnurserycentre.co.uk or call 028 9081 4331; gift vouchers link to Saintfield Nursery Centre's shop."
>
  <header class="sn-header" id="sn-header">
    <div class="sn-wrap sn-header-inner">
      <a class="sn-brand" href="#top">Saintfield Nursery</a>
      <nav class="sn-nav" aria-label="Saintfield Nursery Centre">
        <a href="#finder">Plant finder</a>
        <a href="#departments">In the nursery</a>
        <a href="#visit">Visit and vouchers</a>
      </nav>
      <a class="sn-header-tel" href={phoneHref}>{phone}</a>
    </div>
  </header>

  <main id="top" class="sn-main">
    <section class="sn-hero" aria-labelledby="sn-hero-title">
      <div class="sn-hero-sentinel" id="sn-hero-sentinel" aria-hidden="true"></div>
      <div class="sn-wrap sn-hero-lockup">
        <h1 id="sn-hero-title">Grown for real gardens along the Belfast Road.</h1>
        <p class="sn-lede">
          Hardy perennials, evergreens, garden furniture, everyday supplies, and
          seasonal displays at 88 Belfast Road, Saintfield.
        </p>
        <a class="sn-btn sn-btn--forest" href="#finder">Explore the plant finder</a>
      </div>

      <div class="sn-wrap sn-hero-stage">
        <div class="sn-hero-media">
          <ResponsiveImage
            src="/media/concepts/saintfield-nursery/saintfield-nursery-glasshouse.jpg"
            alt="Sunlit nursery conservatory glasshouse lined with terracotta pots, flowering perennials and trailing evergreens on timber benches"
            width={1376}
            height={768}
            loading="eager"
            sizes="(max-width: 1360px) 92vw, 1240px"
            class="sn-hero-img"
          />
        </div>
        <p class="sn-hero-caption">Indicative sunlit timber glasshouse visualisation.</p>
      </div>
    </section>

    <section class="sn-finder" id="finder" aria-labelledby="sn-finder-title">
      <div class="sn-wrap">
        <div class="sn-finder-head">
          <h2 id="sn-finder-title">Tell us what you are planting and we will check the benches.</h2>
          <p class="sn-finder-note">
            Choose your peak season, foliage, and border colour to send a clear
            stock note straight to <a href={`mailto:${email}`}>{email}</a> or
            call <a href={phoneHref}>{phone}</a>.
          </p>
        </div>

        <form class="sn-finder-form" id="sn-finder-form" data-email={email}>
          <div class="sn-filter-grid">
            <fieldset class="sn-filter-group">
              <legend>Peak season</legend>
              <div class="sn-seg-track sn-seg-track--4">
                {seasons.map((season, i) => (
                  <label class="sn-seg-item">
                    <input
                      type="radio"
                      name="season"
                      value={season}
                      checked={i === 0}
                      data-sn-filter="season"
                    />
                    <span>{season}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <fieldset class="sn-filter-group">
              <legend>Foliage type</legend>
              <div class="sn-seg-track sn-seg-track--3">
                {foliageTypes.map((foliage, i) => (
                  <label class="sn-seg-item">
                    <input
                      type="radio"
                      name="foliage"
                      value={foliage}
                      checked={i === 0}
                      data-sn-filter="foliage"
                    />
                    <span>{foliage}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <fieldset class="sn-filter-group sn-filter-group--wide">
              <legend>Colour palette</legend>
              <div class="sn-seg-track sn-seg-track--4">
                {colours.map((colour, i) => (
                  <label class="sn-seg-item">
                    <input
                      type="radio"
                      name="colour"
                      value={colour.value}
                      checked={i === 0}
                      data-sn-filter="colour"
                    />
                    <span>{colour.label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          </div>

          <div class="sn-finder-inputs">
            <label>
              <span>Specific plant, height, or border notes</span>
              <input name="details" placeholder="e.g. 1m evergreen hedging or shade perennials" />
            </label>
            <label>
              <span>Your name and phone</span>
              <input name="who" placeholder="Name and callback number" required />
            </label>
            <button class="sn-btn sn-btn--forest" type="submit">Ask the nursery</button>
          </div>

          <p class="sn-summary-line" id="sn-summary-line">
            Selected: Spring, Evergreen, White and cream
          </p>
        </form>
      </div>
    </section>

    <section class="sn-depts" id="departments" aria-labelledby="sn-depts-title">
      <div class="sn-wrap sn-depts-grid">
        <div class="sn-depts-list">
          <h2 id="sn-depts-title">Four corners of Saintfield Nursery Centre.</h2>
          <ul class="sn-ledger">
            {departments.map((d) => (
              <li>
                <h3>{d.name}</h3>
                <p>{d.detail}</p>
                {d.linkHref && d.linkLabel && (
                  <a class="sn-ledger-link" href={d.linkHref} rel="noopener noreferrer">
                    {d.linkLabel}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>

        <figure class="sn-potting-plate">
          <ResponsiveImage
            src="/media/concepts/saintfield-nursery/saintfield-nursery-potting-bench.jpg"
            alt="Terracotta pots, brass hand-trowel, garden twine and freshly potted shrubs on an aged wooden bench"
            width={1200}
            height={896}
            sizes="(max-width: 960px) 100vw, 46vw"
            class="sn-potting-img"
          />
          <figcaption>Indicative potting bench and nursery craft visualisation.</figcaption>
        </figure>
      </div>
    </section>

    <section class="sn-visit" id="visit" aria-labelledby="sn-visit-title">
      <div class="sn-wrap sn-visit-grid">
        <div class="sn-visit-copy">
          <h2 id="sn-visit-title">Visit us on the Belfast Road or send a question.</h2>
          <p>
            Call in to browse the benches, garden furniture, seasonal displays,
            and Christmas shop, or order gift vouchers directly online. Ring{" "}
            <a href={phoneHref}>{phone}</a> or write to{" "}
            <a href={`mailto:${email}`}>{email}</a>.
          </p>
          <dl class="sn-visit-ledger">
            <div>
              <dt>Address</dt>
              <dd>88 Belfast Road, Saintfield, Co. Down, BT24 7HF</dd>
            </div>
            <div>
              <dt>Telephone and email</dt>
              <dd>
                <a href={phoneHref}>{phone}</a>
                {" · "}
                <a href={`mailto:${email}`}>{email}</a>
              </dd>
            </div>
            <div>
              <dt>Helpful links</dt>
              <dd>
                <a href={vouchersUrl} rel="noopener noreferrer">Gift vouchers ↗</a>
                {" · "}
                <a href={mapHref} rel="noopener noreferrer">Google Maps ↗</a>
                {" · "}
                <a href={facebook} rel="noopener noreferrer">Facebook ↗</a>
              </dd>
            </div>
          </dl>
        </div>

        <form class="sn-visit-form" id="sn-visit-form" data-email={email}>
          <div class="sn-row">
            <label>
              <span>Enquiry topic</span>
              <select name="topic">
                <option value="Garden furniture and supplies">Garden furniture and supplies</option>
                <option value="Seasonal displays and Christmas shop">Seasonal displays and Christmas shop</option>
                <option value="Gift vouchers">Gift vouchers</option>
                <option value="General nursery enquiry">General nursery enquiry</option>
              </select>
            </label>
            <label>
              <span>Your name</span>
              <input name="name" autocomplete="name" required />
            </label>
          </div>
          <label>
            <span>Phone number</span>
            <input name="phone" type="tel" autocomplete="tel" required />
          </label>
          <label>
            <span>How can we help</span>
            <textarea name="message" rows="3" placeholder="Tell us what you are looking for in the nursery"></textarea>
          </label>
          <button class="sn-btn sn-btn--forest sn-btn--full" type="submit">Open enquiry email</button>
        </form>
      </div>

      <div class="sn-wrap sn-map-wrap">
        <LocalAreaMap
          id="saintfield-nursery-map"
          businessName="Saintfield Nursery"
          address="88 Belfast Road, Saintfield, Co. Down, BT24 7HF"
          lon={-5.833}
          lat={54.457}
          spanKm={16}
          radiusKm={4}
          radiusLabel="Saintfield and A7 Belfast Road"
          mapHref={mapHref}
          kicker=""
          markers={[
            { name: "Crossgar", lon: -5.764, lat: 54.402, note: "8 mins", side: "r" },
            { name: "Ballynahinch", lon: -5.897, lat: 54.402, note: "10 mins", side: "l" },
            { name: "Comber", lon: -5.747, lat: 54.550, note: "14 mins", side: "r" },
            { name: "Downpatrick", lon: -5.716, lat: 54.328, note: "18 mins", side: "r" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="sn-footer">
    <div class="sn-wrap sn-footer-inner">
      <span><strong>Saintfield Nursery Centre</strong>, 88 Belfast Road, Saintfield, Co. Down, BT24 7HF</span>
      <span>
        <a href={phoneHref}>{phone}</a>
        {" · "}
        <a href={`mailto:${email}`}>{email}</a>
        {" · "}
        <a href={vouchersUrl} rel="noopener noreferrer">Gift vouchers ↗</a>
      </span>
    </div>
  </footer>

  <script>
    const header = document.getElementById("sn-header");
    const sentinel = document.getElementById("sn-hero-sentinel");
    if (header && sentinel) {
      const observer = new IntersectionObserver(
        (entries) => {
          const entry = entries[0];
          if (!entry) return;
          header.classList.toggle("is-scrolled", !entry.isIntersecting);
        },
        { threshold: 0 },
      );
      observer.observe(sentinel);
    }

    const state: Record<string, string> = {
      season: "Spring",
      foliage: "Evergreen",
      colour: "White and cream",
    };
    const summaryEl = document.getElementById("sn-summary-line");
    const updateSummary = () => {
      if (summaryEl) {
        summaryEl.textContent = `Selected: ${state.season}, ${state.foliage}, ${state.colour}`;
      }
    };

    document.querySelectorAll<HTMLInputElement>("[data-sn-filter]").forEach((input) => {
      input.addEventListener("change", () => {
        const key = input.dataset.snFilter;
        if (input.checked && key) {
          state[key] = input.value;
          updateSummary();
        }
      });
    });

    const finderForm = document.getElementById("sn-finder-form") as HTMLFormElement | null;
    finderForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      const d = new FormData(finderForm);
      const body = [
        "Plant Stock Enquiry: Saintfield Nursery Centre",
        `Season: ${state.season}`,
        `Foliage: ${state.foliage}`,
        `Colour palette: ${state.colour}`,
        `Details: ${d.get("details") || "General advice"}`,
        `Contact: ${d.get("who") || ""}`,
      ].join("\n");
      const to = finderForm.dataset.email ?? "";
      const subject = `Plant finder enquiry: ${state.season}, ${state.foliage}`;
      const url = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      if (window.dispatchEvent(new CustomEvent("mm:enquiry", { cancelable: true, detail: { to, subject, body, url } }))) {
        window.location.href = url;
      }
    });

    const visitForm = document.getElementById("sn-visit-form") as HTMLFormElement | null;
    visitForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      const d = new FormData(visitForm);
      const topic = String(d.get("topic") || "Nursery enquiry");
      const body = [
        `Topic: ${topic}`,
        `Name: ${d.get("name") || ""}`,
        `Phone: ${d.get("phone") || ""}`,
        "",
        String(d.get("message") || ""),
      ].join("\n");
      const to = visitForm.dataset.email ?? "";
      const subject = `${topic}: Saintfield Nursery Centre`;
      const url = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      if (window.dispatchEvent(new CustomEvent("mm:enquiry", { cancelable: true, detail: { to, subject, body, url } }))) {
        window.location.href = url;
      }
    });
  </script>
</ConceptLayout>
