---
/* Drawn enamel fascia at 22–24 Main Street.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

{compact ? (
  <svg
    class="sv-mark"
    width="44"
    height="44"
    viewBox="0 0 44 44"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="1.5" y="1.5" width="41" height="41" fill="#3a1420"/>
    <rect x="1.5" y="1.5" width="41" height="41" stroke="#d4b06a" stroke-width="1.6"/>
    <text
      x="22"
      y="19"
      text-anchor="middle"
      fill="#f6efe4"
      font-family="Playfair Display, Georgia, serif"
      font-size="9"
      font-weight="700"
      letter-spacing="1.2"
    >SAVOY</text>
    <text
      x="22"
      y="31"
      text-anchor="middle"
      fill="#d4b06a"
      font-family="Sora, system-ui, sans-serif"
      font-size="5.5"
      font-weight="600"
      letter-spacing="0.6"
    >CAFE</text>
  </svg>
) : (
  <svg
    class="sv-fascia"
    viewBox="0 0 960 560"
    role="img"
    aria-label="Savoy Cafe enamel fascia over a Main Street shop window, with 22–24 on the door and Good Food, not Fast Food under the name"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="sv-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#efe6d6"/>
        <stop offset="1" stop-color="#e2d4c0"/>
      </linearGradient>
      <linearGradient id="sv-brick" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#b89a86"/>
        <stop offset="1" stop-color="#9a7a68"/>
      </linearGradient>
      <linearGradient id="sv-glass" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fff8ee" stop-opacity="0.4"/>
        <stop offset="0.55" stop-color="#e8dcc8" stop-opacity="0.1"/>
        <stop offset="1" stop-color="#d4c4ae" stop-opacity="0.28"/>
      </linearGradient>
      <linearGradient id="sv-room" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f7efe2"/>
        <stop offset="1" stop-color="#e8d7bf"/>
      </linearGradient>
      <pattern id="sv-bond" width="30" height="16" patternUnits="userSpaceOnUse">
        <rect width="30" height="16" fill="#a88874"/>
        <rect y="7.5" width="30" height="1.1" fill="#8a6c5c"/>
        <rect x="14.4" width="1.2" height="16" fill="#8a6c5c"/>
      </pattern>
      <pattern id="sv-pave" width="52" height="18" patternUnits="userSpaceOnUse">
        <rect width="52" height="18" fill="#cfc2ae"/>
        <rect x="0" y="16" width="52" height="2" fill="#b8ab97"/>
        <rect x="25" width="1" height="18" fill="#b8ab97"/>
      </pattern>
    </defs>

    <rect width="960" height="560" fill="url(#sv-sky)"/>

    <!-- Upper storey -->
    <rect x="72" y="28" width="816" height="150" fill="url(#sv-brick)"/>
    <rect x="72" y="28" width="816" height="150" fill="url(#sv-bond)" opacity="0.5"/>
    <rect x="72" y="28" width="816" height="10" fill="#7a5c4c"/>

    <g fill="#f3e8d8" stroke="#5c4338" stroke-width="2">
      <rect x="130" y="56" width="92" height="96"/>
      <rect x="280" y="56" width="92" height="96"/>
      <rect x="588" y="56" width="92" height="96"/>
      <rect x="738" y="56" width="92" height="96"/>
    </g>
    <g stroke="#5c4338" stroke-width="1.4">
      <path d="M176 56v96M130 104h92M326 56v96M280 104h92M634 56v96M588 104h92M784 56v96M738 104h92"/>
    </g>

    <!-- Enamel fascia -->
    <rect x="48" y="168" width="864" height="100" fill="#3a1420"/>
    <rect x="48" y="168" width="864" height="7" fill="#d4b06a"/>
    <rect x="48" y="261" width="864" height="7" fill="#d4b06a"/>
    <text
      x="480"
      y="218"
      text-anchor="middle"
      fill="#f6efe4"
      font-family="Playfair Display, Georgia, serif"
      font-size="54"
      font-weight="700"
      letter-spacing="14"
    >SAVOY</text>
    <text
      x="480"
      y="246"
      text-anchor="middle"
      fill="#d4b06a"
      font-family="Sora, system-ui, sans-serif"
      font-size="12"
      font-weight="600"
      letter-spacing="4.5"
    >GOOD FOOD, NOT FAST FOOD</text>

    <!-- Shop body -->
    <rect x="48" y="268" width="864" height="214" fill="#2a1814"/>
    <rect x="68" y="286" width="640" height="180" fill="url(#sv-room)"/>

    <!-- Counter + plates -->
    <rect x="96" y="410" width="584" height="40" fill="#3a1420"/>
    <rect x="96" y="410" width="584" height="7" fill="#d4b06a"/>

    <!-- Coffee cup -->
    <g transform="translate(160 318)">
      <ellipse cx="36" cy="78" rx="34" ry="8" fill="#c9b59a" opacity=".55"/>
      <path d="M8 28h56l-6 50H14Z" fill="#f6efe4" stroke="#3a1420" stroke-width="2"/>
      <ellipse cx="36" cy="28" rx="28" ry="8" fill="#3a1420"/>
      <ellipse cx="36" cy="28" rx="22" ry="5.5" fill="#6b3a28"/>
      <path d="M64 38c14 2 18 16 6 26" fill="none" stroke="#3a1420" stroke-width="2.2"/>
      <path d="M28 8c4-10 12-10 16 0" fill="none" stroke="#9a8a78" stroke-width="1.6" opacity=".7"/>
    </g>

    <!-- Traybake square -->
    <g transform="translate(320 348)">
      <rect x="0" y="18" width="78" height="52" rx="4" fill="#8b5a2b" stroke="#3a1420" stroke-width="1.8"/>
      <rect x="6" y="24" width="66" height="18" fill="#c4894a"/>
      <rect x="6" y="44" width="66" height="18" fill="#a56b34"/>
      <path d="M0 44h78" stroke="#3a1420" stroke-width="1" opacity=".35"/>
    </g>

    <!-- Scone -->
    <g transform="translate(460 352)">
      <ellipse cx="40" cy="58" rx="38" ry="12" fill="#c9b59a" opacity=".5"/>
      <path d="M8 48c4-28 60-28 64 0 2 10-8 18-32 18S6 58 8 48Z" fill="#e8c48a" stroke="#3a1420" stroke-width="1.8"/>
      <path d="M18 40c10-8 34-8 44 0" fill="none" stroke="#c49a58" stroke-width="2"/>
      <ellipse cx="40" cy="36" rx="10" ry="5" fill="#f6efe4" opacity=".85"/>
    </g>

    <!-- Soup bowl -->
    <g transform="translate(580 336)">
      <ellipse cx="42" cy="86" rx="40" ry="9" fill="#c9b59a" opacity=".45"/>
      <path d="M8 40c0 36 10 48 42 48s42-12 42-48" fill="#f6efe4" stroke="#3a1420" stroke-width="2"/>
      <ellipse cx="50" cy="40" rx="36" ry="12" fill="#c45a2c"/>
      <ellipse cx="50" cy="38" rx="22" ry="6" fill="#e07840" opacity=".7"/>
      <path d="M88 48h18c8 0 12 8 6 14" fill="none" stroke="#3a1420" stroke-width="2"/>
    </g>

    <!-- Glass -->
    <rect x="68" y="286" width="640" height="180" fill="url(#sv-glass)"/>
    <path d="M86 296l48 160" stroke="#ffffff" stroke-opacity="0.3" stroke-width="10"/>
    <path d="M152 294l26 162" stroke="#ffffff" stroke-opacity="0.12" stroke-width="6"/>
    <rect x="68" y="286" width="640" height="180" fill="none" stroke="#1c1210" stroke-width="3"/>
    <line x1="388" y1="286" x2="388" y2="466" stroke="#1c1210" stroke-width="2"/>

    <!-- Door with 22–24 -->
    <rect x="728" y="286" width="164" height="212" fill="#f3e8d8" stroke="#1c1210" stroke-width="3"/>
    <rect x="746" y="304" width="128" height="120" fill="#e2d4c0" stroke="#3a1420" stroke-width="2"/>
    <text
      x="810"
      y="368"
      text-anchor="middle"
      fill="#3a1420"
      font-family="Playfair Display, Georgia, serif"
      font-size="36"
      font-weight="700"
    >22–24</text>
    <text
      x="810"
      y="392"
      text-anchor="middle"
      fill="#6b5344"
      font-family="Sora, system-ui, sans-serif"
      font-size="11"
      font-weight="600"
      letter-spacing="1.5"
    >MAIN ST</text>
    <circle cx="872" cy="448" r="4.5" fill="#d4b06a"/>
    <rect x="746" y="440" width="128" height="36" fill="#3a1420"/>

    <!-- Pavement -->
    <rect x="0" y="480" width="960" height="80" fill="url(#sv-pave)"/>
    <rect x="0" y="476" width="960" height="6" fill="#9a8e7a"/>
    <rect x="56" y="532" width="140" height="8" rx="1" fill="#3a1420" opacity="0.28"/>
  </svg>
)}
