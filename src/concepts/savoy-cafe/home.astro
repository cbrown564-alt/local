---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import SavoyFascia from "./SavoyFascia.astro";

/* Savoy Cafe — meal. Speak as the café.
   First-party savoy.cafe live-read 13 Sep 2026 (Europe/London).
   Ethos, door, contact hours, Mallon revival. Contact hours override the
   Mourne Magazine Monday late-night colour on /about/ — do not assert it.
   Revival ≠ continuous trading since the 1930s. Not Seasalt, not Broadway,
   not Mauds, not Piccolo (contrast stays in research). No booking form. */
const phone = "028 4372 5757";
const phoneHref = "tel:+442843725757";
const site = "https://savoy.cafe/";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Sora:wght@400;500;600;700&display=swap";
---

<ConceptLayout
  title={"Savoy Cafe — independent concept"}
  slug="savoy-cafe"
  bodyClass="concept-page concept-savoy"
  lang="en-GB"
  businessName="Savoy Cafe"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The Main Street fascia is a drawing."
>
  <div class="sv-strip">
    <span>22–24 Main Street, Newcastle · BT33 0AD · Good Food, not Fast Food</span>
    <span class="sv-strip-r">
      Mon–Sun 08:00–17:00 · <a href={phoneHref}>{phone}</a>
    </span>
  </div>

  <header class="sv-header">
    <a class="sv-brand" href="/concepts/savoy-cafe/">
      <span class="sv-brand-mark" aria-hidden="true">
        <SavoyFascia compact />
      </span>
      <span class="sv-brand-text">
        <span class="sv-brand-name">Savoy Cafe</span>
        <span class="sv-brand-sub">22–24 Main Street · Newcastle</span>
      </span>
    </a>
    <nav class="sv-nav" aria-label="Concept navigation">
      <a href="#counter">The counter</a>
      <a href="#ethos">Ethos</a>
      <a href="#name">The name</a>
      <a href="#door">The door</a>
    </nav>
    <a class="sv-walk" href="#door">Walk in</a>
  </header>

  <main class="sv-main">
    <section class="sv-hero" aria-labelledby="sv-name">
      <div class="sv-mast">
        <p class="sv-kicker">Family-run · Main Street</p>
        <h1 id="sv-name">Savoy Cafe</h1>
        <p class="sv-number">22–24 Main Street · Newcastle</p>
        <p class="sv-say">Good Food, not Fast Food</p>
        <p class="sv-lede">
          Homemade seasonal food, freshly made to order — breakfast through
          lunch, Fairtrade tea and coffee, traybakes and scones. Walk in,
          ring, or visit our site. There is no table to book online.
        </p>
        <p class="sv-cta">
          <a class="sv-walk sv-walk--inline" href="#door">Walk in</a>
          <a class="sv-ring" href={phoneHref}>Ring {phone}</a>
          <a class="sv-site" href={site} rel="noopener noreferrer">savoy.cafe</a>
        </p>
      </div>

      <aside class="sv-appetite" aria-label="Counter appetite">
        <p class="sv-appetite-kicker">At the counter</p>
        <ul class="sv-appetite-list">
          <li>
            <span class="sv-appetite-name">Breakfast</span>
            <span class="sv-appetite-note">From the full fry to a toasted teacake</span>
          </li>
          <li>
            <span class="sv-appetite-name">Lunch</span>
            <span class="sv-appetite-note">Soups, sandwiches, hot lunch made to order</span>
          </li>
          <li>
            <span class="sv-appetite-name">Treats</span>
            <span class="sv-appetite-note">Homemade traybakes, scones, Fairtrade tea &amp; coffee</span>
          </li>
        </ul>
        <p class="sv-appetite-foot">
          Today’s soup and traybake live on the counter — ring or walk in.
        </p>
      </aside>
    </section>

    <section class="sv-counter" id="counter" aria-labelledby="sv-counter-title">
      <div class="sv-section-head">
        <p class="sv-kicker">The counter</p>
        <h2 id="sv-counter-title">Made to order on Main Street.</h2>
        <p class="sv-section-intro">
          We pride ourselves in making everything fresh to order. Food, drinks,
          and treats — not a fast-food board with prices invented for a screen.
        </p>
      </div>

      <div class="sv-cards" role="list">
        <article class="sv-card" role="listitem">
          <p class="sv-card-kicker">Morning</p>
          <h3>Breakfast</h3>
          <p>
            Our breakfast menu runs from 9am to midday — from the full fry
            through to a toasted teacake topped with cinnamon bananas and
            Greek yogurt.
          </p>
        </article>
        <article class="sv-card" role="listitem">
          <p class="sv-card-kicker">Midday</p>
          <h3>Lunch</h3>
          <p>
            Freshly made soups and sandwiches — fillings with a contemporary
            twist, prepared when you ask for them.
          </p>
        </article>
        <article class="sv-card" role="listitem">
          <p class="sv-card-kicker">Anytime</p>
          <h3>Tea, coffee &amp; traybakes</h3>
          <p>
            Fairtrade teas and coffees with homemade traybakes or a scone.
            Takeaway and sandwich orders welcome — ring ahead if you like.
          </p>
        </article>
      </div>
    </section>

    <section class="sv-ethos" id="ethos" aria-labelledby="sv-ethos-title">
      <p class="sv-kicker sv-kicker--on-dark">Our ethos</p>
      <h2 id="sv-ethos-title">Good Food, not Fast Food</h2>
      <p>
        Homemade Seasonal Food Freshly Made to Order. That is the room —
        family-run, in the centre of Newcastle, County Down.
      </p>
    </section>

    <section class="sv-name-arc" id="name" aria-labelledby="sv-arc-title">
      <div class="sv-paper">
        <p class="sv-kicker">The name</p>
        <h2 id="sv-arc-title">A revived Savoy on Main Street.</h2>
        <p>
          Paddy &amp; Eileen Mallon revived the 1930s Savoy Cafe name and opened
          a modern, fresh café on the site adjacent to where the first café
          stood — over eighty years ago. A contemporary twist on a Newcastle
          name, not unbroken trading since the thirties.
        </p>
        <p class="sv-source">From the welcome piece on our about page · mournemagazine.com</p>
      </div>
    </section>

    <section class="sv-door" id="door" aria-labelledby="sv-door-title">
      <div class="sv-door-copy">
        <p class="sv-kicker">The door</p>
        <h2 id="sv-door-title">22–24 Main Street.</h2>
        <p class="sv-door-lede">
          Walk in. Ring if you like. Or start on our site — then come to the
          counter.
        </p>
        <p class="sv-hours">
          <strong>Hours</strong>
          <span>Mon–Sun 08:00–17:00</span>
          <span class="sv-hours-stamp">From savoy.cafe/contact-us · 13 Sep 2026</span>
        </p>
        <p class="sv-artefact-cta">
          <span class="sv-walk sv-walk--inline">Walk in</span>
          <a class="sv-ring" href={phoneHref}>{phone}</a>
          <a class="sv-site" href={site} rel="noopener noreferrer">savoy.cafe</a>
        </p>
      </div>

      <figure class="sv-artefact">
        <SavoyFascia />
        <figcaption>The fascia on Main Street.</figcaption>
      </figure>

      <address class="sv-address">
        <strong>Savoy Cafe</strong>
        <span>22–24 Main Street</span>
        <span>Newcastle</span>
        <span>County Down</span>
        <span>BT33 0AD</span>
        <a href={phoneHref}>{phone}</a>
        <a href={site} rel="noopener noreferrer">savoy.cafe</a>
        <span>Mon–Sun 08:00–17:00</span>
      </address>
    </section>
  </main>
</ConceptLayout>
