---
/* BSW Autohouse — Interactive MOT, Tyres & Servicing Triage.
   Lets Newcastle drivers pick their workshop job and see the exact bay check
   before ringing Unit 4, 63a Castlewellan Road (Mon–Fri 08:30–17:30). */
interface Props {
  phone: string;
  phoneHref: string;
}
const { phone, phoneHref } = Astro.props;

const jobs = [
  {
    id: "mot",
    label: "MOT Preparation",
    headline: "Pre-MOT inspection so you don't lose your Downpatrick / Newry slot.",
    checks: ["Headlight alignment, bulbs & wipers", "Brakes, suspension bushes & exhaust", "Tyre tread depth, sidewalls & emissions"],
  },
  {
    id: "tyres",
    label: "Tyres & Alignment",
    headline: "Supply, balance and tracking right on Castlewellan Road.",
    checks: ["Budget, mid-range & branded tyres", "Wheel balancing & valve check", "Tracking check for uneven edge wear"],
  },
  {
    id: "service",
    label: "Full / Interim Service",
    headline: "Routine oil, filter and safety servicing for petrol, diesel and hybrid cars.",
    checks: ["Engine oil & filter change", "Air, fuel & cabin filter inspection", "Fluid top-ups, battery & underbody check"],
  },
  {
    id: "diag",
    label: "Warning Light / Brakes",
    headline: "Diagnostic code read & clear quote before any part is fitted.",
    checks: ["OBD fault scan & live sensor check", "Brake pads, discs & caliper inspection", "Clear telephone quote before work starts"],
  },
];
---

<section class="bw-triage-band" id="workshop-triage" aria-labelledby="bw-triage-title">
  <div class="bw-triage-card" data-bw-triage>
    <div class="bw-triage-head">
      <div>
        <p class="bw-triage-kicker">Bay Triage · Unit 4, 63a Castlewellan Road</p>
        <h2 id="bw-triage-title">What does the car need?</h2>
      </div>
      <div class="bw-triage-tabs" role="tablist" aria-label="Workshop job type">
        {jobs.map((j, i) => (
          <button
            type="button"
            role="tab"
            class:list={["bw-job-tab", { "is-active": i === 0 }]}
            aria-selected={i === 0 ? "true" : "false"}
            data-bw-job={j.id}
          >
            {j.label}
          </button>
        ))}
      </div>
    </div>

    {jobs.map((j, i) => (
      <div class="bw-job-panel" role="tabpanel" data-bw-panel={j.id} hidden={i !== 0}>
        <p class="bw-job-lead">{j.headline}</p>
        <ul class="bw-job-checks">
          {j.checks.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    ))}

    <div class="bw-triage-foot">
      <span>Open Mon–Fri 08:30 – 17:30 · Newcastle, County Down</span>
      <a class="bw-triage-cta" href={phoneHref}>Book a bay · {phone}</a>
    </div>
  </div>
</section>

<style>
  .bw-triage-band {
    max-width: 1120px;
    margin: 0 auto;
    padding: 36px 24px 12px;
  }

  .bw-triage-card {
    background: var(--bw-charcoal, #161a1e);
    color: #f4f6f8;
    border-top: 3px solid var(--bw-amber, #e68e19);
    padding: 28px 30px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .bw-triage-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
  }

  .bw-triage-kicker {
    margin: 0 0 6px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bw-amber, #e68e19);
  }

  .bw-triage-head h2 {
    margin: 0;
    font-size: clamp(1.55rem, 2.8vw, 2.1rem);
    color: #ffffff;
  }

  .bw-triage-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .bw-job-tab {
    padding: 8px 13px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: transparent;
    color: rgba(244, 246, 248, 0.84);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 140ms ease, color 140ms ease;
  }

  .bw-job-tab.is-active {
    background: var(--bw-amber, #e68e19);
    border-color: var(--bw-amber, #e68e19);
    color: #14181c;
  }

  .bw-job-lead {
    margin: 0 0 14px;
    font-size: 1rem;
    color: #ffffff;
    font-weight: 600;
  }

  .bw-job-checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .bw-job-checks li {
    padding: 13px 15px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.88rem;
    color: rgba(244, 246, 248, 0.86);
  }

  .bw-triage-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.84rem;
    color: rgba(244, 246, 248, 0.72);
  }

  .bw-triage-cta {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    background: var(--bw-amber, #e68e19);
    color: #14181c;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.86rem;
  }

  @media (max-width: 780px) {
    .bw-job-checks {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const box = document.querySelector<HTMLElement>("[data-bw-triage]");
  if (box) {
    box.querySelectorAll<HTMLButtonElement>("[data-bw-job]").forEach((tab) => {
      tab.addEventListener("click", () => {
        const id = tab.dataset.bwJob || "mot";
        box.querySelectorAll<HTMLButtonElement>("[data-bw-job]").forEach((t) => {
          const on = t === tab;
          t.classList.toggle("is-active", on);
          t.setAttribute("aria-selected", String(on));
        });
        box.querySelectorAll<HTMLElement>("[data-bw-panel]").forEach((p) => {
          p.hidden = p.dataset.bwPanel !== id;
        });
      });
    });
  }
</script>
