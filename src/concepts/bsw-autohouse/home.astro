---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import KeysBack from "./KeysBack.astro";

/* BSW Autohouse — independent garage and tyre specialist on Castlewellan Road.
   Unit 4, 63a Castlewellan Road, Newcastle.
   Phone: 028 4372 7112 · Mobile: 07850 089 802.
   Mon–Fri 08:30–17:30 · Closed Saturday. */
const phone = "028 4372 7112";
const phoneHref = "tel:+442843727112";
const mobile = "07850 089 802";
const mobileHref = "tel:+447850089802";
const site = "https://www.bswtyres.co.uk/";
const contact = "https://www.bswtyres.co.uk/contact/";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap";

const workshopServices = [
  {
    badge: "MOT",
    title: "MOT Preparation & Checks",
    detail: "Full pre-test inspection covering brakes, lights, emissions, steering, and suspension. Replacement bulbs from £5.",
  },
  {
    badge: "Tyres",
    title: "Tyre Supply & Blackcircles Fitting",
    detail: "Approved Blackcircles fitting partner. Extensive stock of premium, mid-range, and budget tyres with computer balancing.",
  },
  {
    badge: "Alignment",
    title: "Computerised Wheel Alignment",
    detail: "Precision laser alignment (£40) to restore straight tracking, prevent tyre wear, and improve vehicle safety.",
  },
  {
    badge: "Diagnostics",
    title: "Snap-On Diagnostic Scanning",
    detail: "Advanced electronic diagnostics for warning lights, engine faults, ABS, and vehicle management systems.",
  },
  {
    badge: "Mechanical",
    title: "Brakes, Exhausts & Suspension",
    detail: "Pads, discs, full exhaust replacements, shock absorbers, coil springs, and general mechanical servicing.",
  },
  {
    badge: "Billing",
    title: "Half-Hour Transparent Labour",
    detail: "No inflated minimum charges. Honest labour billed by the half-hour with same-day completion wherever possible.",
  },
];
---

<ConceptLayout
  title={"BSW Autohouse — independent concept"}
  slug="bsw-autohouse"
  bodyClass="concept-page concept-bsw-autohouse"
  lang="en-GB"
  businessName="BSW Autohouse"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The keys-back ticket is a drawing."
>
  <div class="bw-strip">
    <span>Unit 4, 63a Castlewellan Road, Newcastle · Female-led garage &amp; workshop</span>
    <span class="bw-strip-r">
      <a href={phoneHref}>{phone}</a>
      <span class="bw-strip-sep" aria-hidden="true">·</span>
      <a href={mobileHref}>{mobile}</a>
    </span>
  </div>

  <header class="bw-header">
    <a class="bw-brand" href="/concepts/bsw-autohouse/">
      <span class="bw-brand-mark" aria-hidden="true">
        <KeysBack compact />
      </span>
      <span class="bw-brand-text">
        <span class="bw-brand-name">BSW Autohouse</span>
        <span class="bw-brand-sub">Unit 4 · Castlewellan Road</span>
      </span>
    </a>
    <nav class="bw-nav" aria-label="Concept navigation">
      <a href="#services">Workshop Bays</a>
      <a href="#team">Our Team</a>
      <a href="#booking">Book In</a>
      <a href="#location">Find Us</a>
    </nav>
    <a class="bw-ring-nav" href={phoneHref}>Call Workshop</a>
  </header>

  <main class="bw-main">
    <section class="bw-hero" aria-labelledby="bw-name">
      <div class="bw-hero-main">
        <div class="bw-hero-tag">Newcastle · Castlewellan · Dundrum</div>
        <h1 id="bw-name">BSW Autohouse</h1>
        <p class="bw-location-line">Unit 4, 63a Castlewellan Road · Newcastle</p>
        <p class="bw-hero-say">Road-ready service from Unit 4 — honest mechanics, clear pricing, same-day where we can.</p>
        <p class="bw-hero-lede">
          An approachable, female-led garage team where every driver is welcomed and treated with straightforward respect.
          From laser wheel alignment and tyre fitting to pre-MOT testing and Snap-On diagnostics, we keep you safely on the road.
        </p>
        <div class="bw-hero-actions">
          <a class="bw-btn bw-btn--primary" href={phoneHref}>Ring {phone}</a>
          <a class="bw-btn bw-btn--mobile" href={mobileHref}>Mobile {mobile}</a>
          <a class="bw-btn bw-btn--outline" href={contact} rel="noopener noreferrer">Online Enquiry</a>
        </div>
      </div>

      <aside class="bw-hours-card" aria-label="Workshop Hours and Schedule">
        <div class="bw-hours-header">
          <span class="bw-hours-title">Workshop Hours</span>
          <span class="bw-hours-status">Drive-in &amp; Booking</span>
        </div>
        <div class="bw-hours-table">
          <div class="bw-hours-row">
            <span>Monday – Friday</span>
            <strong>08:30 – 17:30</strong>
          </div>
          <div class="bw-hours-row">
            <span>Saturday – Sunday</span>
            <strong>Closed</strong>
          </div>
        </div>
        <div class="bw-hours-perks">
          <div class="bw-perk-item">
            <span class="bw-perk-icon" aria-hidden="true">✓</span>
            <span>Free on-site customer parking</span>
          </div>
          <div class="bw-perk-item">
            <span class="bw-perk-icon" aria-hidden="true">✓</span>
            <span>Approved Blackcircles fitting station</span>
          </div>
          <div class="bw-perk-item">
            <span class="bw-perk-icon" aria-hidden="true">✓</span>
            <span>Transparent half-hour labour rates</span>
          </div>
        </div>
      </aside>
    </section>

    <section class="bw-services-section" id="services" aria-labelledby="bw-services-title">
      <div class="bw-section-header">
        <span class="bw-kicker">The Workshop</span>
        <h2 id="bw-services-title">Specialist Vehicle Services &amp; MOT Care</h2>
        <p class="bw-section-lede">
          Our workshop bays are fully equipped for passenger cars, light commercial vehicles, and 4x4s across Newcastle and South Down.
        </p>
      </div>

      <div class="bw-services-grid" role="list">
        {workshopServices.map((svc) => (
          <article class="bw-service-bay" role="listitem">
            <div class="bw-service-badge">{svc.badge}</div>
            <h3>{svc.title}</h3>
            <p>{svc.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="bw-team-section" id="team" aria-labelledby="bw-team-title">
      <div class="bw-team-container">
        <div class="bw-team-content">
          <span class="bw-kicker">The People</span>
          <h2 id="bw-team-title">Adelle, Berny, and the Bay Team</h2>
          <p class="bw-team-text">
            Founded on Castlewellan Road, BSW Autohouse is managed by Adelle and Sean, with Berny in the front office
            and Robbie, Darren, and Martin on the vehicle tools. We pride ourselves on creating an environment that breaks
            the intimidating garage stereotype — transparent explanations, honest advice, and zero unnecessary work.
          </p>
          <blockquote class="bw-team-quote">
            “An honest, welcoming garage where you always get a straight answer and work done right the first time.”
          </blockquote>
        </div>

        <div class="bw-team-artefact">
          <KeysBack />
          <p class="bw-artefact-label">The road-ready keys-back moment at Unit 4.</p>
        </div>
      </div>
    </section>

    <section class="bw-booking-section" id="booking" aria-labelledby="bw-booking-title">
      <div class="bw-booking-card">
        <div class="bw-booking-info">
          <span class="bw-kicker">Bookings &amp; Advice</span>
          <h2 id="bw-booking-title">Get Booked in at Unit 4</h2>
          <p>
            Whether your vehicle needs an annual service, tyres fitted, laser alignment, or a pre-MOT inspection,
            give Adelle or Berny a call. We will advise you on the quickest turn-around and get your keys back in hand.
          </p>
          <div class="bw-booking-buttons">
            <a class="bw-btn bw-btn--primary" href={phoneHref}>Call {phone}</a>
            <a class="bw-btn bw-btn--mobile" href={mobileHref}>Mobile {mobile}</a>
            <a class="bw-btn bw-btn--outline" href={contact} rel="noopener noreferrer">Message Our Office</a>
          </div>
        </div>

        <address class="bw-garage-address" id="location">
          <strong>BSW Autohouse</strong>
          <span>Unit 4, 63a Castlewellan Road</span>
          <span>Newcastle, County Down</span>
          <span>Open Mon–Fri 08:30 – 17:30</span>
          <a class="bw-address-phone" href={phoneHref}>{phone}</a>
          <a class="bw-address-link" href={site} rel="noopener noreferrer">bswtyres.co.uk</a>
        </address>
      </div>
    </section>
  </main>
</ConceptLayout>
