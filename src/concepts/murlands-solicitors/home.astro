---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import MrlMatterRouter from "./MrlMatterRouter.astro";
import "./styles.css";

/* Murlands Solicitors — 2 Dromore Street, Ballynahinch BT24 8AG & Downpatrick.
   Verified live 26 Nov 2026: murlands.co.uk prints "outdatedbrowser.com" warning, raw --> leak & dup nav.
   191 years of legal practice in County Down. Ballynahinch 028 9756 2209, Downpatrick 028 4461 9980, law@murlands.co.uk. */
const ballyPhone = "028 9756 2209";
const ballyHref = "tel:+442897562209";
const downPhone = "028 4461 9980";
const downHref = "tel:+442844619980";
const email = "law@murlands.co.uk";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Murlands+Solicitors+2+Dromore+Street+Ballynahinch+BT24+8AG";
---

<ConceptLayout
  title="Murlands Solicitors — Ballynahinch & Downpatrick"
  slug="murlands-solicitors"
  bodyClass="concept-page concept-murlands"
  businessName="Murlands Solicitors"
  town="Ballynahinch"
  bannerNote="Imagery comprises indicative County Down legal chambers and office visualisations."
>
  <header class="mr-header">
    <div class="mr-header-inner">
      <a class="mr-brand" href="#top">
        <strong>Murlands Solicitors</strong>
        <span>191 Years · Ballynahinch &amp; Downpatrick</span>
      </a>
      <nav class="mr-nav" aria-label="Primary">
        <a href="#practice">Practice Areas</a>
        <a href="#offices">Our Offices</a>
        <a href="#contact">Enquire</a>
        <a href="#location">Find Us</a>
      </nav>
      <div class="mr-header-actions">
        <a class="mr-header-tel" href={ballyHref}>{ballyPhone}</a>
        <a class="mr-header-cta" href="#contact">Speak to a Solicitor</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="mr-hero" aria-labelledby="mr-hero-title">
      <div class="mr-wrap mr-hero-grid">
        <div>
          <p class="mr-kicker">County Down Legal Practice · 191 Years</p>
          <h1 id="mr-hero-title">Traditional values. Timeless experience. Modern legal advice.</h1>
          <p class="mr-lead">
            One of Northern Ireland's oldest independent legal practices — advising families, landowners
            and businesses from our Ballynahinch and Downpatrick offices.
          </p>
          <div class="mr-actions">
            <a class="mr-btn mr-btn--primary" href="#contact">Arrange a Consultation</a>
            <a class="mr-btn mr-btn--outline" href="#practice">Explore Practice Areas</a>
          </div>
        </div>
        <figure class="mr-hero-plate">
          <picture>
            <source srcset="/media/concepts/murlands-solicitors/murlands-chambers-hero-640.webp 640w, /media/concepts/murlands-solicitors/murlands-chambers-hero-1265.webp 1265w" sizes="(max-width: 900px) 100vw, 52vw" type="image/webp" />
            <img src="/media/concepts/murlands-solicitors/murlands-chambers-hero.jpg" alt="Georgian legal chambers interior with dark heritage-green panelling, walnut conference table and brass lamp" width="1408" height="768" loading="eager" />
          </picture>
          <figcaption>County Down legal chambers. Indicative practice visualisation.</figcaption>
        </figure>
      </div>
    </section>

    <MrlMatterRouter />

    <section class="mr-section mr-offices" id="offices" aria-labelledby="mr-off-title">
      <div class="mr-wrap mr-split">
        <figure class="mr-plate">
          <picture>
            <source srcset="/media/concepts/murlands-solicitors/murlands-county-down-desk-640.webp 640w, /media/concepts/murlands-solicitors/murlands-county-down-desk-1265.webp 1265w" sizes="(max-width: 860px) 100vw, 48vw" type="image/webp" />
            <img src="/media/concepts/murlands-solicitors/murlands-county-down-desk.jpg" alt="Solicitor's oak desk with parchment deeds tied in green ribbon beside a sunlit County Down sash window" width="1408" height="768" loading="lazy" />
          </picture>
          <figcaption>Property deeds &amp; private client practice. Indicative office visualisation.</figcaption>
        </figure>
        <div>
          <p class="mr-kicker">Two County Down Offices</p>
          <h2 id="mr-off-title">Direct access to your solicitor in Ballynahinch or Downpatrick.</h2>
          <div class="mr-office-cards">
            <article>
              <h3>Ballynahinch Office</h3>
              <p>2 Dromore Street, Ballynahinch, BT24 8AG</p>
              <a href={ballyHref}>{ballyPhone}</a>
            </article>
            <article>
              <h3>Downpatrick Office</h3>
              <p>Downpatrick, County Down</p>
              <a href={downHref}>{downPhone}</a>
            </article>
          </div>
          <p class="mr-email-line">General &amp; new instructions: <a href={`mailto:${email}`}>{email}</a></p>
        </div>
      </div>
    </section>

    <section class="mr-section mr-contact" id="contact" aria-labelledby="mr-con-title">
      <div class="mr-wrap mr-split">
        <div>
          <p class="mr-kicker">Confidential Enquiry</p>
          <h2 id="mr-con-title">Tell us briefly how we can help.</h2>
          <p>
            Outline your matter and preferred office below. A solicitor from the appropriate team will respond
            directly to arrange a telephone or in-person appointment.
          </p>
        </div>
        <form class="mr-form" data-mr-form>
          <div class="mr-row">
            <label>
              <span>Your name</span>
              <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
            </label>
            <label>
              <span>Telephone</span>
              <input name="phone" type="tel" required autocomplete="tel" placeholder="028 / 07..." />
            </label>
          </div>
          <div class="mr-row">
            <label>
              <span>Area of law</span>
              <select name="area">
                <option value="Property & Conveyancing">Property &amp; Conveyancing</option>
                <option value="Wills, Probate & Estates">Wills, Probate &amp; Estates</option>
                <option value="Commercial / Business Law">Law for Business &amp; Leases</option>
                <option value="Family / Personal Law">Family or Personal Matter</option>
              </select>
            </label>
            <label>
              <span>Preferred office</span>
              <select name="office">
                <option value="Ballynahinch (2 Dromore St)">Ballynahinch Office</option>
                <option value="Downpatrick">Downpatrick Office</option>
                <option value="Telephone / Either">Telephone / Either Office</option>
              </select>
            </label>
          </div>
          <label>
            <span>Brief summary</span>
            <textarea name="notes" rows="3" placeholder="A short outline of your enquiry (please avoid sensitive account numbers)..."></textarea>
          </label>
          <button class="mr-btn mr-btn--primary" type="submit">Send Confidential Enquiry</button>
        </form>
      </div>
    </section>

    <section class="mr-section" id="location" aria-label="Ballynahinch office map">
      <div class="mr-wrap">
        <LocalAreaMap
          id="mr-map"
          kicker="Ballynahinch & Downpatrick"
          businessName="Murlands Solicitors"
          address="2 Dromore Street, Ballynahinch, BT24 8AG"
          lon={-5.8975554}
          lat={54.4005445}
          spanKm={20}
          mapHref={mapsHref}
          markers={[
            { name: "Downpatrick Office", lon: -5.7168, lat: 54.3286, note: "16 mins south-east", side: "r" },
            { name: "Saintfield", lon: -5.8338, lat: 54.4581, note: "9 mins north", side: "t" },
            { name: "Castlewellan", lon: -5.9442, lat: 54.2596, note: "16 mins south", side: "b" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="mr-footer">
    <div class="mr-wrap mr-footer-inner">
      <div>
        <strong>Murlands Solicitors</strong>
        <p>2 Dromore Street, Ballynahinch, BT24 8AG · Downpatrick, Co. Down</p>
      </div>
      <div class="mr-footer-links">
        <a href={ballyHref}>Ballynahinch {ballyPhone}</a>
        <a href={downHref}>Downpatrick {downPhone}</a>
        <a href={`mailto:${email}`}>{email}</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const form = document.querySelector("[data-mr-form]");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        const subject = `New Instruction Enquiry — ${fd.get("area")} (${fd.get("office")})`;
        const body = [
          `Name: ${fd.get("name")}`,
          `Phone: ${fd.get("phone")}`,
          `Area: ${fd.get("area")}`,
          `Office: ${fd.get("office")}`,
          `Summary: ${fd.get("notes") || "None"}`,
        ].join("\n");
        const ev = new CustomEvent("mm:enquiry", {
          cancelable: true,
          detail: { to: "law@murlands.co.uk", subject, body, phone: "028 9756 2209", phoneHref: "tel:+442897562209" },
        });
        if (document.dispatchEvent(ev)) {
          window.location.href = `mailto:law@murlands.co.uk?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }
      });
    })();
  </script>
</ConceptLayout>
