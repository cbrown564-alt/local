---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import MrlMatterRouter from "./MrlMatterRouter.astro";
import "./styles.css";

/* Murlands Solicitors, 2 Dromore Street, Ballynahinch BT24 8AG and Downpatrick.
   191 years of legal practice in County Down.
   Ballynahinch 028 9756 2209, Downpatrick 028 4461 9980, law@murlands.co.uk. */
const ballyPhone = "028 9756 2209";
const ballyHref = "tel:+442897562209";
const downPhone = "028 4461 9980";
const downHref = "tel:+442844619980";
const email = "law@murlands.co.uk";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Murlands+Solicitors+2+Dromore+Street+Ballynahinch+BT24+8AG";
---

<ConceptLayout
  title="Murlands Solicitors, Ballynahinch and Downpatrick"
  slug="murlands-solicitors"
  bodyClass="concept-page concept-murlands"
  businessName="Murlands Solicitors"
  town="Ballynahinch"
  bannerNote="Imagery comprises indicative County Down legal chambers and office visualisations."
>
  <header class="mr-header" data-mr-header>
    <div class="mr-header-inner">
      <a class="mr-brand" href="#top">Murlands Solicitors</a>
      <nav class="mr-nav" aria-label="Primary">
        <a href="#practice">Practice areas</a>
        <a href="#offices">Offices</a>
        <a href="#contact">Enquiry</a>
        <a href="#location">Location</a>
      </nav>
      <div class="mr-header-actions">
        <a class="mr-header-tel" href={ballyHref}>{ballyPhone}</a>
        <a class="mr-header-cta" href="#contact">Consultation</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="mr-hero" aria-labelledby="mr-hero-title">
      <span class="mr-hero-sentinel" data-mr-sentinel aria-hidden="true"></span>
      <div class="mr-wrap">
        <div class="mr-hero-top">
          <h1 id="mr-hero-title">Measured legal counsel rooted in County Down.</h1>
          <div class="mr-hero-side">
            <p class="mr-hero-lead">
              Independent solicitors advising County Down families, landowners, and businesses from
              Ballynahinch and Downpatrick for 191 years.
            </p>
            <a class="mr-btn mr-btn--primary" href="#contact">Arrange a consultation</a>
          </div>
        </div>

        <div class="mr-hero-plate">
          <picture>
            <source
              srcset="/media/concepts/murlands-solicitors/murlands-chambers-hero-640.webp 640w, /media/concepts/murlands-solicitors/murlands-chambers-hero-1265.webp 1265w"
              sizes="100vw"
              type="image/webp"
            />
            <img
              src="/media/concepts/murlands-solicitors/murlands-chambers-hero.jpg"
              alt="Georgian legal chambers interior with dark heritage-green panelling, walnut conference table, and brass lamp"
              width="1408"
              height="768"
              loading="eager"
            />
          </picture>
          <p class="mr-hero-caption">Indicative County Down legal chambers visualisation.</p>
        </div>
      </div>
    </section>

    <MrlMatterRouter />

    <section class="mr-section mr-contact" id="contact" aria-labelledby="mr-off-title">
      <div class="mr-wrap mr-split">
        <div class="mr-col" id="offices">
          <h2 id="mr-off-title">Direct access to your solicitor in Ballynahinch or Downpatrick.</h2>
          <p class="mr-body">
            Outline your matter and preferred office. A solicitor from the appropriate team will respond
            directly to arrange a telephone or in-person appointment in strict confidence.
          </p>
          <dl class="mr-office-list">
            <div>
              <dt>Ballynahinch office</dt>
              <dd>2 Dromore Street, BT24 8AG, <a href={ballyHref}>{ballyPhone}</a></dd>
            </div>
            <div>
              <dt>Downpatrick office</dt>
              <dd>Downpatrick, County Down, <a href={downHref}>{downPhone}</a></dd>
            </div>
            <div>
              <dt>New instructions</dt>
              <dd><a href={`mailto:${email}`}>{email}</a></dd>
            </div>
            <div>
              <dt>Practice standing</dt>
              <dd>191 years of unbroken County Down practice</dd>
            </div>
          </dl>
        </div>

        <div class="mr-col">
          <form class="mr-form" data-mr-form aria-label="Confidential legal enquiry">
            <h3 class="mr-form-title">Send a confidential enquiry</h3>
            <p class="mr-form-intro">
              Share a brief outline of your matter and which office suits you best.
            </p>
            <div class="mr-row">
              <label>
                <span>Your name</span>
                <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
              </label>
              <label>
                <span>Telephone</span>
                <input name="phone" type="tel" required autocomplete="tel" placeholder="028 or 07 number" />
              </label>
            </div>
            <div class="mr-row">
              <label>
                <span>Area of law</span>
                <select name="area" data-mr-area-select>
                  <option value="Property and conveyancing">Property and conveyancing</option>
                  <option value="Wills, estates, and family">Wills, estates, and family</option>
                  <option value="Commercial and litigation">Commercial and litigation</option>
                </select>
              </label>
              <label>
                <span>Preferred office</span>
                <select name="office">
                  <option value="Ballynahinch (2 Dromore Street)">Ballynahinch office</option>
                  <option value="Downpatrick">Downpatrick office</option>
                  <option value="Telephone or either office">Telephone or either office</option>
                </select>
              </label>
            </div>
            <label>
              <span>Brief summary</span>
              <textarea name="notes" rows="3" placeholder="Short outline of your enquiry (please omit sensitive account numbers)"></textarea>
            </label>
            <button class="mr-btn mr-btn--primary" type="submit">Send confidential enquiry</button>
          </form>
        </div>
      </div>
    </section>

    <section class="mr-section mr-map-band" id="location" aria-label="Ballynahinch office map">
      <div class="mr-wrap">
        <LocalAreaMap
          id="mr-map"
          kicker=""
          businessName="Murlands Solicitors"
          address="2 Dromore Street, Ballynahinch, BT24 8AG"
          lon={-5.8975554}
          lat={54.4005445}
          spanKm={20}
          mapHref={mapsHref}
          markers={[
            { name: "Downpatrick Office", lon: -5.7168, lat: 54.3286, note: "16 mins south-east", side: "r" },
            { name: "Saintfield", lon: -5.8338, lat: 54.4581, note: "9 mins north", side: "t" },
            { name: "Castlewellan", lon: -5.9442, lat: 54.2596, note: "16 mins south", side: "b" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="mr-footer">
    <div class="mr-wrap mr-footer-inner">
      <div>
        <strong>Murlands Solicitors</strong>
        <p>2 Dromore Street, Ballynahinch, BT24 8AG, and Downpatrick, County Down</p>
      </div>
      <div class="mr-footer-links">
        <a href={ballyHref}>Ballynahinch {ballyPhone}</a>
        <a href={downHref}>Downpatrick {downPhone}</a>
        <a href={`mailto:${email}`}>{email}</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-mr-header]");
      const sentinel = document.querySelector("[data-mr-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            const entry = entries[0];
            header.classList.toggle("is-scrolled", !entry.isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      const form = document.querySelector("[data-mr-form]");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        const subject = `New instruction enquiry: ${fd.get("area")} (${fd.get("office")})`;
        const body = [
          `Name: ${fd.get("name")}`,
          `Phone: ${fd.get("phone")}`,
          `Area of law: ${fd.get("area")}`,
          `Preferred office: ${fd.get("office")}`,
          `Summary: ${fd.get("notes") || "None"}`,
        ].join("\n");
        const ev = new CustomEvent("mm:enquiry", {
          cancelable: true,
          detail: { to: "law@murlands.co.uk", subject, body, phone: "028 9756 2209", phoneHref: "tel:+442897562209" },
        });
        if (window.dispatchEvent(ev)) {
          window.location.href = `mailto:law@murlands.co.uk?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }
      });
    })();
  </script>
</ConceptLayout>
