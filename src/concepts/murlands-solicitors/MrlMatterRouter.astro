---
/* Murlands Solicitors: Interactive Practice Areas Stage.
   Helps County Down clients frame their matter before ringing Ballynahinch or Downpatrick
   or sending a confidential enquiry. */
const matters = [
  {
    id: "property",
    label: "Property and conveyancing",
    title: "Residential sales, purchases, remortgages, and agricultural land transfers.",
    summary: "Direct solicitor handling from agreed offer to completion, backed by clear fee estimates and local knowledge of County Down title.",
    points: [
      { term: "Fees and timing", detail: "Clear written fee estimate and expected timeline set out from day one." },
      { term: "Local handling", detail: "Direct solicitor contact across Ballynahinch, Downpatrick, and surrounding parishes." },
      { term: "Preparing ahead", detail: "Bring photo ID, mortgage agreement in principle if buying, and estate agent details." },
    ],
    cta: "Request a property consultation",
    selectValue: "Property and conveyancing",
  },
  {
    id: "wills",
    label: "Wills, estates, and family",
    title: "Carefully drafted Wills, Enduring Powers of Attorney, probate, and family law.",
    summary: "Plain-spoken guidance for inheritance planning, estate administration, and sensitive personal decisions.",
    points: [
      { term: "Wills and powers", detail: "Succession planning and Enduring Powers of Attorney explained without jargon." },
      { term: "Probate and family", detail: "Thorough estate administration and discreet, measured family law counsel." },
      { term: "Accessible visits", detail: "Home or hospital visits arranged where needed, with a short checklist sent ahead." },
    ],
    cta: "Request a private client call",
    selectValue: "Wills, estates, and family",
  },
  {
    id: "commercial",
    label: "Commercial and litigation",
    title: "Commercial leases, business structuring, agri-business, and court representation.",
    summary: "Practical Northern Ireland legal counsel for local companies, farming enterprises, and individuals facing disputes.",
    points: [
      { term: "Commercial property", detail: "Commercial lease negotiations, renewals, and property acquisitions." },
      { term: "Business counsel", detail: "Partnership agreements, shareholder structuring, and agri-business advice." },
      { term: "Representation", detail: "Experienced Northern Ireland court representation and dispute resolution." },
    ],
    cta: "Request a commercial consultation",
    selectValue: "Commercial and litigation",
  },
];
---

<section class="mr-stage" id="practice" aria-labelledby="mr-router-title">
  <div class="mr-wrap mr-stage-grid" data-mr-router>
    <div class="mr-stage-copy">
      <h2 id="mr-router-title">Practice areas for County Down families and businesses.</h2>

      <div class="mr-tabs" role="tablist" aria-label="Practice areas">
        {matters.map((m, idx) => (
          <button
            type="button"
            role="tab"
            id={`mr-tab-${m.id}`}
            aria-controls={`mr-panel-${m.id}`}
            aria-selected={idx === 0 ? "true" : "false"}
            tabindex={idx === 0 ? "0" : "-1"}
            class:list={["mr-tab", idx === 0 && "is-active"]}
            data-mr-tab={m.id}
          >
            {m.label}
          </button>
        ))}
      </div>

      {matters.map((m, idx) => (
        <div
          class="mr-panel"
          role="tabpanel"
          id={`mr-panel-${m.id}`}
          aria-labelledby={`mr-tab-${m.id}`}
          data-mr-panel={m.id}
          hidden={idx !== 0}
        >
          <h3 class="mr-panel-title">{m.title}</h3>
          <p class="mr-panel-summary">{m.summary}</p>
          <dl class="mr-ledger">
            {m.points.map((pt) => (
              <div class="mr-ledger-row">
                <dt>{pt.term}</dt>
                <dd>{pt.detail}</dd>
              </div>
            ))}
          </dl>
          <a class="mr-btn mr-btn--light" href="#contact" data-mr-select-area={m.selectValue}>
            {m.cta}
          </a>
        </div>
      ))}
    </div>

    <div class="mr-stage-media">
      <figure class="mr-plate">
        <picture>
          <source
            srcset="/media/concepts/murlands-solicitors/murlands-county-down-desk-640.webp 640w, /media/concepts/murlands-solicitors/murlands-county-down-desk-1265.webp 1265w"
            sizes="(max-width: 960px) 100vw, 44vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/murlands-solicitors/murlands-county-down-desk.jpg"
            alt="Solicitor oak desk with parchment deeds tied in green ribbon beside a sunlit County Down sash window"
            width="1408"
            height="768"
            loading="lazy"
          />
        </picture>
        <figcaption>Indicative property deeds and private client office visualisation.</figcaption>
      </figure>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-mr-router]");
    if (!root) return;
    const tabs = [...root.querySelectorAll("[data-mr-tab]")];
    const panels = [...root.querySelectorAll("[data-mr-panel]")];

    const activate = (btn, moveFocus) => {
      const id = btn.getAttribute("data-mr-tab");
      tabs.forEach((t) => {
        const active = t === btn;
        t.classList.toggle("is-active", active);
        t.setAttribute("aria-selected", active ? "true" : "false");
        t.setAttribute("tabindex", active ? "0" : "-1");
      });
      panels.forEach((p) => {
        p.hidden = p.getAttribute("data-mr-panel") !== id;
      });
      if (moveFocus) btn.focus();
    };

    tabs.forEach((btn, idx) => {
      btn.addEventListener("click", () => activate(btn, false));
      btn.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") {
          e.preventDefault();
          activate(tabs[(idx + 1) % tabs.length], true);
        } else if (e.key === "ArrowLeft") {
          e.preventDefault();
          activate(tabs[(idx - 1 + tabs.length) % tabs.length], true);
        }
      });
    });

    root.querySelectorAll("[data-mr-select-area]").forEach((link) => {
      link.addEventListener("click", () => {
        const val = link.getAttribute("data-mr-select-area");
        const select = document.querySelector("[data-mr-area-select]");
        if (select && val) {
          select.value = val;
          select.dispatchEvent(new Event("change", { bubbles: true }));
        }
      });
    });
  })();
</script>
