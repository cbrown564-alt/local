---
/* Murlands Solicitors — Interactive Legal Matter Router.
   Helps County Down clients frame their matter (Property, Wills, Commercial, Family)
   before ringing Ballynahinch or Downpatrick or sending a confidential enquiry. */
const matters = [
  {
    id: "property",
    label: "Property & Conveyancing",
    title: "Residential sales, purchases, remortgages and agricultural land transfers.",
    points: ["Clear fee estimate & timeline from day one", "Direct solicitor handling across County Down", "Dedicated Ballynahinch & Downpatrick offices"],
    note: "Bring photo ID, mortgage agreement in principle (if buying) and estate agent details.",
  },
  {
    id: "wills",
    label: "Wills, Probate & Estates",
    title: "Carefully drafted Wills, Enduring Powers of Attorney and estate administration.",
    points: ["Plain-spoken inheritance & succession planning", "Sensitive, thorough probate administration", "Home or hospital visits arranged where needed"],
    note: "We send a short confidential checklist beforehand so your meeting is calm and productive.",
  },
  {
    id: "business",
    label: "Law for Business",
    title: "Commercial leases, company structuring, agri-business and dispute advice.",
    points: ["Commercial property & lease negotiations", "Partnership & shareholder agreements", "Practical County Down & NI commercial counsel"],
    note: "Share your draft heads of terms or lease ahead of our initial consultation.",
  },
  {
    id: "personal",
    label: "Law for You",
    title: "Family law, personal litigation and trusted personal representation.",
    points: ["Discreet, measured guidance through difficult decisions", "Experienced Northern Ireland court representation", "191 years of unbroken local practice"],
    note: "All initial enquiries are treated in strict professional confidence.",
  },
];
---

<section class="mr-router-band" id="practice" aria-labelledby="mr-router-title">
  <div class="mr-wrap">
    <div class="mr-router-card" data-mr-router>
      <div class="mr-router-head">
        <div>
          <p class="mr-kicker">191 Years of Practice · Law for Business &amp; Law for You</p>
          <h2 id="mr-router-title">How can our solicitors advise you?</h2>
        </div>
        <div class="mr-tabs" role="tablist" aria-label="Choose legal area">
          {matters.map((m, idx) => (
            <button
              type="button"
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
              class:list={["mr-tab", idx === 0 && "is-active"]}
              data-mr-tab={m.id}
            >
              {m.label}
            </button>
          ))}
        </div>
      </div>

      {matters.map((m, idx) => (
        <div class="mr-panel" role="tabpanel" data-mr-panel={m.id} hidden={idx !== 0}>
          <h3>{m.title}</h3>
          <ul class="mr-points">
            {m.points.map((pt) => <li>{pt}</li>)}
          </ul>
          <div class="mr-panel-foot">
            <p class="mr-note"><strong>Preparing for your call:</strong> {m.note}</p>
            <a class="mr-btn mr-btn--primary" href="#contact">Request a Confidential Call</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .mr-router-band { padding: clamp(48px, 6vw, 76px) 0; }
  .mr-router-card {
    background: #ffffff;
    border: 1px solid rgba(22, 38, 31, 0.14);
    border-top: 3px solid #1d4232;
    padding: clamp(24px, 4vw, 40px);
    border-radius: 2px;
  }
  .mr-router-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 18px;
    padding-bottom: 22px;
    border-bottom: 1px solid rgba(22, 38, 31, 0.12);
  }
  .mr-router-head h2 { margin: 0; font-family: var(--mr-serif); font-size: clamp(1.75rem, 3.2vw, 2.5rem); font-weight: 500; }
  .mr-tabs { display: flex; flex-wrap: wrap; gap: 8px; }
  .mr-tab {
    padding: 9px 15px;
    border: 1px solid rgba(22, 38, 31, 0.22);
    background: #f7f6f1;
    color: #16261f;
    font-family: var(--mr-sans);
    font-size: 0.84rem;
    font-weight: 600;
    border-radius: 2px;
    cursor: pointer;
  }
  .mr-tab.is-active { background: #1d4232; border-color: #1d4232; color: #f7f6f1; }
  .mr-panel { padding-top: 24px; }
  .mr-panel h3 { margin: 0 0 18px; font-family: var(--mr-serif); font-size: 1.45rem; font-weight: 500; }
  .mr-points {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .mr-points li {
    background: #f7f6f1;
    border: 1px solid rgba(22, 38, 31, 0.1);
    padding: 14px 16px;
    font-size: 0.9rem;
    color: #16261f;
  }
  .mr-panel-foot { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; }
  .mr-note { margin: 0; font-size: 0.9rem; color: #4b5d54; max-width: 54ch; }
  .mr-note strong { color: #16261f; }
  @media (max-width: 780px) { .mr-points { grid-template-columns: minmax(0, 1fr); } }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-mr-router]");
    if (!root) return;
    const tabs = [...root.querySelectorAll("[data-mr-tab]")];
    const panels = [...root.querySelectorAll("[data-mr-panel]")];
    tabs.forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-mr-tab");
        tabs.forEach((t) => {
          const active = t === btn;
          t.classList.toggle("is-active", active);
          t.setAttribute("aria-selected", active ? "true" : "false");
        });
        panels.forEach((p) => { p.hidden = p.getAttribute("data-mr-panel") !== id; });
      });
    });
  })();
</script>
