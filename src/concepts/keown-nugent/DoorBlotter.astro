---
/* Drawn door at 26 Railway Street: Brunswick panels, brass 26,
   nameplate, letterbox, and a Law Society listing in the fanlight.
   Honesty that it is a drawing lives in bannerNote, not the caption.
   Not a desk. Not 123A. Not Cregagh Road. */
---

<svg
  class="kn-blotter"
  viewBox="0 0 640 920"
  role="img"
  aria-label="Drawn door at 26 Railway Street, Newcastle: a green door, brass number 26, Keown Nugent nameplate, and a Law Society listing in the fanlight for Anna Marie Nugent and John Keown"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="kn-wall" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#d9d3c6"/>
      <stop offset="1" stop-color="#c8c0b2"/>
    </linearGradient>
    <linearGradient id="kn-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#cfd8dc"/>
      <stop offset="1" stop-color="#e4e8e6"/>
    </linearGradient>
    <linearGradient id="kn-leaf" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2a5a4a"/>
      <stop offset="1" stop-color="#1a3d32"/>
    </linearGradient>
    <linearGradient id="kn-panel" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#245445"/>
      <stop offset="1" stop-color="#16382e"/>
    </linearGradient>
    <linearGradient id="kn-brass-g" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#d4b06a"/>
      <stop offset="1" stop-color="#9a7038"/>
    </linearGradient>
    <linearGradient id="kn-step" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#b7b0a4"/>
      <stop offset="1" stop-color="#9a9388"/>
    </linearGradient>
    <linearGradient id="kn-card" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fbf8f1"/>
      <stop offset="1" stop-color="#efe6d4"/>
    </linearGradient>
    <linearGradient id="kn-glass" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f4f8f9" stop-opacity="0.35"/>
      <stop offset="1" stop-color="#c5d0d4" stop-opacity="0.18"/>
    </linearGradient>
    <pattern id="kn-mortar" width="48" height="16" patternUnits="userSpaceOnUse">
      <path d="M0 15h48" stroke="#b7b0a4" stroke-width="1.1" opacity=".55"/>
      <path d="M24 0v16" stroke="#b7b0a4" stroke-width=".7" opacity=".35"/>
    </pattern>
  </defs>

  <rect width="640" height="920" fill="url(#kn-wall)"/>
  <rect width="640" height="920" fill="url(#kn-mortar)" opacity=".45"/>

  <!-- Quiet street light above the door, not a portrait of Main Street -->
  <rect x="96" y="18" width="448" height="86" fill="url(#kn-sky)"/>
  <path d="M96 86h448v18H96Z" fill="#b8c0c2"/>

  <!-- Stone architrave -->
  <rect x="78" y="108" width="484" height="742" fill="#cfc8ba"/>
  <rect x="94" y="124" width="452" height="710" fill="#b9b2a4"/>
  <rect x="108" y="138" width="424" height="682" fill="#1a2e28"/>

  <!-- Fanlight -->
  <rect x="124" y="152" width="392" height="118" fill="#0f241e"/>
  <rect x="136" y="164" width="120" height="94" fill="#dfe6e8"/>
  <rect x="260" y="164" width="120" height="94" fill="#e7eeef"/>
  <rect x="384" y="164" width="120" height="94" fill="#dfe6e8"/>

  <!-- Law Society listing in the left light — this door, these names -->
  <g transform="translate(144 172)">
    <rect x="0" y="0" width="104" height="78" fill="url(#kn-card)" stroke="#1f4a3c" stroke-width="1.2"/>
    <rect x="0" y="0" width="104" height="12" fill="#1f4a3c"/>
    <text
      x="52"
      y="9"
      text-anchor="middle"
      fill="#f4f1ea"
      font-family="Public Sans, Segoe UI, sans-serif"
      font-size="4.4"
      font-weight="700"
      letter-spacing="0.4"
    >LAW SOCIETY OF NI</text>
    <text
      x="52"
      y="22"
      text-anchor="middle"
      fill="#1a2420"
      font-family="EB Garamond, Georgia, serif"
      font-size="6.2"
      font-weight="700"
    >Keown Nugent</text>
    <text
      x="52"
      y="30"
      text-anchor="middle"
      fill="#1f4a3c"
      font-family="Public Sans, Segoe UI, sans-serif"
      font-size="4.2"
      font-weight="700"
      letter-spacing="0.6"
    >SOLICITORS LTD</text>
    <text
      x="52"
      y="42"
      text-anchor="middle"
      fill="#1a2420"
      font-family="Public Sans, Segoe UI, sans-serif"
      font-size="4.6"
      font-weight="600"
    >ANNA MARIE NUGENT PPP</text>
    <text
      x="52"
      y="50"
      text-anchor="middle"
      fill="#1a2420"
      font-family="Public Sans, Segoe UI, sans-serif"
      font-size="4.6"
      font-weight="600"
    >JOHN KEOWN PPP</text>
    <text
      x="52"
      y="62"
      text-anchor="middle"
      fill="#4d5c56"
      font-family="Public Sans, Segoe UI, sans-serif"
      font-size="4.2"
    >26 Railway Street</text>
    <text
      x="52"
      y="70"
      text-anchor="middle"
      fill="#4d5c56"
      font-family="Public Sans, Segoe UI, sans-serif"
      font-size="3.8"
    >Newcastle · 028 4333 0055</text>
  </g>

  <rect x="136" y="164" width="368" height="94" fill="url(#kn-glass)"/>
  <line x1="256" y1="164" x2="256" y2="258" stroke="#0f241e" stroke-width="6"/>
  <line x1="380" y1="164" x2="380" y2="258" stroke="#0f241e" stroke-width="6"/>
  <rect x="124" y="152" width="392" height="118" fill="none" stroke="#0a1c18" stroke-width="3"/>

  <!-- Door leaf -->
  <rect x="124" y="278" width="392" height="524" fill="url(#kn-leaf)"/>
  <rect x="124" y="278" width="392" height="8" fill="#0f241e"/>

  <!-- Four panels -->
  <rect x="148" y="306" width="152" height="168" fill="none" stroke="#0f241e" stroke-width="7"/>
  <rect x="156" y="314" width="136" height="152" fill="url(#kn-panel)"/>
  <rect x="340" y="306" width="152" height="168" fill="none" stroke="#0f241e" stroke-width="7"/>
  <rect x="348" y="314" width="136" height="152" fill="url(#kn-panel)"/>
  <rect x="148" y="500" width="152" height="196" fill="none" stroke="#0f241e" stroke-width="7"/>
  <rect x="156" y="508" width="136" height="180" fill="url(#kn-panel)"/>
  <rect x="340" y="500" width="152" height="196" fill="none" stroke="#0f241e" stroke-width="7"/>
  <rect x="348" y="508" width="136" height="180" fill="url(#kn-panel)"/>

  <!-- Brass 26 -->
  <g transform="translate(248 348)">
    <ellipse cx="72" cy="46" rx="54" ry="40" fill="url(#kn-brass-g)"/>
    <ellipse cx="72" cy="46" rx="48" ry="34" fill="none" stroke="#6a4a22" stroke-width="1.4"/>
    <text
      x="72"
      y="58"
      text-anchor="middle"
      fill="#2a1c10"
      font-family="EB Garamond, Georgia, serif"
      font-size="42"
      font-weight="700"
    >26</text>
  </g>

  <!-- Nameplate -->
  <g transform="translate(214 432)">
    <rect x="0" y="0" width="212" height="36" rx="1" fill="url(#kn-brass-g)"/>
    <rect x="4" y="4" width="204" height="28" fill="none" stroke="#6a4a22" stroke-width="1"/>
    <text
      x="106"
      y="18"
      text-anchor="middle"
      fill="#2a1c10"
      font-family="Public Sans, Segoe UI, sans-serif"
      font-size="8"
      font-weight="700"
      letter-spacing="1.6"
    >KEOWN NUGENT</text>
    <text
      x="106"
      y="30"
      text-anchor="middle"
      fill="#3a2a14"
      font-family="Public Sans, Segoe UI, sans-serif"
      font-size="6"
      font-weight="600"
      letter-spacing="1.8"
    >SOLICITORS</text>
  </g>

  <!-- Knocker -->
  <g transform="translate(456 360)">
    <circle cx="16" cy="10" r="7" fill="url(#kn-brass-g)"/>
    <path d="M6 18c0 14 20 14 20 0" fill="none" stroke="#b08a4a" stroke-width="5" stroke-linecap="round"/>
  </g>

  <!-- Letterbox -->
  <g transform="translate(248 560)">
    <rect x="0" y="0" width="144" height="28" rx="2" fill="url(#kn-brass-g)"/>
    <rect x="8" y="8" width="128" height="8" rx="1" fill="#1a2420"/>
    <rect x="8" y="8" width="128" height="3" fill="#3a4a44"/>
  </g>

  <!-- Threshold -->
  <rect x="96" y="808" width="448" height="22" fill="url(#kn-step)"/>
  <rect x="78" y="828" width="484" height="18" fill="#8a8478"/>
  <rect x="0" y="846" width="640" height="74" fill="#9a9388"/>
  <rect x="0" y="846" width="640" height="6" fill="#7a7468"/>

  <text
    x="320"
    y="888"
    text-anchor="middle"
    fill="#3a3630"
    font-family="Public Sans, Segoe UI, sans-serif"
    font-size="11"
    font-weight="700"
    letter-spacing="2.4"
  >26 RAILWAY STREET · BT33 0AL</text>
</svg>
