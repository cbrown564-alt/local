---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import CaravanDocket from "./CaravanDocket.astro";

/* Speaks as the showroom at Unit 2, 63a Castlewellan Road.
   Distinct from 63. Ring, email, their contact page — no fake
   configurator, no second catalogue, no EssenceMedia.
   No Alan Kerr. No 2014 opening-year chrome. */
const phone = "028 4372 7676";
const phoneHref = "tel:+442843727676";
const email = "first4floorsni@gmail.com";
const mailto = `mailto:${email}`;
const site = "https://www.firstfloornewcastle.co.uk";
const contact = `${site}/contact`;
const caravanHref = `${site}/caravans-re-flooring`;
const fontHref =
  "https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Sora:wght@400;500;600;700&display=swap";
---

<ConceptLayout
  title={"First 4 Floors — independent concept"}
  slug="first-4-floors"
  bodyClass="concept-page concept-f4"
  lang="en-GB"
  businessName="First 4 Floors"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The docket is a drawing of the showroom slip for Unit 2, 63a Castlewellan Road."
>
  <div class="f4-strip">
    <span>Unit 2, 63a Castlewellan Road, Newcastle · BT33 0JX</span>
    <span class="f4-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="f4-header">
    <a class="f4-brand" href="/concepts/first-4-floors/">
      <span class="f4-brand-mark" aria-hidden="true">
        <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
          <rect width="44" height="44" fill="#f4efe6"/>
          <rect x="3" y="3" width="18" height="18" fill="#c9a06a"/>
          <rect x="23" y="3" width="18" height="18" fill="#d8c4a8"/>
          <rect x="3" y="23" width="18" height="18" fill="#8f6a4a"/>
          <rect x="23" y="23" width="18" height="18" fill="#e7ddd0"/>
          <path d="M3 12.5h18M23 12.5h18M3 32.5h18M23 32.5h18" stroke="#2c2824" stroke-opacity=".18" stroke-width="1"/>
        </svg>
      </span>
      <span class="f4-brand-text">
        <span class="f4-brand-name">First 4 Floors</span>
        <span class="f4-brand-sub">Unit 2 · 63a Castlewellan Road</span>
      </span>
    </a>
    <nav class="f4-nav" aria-label="Concept navigation">
      <a href="#showroom">Showroom</a>
      <a href="#caravan">Caravan</a>
      <a href="#docket">Docket</a>
    </nav>
    <a class="f4-ring-btn" href={phoneHref}>Ring</a>
  </header>

  <main class="f4-main">
    <section class="f4-hero" aria-labelledby="f4-name">
      <div class="f4-hero-copy">
        <p class="f4-kicker">Flooring specialists · Newcastle, County Down</p>
        <h1 id="f4-name">First 4 Floors</h1>
        <p class="f4-unit">Unit 2, 63a Castlewellan Road</p>
        <p class="f4-say">Including the caravan.</p>
        <p class="f4-lede">
          One of the premier suppliers of flooring across the County Down
          area. From lounge carpets to vinyl for kitchens — and the
          awkward shapes inside a van.
        </p>
        <p class="f4-cta">
          <a class="f4-ring-btn f4-ring-btn--inline" href={phoneHref}>{phone}</a>
          <a class="f4-ghost" href="#showroom">Visit the showroom</a>
        </p>
      </div>
      <div class="f4-bay" aria-hidden="true">
        <span class="f4-bay-light"></span>
        <span class="f4-plank f4-plank--a"></span>
        <span class="f4-plank f4-plank--b"></span>
        <span class="f4-plank f4-plank--c"></span>
        <span class="f4-plank f4-plank--d"></span>
        <span class="f4-bay-label">Unit 2 · daylight</span>
      </div>
    </section>

    <section class="f4-folio" id="showroom" aria-labelledby="f4-showroom-title">
      <p class="f4-folio-mark">First 4 Floors · Unit 2 · 63a Castlewellan Road · Newcastle</p>
      <div class="f4-spread">
        <div class="f4-spread-col">
          <p class="f4-kicker">Showroom</p>
          <h2 id="f4-showroom-title">Come and see what we have in store.</h2>
          <p>
            If you are unsure about what to buy, our team can offer expert
            advice and make recommendations that will help you make an
            inspired choice. Visit the showroom at Unit 2 to see the samples
            in daylight.
          </p>
          <p class="f4-hours">
            Monday–Friday 9:30–17:00 · Saturday 9:30–14:00 · Sunday closed
          </p>
        </div>
        <div class="f4-spread-col" id="caravan">
          <p class="f4-kicker">Caravan</p>
          <h2>All aspects of caravan flooring.</h2>
          <p>
            Replacement in a van is awkward because the interior is a
            unique shape. We specialise in that work: durable carpets and
            vinyl cut for the van, measured from the showroom at Unit 2.
          </p>
          <p class="f4-handoff">
            Ranges live on
            <a href={site} rel="noopener noreferrer">firstfloornewcastle.co.uk</a>
            — vinyl, carpets, laminate, LVT waterproof, and
            <a href={caravanHref} rel="noopener noreferrer">caravan re-flooring</a>.
            Cormar, Phloor, Lifestyle Floors, Regency, Abingdon: see them there.
          </p>
        </div>
      </div>
    </section>

    <section class="f4-docket" id="docket" aria-labelledby="f4-docket-title">
      <div class="f4-docket-copy">
        <p class="f4-kicker">Docket</p>
        <h2 id="f4-docket-title">The slip for Unit 2.</h2>
        <p class="f4-docket-lede">
          Ring, write, or use the contact page. We measure, supply and fit
          — lounge, kitchen, or the caravan.
        </p>
        <ul class="f4-chips" aria-label="How to start">
          <li><a href={phoneHref}>Ring</a></li>
          <li><a href={mailto}>Email</a></li>
          <li><a href={contact} rel="noopener noreferrer">Contact page</a></li>
        </ul>
        <p class="f4-artefact-cta">
          <a class="f4-ring-btn f4-ring-btn--inline" href={phoneHref}>{phone}</a>
          <a class="f4-mail" href={mailto}>{email}</a>
        </p>
      </div>

      <figure class="f4-artefact">
        <CaravanDocket />
        <figcaption>The caravan docket for Unit 2.</figcaption>
      </figure>

      <address class="f4-address">
        <strong>First 4 Floors</strong>
        <span>Unit 2, 63a Castlewellan Road</span>
        <span>Newcastle, Co. Down</span>
        <span>BT33 0JX</span>
        <a href={phoneHref}>{phone}</a>
        <a href={mailto}>{email}</a>
        <a href={site} rel="noopener noreferrer">firstfloornewcastle.co.uk</a>
      </address>
    </section>
  </main>
</ConceptLayout>
