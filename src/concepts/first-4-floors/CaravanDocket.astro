---
/* Drawn showroom docket for a caravan re-floor at Unit 2, 63a.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
---

<svg
  class="f4-clip"
  viewBox="0 0 960 640"
  role="img"
  aria-label="Showroom docket for First 4 Floors at Unit 2, 63a Castlewellan Road, Newcastle: caravan re-floor measure, ring, email"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="f4-day" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f7f1e6"/>
      <stop offset="1" stop-color="#e8dcc8"/>
    </linearGradient>
    <linearGradient id="f4-sheet" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fffaf2"/>
      <stop offset="1" stop-color="#f3eadc"/>
    </linearGradient>
    <linearGradient id="f4-kraft" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#c9a06a"/>
      <stop offset="1" stop-color="#8f6a4a"/>
    </linearGradient>
    <pattern id="f4-perf" width="18" height="18" patternUnits="userSpaceOnUse">
      <circle cx="9" cy="9" r="3.2" fill="#e8dcc8"/>
    </pattern>
  </defs>

  <rect width="960" height="640" fill="url(#f4-day)"/>
  <rect x="0" y="0" width="960" height="640" fill="none" stroke="#d8c4a8" stroke-width="0"/>

  <!-- Table shadow -->
  <rect x="118" y="48" width="724" height="552" rx="4" fill="#cbbba0" opacity=".35"/>

  <!-- Docket sheet -->
  <rect x="108" y="32" width="744" height="560" rx="3" fill="url(#f4-sheet)" stroke="#d4c4aa" stroke-width="1.2"/>
  <rect x="108" y="32" width="42" height="560" fill="url(#f4-perf)"/>
  <rect x="148" y="32" width="2" height="560" fill="#c9a06a"/>
  <rect x="108" y="32" width="744" height="10" fill="url(#f4-kraft)"/>

  <text
    x="534"
    y="78"
    text-anchor="middle"
    fill="#2c2824"
    font-family="Instrument Serif, Georgia, serif"
    font-size="36"
    font-weight="400"
    letter-spacing="1.4"
  >FIRST 4 FLOORS</text>
  <text
    x="534"
    y="104"
    text-anchor="middle"
    fill="#8f6a4a"
    font-family="Sora, Segoe UI, sans-serif"
    font-size="12"
    font-weight="600"
    letter-spacing="4.2"
  >SHOWROOM DOCKET</text>
  <text
    x="534"
    y="136"
    text-anchor="middle"
    fill="#2c2824"
    font-family="Sora, Segoe UI, sans-serif"
    font-size="15"
    font-weight="600"
    letter-spacing="1.8"
  >UNIT 2 · 63a CASTLEWELLAN ROAD</text>
  <text
    x="534"
    y="158"
    text-anchor="middle"
    fill="#6a6258"
    font-family="Sora, Segoe UI, sans-serif"
    font-size="12"
    font-weight="500"
    letter-spacing="1.8"
  >NEWCASTLE · CO. DOWN · BT33 0JX</text>

  <line x1="176" y1="176" x2="812" y2="176" stroke="#d4c4aa" stroke-width="1"/>

  <!-- Caravan plan -->
  <g transform="translate(176 198)">
    <text
      x="0"
      y="0"
      fill="#8f6a4a"
      font-family="Sora, Segoe UI, sans-serif"
      font-size="10"
      font-weight="600"
      letter-spacing="2"
    >JOB · CARAVAN RE-FLOOR</text>

    <!-- Van body -->
    <rect x="8" y="22" width="292" height="118" rx="18" fill="#fffaf2" stroke="#2c2824" stroke-width="1.8"/>
    <!-- Nose -->
    <path d="M300 48h36c10 0 18 10 18 22s-8 22-18 22h-36" fill="#fffaf2" stroke="#2c2824" stroke-width="1.8"/>
    <!-- Wheel arches cutting the floor -->
    <path d="M52 140c0-16 12-28 28-28s28 12 28 28" fill="#f3eadc" stroke="#2c2824" stroke-width="1.6"/>
    <path d="M200 140c0-16 12-28 28-28s28 12 28 28" fill="#f3eadc" stroke="#2c2824" stroke-width="1.6"/>
    <!-- Floor field -->
    <rect x="28" y="40" width="252" height="62" fill="#e7ddd0"/>
    <path d="M28 56h252M28 72h252M28 88h252" stroke="#c9a06a" stroke-opacity=".55" stroke-width="1"/>
    <text
      x="154"
      y="76"
      text-anchor="middle"
      fill="#2c2824"
      font-family="Sora, Segoe UI, sans-serif"
      font-size="11"
      font-weight="600"
      letter-spacing="1.4"
    >UNIQUE INTERIOR SHAPE</text>
    <text
      x="0"
      y="168"
      fill="#6a6258"
      font-family="Sora, Segoe UI, sans-serif"
      font-size="11"
      font-weight="500"
    >Carpets and vinyl cut for the van.</text>
  </g>

  <!-- Ticks -->
  <g transform="translate(560 214)" fill="none">
    <g>
      <rect x="0" y="0" width="16" height="16" stroke="#2c2824" stroke-width="1.5"/>
      <path d="M3.5 9l3.5 3.5 7-8" stroke="#8f6a4a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <text
        x="26"
        y="13"
        fill="#2c2824"
        font-family="Sora, Segoe UI, sans-serif"
        font-size="14"
        font-weight="600"
      >Measure at Unit 2</text>
    </g>
    <g transform="translate(0 36)">
      <rect x="0" y="0" width="16" height="16" stroke="#2c2824" stroke-width="1.5"/>
      <path d="M3.5 9l3.5 3.5 7-8" stroke="#8f6a4a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <text
        x="26"
        y="13"
        fill="#2c2824"
        font-family="Sora, Segoe UI, sans-serif"
        font-size="14"
        font-weight="600"
      >Carpet / vinyl</text>
    </g>
    <g transform="translate(0 72)">
      <rect x="0" y="0" width="16" height="16" stroke="#2c2824" stroke-width="1.5"/>
      <path d="M3.5 9l3.5 3.5 7-8" stroke="#8f6a4a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <text
        x="26"
        y="13"
        fill="#2c2824"
        font-family="Sora, Segoe UI, sans-serif"
        font-size="14"
        font-weight="600"
      >Supply and fit</text>
    </g>
    <text
      x="0"
      y="128"
      fill="#6a6258"
      font-family="Sora, Segoe UI, sans-serif"
      font-size="11"
      font-weight="500"
    >Ring · email · contact page</text>
  </g>

  <line x1="176" y1="432" x2="812" y2="432" stroke="#d4c4aa" stroke-width="1"/>

  <text
    x="176"
    y="468"
    fill="#6a6258"
    font-family="Sora, Segoe UI, sans-serif"
    font-size="11"
    font-weight="600"
    letter-spacing="1.6"
  >SHOWROOM</text>
  <text
    x="176"
    y="492"
    fill="#2c2824"
    font-family="Sora, Segoe UI, sans-serif"
    font-size="14"
    font-weight="600"
  >Unit 2, 63a Castlewellan Road</text>
  <text
    x="176"
    y="514"
    fill="#6a6258"
    font-family="Sora, Segoe UI, sans-serif"
    font-size="13"
    font-weight="500"
  >Mon–Fri 9:30–17:00 · Sat 9:30–14:00</text>

  <text
    x="812"
    y="492"
    text-anchor="end"
    fill="#2c2824"
    font-family="Instrument Serif, Georgia, serif"
    font-size="22"
  >028 4372 7676</text>
  <text
    x="812"
    y="518"
    text-anchor="end"
    fill="#8f6a4a"
    font-family="Sora, Segoe UI, sans-serif"
    font-size="13"
    font-weight="600"
  >first4floorsni@gmail.com</text>
</svg>
