---
/* Drawn cardboard cup sleeve at 21 Central Promenade.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

{compact ? (
  <svg
    class="su-mark"
    width="44"
    height="44"
    viewBox="0 0 44 44"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <rect width="44" height="44" rx="8" fill="#0f5c52"/>
    <rect x="12" y="8" width="20" height="28" rx="3" fill="#faf6eb" stroke="#c8e86c" stroke-width="1.4"/>
    <path d="M14 14h16M14 30h16" stroke="#1a6b5c" stroke-width="1.2" opacity="0.35"/>
    <text
      x="22"
      y="24"
      text-anchor="middle"
      fill="#0f5c52"
      font-family="Fraunces, Georgia, serif"
      font-size="7"
      font-weight="700"
      letter-spacing="0.4"
    >SUCOS</text>
    <circle cx="22" cy="11" r="1.4" fill="#f5a962"/>
  </svg>
) : (
  <svg
    class="su-sleeve"
    viewBox="0 0 720 560"
    role="img"
    aria-label="Sucos Shake N Juice cardboard cup sleeve naming 21 Central Promenade, Newcastle"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="su-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e8f6f2"/>
        <stop offset="1" stop-color="#d4ebe4"/>
      </linearGradient>
      <linearGradient id="su-card" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#faf6eb"/>
        <stop offset="1" stop-color="#efe6d4"/>
      </linearGradient>
      <linearGradient id="su-cup" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ffffff"/>
        <stop offset="1" stop-color="#f0e8d8"/>
      </linearGradient>
      <linearGradient id="su-juice" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f5a962"/>
        <stop offset="0.55" stop-color="#e8784a"/>
        <stop offset="1" stop-color="#c45c7a"/>
      </linearGradient>
      <linearGradient id="su-lid" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1a6b5c"/>
        <stop offset="1" stop-color="#0f5c52"/>
      </linearGradient>
    </defs>

    <rect width="720" height="560" fill="url(#su-sky)"/>

    <!-- Soft prom wash -->
    <ellipse cx="560" cy="480" rx="220" ry="48" fill="#b8ddd4" opacity="0.45"/>
    <ellipse cx="160" cy="500" rx="160" ry="36" fill="#c8e86c" opacity="0.22"/>

    <!-- Cup body -->
    <path
      d="M248 168 L278 468 H442 L472 168 Z"
      fill="url(#su-cup)"
      stroke="#1a2a28"
      stroke-width="2.2"
    />
    <!-- Juice fill visible above sleeve -->
    <path
      d="M256 188 L268 300 H452 L464 188 Z"
      fill="url(#su-juice)"
      opacity="0.92"
    />
    <!-- Foam top -->
    <ellipse cx="360" cy="188" rx="104" ry="14" fill="#fff8ee" opacity="0.85"/>

    <!-- Lid -->
    <rect x="236" y="148" width="248" height="28" rx="8" fill="url(#su-lid)"/>
    <rect x="248" y="140" width="224" height="14" rx="6" fill="#0f5c52"/>
    <!-- Straw -->
    <rect x="392" y="72" width="14" height="92" rx="4" fill="#c8e86c" stroke="#1a6b5c" stroke-width="1.2"/>
    <rect x="392" y="72" width="14" height="18" rx="4" fill="#f5a962"/>

    <!-- Cardboard sleeve -->
    <path
      d="M262 292 L278 430 H442 L458 292 Z"
      fill="url(#su-card)"
      stroke="#1a6b5c"
      stroke-width="2.4"
    />
    <path
      d="M268 304 H452"
      stroke="#c8e86c"
      stroke-width="3"
      stroke-linecap="round"
    />
    <path
      d="M272 414 H448"
      stroke="#c8e86c"
      stroke-width="2.2"
      stroke-linecap="round"
      opacity="0.7"
    />

    <text
      x="360"
      y="342"
      text-anchor="middle"
      fill="#0f5c52"
      font-family="Fraunces, Georgia, serif"
      font-size="36"
      font-weight="700"
      letter-spacing="2"
    >Sucos</text>
    <text
      x="360"
      y="368"
      text-anchor="middle"
      fill="#c45c7a"
      font-family="Figtree, system-ui, sans-serif"
      font-size="13"
      font-weight="700"
      letter-spacing="3.2"
    >SHAKE N JUICE</text>
    <text
      x="360"
      y="396"
      text-anchor="middle"
      fill="#1a2a28"
      font-family="Figtree, system-ui, sans-serif"
      font-size="11"
      font-weight="600"
      letter-spacing="1.8"
    >21 CENTRAL PROMENADE</text>

    <!-- Ticket stub beside cup -->
    <g transform="translate(500, 210)">
      <rect width="160" height="220" rx="10" fill="#faf6eb" stroke="#1a6b5c" stroke-width="2"/>
      <rect x="0" y="0" width="160" height="36" rx="10" fill="#0f5c52"/>
      <rect x="0" y="24" width="160" height="12" fill="#0f5c52"/>
      <text
        x="80"
        y="24"
        text-anchor="middle"
        fill="#c8e86c"
        font-family="Figtree, system-ui, sans-serif"
        font-size="11"
        font-weight="700"
        letter-spacing="2.4"
      >SHAKE TICKET</text>
      <text
        x="80"
        y="72"
        text-anchor="middle"
        fill="#0f5c52"
        font-family="Fraunces, Georgia, serif"
        font-size="42"
        font-weight="700"
      >21</text>
      <text
        x="80"
        y="96"
        text-anchor="middle"
        fill="#5c6e6a"
        font-family="Figtree, system-ui, sans-serif"
        font-size="10"
        font-weight="600"
        letter-spacing="1.4"
      >CENTRAL PROMENADE</text>
      <line x1="24" y1="118" x2="136" y2="118" stroke="#d4ebe4" stroke-width="2"/>
      <text
        x="80"
        y="148"
        text-anchor="middle"
        fill="#1a2a28"
        font-family="Figtree, system-ui, sans-serif"
        font-size="12"
        font-weight="600"
      >Juice · Smoothie</text>
      <text
        x="80"
        y="170"
        text-anchor="middle"
        fill="#1a2a28"
        font-family="Figtree, system-ui, sans-serif"
        font-size="12"
        font-weight="600"
      >Shake · Dessert</text>
      <text
        x="80"
        y="204"
        text-anchor="middle"
        fill="#c45c7a"
        font-family="Figtree, system-ui, sans-serif"
        font-size="10"
        font-weight="700"
        letter-spacing="1.2"
      >WALK UP · RING</text>
    </g>
  </svg>
)}
