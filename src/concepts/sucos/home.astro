---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import CupSleeve from "./CupSleeve.astro";

/* Sucos Shake N Juice — meal: consume-now juice bar on the prom.
   Speak as the bar. 21 Central Promenade, Newcastle, BT33 0AA.
   Not John Mac's (chippy at 9). Not Morelli's (scoop at 73).
   No verified own domain — handoff tel only. Hours conflict — omit.
   FSA 5 Very Good Aug 2024 stays in research, not guest chrome.
   No form. No invented flavours or social handles.
   Menu board leads the page; photos support, never headline. */
const phone = "028 4372 5795";
const phoneHref = "tel:+442843725795";
const maps =
  "https://www.google.com/maps/search/?api=1&query=21+Central+Promenade+Newcastle+BT33+0AA";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Shrikhand&family=Quicksand:wght@400;500;600;700&display=swap";

const rounds = [
  {
    num: "01",
    title: "Walk up to 21",
    text: "Central Promenade, right facing the bay. Step up to the counter window.",
  },
  {
    num: "02",
    title: "We blend it",
    text: "Juices pressed fresh to order, thick fruit smoothies, shakes and sweet treats.",
  },
  {
    num: "03",
    title: "Take it to the sea",
    text: "Straw in the cup, sea wall across the promenade, Mournes rising behind.",
  },
];
---

<ConceptLayout
  title={"Sucos — independent concept"}
  slug="sucos"
  bodyClass="concept-page concept-sucos"
  lang="en-GB"
  businessName="Sucos"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="AI-generated illustrations imagine the setting, spaces and products; they are not photographs of the business. The cup sleeve is a drawing."
>
  <div class="su-topline">
    <span class="su-topline-where">21 Central Promenade, Newcastle · BT33 0AA</span>
    <a class="su-topline-tel" href={phoneHref}>{phone}</a>
  </div>

  <header class="su-sign">
    <a class="su-wordmark" href="/concepts/sucos/">
      <span class="su-wordmark-name">Sucos</span>
      <span class="su-wordmark-tag">Shake N Juice</span>
    </a>
    <nav class="su-jumpnav" aria-label="Concept navigation">
      <a href="#board">The board</a>
      <a href="#counter">The counter</a>
      <a href="#find-us">Find 21</a>
    </nav>
    <a class="su-ringlink" href={phoneHref}>Ring the counter</a>
  </header>

  <main class="su-page">
    <section class="su-menuwall" id="board" aria-labelledby="su-menuwall-title">
      <div class="su-menuwall-head">
        <p class="su-menuwall-eyebrow">Juice bar · Central Promenade · Newcastle</p>
        <h1 id="su-menuwall-title">
          Sucos
          <span class="su-menuwall-sub">Shake N Juice</span>
        </h1>
        <p class="su-menuwall-intro">
          Fresh juices, thick smoothies, milkshakes and desserts — pressed and
          blended to order at the counter. Walk up to 21, or ring ahead.
        </p>
      </div>

      <div class="su-panels" role="list">
        <article class="su-panel su-panel--press" role="listitem">
          <h2 class="su-panel-name">Juices</h2>
          <p class="su-panel-note">Pressed fresh</p>
          <ul class="su-panel-lines">
            <li>Pressed when you order</li>
            <li>Poured straight into the glass</li>
            <li>Ask what is in the press today</li>
          </ul>
        </article>
        <article class="su-panel su-panel--blend" role="listitem">
          <h2 class="su-panel-name">Smoothies</h2>
          <p class="su-panel-note">Blended thick</p>
          <ul class="su-panel-lines">
            <li>Fruit thick enough for a straw</li>
            <li>Blended to order at the counter</li>
            <li>Made for the walk to the sea</li>
          </ul>
        </article>
        <article class="su-panel su-panel--sweet" role="listitem">
          <h2 class="su-panel-name">Shakes &amp; desserts</h2>
          <p class="su-panel-note">The sweet finish</p>
          <ul class="su-panel-lines">
            <li>Milkshakes blended cold</li>
            <li>Desserts from the counter</li>
            <li>When the prom wants something richer</li>
          </ul>
        </article>
      </div>

      <p class="su-menuwall-foot">What is in the blender today is written up at the counter.</p>
    </section>

    <section class="su-seafront" aria-labelledby="su-seafront-title">
      <div class="su-seafront-copy">
        <h2 id="su-seafront-title">The juice bar on the prom.</h2>
        <p>
          Step off the seafront and up to our window at 21. The counter faces
          the bay — you can watch the water while the blender runs.
        </p>
      </div>
      <figure class="su-seafront-frame">
        <img
          src="/media/concepts/sucos/sucos-hero-promenade.jpg"
          alt="Sucos juice and smoothie bar frontage at 21 Central Promenade on the Newcastle seafront"
          width="1376"
          height="768"
          loading="eager"
        />
        <figcaption>21 Central Promenade · fresh juice on the seafront</figcaption>
      </figure>
    </section>

    <section class="su-rounds" aria-labelledby="su-rounds-title">
      <h2 id="su-rounds-title">Walk up. Blend. Sea.</h2>
      <ol class="su-rounds-list">
        {rounds.map((r) => (
          <li class="su-round">
            <span class="su-round-num">{r.num}</span>
            <h3 class="su-round-title">{r.title}</h3>
            <p class="su-round-text">{r.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="su-counter" id="counter" aria-labelledby="su-counter-title">
      <div class="su-counter-copy">
        <p class="su-counter-eyebrow">At the counter</p>
        <h2 id="su-counter-title">Blended in front of you.</h2>
        <p>
          Real fruit, fresh ginger, greens and berries — blended to order right
          before you. No long queues or complicated apps. Tell us what you
          want in the cup and we make it while you watch.
        </p>
        <p class="su-counter-ring">
          <a href={phoneHref}>Ring the counter: {phone}</a>
        </p>
      </div>
      <figure class="su-counter-photo">
        <img
          src="/media/concepts/sucos/sucos-counter-blender.jpg"
          alt="Fresh fruit, high-power blender pitcher and ginger on the preparation counter at Sucos"
          width="1264"
          height="848"
          loading="lazy"
        />
        <figcaption>Freshly blended at 21 · real fruit on the counter</figcaption>
      </figure>
    </section>

    <section class="su-promwalk" id="cup" aria-labelledby="su-promwalk-title">
      <figure class="su-promwalk-photo">
        <img
          src="/media/concepts/sucos/sucos-promenade-cup.jpg"
          alt="A fresh fruit smoothie cup held at the Newcastle promenade railings with Slieve Donard behind"
          width="1264"
          height="848"
          loading="lazy"
        />
        <figcaption>The seafront ritual · a fresh cup on the promenade</figcaption>
      </figure>
      <div class="su-promwalk-copy">
        <h2 id="su-promwalk-title">Best drunk by the sea.</h2>
        <p>
          That is the whole visit. Tell us what you want in the cup, take it
          straight across to the sea wall, and watch the waves come in against
          the Mournes.
        </p>
      </div>
    </section>

    <section class="su-findus" id="find-us" aria-labelledby="su-findus-title">
      <div class="su-findus-visit">
        <h2 id="su-findus-title">Find the counter at 21.</h2>
        <p class="su-findus-text">
          Right on the seafront in Newcastle. Walk up to 21, or ring to check
          what is in the blender today.
        </p>
        <address class="su-where">
          <strong>Sucos Shake N Juice</strong>
          <span>21 Central Promenade</span>
          <span>Newcastle, Co. Down · BT33 0AA</span>
        </address>
        <p class="su-findus-links">
          <a class="su-telbig" href={phoneHref}>{phone}</a>
          <a class="su-maplink" href={maps} rel="noopener noreferrer">Open in Google Maps →</a>
        </p>
      </div>
      <figure class="su-sleevewrap">
        <CupSleeve />
        <figcaption>The cup sleeve at 21.</figcaption>
      </figure>
    </section>
  </main>

  <footer class="su-footnote">
    <p>
      Sucos Shake N Juice · 21 Central Promenade, Newcastle, BT33 0AA ·
      <a href={phoneHref}>{phone}</a>
    </p>
  </footer>
</ConceptLayout>
