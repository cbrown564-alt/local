---
/* Drawn cottage and log pod on Tullybrannigan: Mournes behind, Dundrum Bay below.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
---

<svg
  class="bn-plate"
  viewBox="0 0 1000 620"
  role="img"
  aria-label="Bonny's cottage and log pod on Tullybrannigan, with the Mournes behind and Dundrum Bay below"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="bn-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#eaf3f1"/>
      <stop offset=".55" stop-color="#dceae6"/>
      <stop offset="1" stop-color="#c8ddd8"/>
    </linearGradient>
    <linearGradient id="bn-bay" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#7aa8a2"/>
      <stop offset="1" stop-color="#4f7f79"/>
    </linearGradient>
    <linearGradient id="bn-sand" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e6dcc8"/>
      <stop offset="1" stop-color="#d4c6a8"/>
    </linearGradient>
    <linearGradient id="bn-moss" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#6d8f6a"/>
      <stop offset="1" stop-color="#4a6b52"/>
    </linearGradient>
    <linearGradient id="bn-cottage" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f7f2e8"/>
      <stop offset="1" stop-color="#e4d8c4"/>
    </linearGradient>
    <linearGradient id="bn-roof" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#5a6a62"/>
      <stop offset="1" stop-color="#3d4a44"/>
    </linearGradient>
    <linearGradient id="bn-pod" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#b08968"/>
      <stop offset="1" stop-color="#8a684c"/>
    </linearGradient>
    <linearGradient id="bn-glass" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f7fbfc" stop-opacity=".5"/>
      <stop offset="1" stop-color="#a8c8c2" stop-opacity=".28"/>
    </linearGradient>
    <pattern id="bn-grass" width="28" height="10" patternUnits="userSpaceOnUse">
      <rect width="28" height="10" fill="#8aa87a"/>
      <path d="M0 8h28M7 2v6M14 1v7M21 3v5" stroke="#6d8f6a" stroke-width="1" opacity=".55"/>
    </pattern>
    <pattern id="bn-grid" width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M20 0H0V20" fill="none" stroke="#1e2a24" stroke-opacity=".04" stroke-width="1"/>
    </pattern>
  </defs>

  <rect width="1000" height="620" fill="#f5f1e8"/>
  <rect width="1000" height="620" fill="url(#bn-grid)"/>

  <rect x="28" y="28" width="944" height="564" fill="none" stroke="#1e2a24" stroke-width="1.4"/>
  <rect x="36" y="36" width="928" height="464" fill="url(#bn-sky)"/>

  <!-- Mournes ridge -->
  <path d="M36 268 L180 148 L280 198 L380 110 L520 188 L640 96 L780 170 L880 128 L964 240 L964 268 Z" fill="#6b7d78"/>
  <path d="M380 110 L440 268 L320 268 Z" fill="#8a9a94" opacity=".55"/>
  <path d="M640 96 L700 268 L560 268 Z" fill="#84948e" opacity=".45"/>
  <path d="M620 118 C632 136 638 158 642 180" fill="none" stroke="#f5f1e8" stroke-width="1.3" opacity=".4"/>

  <!-- Dundrum Bay -->
  <rect x="36" y="268" width="928" height="78" fill="url(#bn-bay)"/>
  <path d="M36 268 C140 258 220 278 340 266 S540 252 680 268 S840 256 964 272" fill="none" stroke="#eaf3f1" stroke-width="2" opacity=".45"/>
  <rect x="36" y="346" width="928" height="26" fill="url(#bn-sand)"/>

  <!-- Park ground -->
  <rect x="36" y="372" width="928" height="128" fill="url(#bn-grass)"/>
  <rect x="36" y="372" width="928" height="128" fill="url(#bn-moss)" opacity=".18"/>

  <!-- Static caravan silhouette (background stock) -->
  <g transform="translate(118 356)" opacity=".85">
    <rect x="0" y="28" width="118" height="42" rx="6" fill="#d8cfc0" stroke="#1e2a24" stroke-width="1.2"/>
    <rect x="10" y="36" width="28" height="18" fill="url(#bn-glass)" stroke="#1e2a24" stroke-width="1"/>
    <rect x="48" y="36" width="28" height="18" fill="url(#bn-glass)" stroke="#1e2a24" stroke-width="1"/>
    <rect x="86" y="36" width="22" height="18" fill="#5a8a84" stroke="#1e2a24" stroke-width="1"/>
    <rect x="-4" y="66" width="126" height="6" rx="2" fill="#4a6b52"/>
  </g>

  <!-- Log pod -->
  <g transform="translate(290 378)">
    <ellipse cx="54" cy="68" rx="58" ry="10" fill="#3d4a44" opacity=".25"/>
    <path d="M4 54 C4 22 28 6 54 6 S104 22 104 54 L104 70 L4 70 Z" fill="url(#bn-pod)" stroke="#1e2a24" stroke-width="1.4"/>
    <path d="M4 54 C24 48 84 48 104 54" fill="none" stroke="#6a4e38" stroke-width="1.2" opacity=".7"/>
    <rect x="40" y="34" width="28" height="36" rx="3" fill="url(#bn-glass)" stroke="#1e2a24" stroke-width="1.2"/>
    <text x="54" y="92" text-anchor="middle" fill="#1e2a24" font-family="Nunito Sans, Segoe UI, sans-serif" font-size="11" font-weight="700" letter-spacing="2.2">LOG POD</text>
  </g>

  <!-- Bonny's Cottage -->
  <g transform="translate(520 318)">
    <ellipse cx="150" cy="178" rx="170" ry="14" fill="#3d4a44" opacity=".2"/>
    <!-- walls -->
    <rect x="40" y="70" width="220" height="110" fill="url(#bn-cottage)" stroke="#1e2a24" stroke-width="1.5"/>
    <!-- roof -->
    <path d="M28 78 L150 18 L272 78 Z" fill="url(#bn-roof)" stroke="#1e2a24" stroke-width="1.5"/>
    <rect x="132" y="28" width="36" height="42" fill="#4a6b52" stroke="#1e2a24" stroke-width="1.2"/>
    <!-- door -->
    <rect x="128" y="118" width="44" height="62" fill="#5a8a84" stroke="#1e2a24" stroke-width="1.3"/>
    <circle cx="162" cy="150" r="2.2" fill="#f5f1e8"/>
    <!-- windows -->
    <rect x="58" y="100" width="48" height="40" fill="url(#bn-glass)" stroke="#1e2a24" stroke-width="1.3"/>
    <path d="M82 100v40M58 120h48" stroke="#1e2a24" stroke-width="1"/>
    <rect x="194" y="100" width="48" height="40" fill="url(#bn-glass)" stroke="#1e2a24" stroke-width="1.3"/>
    <path d="M218 100v40M194 120h48" stroke="#1e2a24" stroke-width="1"/>
    <!-- garden hedge -->
    <path d="M20 180 C60 168 100 176 150 170 S240 168 280 178" fill="none" stroke="#4a6b52" stroke-width="8" stroke-linecap="round" opacity=".75"/>
    <text x="150" y="210" text-anchor="middle" fill="#1e2a24" font-family="Source Serif 4, Georgia, serif" font-size="22" font-weight="700">Bonny's Cottage</text>
    <text x="150" y="230" text-anchor="middle" fill="#5a6a62" font-family="Nunito Sans, Segoe UI, sans-serif" font-size="11" font-weight="600" letter-spacing="2.4">TULLYBRANNIGAN · DUNDRUM BAY</text>
  </g>

  <!-- Title bar -->
  <rect x="36" y="500" width="928" height="84" fill="#1e2a24"/>
  <text x="72" y="538" fill="#c5d9d6" font-family="Nunito Sans, Segoe UI, sans-serif" font-size="12" font-weight="700" letter-spacing="3.2">BONNY'S CARAVAN PARK</text>
  <text x="72" y="566" fill="#f5f1e8" font-family="Source Serif 4, Georgia, serif" font-size="28" font-weight="600">Foot of the Mournes</text>
  <text x="900" y="556" text-anchor="end" fill="#5a8a84" font-family="Nunito Sans, Segoe UI, sans-serif" font-size="13" font-weight="700" letter-spacing="1.6">NEWCASTLE</text>
</svg>
