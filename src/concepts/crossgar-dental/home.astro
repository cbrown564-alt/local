---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";
import CdMark from "./CdMark.astro";

/* Crossgar Dental Practice — 48 Killyleagh Street, Crossgar, BT30 9DQ.
   Sources (live-fetched 26 Nov 2026): crossgardentalpractice.co.uk (/, /contact).
   - Accepting New Patients.
   - Live DentalHub online booking portal:
     https://uk.dentalhub.online/soe/new/Crossgar%20Dental%20Practice?pid=UKPOH01
   - Phone: 028 4483 2585 (recommended directly for dental emergencies).
   - Treatments published on site: Routine Dental Care, Dental Hygiene,
     Restorative Dentistry, Cosmetic Dentistry, Orthodontics (Clear Aligners,
     Ceramic Braces, Retainers), Dental Implants (Single, Multiple, All-on-4,
     Implant Supported Dentures), IV Sedation & Nervous Patients, Dentistry for
     Children, Dental Emergencies, Membership Plans & Treatment Fees.
   Brief: research/concepts/crossgar-dental/crossgar-dental-elevation-brief.md */

const phone = "028 4483 2585";
const phoneHref = "tel:+442844832585";
const bookOnline = "https://uk.dentalhub.online/soe/new/Crossgar%20Dental%20Practice?pid=UKPOH01";
const contactUrl = "https://www.crossgardentalpractice.co.uk/contact";
const facebook = "https://www.facebook.com/crossgardental";
const instagram = "https://www.instagram.com/crossgar_dental/";
const mapHref = "https://www.google.com/maps/dir//48+Killyleagh+Rd,+Crossgar,+Downpatrick+BT30+9DQ/@54.3977088,-5.7582088,16z";
const fontHref =
  "https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700&display=swap";

const treatments = [
  {
    name: "Routine Care, Hygiene & Children",
    summary: "Unhurried check-ups, preventive dentistry, dental hygiene appointments and gentle care for children.",
    href: "https://www.crossgardentalpractice.co.uk/dental-treatments/routine-dental-care",
  },
  {
    name: "Dental Implants",
    summary: "Permanent, natural-looking tooth replacement — single implants, multiple teeth, All-on-4 and implant-supported dentures.",
    href: "https://www.crossgardentalpractice.co.uk/dental-treatments/dental-implants",
  },
  {
    name: "Orthodontics & Clear Aligners",
    summary: "Discreet teeth straightening with clear aligners, ceramic braces and custom retainers.",
    href: "https://www.crossgardentalpractice.co.uk/dental-treatments/orthodontics",
  },
  {
    name: "Cosmetic & Restorative Dentistry",
    summary: "Tailored restorative and cosmetic treatments focused on long-term comfort and natural results.",
    href: "https://www.crossgardentalpractice.co.uk/dental-treatments/cosmetic-dentistry",
  },
  {
    name: "Nervous Patients & IV Sedation",
    summary: "Calm, unhurried visits with IV sedation options so anxious patients feel supported and in control.",
    href: "https://www.crossgardentalpractice.co.uk/for-patients/nervous-patients",
  },
  {
    name: "Membership Plans & Fees",
    summary: "Clear treatment fees explained upfront and membership plans to spread the cost of routine care.",
    href: contactUrl,
  },
];
---

<ConceptLayout
  title="Crossgar Dental Practice — 48 Killyleagh Street, Crossgar"
  slug="crossgar-dental"
  bodyClass="concept-page concept-crossgardental"
  lang="en-GB"
  businessName="Crossgar Dental Practice"
  town="Crossgar"
  fontHref={fontHref}
  bannerNote="The sunlit reception lounge and botanical ceramic study are AI-generated visualisations. Online booking hands straight to Crossgar Dental Practice's own DentalHub portal; emergency calls go directly to 028 4483 2585."
>
  <div class="cd-topbar">
    <div class="cd-wrap cd-topbar-inner">
      <span>48 Killyleagh Street, Crossgar, BT30 9DQ · <strong>Accepting New Patients</strong></span>
      <span>Dental emergency? Call <a href={phoneHref}>{phone}</a> directly</span>
    </div>
  </div>

  <header class="cd-header">
    <div class="cd-wrap cd-header-inner">
      <a class="cd-brand" href="#top">
        <CdMark size={34} tone="teal" />
        <span>
          <strong>Crossgar Dental Practice</strong>
          <small>Crossgar · County Down</small>
        </span>
      </a>
      <nav class="cd-nav" aria-label="Crossgar Dental Practice">
        <a href="#triage">How We Can Help</a>
        <a href="#treatments">Treatments</a>
        <a href="#find">Find the Practice</a>
      </nav>
      <a class="cd-header-cta" href={bookOnline} rel="noopener noreferrer">Book Online ↗</a>
    </div>
  </header>

  <main id="top" class="cd-main">
    <section class="cd-hero" aria-labelledby="cd-hero-title">
      <figure class="cd-hero-plate">
        <ResponsiveImage
          src="/media/concepts/crossgar-dental/crossgar-dental-calm-suite.jpg"
          alt="Sunlit minimalist dental reception lounge in porcelain white, soft sage green and pale oak with indoor greenery"
          width={1376}
          height={768}
          loading="eager"
          sizes="100vw"
          class="cd-hero-img"
        />
        <figcaption class="cd-hero-cap">Calm sunlit reception feel. Visualisation (AI-generated).</figcaption>
      </figure>

      <div class="cd-wrap cd-hero-overlay">
        <div class="cd-porcelain-card">
          <p class="cd-badge">Accepting New Patients · Crossgar &amp; Downpatrick</p>
          <h1 id="cd-hero-title">Gentle, unhurried dentistry <em>in calm hands.</em></h1>
          <p class="cd-lede">
            Routine family care, hygiene, dental implants, clear aligners and IV
            sedation for nervous patients — book straight into our live online
            diary or talk with reception on Killyleagh Street.
          </p>
          <div class="cd-hero-actions">
            <a class="cd-btn cd-btn--teal" href={bookOnline} rel="noopener noreferrer">Book an appointment online ↗</a>
            <a class="cd-btn cd-btn--soft" href={phoneHref}>Call {phone}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="cd-triage-section" id="triage" aria-labelledby="cd-triage-title">
      <div class="cd-wrap">
        <div class="cd-triage-head">
          <p class="cd-kicker">Calm Patient Triage</p>
          <h2 id="cd-triage-title">What brings you to Crossgar Dental today?</h2>
        </div>

        <div class="cd-triage-box">
          <div class="cd-triage-tabs" role="tablist" aria-label="Patient visit reason">
            <button type="button" role="tab" aria-selected="true" class="cd-triage-tab is-active" data-cd-tab="routine">
              <strong>New or Routine Visit</strong>
              <span>Check-ups, hygiene &amp; children</span>
            </button>
            <button type="button" role="tab" aria-selected="false" class="cd-triage-tab" data-cd-tab="nervous">
              <strong>Nervous? IV Sedation</strong>
              <span>Calm, unhurried support</span>
            </button>
            <button type="button" role="tab" aria-selected="false" class="cd-triage-tab cd-triage-tab--urgent" data-cd-tab="emergency">
              <strong>Urgent Emergency</strong>
              <span>Pain, swelling or broken tooth</span>
            </button>
            <button type="button" role="tab" aria-selected="false" class="cd-triage-tab" data-cd-tab="implants">
              <strong>Implants &amp; Aligners</strong>
              <span>Restorative &amp; orthodontic care</span>
            </button>
          </div>

          <div class="cd-triage-stage">
            <div class="cd-triage-panel" data-cd-panel="routine">
              <p class="cd-panel-eyebrow">New &amp; Existing Patients</p>
              <h3>Book your check-up or hygiene visit online in minutes.</h3>
              <p>
                We are welcoming new adult and child patients from Crossgar,
                Downpatrick, Saintfield, Killyleagh and Ballynahinch. Choose a
                slot straight in our DentalHub diary — options and treatment fees
                are always explained clearly before anything begins.
              </p>
              <div class="cd-panel-actions">
                <a class="cd-btn cd-btn--teal" href={bookOnline} rel="noopener noreferrer">Open DentalHub online diary ↗</a>
                <a class="cd-btn cd-btn--outline" href={contactUrl} rel="noopener noreferrer">Ask about membership plans ↗</a>
              </div>
            </div>

            <div class="cd-triage-panel" data-cd-panel="nervous" hidden>
              <p class="cd-panel-eyebrow">Nervous Patients &amp; IV Sedation</p>
              <h3>Take your first visit at your own pace.</h3>
              <p>
                Feeling anxious about sitting in the dental chair is completely
                understandable. We take extra time to listen first, never rush,
                and offer <strong>IV sedation</strong> so you remain relaxed and
                comfortable throughout treatment.
              </p>
              <div class="cd-panel-actions">
                <a class="cd-btn cd-btn--teal" href={bookOnline} rel="noopener noreferrer">Book a calm first consultation ↗</a>
                <a class="cd-btn cd-btn--outline" href={phoneHref}>Talk quietly with reception · {phone}</a>
              </div>
            </div>

            <div class="cd-triage-panel cd-triage-panel--urgent" data-cd-panel="emergency" hidden>
              <p class="cd-panel-eyebrow cd-panel-eyebrow--urgent">Dental Emergencies — Please Call Directly</p>
              <h3>Ring reception on {phone} rather than booking online.</h3>
              <p>
                If you are in pain, have swelling or have damaged a tooth, please
                telephone our Killyleagh Street desk directly so our team can
                triage your symptoms and arrange the earliest urgent appointment.
              </p>
              <div class="cd-panel-actions">
                <a class="cd-btn cd-btn--urgent" href={phoneHref}>Call reception now · {phone}</a>
                <a class="cd-btn cd-btn--outline" href={mapHref} rel="noopener noreferrer">Directions to 48 Killyleagh St ↗</a>
              </div>
            </div>

            <div class="cd-triage-panel" data-cd-panel="implants" hidden>
              <p class="cd-panel-eyebrow">Dental Implants &amp; Orthodontics</p>
              <h3>Long-term tooth replacement and subtle straightening.</h3>
              <p>
                From single and multiple dental implants, All-on-4 and
                implant-supported dentures to clear aligners, ceramic braces and
                retainers — start with a straightforward consultation to talk
                through clinical options and fees.
              </p>
              <div class="cd-panel-actions">
                <a class="cd-btn cd-btn--teal" href={bookOnline} rel="noopener noreferrer">Book a consultation online ↗</a>
                <a class="cd-btn cd-btn--outline" href={contactUrl} rel="noopener noreferrer">Send a treatment enquiry ↗</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="cd-section cd-treatments" id="treatments" aria-labelledby="cd-treatments-title">
      <div class="cd-wrap cd-treatments-layout">
        <div class="cd-treatments-list">
          <p class="cd-kicker">Under One Roof · 48 Killyleagh Street</p>
          <h2 id="cd-treatments-title">Preventive, restorative and specialist care.</h2>

          <ol class="cd-index">
            {treatments.map((t, i) => (
              <li class="cd-index-row">
                <span class="cd-index-no">0{i + 1}</span>
                <div class="cd-index-copy">
                  <h3><a href={t.href} rel="noopener noreferrer">{t.name} ↗</a></h3>
                  <p>{t.summary}</p>
                </div>
              </li>
            ))}
          </ol>

          <div style="margin-top: 24px;">
            <SpecimenSheet
              id="crossgar-care-sheet"
              triggerLabel="Open Full Treatment & Care Guide"
              kicker="Crossgar Dental Practice · 48 Killyleagh Street"
              title="Complete Treatment & Emergency Guide"
              subtitle="Preventive family dentistry, implants, clear aligners, IV sedation, and urgent telephone triage."
              groups={[
                {
                  id: "routine",
                  label: "Preventive & Family Care",
                  items: [
                    { name: "New Patient & Routine Check-Ups", note: "Unhurried clinical exams, digital imaging & clear treatment plans" },
                    { name: "Hygiene & Gum Care", note: "Preventive scaling, polishing and tailored home-care guidance" },
                    { name: "Children's Dentistry", note: "Gentle, reassuring visits from the very first tooth" },
                  ],
                },
                {
                  id: "specialist",
                  label: "Implants, Orthodontics & Cosmetic",
                  items: [
                    { name: "Dental Implants & All-on-4", note: "Single, multiple and implant-supported restorations" },
                    { name: "Clear Aligners & Ceramic Braces", note: "Discreet orthodontic straightening & custom retainers" },
                    { name: "Nervous Patients & IV Sedation", note: "Calm, unhurried appointments with intravenous sedation available" },
                  ],
                },
                {
                  id: "urgent",
                  label: "Urgent Dental Emergencies",
                  items: [
                    { name: "Direct Emergency Reception", note: "For pain, swelling or trauma, call reception directly rather than booking online", meta: phone },
                  ],
                },
              ]}
              ctaLabel="Book online via DentalHub ↗"
              ctaHref={bookOnline}
              ctaExternal={true}
              secondaryLabel={`Emergency desk · ${phone}`}
              secondaryHref={phoneHref}
            />
          </div>
        </div>

        <aside class="cd-botanical-col">
          <figure class="cd-botanical-plate">
            <ResponsiveImage
              src="/media/concepts/crossgar-dental/crossgar-dental-botanical-detail.jpg"
              alt="Ceramic cup and fresh eucalyptus sprig on pale limestone beside a sunlit window"
              width={1200}
              height={896}
              sizes="(max-width: 960px) 100vw, 40vw"
              class="cd-botanical-img"
            />
            <figcaption>Unhurried clinical sanctuary mood. Visualisation (AI-generated).</figcaption>
          </figure>

          <div class="cd-find-box" id="find">
            <p class="cd-kicker">Find the Practice</p>
            <h3>48 Killyleagh Street, Crossgar, BT30 9DQ</h3>
            <p>
              Serving patients across Crossgar, Downpatrick, Saintfield,
              Killyleagh and Ballynahinch.
            </p>
            <dl class="cd-find-dl">
              <div><dt>Phone &amp; Emergencies</dt><dd><a href={phoneHref}>{phone}</a></dd></div>
              <div><dt>Online Diary</dt><dd><a href={bookOnline} rel="noopener noreferrer">DentalHub Booking Portal ↗</a></dd></div>
              <div><dt>Follow</dt><dd><a href={facebook} rel="noopener noreferrer">Facebook</a> · <a href={instagram} rel="noopener noreferrer">Instagram</a></dd></div>
            </dl>
            <a class="cd-btn cd-btn--outline cd-btn--full" href={mapHref} rel="noopener noreferrer">Directions on Google Maps ↗</a>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <footer class="cd-footer">
    <div class="cd-wrap cd-footer-inner">
      <div class="cd-footer-brand">
        <CdMark size={28} tone="teal" />
        <span><strong>Crossgar Dental Practice</strong> · 48 Killyleagh Street, Crossgar, BT30 9DQ</span>
      </div>
      <p class="cd-footer-right">
        <a href={phoneHref}>{phone}</a> · <a href={bookOnline} rel="noopener noreferrer">Book Online ↗</a>
      </p>
    </div>
  </footer>

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>("[data-cd-tab]");
    const panels = document.querySelectorAll<HTMLElement>("[data-cd-panel]");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.cdTab;
        tabs.forEach((t) => {
          const active = t.dataset.cdTab === target;
          t.classList.toggle("is-active", active);
          t.setAttribute("aria-selected", String(active));
        });
        panels.forEach((p) => {
          p.hidden = p.dataset.cdPanel !== target;
        });
      });
    });
  </script>
</ConceptLayout>
