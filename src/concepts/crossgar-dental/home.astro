---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import CdMark from "./CdMark.astro";
import "./styles.css";

/* Crossgar Dental Practice — 48 Killyleagh Street, Crossgar, BT30 9DQ.
   Sources (live-fetched 26 Nov 2026): crossgardentalpractice.co.uk (/, /contact).
   - Accepting New Patients.
   - Live DentalHub online booking portal:
     https://uk.dentalhub.online/soe/new/Crossgar%20Dental%20Practice?pid=UKPOH01
   - Phone: 028 4483 2585 (recommended directly for dental emergencies).
   - Treatments published on site: Routine Dental Care, Dental Hygiene,
     Restorative Dentistry, Cosmetic Dentistry, Orthodontics (Clear Aligners,
     Ceramic Braces, Retainers), Dental Implants (Single, Multiple, All-on-4,
     Implant Supported Dentures), IV Sedation & Nervous Patients, Dentistry for
     Children, Dental Emergencies, Membership Plans & Treatment Fees. */

const phone = "028 4483 2585";
const phoneHref = "tel:+442844832585";
const bookOnline =
  "https://uk.dentalhub.online/soe/new/Crossgar%20Dental%20Practice?pid=UKPOH01";
const contactUrl = "https://www.crossgardentalpractice.co.uk/contact";
const facebook = "https://www.facebook.com/crossgardental";
const instagram = "https://www.instagram.com/crossgar_dental/";
const mapHref =
  "https://www.google.com/maps/dir//48+Killyleagh+Rd,+Crossgar,+Downpatrick+BT30+9DQ/@54.3977088,-5.7582088,16z";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700&family=Manrope:wght@400;500;600;700&display=swap";

const carePillars = [
  {
    id: "routine",
    tabLabel: "Routine and hygiene",
    title: "Preventive check-ups, hygiene, and children's care",
    visitValue: "routine",
    summary:
      "We are accepting new adult and child patients from Crossgar, Downpatrick, Saintfield, Killyleagh, and Ballynahinch. Appointments are unhurried, with treatment options and fees explained clearly before anything begins.",
    details: [
      { label: "New patients", value: "Welcoming adults and children across County Down" },
      { label: "Routine care", value: "Check-ups, preventive dentistry, hygiene, and restorative care" },
      { label: "Fees and plans", value: "Clear upfront fees and membership plans to spread routine care" },
    ],
    ctaLabel: "Book a check-up or hygiene visit ↗",
    ctaHref: bookOnline,
    external: true,
  },
  {
    id: "implants",
    tabLabel: "Implants and aligners",
    title: "Natural tooth replacement and discreet straightening",
    visitValue: "implants",
    summary:
      "Long-term restorative and orthodontic care under one roof on Killyleagh Street, from single dental implants and All-on-4 restorations to clear aligners, ceramic braces, custom retainers, and cosmetic dentistry.",
    details: [
      { label: "Dental implants", value: "Single implants, multiple teeth, All-on-4, and implant-supported dentures" },
      { label: "Orthodontics", value: "Clear aligners, ceramic braces, and custom retainers" },
      { label: "Cosmetic care", value: "Tailored restorative and cosmetic treatments for natural results" },
    ],
    ctaLabel: "Book a consultation online ↗",
    ctaHref: bookOnline,
    external: true,
  },
  {
    id: "nervous",
    tabLabel: "Nervous patients",
    title: "Take your visit at your own pace, with IV sedation available",
    visitValue: "nervous",
    summary:
      "Feeling anxious about visiting the dentist is completely understandable. Our team takes extra time to listen first, never rushes an appointment, and offers intravenous sedation so you stay calm and comfortable throughout treatment.",
    details: [
      { label: "First step", value: "Unhurried conversation before any examination or treatment" },
      { label: "Sedation option", value: "IV sedation available for nervous or anxious patients" },
      { label: "Speak first", value: `Talk quietly with reception on ${phone}` },
    ],
    ctaLabel: "Book a calm first consultation ↗",
    ctaHref: bookOnline,
    external: true,
  },
];

const treatments = [
  {
    name: "Routine care, hygiene, and children",
    summary:
      "Unhurried check-ups, preventive dentistry, dental hygiene appointments, and gentle care for children.",
    href: "https://www.crossgardentalpractice.co.uk/dental-treatments/routine-dental-care",
  },
  {
    name: "Dental implants",
    summary:
      "Permanent, natural-looking tooth replacement including single implants, multiple teeth, All-on-4, and implant-supported dentures.",
    href: "https://www.crossgardentalpractice.co.uk/dental-treatments/dental-implants",
  },
  {
    name: "Orthodontics and clear aligners",
    summary:
      "Discreet teeth straightening with clear aligners, ceramic braces, and custom retainers.",
    href: "https://www.crossgardentalpractice.co.uk/dental-treatments/orthodontics",
  },
  {
    name: "Cosmetic and restorative dentistry",
    summary:
      "Tailored restorative and cosmetic treatments focused on long-term comfort and natural results.",
    href: "https://www.crossgardentalpractice.co.uk/dental-treatments/cosmetic-dentistry",
  },
  {
    name: "Nervous patients and IV sedation",
    summary:
      "Calm, unhurried visits with IV sedation options so anxious patients feel supported and in control.",
    href: "https://www.crossgardentalpractice.co.uk/for-patients/nervous-patients",
  },
  {
    name: "Membership plans and fees",
    summary:
      "Clear treatment fees explained upfront and membership plans to spread the cost of routine care.",
    href: contactUrl,
  },
];

const careSheetGroups = [
  {
    id: "routine",
    label: "Preventive and Family Care",
    items: [
      {
        name: "New Patient and Routine Check-Ups",
        note: "Unhurried clinical exams and clear treatment plans explained upfront",
      },
      {
        name: "Hygiene and Gum Care",
        note: "Preventive scaling, polishing, and tailored home-care guidance",
      },
      {
        name: "Children's Dentistry",
        note: "Gentle, reassuring visits for younger patients",
      },
    ],
  },
  {
    id: "specialist",
    label: "Implants, Orthodontics and Cosmetic",
    items: [
      {
        name: "Dental Implants and All-on-4",
        note: "Single, multiple, All-on-4, and implant-supported dentures",
      },
      {
        name: "Clear Aligners and Ceramic Braces",
        note: "Discreet orthodontic straightening and custom retainers",
      },
      {
        name: "Nervous Patients and IV Sedation",
        note: "Calm, unhurried appointments with intravenous sedation available",
      },
    ],
  },
  {
    id: "urgent",
    label: "Urgent Dental Emergencies",
    items: [
      {
        name: "Direct Emergency Reception",
        note: "For pain, swelling, or trauma, call reception directly rather than booking online",
        meta: phone,
      },
    ],
  },
];
---

<ConceptLayout
  title="Crossgar Dental Practice, 48 Killyleagh Street, Crossgar"
  slug="crossgar-dental"
  bodyClass="concept-page concept-crossgardental"
  lang="en-GB"
  businessName="Crossgar Dental Practice"
  town="Crossgar"
  fontHref={fontHref}
  bannerNote="The sunlit reception suite and botanical ceramic study are indicative visualisations. Online booking hands straight to Crossgar Dental Practice's own DentalHub portal; emergency calls go directly to 028 4483 2585."
>
  <header class="cd-header" data-cd-header>
    <div class="cd-header-inner">
      <a class="cd-brand" href="#top">
        <CdMark size={26} tone="teal" />
        <span>Crossgar Dental</span>
      </a>
      <nav class="cd-nav" aria-label="Primary">
        <a href="#care">Care and treatments</a>
        <a href="#reassurance">Emergencies and sedation</a>
        <a href="#appointments">Appointments</a>
        <a href="#location">Killyleagh Street</a>
      </nav>
      <div class="cd-header-actions">
        <a class="cd-header-tel" href={phoneHref}>{phone}</a>
        <a class="cd-header-cta" href={bookOnline} rel="noopener noreferrer">Book online</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="cd-hero" aria-labelledby="cd-hero-title">
      <div class="cd-hero-sentinel" data-cd-sentinel aria-hidden="true"></div>

      <div class="cd-hero-media">
        <picture>
          <source
            srcset="/media/concepts/crossgar-dental/crossgar-dental-calm-suite-640.webp 640w, /media/concepts/crossgar-dental/crossgar-dental-calm-suite-1265.webp 1265w"
            sizes="100vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/crossgar-dental/crossgar-dental-calm-suite.jpg"
            alt="Sunlit minimalist dental reception lounge in porcelain white, soft sage green, and pale oak with eucalyptus greenery"
            width="1376"
            height="768"
            loading="eager"
          />
        </picture>
      </div>

      <div class="cd-hero-scrim" aria-hidden="true"></div>

      <div class="cd-wrap cd-hero-content">
        <div class="cd-hero-copy">
          <h1 id="cd-hero-title">Gentle, unhurried dentistry in calm hands.</h1>
          <p class="cd-hero-sub">
            Accepting new patients on Killyleagh Street for routine care,
            hygiene, implants, clear aligners, and IV sedation.
          </p>
          <div class="cd-hero-foot">
            <a class="cd-btn cd-btn--pine" href={bookOnline} rel="noopener noreferrer">
              Book an appointment online ↗
            </a>
            <p class="cd-hero-caption">
              Sunlit Crossgar reception suite. Indicative visualisation.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="cd-section cd-care" id="care" aria-labelledby="cd-care-title">
      <div class="cd-wrap">
        <div class="cd-section-head">
          <div>
            <h2 id="cd-care-title">Care and treatments under one roof.</h2>
            <p class="cd-section-copy">
              Serving Crossgar, Downpatrick, Saintfield, Killyleagh, and
              Ballynahinch with preventive family care, restorative dentistry,
              and specialist support.
            </p>
          </div>
          <div class="cd-guide-slot">
            <SpecimenSheet
              id="crossgar-care-sheet"
              triggerLabel="Full treatment and care guide"
              kicker="Crossgar Dental Practice · 48 Killyleagh Street"
              title="Complete Treatment and Emergency Guide"
              subtitle="Preventive family dentistry, implants, clear aligners, IV sedation, and urgent telephone triage."
              groups={careSheetGroups}
              ctaLabel="Book online via DentalHub ↗"
              ctaHref={bookOnline}
              ctaExternal={true}
              secondaryLabel={`Emergency desk: ${phone}`}
              secondaryHref={phoneHref}
              buttonClass="cd-guide-trigger"
            />
          </div>
        </div>

        <div class="cd-tabs" role="tablist" aria-label="Care and treatments">
          {carePillars.map((item, idx) => (
            <button
              type="button"
              role="tab"
              id={`cd-tab-${item.id}`}
              aria-selected={idx === 0 ? "true" : "false"}
              aria-controls={`cd-panel-${item.id}`}
              tabindex={idx === 0 ? "0" : "-1"}
              class={`cd-tab${idx === 0 ? " is-active" : ""}`}
              data-cd-tab={item.id}
            >
              {item.tabLabel}
            </button>
          ))}
        </div>

        <div class="cd-care-layout">
          <div class="cd-care-stage">
            {carePillars.map((item, idx) => (
              <article
                id={`cd-panel-${item.id}`}
                role="tabpanel"
                aria-labelledby={`cd-tab-${item.id}`}
                class={`cd-panel${idx === 0 ? " is-active" : ""}`}
                data-cd-panel={item.id}
                hidden={idx !== 0}
              >
                <h3>{item.title}</h3>
                <p>{item.summary}</p>
                <dl class="cd-spec-list">
                  {item.details.map((row) => (
                    <div class="cd-spec-row">
                      <dt>{row.label}</dt>
                      <dd>{row.value}</dd>
                    </div>
                  ))}
                </dl>
                <a
                  class="cd-btn cd-btn--pine"
                  href={item.ctaHref}
                  rel={item.external ? "noopener noreferrer" : undefined}
                >
                  {item.ctaLabel}
                </a>
              </article>
            ))}
          </div>

          <figure class="cd-plate">
            <picture>
              <source
                srcset="/media/concepts/crossgar-dental/crossgar-dental-botanical-detail-640.webp 640w, /media/concepts/crossgar-dental/crossgar-dental-botanical-detail-1265.webp 1265w"
                sizes="(max-width: 980px) 100vw, 44vw"
                type="image/webp"
              />
              <img
                src="/media/concepts/crossgar-dental/crossgar-dental-botanical-detail.jpg"
                alt="Ceramic cup and fresh eucalyptus sprig on pale limestone beside a sunlit window"
                width="1200"
                height="896"
                loading="lazy"
              />
            </picture>
            <figcaption>Unhurried clinical sanctuary mood. Indicative visualisation.</figcaption>
          </figure>
        </div>

        <ul class="cd-treatment-index" aria-label="Treatment links on Crossgar Dental Practice">
          {treatments.map((t) => (
            <li class="cd-treatment-row">
              <h3>
                <a href={t.href} rel="noopener noreferrer">
                  {t.name} ↗
                </a>
              </h3>
              <p>{t.summary}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="cd-section cd-reassurance" id="reassurance" aria-labelledby="cd-reassurance-title">
      <div class="cd-wrap cd-reassurance-grid">
        <div class="cd-reassurance-intro">
          <h2 id="cd-reassurance-title">Dental emergencies and calm IV sedation support.</h2>
          <p>
            Whether you are dealing with sudden tooth pain or returning to a
            dentist after years of anxiety, our Killyleagh Street team responds
            with calm, practical care.
          </p>
          <a class="cd-btn cd-btn--light" href={phoneHref}>
            Call reception on {phone}
          </a>
        </div>

        <dl class="cd-reassurance-list">
          <div class="cd-reassurance-row">
            <dt>Urgent dental emergency</dt>
            <dd>
              If you have pain, swelling, or a broken tooth, please telephone
              reception directly on <a href={phoneHref}>{phone}</a> rather than
              booking online so we can triage your symptoms and arrange the
              earliest urgent appointment.
            </dd>
          </div>
          <div class="cd-reassurance-row">
            <dt>Nervous patients and IV sedation</dt>
            <dd>
              Let reception know when you book if you feel anxious. We allow
              extra time to talk first without rushing, and offer intravenous
              sedation so treatment stays calm and comfortable.
            </dd>
          </div>
          <div class="cd-reassurance-row">
            <dt>Clear fees and membership plans</dt>
            <dd>
              Every clinical option and treatment fee is explained clearly
              before you decide, with membership plans available to spread
              routine preventive care.
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="cd-section cd-appointments" id="appointments" aria-labelledby="cd-appointments-title">
      <div class="cd-wrap cd-appointments-grid">
        <div class="cd-appointments-intro">
          <h2 id="cd-appointments-title">Book online or speak with Killyleagh Street.</h2>
          <p>
            Choose a routine check-up, hygiene visit, or consultation directly
            in our live DentalHub diary, or call reception for urgent care and
            membership enquiries.
          </p>

          <dl class="cd-contact-list">
            <div class="cd-contact-row">
              <dt>Phone and emergencies</dt>
              <dd><a href={phoneHref}>{phone}</a></dd>
            </div>
            <div class="cd-contact-row">
              <dt>Online diary</dt>
              <dd>
                <a href={bookOnline} rel="noopener noreferrer">DentalHub Booking Portal ↗</a>
              </dd>
            </div>
            <div class="cd-contact-row">
              <dt>Practice contact</dt>
              <dd>
                <a href={contactUrl} rel="noopener noreferrer">crossgardentalpractice.co.uk/contact ↗</a>
              </dd>
            </div>
            <div class="cd-contact-row">
              <dt>Social</dt>
              <dd>
                <a href={facebook} rel="noopener noreferrer">Facebook</a> and{" "}
                <a href={instagram} rel="noopener noreferrer">Instagram</a>
              </dd>
            </div>
            <div class="cd-contact-row">
              <dt>Address</dt>
              <dd>48 Killyleagh Street, Crossgar, BT30 9DQ</dd>
            </div>
          </dl>
        </div>

        <form class="cd-form" data-cd-form data-book-url={bookOnline} data-phone-href={phoneHref}>
          <div class="cd-row">
            <label>
              <span>Reason for your visit</span>
              <select name="reason" data-cd-reason>
                <option value="routine">New patient or routine check-up</option>
                <option value="hygiene">Dental hygiene appointment</option>
                <option value="implants">Dental implants or clear aligners</option>
                <option value="nervous">Nervous patient consultation (IV sedation)</option>
                <option value="emergency">Urgent dental emergency (call reception)</option>
              </select>
            </label>
            <label>
              <span>Patient type</span>
              <select name="patient" data-cd-patient>
                <option value="New patient">New patient</option>
                <option value="Existing patient">Existing patient</option>
                <option value="Child patient">Child patient</option>
              </select>
            </label>
          </div>
          <label>
            <span>Optional note to keep handy when booking</span>
            <textarea
              name="notes"
              rows="3"
              placeholder="Preferred mornings or afternoons, nervous-patient support, or membership enquiry..."
            ></textarea>
          </label>
          <p class="cd-echo" data-cd-echo aria-live="polite">
            New patient check-ups open directly in Crossgar Dental Practice's DentalHub diary.
          </p>
          <button class="cd-btn cd-btn--pine" type="submit" data-cd-submit>
            Open DentalHub online diary ↗
          </button>
        </form>
      </div>
    </section>

    <section class="cd-section cd-map-band" id="location" aria-labelledby="cd-location-title">
      <div class="cd-wrap">
        <div class="cd-location-head">
          <h2 id="cd-location-title">48 Killyleagh Street in the heart of Crossgar.</h2>
          <p class="cd-section-copy">
            Conveniently placed for patients travelling from Crossgar,
            Downpatrick, Saintfield, Killyleagh, and Ballynahinch.
          </p>
        </div>

        <LocalAreaMap
          id="cd-map"
          kicker=""
          businessName="Crossgar Dental"
          address="48 Killyleagh Street, Crossgar, BT30 9DQ"
          lon={-5.7582088}
          lat={54.3977088}
          spanKm={16}
          mapHref={mapHref}
          markers={[
            { name: "Downpatrick", lon: -5.7168, lat: 54.3286, note: "10 mins south", side: "r" },
            { name: "Saintfield", lon: -5.833, lat: 54.457, note: "10 mins north", side: "l" },
            { name: "Killyleagh", lon: -5.654, lat: 54.403, note: "8 mins east", side: "r" },
            { name: "Ballynahinch", lon: -5.896, lat: 54.402, note: "12 mins west", side: "l" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="cd-footer">
    <div class="cd-wrap cd-footer-inner">
      <div>
        <strong>Crossgar Dental Practice</strong>
        <p>48 Killyleagh Street, Crossgar, Downpatrick, Co. Down, BT30 9DQ</p>
      </div>
      <div class="cd-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={bookOnline} rel="noopener noreferrer">Book online ↗</a>
        <a href={contactUrl} rel="noopener noreferrer">Contact</a>
        <a href="#top">Back to top</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-cd-header]");
      const sentinel = document.querySelector("[data-cd-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            header.classList.toggle("is-scrolled", !entries[0].isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      const tabs = Array.from(document.querySelectorAll("[data-cd-tab]"));
      const panels = Array.from(document.querySelectorAll("[data-cd-panel]"));

      const activateTab = (targetId, moveFocus = false) => {
        tabs.forEach((tab) => {
          const active = tab.getAttribute("data-cd-tab") === targetId;
          tab.classList.toggle("is-active", active);
          tab.setAttribute("aria-selected", active ? "true" : "false");
          tab.setAttribute("tabindex", active ? "0" : "-1");
          if (active && moveFocus) tab.focus();
        });
        panels.forEach((panel) => {
          const active = panel.getAttribute("data-cd-panel") === targetId;
          panel.classList.toggle("is-active", active);
          panel.hidden = !active;
        });
      };

      tabs.forEach((tab, idx) => {
        tab.addEventListener("click", () => {
          const id = tab.getAttribute("data-cd-tab");
          if (id) activateTab(id);
        });
        tab.addEventListener("keydown", (e) => {
          if (e.key !== "ArrowRight" && e.key !== "ArrowLeft" && e.key !== "Home" && e.key !== "End") return;
          e.preventDefault();
          let next = idx;
          if (e.key === "ArrowRight") next = (idx + 1) % tabs.length;
          if (e.key === "ArrowLeft") next = (idx - 1 + tabs.length) % tabs.length;
          if (e.key === "Home") next = 0;
          if (e.key === "End") next = tabs.length - 1;
          const nextId = tabs[next]?.getAttribute("data-cd-tab");
          if (nextId) activateTab(nextId, true);
        });
      });

      const form = document.querySelector("[data-cd-form]");
      const reasonSelect = document.querySelector("[data-cd-reason]");
      const patientSelect = document.querySelector("[data-cd-patient]");
      const echo = document.querySelector("[data-cd-echo]");
      const submitBtn = document.querySelector("[data-cd-submit]");

      const updateGuidance = () => {
        if (!reasonSelect || !echo || !submitBtn) return;
        const reason = reasonSelect.value;
        const patient = patientSelect?.value || "New patient";
        if (reason === "emergency") {
          echo.textContent =
            "For tooth pain, swelling, or damage, please call reception directly on 028 4483 2585 for urgent triage.";
          submitBtn.textContent = "Call emergency reception: 028 4483 2585";
          submitBtn.classList.add("cd-btn--urgent");
        } else if (reason === "nervous") {
          echo.textContent = `${patient}: book a calm first consultation online and mention IV sedation or nervous-patient support in your booking note.`;
          submitBtn.textContent = "Open DentalHub online diary ↗";
          submitBtn.classList.remove("cd-btn--urgent");
        } else {
          echo.textContent = `${patient}: choose an appointment slot directly in Crossgar Dental Practice's DentalHub diary.`;
          submitBtn.textContent = "Open DentalHub online diary ↗";
          submitBtn.classList.remove("cd-btn--urgent");
        }
      };

      reasonSelect?.addEventListener("change", updateGuidance);
      patientSelect?.addEventListener("change", updateGuidance);
      updateGuidance();

      form?.addEventListener("submit", (e) => {
        e.preventDefault();
        const reason = reasonSelect?.value || "routine";
        if (reason === "emergency") {
          const tel = form.getAttribute("data-phone-href") || "tel:+442844832585";
          window.location.href = tel;
          return;
        }
        const url = form.getAttribute("data-book-url");
        if (url) window.open(url, "_blank", "noopener,noreferrer");
      });
    })();
  </script>
</ConceptLayout>
