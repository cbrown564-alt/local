---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import CdMark from "./CdMark.astro";

/* Crossgar Dental Practice — 48 Killyleagh Street, Crossgar, BT30 9DQ.
   Sources (live-fetched 26 Nov 2026): crossgardentalpractice.co.uk (/, /contact).
   - Accepting New Patients.
   - Live DentalHub online booking portal:
     https://uk.dentalhub.online/soe/new/Crossgar%20Dental%20Practice?pid=UKPOH01
   - Phone: 028 4483 2585 (recommended directly for dental emergencies).
   - Treatments published on site: Routine Dental Care, Dental Hygiene,
     Restorative Dentistry, Cosmetic Dentistry, Orthodontics (Clear Aligners,
     Ceramic Braces, Retainers), Dental Implants (Single, Multiple, All-on-4,
     Implant Supported Dentures), IV Sedation & Nervous Patients, Dentistry for
     Children, Dental Emergencies, Membership Plans & Treatment Fees.
   Brief: research/concepts/crossgar-dental/crossgar-dental-elevation-brief.md */

const phone = "028 4483 2585";
const phoneHref = "tel:+442844832585";
const bookOnline = "https://uk.dentalhub.online/soe/new/Crossgar%20Dental%20Practice?pid=UKPOH01";
const facebook = "https://www.facebook.com/crossgardental";
const instagram = "https://www.instagram.com/crossgar_dental/";
const mapHref = "https://www.google.com/maps/dir//48+Killyleagh+Rd,+Crossgar,+Downpatrick+BT30+9DQ/@54.3977088,-5.7582088,16z";
const fontHref =
  "https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700&display=swap";

const treatments = [
  {
    name: "Routine Care & Hygiene",
    summary: "Check-ups, preventive dentistry, dental hygiene appointments and dentistry for children.",
    href: "https://www.crossgardentalpractice.co.uk/dental-treatments/routine-dental-care",
  },
  {
    name: "Dental Implants",
    summary: "Permanent, natural-looking tooth replacement — single implants, multiple teeth, All-on-4 and implant-supported dentures.",
    href: "https://www.crossgardentalpractice.co.uk/dental-treatments/dental-implants",
  },
  {
    name: "Orthodontics & Clear Aligners",
    summary: "Subtle teeth straightening with clear aligners, ceramic braces and custom retainers.",
    href: "https://www.crossgardentalpractice.co.uk/dental-treatments/orthodontics",
  },
  {
    name: "Cosmetic & Restorative Dentistry",
    summary: "Restorative and cosmetic care tailored to your smile and long-term oral health.",
    href: "https://www.crossgardentalpractice.co.uk/dental-treatments/cosmetic-dentistry",
  },
  {
    name: "Nervous Patients & IV Sedation",
    summary: "Calm, gentle dental care with sedation options designed to put anxious patients at ease.",
    href: "https://www.crossgardentalpractice.co.uk/for-patients/nervous-patients",
  },
  {
    name: "Fees & Membership Plans",
    summary: "Clear treatment fees and ongoing membership plans to help spread the cost of care.",
    href: "https://www.crossgardentalpractice.co.uk/contact",
  },
];
---

<ConceptLayout
  title="Crossgar Dental Practice — 48 Killyleagh Street, Crossgar"
  slug="crossgar-dental"
  bodyClass="concept-page concept-crossgardental"
  lang="en-GB"
  businessName="Crossgar Dental Practice"
  town="Crossgar"
  fontHref={fontHref}
  bannerNote="The practice mark is drawn for this page. Online booking hands straight to Crossgar Dental Practice's own DentalHub portal; emergency calls go to 028 4483 2585."
>
  <div class="cd-strip">
    <span>48 Killyleagh Street, Crossgar, BT30 9DQ · Accepting New Patients</span>
    <span>Dental emergency? Call <a href={phoneHref}>{phone}</a> directly</span>
  </div>

  <header class="cd-header">
    <a class="cd-brand" href="#top">
      <CdMark size={38} tone="teal" />
      <span class="cd-brand-text">
        <strong>Crossgar Dental Practice</strong>
        <small>Crossgar · County Down</small>
      </span>
    </a>
    <nav class="cd-nav" aria-label="Crossgar Dental Practice">
      <a href="#treatments">Treatments</a>
      <a href="#nervous">Nervous Patients</a>
      <a href="#new-patients">New Patients</a>
      <a href="#find">Find Us</a>
    </nav>
    <a class="cd-header-cta" href={bookOnline} rel="noopener noreferrer">Book Online ↗</a>
  </header>

  <main id="top">
    <section class="cd-hero" aria-labelledby="cd-hero-title">
      <div class="cd-wrap cd-hero-grid">
        <div>
          <p class="cd-kicker">48 Killyleagh Street · Crossgar</p>
          <h1 id="cd-hero-title">Calm, modern dentistry <em>for Crossgar and Downpatrick.</em></h1>
          <p class="cd-lede">
            From routine check-ups and family care to dental implants, clear
            aligners and IV sedation for nervous patients — book online in a
            couple of taps or speak directly with our reception team.
          </p>
          <div class="cd-hero-actions">
            <a class="cd-btn cd-btn--teal" href={bookOnline} rel="noopener noreferrer">Book an appointment online ↗</a>
            <a class="cd-btn cd-btn--outline" href={phoneHref}>Call {phone}</a>
          </div>
        </div>

        <aside class="cd-triage" aria-label="How can we help today">
          <p class="cd-kicker">Patient Desk</p>
          <h2>How can we help today?</h2>
          <div class="cd-triage-list">
            <a class="cd-triage-item" href={bookOnline} rel="noopener noreferrer">
              <strong>Book online (New &amp; Existing Patients)</strong>
              <span>Routine check-ups, hygiene, implants, clear aligners &amp; consultations via DentalHub ↗</span>
            </a>
            <a class="cd-triage-item cd-triage-item--urgent" href={phoneHref}>
              <strong>Urgent or dental emergency</strong>
              <span>Call reception directly on {phone} rather than using online booking.</span>
            </a>
            <a class="cd-triage-item" href="https://www.crossgardentalpractice.co.uk/contact" rel="noopener noreferrer">
              <strong>Send a treatment enquiry</strong>
              <span>Ask about fees, membership plans, or IV sedation on our contact page ↗</span>
            </a>
          </div>
        </aside>
      </div>
    </section>

    <section class="cd-section cd-treatments" id="treatments" aria-labelledby="cd-treatments-title">
      <div class="cd-wrap">
        <div class="cd-head">
          <div>
            <p class="cd-kicker">Dental Treatments</p>
            <h2 id="cd-treatments-title">Routine care through to implants and orthodontics.</h2>
          </div>
          <p>
            Personalised care under one roof on Killyleagh Street — whether you
            are due a routine check-up or exploring long-term restorative work.
          </p>
        </div>

        <div class="cd-grid">
          {treatments.map((t) => (
            <article class="cd-card">
              <h3>{t.name}</h3>
              <p>{t.summary}</p>
              <a href={t.href} rel="noopener noreferrer">Learn more ↗</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="cd-section cd-reassure" id="nervous" aria-labelledby="cd-reassure-title">
      <div class="cd-wrap cd-reassure-grid">
        <article class="cd-panel cd-panel--dark">
          <p class="cd-kicker cd-kicker--light">Nervous Patients &amp; Sedation</p>
          <h2 id="cd-reassure-title">Feeling anxious about dental treatment?</h2>
          <p>
            You are not alone. We take a calm, unhurried approach and offer
            <strong>IV sedation</strong> alongside gentle care so you stay
            comfortable and in control from your first conversation.
          </p>
          <a class="cd-btn cd-btn--coral" href={bookOnline} rel="noopener noreferrer">Book a calm first visit ↗</a>
        </article>

        <article class="cd-panel" id="new-patients">
          <p class="cd-kicker">Accepting New Patients</p>
          <h2>Straightforward first visits for adults and children.</h2>
          <p>
            Whether you are joining us for routine care, bringing children for
            check-ups, or asking about a specific concern, our team will walk
            you through options and fees clearly before any treatment starts.
          </p>
          <div class="cd-panel-links">
            <a class="cd-btn cd-btn--teal" href={bookOnline} rel="noopener noreferrer">Register &amp; book online ↗</a>
            <a class="cd-btn cd-btn--outline" href={phoneHref}>Call {phone}</a>
          </div>
        </article>
      </div>
    </section>

    <section class="cd-section cd-find" id="find" aria-labelledby="cd-find-title">
      <div class="cd-wrap cd-find-grid">
        <div>
          <p class="cd-kicker">Find the Practice</p>
          <h2 id="cd-find-title">48 Killyleagh Street, Crossgar.</h2>
          <p>
            Centrally located in Crossgar village, serving patients across
            Crossgar, Downpatrick, Saintfield, Killyleagh and Ballynahinch.
          </p>
          <div class="cd-find-actions">
            <a class="cd-btn cd-btn--teal" href={mapHref} rel="noopener noreferrer">Directions on Google Maps ↗</a>
            <a class="cd-btn cd-btn--outline" href={phoneHref}>Call {phone}</a>
          </div>
        </div>
        <div class="cd-find-card">
          <dl>
            <div><dt>Address</dt><dd>48 Killyleagh Street, Crossgar, Downpatrick, BT30 9DQ</dd></div>
            <div><dt>Reception &amp; Emergencies</dt><dd><a href={phoneHref}>{phone}</a></dd></div>
            <div><dt>Online Booking</dt><dd><a href={bookOnline} rel="noopener noreferrer">DentalHub Online Portal ↗</a></dd></div>
            <div><dt>Social</dt><dd><a href={facebook} rel="noopener noreferrer">Facebook</a> · <a href={instagram} rel="noopener noreferrer">Instagram</a></dd></div>
          </dl>
        </div>
      </div>
    </section>
  </main>

  <footer class="cd-footer">
    <div class="cd-wrap cd-footer-inner">
      <div class="cd-footer-brand">
        <CdMark size={32} tone="white" />
        <div>
          <strong>Crossgar Dental Practice</strong>
          <span>48 Killyleagh Street, Crossgar, BT30 9DQ</span>
        </div>
      </div>
      <p class="cd-footer-right">
        <a href={phoneHref}>{phone}</a> · <a href={bookOnline} rel="noopener noreferrer">Book Online ↗</a>
      </p>
    </div>
  </footer>
</ConceptLayout>
