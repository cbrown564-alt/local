---
interface Props {
  size?: number;
  tone?: "teal" | "white" | "coral";
}
const { size = 40, tone = "teal" } = Astro.props;
const stroke = tone === "white" ? "#fbfcfc" : tone === "coral" ? "#c76b43" : "#123c42";
---
<svg width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <rect x="3" y="3" width="42" height="42" rx="10" stroke={stroke} stroke-width="1.6" />
  <path d="M16 20C16 14.8 19.6 12 24 12C28.4 12 32 14.8 32 20C32 25.5 29.5 34.5 27 34.5C25.5 34.5 25.2 29 24 29C22.8 29 22.5 34.5 21 34.5C18.5 34.5 16 25.5 16 20Z" stroke={stroke} stroke-width="1.7" stroke-linejoin="round" />
</svg>
