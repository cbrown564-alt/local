---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";
import BcMark from "./BcMark.astro";

/* Belleek Country House — 16 Main Street, Belleek, Newry, BT35 7PH (6 miles from Newry City).
   Sources (live-fetched 26 Nov 2026): belleekcountryhouse.com (/, /about-us/,
   /restaurant-bar/, /weddings/, /contact-us/) and FSA FHRS register (Authority
   145, inspected 2026-09-24).
   - Family-run bar, restaurant & events venue welcoming visitors for decades.
   - Hours published on /contact-us/:
     Monday–Thursday: Closed · Friday: 4:00pm – 1:00am (Steak Night from 5pm) ·
     Saturday & Sunday: 12 noon – 1:00am.
   - Live menu PDF: https://belleekcountryhouse.com/wp-content/uploads/2025/07/Belleek_Country_House_MAINMAINMenu_2025.pdf
   - Weddings: One wedding a day, bespoke wedding packages, experienced staff.
   - Events: Baby Showers, Birthdays & Anniversaries, Christenings & Baptisms,
     Hen Parties, Funerals, Weddings & Other Celebrations; live music & live sports.
   - Phone: 028 3087 8999 · Facebook & Instagram (@belleekcountryhouse).
     No public email is published, so enquiries build a copy-ready note for
     phone or Instagram/Facebook DM without inventing an address.
   Brief: research/concepts/belleek-country-house/belleek-country-house-elevation-brief.md */

const phone = "028 3087 8999";
const phoneHref = "tel:+442830878999";
const menuPdf = "https://belleekcountryhouse.com/wp-content/uploads/2025/07/Belleek_Country_House_MAINMAINMenu_2025.pdf";
const facebook = "https://www.facebook.com/profile.php?id=100063707553686";
const instagram = "https://www.instagram.com/belleekcountryhouse";
const mapHref = "https://www.google.com/maps/search/?api=1&query=16+Main+Street+Belleek+Newry+BT35+7PH";
const fontHref =
  "https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Figtree:wght@400;500;600;700&display=swap";

const celebrations = [
  "Weddings · One wedding a day",
  "Christenings & Baptisms",
  "Birthdays & Anniversaries",
  "Baby Showers",
  "Hen Parties",
  "Funerals & Family Gatherings",
];

const hours = [
  { days: "Monday – Thursday", time: "Closed", note: "Private event enquiries welcome by telephone." },
  { days: "Friday", time: "4:00pm – 1:00am", note: "Steak Night specials served every Friday from 5:00pm." },
  { days: "Saturday & Sunday", time: "12:00 noon – 1:00am", note: "All-day dining, bar, live music & live sports." },
];
---

<ConceptLayout
  title="Belleek Country House — Bar, Restaurant & Weddings, Belleeks, Newry"
  slug="belleek-country-house"
  bodyClass="concept-page concept-belleek"
  lang="en-GB"
  businessName="Belleek Country House"
  town="Belleeks / Camlough"
  fontHref={fontHref}
  bannerNote="The candlelit wedding table and Friday steak supper scenes are AI-generated visualisations. The main menu links to Belleek Country House's published PDF; bookings and wedding enquiries go by phone (028 3087 8999), Instagram or Facebook."
>
  <header class="bc-header">
    <div class="bc-wrap bc-header-inner">
      <nav class="bc-nav" aria-label="Left navigation">
        <a href="#weddings">One Wedding a Day</a>
        <a href="#steak-night">Friday Steak Night</a>
      </nav>
      <a class="bc-crest" href="#top">
        <BcMark size={32} tone="gold" />
        <strong>Belleek Country House</strong>
      </a>
      <nav class="bc-nav bc-nav--right" aria-label="Right navigation">
        <a href="#rsvp">Enquire</a>
        <a href={phoneHref}>{phone}</a>
      </nav>
    </div>
  </header>

  <main id="top" class="bc-main">
    <section class="bc-invitation-hero" aria-labelledby="bc-hero-title">
      <figure class="bc-hero-backdrop">
        <ResponsiveImage
          src="/media/concepts/belleek-country-house/belleek-country-house-wedding-table.jpg"
          alt="Candlelit country-house wedding banquet dining table dressed in ivory linen, claret flowers and brass candlesticks"
          width={1376}
          height={768}
          loading="eager"
          sizes="100vw"
          class="bc-hero-img"
        />
        <figcaption class="bc-hero-cap">Candlelit wedding banquet room mood. Visualisation (AI-generated).</figcaption>
      </figure>
      <div class="bc-hero-scrim" aria-hidden="true"></div>

      <div class="bc-wrap bc-invitation-stage">
        <div class="bc-invitation-card">
          <div class="bc-invitation-inner">
            <p class="bc-eyebrow">16 Main Street, Belleek · Six Miles from Newry</p>
            <h1 id="bc-hero-title">Come as guests, <em>leave as friends.</em></h1>
            <p class="bc-inv-lede">
              A family-run country house bar, restaurant and wedding venue
              welcoming South Armagh for decades — homemade dishes from fresh
              local produce, Friday Steak Night, live music, and one dedicated
              wedding a day.
            </p>
            <div class="bc-inv-actions">
              <a class="bc-btn bc-btn--gold" href="#rsvp">Check a wedding or table date</a>
              <a class="bc-btn bc-btn--ghost" href={menuPdf} rel="noopener noreferrer">Main Menu PDF ↗</a>
            </div>
            <p class="bc-inv-hours">
              Open Fri 4pm – 1am (Steak Night from 5pm) · Sat &amp; Sun 12 noon – 1am · <a href={phoneHref}>{phone}</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="bc-promise" id="weddings" aria-labelledby="bc-weddings-title">
      <div class="bc-wrap bc-promise-inner">
        <p class="bc-eyebrow bc-eyebrow--claret">Weddings &amp; Family Milestones</p>
        <h2 id="bc-weddings-title">One wedding a day — never shared, never rushed.</h2>
        <div class="bc-rule-vert" aria-hidden="true"></div>
        <p class="bc-promise-copy">
          Whether you are gathering a close circle of family or filling the
          dining room for a full reception, Belleek Country House hosts strictly{" "}
          <strong>one wedding a day</strong>. Our experienced family-run team
          shapes bespoke wedding packages around your table, your music and your
          pace — and brings the exact same care to every family occasion through
          the year.
        </p>

        <ul class="bc-occasions">
          {celebrations.map((c) => <li>{c}</li>)}
        </ul>

        <a class="bc-btn bc-btn--claret" href="#rsvp">Prepare a wedding or celebration note</a>
      </div>
    </section>

    <section class="bc-supper" id="steak-night" aria-labelledby="bc-dining-title">
      <div class="bc-supper-grid">
        <figure class="bc-steak-plate">
          <ResponsiveImage
            src="/media/concepts/belleek-country-house/belleek-country-house-steak-night.jpg"
            alt="Candlelit seared ribeye steak on dark stoneware with peppercorn sauce, charred greens and a glass of red wine"
            width={1200}
            height={896}
            sizes="(max-width: 960px) 100vw, 48vw"
            class="bc-steak-img"
          />
          <figcaption>Friday evening Steak Night mood. Visualisation (AI-generated).</figcaption>
        </figure>

        <div class="bc-supper-bill">
          <div class="bc-bill-frame">
            <p class="bc-eyebrow">The Restaurant &amp; Bar · Weekend Supper Bill</p>
            <h2 id="bc-dining-title">Friday Steak Night from 5pm — and weekend music in the bar.</h2>
            <p class="bc-bill-copy">
              Homemade dishes cooked from fresh local ingredients — starters
              through indulgent desserts, alongside a full bar, live sporting
              fixtures and weekend live music.
            </p>

            <dl class="bc-bill-hours">
              {hours.map((h) => (
                <div class="bc-bill-row">
                  <dt>
                    <strong>{h.days}</strong>
                    <span>{h.note}</span>
                  </dt>
                  <dd>{h.time}</dd>
                </div>
              ))}
            </dl>

            <div class="bc-bill-actions">
              <a class="bc-btn bc-btn--gold" href={menuPdf} rel="noopener noreferrer">Open Main Menu PDF ↗</a>
              <a class="bc-btn bc-btn--ghost" href={phoneHref}>Book a table · {phone}</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bc-rsvp" id="rsvp" aria-labelledby="bc-rsvp-title">
      <div class="bc-wrap">
        <div class="bc-rsvp-card">
          <div class="bc-rsvp-head">
            <p class="bc-eyebrow bc-eyebrow--claret">Enquiries &amp; Table Reservations</p>
            <h2 id="bc-rsvp-title">Prepare your date &amp; guest count.</h2>
            <p>
              Put your occasion details together below to copy a tidy enquiry
              note for Instagram or Facebook — or speak straight to the house on{" "}
              <a href={phoneHref}><strong>{phone}</strong></a>.
            </p>
          </div>

          <form class="bc-form" id="bc-form">
            <div class="bc-row">
              <label>
                <span>Occasion</span>
                <select name="occasion">
                  <option value="Wedding (One wedding a day)">Wedding (One wedding a day)</option>
                  <option value="Friday Steak Night / Table Booking">Friday Steak Night / Table Booking</option>
                  <option value="Birthday or Anniversary">Birthday or Anniversary</option>
                  <option value="Christening or Baby Shower">Christening or Baby Shower</option>
                  <option value="Hen Party or Celebration">Hen Party or Celebration</option>
                  <option value="Funeral Gathering">Funeral Gathering</option>
                </select>
              </label>
              <label>
                <span>Preferred date or month</span>
                <input name="date" placeholder="e.g. Saturday 12 Sept 2026" />
              </label>
            </div>
            <div class="bc-row">
              <label>
                <span>Estimated guests</span>
                <input name="guests" placeholder="e.g. 6 for Steak Night or 120 wedding guests" />
              </label>
              <label>
                <span>Your name &amp; phone</span>
                <input name="who" placeholder="Name and callback number" />
              </label>
            </div>
            <div class="bc-form-actions">
              <button class="bc-btn bc-btn--claret" type="submit">Copy enquiry note</button>
              <a class="bc-btn bc-btn--outline" href={phoneHref}>Call {phone}</a>
              <a class="bc-btn bc-btn--outline" href={instagram} rel="noopener noreferrer">Instagram ↗</a>
              <a class="bc-btn bc-btn--outline" href={facebook} rel="noopener noreferrer">Facebook ↗</a>
              <a class="bc-btn bc-btn--outline" href={mapHref} rel="noopener noreferrer">Google Maps ↗</a>
            </div>
            <p class="bc-status" id="bc-status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer class="bc-footer">
    <div class="bc-wrap bc-footer-inner">
      <span><strong>Belleek Country House</strong> · 16 Main Street, Belleek, Newry, BT35 7PH (6 miles from Newry City)</span>
      <span><a href={phoneHref}>{phone}</a> · <a href={facebook} rel="noopener noreferrer">Facebook</a> · <a href={instagram} rel="noopener noreferrer">Instagram</a></span>
    </div>
  </footer>

  <script>
    const form = document.getElementById("bc-form") as HTMLFormElement | null;
    const status = document.getElementById("bc-status");
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const d = new FormData(form);
      const text = [
        "Enquiry — Belleek Country House",
        `Occasion: ${d.get("occasion") || ""}`,
        `Preferred date: ${d.get("date") || "To confirm"}`,
        `Estimated guests: ${d.get("guests") || "To confirm"}`,
        `Contact: ${d.get("who") || ""}`,
      ].join("\n");
      try {
        await navigator.clipboard.writeText(text);
        if (status) status.textContent = "Note copied — paste it into Instagram or Facebook, or call 028 3087 8999.";
      } catch {
        if (status) status.textContent = text;
      }
    });
  </script>
</ConceptLayout>
