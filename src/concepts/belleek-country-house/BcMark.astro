---
interface Props {
  size?: number;
  tone?: "gold" | "claret" | "ivory";
}
const { size = 40, tone = "gold" } = Astro.props;
const stroke = tone === "claret" ? "#4c1d28" : tone === "ivory" ? "#f8f3ea" : "#c79e54";
---
<svg width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <rect x="4" y="4" width="40" height="40" rx="20" stroke={stroke} stroke-width="1.5" />
  <path d="M13 26L24 16L35 26" stroke={stroke} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M17 24V34H31V24" stroke={stroke} stroke-width="1.5" />
  <path d="M22 34V28H26V34" stroke={stroke} stroke-width="1.4" />
</svg>
