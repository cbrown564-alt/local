---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import "./styles.css";

/* The Yellow Heifer, 16 Main Street, Camlough, Newry BT35 7JG.
   Verified live 26 Nov 2026: live Dojo booking link, 028 3083 0505,
   theyellowheifer@hotmail.co.uk, FSA verified. Thu to Sun from 11:00. */
const phone = "028 3083 0505";
const phoneHref = "tel:+442830830505";
const email = "theyellowheifer@hotmail.co.uk";
const dojoHref = "https://web.dojo.app/create_booking/vendor/qdHtdJlDZFSwNtZPFUD8yehWZCdiQLd-Z91qYLKIoJc_restaurant";
const fbHref = "https://www.facebook.com/theyellowheifer/";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=The+Yellow+Heifer+16+Main+Street+Camlough+BT35+7JG";

const menuGroups = [
  {
    id: "grill",
    label: "Grill and bistro",
    items: [
      {
        name: "Irish dry-aged steaks",
        note: "Chargrilled to order with herb butter, peppercorn jus, and hand-cut chips.",
        meta: "Cooked to order",
      },
      {
        name: "Bistro and seasonal mains",
        note: "Fresh local meat, poultry, and coastal seafood plates prepared in-house.",
        meta: "Thursday to Sunday",
      },
      {
        name: "Allergy and dietary care",
        note: "Dishes cooked to order so gluten-free and dietary needs are handled properly.",
        meta: "Tell your server",
      },
    ],
  },
  {
    id: "day",
    label: "Brunch, Sunday, and drinks",
    items: [
      {
        name: "Weekend brunch and lunch",
        note: "Served from 11:00 Thursday through Sunday in the village bistro.",
        meta: "From 11:00",
      },
      {
        name: "Sunday dinner",
        note: "Traditional Sunday plates and family tables in Camlough.",
        meta: "Sunday 11:00 to 19:30",
      },
      {
        name: "Cocktails and bar",
        note: "House cocktails, draught pints, and curated wines from the bar.",
        meta: "Bar and bistro",
      },
    ],
  },
];
---

<ConceptLayout
  title="The Yellow Heifer, Bar & Bistro, Camlough"
  slug="the-yellow-heifer"
  bodyClass="concept-page concept-yellowheifer"
  businessName="The Yellow Heifer"
  town="Camlough"
  bannerNote="Imagery comprises indicative dining-room and chargrill visualisations generated for illustration."
>
  <header class="yh-header" data-yh-header>
    <div class="yh-header-inner">
      <a class="yh-brand" href="#top">The Yellow Heifer</a>
      <nav class="yh-nav" aria-label="Primary">
        <a href="#kitchen">Kitchen and bar</a>
        <a href="#hours">Service hours</a>
        <a href="#private-tables">Group tables</a>
        <a href="#location">Find us</a>
      </nav>
      <div class="yh-header-actions">
        <a class="yh-header-tel" href={phoneHref}>{phone}</a>
        <a class="yh-header-cta" href={dojoHref} target="_blank" rel="noopener noreferrer">Book a table</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="yh-hero" aria-labelledby="yh-hero-title">
      <div class="yh-hero-sentinel" data-yh-sentinel aria-hidden="true"></div>
      <div class="yh-hero-media">
        <picture>
          <source
            srcset="/media/concepts/the-yellow-heifer/yellow-heifer-dining-room-640.webp 640w, /media/concepts/the-yellow-heifer/yellow-heifer-dining-room-1265.webp 1265w"
            sizes="100vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/the-yellow-heifer/yellow-heifer-dining-room.jpg"
            alt="Warm evening village bistro interior with timber panelling, ochre leather banquettes, and brass lamps"
            width="1408"
            height="768"
            loading="eager"
          />
        </picture>
        <div class="yh-hero-scrim" aria-hidden="true"></div>
      </div>

      <div class="yh-wrap yh-hero-foot">
        <div class="yh-hero-title-col">
          <h1 id="yh-hero-title">Cooked to order in Camlough.</h1>
        </div>
        <div class="yh-hero-copy-col">
          <p class="yh-hero-lead">
            Dry-aged Irish steaks, weekend brunch, and house cocktails served Thursday through Sunday, five minutes from Newry.
          </p>
          <a class="yh-btn yh-btn--amber" href={dojoHref} target="_blank" rel="noopener noreferrer">Reserve a table</a>
          <p class="yh-hero-caption">Indicative Camlough bistro dining room visualisation.</p>
        </div>
      </div>
    </section>

    <section class="yh-section yh-stage" id="kitchen" aria-labelledby="yh-kitchen-title">
      <div class="yh-wrap yh-stage-grid">
        <div class="yh-stage-copy">
          <h2 id="yh-kitchen-title">Fresh plates, steady fire, unhurried tables.</h2>

          <div class="yh-tabs" role="tablist" aria-label="Kitchen, brunch, and cocktails" data-yh-tabs>
            <button
              type="button"
              class="yh-tab"
              role="tab"
              id="yh-tab-steaks"
              aria-selected="true"
              aria-controls="yh-panel-steaks"
            >
              Dry-aged steaks
            </button>
            <button
              type="button"
              class="yh-tab"
              role="tab"
              id="yh-tab-brunch"
              aria-selected="false"
              aria-controls="yh-panel-brunch"
              tabindex="-1"
            >
              Weekend brunch
            </button>
            <button
              type="button"
              class="yh-tab"
              role="tab"
              id="yh-tab-cocktails"
              aria-selected="false"
              aria-controls="yh-panel-cocktails"
              tabindex="-1"
            >
              Cocktails and groups
            </button>
          </div>

          <div class="yh-panel" role="tabpanel" id="yh-panel-steaks" aria-labelledby="yh-tab-steaks">
            <p>
              Every order is prepared fresh from the pass rather than waiting under heat lamps, so our chefs gladly adapt dishes for gluten-free and dietary requests.
            </p>
            <dl class="yh-stage-ledger">
              <div>
                <dt>Irish dry-aged steaks</dt>
                <dd>Chargrilled to order with herb butter, peppercorn jus, and hand-cut chips</dd>
              </div>
              <div>
                <dt>Seasonal bistro mains</dt>
                <dd>Fresh local meat, poultry, and coastal seafood cooked in-house</dd>
              </div>
              <div>
                <dt>Live table diary</dt>
                <dd><a href={dojoHref} target="_blank" rel="noopener noreferrer">Book instantly via Dojo ↗</a></dd>
              </div>
            </dl>
          </div>

          <div class="yh-panel" role="tabpanel" id="yh-panel-brunch" aria-labelledby="yh-tab-brunch" hidden>
            <p>
              From Thursday morning brunch through lively Saturday lunches and traditional family Sunday dinners on Main Street.
            </p>
            <dl class="yh-stage-ledger">
              <div>
                <dt>Brunch and lunch</dt>
                <dd>Served from 11:00 Thursday through Sunday in Camlough</dd>
              </div>
              <div>
                <dt>Sunday dinner</dt>
                <dd>Traditional Sunday plates served from 11:00 to 19:30</dd>
              </div>
              <div>
                <dt>Village parking</dt>
                <dd>Easy access right off Main Street, five minutes west of Newry</dd>
              </div>
            </dl>
          </div>

          <div class="yh-panel" role="tabpanel" id="yh-panel-cocktails" aria-labelledby="yh-tab-cocktails" hidden>
            <p>
              House cocktails, draught pints, and curated wines poured beside bistro mains, with set-table hospitality for birthdays and family celebrations.
            </p>
            <dl class="yh-stage-ledger">
              <div>
                <dt>Bar and cocktails</dt>
                <dd>House cocktails, draught pints, and wines from the bar</dd>
              </div>
              <div>
                <dt>Parties of eight or more</dt>
                <dd><a href="#private-tables">Send a group table enquiry below</a></dd>
              </div>
              <div>
                <dt>Direct desk</dt>
                <dd><a href={phoneHref}>{phone}</a></dd>
              </div>
            </dl>
          </div>

          <div class="yh-stage-sheet">
            <SpecimenSheet
              id="yh-menu-sheet"
              triggerLabel="Browse full kitchen and bar guide"
              kicker="The Yellow Heifer, 16 Main Street, Camlough"
              title="Kitchen, chargrill, and bar guide"
              subtitle="Everything is cooked to order so gluten-free and dietary requests are handled properly."
              groups={menuGroups}
              ctaLabel="Book online via Dojo ↗"
              ctaHref={dojoHref}
              ctaExternal={true}
              secondaryLabel={`Call ${phone}`}
              secondaryHref={phoneHref}
              buttonClass="yh-link-trigger"
            />
          </div>
        </div>

        <div class="yh-stage-media">
          <figure class="yh-plate">
            <picture>
              <source
                srcset="/media/concepts/the-yellow-heifer/yellow-heifer-chargrilled-steak-640.webp 640w, /media/concepts/the-yellow-heifer/yellow-heifer-chargrilled-steak-1265.webp 1265w"
                sizes="(max-width: 860px) 100vw, 48vw"
                type="image/webp"
              />
              <img
                src="/media/concepts/the-yellow-heifer/yellow-heifer-chargrilled-steak.jpg"
                alt="Seared Irish dry-aged ribeye steak with herb butter, peppercorn jus, and hand-cut chips"
                width="1408"
                height="768"
                loading="lazy"
              />
            </picture>
            <figcaption>Chargrilled steak and bistro service at The Yellow Heifer. Indicative food visualisation.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="yh-section yh-hours-band" id="hours" aria-labelledby="yh-hours-title">
      <div class="yh-wrap yh-split">
        <div class="yh-copy-col">
          <h2 id="yh-hours-title">Thursday through Sunday on Main Street.</h2>
          <p>
            Reserve ahead through our live Dojo diary for Friday and Saturday evening sittings or Sunday family tables. For same-day changes, ring the desk directly on <a href={phoneHref}>{phone}</a>.
          </p>
          <a class="yh-btn yh-btn--primary" href={dojoHref} target="_blank" rel="noopener noreferrer">Open live table diary ↗</a>
        </div>
        <div class="yh-ledger-col">
          <dl class="yh-hours-ledger">
            <div><dt>Monday to Wednesday</dt><dd>Closed</dd></div>
            <div><dt>Thursday</dt><dd>11:00 to 20:00</dd></div>
            <div><dt>Friday</dt><dd>11:00 to 20:30</dd></div>
            <div><dt>Saturday</dt><dd>11:00 to 21:00</dd></div>
            <div><dt>Sunday</dt><dd>11:00 to 19:30</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section class="yh-section yh-enquiry-band" id="private-tables" aria-labelledby="yh-enq-title">
      <div class="yh-wrap yh-split">
        <div class="yh-copy-col">
          <h2 id="yh-enq-title">Planning a birthday, christening, or family table?</h2>
          <p>
            For parties of eight or more, set-menu occasions, or dietary notes ahead of your visit, send us the outline below and we will come straight back to you from Camlough.
          </p>
          <p class="yh-contact-line">
            Direct desk: <a href={phoneHref}>{phone}</a>, <a href={`mailto:${email}`}>{email}</a>
          </p>
        </div>
        <div class="yh-form-col">
          <form class="yh-form" data-yh-form>
            <div class="yh-row">
              <label>
                <span>Your name</span>
                <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
              </label>
              <label>
                <span>Telephone</span>
                <input name="phone" type="tel" required autocomplete="tel" placeholder="028 or 07..." />
              </label>
            </div>
            <div class="yh-row">
              <label>
                <span>Preferred date</span>
                <input name="date" type="date" required />
              </label>
              <label>
                <span>Party size</span>
                <input name="guests" type="number" min="2" max="40" value="10" required />
              </label>
            </div>
            <label>
              <span>Sitting</span>
              <select name="sitting">
                <option value="Friday or Saturday evening dinner">Friday or Saturday evening dinner</option>
                <option value="Sunday family lunch">Sunday family lunch</option>
                <option value="Thursday bistro or brunch">Thursday bistro or brunch</option>
                <option value="Private celebration or set table">Private celebration or set table</option>
              </select>
            </label>
            <label>
              <span>Dietary notes or occasion</span>
              <textarea name="notes" rows="3" placeholder="Any gluten-free guests, children's seats, or special requests"></textarea>
            </label>
            <button class="yh-btn yh-btn--primary" type="submit">Send group table enquiry</button>
          </form>
        </div>
      </div>
    </section>

    <section class="yh-section yh-map-band" id="location" aria-label="Camlough Main Street location map">
      <div class="yh-wrap">
        <LocalAreaMap
          id="yh-map"
          kicker=""
          businessName="The Yellow Heifer"
          address="16 Main Street, Camlough, Newry, BT35 7JG"
          lon={-6.4096245}
          lat={54.1807255}
          spanKm={16}
          mapHref={mapsHref}
          markers={[
            { name: "Newry City", lon: -6.3402, lat: 54.1751, note: "7 mins east", side: "r" },
            { name: "Slieve Gullion", lon: -6.4336, lat: 54.1225, note: "10 mins south", side: "l" },
            { name: "Bessbrook", lon: -6.3955, lat: 54.1977, note: "4 mins north", side: "t" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="yh-footer">
    <div class="yh-wrap yh-footer-inner">
      <div>
        <strong>The Yellow Heifer</strong>
        <p>16 Main Street, Camlough, Newry, Co. Down, BT35 7JG</p>
      </div>
      <div class="yh-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={fbHref} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-yh-header]");
      const sentinel = document.querySelector("[data-yh-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            const entry = entries[0];
            if (!entry) return;
            header.classList.toggle("is-scrolled", !entry.isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      const tablist = document.querySelector("[data-yh-tabs]");
      if (tablist) {
        const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
        const activate = (tab, moveFocus) => {
          tabs.forEach((t) => {
            const selected = t === tab;
            t.setAttribute("aria-selected", String(selected));
            t.tabIndex = selected ? 0 : -1;
            const panelId = t.getAttribute("aria-controls");
            const panel = panelId ? document.getElementById(panelId) : null;
            if (panel) panel.hidden = !selected;
          });
          if (moveFocus) tab.focus();
        };
        tabs.forEach((tab, idx) => {
          tab.addEventListener("click", () => activate(tab, false));
          tab.addEventListener("keydown", (e) => {
            if (e.key === "ArrowRight") {
              e.preventDefault();
              activate(tabs[(idx + 1) % tabs.length], true);
            } else if (e.key === "ArrowLeft") {
              e.preventDefault();
              activate(tabs[(idx - 1 + tabs.length) % tabs.length], true);
            } else if (e.key === "Home") {
              e.preventDefault();
              activate(tabs[0], true);
            } else if (e.key === "End") {
              e.preventDefault();
              activate(tabs[tabs.length - 1], true);
            }
          });
        });
      }

      const form = document.querySelector("[data-yh-form]");
      if (form) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;
          const fd = new FormData(form);
          const subject = `Group table enquiry: ${fd.get("guests")} guests (${fd.get("date")})`;
          const body = [
            `Name: ${fd.get("name")}`,
            `Phone: ${fd.get("phone")}`,
            `Date: ${fd.get("date")}`,
            `Party size: ${fd.get("guests")}`,
            `Sitting: ${fd.get("sitting")}`,
            `Notes: ${fd.get("notes") || "None"}`,
          ].join("\n");
          const ev = new CustomEvent("mm:enquiry", {
            cancelable: true,
            detail: {
              to: "theyellowheifer@hotmail.co.uk",
              subject,
              body,
              phone: "028 3083 0505",
              phoneHref: "tel:+442830830505",
            },
          });
          if (window.dispatchEvent(ev)) {
            window.location.href = `mailto:theyellowheifer@hotmail.co.uk?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
          }
        });
      }
    })();
  </script>
</ConceptLayout>
