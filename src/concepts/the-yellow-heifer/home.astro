---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import "./styles.css";

/* The Yellow Heifer — Camlough, Newry BT35 7JG.
   Verified live 26 Nov 2026: http://www.theyellowheifer.co.uk/ (HTTP-only, raw --> leaks),
   live Dojo booking link, 028 3083 0505, theyellowheifer@hotmail.co.uk, FSA verified. */
const phone = "028 3083 0505";
const phoneHref = "tel:+442830830505";
const email = "theyellowheifer@hotmail.co.uk";
const dojoHref = "https://web.dojo.app/create_booking/vendor/qdHtdJlDZFSwNtZPFUD8yehWZCdiQLd-Z91qYLKIoJc_restaurant";
const fbHref = "https://www.facebook.com/theyellowheifer/";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=The+Yellow+Heifer+16+Main+Street+Camlough+BT35+7JG";

const menuGroups = [
  {
    id: "grill",
    label: "Grill & Bistro",
    items: [
      { name: "Irish Dry-Aged Steaks", note: "Chargrilled to order with herb butter, peppercorn jus & hand-cut chips", meta: "Cooked to order" },
      { name: "Bistro & Seasonal Mains", note: "Fresh local meat, poultry & coastal seafood plates prepared in-house", meta: "Thu – Sun" },
      { name: "Allergy & Dietary Care", note: "Dishes cooked to order so gluten-free and dietary needs are handled properly", meta: "Just tell your server" },
    ],
  },
  {
    id: "day",
    label: "Brunch, Sunday & Drinks",
    items: [
      { name: "Weekend Brunch & Lunch", note: "Served from 11am Thursday through Sunday in the village bistro", meta: "From 11:00" },
      { name: "Sunday Dinner", note: "Traditional Sunday plates and family tables in Camlough", meta: "Sun 11:00 – 19:30" },
      { name: "Cocktails & Bar", note: "House cocktails, draught pints and curated wines from the bar", meta: "Bar & Bistro" },
    ],
  },
];
---

<ConceptLayout
  title="The Yellow Heifer — Bar & Bistro, Camlough"
  slug="the-yellow-heifer"
  bodyClass="concept-page concept-yellowheifer"
  businessName="The Yellow Heifer"
  town="Camlough"
  bannerNote="Imagery comprises indicative dining-room and chargrill visualisations generated for illustration."
>
  <header class="yh-header">
    <div class="yh-header-inner">
      <a class="yh-brand" href="#top">
        <strong>The Yellow Heifer</strong>
        <span>Camlough · Bar &amp; Bistro</span>
      </a>
      <nav class="yh-nav" aria-label="Primary">
        <a href="#kitchen">The Kitchen</a>
        <a href="#hours">Service Hours</a>
        <a href="#private-tables">Group Tables</a>
        <a href="#location">Find Us</a>
      </nav>
      <div class="yh-header-actions">
        <a class="yh-header-tel" href={phoneHref}>{phone}</a>
        <a class="yh-header-cta" href={dojoHref} target="_blank" rel="noopener noreferrer">Book a Table</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="yh-hero" aria-labelledby="yh-hero-title">
      <div class="yh-hero-split">
        <div class="yh-hero-copy">
          <p class="yh-eyebrow">16 Main Street · Camlough · County Down</p>
          <h1 id="yh-hero-title">Cooked to order in Camlough.</h1>
          <p class="yh-hero-lead">
            Dry-aged Irish steaks, fresh bistro plates, weekend brunch and house cocktails served Thursday through
            Sunday, five minutes from Newry.
          </p>
          <div class="yh-hero-actions">
            <a class="yh-btn yh-btn--primary" href={dojoHref} target="_blank" rel="noopener noreferrer">Reserve a Table ↗</a>
            <SpecimenSheet
              id="yh-menu-sheet"
              triggerLabel="Browse Menu Guide"
              kicker="The Yellow Heifer · 16 Main Street, Camlough"
              title="Kitchen, Chargrill & Bar Guide"
              subtitle="Everything is cooked to order so gluten-free and dietary requests are handled properly."
              groups={menuGroups}
              ctaLabel="Book Online via Dojo ↗"
              ctaHref={dojoHref}
              ctaExternal={true}
              secondaryLabel={`Call ${phone}`}
              secondaryHref={phoneHref}
              buttonClass="yh-link-trigger"
            />
          </div>
          <dl class="yh-hero-facts">
            <div><dt>Open</dt><dd>Thu – Sun, from 11:00</dd></div>
            <div><dt>Booking</dt><dd>Live Dojo diary</dd></div>
            <div><dt>Direct Desk</dt><dd>{phone}</dd></div>
          </dl>
        </div>
        <figure class="yh-hero-media">
          <picture>
            <source srcset="/media/concepts/the-yellow-heifer/yellow-heifer-dining-room-640.webp 640w, /media/concepts/the-yellow-heifer/yellow-heifer-dining-room-1265.webp 1265w" sizes="(max-width: 960px) 100vw, 54vw" type="image/webp" />
            <img src="/media/concepts/the-yellow-heifer/yellow-heifer-dining-room.jpg" alt="Warm evening village bistro interior with timber panelling, ochre leather banquettes and brass lamps" width="1408" height="768" loading="eager" />
          </picture>
          <figcaption class="yh-hero-cap">Indicative bistro dining room visualisation.</figcaption>
        </figure>
      </div>
    </section>

    <section class="yh-section yh-kitchen" id="kitchen" aria-labelledby="yh-kitchen-title">
      <div class="yh-wrap yh-split">
        <div class="yh-copy">
          <p class="yh-kicker">From the Pass</p>
          <h2 id="yh-kitchen-title">Fresh plates, steady fire, unhurried tables.</h2>
          <p>
            From Thursday morning brunch through Saturday evening steaks and Sunday family dinners, our kitchen
            prepares every order fresh. Because nothing sits waiting under heat lamps, our chefs gladly adapt
            dishes for gluten-free and dietary requests.
          </p>
          <ul class="yh-highlights">
            <li><strong>Instant table booking</strong> via our live Dojo diary for lunch, dinner and Sunday service.</li>
            <li><strong>Bar &amp; cocktail list</strong> poured alongside bistro mains and weekend specials.</li>
            <li><strong>Easy village parking</strong> right off Main Street, five minutes west of Newry.</li>
          </ul>
        </div>
        <figure class="yh-plate">
          <picture>
            <source srcset="/media/concepts/the-yellow-heifer/yellow-heifer-chargrilled-steak-640.webp 640w, /media/concepts/the-yellow-heifer/yellow-heifer-chargrilled-steak-1265.webp 1265w" sizes="(max-width: 860px) 100vw, 48vw" type="image/webp" />
            <img src="/media/concepts/the-yellow-heifer/yellow-heifer-chargrilled-steak.jpg" alt="Seared Irish dry-aged ribeye steak with herb butter, peppercorn jus and hand-cut chips" width="1408" height="768" loading="lazy" />
          </picture>
          <figcaption>Chargrilled steak &amp; bistro service at The Yellow Heifer. Indicative food visualisation.</figcaption>
        </figure>
      </div>
    </section>

    <section class="yh-section yh-hours-band" id="hours" aria-labelledby="yh-hours-title">
      <div class="yh-wrap yh-hours-grid">
        <div>
          <p class="yh-kicker">Opening Hours</p>
          <h2 id="yh-hours-title">Thursday through Sunday on Main Street.</h2>
          <p class="yh-muted">
            Reserve ahead for Friday and Saturday evening sittings or Sunday family tables. For same-day changes,
            ring the desk directly on <a href={phoneHref}>{phone}</a>.
          </p>
        </div>
        <div class="yh-hours-card">
          <dl class="yh-hours-list">
            <div><dt>Monday – Wednesday</dt><dd>Closed</dd></div>
            <div><dt>Thursday</dt><dd>11:00 – 20:00</dd></div>
            <div><dt>Friday</dt><dd>11:00 – 20:30</dd></div>
            <div><dt>Saturday</dt><dd>11:00 – 21:00</dd></div>
            <div><dt>Sunday</dt><dd>11:00 – 19:30</dd></div>
          </dl>
          <a class="yh-btn yh-btn--primary yh-btn--full" href={dojoHref} target="_blank" rel="noopener noreferrer">Open Live Table Diary ↗</a>
        </div>
      </div>
    </section>

    <section class="yh-section yh-enquiry-band" id="private-tables" aria-labelledby="yh-enq-title">
      <div class="yh-wrap yh-enq-grid">
        <div class="yh-copy">
          <p class="yh-kicker">Larger Tables &amp; Celebrations</p>
          <h2 id="yh-enq-title">Planning a birthday, christening or family table?</h2>
          <p>
            For parties of eight or more, set-menu occasions, or dietary notes ahead of your visit, send us the
            outline below and we will come straight back to you from Camlough.
          </p>
          <p class="yh-contact-line">
            Direct desk: <a href={phoneHref}>{phone}</a> · <a href={`mailto:${email}`}>{email}</a>
          </p>
        </div>
        <form class="yh-form" data-yh-form>
          <div class="yh-row">
            <label>
              <span>Your name</span>
              <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
            </label>
            <label>
              <span>Telephone</span>
              <input name="phone" type="tel" required autocomplete="tel" placeholder="07..." />
            </label>
          </div>
          <div class="yh-row">
            <label>
              <span>Preferred date</span>
              <input name="date" type="date" required />
            </label>
            <label>
              <span>Party size</span>
              <input name="guests" type="number" min="2" max="40" value="10" required />
            </label>
          </div>
          <label>
            <span>Sitting</span>
            <select name="sitting">
              <option value="Friday / Saturday Evening">Friday / Saturday Evening Dinner</option>
              <option value="Sunday Family Lunch">Sunday Family Lunch</option>
              <option value="Thursday Bistro / Brunch">Thursday Bistro or Brunch</option>
              <option value="Private Celebration">Private Celebration / Set Table</option>
            </select>
          </label>
          <label>
            <span>Dietary notes or occasion</span>
            <textarea name="notes" rows="3" placeholder="Any gluten-free guests, children's seats, or special requests..."></textarea>
          </label>
          <button class="yh-btn yh-btn--primary" type="submit">Send Group Table Enquiry</button>
        </form>
      </div>
    </section>

    <section class="yh-section yh-map-band" id="location" aria-label="Location map">
      <div class="yh-wrap">
        <LocalAreaMap
          id="yh-map"
          kicker="Camlough & Ring of Gullion"
          businessName="The Yellow Heifer"
          address="16 Main Street, Camlough, Newry, BT35 7JG"
          lon={-6.4096245}
          lat={54.1807255}
          spanKm={16}
          mapHref={mapsHref}
          markers={[
            { name: "Newry City", lon: -6.3402, lat: 54.1751, note: "7 mins east", side: "r" },
            { name: "Slieve Gullion", lon: -6.4336, lat: 54.1225, note: "10 mins south", side: "l" },
            { name: "Bessbrook", lon: -6.3955, lat: 54.1977, note: "4 mins north", side: "t" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="yh-footer">
    <div class="yh-wrap yh-footer-inner">
      <div>
        <strong>The Yellow Heifer</strong>
        <p>16 Main Street, Camlough, Newry, Co. Down, BT35 7JG</p>
      </div>
      <div class="yh-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={fbHref} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const form = document.querySelector("[data-yh-form]");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        const subject = `Group Table Enquiry — ${fd.get("guests")} guests (${fd.get("date")})`;
        const body = [
          `Name: ${fd.get("name")}`,
          `Phone: ${fd.get("phone")}`,
          `Date: ${fd.get("date")}`,
          `Party size: ${fd.get("guests")}`,
          `Sitting: ${fd.get("sitting")}`,
          `Notes: ${fd.get("notes") || "None"}`,
        ].join("\n");
        const ev = new CustomEvent("mm:enquiry", {
          cancelable: true,
          detail: { to: "theyellowheifer@hotmail.co.uk", subject, body, phone: "028 3083 0505", phoneHref: "tel:+442830830505" },
        });
        if (window.dispatchEvent(ev)) {
          window.location.href = `mailto:theyellowheifer@hotmail.co.uk?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }
      });
    })();
  </script>
</ConceptLayout>
