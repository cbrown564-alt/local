---
import EnniskeenShell from "./components/EnniskeenShell.astro";
import EnkEstateMap from "./components/EnkEstateMap.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";
import { estate, generatedVisuals, outdoors, thingsToDo } from "./content";

/* The estate and the Mournes on one page. The pitch keeps one idea per
   section: the grounds, drawn; three reasons to come; where the house came
   from. The routes, packages and practical detail stay in content.ts for
   the finished site. */
const activities = [
  { title: "Walking", copy: outdoors.walking, image: generatedVisuals.walker },
  { title: "Golf", copy: outdoors.golf, image: generatedVisuals.royalCountyDown },
  { title: "Bikes", copy: outdoors.cycling, image: generatedVisuals.cycling },
];
const nearby = thingsToDo.nearby.filter((place) => place.label !== "Royal County Down");
---

<EnniskeenShell title={"The estate & the Mournes — Enniskeen Country House Hotel"} current="estate">
    <main>
      <section class="enk-int-hero enk-int-hero--flip">
        <div class="enk-int-hero-copy">
          <p class="enk-kicker">The estate &amp; the Mournes</p>
          <h1>Twelve wooded acres above the Shimna.</h1>
          <p class="enk-lede">{outdoors.lede}</p>
          <div class="enk-actions">
            <a class="enk-cta" href="#mournes">From the door</a>
          </div>
        </div>
        <figure class="enk-int-hero-image">
          <ResponsiveImage
            pictureClass="concept-responsive-picture"
            {...generatedVisuals.estate}
            loading="eager"
          />
          <figcaption>The estate</figcaption>
        </figure>
      </section>

      <section class="enk-map-section" aria-labelledby="map-heading">
        <div class="enk-map-head">
          <p class="enk-kicker" style="animation:none">The grounds</p>
          <h2 id="map-heading">The twelve acres, drawn.</h2>
          <p>{outdoors.map}</p>
        </div>
        <EnkEstateMap headingId="map-heading" />
      </section>

      <section class="enk-mournes" id="mournes" aria-labelledby="mournes-heading">
        <div class="enk-room-types-head">
          <p class="enk-kicker" style="animation:none">From the door</p>
          <h2 id="mournes-heading">The Mournes start at the garden gate.</h2>
        </div>
        <ul class="enk-mournes-grid" role="list">
          {activities.map((item) => (
            <li class="enk-mournes-card">
              <figure>
                <ResponsiveImage pictureClass="concept-responsive-picture" {...item.image} />
              </figure>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </li>
          ))}
        </ul>
        <p class="enk-mournes-nearby">
          <span class="enk-mournes-nearby-label">Nearby</span>
          {nearby.map((place, index) => (
            <Fragment>
              {index > 0 && <span aria-hidden="true">·</span>}
              <a href={place.href} rel="external">{place.label}</a>
            </Fragment>
          ))}
        </p>
      </section>

      <!-- The history as four headlines. The paragraphs behind each stay in
           content.ts; on the pitch the titles carry the story. -->
      <section class="enk-timeline-band" aria-labelledby="timeline-heading">
        <div class="enk-timeline-head">
          <p class="enk-kicker" style="animation:none">A hundred and thirty years</p>
          <h2 id="timeline-heading">How the house got here.</h2>
        </div>
        <ol class="enk-timeline" role="list">
          {estate.timeline.map((entry) => (
            <li>
              <span class="enk-timeline-marker">{entry.marker}</span>
              <h3>{entry.title}</h3>
            </li>
          ))}
        </ol>
      </section>
    </main>
</EnniskeenShell>
