---
import EnniskeenShell from "./components/EnniskeenShell.astro";
import EnkEstateMap from "./components/EnkEstateMap.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";
import { estate, base, generatedVisuals } from "./content";
---

<EnniskeenShell title={"The estate — Enniskeen Country House Hotel — independent concept"} current="estate">
    <main>
      <!-- Hero: the estate from the air -->
      <section class="enk-int-hero enk-int-hero--flip">
        <div class="enk-int-hero-copy">
          <p class="enk-kicker">The estate · Twelve acres</p>
          <h1>Twelve wooded acres above the <em>Shimna</em>.</h1>
          <p class="enk-lede">{estate.wildlife}</p>
          <div class="enk-actions">
            <a class="enk-cta" href={`${base}/things-to-do/`}>Walks from the door</a>
          </div>
        </div>
        <figure class="enk-int-hero-image">
          <ResponsiveImage
            pictureClass="concept-responsive-picture"
            {...generatedVisuals.estate}
            loading="eager"
          />
          <figcaption>The estate</figcaption>
        </figure>
      </section>

      <!-- The woodland trail -->
      <section class="enk-trail" aria-labelledby="trail-heading">
        <div class="enk-trail-copy">
          <p class="enk-kicker" style="animation:none">The woodland trail</p>
          <h2 id="trail-heading">Past the Wishing Well, down to the river.</h2>
          <p>{estate.intro}</p>
        </div>
        <figure class="enk-trail-visual">
          <ResponsiveImage
            pictureClass="concept-responsive-picture"
            {...generatedVisuals.woodland}
          />
          <figcaption>On the trail</figcaption>
        </figure>
      </section>

      <!-- The estate, drawn -->
      <section class="enk-map-section" aria-labelledby="map-heading">
        <div class="enk-map-head">
          <p class="enk-kicker" style="animation:none">The grounds</p>
          <h2 id="map-heading">The twelve acres, drawn.</h2>
          <p>
            The drive in off the Bryansford Road, the house and its turret, the
            lawns below the terrace, and the trail that leaves the gardens for
            the woods, passes the Wishing Well and comes out on the Shimna.
          </p>
        </div>
        <EnkEstateMap headingId="map-heading" />
      </section>

      <!-- Gardens band -->
      <section class="enk-gardens-band">
        <figure>
          <ResponsiveImage
            pictureClass="concept-responsive-picture"
            {...generatedVisuals.woodland}
            sizes="100vw"
          />
          <figcaption>On the woodland trail</figcaption>
        </figure>
      </section>

      <!-- History -->
      <section class="enk-history" aria-labelledby="history-heading">
        <figure class="enk-history-visual">
          <ResponsiveImage
            pictureClass="concept-responsive-picture"
            {...generatedVisuals.house}
          />
          <figcaption>The house in period</figcaption>
        </figure>
        <div class="enk-history-copy">
          <p class="enk-kicker" style="animation:none">Since the 1890s</p>
          <h2 id="history-heading">Built on tobacco, rope and linen.</h2>
          <p>{estate.history.built}</p>
          <p>{estate.history.titanic}</p>
        </div>
      </section>

      <!-- The same history as a dated band. The hotel already owns a better
           story than anything a competitor could buy; it was previously two
           paragraphs beside a photograph. -->
      <section class="enk-timeline-band" aria-labelledby="timeline-heading">
        <div class="enk-timeline-head">
          <p class="enk-kicker" style="animation:none">A hundred and thirty years</p>
          <h2 id="timeline-heading">How the house got here.</h2>
        </div>
        <ol class="enk-timeline" role="list">
          {estate.timeline.map((entry) => (
            <li>
              <span class="enk-timeline-marker">{entry.marker}</span>
              <h3>{entry.title}</h3>
              <p>{entry.copy}</p>
            </li>
          ))}
        </ol>
      </section>
    </main>
</EnniskeenShell>
