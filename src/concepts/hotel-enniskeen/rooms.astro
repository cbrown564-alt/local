---
import EnniskeenShell from "./components/EnniskeenShell.astro";
import EnkBooking from "./components/EnkBooking.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";
import { bookin1, enniskeen, generatedVisuals, rooms } from "./content";
---

<EnniskeenShell title={"Stay — Enniskeen Country House Hotel"} current="rooms">
    <main>
      <!-- Hero: the balcony rooms -->
      <section class="enk-rooms-hero">
        <figure class="enk-rooms-hero-image">
          <ResponsiveImage
            pictureClass="concept-responsive-picture"
            {...generatedVisuals.balcony}
            loading="eager"
          />
        </figure>
        <div class="enk-rooms-hero-copy">
          <p class="enk-kicker">Stay · Rooms &amp; suites</p>
          <h1>Wake to the valley and the mountains beyond.</h1>
          <p class="enk-lede">{rooms.intro}</p>
          <div class="enk-actions">
            <a class="enk-cta" href={bookin1.engine} rel="external">Check availability</a>
            <a class="enk-link" href={enniskeen.phoneHref}>Call {enniskeen.phone} →</a>
          </div>
        </div>
      </section>

      <!-- Rooms with character -->
      <section class="enk-character" aria-labelledby="character-heading">
        <div class="enk-room-types-head">
          <p class="enk-kicker" style="animation:none">Individually styled</p>
          <h2 id="character-heading">Rooms with character</h2>
          <p class="enk-rooms-sub">{rooms.character}</p>
        </div>
        <ul class="enk-character-grid" role="list">
          {rooms.featured.map((room) => (
            <li class={`enk-character-card${room.picture ? "" : " enk-character-card--text"}`}>
              {room.picture && (
                <figure class="enk-character-image">
                  <ResponsiveImage pictureClass="concept-responsive-picture" {...room.picture} />
                </figure>
              )}
              <div class="enk-character-body">
                <h3>{room.name}</h3>
                <p class="enk-room-view">{room.detail}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <!-- Included with every booking -->
      <section class="enk-amenities" aria-labelledby="amenities-heading">
        <p class="enk-kicker" style="animation:none" id="amenities-heading">Included with every booking</p>
        <ul class="enk-amenity-grid" role="list">
          <li class="enk-amenity">
            <span class="enk-amenity-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="26" height="26"><path d="M3 17h18M3 12h18M9 7l3-3 3 3"/><path d="M5 12V7a7 7 0 0 1 14 0v5"/></svg>
            </span>
            <strong>Breakfast</strong>
            <span>Included with every booking</span>
          </li>
          <li class="enk-amenity">
            <span class="enk-amenity-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="26" height="26"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>
            </span>
            <strong>Free Wi-Fi</strong>
            <span>Throughout the house</span>
          </li>
          <li class="enk-amenity">
            <span class="enk-amenity-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="26" height="26"><rect x="1" y="7" width="15" height="10" rx="1"/><path d="M16 10h3l3 3v4h-6"/><circle cx="6" cy="19" r="2"/><circle cx="18" cy="19" r="2"/></svg>
            </span>
            <strong>Free parking</strong>
            <span>At the house, with accessible spaces</span>
          </li>
          <li class="enk-amenity">
            <span class="enk-amenity-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="26" height="26"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22V12h6v10"/><path d="M12 6v2"/></svg>
            </span>
            <strong>Passenger lift</strong>
            <span>With accessible entrance and parking</span>
          </li>
        </ul>
      </section>

      <!-- Availability bar -->
      <section class="enk-page-booking-section" aria-labelledby="avail-heading">
        <div class="enk-page-booking-inner">
          <div class="enk-page-booking-copy">
            <h2 id="avail-heading">Ready to book?</h2>
            <p>Check what's free for your dates and book directly with the house.</p>
          </div>
          <EnkBooking />
        </div>
      </section>
    </main>
</EnniskeenShell>
