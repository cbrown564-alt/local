---
import { enniskeen, bookin1, base, nav, type NavId } from "../content";
import ConceptLayout from "../../_shell/ConceptLayout.astro";
import EnkMark from "./EnkMark.astro";
import "../../../site/styles/global.css";
import "../styles.css";

interface Props {
  title: string;
  current: NavId;
}

const { title, current } = Astro.props;
---

<ConceptLayout
  title={title}
  slug="hotel-enniskeen"
  bodyClass="concept-page concept-enniskeen"
  lang="en-GB"
  bannerNote="Imagery is AI-generated."
  favicon="/brand/enniskeen-mark.svg"
>
    <!-- One photographic voice.
         Every image in the concept is graded through this single filter —
         shadows carried toward the house pine, highlights warmed, saturation
         eased back, and a fine grain blended over the top — so a set built
         from separate generations reads as one commissioned shoot rather than
         as assembled stock. Browsers without SVG filter support simply show
         the ungraded images. -->
    <svg class="enk-grade-defs" aria-hidden="true" focusable="false" width="0" height="0">
      <filter id="enk-grade" color-interpolation-filters="sRGB">
        <feColorMatrix type="saturate" values="0.93" result="eased" />
        <feComponentTransfer in="eased" result="graded">
          <feFuncR type="table" tableValues="0.012 0.5 1" />
          <feFuncG type="table" tableValues="0.034 0.52 0.995" />
          <feFuncB type="table" tableValues="0.046 0.48 0.94" />
        </feComponentTransfer>
        <feTurbulence type="fractalNoise" baseFrequency="0.86" numOctaves="2" seed="7" result="noise" />
        <feColorMatrix in="noise" type="saturate" values="0" result="mono" />
        <feComponentTransfer in="mono" result="grain">
          <feFuncA type="linear" slope="0.085" intercept="-0.028" />
        </feComponentTransfer>
        <feBlend in="graded" in2="grain" mode="overlay" />
      </filter>
    </svg>
    <header class="enk-header">
      <div class="enk-brand">
        <a href={`${base}/`} class="enk-brand-link">
          <EnkMark class="enk-brand-mark" size={36} />
          <span class="enk-brand-text">
            <span class="enk-brand-name">{enniskeen.brand}</span>
            <span class="enk-brand-sub">{enniskeen.brandSub}</span>
          </span>
        </a>
      </div>
      <nav class="enk-nav" aria-label="Concept navigation">
        {nav.filter((item) => item.id !== "home").map((item) => (
          <a href={item.href} aria-current={current === item.id ? "page" : undefined}>{item.label}</a>
        ))}
      </nav>
      <div class="enk-header-actions">
        <a class="enk-phone" href={enniskeen.phoneHref}>{enniskeen.phone}</a>
        <a class="enk-book" href={bookin1.engine} rel="external">Book a room</a>
      </div>
    </header>
    <slot />
    <footer class="enk-footer">
      <div class="enk-footer-grid">
        <div class="enk-footer-col">
          <EnkMark class="enk-footer-mark" size={30} />
          <p class="enk-footer-brand">{enniskeen.name}</p>
          <p>{enniskeen.address}</p>
          <p>{enniskeen.directions}</p>
        </div>
        <div class="enk-footer-col">
          <p class="enk-footer-head">Reach the house</p>
          <p><a href={enniskeen.phoneHref}>{enniskeen.phone}</a></p>
          <p><a href={enniskeen.emailHref}>{enniskeen.email}</a></p>
          <p>
            <a href={enniskeen.facebook} rel="external">Facebook</a>
            {" · "}
            <a href={enniskeen.twitter} rel="external">Twitter</a>
          </p>
        </div>
        <div class="enk-footer-col">
          <p class="enk-footer-head">Good to know</p>
          <p>Free parking · free Wi-Fi · all rooms en suite · passenger lift</p>
          <p>Packed lunches and room service on request. Guide dogs welcome; no other pets.</p>
          <p><a href={bookin1.vouchers} rel="external">Gift vouchers — the hotel's own voucher shop →</a></p>
        </div>
      </div>
      <nav class="enk-footer-nav" aria-label="Footer navigation">
        {nav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    </footer>
</ConceptLayout>
