---
/** The house through the years.
 *
 *  A 17-second film of the same view of the house in six photographic
 *  treatments, from archival monochrome to present-day colour (see
 *  research/image-provenance.md, time-travel-v1). It plays once and stops
 *  on the present day.
 *
 *  The settled frame is the present-day still, and it is what a no-JS visit,
 *  a reduced-motion visit, a crawler or the capture pipeline sees. The film
 *  is decorative on top of it: the still carries the alt text. The page
 *  foot says the imagery is AI-generated; the caption does not repeat it,
 *  since the passage from monochrome to colour shows itself as a
 *  treatment of one picture rather than a set of archive photographs. */
import ResponsiveImage from "../../../site/components/ResponsiveImage.astro";
---

<figure class="enk-visual enk-film" data-enk-film>
  <ResponsiveImage
    pictureClass="concept-responsive-picture"
    src="/media/concepts/hotel-enniskeen/enniskeen-through-time-end.jpg"
    alt="Enniskeen Country House Hotel above its lawn: the turret, the chimneys and the ivy across the front"
    width={1536}
    height={1024}
    loading="eager"
  />
  <video
    class="enk-film-video"
    muted
    playsinline
    preload="none"
    poster="/media/concepts/hotel-enniskeen/enniskeen-through-time-start.jpg"
    aria-hidden="true"
    tabindex="-1"
    hidden
  >
    <source src="/media/concepts/hotel-enniskeen/enniskeen-through-time.webm" type="video/webm" />
    <source src="/media/concepts/hotel-enniskeen/enniskeen-through-time.mp4" type="video/mp4" />
  </video>
  <figcaption>Through the years</figcaption>
  <button class="enk-film-toggle" type="button" aria-label="Pause the film" hidden>
    <span aria-hidden="true"></span>
  </button>
</figure>

<script is:inline>
  (() => {
    const figure = document.querySelector("[data-enk-film]");
    const video = figure && figure.querySelector("video");
    const toggle = figure && figure.querySelector(".enk-film-toggle");
    if (!video || !toggle) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let heldByVisitor = false;
    const label = () => {
      const paused = video.paused;
      toggle.setAttribute("aria-label", paused ? "Play the film" : "Pause the film");
      toggle.dataset.state = paused ? "paused" : "playing";
    };
    // A browser may refuse or interrupt playback (a background tab, a data
    // saver). Nothing shows until frames are actually moving, so a refusal
    // simply leaves the still.
    const start = () => {
      if (heldByVisitor || video.ended || document.visibilityState !== "visible") return;
      const playing = video.play();
      if (playing && playing.catch) playing.catch(() => {});
    };

    video.hidden = false;
    video.preload = "auto";
    video.addEventListener("playing", () => {
      video.dataset.playing = "";
      toggle.hidden = false;
      label();
    });
    video.addEventListener("pause", label);
    // The last frame is the present-day still underneath; once the film has
    // said its piece the control goes, and the page is a still again.
    video.addEventListener("ended", () => {
      toggle.hidden = true;
    });
    toggle.addEventListener("click", () => {
      heldByVisitor = !video.paused;
      if (video.paused) video.play();
      else video.pause();
    });
    document.addEventListener("visibilitychange", start);
    start();
  })();
</script>
