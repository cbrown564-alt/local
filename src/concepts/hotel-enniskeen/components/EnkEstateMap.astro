---
import GeneratedMapPlate from "../../_shell/GeneratedMapPlate.astro";

interface Props { headingId?: string; }
const { headingId } = Astro.props;

const places = [
  { label: "Bryansford Road", note: "" },
  { label: "Enniskeen House", note: "Twelve wooded acres" },
  { label: "Lawn & gardens", note: "" },
  { label: "The Wishing Well", note: "" },
  { label: "The Shimna River", note: "" },
  { label: "Slieve Donard", note: "" },
  { label: "Newcastle & the Irish Sea", note: "" },
] as const;
---

<GeneratedMapPlate
  id="enk-map"
  src="/media/maps/enniskeen-estate-generated.png"
  width={1448}
  height={1086}
  title="Plan of the Enniskeen estate"
  desc="An indicative illustrated relationship between Enniskeen House, its gardens and woodland trail, the Wishing Well, the Shimna River, Slieve Donard and the Irish Sea."
  headingId={headingId}
>
  <span class="mm-generated-map-label" style="--map-x:44%;--map-y:28%">Enniskeen House</span>
  <Fragment slot="caption">
    Indicative plan drawn from the hotel's description of the grounds — the order a guest meets them, not a survey.
  </Fragment>
  <ul slot="key">
    {places.map((place) => <li><strong>{place.label}</strong>{place.note && <span>{place.note}</span>}</li>)}
  </ul>
</GeneratedMapPlate>
