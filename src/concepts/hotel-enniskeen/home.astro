---
import EnniskeenShell from "./components/EnniskeenShell.astro";
import EnkBooking from "./components/EnkBooking.astro";
import EnkHero from "./components/EnkHero.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";
import { base, bookin1, generatedVisuals, home, review } from "./content";

const explore = [
  {
    href: `${base}/rooms/`,
    title: "Stay",
    note: "Twelve individually styled rooms — art-deco baths, the turret, the balconies.",
    image: generatedVisuals.balcony,
  },
  {
    href: `${base}/dine/`,
    title: "Dine",
    note: "The Oak Restaurant, Mourne Honey afternoon tea, and the Brandy Pad Lounge.",
    image: generatedVisuals.afternoonTea,
  },
  {
    href: `${base}/estate/`,
    title: "The estate",
    note: "The Wishing Well, the woodland trail, and the walk down to the Shimna River.",
    image: generatedVisuals.estate,
  },
  {
    href: `${base}/things-to-do/`,
    title: "Things to do",
    note: "Slieve Donard from the door, Royal County Down next door, bikes to Spelga Dam.",
    image: generatedVisuals.walker,
  },
];
---

<EnniskeenShell title={"Enniskeen Country House Hotel"} current="home">
    <main>
    <section class="enk-hero">
      <section class="enk-story">
        <p class="enk-kicker">Newcastle · County Down</p>
        <h1>A mountainside <em>hideaway</em> above the Shimna Valley.</h1>
        <!-- Dates sit straight under the headline: on a phone this is the
             first thing a guest can do, and in source order it is the first
             control a keyboard reaches. On a wide screen the bar is still
             stitched across the story/image seam (see styles.css). -->
        <EnkBooking variant="hero" />
        <p class="enk-lede">{home.lede}</p>
        <div class="enk-actions">
          <a class="enk-cta" href={`${base}/rooms/`}>See rooms &amp; suites</a>
          <a class="enk-link" href={`${base}/dine/`}>Afternoon tea →</a>
        </div>
      </section>
      <EnkHero />
    </section>

    <section class="enk-explore" aria-labelledby="explore-heading">
      <p class="enk-kicker" style="animation:none">The house &amp; the valley</p>
      <h2 id="explore-heading">Find your way around</h2>
      <ul class="enk-explore-grid" role="list">
        {explore.map((item) => (
          <li class="enk-explore-card">
            <a href={item.href}>
              <span class="enk-explore-image">
                <ResponsiveImage pictureClass="concept-responsive-picture" {...item.image} />
              </span>
              <span class="enk-explore-body">
                <span class="enk-explore-title">{item.title}</span>
                <span class="enk-explore-note">{item.note}</span>
                <span class="enk-explore-more" aria-hidden="true">Explore →</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- A guest's own words, alone, at a size the studio's own copy never
         gets. The welcome paragraph, second house picture and directions
         line that used to sit around it repeated the hero and the footer.
         The name and month stay light on the page; the blockquote's cite
         carries the TripAdvisor source, so the owner can still go and find
         this real review. The "Breakfast meets the valley" film strip that
         used to follow was in another site's type and corners, and the
         quote is the stronger last word. -->
    <section class="enk-welcome" aria-label="A guest's words">
      <figure class="enk-pullquote">
        <blockquote cite={review.source}>“{review.text}”</blockquote>
        <figcaption>
          {review.attribution}
          <span>{review.context}</span>
        </figcaption>
      </figure>
      <p class="enk-gift"><a href={bookin1.vouchers} rel="external">Giving a stay this Christmas? <span>Gift vouchers →</span></a></p>
    </section>
    </main>
</EnniskeenShell>
