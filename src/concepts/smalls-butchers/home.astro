---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import CasePlate from "./CasePlate.astro";

/* Smalls Butchers+Deli — jar at the counter. No owned site. Speak as the shop.
   Hours on Google (Mon–Sat 8:30–4:30) are an unclaimed listing: omit on this
   guest page. EST 2007 is a third-party shelf photo, not first-party: omit.
   Not Joe's Quality Meats (6 Main Street). Not a clothing Smalls.
   Instagram already holds the case; this page holds the door, the sandwich,
   and the number. */

const phone = "028 4372 3512";
const phoneHref = "tel:+442843723512";
const instagram = "https://www.instagram.com/smallsbutchers_foods/";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Unna:ital,wght@0,400;0,700;1,400;1,700&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap";
---

<ConceptLayout
  title={"Smalls Butchers+Deli — independent concept"}
  slug="smalls-butchers"
  bodyClass="concept-page concept-smalls"
  lang="en-GB"
  businessName="Smalls Butchers+Deli"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The case plate is a drawing of the shopping-centre unit, not a photograph of the shop."
>
  <div class="sb-strip">
    <span>The Shopping Centre, Main Street, Newcastle · BT33 0ES</span>
    <span class="sb-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="sb-header">
    <a class="sb-brand" href="/concepts/smalls-butchers/">
      <span class="sb-brand-mark" aria-hidden="true">
        <svg width="42" height="42" viewBox="0 0 42 42" fill="none">
          <rect x="1.5" y="1.5" width="39" height="39" rx="2" stroke="currentColor" stroke-width="1.6"/>
          <rect x="5" y="5" width="32" height="11" fill="currentColor"/>
          <text x="21" y="13.2" text-anchor="middle" fill="#f4ead6" font-size="8.2" font-family="Unna, serif" font-style="italic">small's</text>
          <text x="21" y="26.5" text-anchor="middle" fill="currentColor" font-size="5.2" font-family="Source Sans 3, sans-serif" font-weight="700" letter-spacing="0.12">BUTCHERS</text>
          <text x="21" y="33.5" text-anchor="middle" fill="currentColor" font-size="5.2" font-family="Source Sans 3, sans-serif" font-weight="600" letter-spacing="0.18">+ DELI</text>
        </svg>
      </span>
      <span class="sb-brand-text">
        <span class="sb-brand-name">small's</span>
        <span class="sb-brand-sub">Butchers+Deli · The Shopping Centre</span>
      </span>
    </a>
    <nav class="sb-nav" aria-label="Concept navigation">
      <a href="#counter">The counter</a>
      <a href="#sandwich">The sandwich</a>
      <a href="#door">Find us</a>
    </nav>
    <a class="sb-walk" href="#door">Walk in</a>
  </header>

  <main class="sb-main">
    <div class="sb-hero" id="counter">
      <section class="sb-lede" aria-labelledby="sb-name">
        <p class="sb-eyebrow">Mourne butchers · inside the shopping centre</p>
        <h1 id="sb-name">small's</h1>
        <p class="sb-fascia">Butchers+Deli</p>
        <p class="sb-say">We're serving prime cuts at the best quality. Anything you need, we have.</p>
        <p class="sb-body">
          Come in for the case. Come back for the sandwich. The tray is on the
          counter in the shopping centre — and on Instagram when we post it.
        </p>
        <p class="sb-cta">
          <a class="sb-walk sb-walk--inline" href="#door">Walk in</a>
          <a class="sb-ring" href={phoneHref}>Ring {phone}</a>
        </p>
      </section>

      <figure class="sb-artefact">
        <CasePlate />
        <figcaption>The fascia, the case, the sandwich on the counter.</figcaption>
      </figure>
    </div>

    <section class="sb-sandwich" id="sandwich" aria-labelledby="sb-sandwich-title">
      <div class="sb-section-head">
        <p class="sb-eyebrow">The return ritual</p>
        <h2 id="sb-sandwich-title">The cut is the visit. The sandwich is why you come back.</h2>
      </div>
      <div class="sb-sandwich-grid">
        <p class="sb-sandwich-lead">
          Someone in front of you is collecting a joint. Someone behind you wants
          lunch. Prime cuts in the case; sausages on the tray; a sandwich wrapped
          at the counter. Mourne butchers, in the shopping centre.
        </p>
        <ol class="sb-ritual">
          <li>
            <p class="sb-ritual-when">The visit</p>
            <p class="sb-ritual-do">Point at the case. Ask for the cut. We have what you need, or we will tell you when it is in.</p>
          </li>
          <li>
            <p class="sb-ritual-when">The return</p>
            <p class="sb-ritual-do">The sandwich is the lunch that brings the same people back through the shopping centre.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="sb-tray" aria-labelledby="sb-tray-title">
      <div class="sb-section-head">
        <p class="sb-eyebrow">Today's tray</p>
        <h2 id="sb-tray-title">The case lives here. The picture of it lives on Instagram.</h2>
      </div>
      <p class="sb-tray-body">
        What is on the tray changes. When the drinks are in, we say so there.
      </p>
      <p class="sb-tray-cta">
        <a class="sb-ig" href={instagram} rel="external">@smallsbutchers_foods</a>
      </p>
    </section>

    <section class="sb-door" id="door" aria-labelledby="sb-door-title">
      <div class="sb-section-head">
        <p class="sb-eyebrow">The door</p>
        <h2 id="sb-door-title">Walk into the shopping centre. Ring if you want something put aside.</h2>
      </div>
      <ol class="sb-steps">
        <li>
          <p class="sb-step-n" aria-hidden="true">1</p>
          <p class="sb-step-do">Main Street, Newcastle — The Shopping Centre.</p>
        </li>
        <li>
          <p class="sb-step-n" aria-hidden="true">2</p>
          <p class="sb-step-do">The fascia reads <em>small's</em> · BUTCHERS+DELI.</p>
        </li>
        <li>
          <p class="sb-step-n" aria-hidden="true">3</p>
          <p class="sb-step-do">Point at the case, or ring <a href={phoneHref}>{phone}</a>.</p>
        </li>
      </ol>
      <address class="sb-address">
        <strong>small's</strong>
        <span>Butchers+Deli</span>
        <span>The Shopping Centre</span>
        <span>Main Street, Newcastle</span>
        <span>BT33 0ES</span>
        <a href={phoneHref}>{phone}</a>
        <a href={instagram} rel="external">Instagram · @smallsbutchers_foods</a>
      </address>
    </section>
  </main>
</ConceptLayout>
