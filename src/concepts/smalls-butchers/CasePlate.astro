---
/* Drawn plate of the shopping-centre unit: fascia + refrigerated case +
   sandwich on the counter. Not a photograph. Honesty lives in bannerNote. */
---

<svg
  class="sb-plate"
  viewBox="0 0 720 820"
  role="img"
  aria-label="small's fascia over a glass case in the shopping centre, with a sandwich on the counter"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="sb-arcade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#efe4cc"/>
      <stop offset="1" stop-color="#e2d3b4"/>
    </linearGradient>
    <linearGradient id="sb-glass" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f7fbfc" stop-opacity="0.55"/>
      <stop offset="0.45" stop-color="#d5e0e4" stop-opacity="0.18"/>
      <stop offset="1" stop-color="#c5d2d6" stop-opacity="0.35"/>
    </linearGradient>
    <linearGradient id="sb-case-body" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ece7dc"/>
      <stop offset="1" stop-color="#cfc6b6"/>
    </linearGradient>
    <linearGradient id="sb-light" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff7e0" stop-opacity="0.9"/>
      <stop offset="1" stop-color="#fff7e0" stop-opacity="0"/>
    </linearGradient>
    <pattern id="sb-terrazzo" width="18" height="18" patternUnits="userSpaceOnUse">
      <rect width="18" height="18" fill="#d8cbb3"/>
      <circle cx="3" cy="5" r="1.1" fill="#c4b49a"/>
      <circle cx="12" cy="14" r="0.9" fill="#b9a78a"/>
      <circle cx="15" cy="4" r="0.7" fill="#efe6d4"/>
    </pattern>
  </defs>

  <rect width="720" height="820" fill="url(#sb-arcade)"/>

  <!-- Arcade -->
  <rect x="0" y="0" width="720" height="86" fill="#d7c7a8"/>
  <rect x="0" y="78" width="720" height="8" fill="#c4b08a"/>
  <rect x="18" y="0" width="36" height="820" fill="#cbbba0"/>
  <rect x="666" y="0" width="36" height="820" fill="#cbbba0"/>
  <rect x="18" y="0" width="8" height="820" fill="#b9a88a"/>
  <rect x="694" y="0" width="8" height="820" fill="#b9a88a"/>

  <!-- Unit recess -->
  <rect x="78" y="108" width="564" height="620" fill="#f3ead8" stroke="#b9a78a" stroke-width="2"/>

  <!-- Fascia -->
  <rect x="78" y="108" width="564" height="92" fill="#6b1d1d"/>
  <rect x="78" y="198" width="564" height="6" fill="#c4a15a"/>
  <text
    x="360"
    y="152"
    text-anchor="middle"
    fill="#f4ead6"
    font-family="Unna, Palatino, serif"
    font-style="italic"
    font-size="44"
    font-weight="700"
  >small's</text>
  <text
    x="360"
    y="182"
    text-anchor="middle"
    fill="#c4a15a"
    font-family="Source Sans 3, Segoe UI, sans-serif"
    font-size="13"
    font-weight="700"
    letter-spacing="6"
  >BUTCHERS+DELI</text>

  <!-- Case lights -->
  <rect x="110" y="220" width="500" height="18" rx="2" fill="#ece6d6"/>
  <rect x="124" y="224" width="110" height="10" rx="2" fill="#fff6d8"/>
  <rect x="250" y="224" width="110" height="10" rx="2" fill="#fff6d8"/>
  <rect x="376" y="224" width="110" height="10" rx="2" fill="#fff6d8"/>
  <rect x="502" y="224" width="94" height="10" rx="2" fill="#fff6d8"/>
  <rect x="124" y="234" width="472" height="70" fill="url(#sb-light)"/>

  <!-- Refrigerated case -->
  <rect x="104" y="248" width="512" height="268" rx="6" fill="url(#sb-case-body)" stroke="#8f8270" stroke-width="2"/>
  <rect x="118" y="262" width="484" height="196" fill="#f7f1e6"/>

  <!-- Trays -->
  <g>
    <rect x="132" y="278" width="100" height="72" rx="3" fill="#e8d9c4" stroke="#c4b08a"/>
    <ellipse cx="182" cy="312" rx="32" ry="16" fill="#c9897a"/>
    <ellipse cx="168" cy="308" rx="18" ry="10" fill="#b56b5c"/>
    <rect x="246" y="278" width="100" height="72" rx="3" fill="#e8d9c4" stroke="#c4b08a"/>
    <rect x="262" y="292" width="68" height="18" rx="4" fill="#d4a574"/>
    <rect x="270" y="318" width="52" height="14" rx="4" fill="#c4895a"/>
    <rect x="360" y="278" width="100" height="72" rx="3" fill="#e8d9c4" stroke="#c4b08a"/>
    <ellipse cx="392" cy="314" rx="14" ry="22" fill="#8a3a32"/>
    <ellipse cx="418" cy="310" rx="16" ry="20" fill="#7a302a"/>
    <ellipse cx="444" cy="316" rx="12" ry="18" fill="#9a4840"/>
    <rect x="474" y="278" width="112" height="72" rx="3" fill="#e8d9c4" stroke="#c4b08a"/>
    <rect x="488" y="294" width="36" height="12" rx="6" fill="#c45c48"/>
    <rect x="530" y="294" width="36" height="12" rx="6" fill="#6b1d1d"/>
    <rect x="488" y="314" width="36" height="12" rx="6" fill="#d8c4a0"/>
    <rect x="530" y="314" width="36" height="12" rx="6" fill="#4a1212"/>
  </g>
  <g>
    <rect x="132" y="362" width="216" height="78" rx="3" fill="#efe4cc" stroke="#c4b08a"/>
    <path d="M160 392h160M160 408h120" stroke="#b9a78a" stroke-width="6" stroke-linecap="round"/>
    <rect x="364" y="362" width="222" height="78" rx="3" fill="#efe4cc" stroke="#c4b08a"/>
    <circle cx="410" cy="400" r="16" fill="#e8c9a0"/>
    <circle cx="448" cy="396" r="14" fill="#f0d8b0"/>
    <circle cx="484" cy="402" r="15" fill="#dcc09a"/>
    <circle cx="524" cy="398" r="13" fill="#e4c8a4"/>
  </g>

  <!-- Glass -->
  <rect x="118" y="262" width="484" height="196" fill="url(#sb-glass)"/>
  <path d="M130 270l70 188" stroke="#ffffff" stroke-opacity="0.35" stroke-width="10"/>
  <path d="M210 268l40 188" stroke="#ffffff" stroke-opacity="0.14" stroke-width="6"/>
  <rect x="118" y="454" width="484" height="8" fill="#8f8270"/>
  <rect x="104" y="500" width="512" height="16" fill="#b7ada0"/>

  <!-- Counter -->
  <rect x="78" y="548" width="564" height="180" fill="#5a4636"/>
  <rect x="78" y="548" width="564" height="22" fill="#3f3126"/>
  <rect x="78" y="568" width="564" height="10" fill="#c4a15a"/>
  <rect x="90" y="728" width="540" height="12" fill="url(#sb-terrazzo)"/>

  <!-- Wrapped sandwich -->
  <g transform="translate(248 596)">
    <ellipse cx="112" cy="86" rx="118" ry="18" fill="#3f3126" opacity="0.35"/>
    <path d="M18 54c8-28 46-46 94-46s86 18 94 46c2 10-6 22-22 28H40c-16-6-24-18-22-28Z" fill="#f4ead6" stroke="#c4b08a" stroke-width="2"/>
    <path d="M40 62h144" stroke="#6b1d1d" stroke-width="2.2" stroke-dasharray="6 5"/>
    <path d="M112 12v78" stroke="#6b1d1d" stroke-width="2"/>
    <path d="M36 48c22-8 50-12 76-12s54 4 76 12" fill="none" stroke="#c4a15a" stroke-width="3"/>
    <rect x="86" y="28" width="52" height="22" rx="2" fill="#6b1d1d"/>
    <text
      x="112"
      y="43.5"
      text-anchor="middle"
      fill="#f4ead6"
      font-family="Unna, Palatino, serif"
      font-style="italic"
      font-size="11"
    >small's</text>
  </g>

  <!-- Ticket on the case -->
  <g transform="translate(132 470)">
    <rect width="92" height="26" fill="#f4ead6" stroke="#6b1d1d"/>
    <text
      x="46"
      y="17"
      text-anchor="middle"
      fill="#6b1d1d"
      font-family="Source Sans 3, Segoe UI, sans-serif"
      font-size="9"
      font-weight="700"
      letter-spacing="1.4"
    >MOURNE</text>
  </g>
</svg>
