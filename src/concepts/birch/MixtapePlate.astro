---
/**
 * Keepable artefact: birch leaf on the mixtape plate.
 * Drawn, not a café photograph. Disclosure lives in ConceptLayout
 * bannerNote; the caption names the leaf and the tape.
 */
interface Props {
  headingId?: string;
}

const { headingId = "bi-mix-title" } = Astro.props;
---

<figure class="bi-plate" aria-labelledby={headingId}>
  <svg
    class="bi-plate-svg"
    viewBox="0 0 640 720"
    role="img"
    aria-label="A silver birch leaf on white china, a cassette labelled Birch Mixtape"
  >
    <defs>
      <radialGradient id="bi-linen" cx="50%" cy="38%" r="72%">
        <stop offset="0%" stop-color="#fbf8f1" />
        <stop offset="55%" stop-color="#efe6d4" />
        <stop offset="100%" stop-color="#d9cbb3" />
      </radialGradient>
      <radialGradient id="bi-china" cx="46%" cy="40%" r="62%">
        <stop offset="0%" stop-color="#fffdf8" />
        <stop offset="70%" stop-color="#f3eee4" />
        <stop offset="100%" stop-color="#e2d8c6" />
      </radialGradient>
      <linearGradient id="bi-leaf" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#dfe8d6" />
        <stop offset=".45" stop-color="#c5d4b0" />
        <stop offset="1" stop-color="#8aa074" />
      </linearGradient>
      <linearGradient id="bi-shell" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#3a3632" />
        <stop offset="1" stop-color="#1c1a18" />
      </linearGradient>
    </defs>

    <rect width="640" height="720" fill="url(#bi-linen)" />
    <ellipse cx="320" cy="668" rx="210" ry="22" fill="#5c4a32" opacity=".1" />

    <ellipse cx="320" cy="338" rx="236" ry="236" fill="#c9bba4" opacity=".35" />
    <ellipse cx="320" cy="338" rx="214" ry="214" fill="url(#bi-china)" stroke="#c9bba4" stroke-width="3" />
    <ellipse cx="320" cy="338" rx="176" ry="176" fill="none" stroke="#e7dcc8" stroke-width="2" />

    <!-- silver birch leaf -->
    <g transform="translate(262 168) rotate(-18)">
      <path
        d="M58 8
           C72 28 86 46 92 70
           C98 92 90 118 74 142
           C58 166 40 188 32 214
           C28 198 18 176 8 154
           C-4 128 -6 96 8 70
           C22 42 40 22 58 8Z"
        fill="url(#bi-leaf)"
        stroke="#2a4a30"
        stroke-width="1.6"
      />
      <path
        d="M58 8 C54 70 48 128 32 214"
        fill="none"
        stroke="#2a4a30"
        stroke-width="1.4"
        opacity=".7"
      />
      <g fill="none" stroke="#2a4a30" stroke-width="1" opacity=".45">
        <path d="M58 40 C72 52 80 62 86 78" />
        <path d="M54 72 C68 84 74 96 78 112" />
        <path d="M48 110 C60 122 64 136 68 150" />
        <path d="M58 40 C44 54 36 64 28 80" />
        <path d="M54 72 C40 86 32 98 26 114" />
        <path d="M48 110 C36 124 28 138 22 152" />
      </g>
      <g fill="none" stroke="#2a4a30" stroke-width="1.1">
        <path d="M22 52 l-7 -6 M86 58 l8 -5 M16 96 l-8 -2 M90 108 l9 1 M20 148 l-7 4 M80 156 l8 6" />
      </g>
    </g>

    <!-- mixtape cassette, overlapping the rim -->
    <g transform="translate(168 448) rotate(-7)">
      <rect x="0" y="0" width="292" height="184" rx="10" fill="url(#bi-shell)" />
      <rect x="10" y="10" width="272" height="96" rx="4" fill="#f4f1ea" />
      <text
        x="146"
        y="48"
        text-anchor="middle"
        fill="#2a4a30"
        font-family="Syne, sans-serif"
        font-size="22"
        font-weight="800"
        letter-spacing="4"
      >BIRCH</text>
      <text
        x="146"
        y="78"
        text-anchor="middle"
        fill="#5a8a8a"
        font-family="Source Serif 4, Georgia, serif"
        font-size="16"
        font-style="italic"
      >Mixtape</text>
      <rect x="18" y="118" width="256" height="50" rx="4" fill="#2c2a27" />
      <circle cx="86" cy="143" r="16" fill="#c9bba4" />
      <circle cx="86" cy="143" r="7" fill="#1c1a18" />
      <circle cx="206" cy="143" r="16" fill="#c9bba4" />
      <circle cx="206" cy="143" r="7" fill="#1c1a18" />
      <rect x="108" y="132" width="76" height="22" rx="2" fill="#1c1a18" stroke="#5a8a8a" stroke-width="1.2" />
      <rect x="0" y="0" width="292" height="184" rx="10" fill="none" stroke="#1c1a18" stroke-width="2" />
    </g>
  </svg>
  <figcaption>Birch leaf on the mixtape plate.</figcaption>
</figure>
