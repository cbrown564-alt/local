---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import MixtapePlate from "./MixtapePlate.astro";
import BirchCulture from "./BirchCulture.astro";

/* Speaks as Birch. No published phone — do not invent click-to-call.
   Do not hand off to parked birchcoffee.co.uk. Do not use Sea Salt's
   number, menu, or BYO. Castlewellan has no address here. Kitchen
   until 3 is Instagram (August 2026) — dated when printed. White Star
   lives only on the parked WordPress in the harvest; omitted. */
const instagram = "https://www.instagram.com/birch_coffee_/";
const linktree = "https://linktr.ee/Birch_Coffee";
const maps =
  "https://www.google.com/maps/search/?api=1&query=51+Central+Promenade+Newcastle+BT33+0HH";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400;1,8..60,600&family=Syne:wght@500;600;700;800&display=swap";

const hours = [
  { when: "Monday–Saturday", open: "8–4" },
  { when: "Sunday", open: "9–4" },
];
---

<ConceptLayout
  title={"Birch — independent concept"}
  slug="birch"
  bodyClass="concept-page concept-birch"
  lang="en-GB"
  businessName="Birch"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The coastal ceramic coffee hero plate is a concept visualisation. The mixtape plate is a drawn illustration."
>
  <div class="bi-strip">
    <span>51 Central Promenade, Newcastle · BT33 0HH</span>
    <span class="bi-strip-r">Vegetarian · vegan · dog friendly</span>
  </div>

  <header class="bi-header">
    <a class="bi-brand" href="/concepts/birch/">
      <span class="bi-brand-mark" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
          <circle cx="20" cy="20" r="18.2" stroke="currentColor" stroke-width="1.4" />
          <path
            d="M20 7.5c.4 4.2 2.6 7.4 6.8 10.2-3.2.6-5.4 2.4-6.8 5.6-1.4-3.2-3.6-5-6.8-5.6C17.4 14.9 19.6 11.7 20 7.5Z"
            fill="currentColor"
          />
          <path
            d="M20 7.5v21.4"
            stroke="#f4f1ea"
            stroke-width="1.15"
            stroke-linecap="round"
          />
        </svg>
      </span>
      <span class="bi-brand-text">
        <span class="bi-brand-name">Birch</span>
        <span class="bi-brand-sub">51 Central Promenade · Newcastle</span>
      </span>
    </a>
    <nav class="bi-nav" aria-label="Concept navigation">
      <a href="#door">The door</a>
      <a href="#culture">Culture &amp; Ritual</a>
      <a href="#mixtape">Mixtape</a>
      <a href="#find">Find us</a>
    </nav>
    <a class="bi-ig" href={instagram} rel="external">Instagram</a>
  </header>

  <main class="bi-main">
    <section class="bi-hero" id="door" aria-labelledby="bi-name">
      <div class="bi-lede">
        <p class="bi-eyebrow">Vegetarian specialty coffee · opposite the sea</p>
        <h1 id="bi-name">Birch</h1>
        <p class="bi-say">51 Central Promenade.</p>
        <p class="bi-body">
          Walk in facing the bay. Botanical specialty coffee, artisan cardamom bakes, vegan and vegetarian plates, and sea mist over the Mournes.
        </p>
        <p class="bi-cta">
          <a class="bi-walk" href="#find">Walk in</a>
          <a class="bi-ig-text" href={instagram} rel="external">Instagram @birch_coffee_</a>
        </p>
      </div>

      <figure class="bi-theatre">
        <img
          src="/media/concepts/birch/birch-hero.jpg"
          alt="Hand-thrown seafoam ceramic cup of oat flat white and cardamom bun overlooking the misty Mourne coastline"
          class="bi-theatre-img"
          loading="eager"
        />
        <figcaption class="bi-theatre-cap">
          Oat flat white &amp; cardamom bun · 51 Central Promenade
        </figcaption>
      </figure>
    </section>

    <section class="bi-culture-section" id="culture" aria-labelledby="bi-culture-title">
      <div class="bi-room-head">
        <p class="bi-kicker">Coastal Lifestyle</p>
        <h2 id="bi-culture-title">Coffee, Plant Kitchen &amp; Community.</h2>
        <p class="bi-copy">
          From Sunday morning promenade runs to curated playlists and mountain espresso popups.
        </p>
      </div>
      <BirchCulture headingId="bi-culture-title" />
    </section>

    <section class="bi-spread" id="mixtape" aria-labelledby="bi-mix-title">
      <div class="bi-spread-copy">
        <p class="bi-kicker">The tape</p>
        <h2 id="bi-mix-title">The mixtape.</h2>
        <p class="bi-deck">
          We put the week on tape. Year one. February. Playlists by
          Chris Rice.
        </p>
        <p class="bi-copy">
          Open them on Linktree — that is where the mixtape lives, next to
          the room.
        </p>
        <ul class="bi-tape-list">
          <li>
            <span class="bi-tape-name">Mixtape Year 1 Top 10</span>
            <span class="bi-tape-meta">Playlist · Chris Rice</span>
          </li>
          <li>
            <span class="bi-tape-name">Birch Mixtape February 24</span>
            <span class="bi-tape-meta">Playlist · Chris Rice</span>
          </li>
        </ul>
        <p class="bi-spread-cta">
          <a class="bi-walk bi-walk--ghost" href={linktree} rel="external">Open the mixtape</a>
        </p>
      </div>
      <MixtapePlate headingId="bi-mix-title" />
    </section>

    <section class="bi-room" id="room" aria-labelledby="bi-room-title">
      <div class="bi-room-head">
        <p class="bi-kicker">The room</p>
        <h2 id="bi-room-title">Vegetarian specialty coffee. Dogs in too.</h2>
        <p class="bi-copy">
          Sit-in and takeaway. House bakes with vegan and gluten-free on
          the counter. What is on today lives on Instagram.
        </p>
      </div>
      <dl class="bi-hours">
        {hours.map((row) => (
          <div>
            <dt>{row.when}</dt>
            <dd>{row.open}</dd>
          </div>
        ))}
        <div class="bi-hours-kitchen">
          <dt>Kitchen</dt>
          <dd>Until 3 · Instagram · August 2026</dd>
        </div>
      </dl>
    </section>

    <section class="bi-find" id="find" aria-labelledby="bi-find-title">
      <p class="bi-kicker">The door</p>
      <h2 id="bi-find-title">Walk in on Central Promenade.</h2>
      <ol class="bi-steps">
        <li>
          <p class="bi-step-n" aria-hidden="true">1</p>
          <p class="bi-step-do">51 Central Promenade, Newcastle, BT33 0HH.</p>
        </li>
        <li>
          <p class="bi-step-n" aria-hidden="true">2</p>
          <p class="bi-step-do">Walk in. Kitchen until three; the door until four.</p>
        </li>
        <li>
          <p class="bi-step-n" aria-hidden="true">3</p>
          <p class="bi-step-do">
            Today, the mixtape, the van:
            <a href={instagram} rel="external">@birch_coffee_</a>
            and
            <a href={linktree} rel="external">Linktree</a>.
          </p>
        </li>
      </ol>
      <address class="bi-address">
        <strong>Birch</strong>
        <span>51 Central Promenade</span>
        <span>Newcastle, Co. Down</span>
        <span>BT33 0HH</span>
        <a href={maps} rel="external">Directions on Google Maps</a>
        <a href={instagram} rel="external">Instagram · @birch_coffee_</a>
        <a href={linktree} rel="external">linktr.ee/Birch_Coffee</a>
        <span class="bi-hygiene">Food hygiene rating 5 · inspected 1 August 2024</span>
      </address>
    </section>
  </main>

  <footer class="bi-footer">
    <p class="bi-footer-name">Birch</p>
    <p>Opposite the sea · 51 Central Promenade, Newcastle</p>
  </footer>
</ConceptLayout>
