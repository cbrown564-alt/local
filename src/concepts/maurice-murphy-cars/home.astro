---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import MmcStockBrief from "./MmcStockBrief.astro";
import "./styles.css";

/* Maurice Murphy Car Sales — 26 Belfast Road, Newry, Co. Down BT34 1QA.
   Verified live 27 Nov 2026: mauricemurphycarsales.co.uk duplicates its full search bar and welcome heading
   twice on a dated UsedCarsNI template.
   Contacts: 07708 164585 / 028 3026 0584, mauricemurphycars@btinternet.com.
   Hours: Mon–Fri 09:00–17:00, Sat 09:00–15:00, Sun by appointment. */
const mobilePhone = "07708 164585";
const mobileHref = "tel:+447708164585";
const officePhone = "028 3026 0584";
const officeHref = "tel:+442830260584";
const email = "mauricemurphycars@btinternet.com";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Maurice+Murphy+Car+Sales+26+Belfast+Road+Newry+BT34+1QA";
---

<ConceptLayout
  title="Maurice Murphy Car Sales — Quality Used Cars, Belfast Road, Newry"
  slug="maurice-murphy-cars"
  bodyClass="concept-page concept-mauricemurphy"
  businessName="Maurice Murphy Car Sales"
  town="Newry"
  bannerNote="Imagery comprises indicative County Down dealership forecourt and prepared vehicle cabin visualisations."
>
  <header class="mmc-header">
    <div class="mmc-header-inner">
      <a class="mmc-brand" href="#top">
        <strong>Maurice Murphy Car Sales</strong>
        <span>26 Belfast Road · Newry</span>
      </a>
      <nav class="mmc-nav" aria-label="Primary">
        <a href="#buying">Part-Exchange &amp; Viewing</a>
        <a href="#standards">Prepared Stock</a>
        <a href="#hours">Opening Hours</a>
        <a href="#location">Find Forecourt</a>
      </nav>
      <div class="mmc-header-actions">
        <a class="mmc-header-tel" href={mobileHref}>{mobilePhone}</a>
        <a class="mmc-header-cta" href="#enquire">Book Viewing</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="mmc-hero" aria-labelledby="mmc-hero-title">
      <div class="mmc-wrap mmc-hero-grid">
        <div>
          <p class="mmc-kicker">26 Belfast Road · Newry · BT34 1QA</p>
          <h1 id="mmc-hero-title">Quality hand-picked used cars, straight answers on Belfast Road.</h1>
          <p class="mmc-lead">
            Independent Newry dealership offering carefully selected family SUVs, hatchbacks and
            executive saloons — fully prepared, honestly priced and backed by personal local service.
          </p>
          <div class="mmc-actions">
            <a class="mmc-btn mmc-btn--primary" href="#enquire">Book a Viewing or Valuation</a>
            <a class="mmc-btn mmc-btn--outline" href={mobileHref}>Call {mobilePhone}</a>
          </div>
          <div class="mmc-metrics">
            <div><strong>26 Belfast Rd</strong><span>Minutes off the A1 dual carriageway</span></div>
            <div><strong>Direct Deal</strong><span>Honest local part-exchange appraisals</span></div>
          </div>
        </div>
        <figure class="mmc-hero-plate">
          <picture>
            <source srcset="/media/concepts/maurice-murphy-cars/maurice-murphy-forecourt-640.webp 640w, /media/concepts/maurice-murphy-cars/maurice-murphy-forecourt-1265.webp 1265w" sizes="(max-width: 900px) 100vw, 52vw" type="image/webp" />
            <img src="/media/concepts/maurice-murphy-cars/maurice-murphy-forecourt.jpg" alt="Modern dark-metallic SUVs and silver executive saloons parked cleanly along a stone-walled County Down forecourt at golden hour" width="1408" height="768" loading="eager" />
          </picture>
          <figcaption>Belfast Road forecourt line-up. Indicative dealership visualisation.</figcaption>
        </figure>
      </div>
    </section>

    <MmcStockBrief />

    <section class="mmc-section mmc-standards" id="standards" aria-labelledby="mmc-std-title">
      <div class="mmc-wrap mmc-split">
        <figure class="mmc-plate">
          <picture>
            <source srcset="/media/concepts/maurice-murphy-cars/maurice-murphy-interior-640.webp 640w, /media/concepts/maurice-murphy-cars/maurice-murphy-interior-1265.webp 1265w" sizes="(max-width: 860px) 100vw, 48vw" type="image/webp" />
            <img src="/media/concepts/maurice-murphy-cars/maurice-murphy-interior.jpg" alt="Spotless right-hand-drive dark leather car interior with stitched steering wheel and brushed metal console trim" width="1408" height="768" loading="lazy" />
          </picture>
          <figcaption>Prepared cabin finish &amp; inspection standard. Indicative vehicle visualisation.</figcaption>
        </figure>
        <div>
          <p class="mmc-kicker">Prepared Before You Arrive</p>
          <h2 id="mmc-std-title">Clean history, thorough valeting and no wasted journeys.</h2>
          <p>
            Whether you are travelling up the A1 from Dundalk or coming in from Banbridge,
            Rostrevor or Kilkeel, we verify every car's provenance and condition before it reaches
            our Belfast Road forecourt.
          </p>
          <div class="mmc-hours-card" id="hours">
            <h3>Forecourt Opening Hours</h3>
            <dl class="mmc-hours-list">
              <div><dt>Monday – Friday</dt><dd>09:00 – 17:00</dd></div>
              <div><dt>Saturday</dt><dd>09:00 – 15:00</dd></div>
              <div><dt>Sunday</dt><dd>By Appointment</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="mmc-section mmc-enquire" id="enquire" aria-labelledby="mmc-enq-title">
      <div class="mmc-wrap mmc-split">
        <div>
          <p class="mmc-kicker">Direct Forecourt Enquiry</p>
          <h2 id="mmc-enq-title">Ask about current stock or book a viewing.</h2>
          <p>
            Send us the car you have in mind or your trade-in details. You can also ring Maurice
            directly on <a href={mobileHref}>{mobilePhone}</a> or the office on <a href={officeHref}>{officePhone}</a>.
          </p>
          <p class="mmc-email-line">Email: <a href={`mailto:${email}`}>{email}</a></p>
        </div>
        <form class="mmc-form" data-mmc-form>
          <div class="mmc-row">
            <label>
              <span>Your name</span>
              <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
            </label>
            <label>
              <span>Telephone</span>
              <input name="phone" type="tel" required autocomplete="tel" placeholder="07 / 028..." />
            </label>
          </div>
          <div class="mmc-row">
            <label>
              <span>Enquiry type</span>
              <select name="type">
                <option value="Book a Viewing / Test Drive">Book a Viewing / Test Drive</option>
                <option value="Part-Exchange Valuation">Part-Exchange Valuation</option>
                <option value="Vehicle Sourcing">Vehicle Sourcing / Budget Search</option>
              </select>
            </label>
            <label>
              <span>Preferred day</span>
              <input name="day" type="text" placeholder="e.g. Saturday morning" />
            </label>
          </div>
          <label>
            <span>Car of interest or trade-in details</span>
            <textarea name="notes" rows="3" placeholder="Vehicle make/model, or registration & mileage if trading in..."></textarea>
          </label>
          <button class="mmc-btn mmc-btn--primary" type="submit">Send Forecourt Enquiry</button>
        </form>
      </div>
    </section>

    <section class="mmc-section" id="location" aria-label="Newry Belfast Road map">
      <div class="mmc-wrap">
        <LocalAreaMap
          id="mmc-map"
          kicker="26 Belfast Road · Newry"
          businessName="Maurice Murphy Car Sales"
          address="26 Belfast Road, Newry, Co. Down, BT34 1QA"
          lon={-6.3355}
          lat={54.1892}
          spanKm={16}
          mapHref={mapsHref}
          markers={[
            { name: "Newry City Centre", lon: -6.3402, lat: 54.1751, note: "4 mins south", side: "b" },
            { name: "Warrenpoint", lon: -6.2504, lat: 54.1003, note: "14 mins south-east", side: "r" },
            { name: "Banbridge (A1)", lon: -6.2704, lat: 54.3489, note: "18 mins north", side: "t" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="mmc-footer">
    <div class="mmc-wrap mmc-footer-inner">
      <div>
        <strong>Maurice Murphy Car Sales</strong>
        <p>26 Belfast Road, Newry, Co. Down, BT34 1QA</p>
      </div>
      <div class="mmc-footer-links">
        <a href={mobileHref}>{mobilePhone}</a>
        <a href={officeHref}>{officePhone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={mapsHref} target="_blank" rel="noopener noreferrer">Directions ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const form = document.querySelector("[data-mmc-form]");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        const subject = `Car Sales Enquiry — ${fd.get("type")} (${fd.get("name")})`;
        const body = [
          `Name: ${fd.get("name")}`,
          `Phone: ${fd.get("phone")}`,
          `Enquiry: ${fd.get("type")}`,
          `Preferred Day: ${fd.get("day") || "Flexible"}`,
          `Details: ${fd.get("notes") || "None"}`,
        ].join("\n");
        const ev = new CustomEvent("mm:enquiry", {
          cancelable: true,
          detail: { to: "mauricemurphycars@btinternet.com", subject, body },
        });
        if (window.dispatchEvent(ev)) {
          window.location.href = `mailto:mauricemurphycars@btinternet.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }
      });
    })();
  </script>
</ConceptLayout>
