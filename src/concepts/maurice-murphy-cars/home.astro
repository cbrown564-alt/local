---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import MmcStockBrief from "./MmcStockBrief.astro";
import "./styles.css";

/* Maurice Murphy Car Sales — 26 Belfast Road, Newry, Co. Down BT34 1QA.
   Verified live 27 Nov 2026: independent used car dealership on Belfast Road, Newry.
   Contacts: 07708 164585 / 028 3026 0584, mauricemurphycars@btinternet.com.
   Hours: Mon-Fri 09:00-17:00, Sat 09:00-15:00, Sun by appointment. */
const mobilePhone = "07708 164585";
const mobileHref = "tel:+447708164585";
const officePhone = "028 3026 0584";
const officeHref = "tel:+442830260584";
const email = "mauricemurphycars@btinternet.com";
const mapsHref =
  "https://www.google.com/maps/search/?api=1&query=Maurice+Murphy+Car+Sales+26+Belfast+Road+Newry+BT34+1QA";
---

<ConceptLayout
  title="Maurice Murphy Car Sales: Quality Used Cars, Belfast Road, Newry"
  slug="maurice-murphy-cars"
  bodyClass="concept-page concept-mauricemurphy"
  businessName="Maurice Murphy Car Sales"
  town="Newry"
  bannerNote="Imagery comprises indicative County Down dealership forecourt and prepared vehicle cabin visualisations."
>
  <header class="mmc-header" data-mmc-header>
    <div class="mmc-header-inner">
      <a class="mmc-brand" href="#top">Maurice Murphy</a>

      <nav class="mmc-nav" aria-label="Primary">
        <a class="mmc-nav-link" href="#services" data-mmc-jump="services">Services</a>
        <a class="mmc-nav-link" href="#services" data-mmc-jump="standards">Standards</a>
        <a class="mmc-nav-link" href="#hours">Hours</a>
        <a class="mmc-nav-link" href="#location">Belfast Road</a>
      </nav>

      <div class="mmc-header-actions">
        <a class="mmc-header-tel" href={mobileHref}>{mobilePhone}</a>
        <a class="mmc-header-cta" href="#enquire">Book viewing</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="mmc-hero" aria-labelledby="mmc-hero-title">
      <div class="mmc-scroll-sentinel" aria-hidden="true" data-mmc-sentinel></div>

      <div class="mmc-wrap">
        <div class="mmc-hero-lockup">
          <h1 id="mmc-hero-title" class="mmc-reveal mmc-reveal-1">
            Hand-picked cars on Belfast Road.
          </h1>
          <div class="mmc-hero-bar mmc-reveal mmc-reveal-2">
            <p>
              Independent Newry dealership offering inspected family SUVs, hatchbacks and saloons
              with honest local part-exchange.
            </p>
            <a class="mmc-btn" href="#enquire">Book a viewing</a>
          </div>
        </div>

        <div class="mmc-hero-media mmc-reveal mmc-reveal-3">
          <picture>
            <source
              srcset="/media/concepts/maurice-murphy-cars/maurice-murphy-forecourt-640.webp 640w, /media/concepts/maurice-murphy-cars/maurice-murphy-forecourt-1265.webp 1265w"
              sizes="(max-width: 1280px) 92vw, 1240px"
              type="image/webp"
            />
            <img
              src="/media/concepts/maurice-murphy-cars/maurice-murphy-forecourt.jpg"
              alt="Modern dark-metallic SUVs and silver executive saloons parked cleanly along a stone-walled County Down forecourt at golden hour"
              width="1408"
              height="768"
              loading="eager"
            />
          </picture>
        </div>

        <div class="mmc-hero-foot">
          <p class="mmc-hero-caption">Indicative Belfast Road forecourt visualisation.</p>
        </div>
      </div>
    </section>

    <MmcStockBrief />

    <section class="mmc-section mmc-enquire" id="enquire" aria-labelledby="mmc-enq-title">
      <div class="mmc-wrap mmc-split">
        <div class="mmc-col">
          <h2 id="mmc-enq-title">Ask about current stock or book a viewing.</h2>
          <p class="mmc-body">
            Send us the car you have in mind or your trade-in details. You can also ring Maurice
            directly on <a href={mobileHref}>{mobilePhone}</a> or the office on{" "}
            <a href={officeHref}>{officePhone}</a>.
          </p>

          <h3 class="mmc-subhead" id="hours">Forecourt hours and direct desk</h3>
          <dl class="mmc-ledger">
            <div>
              <dt>Monday to Friday</dt>
              <dd>09:00 to 17:00</dd>
            </div>
            <div>
              <dt>Saturday</dt>
              <dd>09:00 to 15:00</dd>
            </div>
            <div>
              <dt>Sunday</dt>
              <dd>By appointment</dd>
            </div>
            <div>
              <dt>Direct mobile</dt>
              <dd><a href={mobileHref}>{mobilePhone}</a></dd>
            </div>
            <div>
              <dt>Office telephone</dt>
              <dd><a href={officeHref}>{officePhone}</a></dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd><a href={`mailto:${email}`}>{email}</a></dd>
            </div>
          </dl>
        </div>

        <div class="mmc-col">
          <form class="mmc-form" data-mmc-form>
            <div class="mmc-row">
              <label>
                <span>Your name</span>
                <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
              </label>
              <label>
                <span>Telephone</span>
                <input name="phone" type="tel" required autocomplete="tel" placeholder="07 or 028..." />
              </label>
            </div>
            <div class="mmc-row">
              <label>
                <span>Enquiry type</span>
                <select name="type" data-mmc-type-select>
                  <option value="Book a Viewing / Test Drive">Book a viewing or test drive</option>
                  <option value="Part-Exchange Valuation">Part-exchange valuation</option>
                  <option value="Vehicle Sourcing">Vehicle sourcing and budget search</option>
                </select>
              </label>
              <label>
                <span>Preferred day</span>
                <input name="day" type="text" placeholder="e.g. Saturday morning" />
              </label>
            </div>
            <label>
              <span>Car of interest or trade-in details</span>
              <textarea
                name="notes"
                rows="3"
                placeholder="Vehicle make and model, or registration and mileage if trading in..."
              ></textarea>
            </label>
            <button class="mmc-btn" type="submit">Send forecourt enquiry</button>
          </form>
        </div>
      </div>
    </section>

    <section class="mmc-section mmc-map-band" id="location" aria-label="Newry Belfast Road map">
      <div class="mmc-wrap">
        <LocalAreaMap
          id="mmc-map"
          kicker=""
          businessName="Maurice Murphy Cars"
          address="26 Belfast Road, Newry, Co. Down, BT34 1QA"
          lon={-6.3355}
          lat={54.1892}
          spanKm={16}
          mapHref={mapsHref}
          markers={[
            { name: "Newry City Centre", lon: -6.3402, lat: 54.1751, note: "4 mins south", side: "b" },
            { name: "Warrenpoint", lon: -6.2504, lat: 54.1003, note: "14 mins south-east", side: "r" },
            { name: "Banbridge (A1)", lon: -6.2704, lat: 54.3489, note: "18 mins north", side: "t" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="mmc-footer">
    <div class="mmc-wrap mmc-footer-inner">
      <div>
        <strong>Maurice Murphy Car Sales</strong>
        <p>26 Belfast Road, Newry, Co. Down, BT34 1QA</p>
      </div>
      <div class="mmc-footer-links">
        <a href={mobileHref}>{mobilePhone}</a>
        <a href={officeHref}>{officePhone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={mapsHref} target="_blank" rel="noopener noreferrer">Directions</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-mmc-header]");
      const sentinel = document.querySelector("[data-mmc-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            header.classList.toggle("is-scrolled", !entries[0].isIntersecting);
          },
          { rootMargin: "-74px 0px 0px 0px", threshold: 0 },
        );
        io.observe(sentinel);
      }

      document.querySelectorAll("[data-mmc-jump]").forEach((link) => {
        link.addEventListener("click", () => {
          const id = link.getAttribute("data-mmc-jump");
          if (id) window.dispatchEvent(new CustomEvent("mmc:select-tab", { detail: { id } }));
        });
      });

      const form = document.querySelector("[data-mmc-form]");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        const subject = `Car Sales Enquiry: ${fd.get("type")} (${fd.get("name")})`;
        const body = [
          `Name: ${fd.get("name")}`,
          `Phone: ${fd.get("phone")}`,
          `Enquiry: ${fd.get("type")}`,
          `Preferred Day: ${fd.get("day") || "Flexible"}`,
          `Details: ${fd.get("notes") || "None"}`,
        ].join("\n");
        const ev = new CustomEvent("mm:enquiry", {
          cancelable: true,
          detail: { to: "mauricemurphycars@btinternet.com", subject, body },
        });
        if (window.dispatchEvent(ev)) {
          window.location.href = `mailto:mauricemurphycars@btinternet.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }
      });
    })();
  </script>
</ConceptLayout>
