---
/* Maurice Murphy Car Sales — Deep Showroom-Navy Stage with Services, Standards & Part-Exchange Tabs. */
const options = [
  {
    id: "services",
    label: "Services",
    enquiryOption: "Book a Viewing / Test Drive",
    title: "Inspect prepared forecourt stock on Belfast Road with zero showroom pressure.",
    points: [
      {
        label: "Unhurried viewings",
        detail: "Every vehicle is inspected, valeted and ready for a road test at 26 Belfast Road.",
      },
      {
        label: "Sourcing and finance",
        detail: "Hand-picked family SUVs, hatchbacks and saloons with tailored monthly payment guidance on qualifying stock.",
      },
      {
        label: "Direct dealing",
        detail: "Speak directly with Maurice Murphy from first enquiry through handover.",
      },
    ],
    note: "Call 07708 164585 ahead of travel so the car you want to view is fuelled and waiting.",
  },
  {
    id: "standards",
    label: "Standards",
    enquiryOption: "Vehicle Sourcing",
    title: "Clean history, thorough valeting and no wasted journeys.",
    points: [
      {
        label: "Verified provenance",
        detail: "Transparent vehicle history and service checks carried out before any car reaches Belfast Road.",
      },
      {
        label: "Cabin preparation",
        detail: "Detailed interior and exterior preparation so every vehicle matches its description on arrival.",
      },
      {
        label: "A1 convenience",
        detail: "Straightforward access for buyers travelling from Dundalk, Banbridge, Rostrevor or Kilkeel.",
      },
    ],
    note: "Fresh stock arrives regularly; let us know your preferred make, gearbox and budget.",
  },
  {
    id: "partex",
    label: "Part-exchange",
    enquiryOption: "Part-Exchange Valuation",
    title: "Straight-talking local trade-in appraisals on your current car or van.",
    points: [
      {
        label: "Real appraisal",
        detail: "Honest local trade-in figures without automated online guesswork.",
      },
      {
        label: "Simple preparation",
        detail: "Bring your registration, current mileage and service book when you visit.",
      },
      {
        label: "Same-day swap",
        detail: "Straightforward handover on the day you collect your next vehicle.",
      },
    ],
    note: "Include your registration and approximate mileage in the enquiry form below for a guide figure.",
  },
];
---

<section class="mmc-stage" id="services" aria-labelledby="mmc-stage-title">
  <div class="mmc-wrap" data-mmc-brief>
    <div class="mmc-stage-head">
      <h2 id="mmc-stage-title">How we help with your next car.</h2>
      <div class="mmc-tabs" role="tablist" aria-label="Explore forecourt services, standards and part-exchange">
        {options.map((opt, idx) => (
          <button
            type="button"
            role="tab"
            id={`mmc-tab-${opt.id}`}
            aria-controls={`mmc-panel-${opt.id}`}
            aria-selected={idx === 0 ? "true" : "false"}
            class:list={["mmc-tab", idx === 0 && "is-active"]}
            data-mmc-tab={opt.id}
          >
            {opt.label}
          </button>
        ))}
      </div>
    </div>

    <div class="mmc-stage-grid">
      <div class="mmc-stage-copy">
        {options.map((opt, idx) => (
          <div
            class="mmc-panel"
            role="tabpanel"
            id={`mmc-panel-${opt.id}`}
            aria-labelledby={`mmc-tab-${opt.id}`}
            data-mmc-panel={opt.id}
            hidden={idx !== 0}
          >
            <h3>{opt.title}</h3>
            <dl class="mmc-stage-ledger">
              {opt.points.map((pt) => (
                <div>
                  <dt>{pt.label}</dt>
                  <dd>{pt.detail}</dd>
                </div>
              ))}
            </dl>
            <p class="mmc-stage-note">{opt.note}</p>
            <a class="mmc-stage-cta" href="#enquire" data-mmc-prefill={opt.enquiryOption}>
              Enquire about {opt.label.toLowerCase()}
            </a>
          </div>
        ))}
      </div>

      <figure class="mmc-plate">
        <picture>
          <source
            srcset="/media/concepts/maurice-murphy-cars/maurice-murphy-interior-640.webp 640w, /media/concepts/maurice-murphy-cars/maurice-murphy-interior-1265.webp 1265w"
            sizes="(max-width: 900px) 100vw, 46vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/maurice-murphy-cars/maurice-murphy-interior.jpg"
            alt="Spotless right-hand-drive dark leather car interior with stitched steering wheel and brushed metal console trim"
            width="1408"
            height="768"
            loading="lazy"
          />
        </picture>
        <figcaption>Indicative prepared vehicle cabin visualisation.</figcaption>
      </figure>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-mmc-brief]");
    if (!root) return;
    const tabs = [...root.querySelectorAll("[data-mmc-tab]")];
    const panels = [...root.querySelectorAll("[data-mmc-panel]")];

    const selectTab = (id) => {
      const target = tabs.find((t) => t.getAttribute("data-mmc-tab") === id);
      if (!target) return;
      tabs.forEach((t) => {
        const active = t === target;
        t.classList.toggle("is-active", active);
        t.setAttribute("aria-selected", active ? "true" : "false");
      });
      panels.forEach((p) => {
        p.hidden = p.getAttribute("data-mmc-panel") !== id;
      });
    };

    tabs.forEach((btn) => {
      btn.addEventListener("click", () => {
        selectTab(btn.getAttribute("data-mmc-tab"));
      });
    });

    window.addEventListener("mmc:select-tab", (e) => {
      if (e && e.detail && e.detail.id) {
        selectTab(e.detail.id);
      }
    });

    root.querySelectorAll("[data-mmc-prefill]").forEach((link) => {
      link.addEventListener("click", () => {
        const value = link.getAttribute("data-mmc-prefill");
        const select = document.querySelector("[data-mmc-type-select]");
        if (select && value) {
          select.value = value;
          select.dispatchEvent(new Event("change", { bubbles: true }));
        }
      });
    });
  })();
</script>
