---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import SessionCard from "./SessionCard.astro";

const phone = "028 4375 0848";
const phoneHref = "tel:+442843750848";
const handoff = "https://www.dundrumphysio.co.uk/";
const maps = "https://www.google.com/maps/search/?api=1&query=12+Parterre+Crescent+Dundrum+BT33+0WJ";
const fontHref = "https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,600;0,9..40,700;1,9..40,400&family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500;1,9..144,600&display=swap";
const stock = [
  { kicker: "Sports injuries", title: "Back to the pitch.", body: "Sports injuries and rehab with a chartered physiotherapist — hour initial assessment, no referral needed." },
  { kicker: "Back & sciatica", title: "The plan starts here.", body: "Back pain, sciatica, and everyday aches treated with manual therapy, ultrasound and acupuncture where it helps." },
  { kicker: "Marguerite Quinn", title: "Twenty years in.", body: "Ex Downe Hospital senior outpatient; first in Downe for Injection Therapy; first in South Down for Sarah Key technique." },
];
---
<ConceptLayout title={"Dundrum Physio — independent concept"} slug="dundrum-physio" bodyClass="concept-page concept-dundrum-physio" lang="en-GB" businessName="Dundrum Physio" town="Dundrum" fontHref={fontHref} bannerNote="AI-generated illustrations imagine the clinic and setting; they are not photographs of the business.">
  <div class="dp-strip"><span>12 Parterre Crescent, Dundrum · BT33 0WJ</span><span class="dp-strip-r"><a href={phoneHref}>{phone}</a></span></div>
  <header class="dp-header"><div class="dp-header-inner">
    <a class="dp-brand" href="/concepts/dundrum-physio/"><span class="dp-brand-name">Dundrum Physio</span><span class="dp-brand-sub">12 Parterre Crescent · Dundrum</span></a>
    <nav class="dp-nav" aria-label="Concept navigation"><a href="#stock">Care</a><a href="#session">Session</a><a href="#door">Find 12</a></nav>
    <a class="dp-walk" href={phoneHref}>Ring to book</a>
  </div></header>
  <main class="dp-main">
    <section class="dp-hero" aria-labelledby="dp-name">
      <div class="dp-mast-copy">
        <p class="dp-kicker">Physiotherapy &amp; sports injury · Dundrum</p>
        <h1 id="dp-name">Dundrum Physio</h1>
        <p class="dp-number">12 Parterre Crescent · Dundrum</p>
        <p class="dp-say">Relief at 12.</p>
        <p class="dp-lede">Chartered physiotherapy with Marguerite Quinn. Sports injuries, back pain, sciatica and rehab. Ring to book an hour that starts the plan.</p>
        <div class="dp-hero-actions">
          <a class="dp-btn-primary" href={phoneHref}>Ring to book: {phone}</a>
          <a class="dp-btn-secondary" href="#door">Find 12 Parterre</a>
        </div>
      </div>
      <figure class="dp-theatre">
        <img src="/media/concepts/dundrum-physio/dundrum-physio-hero-parterre.jpg" alt="Calm clinic exterior on Parterre Crescent Dundrum" width="1200" height="675" loading="eager" />
        <figcaption>12 Parterre Crescent · Chartered physiotherapy</figcaption>
      </figure>
    </section>
    <section class="dp-folio" id="stock" aria-labelledby="dp-stock-title">
      <div class="dp-folio-head"><p class="dp-kicker">Care</p><h2 id="dp-stock-title">What we treat.</h2>
        <p class="dp-folio-lede">Calm clinic linen — not a spa dusk overlay. Manual therapy, ultrasound, acupuncture; cash or cheque.</p></div>
      <div class="dp-mag-grid">{stock.map((item) => (<article class="dp-mag-cell"><p class="dp-mag-kicker">{item.kicker}</p><h3>{item.title}</h3><p>{item.body}</p></article>))}</div>
    </section>
    <section class="dp-ritual" id="session" aria-labelledby="dp-ticket-title">
      <div>
        <p class="dp-kicker">The session</p>
        <h2 id="dp-ticket-title">Ring for the hour.</h2>
        <p class="dp-ritual-lede">Initial assessment is an hour. No referral needed. We write the plan with you.</p>
        <ol class="dp-beats">
          <li><span class="dp-beat-n">01</span><span class="dp-beat-t">Ring 028 4375 0848</span></li>
          <li><span class="dp-beat-n">02</span><span class="dp-beat-t">Hour assessment</span></li>
          <li><span class="dp-beat-n">03</span><span class="dp-beat-t">Rehab plan</span></li>
        </ol>
        <div class="dp-cta"><a class="dp-walk dp-walk--inline" href={phoneHref}>Ring to book</a></div>
      </div>
      <SessionCard headingId="dp-ticket-title" />
    </section>
    <section class="dp-section" id="room" aria-labelledby="dp-room-title">
      <div class="dp-section-copy">
        <p class="dp-kicker">The room</p><h2 id="dp-room-title">Linen, soft light, clear plan.</h2>
        <p class="dp-lead">Treatment that feels like a clinic — sage, slate, and the work of getting you moving again.</p>
        <div class="dp-inline-action"><a class="dp-btn-primary" href={handoff} rel="noopener noreferrer">dundrumphysio.co.uk →</a></div>
      </div>
      <figure class="dp-photo-card"><img src="/media/concepts/dundrum-physio/dundrum-physio-treatment-room.jpg" alt="Calm treatment couch with linen and soft sage accents" width="1200" height="800" loading="lazy" /><figcaption>Treatment room · Soft linen and sage</figcaption></figure>
    </section>
    <section class="dp-section dp-section--alt" id="note" aria-labelledby="dp-note-title">
      <figure class="dp-photo-card"><img src="/media/concepts/dundrum-physio/dundrum-physio-session-note.jpg" alt="Clinic clipboard and resistance band on a linen desk" width="1200" height="800" loading="lazy" /><figcaption>Session note · The plan on paper</figcaption></figure>
      <div class="dp-section-copy">
        <p class="dp-kicker">Book</p><h2 id="dp-note-title">Ring Marguerite’s clinic.</h2>
        <p class="dp-lead">Flexible appointment times — ring 028 4375 0848 or visit dundrumphysio.co.uk.</p>
        <div class="dp-inline-action"><a class="dp-btn-secondary" href={phoneHref}>Ring: {phone}</a></div>
      </div>
    </section>
    <section class="dp-door-section" id="door" aria-labelledby="dp-door-title">
      <div class="dp-door-card">
        <p class="dp-kicker">The door</p><h2 id="dp-door-title">12 Parterre Crescent.</h2>
        <p class="dp-door-desc">Dundrum Physiotherapy and Sports Injury Clinic. Ring to book — what is current lives on dundrumphysio.co.uk.</p>
        <div class="dp-door-actions">
          <a class="dp-door-btn dp-door-btn--tel" href={phoneHref}><span class="dp-door-label">Telephone</span><span class="dp-door-val">Ring {phone} →</span></a>
          <a class="dp-door-btn" href={maps} rel="noopener noreferrer"><span class="dp-door-label">Directions</span><span class="dp-door-val">Open in Google Maps →</span></a>
          <a class="dp-door-btn" href={handoff} rel="noopener noreferrer"><span class="dp-door-label">Clinic site</span><span class="dp-door-val">dundrumphysio.co.uk →</span></a>
        </div>
        <address class="dp-address"><strong>Dundrum Physio</strong><span>12 Parterre Crescent</span><span>Dundrum, Newcastle · BT33 0WJ</span><a href={phoneHref}>{phone}</a></address>
      </div>
    </section>
  </main>
</ConceptLayout>
