---
/* Clinical session card for 12 Parterre Crescent.
   Honesty lives in bannerNote — caption stays guest voice. */
interface Props {
  headingId?: string;
}
const { headingId = "dp-session-heading" } = Astro.props;
---

<figure class="dp-card-figure" aria-labelledby={headingId}>
  <svg
    class="dp-card-svg"
    viewBox="0 0 420 540"
    role="img"
    aria-label="Dundrum Physiotherapy Clinic assessment record for 12 Parterre Crescent, showing assessment stages and clinical practice details"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern id="dp-dots" width="10" height="10" patternUnits="userSpaceOnUse">
        <circle cx="1.5" cy="1.5" r="0.8" fill="#a4b8ab" opacity="0.35"/>
      </pattern>
      <filter id="dp-shadow" x="-8%" y="-8%" width="116%" height="116%">
        <feDropShadow dx="0" dy="5" stdDeviation="7" flood-color="#1e3028" flood-opacity="0.14"/>
      </filter>
    </defs>

    <rect width="420" height="540" fill="#e8ebe6"/>
    <rect width="420" height="540" fill="url(#dp-dots)"/>

    <!-- Clip header -->
    <g transform="translate(185 16)">
      <rect x="0" y="0" width="50" height="42" rx="4" fill="#3f5a4a"/>
      <rect x="5" y="4" width="40" height="34" rx="3" fill="#6a8f7a"/>
      <circle cx="25" cy="16" r="4.5" fill="#e8ebe6"/>
    </g>

    <!-- Clinic sheet -->
    <g filter="url(#dp-shadow)">
      <rect x="52" y="44" width="316" height="456" rx="6" fill="#f7f9f7" stroke="#3f5a4a" stroke-width="1.5"/>
      <line x1="52" y1="114" x2="368" y2="114" stroke="#d2ded6" stroke-width="1.2"/>
    </g>

    <!-- Header info -->
    <text x="210" y="80" text-anchor="middle" fill="#1e3028" font-family="'Newsreader', Georgia, serif" font-size="21" font-weight="600">Dundrum Physiotherapy</text>
    <text x="210" y="100" text-anchor="middle" fill="#4a6e5a" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="9.5" font-weight="700" letter-spacing="2">12 PARTERRE CRESCENT · CLINICAL ASSESSMENT</text>

    <!-- Items -->
    <g font-family="'Plus Jakarta Sans', system-ui, sans-serif" fill="#1e3028">
      <text x="76" y="146" font-size="9.5" font-weight="700" letter-spacing="1.4" fill="#4a6e5a">INITIAL VISIT</text>
      <text x="344" y="146" text-anchor="end" font-size="11" font-weight="600" fill="#607268">60 min</text>

      <text x="76" y="174" font-size="14.5" font-weight="600">Comprehensive Assessment</text>
      <text x="344" y="174" text-anchor="end" font-size="12" fill="#607268">History &amp; Exam</text>
      <line x1="76" y1="186" x2="344" y2="186" stroke="#dce5e0" stroke-width="1"/>

      <text x="76" y="218" font-size="14.5" font-weight="600">Musculoskeletal Diagnosis</text>
      <text x="344" y="218" text-anchor="end" font-size="12" fill="#607268">Root Cause</text>
      <line x1="76" y1="230" x2="344" y2="230" stroke="#dce5e0" stroke-width="1"/>

      <text x="76" y="262" font-size="14.5" font-weight="600">Manual Therapy &amp; Relief</text>
      <text x="344" y="262" text-anchor="end" font-size="12" fill="#607268">Mobilisation</text>
      <line x1="76" y1="274" x2="344" y2="274" stroke="#dce5e0" stroke-width="1"/>

      <text x="76" y="306" font-size="14.5" font-weight="600">Tailored Rehab Programme</text>
      <text x="344" y="306" text-anchor="end" font-size="12" fill="#607268">Home Plan</text>
      <line x1="76" y1="318" x2="344" y2="318" stroke="#dce5e0" stroke-width="1"/>

      <text x="76" y="352" font-size="9.5" font-weight="700" letter-spacing="1.4" fill="#4a6e5a">CHARTERED CLINICIAN</text>
      <text x="76" y="378" font-size="14" font-weight="600">Marguerite Quinn MCSP</text>
      <text x="344" y="378" text-anchor="end" font-size="12" fill="#607268">20+ Years Exp.</text>
      <line x1="76" y1="390" x2="344" y2="390" stroke="#dce5e0" stroke-width="1"/>
    </g>

    <!-- Clinic stamp -->
    <g transform="translate(210 435)">
      <circle r="36" fill="none" stroke="#4a6e5a" stroke-width="1.2" opacity="0.8"/>
      <circle r="30" fill="none" stroke="#4a6e5a" stroke-width="0.8" stroke-dasharray="2 2" opacity="0.6"/>
      <text y="-6" text-anchor="middle" fill="#1e3028" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="7.5" font-weight="800" letter-spacing="1.2">DUNDRUM CLINIC</text>
      <text y="8" text-anchor="middle" fill="#4a6e5a" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="8" font-weight="700">BT33 0WJ</text>
      <text y="20" text-anchor="middle" fill="#607268" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="7" font-weight="600">ESTABLISHED</text>
    </g>

    <text x="210" y="488" text-anchor="middle" fill="#4a6e5a" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="10" font-weight="600" letter-spacing="0.4">Ring for appointment · 028 4375 0848</text>
  </svg>
  <figcaption class="dp-card-caption">Assessment card · 12 Parterre Crescent</figcaption>
</figure>
