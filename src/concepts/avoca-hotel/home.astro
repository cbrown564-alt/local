---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import PromWindow from "./PromWindow.astro";

/* Avoca Hotel — seafront hotel, restaurant, and Wild Hare pub on Central Promenade.
   93–97 Central Promenade, Newcastle, BT33 0HH.
   Phone: 028 4372 2253 · Email: info@avocahotel.com.
   Coastal rooms, Wild Hare bar & dining, golf packages, beer garden. */

const phone = "028 4372 2253";
const phoneHref = "tel:+442843722253";
const email = "info@avocahotel.com";
const mailto = `mailto:${email}`;
const site = "https://avocahotel.com/";
const maps =
  "https://www.google.com/maps/search/?api=1&query=93+97+Central+Promenade+Newcastle+BT33+0HH";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Assistant:wght@400;500;600;700&family=STIX+Two+Text:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap";

const roomTypes = [
  {
    kicker: "Seaview Scenic",
    title: "King Sea & Promenade Rooms",
    desc: "Front-facing bedrooms with panoramic double-glazed windows looking directly over the Irish Sea and Newcastle promenade.",
  },
  {
    kicker: "Mourne Aspect",
    title: "King Mountain & Garden Rooms",
    desc: "Quiet, restful rear-facing guest rooms looking toward the foot of the Mourne Mountains and hotel grounds.",
  },
  {
    kicker: "Family Stays",
    title: "Family King & Bunk Suites",
    desc: "Generously proportioned suites featuring a king bed plus sturdy bunk beds, ideal for coastal family holidays.",
  },
];

const hotelFeatures = [
  {
    title: "The Wild Hare Bar & Bistro",
    schedule: "Thu–Sun 3pm–1am",
    desc: "Hearty coastal dining, local Mourne seafood chowder, craft ales, and live acoustic music on Saturday and Sunday evenings.",
  },
  {
    title: "Golf Stay & Play Packages",
    schedule: "County Down Links",
    desc: "Tailored two and three-night stays with arranged tee times for golfers visiting Royal County Down and regional courses.",
  },
  {
    title: "Promenade Beer Garden",
    schedule: "Open Daily in Season",
    desc: "Relax with drinks in the sea air overlooking the Irish Sea, right at the foot of Slieve Donard.",
  },
];
---

<ConceptLayout
  title={"Avoca Hotel — independent concept"}
  slug="avoca-hotel"
  bodyClass="concept-page concept-avoca-hotel"
  lang="en-GB"
  businessName="Avoca Hotel"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The promenade window is a drawing."
>
  <div class="av-strip">
    <span>93–97 Central Promenade, Newcastle · BT33 0HH · Seafront Hotel &amp; Bistro</span>
    <span class="av-strip-r">
      <a href={phoneHref}>{phone}</a>
    </span>
  </div>

  <header class="av-header">
    <a class="av-brand" href="/concepts/avoca-hotel/">
      <span class="av-brand-mark" aria-hidden="true">
        <PromWindow compact />
      </span>
      <span class="av-brand-text">
        <span class="av-brand-name">Avoca Hotel</span>
        <span class="av-brand-sub">Central Promenade · Newcastle</span>
      </span>
    </a>
    <nav class="av-nav" aria-label="Concept navigation">
      <a href="#rooms">Rooms</a>
      <a href="#wild-hare">The Wild Hare</a>
      <a href="#golf">Golf &amp; Leisure</a>
      <a href="#book">Reservations</a>
    </nav>
    <a class="av-book-btn" href={site} rel="noopener noreferrer">Check Availability</a>
  </header>

  <main class="av-main">
    <section class="av-hero" aria-labelledby="av-name">
      <div class="av-hero-content">
        <span class="av-kicker">Seafront Hotel · Mourne Mountains</span>
        <h1 id="av-name">Avoca Hotel</h1>
        <p class="av-location-tag">93–97 Central Promenade · Newcastle · BT33 0HH</p>
        <p class="av-say">Mountains behind, Irish Sea in front — an elegant coastal haven.</p>
        <p class="av-lede">
          A welcoming family-run seafront hotel set directly on Newcastle’s Central Promenade.
          Wake to morning light over the sea, spend the afternoon walking the Mournes or playing world-class golf,
          and enjoy the fireside hospitality of The Wild Hare bar.
        </p>
        <div class="av-hero-actions">
          <a class="av-btn av-btn--primary" href={site} rel="noopener noreferrer">Book Online</a>
          <a class="av-btn av-btn--outline" href={phoneHref}>Ring {phone}</a>
        </div>
      </div>

      <div class="av-hero-art">
        <PromWindow />
      </div>
    </section>

    <section class="av-rooms-section" id="rooms" aria-labelledby="av-rooms-title">
      <div class="av-section-head">
        <span class="av-kicker">Accommodations</span>
        <h2 id="av-rooms-title">Comfortable Rooms Overlooking Sea and Mountain</h2>
        <p class="av-section-intro">
          Every bedroom is thoughtfully appointed with ensuite bathrooms, flat-screen television, high-speed Wi-Fi, and complimentary hot drink facilities.
        </p>
      </div>

      <div class="av-rooms-grid">
        {roomTypes.map((room) => (
          <article class="av-room-card">
            <span class="av-card-kicker">{room.kicker}</span>
            <h3>{room.title}</h3>
            <p>{room.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="av-wildhare-section" id="wild-hare" aria-labelledby="av-hare-title">
      <div class="av-wildhare-wrapper">
        <div class="av-section-head">
          <span class="av-kicker av-kicker--gold">Dining &amp; Tavern</span>
          <h2 id="av-hare-title">The Wild Hare Bar &amp; Bistro</h2>
          <p class="av-section-intro">
            A lively, welcoming Mourne pub serving local seafood, steaks, burgers, and classic tavern fare, alongside draught beers and weekend music.
          </p>
        </div>

        <div class="av-features-grid" id="golf">
          {hotelFeatures.map((feat) => (
            <div class="av-feature-card">
              <span class="av-feature-badge">{feat.schedule}</span>
              <h3>{feat.title}</h3>
              <p>{feat.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="av-booking-section" id="book" aria-labelledby="av-book-title">
      <div class="av-booking-card">
        <div class="av-booking-copy">
          <span class="av-kicker">Direct Reservations</span>
          <h2 id="av-book-title">Plan Your Stay in Newcastle</h2>
          <p class="av-booking-intro">
            Check live dates on our website or call our reception desk directly for room bookings, group dinner reservations, and golf packages.
            Convenient customer parking is supported by nearby Donard Park car park.
          </p>
          <div class="av-booking-actions">
            <a class="av-btn av-btn--primary" href={site} rel="noopener noreferrer">Visit avocahotel.com</a>
            <a class="av-btn av-btn--outline" href={phoneHref}>Call Reception {phone}</a>
            <a class="av-btn av-btn--outline" href={mailto}>Email info@avocahotel.com</a>
          </div>
        </div>

        <address class="av-address-box">
          <strong>Avoca Hotel</strong>
          <span>93–97 Central Promenade</span>
          <span>Newcastle, County Down</span>
          <span>BT33 0HH</span>
          <a class="av-phone-link" href={phoneHref}>{phone}</a>
          <a class="av-email-link" href={mailto}>{email}</a>
          <div class="av-hours-summary">
            <span>Hotel: Mon–Sun 11:00 – 01:00</span>
            <span>Wild Hare: Thu–Sun 15:00 – 01:00</span>
          </div>
          <a class="av-map-link" href={maps} rel="noopener noreferrer">Directions on Google Maps</a>
        </address>
      </div>
    </section>
  </main>

  <footer class="av-footer">
    <p class="av-footer-name">Avoca Hotel</p>
    <p>93–97 Central Promenade, Newcastle · Coastal Hotel, Bistro &amp; Wild Hare Pub</p>
  </footer>
</ConceptLayout>
