---
/* Drawn promenade window: Mournes behind, sea in front.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

{compact ? (
  <svg
    class="av-mark"
    width="44"
    height="44"
    viewBox="0 0 44 44"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <rect width="44" height="44" fill="#1c2438"/>
    <rect x="6" y="8" width="32" height="28" fill="#d8e4ee" stroke="#c9a882" stroke-width="1.5"/>
    <path d="M8 28 L16 18 L22 24 L30 14 L36 28 Z" fill="#5a6e88" opacity="0.5"/>
    <path d="M8 30 H36" stroke="#3a6a7a" stroke-width="2"/>
  </svg>
) : (
  <svg
    class="av-promwindow"
    viewBox="0 0 960 560"
    role="img"
    aria-label="Drawn Avoca Hotel promenade window looking to the Irish Sea with Mournes silhouette"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="av-dusk" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#c5d4e4"/>
        <stop offset="0.55" stop-color="#e8dcc8"/>
        <stop offset="1" stop-color="#b8c8d4"/>
      </linearGradient>
      <linearGradient id="av-sea" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#6a8fa0"/>
        <stop offset="1" stop-color="#3d5a68"/>
      </linearGradient>
    </defs>

    <rect width="960" height="560" fill="#2a303c"/>
    <!-- Window frame -->
    <rect x="60" y="40" width="840" height="480" fill="#1c2438"/>
    <rect x="80" y="60" width="800" height="440" fill="url(#av-dusk)"/>

    <!-- Mournes silhouette -->
    <path d="M80 260 L180 160 L260 220 L340 140 L420 200 L500 120 L580 190 L660 150 L760 210 L880 170 L880 300 L80 300 Z" fill="#3a4558" opacity="0.85"/>
    <!-- Sea -->
    <rect x="80" y="300" width="800" height="200" fill="url(#av-sea)"/>
    <path d="M80 320 Q200 300 320 325 T560 315 T880 330 L880 500 L80 500 Z" fill="#2a4854" opacity="0.35"/>

    <!-- Mullion -->
    <rect x="470" y="60" width="10" height="440" fill="#1c2438"/>
    <rect x="80" y="270" width="800" height="10" fill="#1c2438"/>

    <!-- Brass plate -->
    <rect x="300" y="400" width="360" height="70" fill="#1c2438" opacity="0.92"/>
    <rect x="308" y="408" width="344" height="54" stroke="#c9a882" stroke-width="1.5" fill="none"/>
    <text x="480" y="432" text-anchor="middle" fill="#f4efe6" font-family="STIX Two Text, Georgia, serif" font-size="22" font-weight="600" letter-spacing="3">AVOCA HOTEL</text>
    <text x="480" y="452" text-anchor="middle" fill="#c9a882" font-family="Assistant, system-ui, sans-serif" font-size="11" font-weight="600" letter-spacing="2">93–97 CENTRAL PROMENADE</text>
  </svg>
)}
