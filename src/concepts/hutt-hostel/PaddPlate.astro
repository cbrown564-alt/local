---
/* Drawn corner at 30 Downs Road: The Padd, Donard next door, morning sea.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
---

<svg
  class="hh-plate"
  viewBox="0 0 1000 620"
  role="img"
  aria-label="The Padd at 30 Downs Road, with Donard next door and the sea in the morning"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="hh-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#eef6f8"/>
      <stop offset=".55" stop-color="#e4eef2"/>
      <stop offset="1" stop-color="#d5e4ea"/>
    </linearGradient>
    <linearGradient id="hh-sea" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9bbcc8"/>
      <stop offset="1" stop-color="#6e94a4"/>
    </linearGradient>
    <linearGradient id="hh-sand" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e8d7b0"/>
      <stop offset="1" stop-color="#d4c094"/>
    </linearGradient>
    <linearGradient id="hh-brick" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#b56b58"/>
      <stop offset="1" stop-color="#8c4a3c"/>
    </linearGradient>
    <linearGradient id="hh-hotel" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f3ead8"/>
      <stop offset="1" stop-color="#e0d2b8"/>
    </linearGradient>
    <linearGradient id="hh-glass" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f7fbfc" stop-opacity=".45"/>
      <stop offset="1" stop-color="#c5d8e0" stop-opacity=".22"/>
    </linearGradient>
    <linearGradient id="hh-sun" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff6d8"/>
      <stop offset="1" stop-color="#f0d9a0"/>
    </linearGradient>
    <pattern id="hh-bond" width="22" height="12" patternUnits="userSpaceOnUse">
      <rect width="22" height="12" fill="#9c5646"/>
      <rect y="5.4" width="22" height="1.1" fill="#7a4034"/>
      <rect x="10.4" width="1.1" height="12" fill="#7a4034"/>
    </pattern>
    <pattern id="hh-pave" width="40" height="16" patternUnits="userSpaceOnUse">
      <rect width="40" height="16" fill="#d8cfc2"/>
      <rect y="14" width="40" height="2" fill="#c4b9aa"/>
      <rect x="19" width="1" height="16" fill="#c4b9aa"/>
    </pattern>
    <pattern id="hh-grid" width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M20 0H0V20" fill="none" stroke="#1b2f44" stroke-opacity=".05" stroke-width="1"/>
    </pattern>
  </defs>

  <rect width="1000" height="620" fill="#f4efe6"/>
  <rect width="1000" height="620" fill="url(#hh-grid)"/>

  <!-- Survey frame -->
  <rect x="28" y="28" width="944" height="564" fill="none" stroke="#1b2f44" stroke-width="1.4"/>
  <rect x="36" y="36" width="928" height="464" fill="url(#hh-sky)"/>

  <!-- Morning sun over the sea -->
  <circle cx="168" cy="168" r="42" fill="url(#hh-sun)" opacity=".9"/>
  <circle cx="168" cy="168" r="58" fill="#fff6d8" opacity=".22"/>

  <!-- Donard slope behind the hotel -->
  <path d="M520 268 L668 96 L792 128 L920 268 Z" fill="#6d8490"/>
  <path d="M668 96 L720 268 L616 268 Z" fill="#8aa0aa" opacity=".55"/>
  <path d="M640 118 C652 132 658 148 662 168" fill="none" stroke="#f6f3ee" stroke-width="1.4" opacity=".45"/>

  <!-- Sea and sand, a few hundred yards -->
  <rect x="36" y="268" width="928" height="72" fill="url(#hh-sea)"/>
  <path d="M36 268 C120 258 200 276 300 266 S500 252 640 268 S820 258 964 270" fill="none" stroke="#f6f3ee" stroke-width="2" opacity=".4"/>
  <rect x="36" y="340" width="928" height="28" fill="url(#hh-sand)"/>

  <!-- Slieve Donard Hotel mass — next door -->
  <g transform="translate(612 188)">
    <rect x="48" y="28" width="268" height="152" fill="url(#hh-hotel)" stroke="#1b2f44" stroke-width="1.4"/>
    <polygon points="48,28 182,0 316,28" fill="#e8dcc6" stroke="#1b2f44" stroke-width="1.4"/>
    <rect x="168" y="8" width="28" height="36" fill="#1b2f44"/>
    <g fill="#f6f3ee" stroke="#1b2f44" stroke-width="1">
      <rect x="68" y="48" width="36" height="44"/>
      <rect x="118" y="48" width="36" height="44"/>
      <rect x="210" y="48" width="36" height="44"/>
      <rect x="260" y="48" width="36" height="44"/>
      <rect x="68" y="108" width="36" height="44"/>
      <rect x="118" y="108" width="36" height="44"/>
      <rect x="210" y="108" width="36" height="44"/>
      <rect x="260" y="108" width="36" height="44"/>
    </g>
    <text
      x="182"
      y="214"
      text-anchor="middle"
      fill="#1b2f44"
      font-family="Outfit, Segoe UI, sans-serif"
      font-size="11"
      font-weight="600"
      letter-spacing="3.2"
    >DONARD</text>
  </g>

  <!-- The Hutt, brick corner, number 30 -->
  <g transform="translate(96 196)">
    <rect x="0" y="40" width="420" height="172" fill="url(#hh-brick)"/>
    <rect x="0" y="40" width="420" height="172" fill="url(#hh-bond)" opacity=".55"/>
    <rect x="0" y="40" width="420" height="10" fill="#7a4034"/>
    <rect x="-8" y="32" width="436" height="10" fill="#1b2f44"/>

    <!-- Upper windows -->
    <g fill="#e8f1f4" stroke="#1b2f44" stroke-width="1.4">
      <rect x="28" y="64" width="52" height="64"/>
      <rect x="98" y="64" width="52" height="64"/>
      <rect x="168" y="64" width="52" height="64"/>
      <rect x="280" y="64" width="52" height="64"/>
      <rect x="350" y="64" width="52" height="64"/>
    </g>
    <g stroke="#1b2f44" stroke-width="1">
      <path d="M54 64v64M28 96h52M124 64v64M98 96h52M194 64v64M168 96h52M306 64v64M280 96h52M376 64v64M350 96h52"/>
    </g>

    <!-- The Padd — ground-floor apartment -->
    <rect x="16" y="148" width="388" height="64" fill="#6e3c32"/>
    <rect x="16" y="148" width="388" height="6" fill="#e8d5a3"/>
    <g fill="url(#hh-glass)" stroke="#1b2f44" stroke-width="1.4">
      <rect x="28" y="158" width="78" height="46"/>
      <rect x="118" y="158" width="78" height="46"/>
      <rect x="208" y="158" width="78" height="46"/>
    </g>
    <rect x="308" y="158" width="80" height="54" fill="#f6f3ee" stroke="#1b2f44" stroke-width="1.6"/>
    <text
      x="348"
      y="192"
      text-anchor="middle"
      fill="#1b2f44"
      font-family="Literata, Georgia, serif"
      font-size="22"
      font-weight="700"
    >30</text>
    <circle cx="378" cy="186" r="3" fill="#e8d5a3"/>

    <text
      x="210"
      y="142"
      text-anchor="middle"
      fill="#f6f3ee"
      font-family="Outfit, Segoe UI, sans-serif"
      font-size="13"
      font-weight="700"
      letter-spacing="4"
    >THE PADD</text>
  </g>

  <!-- Pavement / Downs Road -->
  <rect x="36" y="368" width="928" height="132" fill="url(#hh-pave)"/>
  <rect x="36" y="368" width="928" height="6" fill="#b7aa98"/>
  <text
    x="250"
    y="486"
    fill="#1b2f44"
    font-family="Outfit, Segoe UI, sans-serif"
    font-size="12"
    font-weight="600"
    letter-spacing="4.5"
  >DOWNS ROAD</text>
  <text
    x="720"
    y="486"
    text-anchor="end"
    fill="#1b2f44"
    font-family="Outfit, Segoe UI, sans-serif"
    font-size="11"
    font-weight="500"
    letter-spacing="3.2"
  >DONARD PLACE</text>

  <!-- Title block: could not move -->
  <g transform="translate(36 508)">
    <rect x="0" y="0" width="928" height="76" fill="#fbfaf7" stroke="#1b2f44" stroke-width="1.2"/>
    <line x1="220" y1="0" x2="220" y2="76" stroke="#1b2f44" stroke-width="1"/>
    <line x1="520" y1="0" x2="520" y2="76" stroke="#1b2f44" stroke-width="1"/>
    <line x1="740" y1="0" x2="740" y2="76" stroke="#1b2f44" stroke-width="1"/>

    <text x="16" y="24" fill="#9c5646" font-family="Outfit, Segoe UI, sans-serif" font-size="9" font-weight="600" letter-spacing="2.4">APARTMENT</text>
    <text x="16" y="52" fill="#1b2f44" font-family="Literata, Georgia, serif" font-size="22" font-weight="700">The Padd</text>

    <text x="236" y="24" fill="#9c5646" font-family="Outfit, Segoe UI, sans-serif" font-size="9" font-weight="600" letter-spacing="2.4">DOOR</text>
    <text x="236" y="52" fill="#1b2f44" font-family="Literata, Georgia, serif" font-size="18" font-weight="600">30 Downs Road</text>

    <text x="536" y="24" fill="#9c5646" font-family="Outfit, Segoe UI, sans-serif" font-size="9" font-weight="600" letter-spacing="2.4">NEXT DOOR</text>
    <text x="536" y="52" fill="#1b2f44" font-family="Literata, Georgia, serif" font-size="18" font-weight="600">Donard</text>

    <text x="756" y="24" fill="#9c5646" font-family="Outfit, Segoe UI, sans-serif" font-size="9" font-weight="600" letter-spacing="2.4">ROOMS</text>
    <text x="756" y="46" fill="#1b2f44" font-family="Outfit, Segoe UI, sans-serif" font-size="11">Kitchen · lounge</text>
    <text x="756" y="62" fill="#1b2f44" font-family="Outfit, Segoe UI, sans-serif" font-size="11">Shower · toilet</text>
  </g>
</svg>
