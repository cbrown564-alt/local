---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import PaddPlate from "./PaddPlate.astro";

/* The Hutt Hostel — elevated mountain basecamp & expedition lodge concept.
   30 Downs Road, Newcastle, BT33 0AG.
   72 beds, The Padd private flat, foot of Slieve Donard.
   Sourced from hutthostel.com, Google Business, and public records. */

const phone = "028 4372 2133";
const phoneHref = "tel:+442843722133";
const email = "info@hutthostel.com";
const mailto = `mailto:${email}`;
const site = "http://hutthostel.com";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,500;0,7..72,600;0,7..72,700;1,7..72,500;1,7..72,600&family=Outfit:wght@400;500;600;700;800&display=swap";

const trails = [
  {
    name: "Slieve Donard Summit via Glen River",
    distance: "9.2 km return · 850m ascent",
    desc: "Starts at Donard Park, 2 minutes from our front door. Follow the cascading river to the saddle between Donard and Commedagh.",
  },
  {
    name: "The Mourne Wall Ridge",
    distance: "Full day ridge traverse",
    desc: "Granite dry-stone wall crossing fifteen mountain peaks across County Down.",
  },
  {
    name: "Bloody Bridge & Coastal Granite",
    distance: "6.5 km coastal walk",
    desc: "Rocky coastal shoreline path leading up into the dramatic Bloody Bridge river valley.",
  },
];
---

<ConceptLayout
  title={"The Hutt Hostel — Mountain Basecamp & Accommodation, Newcastle"}
  slug="hutt-hostel"
  bodyClass="concept-page concept-hutt"
  lang="en-GB"
  businessName="The Hutt Hostel"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="Mountain dawn and basecamp photographs are AI-generated illustrative visualisations of 30 Downs Road."
>
  <div class="hh-strip">
    <span>30 Downs Road, Newcastle · BT33 0AG · At the foot of Slieve Donard</span>
    <span class="hh-strip-r">Reception 5:00pm–9:00pm daily · <a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="hh-header">
    <a class="hh-brand" href="/concepts/hutt-hostel/">
      <span class="hh-brand-mark" aria-hidden="true">
        <PaddPlate compact />
      </span>
      <span class="hh-brand-text">
        <span class="hh-brand-name">The Hutt Hostel</span>
        <span class="hh-brand-sub">30 Downs Road · Newcastle</span>
      </span>
    </a>
    <nav class="hh-nav" aria-label="Concept navigation">
      <a href="#stay">Bunks &amp; The Padd</a>
      <a href="#basecamp">Basecamp facilities</a>
      <a href="#trails">Mourne trails</a>
      <a href="#reception">Book &amp; Check-in</a>
    </nav>
    <a class="hh-book-nav" href={phoneHref}>Call {phone}</a>
  </header>

  <main class="hh-main">
    <!-- Hero with atmospheric mountain dawn photography plate -->
    <section class="hh-hero" aria-labelledby="hh-hero-title">
      <figure class="hh-hero-plate">
        <picture>
          <img
            src="/media/concepts/hutt-hostel/hutt-hostel-hero-mountain.jpg"
            alt="AI-generated illustrative view of hikers outside The Hutt Hostel on Downs Road with Slieve Donard in morning mist"
            width="1920"
            height="1080"
            loading="eager"
          />
        </picture>
        <figcaption>Dawn on Downs Road with Slieve Donard. AI-generated illustrative visualisation.</figcaption>
      </figure>

      <div class="hh-hero-veil" aria-hidden="true"></div>

      <div class="hh-hero-stage">
        <p class="hh-kicker">30 Downs Road · Newcastle, County Down</p>
        <h1 id="hh-hero-title">The Hutt Hostel</h1>
        <p class="hh-hero-say">Wake up beside the sea.</p>
        <p class="hh-hero-lede">
          72 beds at the foot of the Mourne Mountains. Shared bunks for trail walkers, private rooms, and The Padd self-contained flat — right beside Donard Park and the Percy French.
        </p>
        <div class="hh-hero-actions">
          <a class="hh-btn hh-btn--primary" href="#stay">Choose your accommodation</a>
          <a class="hh-btn hh-btn--ghost" href="#reception">Check-in &amp; Group Booking ↓</a>
        </div>
      </div>
    </section>

    <!-- Accommodation split: Bunks & Private Rooms vs The Padd -->
    <section class="hh-stay-section" id="stay" aria-labelledby="hh-stay-title">
      <div class="hh-section-header">
        <p class="hh-kicker hh-kicker--gorse">Accommodation</p>
        <h2 id="hh-stay-title">Bunk beds or private self-contained living.</h2>
        <p class="hh-section-lead">72 beds configured for individual backpackers, expedition groups, sports clubs, and families.</p>
      </div>

      <div class="hh-stay-grid">
        <!-- Card 1: Mountain Dorms -->
        <article class="hh-stay-card">
          <div class="hh-card-header">
            <span class="hh-badge">Shared &amp; Private Dorms</span>
            <h3>Mountain Bunks &amp; Rooms</h3>
          </div>
          <p class="hh-stay-lede">
            Built for hikers, trail runners, and groups tackling the Mourne Wall. Solid timber bunks, individual reading lights, personal charging sockets, and secure lockers.
          </p>
          <ul class="hh-stay-features">
            <li>72 beds across multiple room configurations</li>
            <li>Hot high-pressure showers &amp; washrooms</li>
            <li>Heated drying room for wet boots and waterproofs</li>
            <li>Full self-catering communal kitchen access</li>
            <li>Ideal for hiking clubs, university trips &amp; DofE groups</li>
          </ul>
          <div class="hh-card-cta">
            <a class="hh-btn hh-btn--primary" href={phoneHref}>Call to reserve beds</a>
            <a class="hh-card-sublink" href={`mailto:${email}?subject=Group%20Booking%20Inquiry%20-%20The%20Hutt`}>Email group inquiry →</a>
          </div>
        </article>

        <!-- Card 2: The Padd Flat -->
        <article class="hh-stay-card hh-stay-card--padd">
          <figure class="hh-padd-thumb">
            <img
              src="/media/concepts/hutt-hostel/hutt-hostel-padd-apartment.jpg"
              alt="AI-generated illustrative interior of The Padd private holiday flat with mountain views"
              width="1200"
              height="800"
              loading="lazy"
            />
            <figcaption>The Padd private self-contained apartment. AI-generated illustrative visualisation.</figcaption>
          </figure>
          <div class="hh-card-body">
            <div class="hh-card-header">
              <span class="hh-badge hh-badge--gold">Private Apartment</span>
              <h3>“The Padd” Self-Contained Flat</h3>
            </div>
            <p class="hh-stay-lede">
              A private self-contained retreat within The Hutt. Complete with dedicated fitted kitchenette, private shower room, toilet, and cozy lounge.
            </p>
            <ul class="hh-stay-features">
              <li>Self-contained private entrance</li>
              <li>Fitted kitchen with hob, microwave &amp; fridge</li>
              <li>Private lounge with sofa &amp; dining table</li>
              <li>En-suite modern shower room &amp; WC</li>
              <li>Mountain views towards the Mourne foothills</li>
            </ul>
            <div class="hh-card-cta">
              <a class="hh-btn hh-btn--primary" href={phoneHref}>Inquire for The Padd</a>
              <a class="hh-card-sublink" href={`mailto:${email}?subject=The%20Padd%20Apartment%20Inquiry`}>Email for dates →</a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- Basecamp Facilities Section -->
    <section class="hh-basecamp-section" id="basecamp" aria-labelledby="hh-basecamp-title">
      <div class="hh-basecamp-grid">
        <figure class="hh-basecamp-figure">
          <img
            src="/media/concepts/hutt-hostel/hutt-hostel-lounge-interior.jpg"
            alt="AI-generated illustrative scene of hikers in The Hutt Hostel common room around the hearth"
            width="1200"
            height="900"
            loading="lazy"
          />
          <figcaption>Evening in the common room. AI-generated illustrative visualisation.</figcaption>
        </figure>

        <div class="hh-basecamp-copy">
          <p class="hh-kicker hh-kicker--gorse">Basecamp facilities</p>
          <h2 id="hh-basecamp-title">The hiker’s hearth in Newcastle.</h2>
          <p class="hh-basecamp-lead">
            After twelve miles on the ridges, you need hot water, a warm room to cook in, and somewhere to dry your kit before tomorrow’s trek.
          </p>
          <div class="hh-amenities-list">
            <div class="hh-amenity">
              <strong>Heated Boot &amp; Gear Drying Room</strong>
              <p>Dedicated high-airflow drying area for soaked walking boots, waterproof jackets, and packs.</p>
            </div>
            <div class="hh-amenity">
              <strong>Self-Catering Kitchen &amp; Social Tables</strong>
              <p>Gas hobs, ovens, cookware, and long pine tables for sharing trail stories over hot tea.</p>
            </div>
            <div class="hh-amenity">
              <strong>Secure Bike &amp; Equipment Storage</strong>
              <p>Locked internal storage for touring bikes, climbing gear, and large backpacks.</p>
            </div>
            <div class="hh-amenity">
              <strong>Prime Newcastle Location</strong>
              <p>Adjacent to the Slieve Donard Resort, Percy French bar, and the start of the Glen River trail.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mourne Trails Compass Section -->
    <section class="hh-trails-section" id="trails" aria-labelledby="hh-trails-title">
      <div class="hh-section-header">
        <p class="hh-kicker hh-kicker--gorse">Trailhead compass</p>
        <h2 id="hh-trails-title">From our front door to the summits.</h2>
        <p class="hh-section-lead">Step straight from 30 Downs Road onto County Down’s greatest mountain routes.</p>
      </div>

      <div class="hh-trails-grid">
        {trails.map((t) => (
          <div class="hh-trail-card">
            <span class="hh-trail-dist">{t.distance}</span>
            <h3 class="hh-trail-name">{t.name}</h3>
            <p class="hh-trail-desc">{t.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Reception Docket & Booking Protocol -->
    <section class="hh-reception-section" id="reception" aria-labelledby="hh-rec-title">
      <div class="hh-reception-wrap">
        <div class="hh-reception-copy">
          <p class="hh-kicker hh-kicker--gorse">Check-in &amp; booking</p>
          <h2 id="hh-rec-title">Reception open 5:00pm to 9:00pm.</h2>
          <p class="hh-reception-lead">
            Our reception desk at 30 Downs Road is open every evening from 5:00pm to 9:00pm for check-ins, trail advice, and room allocations.
          </p>
          <div class="hh-rec-box">
            <strong>Late Arrivals &amp; Groups:</strong>
            <p>Arriving after 9:00pm or organizing a large club expedition? Ring us in advance to arrange key lockbox access or group deposit invoices.</p>
          </div>
          <div class="hh-rec-actions">
            <a class="hh-btn hh-btn--primary" href={phoneHref}>Call {phone}</a>
            <a class="hh-btn hh-btn--ghost" href={mailto}>Email {email}</a>
          </div>
        </div>

        <figure class="hh-plate-figure">
          <PaddPlate />
          <figcaption>The Hutt Hostel · 30 Downs Road, Newcastle.</figcaption>
        </figure>
      </div>
    </section>

    <!-- Footer -->
    <footer class="hh-footer">
      <div class="hh-footer-inner">
        <div class="hh-footer-brand">
          <PaddPlate compact />
          <strong class="hh-footer-name">The Hutt Hostel</strong>
          <span>30 Downs Road · Newcastle · BT33 0AG</span>
        </div>
        <div class="hh-footer-hours">
          <strong>Daily Reception Desk: 5:00pm – 9:00pm</strong>
          <span>Telephone: <a href={phoneHref}>{phone}</a> · <a href={mailto}>{email}</a></span>
        </div>
        <div class="hh-footer-links">
          <a href={site} rel="noopener noreferrer">hutthostel.com</a>
          <a href={phoneHref}>Direct Booking: {phone}</a>
        </div>
      </div>
    </footer>
  </main>
</ConceptLayout>
