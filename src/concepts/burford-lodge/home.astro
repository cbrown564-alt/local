---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import "./styles.css";

/* Burford Lodge Guest House — 30 Quay Street, Ardglass, BT30 7SA.
   Verified live 26 Nov 2026: burfordlodgeguesthouse.com prints raw [yoona-main-slider] shortcode,
   leaks theme-customizer footer copy & ravistheme@gmail.com; 6 seafront en-suite bedrooms,
   dog-friendly, smoked salmon & Full Irish breakfast, opposite Ardglass Marina & minutes from Ardglass Golf Club. */
const phone = "028 4484 1141";
const phoneHref = "tel:+442844841141";
const email = "burfordlodge30@aol.com";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Burford+Lodge+Guest+House+30+Quay+Street+Ardglass+BT30+7SA";

const stayGroups = [
  {
    id: "rooms",
    label: "Six En-Suite Rooms",
    items: [
      { name: "Seafront King & Double Rooms", note: "Front-facing sash windows looking directly over Ardglass Marina and the Irish Sea", meta: "Harbour view" },
      { name: "Triple & Family Bedrooms", note: "Spacious en-suite family rooms with tea & coffee trays, Wi-Fi and flat-screen TVs", meta: "Families welcome" },
      { name: "Dog-Friendly Stays", note: "Family-run guest house where well-behaved family dogs are welcome alongside guests", meta: "Pets welcome" },
    ],
  },
  {
    id: "breakfast",
    label: "Breakfast & Golf Base",
    items: [
      { name: "Cooked-to-Order Breakfast", note: "Full Irish breakfast, smoked salmon on wheaten bread, eggs and fresh coffee", meta: "Included" },
      { name: "Ardglass Golf Club", note: "Minutes from the world-famous clifftop links and 1405 castle clubhouse", meta: "2 mins away" },
      { name: "Lecale & Strangford Coast", note: "Easy base for Castle Ward, Downpatrick, Strangford Ferry and coastal walks", meta: "Quay Street" },
    ],
  },
];
---

<ConceptLayout
  title="Burford Lodge Guest House — Quay Street, Ardglass"
  slug="burford-lodge"
  bodyClass="concept-page concept-burford"
  businessName="Burford Lodge Guest House"
  town="Ardglass"
  bannerNote="Imagery comprises indicative harbour-view bedroom and coastal breakfast visualisations."
>
  <header class="bl-header">
    <div class="bl-header-inner">
      <a class="bl-brand" href="#top">
        <strong>Burford Lodge</strong>
        <span>30 Quay Street · Ardglass</span>
      </a>
      <nav class="bl-nav" aria-label="Primary">
        <a href="#rooms">Rooms</a>
        <a href="#breakfast">Breakfast &amp; Golf</a>
        <a href="#direct-booking">Book Direct</a>
        <a href="#location">Quay Street</a>
      </nav>
      <div class="bl-header-actions">
        <a class="bl-header-tel" href={phoneHref}>{phone}</a>
        <a class="bl-header-cta" href="#direct-booking">Enquire Direct</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="bl-hero" aria-labelledby="bl-hero-title">
      <div class="bl-wrap">
        <div class="bl-hero-head">
          <p class="bl-kicker">30 Quay Street · Ardglass Marina · County Down</p>
          <h1 id="bl-hero-title">Six seafront rooms opposite Ardglass Marina.</h1>
          <p class="bl-lead">
            A family-run guest house on the harbour front, two minutes from Ardglass Golf Club,
            with smoked salmon or a Full Irish on the breakfast table and a warm welcome for dogs.
          </p>
          <div class="bl-actions">
            <a class="bl-btn bl-btn--primary" href="#direct-booking">Check Dates Direct</a>
            <SpecimenSheet
              id="bl-stay-sheet"
              triggerLabel="Rooms & Golf Guide"
              kicker="Burford Lodge · 30 Quay Street, Ardglass"
              title="Seafront Rooms, Breakfast & Local Links"
              subtitle="Six en-suite rooms opposite the marina. Ring or message direct for best rates."
              groups={stayGroups}
              ctaLabel="Send Direct Room Request"
              ctaHref="#direct-booking"
              secondaryLabel={`Call ${phone}`}
              secondaryHref={phoneHref}
              buttonClass="bl-link-trigger"
            />
          </div>
        </div>

        <figure class="bl-hero-figure">
          <picture>
            <source srcset="/media/concepts/burford-lodge/burford-lodge-harbour-view-640.webp 640w, /media/concepts/burford-lodge/burford-lodge-harbour-view-1265.webp 1265w" sizes="(max-width: 900px) 100vw, 90vw" type="image/webp" />
            <img src="/media/concepts/burford-lodge/burford-lodge-harbour-view.jpg" alt="Seafront guest-house bedroom looking out across stone marina walls and morning Irish Sea light" width="1408" height="768" loading="eager" />
          </picture>
          <figcaption>Morning view over Ardglass harbour. Indicative seafront bedroom visualisation.</figcaption>
        </figure>

        <dl class="bl-facts">
          <div><dt>Accommodation</dt><dd>6 En-Suite Bedrooms</dd></div>
          <div><dt>Ardglass Golf Club</dt><dd>2 Minutes on Foot</dd></div>
          <div><dt>Morning Table</dt><dd>Smoked Salmon &amp; Full Irish</dd></div>
          <div><dt>Family Dogs</dt><dd>Welcome Throughout</dd></div>
        </dl>
      </div>
    </section>

    <section class="bl-section bl-rooms" id="rooms" aria-labelledby="bl-rooms-title">
      <div class="bl-wrap">
        <p class="bl-kicker">Accommodation</p>
        <h2 id="bl-rooms-title">Quiet coastal rooms built for golfers, walkers and families.</h2>
        <div class="bl-cards">
          <article class="bl-card">
            <h3>Harbour-View King &amp; Double</h3>
            <p>Front rooms overlooking Ardglass Marina so you wake to fishing boats, rigging and open Irish Sea light.</p>
          </article>
          <article class="bl-card">
            <h3>Triple &amp; Family Rooms</h3>
            <p>Generous en-suite rooms suited to golf fourballs, coastal cyclists and families exploring Lecale.</p>
          </article>
          <article class="bl-card">
            <h3>Dogs Welcome Too</h3>
            <p>Bring the family dog along. Coastal paths, quiet beaches and harbour walls begin across the road.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="bl-section bl-breakfast" id="breakfast" aria-labelledby="bl-breakfast-title">
      <div class="bl-wrap bl-split">
        <figure class="bl-plate">
          <picture>
            <source srcset="/media/concepts/burford-lodge/burford-lodge-morning-breakfast-640.webp 640w, /media/concepts/burford-lodge/burford-lodge-morning-breakfast-1265.webp 1265w" sizes="(max-width: 860px) 100vw, 48vw" type="image/webp" />
            <img src="/media/concepts/burford-lodge/burford-lodge-morning-breakfast.jpg" alt="Smoked salmon on dark wheaten bread with poached eggs and fresh coffee beside a sunlit sash window" width="1408" height="768" loading="lazy" />
          </picture>
          <figcaption>Cooked-to-order morning table at Quay Street. Indicative breakfast visualisation.</figcaption>
        </figure>
        <div>
          <p class="bl-kicker">Morning Table &amp; Nearby</p>
          <h2 id="bl-breakfast-title">Smoked salmon or a Full Irish before your first tee time.</h2>
          <p>
            Start the morning with locally smoked salmon, poached eggs, or a traditional Full Irish breakfast
            before walking up to Ardglass Golf Club or driving ten minutes to Downpatrick and Castle Ward.
          </p>
          <ul class="bl-nearby">
            <li><span>Ardglass Golf Club</span><strong>2 mins</strong></li>
            <li><span>Ardglass Marina &amp; Seafront</span><strong>Opposite</strong></li>
            <li><span>Downpatrick &amp; St Patrick Centre</span><strong>12 mins</strong></li>
            <li><span>Strangford Ferry &amp; Castle Ward</span><strong>15 mins</strong></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="bl-section bl-booking" id="direct-booking" aria-labelledby="bl-book-title">
      <div class="bl-wrap bl-split">
        <div>
          <p class="bl-kicker">Direct Enquiries</p>
          <h2 id="bl-book-title">Book straight with Quay Street.</h2>
          <p>
            Tell us your arrival date, nights and room mix, whether it is a seafront double, a golf fourball,
            or a dog-friendly family stay, and we will reply directly from Burford Lodge.
          </p>
          <p class="bl-direct-meta">
            Telephone: <a href={phoneHref}>{phone}</a><br />
            Email: <a href={`mailto:${email}`}>{email}</a>
          </p>
        </div>
        <form class="bl-form" data-bl-form>
          <div class="bl-row">
            <label>
              <span>Your name</span>
              <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
            </label>
            <label>
              <span>Telephone</span>
              <input name="phone" type="tel" required autocomplete="tel" placeholder="028 / 07..." />
            </label>
          </div>
          <div class="bl-row">
            <label>
              <span>Check-in date</span>
              <input name="checkin" type="date" required />
            </label>
            <label>
              <span>Nights</span>
              <input name="nights" type="number" min="1" max="14" value="2" required />
            </label>
          </div>
          <label>
            <span>Room preference</span>
            <select name="room">
              <option value="Seafront King / Double">Seafront King / Double (Harbour View)</option>
              <option value="Twin / Golf Pairing">Twin Room / Golf Group</option>
              <option value="Triple / Family En-Suite">Triple or Family En-Suite</option>
              <option value="Dog-Friendly Stay">Dog-Friendly Room</option>
            </select>
          </label>
          <label>
            <span>Notes (tee times, early breakfast, bringing a dog)</span>
            <textarea name="notes" rows="3" placeholder="Let us know any early golf start or dog details..."></textarea>
          </label>
          <button class="bl-btn bl-btn--primary" type="submit">Send Direct Stay Request</button>
        </form>
      </div>
    </section>

    <section class="bl-section bl-map-band" id="location" aria-label="Ardglass location map">
      <div class="bl-wrap">
        <LocalAreaMap
          id="bl-map"
          kicker="Lecale Peninsula & Irish Sea"
          businessName="Burford Lodge Guest House"
          address="30 Quay Street, Ardglass, Downpatrick, BT30 7SA"
          lon={-5.608527}
          lat={54.2612987}
          spanKm={16}
          mapHref={mapsHref}
          markers={[
            { name: "Downpatrick", lon: -5.7168, lat: 54.3286, note: "12 mins west", side: "l" },
            { name: "Strangford Ferry", lon: -5.5546, lat: 54.3712, note: "15 mins north", side: "t" },
            { name: "Killough Bay", lon: -5.6431, lat: 54.2535, note: "5 mins south", side: "b" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="bl-footer">
    <div class="bl-wrap bl-footer-inner">
      <div>
        <strong>Burford Lodge Guest House</strong>
        <p>30 Quay Street, Ardglass, Downpatrick, Co. Down, BT30 7SA</p>
      </div>
      <div class="bl-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const form = document.querySelector("[data-bl-form]");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        const subject = `Room Enquiry — ${fd.get("checkin")} (${fd.get("nights")} nights)`;
        const body = [
          `Name: ${fd.get("name")}`,
          `Phone: ${fd.get("phone")}`,
          `Check-in: ${fd.get("checkin")}`,
          `Nights: ${fd.get("nights")}`,
          `Room: ${fd.get("room")}`,
          `Notes: ${fd.get("notes") || "None"}`,
        ].join("\n");
        const ev = new CustomEvent("mm:enquiry", {
          cancelable: true,
          detail: { to: "burfordlodge30@aol.com", subject, body, phone: "028 4484 1141", phoneHref: "tel:+442844841141" },
        });
        if (window.dispatchEvent(ev)) {
          window.location.href = `mailto:burfordlodge30@aol.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }
      });
    })();
  </script>
</ConceptLayout>
