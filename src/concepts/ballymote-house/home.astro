---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import ResponsiveImage from "../../site/components/ResponsiveImage.astro";

/* Ballymote House — 84 Killough Road, Downpatrick, Co. Down, BT30 8BJ.
   Sources (live-fetched 26 Nov 2026): ballymotehouse.com (/, /about-ballymote-country-house/,
   /how-to-find-us/, /sleep-2/).
   - Built around 1730; Georgian country-house B&B in County Down between Lecale,
     the Mountains of Mourne and Strangford Lough.
   - Described by well-travelled guests as "a mini Ballymaloe".
   - Features named guest rooms including The Curtis Room (named after its
     1830s botanical illustrations), open fires, informal country-house dining.
   - Live Freetobook direct booking engine (w_id=39831).
   - Contact: +44 (0) 28 4461 5500 · Mobile +44 (0) 7831 661429 · bandb@ballymotehouse.com.
   Brief: research/concepts/ballymote-house/ballymote-house-elevation-brief.md */

const landline = "028 4461 5500";
const landlineHref = "tel:+442844615500";
const mobile = "07831 661429";
const mobileHref = "tel:+447831661429";
const email = "bandb@ballymotehouse.com";
const freetobookUrl =
  "https://portal.freetobook.com/reservations?w_id=39831&w_tkn=hMDoO4Pa5craTZh1TZkPpwNnBIqUBLOMYK0kspIOApAZLNkGl2NdDlGwwThjS";
const facebook = "https://www.facebook.com/Ballymotehouse/";
const tripadvisor =
  "http://www.tripadvisor.co.uk/Hotel_Review-g186477-d1576523-Reviews-Ballymote_Country_House-Downpatrick_County_Down_Northern_Ireland.html";
const mapHref = "https://www.google.com/maps/search/?api=1&query=84+Killough+Road+Downpatrick+BT30+8BJ";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Lato:wght@400;700&display=swap";

const pillars = [
  {
    roman: "I",
    title: "Relax",
    copy: "Built around 1730 and set quietly along the Killough Road — roaring fires after a day on the coast and unhurried conversation with fellow travellers.",
  },
  {
    roman: "II",
    title: "Sleep",
    copy: "Characterful Georgian bedrooms including The Curtis Room, named for the original 1830s botanical prints still lining its walls.",
  },
  {
    roman: "III",
    title: "Eat",
    copy: "Informal, effortless country-house hospitality — recently called “a mini Ballymaloe” by well-travelled guests.",
  },
];

const outings = [
  "Golf across County Down",
  "Mourne & coastal walking",
  "St Patrick's Country & heritage",
  "Historic gardens",
  "Strangford Lough sailing",
  "Bird watching & wildlife",
  "Horse riding",
  "Local fishing & motorsport",
];
---

<ConceptLayout
  title="Ballymote House — 1730 Georgian Country House B&B, Downpatrick"
  slug="ballymote-house"
  bodyClass="concept-page concept-ballymote"
  lang="en-GB"
  businessName="Ballymote House"
  town="Downpatrick"
  fontHref={fontHref}
  bannerNote="The 1730 Georgian country-house exterior and morning breakfast table are AI-generated visualisations. Direct availability hands straight to Ballymote House's live Freetobook portal; enquiries compose an email to bandb@ballymotehouse.com."
>
  <header class="bm-header">
    <div class="bm-wrap bm-header-inner">
      <div class="bm-header-side">
        <span>84 Killough Road · Downpatrick · BT30 8BJ</span>
      </div>
      <a class="bm-monogram" href="#top">
        <span class="bm-est">EST. c. 1730</span>
        <strong>Ballymote House</strong>
      </a>
      <div class="bm-header-side bm-header-side--right">
        <a href={landlineHref}>{landline}</a>
        <a class="bm-header-book" href={freetobookUrl} rel="noopener noreferrer">Book Direct ↗</a>
      </div>
    </div>
  </header>

  <main id="top" class="bm-main">
    <section class="bm-album-hero" aria-labelledby="bm-hero-title">
      <div class="bm-wrap">
        <div class="bm-hero-plate-wrap">
          <figure class="bm-hero-plate">
            <ResponsiveImage
              src="/media/concepts/ballymote-house/ballymote-house-georgian-facade.jpg"
              alt="Golden-hour view of an 18th-century Irish Georgian stone country house with tall sash windows and walled-garden lawn"
              width={1376}
              height={768}
              loading="eager"
              sizes="(max-width: 1200px) 100vw, 1140px"
              class="bm-hero-img"
            />
            <figcaption>18th-century County Down country-house atmosphere. Visualisation (AI-generated).</figcaption>
          </figure>
        </div>

        <div class="bm-hero-editorial">
          <div class="bm-hero-left">
            <p class="bm-kicker">Lecale · Mountains of Mourne · Strangford Lough</p>
            <h1 id="bm-hero-title">Timeless country-house hospitality, <em>built around 1730.</em></h1>
          </div>
          <div class="bm-hero-right">
            <p class="bm-lede">
              Called <em>“a mini Ballymaloe”</em> by well-travelled guests — a
              gracious County Down Georgian house where everyday cares slip
              away beside a roaring fire, minutes from Downpatrick and the
              shores of Strangford Lough.
            </p>
            <div class="bm-hero-actions">
              <a class="bm-btn bm-btn--olive" href={freetobookUrl} rel="noopener noreferrer">Check live dates on Freetobook ↗</a>
              <a class="bm-btn bm-btn--outline" href="#enquire">Write to your hosts</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bm-triptych" id="house" aria-labelledby="bm-house-title">
      <div class="bm-wrap">
        <p class="bm-kicker bm-kicker--center">The House Tradition</p>
        <h2 class="bm-section-title" id="bm-house-title">Relax. Sleep. Eat.</h2>

        <div class="bm-pillar-grid">
          {pillars.map((p) => (
            <article class="bm-pillar">
              <span class="bm-roman">{p.roman}</span>
              <h3>{p.title}</h3>
              <p>{p.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bm-breakfast" id="curtis" aria-labelledby="bm-curtis-title">
      <div class="bm-wrap bm-breakfast-grid">
        <figure class="bm-table-plate">
          <ResponsiveImage
            src="/media/concepts/ballymote-house/ballymote-house-morning-table.jpg"
            alt="Sunlit Georgian breakfast table with ivory linen, floral china teapot, berries and Irish wheaten bread beside a sash window"
            width={1200}
            height={896}
            sizes="(max-width: 960px) 100vw, 48vw"
            class="bm-table-img"
          />
          <figcaption>Georgian morning table &amp; garden light feel. Visualisation (AI-generated).</figcaption>
        </figure>

        <div class="bm-breakfast-copy">
          <p class="bm-kicker">The Curtis Room &amp; Around Lecale</p>
          <h2 id="bm-curtis-title">1830s botanical prints upstairs, St Patrick's Country out the gate.</h2>
          <p>
            Every detail at Ballymote carries quiet history — from The Curtis
            Room's original 1830s botanical studies to evenings spent sharing
            stories of Lecale, the Mourne peaks and Strangford Lough around the
            fire.
          </p>

          <div class="bm-compass">
            <h3>Things to do from the door</h3>
            <ul>
              {outings.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          <div class="bm-inline-links">
            <a href={freetobookUrl} rel="noopener noreferrer">Reserve directly online ↗</a>
            <a href={tripadvisor} rel="noopener noreferrer">Guest reviews on TripAdvisor ↗</a>
          </div>
        </div>
      </div>
    </section>

    <section class="bm-enquire" id="enquire" aria-labelledby="bm-enquire-title">
      <div class="bm-wrap bm-enquire-grid">
        <div class="bm-enquire-copy">
          <p class="bm-kicker">Direct Booking &amp; Host Desk</p>
          <h2 id="bm-enquire-title">Book directly with Ballymote House — or ask about your dates.</h2>
          <p>
            Check live room availability immediately through our{" "}
            <a href={freetobookUrl} rel="noopener noreferrer">Freetobook direct portal ↗</a>,
            or send a personal note straight to{" "}
            <a href={`mailto:${email}`}>{email}</a>.
          </p>
          <dl class="bm-contact-dl">
            <div><dt>Address</dt><dd>84 Killough Road, Downpatrick, Co. Down, BT30 8BJ</dd></div>
            <div><dt>Telephone</dt><dd><a href={landlineHref}>+44 (0) 28 4461 5500</a> · Mobile <a href={mobileHref}>+44 (0) 7831 661429</a></dd></div>
            <div><dt>Directions</dt><dd><a href={mapHref} rel="noopener noreferrer">Open Google Maps ↗</a> · <a href={facebook} rel="noopener noreferrer">Facebook ↗</a></dd></div>
          </dl>
        </div>

        <form class="bm-form" id="bm-form" data-email={email}>
          <div class="bm-row">
            <label>
              <span>Preferred arrival</span>
              <input type="date" name="arrival" required />
            </label>
            <label>
              <span>Nights &amp; guests</span>
              <input name="stay" placeholder="e.g. 2 nights, 2 guests" />
            </label>
          </div>
          <div class="bm-row">
            <label>
              <span>Your name</span>
              <input name="name" autocomplete="name" required />
            </label>
            <label>
              <span>Phone number</span>
              <input name="phone" type="tel" autocomplete="tel" />
            </label>
          </div>
          <label>
            <span>Room preference or notes (optional)</span>
            <textarea name="notes" rows="2" placeholder="e.g. The Curtis Room, dietary requests, golf or walking trip"></textarea>
          </label>
          <button class="bm-btn bm-btn--olive bm-btn--full" type="submit">Compose enquiry email →</button>
        </form>
      </div>
    </section>
  </main>

  <footer class="bm-footer">
    <div class="bm-wrap bm-footer-inner">
      <span><strong>Ballymote House</strong> · 84 Killough Road, Downpatrick, Co. Down, BT30 8BJ</span>
      <span><a href={landlineHref}>{landline}</a> · <a href={mobileHref}>{mobile}</a> · <a href={`mailto:${email}`}>{email}</a></span>
    </div>
  </footer>

  <script>
    const form = document.getElementById("bm-form") as HTMLFormElement | null;
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const d = new FormData(form);
      const body = [
        `Arrival: ${d.get("arrival") || ""}`,
        `Nights & guests: ${d.get("stay") || ""}`,
        `Name: ${d.get("name") || ""}`,
        `Phone: ${d.get("phone") || ""}`,
        "",
        String(d.get("notes") || ""),
      ].join("\n");
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent("Stay Enquiry — Ballymote House, Downpatrick")}&body=${encodeURIComponent(body)}`;
    });
  </script>
</ConceptLayout>
