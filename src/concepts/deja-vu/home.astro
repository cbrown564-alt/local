---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

/* Deja Vu / Deja Vu Hair Co. — relief: a L’Oréal Professionnel chair
   at 33 Central Promenade. Speak as the salon.
   Ring to book. No Timely (Central Hair is a different door).
   Hours omitted — directories disagree; L’Oréal openingHours empty
   (14 Sep 2026). Facebook unread — omit. No form. */

const phone = "028 4372 2110";
const phoneHref = "tel:+442843722110";
const loreal =
  "https://hair-salon-en.lorealprofessionnel.com/220655-deja-vu";
const maps =
  "https://www.google.com/maps/search/?api=1&query=33+Central+Promenade+Newcastle+BT33+0AA";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Outfit:wght@400;500;600;700;800&display=swap";

const stock = [
  {
    code: "01",
    title: "Cut",
    body: "Shape, length, and a finish that holds in sea air. Tell us how you wear it on the promenade and we cut to that.",
  },
  {
    code: "02",
    title: "Colour",
    body: "From a tidy root through to a full change — L’Oréal Professionnel colour mixed for the chair at 33.",
  },
  {
    code: "03",
    title: "Care",
    body: "Treatments and styling when the hair needs looking after, not just a trim. Ask when you ring.",
  },
];
---

<ConceptLayout
  title={"Deja Vu — independent concept"}
  slug="deja-vu"
  bodyClass="concept-page concept-deja-vu"
  lang="en-GB"
  businessName="Deja Vu"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="AI-generated illustrations imagine the salon and setting; they are not photographs of the business."
>
  <div class="dv-strip">
    <span>33 Central Promenade, Newcastle · BT33 0AA · L’Oréal Professionnel</span>
    <span class="dv-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="dv-header">
    <div class="dv-header-inner">
      <a class="dv-brand" href="/concepts/deja-vu/">
        <span class="dv-brand-name">Deja Vu</span>
        <span class="dv-brand-sub">33 Central Promenade · Newcastle</span>
      </a>
      <nav class="dv-nav" aria-label="Concept navigation">
        <a href="#chair">The chair</a>
        <a href="#colour">Colour</a>
        <a href="#door">Find 33</a>
      </nav>
      <a class="dv-ring-nav" href={phoneHref}>Ring {phone}</a>
    </div>
  </header>

  <main class="dv-main">
    <section class="dv-hero" aria-labelledby="dv-name">
      <div class="dv-mast-copy">
        <p class="dv-kicker">Hair salon · Central Promenade</p>
        <h1 id="dv-name">Deja Vu</h1>
        <p class="dv-number">33 Central Promenade · Newcastle</p>
        <p class="dv-say">Cuts, colour, care on the promenade.</p>
        <p class="dv-lede">
          A L’Oréal Professionnel chair at 33. Come off the seafront, take
          a seat, leave sorted. Ring to book.
        </p>
        <div class="dv-hero-actions">
          <a class="dv-btn-primary" href={phoneHref}>Ring to book: {phone}</a>
          <a class="dv-btn-secondary" href="#door">Find 33 Promenade</a>
        </div>
      </div>

      <figure class="dv-theatre">
        <img
          src="/media/concepts/deja-vu/deja-vu-hero-promenade.jpg"
          alt="Deja Vu boutique hair salon shopfront at 33 Central Promenade overlooking the sea"
          width="1200"
          height="675"
          loading="eager"
        />
        <figcaption>33 Central Promenade · L’Oréal Professionnel salon on Newcastle promenade</figcaption>
      </figure>
    </section>

    <section class="dv-folio" id="chair" aria-labelledby="dv-chair-title">
      <div class="dv-folio-head">
        <p class="dv-kicker">The chair</p>
        <h2 id="dv-chair-title">Come off the prom. Take the chair.</h2>
        <p class="dv-lead">
          We cut, colour, and care for hair at 33 Central Promenade — a
          L’Oréal Professionnel salon on Newcastle’s seafront. What is free today lives on the phone. Ring us, tell us what you want from the chair, and we will sort a time.
        </p>
        <p class="dv-hand">
          <a href={phoneHref}>Ring {phone}</a>
          <span aria-hidden="true">·</span>
          <a href={loreal} rel="noopener noreferrer">L’Oréal Professionnel locator →</a>
        </p>
      </div>
    </section>

    <section class="dv-stock" id="colour" aria-labelledby="dv-stock-title">
      <div class="dv-stock-head">
        <p class="dv-kicker">In the chair</p>
        <h2 id="dv-stock-title">Cut. Colour. Care.</h2>
        <p class="dv-stock-lead">
          Three ways we look after hair at 33 — L’Oréal Professionnel in
          the salon, your brief on the phone.
        </p>
      </div>
      <div class="dv-stock-grid">
        {stock.map((s) => (
          <article class="dv-stock-card">
            <span class="dv-stock-code">{s.code}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <a class="dv-stock-link" href={phoneHref}>Ring about {s.title} →</a>
          </article>
        ))}
      </div>
    </section>

    <section class="dv-door-section" id="door" aria-labelledby="dv-door-title">
      <div class="dv-door-card">
        <p class="dv-kicker">The door</p>
        <h2 id="dv-door-title">33 Central Promenade.</h2>
        <p class="dv-door-desc">
          On Newcastle's Central Promenade. Ring directly to speak to the salon and book your appointment.
        </p>

        <div class="dv-door-actions">
          <a class="dv-door-btn dv-door-btn--tel" href={phoneHref}>
            <span class="dv-door-label">Telephone</span>
            <span class="dv-door-val">Ring {phone} →</span>
          </a>
          <a class="dv-door-btn" href={maps} rel="noopener noreferrer">
            <span class="dv-door-label">Directions</span>
            <span class="dv-door-val">Open in Google Maps →</span>
          </a>
          <a class="dv-door-btn" href={loreal} rel="noopener noreferrer">
            <span class="dv-door-label">Salon Locator</span>
            <span class="dv-door-val">L'Oréal Professionnel →</span>
          </a>
        </div>

        <address class="dv-address">
          <strong>Deja Vu</strong>
          <span>33 Central Promenade</span>
          <span>Newcastle, Co. Down · BT33 0AA</span>
          <a href={phoneHref}>{phone}</a>
        </address>
      </div>
    </section>
  </main>
</ConceptLayout>
