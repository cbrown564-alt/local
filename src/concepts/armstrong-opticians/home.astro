---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

const phone = "028 4372 2991";
const phoneHref = "tel:+442843722991";
const hearing = "028 4064 8306";
const hearingHref = "tel:+442840648306";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Manrope:wght@400;500;700;800&display=swap";
---

<ConceptLayout
  title={"Armstrong Opticians — Newcastle"}
  slug="armstrong-opticians"
  bodyClass="concept-page concept-armstrong"
  businessName="Armstrong Opticians"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The calm plate is a generated image, not a photograph of the practice."
>
  <main class="ao-page">
    <aside class="ao-emergency" id="urgent">
      <p>
        <strong>Sudden loss of vision:</strong>
        go to A&amp;E, or call <a href="tel:111">111</a>.
        Do not wait on a form.
      </p>
    </aside>

    <section class="ao-first" aria-labelledby="ao-name">
      <p class="ao-soon">Can they see us, and soon?</p>
      <h1 id="ao-name">Armstrong Opticians</h1>
      <p class="ao-reassure">
        30 Railway Street, Newcastle, BT33 0AL. Eyes and hearing share the
        building. Hours are not listed — ring and ask. The diary is on the
        phone, not on this page.
      </p>
      <ul class="ao-two">
        <li>
          <span>Eyes</span>
          <strong>Armstrong Opticians</strong>
          <a href={phoneHref}>{phone}</a>
        </li>
        <li>
          <span>Hearing</span>
          <strong>The Hearing Care Partnership</strong>
          <a href={hearingHref}>{hearing}</a>
        </li>
      </ul>
    </section>

    <figure class="ao-calm">
      <img
        src="/media/concepts/armstrong-opticians/calm.jpg"
        alt="Generated image of a calm waiting room with a soft safety-net feel — not a photograph of Armstrong Opticians"
        width="1536"
        height="1024"
      />
      <figcaption>Generated image — a calm safety net. Not a photograph of the practice.</figcaption>
    </figure>

    <section class="ao-desk" id="desk" aria-labelledby="ao-desk-title">
      <p class="ao-kicker">Who needs seen, and when</p>
      <h2 id="ao-desk-title">Prepare the call.</h2>
      <p>
        Write who needs seen and when. Then ring. Nothing is sent from this page.
        If it is an emergency, use the red line at the top — not this form.
      </p>
      <form class="ao-script" data-ao-script>
        <fieldset>
          <legend>Which door</legend>
          <label><input type="radio" name="ao-door" value="eyes" checked /> Eyes — Armstrong Opticians</label>
          <label><input type="radio" name="ao-door" value="hearing" /> Hearing — The Hearing Care Partnership</label>
        </fieldset>
        <label>
          <span>Who needs seen</span>
          <input name="who" type="text" required />
        </label>
        <label>
          <span>When you hope to come</span>
          <input name="when" type="text" placeholder="This week if you can" required />
        </label>
        <label>
          <span>A number they can return</span>
          <input name="tel" type="tel" autocomplete="tel" required />
        </label>
        <button type="submit">Write the script</button>
      </form>
      <div class="ao-ready" data-ao-ready hidden tabindex="-1">
        <p data-ao-ready-script></p>
        <a data-ao-ready-call href={phoneHref}>Call</a>
      </div>
    </section>

    <p class="ao-foot">
      Hours are not listed. Ring {phone} for eyes, or {hearing} for hearing.
    </p>
  </main>

  <script is:inline>
    (function () {
      var practiceHref = "tel:+442843722991";
      var hearingHref = "tel:+442840648306";
      var practice = "028 4372 2991";
      var hearing = "028 4064 8306";
      var form = document.querySelector("[data-ao-script]");
      var ready = document.querySelector("[data-ao-ready]");
      var scriptEl = document.querySelector("[data-ao-ready-script]");
      var callEl = document.querySelector("[data-ao-ready-call]");
      if (!form || !ready || !scriptEl || !callEl) return;

      form.addEventListener("submit", function (event) {
        event.preventDefault();
        if (!form.reportValidity()) return;
        var door = form.querySelector('input[name="ao-door"]:checked').value;
        var who = form.elements.namedItem("who").value.trim();
        var when = form.elements.namedItem("when").value.trim();
        var tel = form.elements.namedItem("tel").value.trim();
        if (door === "hearing") {
          scriptEl.textContent =
            "Ring " + hearing + ". Ask for The Hearing Care Partnership. " +
            who + " needs seen " + when + ". You can return on " + tel + ".";
          callEl.href = hearingHref;
          callEl.textContent = "Call " + hearing;
        } else {
          scriptEl.textContent =
            "Ring " + practice + ". Ask for Armstrong Opticians. " +
            who + " needs seen " + when + ". You can return on " + tel + ".";
          callEl.href = practiceHref;
          callEl.textContent = "Call " + practice;
        }
        ready.hidden = false;
        ready.focus();
      });
    })();
  </script>
</ConceptLayout>
