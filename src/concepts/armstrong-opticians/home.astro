---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

const phone = "028 4372 2991";
const phoneHref = "tel:+442843722991";
---

<ConceptLayout
  title={"Armstrong Opticians — independent concept"}
  slug="armstrong-opticians"
  bodyClass="concept-page concept-armstrong"
  businessName="Armstrong Opticians"
  town="Newcastle"
>
  <header class="ao-header">
    <a class="ao-brand" href="/concepts/armstrong-opticians/">
      <span class="ao-name">Armstrong Opticians</span>
      <span class="ao-sub">30 Railway Street · Newcastle</span>
    </a>
    <a class="ao-phone" href={phoneHref}>{phone}</a>
  </header>
  <main class="ao-main">
    <p class="ao-eyebrow">The practice door, without Facebook</p>
    <h1>Your eyes, on Railway Street.</h1>
    <p class="ao-lead">
      Armstrong Opticians is the practice at 30 Railway Street. Ring the shop
      to book a sight test or ask about an appointment. We have not put a
      diary or hours on this page.
    </p>
    <p class="ao-cta">
      <a class="ao-btn" href={phoneHref}>Call {phone}</a>
      <a class="ao-btn ao-btn--ghost" href="#urgent">If it cannot wait</a>
    </p>
    <section class="ao-find">
      <h2>The practice</h2>
      <p>30 Railway Street, Newcastle, BT33 0AL</p>
      <p>Armstrongs &amp; Armstrong Ltd, company NI611430.</p>
    </section>
    <section class="ao-urgent" id="urgent">
      <h2>If it cannot wait</h2>
      <p>Ring the practice first on <a href={phoneHref}>{phone}</a>.</p>
      <p>If the practice cannot help and you have a sudden loss of vision, go to A&amp;E or call 111.</p>
    </section>
  </main>
</ConceptLayout>
