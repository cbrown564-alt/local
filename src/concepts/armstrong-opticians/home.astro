---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

const phone = "028 4372 2991";
const phoneHref = "tel:+442843722991";
const hearing = "028 4064 8306";
const hearingHref = "tel:+442840648306";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Manrope:wght@400;500;700;800&display=swap";
---

<ConceptLayout
  title={"Armstrong Opticians — independent concept"}
  slug="armstrong-opticians"
  bodyClass="concept-page concept-armstrong"
  businessName="Armstrong Opticians"
  town="Newcastle"
  fontHref={fontHref}
>
  <main class="ao-main">
    <p class="ao-wayfind">
      Armstrong Opticians · 30 Railway Street, Newcastle, BT33 0AL
    </p>

    <section class="ao-doors" aria-label="Choose a door">
      <button
        class="ao-door ao-door--eyes"
        type="button"
        data-ao-door="eyes"
        aria-pressed="false"
      >
        <span class="ao-door-kicker">The practice</span>
        <span class="ao-door-word">Eyes</span>
        <span class="ao-door-who">Armstrong Opticians</span>
        <span class="ao-door-num">{phone}</span>
        <span class="ao-door-hint">Open this door</span>
      </button>

      <span class="ao-hinge" aria-hidden="true"></span>

      <button
        class="ao-door ao-door--hear"
        type="button"
        data-ao-door="hearing"
        aria-pressed="false"
      >
        <span class="ao-door-kicker">Partner in the building</span>
        <span class="ao-door-word">Hearing</span>
        <span class="ao-door-who">The Hearing Care Partnership</span>
        <span class="ao-door-num">{hearing}</span>
        <span class="ao-door-hint">Open this door</span>
      </button>
    </section>

    <section class="ao-desk" id="desk" data-ao-desk hidden>
      <p class="ao-desk-label">Prepare a call</p>
      <p class="ao-desk-line" data-ao-desk-line></p>
      <form class="ao-script" data-ao-script>
        <label class="ao-script-field">
          <span>Your name</span>
          <input name="name" type="text" autocomplete="name" required />
        </label>
        <label class="ao-script-field">
          <span>A number they can return</span>
          <input name="tel" type="tel" autocomplete="tel" required />
        </label>
        <button class="ao-script-go" type="submit">Write the script</button>
      </form>
      <div class="ao-ready" data-ao-ready hidden tabindex="-1">
        <p data-ao-ready-script></p>
        <a data-ao-ready-call href={phoneHref}>Call</a>
      </div>
    </section>

    <ol class="ao-spine" aria-label="The name on the door">
      <li>
        <time datetime="2012">2012</time>
        <span>Armstrongs &amp; Armstrong Ltd is formed. This shop is the registered office.</span>
      </li>
      <li>
        <time datetime="2014">2014</time>
        <span>Ben Armstrong is appointed a director.</span>
      </li>
      <li>
        <time datetime="2019">2019</time>
        <span>Ben remains the live director. The name on the door is still Armstrong Opticians.</span>
      </li>
    </ol>

    <aside class="ao-safety" id="urgent">
      Sudden loss of vision: A&amp;E or 111. Anything else that cannot wait —
      the practice line first, <a href={phoneHref}>{phone}</a>.
    </aside>

    <p class="ao-foot">
      30 Railway Street, Newcastle, BT33 0AL. Hours are not listed — ring and ask.
      No other website is linked from here.
    </p>
  </main>

  <script is:inline>
    (function () {
      var practiceHref = "tel:+442843722991";
      var hearingHref = "tel:+442840648306";
      var practice = "028 4372 2991";
      var hearing = "028 4064 8306";
      var doors = document.querySelectorAll("[data-ao-door]");
      var desk = document.querySelector("[data-ao-desk]");
      var line = document.querySelector("[data-ao-desk-line]");
      var form = document.querySelector("[data-ao-script]");
      var ready = document.querySelector("[data-ao-ready]");
      var scriptEl = document.querySelector("[data-ao-ready-script]");
      var callEl = document.querySelector("[data-ao-ready-call]");
      if (!desk || !line || !form || !ready || !scriptEl || !callEl) return;

      var pick = null;

      function setPick(which) {
        pick = which;
        doors.forEach(function (btn) {
          var on = btn.getAttribute("data-ao-door") === which;
          btn.setAttribute("aria-pressed", on ? "true" : "false");
          btn.classList.toggle("is-open", on);
        });
        desk.hidden = false;
        ready.hidden = true;
        if (which === "hearing") {
          line.textContent =
            "Hearing is The Hearing Care Partnership. Their number is " +
            hearing +
            ". Nothing is sent from this page.";
        } else {
          line.textContent =
            "Eyes is the practice. Their number is " +
            practice +
            ". Nothing is sent from this page.";
        }
        desk.scrollIntoView({ block: "nearest", behavior: "smooth" });
      }

      doors.forEach(function (btn) {
        btn.addEventListener("click", function () {
          setPick(btn.getAttribute("data-ao-door"));
        });
      });

      form.addEventListener("submit", function (event) {
        event.preventDefault();
        if (!pick) return;
        if (!form.reportValidity()) return;
        var name = form.elements.namedItem("name").value.trim();
        var tel = form.elements.namedItem("tel").value.trim();
        if (pick === "hearing") {
          scriptEl.textContent =
            "Ring " +
            hearing +
            ". Ask for The Hearing Care Partnership. Say you are " +
            name +
            ", and they can return you on " +
            tel +
            ".";
          callEl.href = hearingHref;
          callEl.textContent = "Call " + hearing;
        } else {
          scriptEl.textContent =
            "Ring " +
            practice +
            ". Ask for Ben, or for whoever answers. Say you are " +
            name +
            ", you need eyes, and they can return you on " +
            tel +
            ".";
          callEl.href = practiceHref;
          callEl.textContent = "Call " + practice;
        }
        ready.hidden = false;
        ready.focus();
      });
    })();
  </script>
</ConceptLayout>
