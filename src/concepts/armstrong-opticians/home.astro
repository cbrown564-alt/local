---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";

const phone = "028 4372 2991";
const phoneHref = "tel:+442843722991";
const hearing = "028 4064 8306";
const hearingHref = "tel:+442840648306";
const fontHref =
  "https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Manrope:wght@400;600;700&display=swap";
---

<ConceptLayout
  title={"Armstrong Opticians — independent concept"}
  slug="armstrong-opticians"
  bodyClass="concept-page concept-armstrong"
  businessName="Armstrong Opticians"
  town="Newcastle"
  fontHref={fontHref}
>
  <header class="ao-header">
    <a class="ao-brand" href="/concepts/armstrong-opticians/">
      <span class="ao-name">Armstrong Opticians</span>
      <span class="ao-sub">30 Railway Street · Newcastle</span>
    </a>
    <nav class="ao-nav">
      <a href="#practice">The practice</a>
      <a href="#hearing">Hearing</a>
      <a href="#urgent">If it cannot wait</a>
    </nav>
    <a class="ao-phone" href={phoneHref}>{phone}</a>
  </header>

  <main class="ao-main">
    <section class="ao-hero">
      <p class="ao-eyebrow">Independent practice · Railway Street</p>
      <h1>Your eyes, on the same street, under the same name.</h1>
      <p class="ao-lead">
        Armstrong Opticians is the practice at 30 Railway Street. Ring us for
        a sight test. Hearing in this building is with our partner — a
        different number, so you reach the right person first time.
      </p>
      <p class="ao-cta">
        <a class="ao-btn" href={phoneHref}>Call the practice {phone}</a>
        <a class="ao-btn ao-btn--ghost" href="#hearing">Hearing is a partner</a>
      </p>
    </section>

    <section class="ao-arc" id="practice">
      <p class="ao-eyebrow">The name on the door</p>
      <h2>Armstrongs &amp; Armstrong, since 2012. Ben since 2019.</h2>
      <ol>
        <li><span>2012</span> Armstrongs &amp; Armstrong Ltd is formed. The registered office is this shop.</li>
        <li><span>2014</span> Ben Armstrong is appointed a director.</li>
        <li><span>2019</span> Margaret Elaine and Stephen Karl step back. Ben remains the live director.</li>
        <li><span>Today</span> One practice on Railway Street. One number for eyes. A partner number for hearing.</li>
      </ol>
    </section>

    <section class="ao-split">
      <article>
        <h3>Eyes</h3>
        <p>Sight tests and the optical work of the practice. Call {phone}.</p>
        <a class="ao-btn" href={phoneHref}>Call the practice</a>
      </article>
      <article id="hearing">
        <h3>Hearing</h3>
        <p>
          Hearing care in this building is The Hearing Care Partnership —
          assessments, aids, wax, tinnitus. Book them on {hearing}, not on
          the practice line.
        </p>
        <a class="ao-btn ao-btn--ghost" href={hearingHref}>Call the hearing partner</a>
      </article>
    </section>

    <section class="ao-urgent" id="urgent">
      <h2>If it cannot wait</h2>
      <p>Ring the practice first on <a href={phoneHref}>{phone}</a>.</p>
      <p>Sudden loss of vision: A&amp;E, or 111.</p>
      <p class="ao-note">30 Railway Street, Newcastle, BT33 0AL. We have not published hours we do not confirm.</p>
    </section>
  </main>
</ConceptLayout>
