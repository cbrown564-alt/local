---
/**
 * Armstrong Opticians — bespoke spectacles / lens line mark.
 * Sourced to the independent eyewear craft and 1983 practice heritage.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className = "" } = Astro.props;
---

<svg
  class:list={["ao-mark", className]}
  width={size}
  height={Math.round(size * 0.7)}
  viewBox="0 0 44 30"
  fill="none"
  aria-hidden="true"
>
  <!-- Left circular lens frame -->
  <circle
    cx="12"
    cy="16"
    r="9"
    stroke="currentColor"
    stroke-width="2.2"
  />
  <!-- Right circular lens frame -->
  <circle
    cx="32"
    cy="16"
    r="9"
    stroke="currentColor"
    stroke-width="2.2"
  />
  <!-- Elegant arched bridge -->
  <path
    d="M21 13.5C22 11 23 11 24 13.5"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
  />
  <!-- Left temple lug -->
  <path
    d="M3 13.5H4"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
  />
  <!-- Right temple lug -->
  <path
    d="M40 13.5H41"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
  />
</svg>

<style>
  .ao-mark {
    display: inline-block;
    vertical-align: middle;
    color: currentColor;
    flex-shrink: 0;
  }
</style>
