---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import "./styles.css";

/* Denvir's Coaching Inn — 14–16 English Street, Downpatrick BT30 6AB.
   Verified live 26 Nov 2026: denvirs.com (Ireland's oldest surviving coaching inn, 1642, Grade A listed).
   Currently opens with TermsFeed cookie banner copy above hero and leaks agency email.
   6 restored bedrooms & family apartments, 17th-century hearth snug, daily restaurant & Sunday roasts.
   028 4461 2012, info@denvirs.com. */
const phone = "028 4461 2012";
const phoneHref = "tel:+442844612012";
const email = "info@denvirs.com";
const fbHref = "https://www.facebook.com/denvirscoachinginn/";
const igHref = "https://www.instagram.com/denvirscoachinginn/";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Denvirs+Coaching+Inn+14+English+Street+Downpatrick+BT30+6AB";

const innGroups = [
  {
    id: "dining",
    label: "Kitchen & Hearth Snug",
    items: [
      { name: "Famous Sunday Roasts", note: "Locally sourced roasts served weekly beside the historic coaching-inn dining room", meta: "Sundays" },
      { name: "All-Day Kitchen", note: "Relaxed breakfasts, hearty lunches, seafood risotto, comforting pies & seared steaks", meta: "Cooked to order" },
      { name: "17th-Century Hearth Snug", note: "Open turf & log fire, traditional lounge and carefully selected drinks list", meta: "Est. 1642" },
    ],
  },
  {
    id: "rooms",
    label: "Six Restored Rooms",
    items: [
      { name: "Character Boutique Bedrooms", note: "Grade A listed coaching-inn rooms pairing original timber beams with modern en-suites", meta: "6 Rooms" },
      { name: "Family Apartments", note: "Spacious stays right on English Street beside Down Cathedral & St Patrick Centre", meta: "Heart of Downpatrick" },
    ],
  },
];
---

<ConceptLayout
  title="Denvir's Coaching Inn — Est. 1642, English Street, Downpatrick"
  slug="denvirs-downpatrick"
  bodyClass="concept-page concept-denvirs"
  businessName="Denvir's Coaching Inn"
  town="Downpatrick"
  bannerNote="Imagery comprises indicative 17th-century hearth snug and restored coaching-inn bedroom visualisations."
>
  <header class="dv-header">
    <div class="dv-header-inner">
      <a class="dv-brand" href="#top">
        <strong>Denvir's</strong>
        <span>Coaching Inn · Est. 1642</span>
      </a>
      <nav class="dv-nav" aria-label="Primary">
        <a href="#heritage">1642 Snug</a>
        <a href="#rooms">Six Rooms</a>
        <a href="#enquire">Book Direct</a>
        <a href="#location">English Street</a>
      </nav>
      <div class="dv-header-actions">
        <a class="dv-header-tel" href={phoneHref}>{phone}</a>
        <a class="dv-header-cta" href="#enquire">Enquire</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="dv-hero" aria-labelledby="dv-hero-title">
      <div class="dv-wrap">
        <div class="dv-folio-bar">
          <span>Est. 1642 · Grade A Listed</span>
          <span>Ireland's Oldest Surviving Coaching Inn</span>
          <span>14–16 English Street, Downpatrick</span>
        </div>

        <div class="dv-hero-top">
          <h1 id="dv-hero-title">Warm at the hearth since 1642.</h1>
          <div class="dv-hero-side">
            <p class="dv-hero-lead">
              Six restored bedrooms above a 17th-century open fire, daily County Down cooking,
              and Sunday roasts steps from Down Cathedral.
            </p>
            <div class="dv-hero-actions">
              <a class="dv-btn dv-btn--primary" href="#enquire">Book a Stay or Table</a>
              <SpecimenSheet
                id="dv-inn-sheet"
                triggerLabel="Rooms & Kitchen Ledger"
                kicker="Denvir's Coaching Inn · Est. 1642"
                title="Hearth Snug, Kitchen & Six Rooms"
                subtitle="14–16 English Street, Downpatrick. Ring 028 4461 2012 or enquire below."
                groups={innGroups}
                ctaLabel="Send Booking Enquiry"
                ctaHref="#enquire"
                secondaryLabel={`Call ${phone}`}
                secondaryHref={phoneHref}
                buttonClass="dv-link-trigger"
              />
            </div>
          </div>
        </div>

        <figure class="dv-hero-media">
          <picture>
            <source srcset="/media/concepts/denvirs-downpatrick/denvirs-hearth-snug-640.webp 640w, /media/concepts/denvirs-downpatrick/denvirs-hearth-snug-1265.webp 1265w" sizes="(max-width: 960px) 100vw, 90vw" type="image/webp" />
            <img src="/media/concepts/denvirs-downpatrick/denvirs-hearth-snug.jpg" alt="Historic 17th-century Irish coaching inn snug bar with roaring open fire, dark timber beams and oak booths" width="1408" height="768" loading="eager" />
          </picture>
          <figcaption class="dv-hero-cap">Indicative 17th-century hearth snug visualisation.</figcaption>
        </figure>
      </div>
    </section>

    <section class="dv-section dv-heritage" id="heritage" aria-labelledby="dv-her-title">
      <div class="dv-wrap dv-three">
        <article>
          <span>1642</span>
          <h2 id="dv-her-title">Nearly four centuries of English Street hospitality.</h2>
          <p>Originally built as a coaching stop between Belfast and Dublin, our Grade A listed inn still centres around its 17th-century open hearth.</p>
        </article>
        <article>
          <span>Dining</span>
          <h3>Breakfasts, Seafood Risotto &amp; Sunday Roasts</h3>
          <p>Every plate is cooked to order with County Down ingredients, from morning coffee through hearty pies, prime steaks and Sunday lunches.</p>
        </article>
        <article>
          <span>Stay</span>
          <h3>Six Restored Boutique Rooms</h3>
          <p>Original dark beams and deep sash windows paired with quiet modern en-suites and family apartments steps from Down Cathedral.</p>
        </article>
      </div>
    </section>

    <section class="dv-section dv-rooms" id="rooms" aria-labelledby="dv-rooms-title">
      <div class="dv-wrap dv-split">
        <figure class="dv-plate">
          <picture>
            <source srcset="/media/concepts/denvirs-downpatrick/denvirs-coaching-bedroom-640.webp 640w, /media/concepts/denvirs-downpatrick/denvirs-coaching-bedroom-1265.webp 1265w" sizes="(max-width: 860px) 100vw, 48vw" type="image/webp" />
            <img src="/media/concepts/denvirs-downpatrick/denvirs-coaching-bedroom.jpg" alt="Restored coaching inn bedroom with exposed timber beams, oatmeal linen and deep oxblood wool throw" width="1408" height="768" loading="lazy" />
          </picture>
          <figcaption>Restored coaching-inn guest room on English Street. Indicative bedroom visualisation.</figcaption>
        </figure>
        <div>
          <p class="dv-kicker">Sleep Above the Snug</p>
          <h2 id="dv-rooms-title">Quiet rooms for Lecale walkers, golfers and heritage breaks.</h2>
          <p>
            Wake in the heart of Downpatrick, two minutes on foot from St Patrick's Grave and Down Cathedral,
            ten minutes from Strangford Lough, and fifteen from Ardglass Golf Club and the Mournes.
          </p>
          <p class="dv-contact-line">
            Direct inn desk: <a href={phoneHref}>{phone}</a> · <a href={`mailto:${email}`}>{email}</a>
          </p>
        </div>
      </div>
    </section>

    <section class="dv-section dv-enquire" id="enquire" aria-labelledby="dv-enq-title">
      <div class="dv-wrap dv-split">
        <div>
          <p class="dv-kicker">Direct Desk · Rooms, Tables &amp; Vouchers</p>
          <h2 id="dv-enq-title">Send your room dates, Sunday table or gift voucher request.</h2>
          <p>
            Whether you are booking one of our six rooms, gathering family for Sunday roast, or ordering a
            Denvir's gift voucher, message the English Street desk directly below.
          </p>
        </div>
        <form class="dv-form" data-dv-form>
          <div class="dv-row">
            <label>
              <span>Your name</span>
              <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
            </label>
            <label>
              <span>Telephone</span>
              <input name="phone" type="tel" required autocomplete="tel" placeholder="028 / 07..." />
            </label>
          </div>
          <div class="dv-row">
            <label>
              <span>Preferred date</span>
              <input name="date" type="date" required />
            </label>
            <label>
              <span>Guests</span>
              <input name="guests" type="number" min="1" max="30" value="2" required />
            </label>
          </div>
          <label>
            <span>Enquiry type</span>
            <select name="kind">
              <option value="Boutique Bedroom / Family Apartment">Boutique Bedroom or Family Apartment</option>
              <option value="Sunday Roast / Dining Table">Sunday Roast or Evening Dining Table</option>
              <option value="Private Function / Celebration">Private Celebration or Group Dining</option>
              <option value="Denvir's Gift Voucher">Denvir's Gift Voucher</option>
            </select>
          </label>
          <label>
            <span>Notes</span>
            <textarea name="notes" rows="3" placeholder="Number of nights, preferred sitting time, or voucher value..."></textarea>
          </label>
          <button class="dv-btn dv-btn--primary" type="submit">Send Enquiry to English Street</button>
        </form>
      </div>
    </section>

    <section class="dv-section dv-map-band" id="location" aria-label="Downpatrick location map">
      <div class="dv-wrap">
        <LocalAreaMap
          id="dv-map"
          kicker="English Street · Historic Downpatrick"
          businessName="Denvir's Coaching Inn"
          address="14–16 English Street, Downpatrick, BT30 6AB"
          lon={-5.7167939}
          lat={54.328649}
          spanKm={18}
          mapHref={mapsHref}
          markers={[
            { name: "Strangford Ferry", lon: -5.5546, lat: 54.3712, note: "15 mins east", side: "r" },
            { name: "Ardglass Coast", lon: -5.6085, lat: 54.2613, note: "12 mins south-east", side: "b" },
            { name: "Killyleagh", lon: -5.6464, lat: 54.3983, note: "10 mins north", side: "t" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="dv-footer">
    <div class="dv-wrap dv-footer-inner">
      <div>
        <strong>Denvir's Coaching Inn</strong>
        <p>14–16 English Street, Downpatrick, Co. Down, BT30 6AB · Est. 1642</p>
      </div>
      <div class="dv-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={fbHref} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
        <a href={igHref} target="_blank" rel="noopener noreferrer">Instagram ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const form = document.querySelector("[data-dv-form]");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        const subject = `Denvir's Enquiry — ${fd.get("kind")} (${fd.get("date")})`;
        const body = [
          `Name: ${fd.get("name")}`,
          `Phone: ${fd.get("phone")}`,
          `Date: ${fd.get("date")}`,
          `Guests: ${fd.get("guests")}`,
          `Type: ${fd.get("kind")}`,
          `Notes: ${fd.get("notes") || "None"}`,
        ].join("\n");
        const ev = new CustomEvent("mm:enquiry", {
          cancelable: true,
          detail: { to: "info@denvirs.com", subject, body, phone: "028 4461 2012", phoneHref: "tel:+442844612012" },
        });
        if (window.dispatchEvent(ev)) {
          window.location.href = `mailto:info@denvirs.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }
      });
    })();
  </script>
</ConceptLayout>
