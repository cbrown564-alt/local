---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import "./styles.css";

/* Denvir's Coaching Inn, 14-16 English Street, Downpatrick BT30 6AB.
   Verified live 26 Nov 2026: denvirs.com (Ireland's oldest surviving coaching inn, 1642, Grade A listed).
   6 restored bedrooms and family apartments, 17th-century hearth snug, daily restaurant and Sunday roasts.
   028 4461 2012, info@denvirs.com. */
const phone = "028 4461 2012";
const phoneHref = "tel:+442844612012";
const email = "info@denvirs.com";
const fbHref = "https://www.facebook.com/denvirscoachinginn/";
const igHref = "https://www.instagram.com/denvirscoachinginn/";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Denvirs+Coaching+Inn+14+English+Street+Downpatrick+BT30+6AB";

const innGroups = [
  {
    id: "dining",
    label: "Kitchen and hearth snug",
    items: [
      { name: "Famous Sunday roasts", note: "Locally sourced roasts served weekly beside the historic coaching-inn dining room", meta: "Sundays" },
      { name: "All-day kitchen", note: "Relaxed breakfasts, hearty lunches, seafood risotto, comforting pies and seared steaks", meta: "Cooked to order" },
      { name: "17th-century hearth snug", note: "Open turf and log fire, traditional lounge and carefully selected drinks list", meta: "Est. 1642" },
    ],
  },
  {
    id: "rooms",
    label: "Six restored rooms",
    items: [
      { name: "Character boutique bedrooms", note: "Grade A listed coaching-inn rooms pairing original timber beams with modern en-suites", meta: "6 rooms" },
      { name: "Family apartments", note: "Spacious stays right on English Street beside Down Cathedral and St Patrick Centre", meta: "Downpatrick" },
    ],
  },
];

const innPanels = [
  {
    id: "snug",
    label: "17th-century snug",
    heading: "An open turf and log fire lit at the heart of Downpatrick since 1642.",
    summary:
      "Originally built as a coaching stop between Belfast and Dublin, Ireland's oldest surviving coaching inn still gathers locals and travellers around its Grade A listed hearth snug.",
    rows: [
      { term: "Heritage", value: "Established 1642, Grade A listed coaching inn" },
      { term: "The lounge", value: "Open turf and log fire with oak booths and warm timber beams" },
      { term: "Drinks list", value: "Carefully selected pours beside the historic bar" },
    ],
  },
  {
    id: "kitchen",
    label: "All-day kitchen",
    heading: "County Down ingredients cooked to order from breakfast through Sunday roast.",
    summary:
      "Every plate leaves the kitchen fresh, from relaxed morning coffee and hearty lunches to seafood risotto, comforting pies, seared steaks and our weekly Sunday roasts.",
    rows: [
      { term: "Daytime dining", value: "Relaxed breakfasts, hearty lunches and freshly brewed coffee" },
      { term: "Evening plates", value: "Seafood risotto, comforting pies and seared steaks" },
      { term: "Sunday roasts", value: "Locally sourced roasts served weekly beside the dining room" },
    ],
  },
  {
    id: "rooms",
    label: "Six restored rooms",
    heading: "Quiet bedrooms and family apartments above the snug on English Street.",
    summary:
      "Six restored Grade A listed rooms pair original dark beams and deep sash windows with calm modern en-suites, two minutes on foot from Down Cathedral and St Patrick's Grave.",
    rows: [
      { term: "Accommodation", value: "Six boutique bedrooms and spacious family apartments" },
      { term: "On your doorstep", value: "Two minutes on foot to Down Cathedral and St Patrick Centre" },
      { term: "Lecale and coast", value: "Ten minutes to Strangford Lough, fifteen to Ardglass Golf Club" },
    ],
  },
];
---

<ConceptLayout
  title="Denvir's Coaching Inn, Est. 1642, English Street, Downpatrick"
  slug="denvirs-downpatrick"
  bodyClass="concept-page concept-denvirs"
  businessName="Denvir's Coaching Inn"
  town="Downpatrick"
  bannerNote="Imagery comprises indicative 17th-century hearth snug and restored coaching-inn bedroom visualisations."
>
  <header class="dv-header" data-dv-header>
    <div class="dv-header-inner">
      <a class="dv-brand" href="#top">Denvir's</a>
      <nav class="dv-nav" aria-label="Primary">
        <a href="#inn" data-dv-jump="snug">Hearth and kitchen</a>
        <a href="#inn" data-dv-jump="rooms">Six rooms</a>
        <a href="#enquire">Book direct</a>
        <a href="#location">English Street</a>
      </nav>
      <div class="dv-header-actions">
        <a class="dv-header-tel" href={phoneHref}>{phone}</a>
        <a class="dv-header-cta" href="#enquire">Enquire</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="dv-hero" aria-labelledby="dv-hero-title">
      <span class="dv-hero-sentinel" data-dv-sentinel aria-hidden="true"></span>
      <div class="dv-hero-media">
        <picture>
          <source
            srcset="/media/concepts/denvirs-downpatrick/denvirs-hearth-snug-640.webp 640w, /media/concepts/denvirs-downpatrick/denvirs-hearth-snug-1265.webp 1265w"
            sizes="100vw"
            type="image/webp"
          />
          <img
            src="/media/concepts/denvirs-downpatrick/denvirs-hearth-snug.jpg"
            alt="Historic 17th-century Irish coaching inn snug bar with roaring open fire, dark timber beams and oak booths"
            width="1408"
            height="768"
            loading="eager"
          />
        </picture>
      </div>
      <div class="dv-hero-scrim" aria-hidden="true"></div>

      <div class="dv-wrap dv-hero-content">
        <div class="dv-hero-copy">
          <h1 id="dv-hero-title">Warm at the hearth since 1642.</h1>
          <p class="dv-hero-lead">
            Six restored bedrooms above a 17th-century open fire, daily County Down cooking, and Sunday roasts beside Down Cathedral.
          </p>
          <a class="dv-btn dv-btn--primary" href="#enquire">Book a stay or table</a>
        </div>
        <div class="dv-hero-foot">
          <p class="dv-hero-caption">Indicative 17th-century hearth snug visualisation.</p>
        </div>
      </div>
    </section>

    <section class="dv-section dv-inn" id="inn" aria-labelledby="dv-inn-title">
      <div class="dv-wrap dv-inn-grid">
        <div class="dv-inn-main" data-dv-tabs>
          <h2 id="dv-inn-title">Nearly four centuries of English Street hospitality.</h2>

          <div class="dv-tabs" role="tablist" aria-label="Explore the snug, kitchen and six rooms">
            {innPanels.map((panel, idx) => (
              <button
                type="button"
                role="tab"
                id={`dv-tab-${panel.id}`}
                aria-controls={`dv-panel-${panel.id}`}
                aria-selected={idx === 0 ? "true" : "false"}
                tabindex={idx === 0 ? 0 : -1}
                class:list={["dv-tab", idx === 0 && "is-active"]}
                data-dv-tab={panel.id}
              >
                {panel.label}
              </button>
            ))}
          </div>

          {innPanels.map((panel, idx) => (
            <div
              class="dv-panel"
              role="tabpanel"
              id={`dv-panel-${panel.id}`}
              aria-labelledby={`dv-tab-${panel.id}`}
              data-dv-panel={panel.id}
              hidden={idx !== 0}
            >
              <h3>{panel.heading}</h3>
              <p>{panel.summary}</p>
              <dl class="dv-ledger">
                {panel.rows.map((row) => (
                  <div class="dv-ledger-row">
                    <dt>{row.term}</dt>
                    <dd>{row.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}

          <div class="dv-sheet-row">
            <SpecimenSheet
              id="dv-inn-sheet"
              triggerLabel="Open rooms and kitchen ledger"
              kicker="Denvir's Coaching Inn, Est. 1642"
              title="Hearth snug, kitchen and six rooms"
              subtitle="14-16 English Street, Downpatrick. Ring 028 4461 2012 or enquire below."
              groups={innGroups}
              ctaLabel="Send booking enquiry"
              ctaHref="#enquire"
              secondaryLabel={`Call ${phone}`}
              secondaryHref={phoneHref}
              buttonClass="dv-ledger-trigger"
            />
          </div>
        </div>

        <div class="dv-inn-media" id="rooms">
          <figure class="dv-plate">
            <picture>
              <source
                srcset="/media/concepts/denvirs-downpatrick/denvirs-coaching-bedroom-640.webp 640w, /media/concepts/denvirs-downpatrick/denvirs-coaching-bedroom-1265.webp 1265w"
                sizes="(max-width: 900px) 100vw, 46vw"
                type="image/webp"
              />
              <img
                src="/media/concepts/denvirs-downpatrick/denvirs-coaching-bedroom.jpg"
                alt="Restored coaching inn bedroom with exposed timber beams, oatmeal linen and deep oxblood wool throw"
                width="1408"
                height="768"
                loading="lazy"
              />
            </picture>
            <figcaption>Restored coaching-inn guest room on English Street. Indicative bedroom visualisation.</figcaption>
          </figure>
          <p class="dv-inn-note">
            Wake in the heart of Downpatrick for Lecale walks, golf at Ardglass, Strangford Lough ferries, and heritage breaks by the Mournes.
          </p>
        </div>
      </div>
    </section>

    <section class="dv-section dv-enquire" id="enquire" aria-labelledby="dv-enq-title">
      <div class="dv-wrap dv-split">
        <div class="dv-enquire-intro">
          <h2 id="dv-enq-title">Book a room, Sunday table or gift voucher.</h2>
          <p>
            Whether you are reserving one of our six rooms, gathering family for Sunday roast, or ordering a
            Denvir's gift voucher, send your request straight to the English Street desk.
          </p>
          <dl class="dv-contact-ledger">
            <div>
              <dt>Inn desk</dt>
              <dd><a href={phoneHref}>{phone}</a></dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd><a href={`mailto:${email}`}>{email}</a></dd>
            </div>
            <div>
              <dt>Address</dt>
              <dd>14-16 English Street, Downpatrick, BT30 6AB</dd>
            </div>
          </dl>
        </div>

        <form class="dv-form" data-dv-form>
          <div class="dv-row">
            <label>
              <span>Your name</span>
              <input name="name" type="text" required autocomplete="name" placeholder="Full name" />
            </label>
            <label>
              <span>Telephone</span>
              <input name="phone" type="tel" required autocomplete="tel" placeholder="028 or 07..." />
            </label>
          </div>
          <div class="dv-row">
            <label>
              <span>Preferred date</span>
              <input name="date" type="date" required />
            </label>
            <label>
              <span>Guests</span>
              <input name="guests" type="number" min="1" max="30" value="2" required />
            </label>
          </div>
          <label>
            <span>Enquiry type</span>
            <select name="kind">
              <option value="Boutique bedroom or family apartment">Boutique bedroom or family apartment</option>
              <option value="Sunday roast or evening dining table">Sunday roast or evening dining table</option>
              <option value="Private celebration or group dining">Private celebration or group dining</option>
              <option value="Denvir's gift voucher">Denvir's gift voucher</option>
            </select>
          </label>
          <label>
            <span>Notes</span>
            <textarea name="notes" rows="3" placeholder="Number of nights, preferred sitting time, or voucher value"></textarea>
          </label>
          <button class="dv-btn dv-btn--primary" type="submit">Send enquiry to English Street</button>
        </form>
      </div>
    </section>

    <section class="dv-section dv-map-band" id="location" aria-label="Downpatrick location map">
      <div class="dv-wrap">
        <LocalAreaMap
          id="dv-map"
          kicker=""
          businessName="Denvir's Coaching Inn"
          address="14-16 English Street, Downpatrick, BT30 6AB"
          lon={-5.7167939}
          lat={54.328649}
          spanKm={18}
          mapHref={mapsHref}
          markers={[
            { name: "Strangford Ferry", lon: -5.5546, lat: 54.3712, note: "15 mins east", side: "r" },
            { name: "Ardglass Coast", lon: -5.6085, lat: 54.2613, note: "12 mins south-east", side: "b" },
            { name: "Killyleagh", lon: -5.6464, lat: 54.3983, note: "10 mins north", side: "t" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="dv-footer">
    <div class="dv-wrap dv-footer-inner">
      <div>
        <strong>Denvir's Coaching Inn</strong>
        <p>14-16 English Street, Downpatrick, Co. Down, BT30 6AB, Est. 1642</p>
      </div>
      <div class="dv-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={fbHref} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
        <a href={igHref} target="_blank" rel="noopener noreferrer">Instagram ↗</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-dv-header]");
      const sentinel = document.querySelector("[data-dv-sentinel]");
      if (header && sentinel && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            header.classList.toggle("is-scrolled", !entries[0].isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(sentinel);
      }

      const tabRoot = document.querySelector("[data-dv-tabs]");
      const tabs = tabRoot ? Array.from(tabRoot.querySelectorAll("[data-dv-tab]")) : [];
      const panels = tabRoot ? Array.from(tabRoot.querySelectorAll("[data-dv-panel]")) : [];

      const selectTab = (id, moveFocus) => {
        tabs.forEach((tab) => {
          const active = tab.getAttribute("data-dv-tab") === id;
          tab.classList.toggle("is-active", active);
          tab.setAttribute("aria-selected", active ? "true" : "false");
          tab.setAttribute("tabindex", active ? "0" : "-1");
          if (active && moveFocus) tab.focus();
        });
        panels.forEach((panel) => {
          panel.hidden = panel.getAttribute("data-dv-panel") !== id;
        });
      };

      tabs.forEach((tab, idx) => {
        tab.addEventListener("click", () => selectTab(tab.getAttribute("data-dv-tab"), false));
        tab.addEventListener("keydown", (e) => {
          if (e.key === "ArrowRight") {
            e.preventDefault();
            const next = tabs[(idx + 1) % tabs.length];
            selectTab(next.getAttribute("data-dv-tab"), true);
          } else if (e.key === "ArrowLeft") {
            e.preventDefault();
            const prev = tabs[(idx - 1 + tabs.length) % tabs.length];
            selectTab(prev.getAttribute("data-dv-tab"), true);
          } else if (e.key === "Home") {
            e.preventDefault();
            selectTab(tabs[0].getAttribute("data-dv-tab"), true);
          } else if (e.key === "End") {
            e.preventDefault();
            selectTab(tabs[tabs.length - 1].getAttribute("data-dv-tab"), true);
          }
        });
      });

      document.querySelectorAll("[data-dv-jump]").forEach((link) => {
        link.addEventListener("click", () => {
          const targetTab = link.getAttribute("data-dv-jump");
          if (targetTab) selectTab(targetTab, false);
        });
      });

      const form = document.querySelector("[data-dv-form]");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        const subject = `Denvir's Enquiry: ${fd.get("kind")} (${fd.get("date")})`;
        const body = [
          `Name: ${fd.get("name")}`,
          `Phone: ${fd.get("phone")}`,
          `Date: ${fd.get("date")}`,
          `Guests: ${fd.get("guests")}`,
          `Type: ${fd.get("kind")}`,
          `Notes: ${fd.get("notes") || "None"}`,
        ].join("\n");
        const ev = new CustomEvent("mm:enquiry", {
          cancelable: true,
          detail: {
            to: "info@denvirs.com",
            subject,
            body,
            phone: "028 4461 2012",
            phoneHref: "tel:+442844612012",
          },
        });
        if (window.dispatchEvent(ev)) {
          window.location.href = `mailto:info@denvirs.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }
      });
    })();
  </script>
</ConceptLayout>
