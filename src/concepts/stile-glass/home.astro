---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import SurveyClip from "./SurveyClip.astro";

/* Speaks as the workshop. Quote, survey, install — not a café.
   Their mechanism already exists: tel + mailto sales@. No fake
   configurator. No product catalogue clone. No EssenceMedia.
   No £370/m (stale vs 31 Jul 2026 news). Owner unnamed.
   Stephen O'Higgins is a news byline only — omit. Distinct from
   Unit 2, 63a — do not name the neighbour. */
const phone = "028 4372 3260";
const phoneHref = "tel:+442843723260";
const sales = "sales@stileglass.com";
const info = "info@stileglass.com";
const site = "https://www.stileglass.com";
const news = "https://www.stileglass.com/news/glass-balustrade-newcastle";
const fontHref =
  "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Syne:wght@500;600;700;800&display=swap";

const systems = [
  {
    name: "Frameless / spigots",
    line: "Glass on spigots. No frame. The view stays the view.",
  },
  {
    name: "Channel systems",
    line: "A continuous aluminium channel. Glass set in for the longer run.",
  },
  {
    name: "Juliet balconies",
    line: "Glass at the door opening — safety at the French doors.",
  },
  {
    name: "Glass windbreakers",
    line: "Patio and garden shelter that does not block the light.",
  },
];
---

<ConceptLayout
  title={"Stile Glass — independent concept"}
  slug="stile-glass"
  bodyClass="concept-page concept-stile"
  lang="en-GB"
  businessName="Stile Glass"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The survey clip is a drawing of the clipboard for 63 Castlewellan Road."
>
  <div class="sg-strip">
    <span>63 Castlewellan Road, Newcastle · BT33 0JX</span>
    <span class="sg-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="sg-header">
    <a class="sg-brand" href="/concepts/stile-glass/">
      <span class="sg-brand-mark" aria-hidden="true">
        <svg width="42" height="42" viewBox="0 0 42 42" fill="none">
          <rect x="1.5" y="1.5" width="39" height="39" fill="#1c2429"/>
          <rect x="14" y="6" width="14" height="24" fill="#d7ecef"/>
          <path d="M17 7.5l4.5 21" stroke="#f4fcfd" stroke-width="1.8" stroke-opacity=".7"/>
          <rect x="11" y="30" width="20" height="5" fill="#c4ccd2"/>
          <rect x="12" y="28.5" width="18" height="2.2" fill="#8e9aa3"/>
        </svg>
      </span>
      <span class="sg-brand-text">
        <span class="sg-brand-name">Stile Glass</span>
        <span class="sg-brand-sub">63 Castlewellan Road · Newcastle</span>
      </span>
    </a>
    <nav class="sg-nav" aria-label="Concept navigation">
      <a href="#survey">Survey</a>
      <a href="#systems">Systems</a>
      <a href="#showroom">Showroom</a>
      <a href="#quote">Quote</a>
    </nav>
    <a class="sg-visit" href="#survey">Site visit</a>
  </header>

  <main class="sg-main">
    <section class="sg-mast" aria-labelledby="sg-name">
      <div class="sg-mast-copy">
        <p class="sg-kicker">Bespoke glass · Newcastle, Co. Down</p>
        <h1 id="sg-name">STILE GLASS</h1>
        <p class="sg-number">63 Castlewellan Road</p>
        <p class="sg-say">Every project surveyed and quoted.</p>
        <p class="sg-lede">
          Northern Ireland's bespoke glass specialists, based in Newcastle,
          Co. Down.
        </p>
        <p class="sg-cta">
          <a class="sg-visit sg-visit--inline" href="#survey">Site visit</a>
          <a class="sg-ring" href={phoneHref}>{phone}</a>
        </p>
      </div>
      <div class="sg-edge" aria-hidden="true">
        <span class="sg-edge-pane"></span>
        <span class="sg-edge-channel"></span>
      </div>
    </section>

    <section class="sg-magazine" id="systems" aria-labelledby="sg-systems-title">
      <p class="sg-folio">Stile Glass · 63 Castlewellan Road · Newcastle</p>
      <div class="sg-magazine-head">
        <p class="sg-kicker">Systems</p>
        <h2 id="sg-systems-title">The systems, on the bench.</h2>
        <p>
          We design, supply and install glass balustrades, Juliet balconies
          and patio wind screens for homeowners, architects, builders and
          interior designers across Northern Ireland and along the east
          coast and midlands of Ireland. The jobs live on
          <a href={site} rel="noopener noreferrer">stileglass.com</a>.
        </p>
      </div>

      <ul class="sg-cards">
        {systems.map((system) => (
          <li class="sg-card">
            <h3>{system.name}</h3>
            <p>{system.line}</p>
          </li>
        ))}
      </ul>

      <blockquote class="sg-pull" cite={news}>
        <p>We have been transforming homes across Northern Ireland for over 10 years.</p>
      </blockquote>

      <p class="sg-handoff">
        Every job is carried out by our own experienced team — we do not
        subcontract. All glass is toughened laminated safety glass, meeting
        BS 6180:2011 and Technical Booklet H.
        <a href={news} rel="noopener noreferrer">Jobs and news on stileglass.com</a>
      </p>
    </section>

    <section class="sg-showroom" id="showroom" aria-labelledby="sg-showroom-title">
      <p class="sg-kicker sg-kicker--on-dark">Showroom</p>
      <h2 id="sg-showroom-title">The showroom is the workshop.</h2>
      <p>
        Come and see the systems and glass options in person at our base in
        Newcastle before you commit to anything. Many of our customers come
        through word of mouth. We give you 100% commitment to providing work
        to your satisfaction.
      </p>
      <p class="sg-hours">
        Monday–Friday 9–5 · Saturday 10–12 · Sunday closed
      </p>
      <p class="sg-area">
        Antrim, Down, Belfast, Newry and throughout Northern Ireland — and
        along the east coast and midlands of Ireland.
      </p>
    </section>

    <section class="sg-survey" id="survey" aria-labelledby="sg-survey-title">
      <div class="sg-survey-copy">
        <p class="sg-kicker">Survey</p>
        <h2 id="sg-survey-title">The clip for 63.</h2>
        <p class="sg-survey-lede">
          A free, no-obligation site visit, and a clear, itemised quote with
          no hidden costs. Ring, write, or come to the showroom.
        </p>
        <ul class="sg-chips" aria-label="How to start">
          <li><a href={phoneHref}>Site visit</a></li>
          <li><a href={`mailto:${sales}`}>Quote</a></li>
          <li><a href="#showroom">Showroom</a></li>
        </ul>
        <p class="sg-artefact-cta" id="quote">
          <a class="sg-visit sg-visit--inline" href={phoneHref}>{phone}</a>
          <a class="sg-mail" href={`mailto:${sales}`}>{sales}</a>
        </p>
      </div>

      <figure class="sg-artefact">
        <SurveyClip />
        <figcaption>The survey clip for 63.</figcaption>
      </figure>

      <address class="sg-address">
        <strong>Stile Glass</strong>
        <span>63 Castlewellan Road</span>
        <span>Newcastle, Co. Down</span>
        <span>BT33 0JX</span>
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${sales}`}>{sales}</a>
        <a href={`mailto:${info}`}>{info}</a>
        <a href={site} rel="noopener noreferrer">stileglass.com</a>
      </address>
    </section>
  </main>
</ConceptLayout>
