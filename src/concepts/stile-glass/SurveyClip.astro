---
/* Drawn survey clipboard for Stile Glass.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

{compact ? (
  <svg
    class="sg-mark"
    width="46"
    height="46"
    viewBox="0 0 46 46"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="1.4" y="1.4" width="43.2" height="43.2" rx="3" fill="#0e1720" stroke="#5bb4bd" stroke-width="1.6"/>
    <rect x="10" y="8" width="26" height="30" rx="1.5" fill="#1c2429" stroke="#5bb4bd" stroke-width="0.8"/>
    <line x1="14" y1="16" x2="32" y2="16" stroke="#5bb4bd" stroke-width="1"/>
    <line x1="14" y1="22" x2="28" y2="22" stroke="#e2e8f0" stroke-width="1"/>
    <line x1="14" y1="28" x2="30" y2="28" stroke="#e2e8f0" stroke-width="1"/>
  </svg>
) : (
  <svg
    class="sg-clip"
    viewBox="0 0 960 620"
    role="img"
    aria-label="Survey clipboard for Stile Glass at 108 Dundrum Road, Newcastle: architectural glazing, site visit, quote and specifications"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="sg-day" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e8f1f4"/>
        <stop offset="1" stop-color="#d4e0e4"/>
      </linearGradient>
      <linearGradient id="sg-board" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#2a3338"/>
        <stop offset="1" stop-color="#1c2429"/>
      </linearGradient>
      <linearGradient id="sg-sheet" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f7fbfc"/>
        <stop offset="1" stop-color="#eef4f6"/>
      </linearGradient>
      <linearGradient id="sg-glass" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f4fcfd" stop-opacity="0.85"/>
        <stop offset="0.45" stop-color="#d7ecef" stop-opacity="0.35"/>
        <stop offset="1" stop-color="#c4ccd2" stop-opacity="0.55"/>
      </linearGradient>
      <linearGradient id="sg-alum" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#d8dee2"/>
        <stop offset="1" stop-color="#9aa6ae"/>
      </linearGradient>
      <linearGradient id="sg-unit" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#4a555c"/>
        <stop offset="1" stop-color="#2e383e"/>
      </linearGradient>
    </defs>

    <rect width="960" height="620" fill="url(#sg-day)"/>
    <rect x="0" y="548" width="960" height="72" fill="#c5ccd1"/>
    <rect x="0" y="544" width="960" height="6" fill="#8e9aa3"/>

    <!-- Clipboard board -->
    <rect x="168" y="28" width="624" height="552" rx="10" fill="url(#sg-board)"/>
    <rect x="176" y="36" width="608" height="536" rx="8" fill="none" stroke="#3d4a51" stroke-width="1.2"/>

    <!-- Clip -->
    <rect x="412" y="14" width="136" height="54" rx="6" fill="url(#sg-alum)"/>
    <rect x="424" y="22" width="112" height="22" rx="3" fill="#e8eef1"/>
    <rect x="468" y="46" width="24" height="28" rx="3" fill="#8e9aa3"/>
    <circle cx="480" cy="62" r="5" fill="#1c2429"/>

    <!-- Sheet -->
    <rect x="196" y="78" width="568" height="472" fill="url(#sg-sheet)"/>
    <rect x="196" y="78" width="568" height="472" fill="none" stroke="#c4ccd2" stroke-width="1"/>
    <rect x="196" y="78" width="568" height="8" fill="#5bb4bd"/>

    <text
      x="480"
      y="118"
      text-anchor="middle"
      fill="#1c2429"
      font-family="Cinzel, Times New Roman, serif"
      font-size="32"
      font-weight="700"
      letter-spacing="4"
    >STILE GLASS</text>
    <text
      x="480"
      y="142"
      text-anchor="middle"
      fill="#5bb4bd"
      font-family="Plus Jakarta Sans, Segoe UI, sans-serif"
      font-size="12"
      font-weight="700"
      letter-spacing="4.5"
    >SITE SURVEY &amp; SPECIFICATION</text>
    <text
      x="480"
      y="172"
      text-anchor="middle"
      fill="#1c2429"
      font-family="Plus Jakarta Sans, Segoe UI, sans-serif"
      font-size="15"
      font-weight="600"
      letter-spacing="1.4"
    >108 DUNDRUM ROAD</text>
    <text
      x="480"
      y="194"
      text-anchor="middle"
      fill="#4d5a62"
      font-family="Plus Jakarta Sans, Segoe UI, sans-serif"
      font-size="12"
      font-weight="500"
      letter-spacing="1.6"
    >NEWCASTLE · CO. DOWN · BT33 0LN</text>

    <line x1="228" y1="210" x2="732" y2="210" stroke="#c4ccd2" stroke-width="1"/>

    <!-- Workshop elevation on the clip -->
    <g transform="translate(228 228)">
      <rect x="0" y="86" width="268" height="10" fill="#8e9aa3"/>
      <path d="M18 44h232l-14-28H32Z" fill="#1c2429"/>
      <rect x="24" y="44" width="220" height="48" fill="url(#sg-unit)"/>
      <rect x="24" y="44" width="220" height="12" fill="#5bb4bd"/>
      <text
        x="134"
        y="54"
        text-anchor="middle"
        fill="#e8f1f4"
        font-family="Cinzel, Times New Roman, serif"
        font-size="9"
        font-weight="700"
        letter-spacing="2.2"
      >STILE GLASS</text>
      <rect x="36" y="62" width="118" height="28" fill="url(#sg-glass)" stroke="#d8dee2" stroke-width="1.2"/>
      <path d="M48 64l18 24" stroke="#ffffff" stroke-opacity="0.55" stroke-width="3"/>
      <rect x="168" y="62" width="62" height="30" fill="#1c2429"/>
      <text
        x="199"
        y="84"
        text-anchor="middle"
        fill="#e8f1f4"
        font-family="Plus Jakarta Sans, sans-serif"
        font-size="15"
        font-weight="800"
      >108</text>
      <!-- Leaning sample panes -->
      <g transform="translate(8 78) rotate(-12)">
        <rect x="0" y="0" width="28" height="52" fill="url(#sg-glass)" stroke="#9aa6ae" stroke-width="1.2"/>
        <path d="M6 2l8 46" stroke="#ffffff" stroke-opacity="0.45" stroke-width="2"/>
      </g>
      <g transform="translate(38 82) rotate(-7)">
        <rect x="0" y="0" width="26" height="48" fill="url(#sg-glass)" stroke="#9aa6ae" stroke-width="1.2"/>
        <path d="M5 2l7 42" stroke="#ffffff" stroke-opacity="0.4" stroke-width="2"/>
      </g>
      <!-- Channel at the threshold -->
      <rect x="24" y="90" width="220" height="6" fill="#c4ccd2"/>
      <rect x="24" y="88" width="220" height="2.4" fill="#8e9aa3"/>
    </g>

    <!-- Survey ticks -->
    <g transform="translate(530 236)" fill="none">
      <g>
        <rect x="0" y="0" width="18" height="18" stroke="#1c2429" stroke-width="1.6"/>
        <path d="M4 10l4 4 8-9" stroke="#5bb4bd" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        <text
          x="28"
          y="14"
          fill="#1c2429"
          font-family="Plus Jakarta Sans, Segoe UI, sans-serif"
          font-size="14"
          font-weight="600"
        >Site measure &amp; survey</text>
      </g>
      <g transform="translate(0 36)">
        <rect x="0" y="0" width="18" height="18" stroke="#1c2429" stroke-width="1.6"/>
        <path d="M4 10l4 4 8-9" stroke="#5bb4bd" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        <text
          x="28"
          y="14"
          fill="#1c2429"
          font-family="Plus Jakarta Sans, Segoe UI, sans-serif"
          font-size="14"
          font-weight="600"
        >CAD technical drawings</text>
      </g>
      <g transform="translate(0 72)">
        <rect x="0" y="0" width="18" height="18" stroke="#1c2429" stroke-width="1.6"/>
        <path d="M4 10l4 4 8-9" stroke="#5bb4bd" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        <text
          x="28"
          y="14"
          fill="#1c2429"
          font-family="Plus Jakarta Sans, Segoe UI, sans-serif"
          font-size="14"
          font-weight="600"
        >Precision installation</text>
      </g>
      <text
        x="0"
        y="128"
        fill="#4d5a62"
        font-family="Plus Jakarta Sans, Segoe UI, sans-serif"
        font-size="11"
        font-weight="500"
      >Toughened laminated safety glass</text>
      <text
        x="0"
        y="146"
        fill="#4d5a62"
        font-family="Plus Jakarta Sans, Segoe UI, sans-serif"
        font-size="11"
        font-weight="500"
      >BS 6180:2011 · Coastal wind-load tested</text>
    </g>

    <line x1="228" y1="420" x2="732" y2="420" stroke="#c4ccd2" stroke-width="1"/>

    <!-- Channel section -->
    <g transform="translate(240 436)">
      <text
        x="0"
        y="12"
        fill="#4d5a62"
        font-family="Plus Jakarta Sans, Segoe UI, sans-serif"
        font-size="10"
        font-weight="600"
        letter-spacing="1.4"
      >ALUMINIUM &amp; 316 STEEL BASE</text>
      <rect x="0" y="48" width="64" height="10" fill="#c4ccd2"/>
      <rect x="4" y="44" width="56" height="6" fill="#8e9aa3"/>
      <rect x="22" y="22" width="20" height="28" fill="url(#sg-glass)" stroke="#9aa6ae" stroke-width="1"/>
      <path d="M28 24l6 24" stroke="#ffffff" stroke-opacity="0.5" stroke-width="2"/>
    </g>

    <text
      x="720"
      y="468"
      text-anchor="end"
      fill="#1c2429"
      font-family="Plus Jakarta Sans, Segoe UI, sans-serif"
      font-size="13"
      font-weight="600"
    >Dedicated installation team. Direct fabrication.</text>
    <text
      x="720"
      y="494"
      text-anchor="end"
      fill="#5bb4bd"
      font-family="Cinzel, Times New Roman, serif"
      font-size="16"
      font-weight="700"
      letter-spacing="2"
    >028 4372 4944</text>
  </svg>
)}
