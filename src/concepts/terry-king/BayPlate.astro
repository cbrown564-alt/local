---
/* Drawn MOT bay at 84 Dundrum Road: fascia, open roller, van on the
   lift, amber bay lights, painted MOT box on the tarmac.
   Honesty that it is a drawing lives in bannerNote, not the caption. */
---

<svg
  class="tk-plate"
  viewBox="0 0 960 560"
  role="img"
  aria-label="The bay at 84 Dundrum Road: Terry King and Sons fascia, open MOT bay, a van on the lift, amber lights, number 84"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="tk-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#d7e4ee"/>
      <stop offset="0.55" stop-color="#c9d6e0"/>
      <stop offset="1" stop-color="#b7c4ce"/>
    </linearGradient>
    <linearGradient id="tk-amber-glow" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f0c56a" stop-opacity="0.55"/>
      <stop offset="1" stop-color="#f0c56a" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="tk-interior" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4a463c"/>
      <stop offset="1" stop-color="#2e2c28"/>
    </linearGradient>
    <linearGradient id="tk-steel" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9a9590"/>
      <stop offset="1" stop-color="#6e6a66"/>
    </linearGradient>
    <linearGradient id="tk-tarmac-g" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3a3c40"/>
      <stop offset="1" stop-color="#2c2e32"/>
    </linearGradient>
    <linearGradient id="tk-van" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#c8c4bc"/>
      <stop offset="1" stop-color="#8a8680"/>
    </linearGradient>
    <pattern id="tk-corrugate" width="14" height="20" patternUnits="userSpaceOnUse">
      <rect width="14" height="20" fill="#8a8680"/>
      <rect x="0" width="5" height="20" fill="#9a9590"/>
      <rect x="10" width="4" height="20" fill="#7a7672"/>
    </pattern>
    <pattern id="tk-shutter" width="18" height="10" patternUnits="userSpaceOnUse">
      <rect width="18" height="10" fill="#6e6a66"/>
      <rect y="8" width="18" height="2" fill="#5a5652"/>
    </pattern>
    <radialGradient id="tk-lamp" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#ffe9a8"/>
      <stop offset="0.45" stop-color="#e0a43a"/>
      <stop offset="1" stop-color="#e0a43a" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <rect width="960" height="560" fill="url(#tk-sky)"/>

  <!-- Daylight — not dusk. Pale Mournes suggestion only. -->
  <path d="M0 168 C180 128 280 148 420 138 C560 126 680 108 960 148 L960 220 L0 220 Z" fill="#b3c0c8" opacity="0.45"/>

  <!-- Workshop body -->
  <rect x="72" y="86" width="816" height="292" fill="url(#tk-steel)"/>
  <rect x="72" y="132" width="816" height="246" fill="url(#tk-corrugate)"/>

  <!-- Fascia -->
  <rect x="56" y="78" width="848" height="62" fill="#2c2e32"/>
  <rect x="56" y="78" width="848" height="5" fill="#c9b22a"/>
  <rect x="56" y="135" width="848" height="5" fill="#c9b22a"/>
  <text
    x="480"
    y="122"
    text-anchor="middle"
    fill="#f3efe6"
    font-family="IBM Plex Sans, Segoe UI, sans-serif"
    font-size="36"
    font-weight="700"
    letter-spacing="7"
  >TERRY KING &amp; SONS</text>

  <!-- Open MOT bay -->
  <rect x="96" y="152" width="468" height="226" fill="url(#tk-interior)"/>
  <rect x="96" y="152" width="468" height="226" fill="url(#tk-amber-glow)"/>

  <!-- Roller housing -->
  <rect x="88" y="146" width="484" height="16" rx="2" fill="#4a4844"/>

  <!-- Lift posts -->
  <rect x="168" y="198" width="14" height="168" fill="#6a6660"/>
  <rect x="456" y="198" width="14" height="168" fill="#6a6660"/>
  <rect x="168" y="248" width="302" height="8" fill="#8a8680"/>
  <rect x="168" y="198" width="302" height="6" fill="#c9b22a"/>

  <!-- Van on the lift -->
  <g transform="translate(196 214)">
    <rect x="8" y="28" width="248" height="72" rx="6" fill="url(#tk-van)"/>
    <rect x="168" y="8" width="88" height="52" rx="4" fill="#b8b4ac"/>
    <rect x="180" y="16" width="64" height="28" fill="#8eb0c4" opacity="0.7"/>
    <rect x="20" y="40" width="52" height="36" fill="#9a9590"/>
    <rect x="84" y="40" width="52" height="36" fill="#9a9590"/>
    <circle cx="48" cy="104" r="16" fill="#2c2e32"/>
    <circle cx="48" cy="104" r="8" fill="#6e6a66"/>
    <circle cx="216" cy="104" r="16" fill="#2c2e32"/>
    <circle cx="216" cy="104" r="8" fill="#6e6a66"/>
  </g>

  <!-- Amber bay lights -->
  <g>
    <rect x="186" y="160" width="6" height="22" fill="#3a3834"/>
    <rect x="318" y="160" width="6" height="22" fill="#3a3834"/>
    <rect x="450" y="160" width="6" height="22" fill="#3a3834"/>
    <ellipse cx="189" cy="190" rx="28" ry="14" fill="url(#tk-lamp)"/>
    <ellipse cx="321" cy="190" rx="32" ry="16" fill="url(#tk-lamp)"/>
    <ellipse cx="453" cy="190" rx="28" ry="14" fill="url(#tk-lamp)"/>
    <rect x="176" y="180" width="26" height="6" rx="1" fill="#e0a43a"/>
    <rect x="308" y="180" width="26" height="6" rx="1" fill="#e0a43a"/>
    <rect x="440" y="180" width="26" height="6" rx="1" fill="#e0a43a"/>
  </g>

  <!-- Bay reveal with 84 -->
  <rect x="96" y="152" width="36" height="226" fill="#3e3c38"/>
  <rect x="102" y="210" width="24" height="52" fill="#2c2e32" stroke="#c9b22a" stroke-width="1.5"/>
  <text
    x="114"
    y="244"
    text-anchor="middle"
    fill="#f3efe6"
    font-family="IBM Plex Sans, Segoe UI, sans-serif"
    font-size="18"
    font-weight="700"
  >84</text>

  <!-- Closed shutter -->
  <rect x="596" y="152" width="268" height="226" fill="url(#tk-shutter)"/>
  <rect x="588" y="146" width="284" height="16" rx="2" fill="#4a4844"/>
  <rect x="712" y="250" width="36" height="8" rx="1" fill="#c9b22a"/>

  <!-- MOT sign on the closed bay -->
  <g transform="translate(676 176)">
    <rect width="108" height="36" fill="#2c2e32" stroke="#c9b22a" stroke-width="2"/>
    <text
      x="54"
      y="24"
      text-anchor="middle"
      fill="#c9b22a"
      font-family="IBM Plex Mono, ui-monospace, monospace"
      font-size="16"
      font-weight="600"
      letter-spacing="3"
    >MOT</text>
  </g>

  <!-- Tarmac and kerb -->
  <rect x="0" y="378" width="960" height="182" fill="url(#tk-tarmac-g)"/>
  <rect x="0" y="372" width="960" height="10" fill="#4a4c50"/>
  <rect x="0" y="378" width="960" height="6" fill="#c9b22a" opacity="0.35"/>

  <!-- Painted MOT box -->
  <rect x="128" y="400" width="420" height="96" fill="none" stroke="#c9b22a" stroke-width="5"/>
  <rect x="128" y="400" width="36" height="8" fill="#c9b22a"/>
  <rect x="512" y="400" width="36" height="8" fill="#c9b22a"/>
  <rect x="128" y="488" width="36" height="8" fill="#c9b22a"/>
  <rect x="512" y="488" width="36" height="8" fill="#c9b22a"/>
  <text
    x="338"
    y="458"
    text-anchor="middle"
    fill="#c9b22a"
    font-family="IBM Plex Mono, ui-monospace, monospace"
    font-size="28"
    font-weight="600"
    letter-spacing="10"
    opacity="0.85"
  >MOT</text>

  <!-- Kerb legend -->
  <rect x="620" y="428" width="280" height="44" fill="#2c2e32"/>
  <text
    x="760"
    y="456"
    text-anchor="middle"
    fill="#f3efe6"
    font-family="IBM Plex Mono, ui-monospace, monospace"
    font-size="14"
    font-weight="500"
    letter-spacing="3.2"
  >DUNDRUM ROAD</text>
</svg>
