---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import BayPlate from "./BayPlate.astro";

/* Terry King & Sons — elevated industrial garage & MOT preparation bay concept.
   84 Dundrum Road, Newcastle · BT33 0LN.
   Car & Van servicing, MOT prep, computerized diagnostics, mechanical repairs.
   Sourced from Google Business, local garage records, and verified announcements. */

const phone = "028 4372 3644";
const phoneHref = "tel:+442843723644";
const facebook = "https://www.facebook.com/search/top?q=Terry%20King%20%26%20Sons%20%7C%20Newcastle";
const fontHref =
  "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=IBM+Plex+Mono:wght@500;600;700&display=swap";

const services = [
  {
    code: "MOT-01",
    title: "MOT Preparation & Presentation",
    kicker: "Pre-test diagnostic check",
    desc: "Complete pre-MOT ramp inspection covering headlight beam alignment, brake efficiency, suspension linkages, tyre tread, and exhaust emissions.",
  },
  {
    code: "VAN-02",
    title: "Commercial Van & Fleet Servicing",
    kicker: "Priority trade turnaround",
    desc: "Fast-turnaround scheduled servicing and preventative maintenance to keep trade vans and commercial fleets operating without costly downtime.",
  },
  {
    code: "DIAG-03",
    title: "Computerized Engine Diagnostics",
    kicker: "Electronic telemetry & ECU scanning",
    desc: "Live digital telemetry scanning for engine management warning lights, ABS/Airbag sensors, injector faults, and electrical system diagnostics.",
  },
  {
    code: "MECH-04",
    title: "Brakes, Clutches & Mechanical Overhauls",
    kicker: "Heavy mechanical repairs",
    desc: "Complete clutch replacement, timing belt & chain installation, brake disc/pad renewal, suspension shocks, and steering rack repairs.",
  },
];
---

<ConceptLayout
  title={"Terry King & Sons — Automotive Servicing, MOT & Diagnostics, Newcastle"}
  slug="terry-king"
  bodyClass="concept-page concept-terry"
  lang="en-GB"
  businessName="Terry King & Sons"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="Workshop photography and ramp scenes are AI-generated illustrative visualisations of 84 Dundrum Road."
>
  <div class="tk-strip">
    <span>84 Dundrum Road, Newcastle · BT33 0LN · Commercial Van &amp; Car Specialist</span>
    <span class="tk-strip-r">Monday–Friday 9:00am–5:30pm · <a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="tk-header">
    <a class="tk-brand" href="/concepts/terry-king/">
      <span class="tk-brand-mark" aria-hidden="true">
        <BayPlate compact />
      </span>
      <span class="tk-brand-text">
        <span class="tk-brand-name">Terry King &amp; Sons</span>
        <span class="tk-brand-sub">84 Dundrum Road · Newcastle</span>
      </span>
    </a>
    <nav class="tk-nav" aria-label="Concept navigation">
      <a href="#services">MOT &amp; Services</a>
      <a href="#diagnostics">Diagnostics</a>
      <a href="#mot-guide">Pre-MOT checklist</a>
      <a href="#docket">Book ramp slot</a>
    </nav>
    <a class="tk-call-nav" href={phoneHref}>Call the Bay: {phone}</a>
  </header>

  <main class="tk-main">
    <!-- Hero with atmospheric industrial mechanical bay photography plate -->
    <section class="tk-hero" aria-labelledby="tk-hero-title">
      <figure class="tk-hero-plate">
        <picture>
          <img
            src="/media/concepts/terry-king/terry-king-hero-bay.jpg"
            alt="AI-generated illustrative photograph of active mechanical garage bay on Dundrum Road with trade van on hydraulic ramp"
            width="1920"
            height="1080"
            loading="eager"
          />
        </picture>
        <figcaption>Active hydraulic bay on Dundrum Road. AI-generated illustrative visualisation.</figcaption>
      </figure>

      <div class="tk-hero-veil" aria-hidden="true"></div>

      <div class="tk-hero-stage">
        <p class="tk-kicker">84 Dundrum Road · Newcastle, County Down</p>
        <h1 id="tk-hero-title">Terry King &amp; Sons</h1>
        <p class="tk-hero-say">Car &amp; van servicing, MOT and diagnostics.</p>
        <p class="tk-hero-lede">
          Small and large vehicle repairs carried out by fully trained technicians on Dundrum Road. Dedicated commercial van maintenance and fast-turnaround MOT preparation.
        </p>
        <div class="tk-hero-actions">
          <a class="tk-btn tk-btn--primary" href={phoneHref}>Call workshop: {phone}</a>
          <a class="tk-btn tk-btn--ghost" href="#services">View garage services ↓</a>
        </div>
      </div>
    </section>

    <!-- Core Workshop Services Grid -->
    <section class="tk-services-section" id="services" aria-labelledby="tk-services-title">
      <div class="tk-section-header">
        <p class="tk-kicker tk-kicker--amber">Workshop capabilities</p>
        <h2 id="tk-services-title">Trained technicians. Straight mechanical care.</h2>
        <p class="tk-section-lead">Full mechanical, electronic, and safety testing capabilities on our Dundrum Road lifts.</p>
      </div>

      <div class="tk-services-grid">
        {services.map((s) => (
          <article class="tk-service-card">
            <span class="tk-service-code">{s.code}</span>
            <p class="tk-service-kicker">{s.kicker}</p>
            <h3 class="tk-service-title">{s.title}</h3>
            <p class="tk-service-desc">{s.desc}</p>
            <a class="tk-service-link" href={phoneHref}>Call to book slot: {phone} →</a>
          </article>
        ))}
      </div>
    </section>

    <!-- Diagnostics & Underbody Inspection Feature Split -->
    <section class="tk-diagnostics-section" id="diagnostics" aria-labelledby="tk-diag-title">
      <div class="tk-diag-grid">
        <figure class="tk-diag-figure">
          <img
            src="/media/concepts/terry-king/terry-king-diagnostic-bay.jpg"
            alt="AI-generated illustrative close-up of diagnostic telemetry scanner connected to an engine bay"
            width="1200"
            height="900"
            loading="lazy"
          />
          <figcaption>Digital engine telemetry diagnostics. AI-generated illustrative visualisation.</figcaption>
        </figure>

        <div class="tk-diag-copy">
          <p class="tk-kicker tk-kicker--amber">Electronic diagnostics</p>
          <h2 id="tk-diag-title">Precision fault finding before parts are replaced.</h2>
          <p class="tk-diag-lead">
            Modern vehicles demand computerized diagnostic analysis. We connect dedicated diagnostic hardware directly to your vehicle’s ECU to pinpoint warning lights, sensor failures, and performance issues.
          </p>
          <ul class="tk-diag-list">
            <li>Engine management &amp; check engine light reset</li>
            <li>ABS, traction control &amp; airbag sensor calibration</li>
            <li>Diesel particulate filter (DPF) regeneration &amp; emissions checks</li>
            <li>Battery, alternator &amp; electrical charging diagnostics</li>
          </ul>
          <p class="tk-diag-cta">
            <a class="tk-btn tk-btn--primary" href={phoneHref}>Book diagnostic scan ({phone})</a>
          </p>
        </div>
      </div>
    </section>

    <!-- Pre-MOT Guidance & Underbody Ramp Inspection -->
    <section class="tk-mot-section" id="mot-guide" aria-labelledby="tk-mot-title">
      <div class="tk-mot-grid">
        <div class="tk-mot-copy">
          <p class="tk-kicker tk-kicker--amber">Northern Ireland MOT readiness</p>
          <h2 id="tk-mot-title">Pass first time. Avoid re-test delays.</h2>
          <p class="tk-mot-lead">
            With long waiting lists at DVA test centres across Northern Ireland, a re-test failure causes weeks of off-road delay. Our comprehensive pre-MOT ramp check identifies failure points before test day.
          </p>
          <ol class="tk-mot-steps">
            <li>
              <strong>Braking Performance &amp; Fluid Lines:</strong>
              <span>Full roller balance, brake pad wear inspection, and rigid brake pipe corrosion check.</span>
            </li>
            <li>
              <strong>Suspension, Bushings &amp; Wheel Bearings:</strong>
              <span>Hydraulic ramp shake test to identify play in ball joints, drop links, and wishbones.</span>
            </li>
            <li>
              <strong>Headlight Beam Alignment &amp; Bulbs:</strong>
              <span>Optical box alignment to precise legal angle and luminous intensity standards.</span>
            </li>
            <li>
              <strong>Emissions &amp; Exhaust Integrity:</strong>
              <span>Pre-test gas analysis for petrol and diesel smoke density.</span>
            </li>
          </ol>
        </div>

        <figure class="tk-mot-figure">
          <img
            src="/media/concepts/terry-king/terry-king-mot-inspection.jpg"
            alt="AI-generated illustrative underbody ramp inspection with mechanic checking suspension components"
            width="1200"
            height="800"
            loading="lazy"
          />
          <figcaption>Pre-MOT underbody ramp examination. AI-generated illustrative visualisation.</figcaption>
        </figure>
      </div>
    </section>

    <!-- Interactive Bay Docket Section -->
    <section class="tk-docket-section" id="docket" aria-labelledby="tk-docket-title">
      <div class="tk-docket-wrap">
        <div class="tk-docket-copy">
          <p class="tk-kicker tk-kicker--amber">Workshop job card</p>
          <h2 id="tk-docket-title">Direct line to the workshop floor.</h2>
          <p class="tk-docket-lead">
            Ring 84 Dundrum Road directly to book your car or trade van onto the ramp. Speak straight to the mechanics handling your job.
          </p>
          <div class="tk-docket-card">
            <span class="tk-docket-num">JOB DOCKET · 84 DUNDRUM ROAD</span>
            <strong>Direct Booking Protocol:</strong>
            <p>Tell us your vehicle make/model and required date. We confirm ramp availability immediately on the call.</p>
            <a class="tk-docket-dial" href={phoneHref}>Call 028 4372 3644</a>
          </div>
        </div>

        <figure class="tk-docket-figure">
          <BayPlate />
          <figcaption>Terry King &amp; Sons · 84 Dundrum Road, Newcastle.</figcaption>
        </figure>
      </div>
    </section>

    <!-- Footer -->
    <footer class="tk-footer">
      <div class="tk-footer-inner">
        <div class="tk-footer-brand">
          <BayPlate compact />
          <strong class="tk-footer-name">Terry King &amp; Sons</strong>
          <span>84 Dundrum Road · Newcastle · BT33 0LN</span>
        </div>
        <div class="tk-footer-hours">
          <strong>Opening Hours: Monday to Friday 9:00am – 5:30pm</strong>
          <span>Saturday morning by arrangement · Sunday Closed</span>
        </div>
        <div class="tk-footer-links">
          <a href={phoneHref}>Workshop Line: {phone}</a>
          <a href={facebook} rel="noopener noreferrer">Facebook Page</a>
        </div>
      </div>
    </footer>
  </main>
</ConceptLayout>
