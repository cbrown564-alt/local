---
import "../../site/styles/global.css";
import "./styles.css";
import ConceptLayout from "../_shell/ConceptLayout.astro";
import BayPlate from "./BayPlate.astro";

/* Terry King & Sons — ride (the van / the bay, not a shop window).
   Speak as the garage. No live site to hand off to (domain 500 on 23 Aug
   2026 — research only; do not deep-link, do not snark on this door).
   Directory email and fax omitted. Hours are Google-only — omit rather
   than print an undated clock. Owner unnamed. Callum / Gavin stay off.
   Dissolved Ltd / Companies House stay off. Same yard as Spectrum
   Splashbacks — do not mention. No used-car grid; FB mentions sales in
   one sentence. No EssenceMedia. No rasters. No fake online booking.
   Facebook is a search, not a page URL we have not confirmed. */
const phone = "028 4372 3644";
const phoneHref = "tel:+442843723644";
const facebook = "https://www.facebook.com";
const fontHref =
  "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap";

const register = [
  {
    id: "mot",
    bay: "MOT",
    job: "MOT",
    line: "The MOT bay on Dundrum Road.",
  },
  {
    id: "car",
    bay: "CAR",
    job: "Servicing",
    line: "Cars through this bay. We service and sell.",
  },
  {
    id: "vans",
    bay: "VAN",
    job: "Servicing",
    line: "Vans as well as cars. Small and large.",
  },
  {
    id: "diag",
    bay: "DIAG",
    job: "Diagnostics",
    line: "Diagnostics. Fully trained technicians.",
  },
];
---

<ConceptLayout
  title={"Terry King & Sons — independent concept"}
  slug="terry-king"
  bodyClass="concept-page concept-terry"
  lang="en-GB"
  businessName="Terry King & Sons"
  town="Newcastle"
  fontHref={fontHref}
  bannerNote="The bay plate is a drawing of the bay on Dundrum Road."
>
  <div class="tk-strip">
    <span>84 Dundrum Road, Newcastle · BT33 0LN</span>
    <span class="tk-strip-r"><a href={phoneHref}>{phone}</a></span>
  </div>

  <header class="tk-header">
    <a class="tk-brand" href="/concepts/terry-king/">
      <span class="tk-brand-mark" aria-hidden="true">
        <svg width="46" height="46" viewBox="0 0 46 46" fill="none">
          <rect width="46" height="46" fill="#2c2e32"/>
          <rect x="5" y="5" width="36" height="36" fill="none" stroke="#c9b22a" stroke-width="2"/>
          <rect x="5" y="5" width="8" height="2.2" fill="#c9b22a"/>
          <rect x="33" y="5" width="8" height="2.2" fill="#c9b22a"/>
          <rect x="5" y="38.8" width="8" height="2.2" fill="#c9b22a"/>
          <rect x="33" y="38.8" width="8" height="2.2" fill="#c9b22a"/>
          <rect x="14" y="8" width="18" height="3" rx="1" fill="#e0a43a"/>
          <text
            x="23"
            y="31"
            text-anchor="middle"
            fill="#f3efe6"
            font-size="16"
            font-family="IBM Plex Sans, Segoe UI, sans-serif"
            font-weight="700"
          >84</text>
        </svg>
      </span>
      <span class="tk-brand-text">
        <span class="tk-brand-name">Terry King &amp; Sons</span>
        <span class="tk-brand-sub">The bay · Dundrum Road</span>
      </span>
    </a>
    <nav class="tk-nav" aria-label="Concept navigation">
      <a href="#bay">The bay</a>
      <a href="#mot">MOT</a>
      <a href="#vans">Vans</a>
      <a href="#ring">Ring</a>
    </nav>
    <a class="tk-call" href={phoneHref}>Ring</a>
  </header>

  <main class="tk-main">
    <section class="tk-mast" id="bay" aria-labelledby="tk-name">
      <p class="tk-kicker">The bay · Newcastle</p>
      <h1 id="tk-name">
        <span class="tk-h1-a">TERRY KING</span>
        <span class="tk-h1-b">&amp; SONS</span>
      </h1>
      <p class="tk-number">84 Dundrum Road</p>
      <p class="tk-say">
        Car and Van servicing/sales, Mot, Diagnostics, small and large vehicle
        repairs carried out buy fully trained technicians.
      </p>
      <p class="tk-lede">
        The bay on Dundrum Road. Ring — that is how a job starts.
      </p>
      <p class="tk-cta">
        <a class="tk-call tk-call--inline" href={phoneHref}>Ring {phone}</a>
        <a class="tk-fb" href={facebook} rel="noopener noreferrer">Facebook</a>
      </p>
    </section>

    <section class="tk-register" aria-labelledby="tk-register-title">
      <div class="tk-ledger">
        <p class="tk-kicker">Garage register</p>
        <h2 id="tk-register-title">MOT. Cars. Vans. Diagnostics.</h2>
        <p class="tk-ledger-lead">
          What we wrote on Facebook is the work. Four bays on one card —
          not a brochure, and not a used-car grid.
        </p>
      </div>

      <ol class="tk-bays">
        {register.map((row) => (
          <li class="tk-baycard" id={row.id}>
            <span class="tk-baycard-bay">{row.bay}</span>
            <span class="tk-baycard-job">{row.job}</span>
            <p>{row.line}</p>
          </li>
        ))}
      </ol>

      <aside class="tk-today">
        <p class="tk-today-kicker">The wall</p>
        <p>
          Whatever we last posted lives on Facebook. Search
          Terry King &amp; Sons | Newcastle.
        </p>
        <p class="tk-today-links">
          <a href={facebook} rel="noopener noreferrer">facebook.com</a>
        </p>
      </aside>
    </section>

    <section class="tk-ritual" id="ring" aria-labelledby="tk-docket-title">
      <div class="tk-ritual-copy">
        <p class="tk-kicker tk-kicker--on-tarmac">Bay docket</p>
        <h2 id="tk-docket-title">Mark the job. Then ring.</h2>
        <p>
          There is no booking box. The chips are the card — say MOT, car,
          van, or diagnostics when you call. The number starts the job.
        </p>
      </div>

      <div
        class="tk-docket"
        role="group"
        aria-label="Bay docket — mark the job, then ring. This does not book a slot."
      >
        <header class="tk-docket-head">
          <span>Job card</span>
          <span>84 Dundrum Road</span>
        </header>
        <p class="tk-docket-stamp">BAY DOCKET</p>
        <p class="tk-docket-hint">Mark what you would say on the call.</p>
        <div class="tk-chips">
          <button type="button" class="tk-chip" aria-pressed="false">MOT</button>
          <button type="button" class="tk-chip" aria-pressed="false">Car</button>
          <button type="button" class="tk-chip" aria-pressed="false">Van</button>
          <button type="button" class="tk-chip" aria-pressed="false">Diagnostics</button>
        </div>
        <p class="tk-docket-lines" aria-hidden="true">
          <span>Reg</span>
          <span>The job</span>
        </p>
        <a class="tk-call tk-call--docket" href={phoneHref}>Ring {phone}</a>
        <p class="tk-docket-note">No online booking. Ring the bay.</p>
      </div>
    </section>

    <section class="tk-yard" aria-labelledby="tk-yard-title">
      <div class="tk-yard-copy">
        <p class="tk-kicker">84 Dundrum Road</p>
        <h2 id="tk-yard-title">The bay on Dundrum Road.</h2>
        <p class="tk-yard-lede">
          Ring. That is the mechanism.
        </p>
        <p class="tk-cta tk-artefact-cta">
          <a class="tk-call tk-call--inline" href={phoneHref}>Ring {phone}</a>
        </p>
      </div>

      <figure class="tk-artefact">
        <BayPlate />
        <figcaption>The bay on Dundrum Road.</figcaption>
      </figure>

      <address class="tk-address">
        <strong>Terry King &amp; Sons</strong>
        <span>84 Dundrum Road</span>
        <span>Newcastle</span>
        <span>BT33 0LN</span>
        <a href={phoneHref}>{phone}</a>
        <a href={facebook} rel="noopener noreferrer">Facebook · search Terry King &amp; Sons | Newcastle</a>
      </address>
    </section>
  </main>
</ConceptLayout>

<script>
  document.querySelectorAll(".tk-chip").forEach((chip) => {
    chip.addEventListener("click", () => {
      const on = chip.getAttribute("aria-pressed") === "true";
      chip.setAttribute("aria-pressed", on ? "false" : "true");
    });
  });
</script>
