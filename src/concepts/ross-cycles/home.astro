---
import ConceptLayout from "../_shell/ConceptLayout.astro";
import LocalAreaMap from "../_shell/LocalAreaMap.astro";
import SpecimenSheet from "../_shell/SpecimenSheet.astro";
import "./styles.css";

/* Ross Cycles — 44 Clarkhill Road, Castlewellan BT31 9BL.
   Verified live 26 Nov 2026: No standalone owned website (rosscycles.co.uk is Caterham, Surrey).
   Independent Castlewellan bike shop, Volt e-bike stockist, CycleScheme dealer, MTB & road servicing
   minutes from Castlewellan Forest Park trails. Phone: 028 4377 8029. */
const phone = "028 4377 8029";
const phoneHref = "tel:+442843778029";
const fbHref = "https://www.facebook.com/Ross-Cycles-1579772998910836";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Ross+Cycles+44+Clarkhill+Road+Castlewellan+BT31+9BL";

const shopGroups = [
  {
    id: "bikes",
    label: "Bikes, E-Bikes & CycleScheme",
    items: [
      { name: "Volt Electric Bikes", note: "Authorised Northern Ireland Volt e-bike dealer with local sizing, setup and aftercare", meta: "Official stockist" },
      { name: "Cycle to Work (CycleScheme)", note: "Redeem CycleScheme certificates locally on commuter bikes, hybrids and e-bikes", meta: "Scheme accepted" },
      { name: "MTB, Road & Family Bikes", note: "Properly assembled, tuned and sized on Clarkhill Road — never shipped flat-packed", meta: "Ready to ride" },
    ],
  },
  {
    id: "workshop",
    label: "Workshop & Trail Support",
    items: [
      { name: "Drivetrain, Brake & Gear Servicing", note: "Full tune-ups, hydraulic brake bleeds, bottom brackets and cassette swaps", meta: "Book by phone" },
      { name: "Wheel Truing & Tyre Setup", note: "Spoke replacement, wheel truing and tubeless setups for Castlewellan singletrack", meta: "Trail ready" },
    ],
  },
];
---

<ConceptLayout
  title="Ross Cycles — Bikes, E-Bikes & Workshop, Castlewellan"
  slug="ross-cycles"
  bodyClass="concept-page concept-rosscycles"
  businessName="Ross Cycles"
  town="Castlewellan"
  bannerNote="Imagery comprises indicative cycle workshop and Castlewellan forest trail visualisations."
>
  <header class="rc-header">
    <div class="rc-header-grid">
      <a class="rc-brand" href="#top">
        <strong>Ross Cycles</strong>
        <span>44 Clarkhill Rd</span>
      </a>
      <nav class="rc-nav" aria-label="Primary">
        <a href="#bikes">E-Bikes &amp; CycleScheme</a>
        <a href="#trails">Workshop &amp; Trails</a>
        <a href="#location">Castlewellan</a>
      </nav>
      <a class="rc-header-cta" href={phoneHref}>Workshop · {phone}</a>
    </div>
  </header>

  <main id="top">
    <section class="rc-hero" aria-labelledby="rc-hero-title">
      <div class="rc-hero-grid">
        <div class="rc-hero-spec">
          <div class="rc-spec-top">
            <span class="rc-tag">CASTLEWELLAN · BT31 9BL</span>
            <h1 id="rc-hero-title">Volt e-bikes &amp; proper workshop spanners.</h1>
            <p class="rc-lead">
              Independent cycling specialists minutes from Castlewellan Forest Park. Authorised Volt
              e-bike dealer, CycleScheme partner and hands-on servicing.
            </p>
            <div class="rc-actions">
              <a class="rc-btn rc-btn--primary" href={phoneHref}>Call {phone}</a>
              <SpecimenSheet
                id="rc-workshop-sheet"
                triggerLabel="Workshop & bike guide"
                kicker="Ross Cycles · 44 Clarkhill Road, Castlewellan"
                title="Volt E-Bikes, CycleScheme & Servicing"
                subtitle="Ring 028 4377 8029 to check current e-bike stock or book your bike onto the stand."
                groups={shopGroups}
                ctaLabel={`Call ${phone}`}
                ctaHref={phoneHref}
                secondaryLabel="Google Maps ↗"
                secondaryHref={mapsHref}
                buttonClass="rc-ghost-link"
              />
            </div>
          </div>

          <dl class="rc-spec-strip">
            <div><dt>Electric</dt><dd>Authorised Volt Dealer</dd></div>
            <div><dt>Commute</dt><dd>CycleScheme Accepted</dd></div>
            <div><dt>Stand</dt><dd>Brakes · Gears · Wheels</dd></div>
          </dl>
        </div>

        <figure class="rc-hero-plate">
          <picture>
            <source srcset="/media/concepts/ross-cycles/ross-cycles-workshop-640.webp 640w, /media/concepts/ross-cycles/ross-cycles-workshop-1265.webp 1265w" sizes="(max-width: 960px) 100vw, 50vw" type="image/webp" />
            <img src="/media/concepts/ross-cycles/ross-cycles-workshop.jpg" alt="Independent bicycle workshop with matte-slate electric mountain bike clamped in a repair stand and organised tools" width="1408" height="768" loading="eager" />
          </picture>
          <figcaption>Workshop &amp; e-bike setup · indicative visualisation</figcaption>
        </figure>
      </div>
    </section>

    <section class="rc-section rc-bikes" id="bikes" aria-labelledby="rc-b-title">
      <div class="rc-wrap">
        <div class="rc-three">
          <article>
            <span>01 / Electric</span>
            <h2 id="rc-b-title">Authorised Volt e-bike dealer</h2>
            <p>Test fit and buy British-engineered Volt electric bikes with genuine local diagnostics, battery support and warranty backup.</p>
          </article>
          <article>
            <span>02 / Commute</span>
            <h3>CycleScheme welcome</h3>
            <p>Bring your employer CycleScheme voucher to Clarkhill Road for honest sizing across commuter bikes, hybrids and e-bikes.</p>
          </article>
          <article>
            <span>03 / Spanners</span>
            <h3>Proper workshop servicing</h3>
            <p>Gears, hydraulic brakes, wheel truing and bearings sorted cleanly before your next Castlewellan or Mourne spin.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="rc-section rc-trails" id="trails" aria-labelledby="rc-tr-title">
      <div class="rc-wrap rc-split">
        <figure class="rc-plate">
          <picture>
            <source srcset="/media/concepts/ross-cycles/ross-cycles-castlewellan-trail-640.webp 640w, /media/concepts/ross-cycles/ross-cycles-castlewellan-trail-1265.webp 1265w" sizes="(max-width: 860px) 100vw, 48vw" type="image/webp" />
            <img src="/media/concepts/ross-cycles/ross-cycles-castlewellan-trail.jpg" alt="Early morning forested singletrack trail in Castlewellan Forest Park with mountain bike beside a granite stone wall" width="1408" height="768" loading="lazy" />
          </picture>
          <figcaption>Castlewellan singletrack · indicative trail visualisation.</figcaption>
        </figure>
        <div>
          <p class="rc-kicker">Minutes from Castlewellan Forest Park</p>
          <h2 id="rc-tr-title">Drop your bike in on Clarkhill Road before the weekend trails.</h2>
          <p class="rc-body">
            Whether you are upgrading to an e-bike for the County Down hills or need a pre-ride brake
            bleed and gear index, call ahead so we can get your bike straight onto the stand.
          </p>
          <dl class="rc-contact-list">
            <div><dt>Direct Workshop Line</dt><dd><a href={phoneHref}>{phone}</a></dd></div>
            <div><dt>Address</dt><dd>44 Clarkhill Road, Castlewellan, BT31 9BL</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section class="rc-section rc-map-band" id="location" aria-label="Castlewellan Clarkhill Road map">
      <div class="rc-wrap">
        <LocalAreaMap
          id="rc-map"
          tone="dark"
          kicker="44 Clarkhill Road · Castlewellan"
          businessName="Ross Cycles"
          address="44 Clarkhill Road, Castlewellan, BT31 9BL"
          lon={-5.9447377}
          lat={54.2796359}
          spanKm={16}
          mapHref={mapsHref}
          markers={[
            { name: "Castlewellan Forest", lon: -5.9442, lat: 54.2596, note: "4 mins south", side: "b" },
            { name: "Newcastle", lon: -5.8902, lat: 54.2121, note: "12 mins south-east", side: "r" },
            { name: "Ballynahinch", lon: -5.8971, lat: 54.4011, note: "15 mins north", side: "t" },
          ]}
        />
      </div>
    </section>
  </main>

  <footer class="rc-footer">
    <div class="rc-wrap rc-footer-inner">
      <div>
        <strong>Ross Cycles</strong>
        <p>44 Clarkhill Road, Castlewellan, Co. Down, BT31 9BL</p>
      </div>
      <div class="rc-footer-links">
        <a href={phoneHref}>{phone}</a>
        <a href={fbHref} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
        <a href={mapsHref} target="_blank" rel="noopener noreferrer">Directions ↗</a>
      </div>
    </div>
  </footer>
</ConceptLayout>
