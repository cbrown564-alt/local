---
/**
 * The stop — beat 6, and not a layer. The finished chassis with the register
 * slot where the name band sat, and the page's one drawn beat: the blank
 * nameplate hovering over it, seating perfectly because nothing on it is
 * anyone's yet — the swap test's own image, landing on our own chassis.
 * Then the handover: to /five-shapes/ for why the next layer differs by
 * business, and to the transformations for the times it was actually drawn.
 */
import ArrowIcon from "../ArrowIcon.astro";
import AssemblyChassis from "./AssemblyChassis.astro";
---

<div class="hgstop-stage">
  <div class="hgstop-frame-wrap">
    <AssemblyChassis upto={5} stop frameClass="hgstop-frame" />
  </div>
  <div class="hgstop-copy">
    <p class="hgstop-line">
      The next part is a colour, a typeface, a photograph — a first screen drawn for one
      business at one hour. Grey has nothing to offer it, so the build stops here. The plate
      still seats; nothing on it is anyone's yet.
    </p>
    <p class="hgstop-swap">
      The test this part has to pass is the swap test — <a href="/where-it-fails/#t10"
        >try it on Where it fails</a
      >.
    </p>
    <div class="hgstop-handoff">
      <a class="hgstop-link" href="/why-its-yours/">
        <span class="hgstop-link-lead">Why the next part has to be yours</span>
        <span class="hgstop-link-sub">Why a hotel site and a food-bar site shouldn’t work the same way</span>
        <span class="hgstop-link-arrow" aria-hidden="true"><ArrowIcon /></span>
      </a>
      <a class="hgstop-link" href="/transformations/">
        <span class="hgstop-link-lead">The times it was actually drawn</span>
        <span class="hgstop-link-sub">Named businesses, dated audits, screens that could only be theirs</span>
        <span class="hgstop-link-arrow" aria-hidden="true"><ArrowIcon /></span>
      </a>
      <a class="hgstop-ask" href="/request/">
        Send a link — we'll name the parts you already have <ArrowIcon />
      </a>
    </div>
  </div>
</div>
