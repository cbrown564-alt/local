---
import type { FaultBlock, FaultPanel } from "../../data/fault-walks";
import TheatreArt from "../five-shapes/TheatreArt.astro";

interface Props {
  panel: FaultPanel;
  /** "before" panels form the fault walk, "after" panels the fixed walk. */
  mode: "before" | "after";
  /** Interactive panels carry tappable blocks; static plates are inert. */
  interactive: boolean;
  hidden?: boolean;
}

const { panel, mode, interactive, hidden = false } = Astro.props;

const styleFor = (block: FaultBlock) =>
  `left:${block.x}%;top:${block.y}%;width:${block.w}%;height:${block.h}%;`;

const classFor = (block: FaultBlock) =>
  [
    "fwb",
    `fwb-${block.kind}`,
    block.dim ? "is-dim" : null,
    block.goal ? "is-goal" : null,
    block.art ? "has-art" : null,
  ]
    .filter(Boolean)
    .join(" ");

const isTappable = (block: FaultBlock) =>
  block.tap !== undefined || block.goal === true || block.note !== undefined;

/* A drawn scene replaces the placeholder's words on media blocks; on a
   button the words stay — the mechanism word is the block's job. */
const showLabel = (block: FaultBlock) =>
  block.label !== undefined && (block.art === undefined || block.kind === "button");
---

<div
  class:list={["fwp", { "fwp--static": !interactive }]}
  data-panel={panel.id}
  data-mode={mode}
  role={interactive ? "group" : "img"}
  aria-label={panel.caption}
  tabindex={interactive ? "-1" : undefined}
  hidden={hidden}
>
  {
    panel.blocks.map((block) =>
      interactive && isTappable(block) ? (
        <button
          type="button"
          class={classFor(block)}
          style={styleFor(block)}
          data-tap={block.tap}
          data-goal={block.goal ? "true" : undefined}
          data-note={block.note}
          aria-label={block.label ?? block.note ?? "grey layout block"}
        >
          {block.art && <TheatreArt name={block.art} />}
          {showLabel(block) && <span class="fwb-label">{block.label}</span>}
        </button>
      ) : (
        <div class={classFor(block)} style={styleFor(block)} aria-hidden="true">
          {block.art && <TheatreArt name={block.art} />}
          {showLabel(block) && <span class="fwb-label">{block.label}</span>}
        </div>
      ),
    )
  }
</div>
