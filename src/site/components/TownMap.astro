---
import { transformations } from "../data/transformations";
import businesses from "../data/businesses.json";
import ArrowIcon from "./ArrowIcon.astro";
import "../styles/town-map.css";

// Match public transformations to real geographic coordinates
const transformationGeocodes: Record<string, { lat: number; lon: number }> = {
  "dundrum-inn": { lat: 54.248228, lon: -5.8598994 },
  "kelly-mcevoy-brown": { lat: 54.2578944, lon: -5.8467775 },
  "bettys-butters": { lat: 54.2582, lon: -5.8445 },
  "douglas-cromie": { lat: 54.2306716, lon: -5.9312847 },
  "donard-hotel": { lat: 54.2142979, lon: -5.8885605 },
  "newcastle-dental": { lat: 54.2142884, lon: -5.8870259 },
  "hugh-mccanns": { lat: 54.2059906, lon: -5.893239 },
  "newcastle-chamber": { lat: 54.214692, lon: -5.8883328 },
  "kent-amusements": { lat: 54.2075452, lon: -5.892505 },
  "tool-centre": { lat: 54.211934, lon: -5.8898398 },
  "cupla": { lat: 54.258071, lon: -5.8431276 },
  "scopers": { lat: 54.2568552, lon: -5.8467383 },
  "bucks-head": { lat: 54.2590308, lon: -5.8417282 },
  "donard-veterinary": { lat: 54.2144482, lon: -5.8874989 },
  "mourne-cycles": { lat: 54.2307121, lon: -5.9016696 },
  "hotel-enniskeen": { lat: 54.2199678, lon: -5.910281 },
  "castle-farm": { lat: 54.264296, lon: -5.851389 },
  "painted-earth": { lat: 54.2114282, lon: -5.8897171 },
  "bear-necessities": { lat: 54.2121151, lon: -5.8897673 },
  "arley-house": { lat: 54.2670396, lon: -5.8379076 },
  "armstrong-opticians": { lat: 54.214806, lon: -5.8890651 },
  "irelands-appliance-centre": { lat: 54.1986933, lon: -5.8883498 },
  "villa-vinci": { lat: 54.2139201, lon: -5.8891003 },
  "conlyn-house": { lat: 54.21179, lon: -5.8884982 },
  "binghams-menswear": { lat: 54.2117426, lon: -5.8895501 },
  "cafe-mauds": { lat: 54.2107963, lon: -5.8900856 },
  "cocos-adventure-playground": { lat: 54.2092049, lon: -5.8918405 },
  "marine-wellness": { lat: 54.207099, lon: -5.8926828 },
};

const conceptPins = transformations.map((t) => {
  const geo = transformationGeocodes[t.slug] || { lat: 54.214, lon: -5.898 };
  return {
    slug: t.slug,
    name: t.name,
    town: t.town,
    category: t.category,
    summary: t.summary,
    href: t.href,
    lat: geo.lat,
    lon: geo.lon,
  };
});

const previewNewcastle = conceptPins.filter((p) => p.town === "Newcastle");
const previewDundrum = conceptPins.filter((p) => p.town === "Dundrum");
---

<div class="home-showcase-map-container" data-home-map>
  <!-- Top Bar: Town Switcher & Full Directory Link -->
  <div class="home-map-bar">
    <div class="home-map-town-group" role="tablist" aria-label="Town selection">
      <button
        type="button"
        role="tab"
        aria-selected="true"
        class="home-town-tab is-active"
        data-home-town="Newcastle"
      >
        <span>Newcastle</span>
        <span class="home-tab-badge">{previewNewcastle.length}</span>
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        class="home-town-tab"
        data-home-town="Dundrum"
      >
        <span>Dundrum</span>
        <span class="home-tab-badge">{previewDundrum.length}</span>
      </button>
    </div>

    <a class="home-full-map-link" href="/the-map/">
      Explore all 180+ businesses on full map <ArrowIcon />
    </a>
  </div>

  <!-- Interactive Leaflet Showcase Map & Side List -->
  <div class="home-map-viewport">
    <div id="home-leaflet-map" class="home-map-canvas" aria-label="Interactive map of concept websites"></div>

    <div class="home-map-sidebar">
      <div class="home-sidebar-header">
        <h3 class="home-sidebar-title" data-home-list-title>
          Newcastle Website Concepts ({previewNewcastle.length})
        </h3>
        <p class="home-sidebar-sub">Click a business to preview on map or open full comparison.</p>
      </div>

      <div class="home-sidebar-cards" data-home-cards-list>
        <!-- Populated via client script -->
      </div>
    </div>
  </div>
</div>

<script define:vars={{ conceptPins }}>
  window.addEventListener("DOMContentLoaded", () => {
    const rawPins = conceptPins;
    const L = window.L;
    const mapEl = document.getElementById("home-leaflet-map");
    if (!L || !mapEl) return;

    const TOWNS = {
      Newcastle: {
        center: [54.214, -5.898],
        zoom: 14,
      },
      Dundrum: {
        center: [54.258, -5.848],
        zoom: 15,
      },
    };

    let activeTown = "Newcastle";
    let selectedSlug = null;

    const townTabs = document.querySelectorAll("[data-home-town]");
    const cardsList = document.querySelector("[data-home-cards-list]");
    const titleEl = document.querySelector("[data-home-list-title]");

    // Setup Leaflet map instance
    const map = L.map(mapEl, {
      center: TOWNS[activeTown].center,
      zoom: TOWNS[activeTown].zoom,
      zoomControl: true,
      scrollWheelZoom: false,
    });

    L.tileLayer("https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png", {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: "abcd",
      maxZoom: 19,
    }).addTo(map);

    const markerLayer = L.layerGroup().addTo(map);
    const markersBySlug = new Map();

    const createPinIcon = (pin) => {
      const isSelected = pin.slug === selectedSlug;
      return L.divIcon({
        className: "mourne-home-pin-wrapper",
        html: `<div class="mourne-pin is-concept ${isSelected ? "is-active" : ""}" data-slug="${pin.slug}"></div>`,
        iconSize: [28, 28],
        iconAnchor: [14, 28],
      });
    };

    const updateMarkers = () => {
      markerLayer.clearLayers();
      markersBySlug.clear();

      const townPins = rawPins.filter((p) => p.town === activeTown);
      townPins.forEach((pin) => {
        const marker = L.marker([pin.lat, pin.lon], {
          icon: createPinIcon(pin),
        });

        marker.on("click", () => {
          selectPin(pin.slug, true);
        });

        marker.addTo(markerLayer);
        markersBySlug.set(pin.slug, marker);
      });
    };

    const renderCards = () => {
      if (!cardsList) return;
      const townPins = rawPins.filter((p) => p.town === activeTown);

      if (titleEl) {
        titleEl.textContent = `${activeTown} Website Concepts (${townPins.length})`;
      }

      cardsList.innerHTML = townPins
        .map((pin) => {
          const isActive = pin.slug === selectedSlug;
          return `
            <div class="home-concept-card ${isActive ? "is-active" : ""}" data-card-slug="${pin.slug}">
              <div class="home-concept-card-top">
                <span class="home-concept-card-name">${pin.name}</span>
                <span class="home-concept-card-cat">${pin.category}</span>
              </div>
              <p class="home-concept-card-sum">${pin.summary}</p>
              <div class="home-concept-card-action">
                <a href="${pin.href}" class="home-concept-view-link">
                  Open before-and-after &rarr;
                </a>
              </div>
            </div>
          `;
        })
        .join("");

      cardsList.querySelectorAll("[data-card-slug]").forEach((card) => {
        card.addEventListener("click", (e) => {
          if (e.target.closest("a")) return;
          const slug = card.getAttribute("data-card-slug");
          if (slug) selectPin(slug, true);
        });
      });
    };

    const selectPin = (slug, panMap = false) => {
      selectedSlug = slug;
      
      // Update marker active classes and z-index directly
      markersBySlug.forEach((marker, markerSlug) => {
        const isSelected = markerSlug === slug;
        const iconEl = marker.getElement()?.querySelector(".mourne-pin");
        if (iconEl) {
          iconEl.classList.toggle("is-active", isSelected);
        }
        marker.setZIndexOffset(isSelected ? 1000 : 0);
      });

      renderCards();

      const pin = rawPins.find((p) => p.slug === slug);
      if (pin && panMap && typeof pin.lat === "number" && typeof pin.lon === "number") {
        map.setView([pin.lat, pin.lon], Math.max(map.getZoom(), 15), { animate: true });
      }

      // Scroll active card into view
      if (cardsList) {
        const activeCard = cardsList.querySelector(`[data-card-slug="${slug}"]`);
        if (activeCard) {
          activeCard.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }
      }
    };

    townTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const town = tab.getAttribute("data-home-town");
        if (!town || town === activeTown) return;

        activeTown = town;
        selectedSlug = null;

        townTabs.forEach((t) => {
          const isActive = t === tab;
          t.classList.toggle("is-active", isActive);
          t.setAttribute("aria-selected", String(isActive));
        });

        map.setView(TOWNS[activeTown].center, TOWNS[activeTown].zoom, { animate: true });
        updateMarkers();
        renderCards();
      });
    });

    updateMarkers();
    renderCards();
  });
</script>
