---
import type { ShapePlate } from "../../data/five-shapes";
import {
  SHAPE_ANSWER_ORDER,
  SHAPE_PLATE_LAYOUT,
  SHAPE_QUESTIONS,
} from "../../data/five-shapes";
import FaultPanelView from "../fault-walk/FaultPanelView.astro";

interface Props {
  plate: ShapePlate;
  /** Page order 1–5. */
  n: number;
}

const { plate, n } = Astro.props;

const answers = SHAPE_ANSWER_ORDER.map((key, i) => ({
  key,
  n: i + 1,
  question: SHAPE_QUESTIONS[key],
  ...plate.answers[key],
}));

function formatAnswer(text: string): { lead: string; body: string } {
  const qMatch = text.match(/^([^?]+\?)\s*(.*)$/);
  if (qMatch) return { lead: qMatch[1], body: qMatch[2] };

  const dashIndex = text.indexOf(" — ");
  if (dashIndex > 0 && dashIndex <= 35) {
    return {
      lead: text.slice(0, dashIndex),
      body: "— " + text.slice(dashIndex + 3),
    };
  }

  const dotIndex = text.indexOf(". ");
  if (dotIndex > 0 && dotIndex <= 35) {
    return {
      lead: text.slice(0, dotIndex + 1),
      body: text.slice(dotIndex + 2),
    };
  }

  const handoffPhrases = [
    "The season's occasions",
    "Today's board and hours",
    "Live stock and market days",
    "Today's availability",
    "The queue",
  ];
  for (const phrase of handoffPhrases) {
    if (text.startsWith(phrase)) {
      return {
        lead: phrase,
        body: text.slice(phrase.length),
      };
    }
  }

  return { lead: "", body: text };
}
---

<section class="fsp" id={plate.id}>
  <header class="fsp-head">
    <p class="fsp-id" aria-hidden="true">{String(n).padStart(2, "0")}</p>
    <div class="fsp-titles">
      <h3 class="fsp-shape">{plate.ownerQuestion}</h3>
      <p class="fsp-essence">
        <span class="fsp-kind">{plate.shape}</span>
        {plate.essence}
      </p>
      {plate.buildFocus && (
        <p class="fsp-build-focus">
          <span class="fsp-focus-lead">In the build:</span> {plate.buildFocus.text} · <a href={`/how-its-made/#${plate.buildFocus.beatId}`}>see Part {plate.buildFocus.part} on How it’s made</a>
        </p>
      )}
    </div>
  </header>

  <div
    class="fsp-stage"
    style={`--fsp-frame-w:${SHAPE_PLATE_LAYOUT.frameWidthPx}px;--fsp-gap:${SHAPE_PLATE_LAYOUT.gapPx}px;`}
  >
    <div class="fsp-frame-wrap">
      <div class="fw-frame fw-frame--plate fsp-frame">
        {/* mode "after" so the theatre block takes the grammar's one colour
            beat — the eye finds it in a different place on every plate. */}
        <FaultPanelView panel={plate.screen} mode="after" interactive={false} />
        {
          answers.map((answer) => (
            <span
              class="fsp-marker"
              style={`left:${answer.marker.x}%;top:${answer.marker.y}%;`}
              data-fsp-marker={answer.n}
              data-theatre={answer.key === "theatre" ? "true" : undefined}
              aria-hidden="true"
            >
              {answer.n}
            </span>
          ))
        }
      </div>
    </div>

    {/* The same five questions, in the same order, on every plate. Beside the
        plate at desktop width; a numbered key beneath it on the phone. */}
    <dl class="fsp-notes">
      {
        answers.map((note) => {
          const { lead, body } = formatAnswer(note.answer);
          return (
            <div
              class="fsp-note"
              data-fsp-note={note.n}
              data-theatre={note.key === "theatre" ? "true" : undefined}
            >
              <dt>
                <span class="fsp-note-n" aria-hidden="true">{note.n}</span>
                <span class="fsp-note-q">{note.question}</span>
              </dt>
              <dd>
                {lead ? <strong>{lead}</strong> : null} {body}
              </dd>
            </div>
          );
        })
      }
    </dl>
  </div>

  <footer class="fsp-foot">
    <p class="fsp-drew">
      <span class="fsp-drew-lead">We drew one of these</span>
      {" "}
      {
        plate.examples.map((example, index) => (
          <>
            <a href={`/transformations/${example.slug}/`}>{example.name}</a>
            {index < plate.examples.length - 1 && <span aria-hidden="true"> · </span>}
          </>
        ))
      }
      <span class="fsp-drew-label">independent concepts</span>
    </p>
  </footer>
</section>
