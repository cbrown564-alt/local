---
/**
 * The theatre scenes for the /five-shapes/ plates — one small line drawing
 * per shape, rendered inside the plate's goal block (see `art` on FaultBlock
 * in data/five-shapes.ts). The grammar is the plates' own: one ink stroke on
 * paper, round caps, and the blue reserved for the single staged detail —
 * the lit windows, the steam, the melting pat, the sun. Care's scene is
 * white-on-blue because its theatre is the solid emergency button, stated
 * plainly with its words intact.
 *
 * The scenes are drawn, not generated — same rule as the plates themselves,
 * so no provenance entry. `slice` cropping is safe: every scene keeps its
 * subject inside the central band of the viewBox.
 */

interface Props {
  name: string;
}

const { name } = Astro.props;
---

{
  name === "dusk" && (
    <svg viewBox="0 0 160 92" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      {/* the hill behind, the moon up */}
      <path class="ta-line" d="M6 64 Q50 50 92 60 T154 56" />
      <circle class="ta-line" cx="132" cy="15" r="6.5" />
      {/* the house, paper-filled so the hill stays behind it */}
      <path class="ta-paper" d="M46 44 L80 25 L114 44 L114 76 L46 76 Z" />
      <path class="ta-line" d="M46 44 L80 25 L114 44" />
      <path class="ta-line" d="M98 33 L98 26 L104 26 L104 37" />
      <path class="ta-line" d="M52 44 L52 76 L108 76 L108 44" />
      <path class="ta-line" d="M14 76 L146 76" />
      {/* six windows; two lit — the dusk is the blue */}
      <path class="ta-line" d="M58 50 h9 v10 h-9 Z M93 50 h9 v10 h-9 Z" />
      <path class="ta-blue" d="M75.5 50 h9 v10 h-9 Z M58 63 h9 v10 h-9 Z" />
      <path class="ta-line" d="M93 63 h9 v10 h-9 Z" />
      {/* the door between them */}
      <path class="ta-line" d="M76 63 h8 v13 h-8 Z" />
    </svg>
  )
}

{
  name === "steam" && (
    <svg viewBox="0 0 160 92" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      {/* the steam, in the theatre blue — three curls off the dish */}
      <path
        class="ta-blue-line"
        d="M62 50 C56 43 68 38 62 31 C58 26 64 21 62 16 M80 52 C74 44 86 39 80 30 C75 23 84 18 80 10 M98 50 C92 43 104 38 98 31 C94 26 100 21 98 16"
      />
      {/* the bowl and its rim */}
      <path class="ta-line" d="M46 60 Q80 84 114 60" />
      <ellipse class="ta-line" cx="80" cy="60" rx="34" ry="6" />
      {/* the plate beneath */}
      <path class="ta-line" d="M34 74 Q80 86 126 74" />
    </svg>
  )
}

{
  name === "melt" && (
    <svg viewBox="0 0 160 92" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      {/* the slice: flat on the table, loaf crown up */}
      <path
        class="ta-line"
        d="M54 78 L54 44 Q54 33 64 32 Q66 23 80 23 Q94 23 96 32 Q106 33 106 44 L106 78 Z"
      />
      {/* the pat, mid-melt — the one blue thing on the table */}
      <path class="ta-blue" d="M67 27 Q72 19 81 19 Q91 19 94 26 Q91 32.5 82 33 Q71 33.5 67 27 Z" />
      {/* the drip running off it down the crumb */}
      <path class="ta-blue-line" d="M89 32 Q92 43 88 54" />
      {/* the table line */}
      <path class="ta-line" d="M30 80 L130 80" />
    </svg>
  )
}

{
  name === "road" && (
    <svg viewBox="0 0 160 92" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      {/* the hills on the horizon */}
      <path class="ta-line" d="M4 52 Q28 32 52 43 Q70 51 86 49" />
      <path class="ta-line" d="M92 49 Q122 30 156 45" />
      <path class="ta-line" d="M4 52 L156 52" />
      {/* the sun over the gap — the blue beat */}
      <circle class="ta-blue" cx="80" cy="24" r="8" />
      {/* the road, opening toward it — a gentle taper, not a funnel */}
      <path class="ta-line" d="M46 86 Q60 65 70 56 M114 86 Q100 65 90 56" />
      <path class="ta-line" d="M80 84 L80 78 M80 70 L80 65 M80 60 L80 57" />
    </svg>
  )
}

{
  name === "arrival" && (
    <svg viewBox="0 0 220 72" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <path class="ta-line" d="M8 48 Q52 28 96 44 T212 40" />
      <path class="ta-paper" d="M88 28 L110 12 L132 28 L132 58 L88 58 Z" />
      <path class="ta-line" d="M88 28 L110 12 L132 28 L132 58 L88 58 Z" />
      <path class="ta-line" d="M104 40 h12 v18 h-12 Z" />
      <path class="ta-line" d="M94 34 h8 v8 h-8 Z M118 34 h8 v8 h-8 Z" />
      <path class="ta-line" d="M16 58 L204 58" />
    </svg>
  )
}

{
  name === "fascia" && (
    <svg viewBox="0 0 424 40" preserveAspectRatio="none" aria-hidden="true">
      <path class="ta-line" d="M2 2 L422 2 L422 38 L2 38 Z" />
      <path class="ta-line" d="M16 20 L168 20" />
      <path class="ta-line" d="M184 20 L268 20" />
    </svg>
  )
}

{
  name === "ask" && (
    <svg viewBox="0 0 160 92" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path class="ta-line" d="M8 34 L152 34" />
      <path class="ta-line" d="M18 34 L18 14 L54 14 L54 34" />
      <path class="ta-line" d="M26 22 h14 v8 h-14 Z" />
      <path class="ta-line" d="M8 58 L152 58" />
      <path class="ta-line" d="M28 58 L40 46 L52 58" />
      <path class="ta-line" d="M70 58 Q80 48 90 58" />
      <circle class="ta-line" cx="120" cy="22" r="5" />
    </svg>
  )
}

{
  name === "handoff" && (
    <svg viewBox="0 0 160 40" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <path class="ta-line" d="M18 8 L110 8 L110 32 L18 32 Z" />
      <path class="ta-line" d="M26 16 L72 16 M26 24 L58 24" />
      <circle class="ta-line" cx="128" cy="20" r="8" />
      <path class="ta-line" d="M128 14 L128 20 L133 23" />
    </svg>
  )
}

{
  name === "board" && (
    <svg viewBox="0 0 160 92" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path class="ta-line" d="M22 14 L138 14 L138 72 L22 72 Z" />
      <path class="ta-line" d="M34 28 L92 28 M34 40 L78 40 M34 52 L86 52" />
      <path class="ta-line" d="M72 72 L80 84 L88 72" />
    </svg>
  )
}

{
  name === "net" && (
    <svg viewBox="0 0 36 22" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      {/* the safety net, stated as a shield: the calm mark, nothing spidery —
          reassurance is the one register an abstract glyph can betray */}
      <path class="ta-white" d="M18 3 Q23.5 5 26.5 4.8 L26.5 11 Q26.5 16.5 18 20 Q9.5 16.5 9.5 11 L9.5 4.8 Q12.5 5 18 3 Z" />
      <path class="ta-white" d="M14 10.5 L16.8 13.3 L22.5 7.8" />
    </svg>
  )
}
