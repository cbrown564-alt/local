---
/**
 * The theatre scenes for the /five-shapes/ plates — one small line drawing
 * per shape, rendered inside the plate's goal block (see `art` on FaultBlock
 * in data/five-shapes.ts). The grammar is the plates' own: one ink stroke on
 * paper, round caps, and the blue reserved for the single staged detail —
 * the lit windows, the steam, the melting pat, the sun. Care's scene is
 * white-on-blue because its theatre is the solid emergency button, stated
 * plainly with its words intact.
 *
 * The scenes are drawn, not generated — same rule as the plates themselves,
 * so no provenance entry. `slice` cropping is safe: every scene keeps its
 * subject inside the central band of the viewBox.
 */

interface Props {
  name: string;
}

const { name } = Astro.props;
---

{
  name === "dusk-wide" && (
    <svg viewBox="0 0 320 92" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <path class="ta-line" d="M8 64 Q80 48 160 60 T312 56" />
      <circle class="ta-line" cx="246" cy="15" r="6.5" />
      <path class="ta-paper" d="M126 44 L160 25 L194 44 L194 76 L126 76 Z" />
      <path class="ta-line" d="M126 44 L160 25 L194 44" />
      <path class="ta-line" d="M178 33 L178 26 L184 26 L184 37" />
      <path class="ta-line" d="M132 44 L132 76 L188 76 L188 44" />
      <path class="ta-line" d="M24 76 L296 76" />
      <path class="ta-line" d="M138 50 h9 v10 h-9 Z M173 50 h9 v10 h-9 Z" />
      <path class="ta-blue" d="M155.5 50 h9 v10 h-9 Z M138 63 h9 v10 h-9 Z" />
      <path class="ta-line" d="M173 63 h9 v10 h-9 Z" />
      <path class="ta-line" d="M156 63 h8 v13 h-8 Z" />
    </svg>
  )
}

{
  name === "dusk" && (
    <svg viewBox="0 0 160 92" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      {/* the hill behind, the moon up */}
      <path class="ta-line" d="M6 64 Q50 50 92 60 T154 56" />
      <circle class="ta-line" cx="132" cy="15" r="6.5" />
      {/* the house, paper-filled so the hill stays behind it */}
      <path class="ta-paper" d="M46 44 L80 25 L114 44 L114 76 L46 76 Z" />
      <path class="ta-line" d="M46 44 L80 25 L114 44" />
      <path class="ta-line" d="M98 33 L98 26 L104 26 L104 37" />
      <path class="ta-line" d="M52 44 L52 76 L108 76 L108 44" />
      <path class="ta-line" d="M14 76 L146 76" />
      {/* six windows; two lit — the dusk is the blue */}
      <path class="ta-line" d="M58 50 h9 v10 h-9 Z M93 50 h9 v10 h-9 Z" />
      <path class="ta-blue" d="M75.5 50 h9 v10 h-9 Z M58 63 h9 v10 h-9 Z" />
      <path class="ta-line" d="M93 63 h9 v10 h-9 Z" />
      {/* the door between them */}
      <path class="ta-line" d="M76 63 h8 v13 h-8 Z" />
    </svg>
  )
}

{
  name === "steam" && (
    <svg viewBox="0 0 160 92" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      {/* the steam, in the theatre blue — three curls off the dish */}
      <path
        class="ta-blue-line"
        d="M62 50 C56 43 68 38 62 31 C58 26 64 21 62 16 M80 52 C74 44 86 39 80 30 C75 23 84 18 80 10 M98 50 C92 43 104 38 98 31 C94 26 100 21 98 16"
      />
      {/* the bowl and its rim */}
      <path class="ta-line" d="M46 60 Q80 84 114 60" />
      <ellipse class="ta-line" cx="80" cy="60" rx="34" ry="6" />
      {/* the plate beneath */}
      <path class="ta-line" d="M34 74 Q80 86 126 74" />
    </svg>
  )
}

{
  name === "melt" && (
    <svg viewBox="0 0 160 92" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      {/* table surface */}
      <path class="ta-line" d="M14 76 L146 76" />
      {/* the preserve jar */}
      <path class="ta-paper" d="M30 42 L26 48 L26 74 Q26 76 30 76 L62 76 Q66 76 66 74 L66 48 L62 42 Z" />
      <path class="ta-line" d="M30 42 L26 48 L26 74 Q26 76 30 76 L62 76 Q66 76 66 74 L66 48 L62 42" />
      {/* paper/cloth bonnet lid tied with string */}
      <path class="ta-paper" d="M28 42 C28 32 64 32 64 42 Z" />
      <path class="ta-line" d="M28 42 C28 32 64 32 64 42" />
      <path class="ta-line" d="M23 42 H69" />
      <path class="ta-line" d="M23 42 Q25 47 28 46 Q32 43 36 46 Q40 43 44 46 Q48 43 52 46 Q56 43 60 46 Q64 43 69 42" />
      {/* jar label */}
      <path class="ta-line" d="M34 54 H58 V68 H34 Z" />
      <path class="ta-line" d="M38 60 H54 M38 64 H48" />
      {/* toast slice with classic loaf lobes */}
      <path class="ta-paper" d="M86 76 L86 52 C84 40 95 36 103 44 C111 36 122 40 120 52 L120 76 Z" />
      <path class="ta-line" d="M86 76 L86 52 C84 40 95 36 103 44 C111 36 122 40 120 52 L120 76" />
      {/* crust depth line */}
      <path class="ta-line" d="M90 76 L90 54 C89 45 96 42 103 47 C110 42 117 45 116 54 L116 76" />
      {/* melting butter pat — the blue theatre beat */}
      <path class="ta-blue" d="M97 49 L109 46 L113 52 L101 55 Z" />
      {/* warm melt drip running down the crumb */}
      <path class="ta-blue-line" d="M102 56 Q104 63 100 68" />
    </svg>
  )
}

{
  name === "road" && (
    <svg viewBox="0 0 160 92" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      {/* the hills on the horizon */}
      <path class="ta-line" d="M4 52 Q28 32 52 43 Q70 51 86 49" />
      <path class="ta-line" d="M92 49 Q122 30 156 45" />
      <path class="ta-line" d="M4 52 L156 52" />
      {/* the sun over the gap — the blue beat */}
      <circle class="ta-blue" cx="80" cy="24" r="8" />
      {/* the road, opening toward it — a gentle taper, not a funnel */}
      <path class="ta-line" d="M46 86 Q60 65 70 56 M114 86 Q100 65 90 56" />
      <path class="ta-line" d="M80 84 L80 78 M80 70 L80 65 M80 60 L80 57" />
    </svg>
  )
}

{
  name === "fascia" && (
    <svg viewBox="0 0 220 36" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <path class="ta-line ta-line--even" d="M4 5 H216 V31 H4 Z" />
      <path class="ta-line ta-line--even" d="M16 18 H108" />
      <path class="ta-line ta-line--even" d="M120 18 H168" />
    </svg>
