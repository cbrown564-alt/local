}

{
  name === "fascia-wide" && (
    <svg viewBox="0 0 424 25" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <path class="ta-line ta-line--even" d="M2 2 H422 V23 H2 Z" />
      <path class="ta-line ta-line--even" d="M14 12.5 H156" />
      <path class="ta-line ta-line--even" d="M170 12.5 H248" />
    </svg>
  )
}

{
  name === "ask" && (
    <svg viewBox="0 0 160 92" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path class="ta-line" d="M8 34 L152 34" />
      <path class="ta-line" d="M18 34 L18 14 L54 14 L54 34" />
      <path class="ta-line" d="M26 22 h14 v8 h-14 Z" />
      <path class="ta-line" d="M8 58 L152 58" />
      <path class="ta-line" d="M28 58 L40 46 L52 58" />
      <path class="ta-line" d="M70 58 Q80 48 90 58" />
      <circle class="ta-line" cx="120" cy="22" r="5" />
    </svg>
  )
}

{
  name === "handoff" && (
    <svg viewBox="0 0 160 40" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <path class="ta-line" d="M18 8 L110 8 L110 32 L18 32 Z" />
      <path class="ta-line" d="M26 16 L72 16 M26 24 L58 24" />
      <circle class="ta-line" cx="128" cy="20" r="8" />
      <path class="ta-line" d="M128 14 L128 20 L133 23" />
    </svg>
  )
}

{
  name === "board" && (
    <svg viewBox="0 0 160 92" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path class="ta-line" d="M22 14 L138 14 L138 72 L22 72 Z" />
      <path class="ta-line" d="M34 28 L92 28 M34 40 L78 40 M34 52 L86 52" />
      <path class="ta-line" d="M72 72 L80 84 L88 72" />
    </svg>
  )
}

{
  name === "net" && (
    <svg viewBox="0 0 36 22" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      {/* the safety net, stated as a shield: the calm mark, nothing spidery —
          reassurance is the one register an abstract glyph can betray */}
      <path class="ta-white" d="M18 3 Q23.5 5 26.5 4.8 L26.5 11 Q26.5 16.5 18 20 Q9.5 16.5 9.5 11 L9.5 4.8 Q12.5 5 18 3 Z" />
      <path class="ta-white" d="M14 10.5 L16.8 13.3 L22.5 7.8" />
    </svg>
  )
}

{
  name === "video-stall" && (
    <svg viewBox="0 0 160 92" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      {/* landscape hills of the bay */}
      <path class="ta-line" d="M6 68 Q54 44 96 58 T154 52" />
      <path class="ta-line" d="M12 78 Q60 62 108 72 T148 68" />
      {/* video frame and play button */}
      <rect class="ta-paper" x="65" y="31" width="30" height="30" rx="15" />
      <circle class="ta-line" cx="80" cy="46" r="14" />
      <path class="ta-line" d="M76 39 L88 46 L76 53 Z" />
      {/* video scrubber line */}
      <path class="ta-line" d="M24 82 L136 82" />
      <circle class="ta-line" cx="64" cy="82" r="3" />
    </svg>
  )
}

{
  name === "map-grid" && (
    <svg viewBox="0 0 160 92" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      {/* road grid lines */}
      <path class="ta-line" d="M12 28 Q80 20 148 32" />
      <path class="ta-line" d="M12 64 Q80 72 148 56" />
      <path class="ta-line" d="M48 14 L42 78" />
      <path class="ta-line" d="M112 14 L118 78" />
      {/* map pin marker */}
      <path class="ta-paper" d="M80 30 C72 30 66 36 66 44 C66 54 80 68 80 68 C80 68 94 54 94 44 C94 36 88 30 80 30 Z" />
      <path class="ta-line" d="M80 30 C72 30 66 36 66 44 C66 54 80 68 80 68 C80 68 94 54 94 44 C94 36 88 30 80 30 Z" />
      <circle class="ta-line" cx="80" cy="44" r="4.5" />
    </svg>
  )
}

{
  name === "steam-wide" && (
    <svg viewBox="0 0 320 92" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      {/* the steam, in the theatre blue — rising across the dish */}
      <path
        class="ta-blue-line"
        d="M142 50 C136 43 148 38 142 31 C138 26 144 21 142 16 M160 52 C154 44 166 39 160 30 C155 23 164 18 160 10 M178 50 C172 43 184 38 178 31 C174 26 180 21 178 16"
      />
      {/* the bowl and its rim */}
      <path class="ta-line" d="M126 60 Q160 84 194 60" />
      <ellipse class="ta-line" cx="160" cy="60" rx="34" ry="6" />
      {/* the plate beneath */}
      <path class="ta-line" d="M114 74 Q160 86 206 74" />
      <path class="ta-line" d="M24 76 L296 76" />
    </svg>
  )
}

{
  name === "melt-wide" && (
    <svg viewBox="0 0 320 92" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      {/* the wide table line */}
      <path class="ta-line" d="M24 76 L296 76" />
      {/* the preserve jar */}
      <path class="ta-paper" d="M106 42 L102 48 L102 74 Q102 76 106 76 L138 76 Q142 76 142 74 L142 48 L138 42 Z" />
      <path class="ta-line" d="M106 42 L102 48 L102 74 Q102 76 106 76 L138 76 Q142 76 142 74 L142 48 L138 42" />
      {/* paper/cloth bonnet lid tied with string */}
      <path class="ta-paper" d="M104 42 C104 32 140 32 140 42 Z" />
      <path class="ta-line" d="M104 42 C104 32 140 32 140 42" />
      <path class="ta-line" d="M99 42 H145" />
      <path class="ta-line" d="M99 42 Q101 47 104 46 Q108 43 112 46 Q116 43 120 46 Q124 43 128 46 Q132 43 136 46 Q140 43 145 42" />
      {/* jar label */}
      <path class="ta-line" d="M110 54 H134 V68 H110 Z" />
      <path class="ta-line" d="M114 60 H130 M114 64 H124" />
      {/* toast slice with classic loaf lobes */}
      <path class="ta-paper" d="M172 76 L172 52 C170 40 181 36 189 44 C197 36 208 40 206 52 L206 76 Z" />
      <path class="ta-line" d="M172 76 L172 52 C170 40 181 36 189 44 C197 36 208 40 206 52 L206 76" />
      {/* crust depth line */}
      <path class="ta-line" d="M176 76 L176 54 C175 45 182 42 189 47 C196 42 203 45 202 54 L202 76" />
      {/* melting butter pat — the blue theatre beat */}
      <path class="ta-blue" d="M183 49 L195 46 L199 52 L187 55 Z" />
      {/* warm melt drip running down the crumb */}
      <path class="ta-blue-line" d="M188 56 Q190 63 186 68" />
    </svg>
  )
}

{
  name === "road-wide" && (
    <svg viewBox="0 0 320 92" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      {/* the wide mountain ridge */}
      <path class="ta-line" d="M8 52 Q56 32 104 43 Q140 51 172 49 Q232 30 312 45" />
      <path class="ta-line" d="M8 52 L312 52" />
      {/* the sun over the gap — the blue beat */}
      <circle class="ta-blue" cx="160" cy="24" r="8" />
      {/* the road, opening toward it */}
      <path class="ta-line" d="M126 86 Q140 65 150 56 M194 86 Q180 65 170 56" />
      <path class="ta-line" d="M160 84 L160 78 M160 70 L160 65 M160 60 L160 57" />
    </svg>
  )
}

{
  name === "board-wide" && (
    <svg viewBox="0 0 320 92" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <path class="ta-line" d="M62 14 L258 14 L258 72 L62 72 Z" />
      <path class="ta-line" d="M74 28 L152 28 M74 40 L138 40 M74 52 L146 52" />
      <path class="ta-line" d="M168 28 L246 28 M168 40 L232 40 M168 52 L240 52" />
      <path class="ta-line" d="M152 72 L160 84 L168 72" />
    </svg>
  )
}


