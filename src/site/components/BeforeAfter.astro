---
import "../styles/comparison.css";
import ResponsiveImage from "./ResponsiveImage.astro";

interface Props {
  before: string;
  after: string;
  beforeAlt: string;
  afterAlt: string;
  showNotes?: boolean;
  compact?: boolean;
  loading?: "eager" | "lazy";
  /** Homepage hero: arrive fully "before" and sweep once to the settled split. */
  sweep?: boolean;
  /**
   * Carry a `RebuildStage` canvas over the frame. The sweep then waits for the
   * build to finish instead of running on a timer. Set by `RebuildStage.astro`
   * — pages should use that component rather than this flag.
   */
  rebuild?: boolean;
}
const {
  before,
  after,
  beforeAlt,
  afterAlt,
  showNotes = true,
  compact = false,
  loading = "eager",
  sweep = false,
  rebuild = false,
} = Astro.props;
const sizes = compact
  ? "(max-width: 720px) 100vw, (max-width: 1100px) 58vw, 650px"
  : "(max-width: 720px) 100vw, 1180px";
---

<section
  class:list={["comparison", { "comparison--compact": compact }]}
  data-comparison
  {...(sweep ? { "data-comparison-sweep": "" } : {})}
  {...(rebuild ? { "data-comparison-rebuild": "", "data-rebuild-stage": "" } : {})}
  style="--comparison-split: 50%"
>
  <div class="comparison-legend" aria-hidden="true">
    <span class="comparison-legend-item comparison-legend-before">Before</span>
    <span class="comparison-legend-instruction">Drag to compare</span>
    <span class="comparison-legend-item comparison-legend-after">After</span>
  </div>
  <div class="comparison-stage">
    <div class="comparison-frame" data-comparison-frame>
      <ResponsiveImage
        pictureClass="comparison-picture comparison-picture-before"
        class="comparison-before"
        src={before}
        alt={beforeAlt}
        width="1265"
        height="710"
        loading={loading}
        sizes={sizes}
        draggable={false}
        {...(rebuild ? { "data-rebuild-before": "" } : {})}
      />
      <div class="comparison-after" data-after>
        <ResponsiveImage
          pictureClass="comparison-picture"
          src={after}
          alt={afterAlt}
          width="1265"
          height="710"
          loading={loading}
          sizes={sizes}
          draggable={false}
          {...(rebuild ? { "data-rebuild-after": "" } : {})}
        />
      </div>
      {rebuild && (
        <canvas class="comparison-build" data-rebuild-canvas aria-hidden="true"></canvas>
      )}
      <div class="comparison-divider" data-divider aria-hidden="true">
        <div class="comparison-handle">
          <svg class="comparison-handle-grip" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d="M9 6 5 12l4 6M15 6l4 6-4 6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
      </div>
    </div>
    {showNotes && (
      <div class="note-layer" data-note-layer hidden>
        <button type="button" class="note-pin note-pin-1" data-note="1" aria-label="Design note 1">
          <span aria-hidden="true">1</span>
          <span class="note-pin-tooltip" role="tooltip"></span>
        </button>
        <button type="button" class="note-pin note-pin-2" data-note="2" aria-label="Design note 2">
          <span aria-hidden="true">2</span>
          <span class="note-pin-tooltip" role="tooltip"></span>
        </button>
        <button type="button" class="note-pin note-pin-3" data-note="3" aria-label="Design note 3">
          <span aria-hidden="true">3</span>
          <span class="note-pin-tooltip" role="tooltip"></span>
        </button>
      </div>
    )}
  </div>
  <div class="comparison-mobile-toggle" role="group" aria-label="Choose comparison view">
    <button type="button" data-comparison-view="before" aria-pressed="false">Before</button>
    <button type="button" data-comparison-view="after" aria-pressed="false">After</button>
  </div>
  <label class="comparison-control">
    <span class="comparison-control-label">Slide to compare</span>
    <span class="comparison-control-track">
      <input type="range" min="0" max="100" value="50" aria-label="Reveal more or less of the after design" />
    </span>
  </label>
  {showNotes && (
    <div class="comparison-actions">
      <button class="notes-toggle" type="button" aria-pressed="false" aria-controls="design-notes">
        <span class="notes-icon" aria-hidden="true">+</span>
        <span class="notes-toggle-label">Show design notes</span>
      </button>
    </div>
  )}
</section>

<script>
  import { track } from "@vercel/analytics";

  let comparisonInteractionTracked = false;
  const trackComparisonInteraction = (method: "slider" | "drag" | "toggle") => {
    if (comparisonInteractionTracked) return;
    comparisonInteractionTracked = true;
    track("comparison_interacted", { method });
  };

  document.querySelectorAll<HTMLElement>("[data-comparison]").forEach((comparison) => {
    const frame = comparison.querySelector<HTMLElement>("[data-comparison-frame]");
    const input = comparison.querySelector<HTMLInputElement>('input[type="range"]');
    const after = comparison.querySelector<HTMLElement>("[data-after]");
    const viewButtons = comparison.querySelectorAll<HTMLButtonElement>("[data-comparison-view]");
    const toggle = comparison.querySelector<HTMLButtonElement>(".notes-toggle");
    const toggleLabel = toggle?.querySelector<HTMLElement>(".notes-toggle-label");
    const toggleIcon = toggle?.querySelector<HTMLElement>(".notes-icon");
    const layer = comparison.querySelector<HTMLElement>("[data-note-layer]");

    const min = Number(input?.min ?? 0);
    const max = Number(input?.max ?? 100);
    const clamp = (value: number) => Math.min(max, Math.max(min, value));

    const setSplit = (raw: number) => {
      const value = clamp(raw);
      if (input) input.value = String(value);
      comparison.style.setProperty("--comparison-split", `${value}%`);
      if (after) after.style.clipPath = `inset(0 0 0 ${value}%)`;
      // The divider follows `--comparison-split` through a transform; setting
      // its `left` here would put the split back into layout.
      viewButtons.forEach((button) => {
        const isBefore = button.dataset.comparisonView === "before" && value === 100;
        const isAfter = button.dataset.comparisonView === "after" && value === 0;
        button.setAttribute("aria-pressed", String(isBefore || isAfter));
      });
    };

    const splitFromPointer = (clientX: number) => {
      if (!frame) return;
      const { left, width } = frame.getBoundingClientRect();
      setSplit(((clientX - left) / width) * 100);
    };

    input?.addEventListener("input", () => {
      trackComparisonInteraction("slider");
      setSplit(Number(input.value));
    });
    viewButtons.forEach((button) => {
      button.addEventListener("click", () => {
        trackComparisonInteraction("toggle");
        setSplit(button.dataset.comparisonView === "before" ? 100 : 0);
      });
    });
    setSplit(Number(input?.value ?? 50));

    // Homepage hero reveal: arrive fully "before", then sweep once to the
    // settled split. Any user takeover cancels the sweep instantly, and
    // reduced motion renders the settled state with no animation. The SSR
    // markup stays at the settled split so no-JS, crawlers, print and
    // capture are untouched.
    const sweep = comparison.hasAttribute("data-comparison-sweep");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (sweep && !reducedMotion && input && frame) {
      const target = clamp(Number(input.value ?? 50));
      let cancelled = false;
      const cancel = () => {
        if (cancelled) return;
        cancelled = true;
        comparison.setAttribute("data-comparison-sweep-state", "interrupted");
      };
      input.addEventListener("input", cancel, { once: true });
      frame.addEventListener("pointerdown", cancel, { once: true });
      viewButtons.forEach((button) => button.addEventListener("click", cancel, { once: true }));

      setSplit(100);
      comparison.setAttribute("data-comparison-sweep-state", "armed");
      const sweepDurationMs = 1500;
      // With a RebuildStage over the frame the sweep is the handover, not the
      // reveal: it waits for the build to land on the concept, so the two never
      // move at once. `rebuild-stage.ts` fires this event even when it cannot
      // draw, so the comparison can never be left stuck fully "before".
      const rebuilding = comparison.hasAttribute("data-comparison-rebuild");
      const sweepDelayMs = rebuilding ? 0 : 600;
      const runSweep = () => {
        if (cancelled) return;
        comparison.setAttribute("data-comparison-sweep-state", "running");
        const start = performance.now();
        const tick = (now: number) => {
          if (cancelled) return;
          const t = Math.min(1, (now - start) / sweepDurationMs);
          const eased = 1 - Math.pow(1 - t, 3);
          setSplit(100 + (target - 100) * eased);
          if (t < 1) {
            requestAnimationFrame(tick);
          } else {
            comparison.setAttribute("data-comparison-sweep-state", "settled");
          }
        };
        requestAnimationFrame(tick);
      };

      if (rebuilding) {
        // The two scripts are separate modules and either may run first, so the
        // handover is checked as state as well as awaited as an event.
        if (comparison.dataset.rebuildState === "settled") runSweep();
        else comparison.addEventListener("rebuild:settled", runSweep, { once: true });
      } else {
        window.setTimeout(runSweep, sweepDelayMs);
      }
    } else if (sweep) {
      comparison.setAttribute("data-comparison-sweep-state", "settled");
    }

    let dragging = false;

    frame?.addEventListener("pointerdown", (event) => {
      if (event.button !== 0) return;
      dragging = true;
      trackComparisonInteraction("drag");
      frame.setPointerCapture(event.pointerId);
      frame.classList.add("comparison-dragging");
      splitFromPointer(event.clientX);
    });

    frame?.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      splitFromPointer(event.clientX);
    });

    const stopDrag = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      frame?.classList.remove("comparison-dragging");
      if (frame?.hasPointerCapture(event.pointerId)) frame.releasePointerCapture(event.pointerId);
    };

    frame?.addEventListener("pointerup", stopDrag);
    frame?.addEventListener("pointercancel", stopDrag);

    const populateTooltips = () => {
      const cards = document.querySelectorAll("#design-notes .note-card");
      layer?.querySelectorAll<HTMLButtonElement>(".note-pin").forEach((pin, index) => {
        const card = cards[index];
        const tooltip = pin.querySelector<HTMLElement>(".note-pin-tooltip");
        if (!card || !tooltip) return;
        const title = card.querySelector(".notes-accordion-title, h3")?.textContent?.trim() ?? "";
        const body = card.querySelector("p:not(.note-change):not(.notes-accordion-change)")?.textContent?.trim() ?? "";
        tooltip.innerHTML = title ? `<strong>${title}</strong>${body}` : body;
        const noteNum = pin.dataset.note ?? String(index + 1);
        pin.setAttribute("aria-label", title ? `Design note ${noteNum}: ${title}` : `Design note ${noteNum}`);
      });
    };

    layer?.querySelectorAll(".note-pin").forEach((pin) => {
      pin.addEventListener("pointerdown", (event) => event.stopPropagation());
    });

    toggle?.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-pressed") === "true";
      const nextOpen = !isOpen;
      toggle.setAttribute("aria-pressed", String(nextOpen));
      if (toggleIcon) toggleIcon.textContent = nextOpen ? "−" : "+";
      if (toggleLabel) toggleLabel.textContent = nextOpen ? "Hide design notes" : "Show design notes";
      if (layer) layer.hidden = !nextOpen;
      comparison.classList.toggle("notes-visible", nextOpen);
      if (nextOpen) populateTooltips();
    });
  });
</script>
