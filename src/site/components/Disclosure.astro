---
interface Props { compact?: boolean; reminder?: boolean; quiet?: boolean }
const { compact = false, reminder = false, quiet = false } = Astro.props;
---
{reminder ? (
  <p class:list={["disclosure-reminder", { "disclosure-reminder--quiet": quiet }]} role="note">
    <span class="disclosure-reminder-mark" aria-hidden="true">C</span>
    <span><strong>Independent concept.</strong> Created from public information to demonstrate an idea. Not commissioned or approved by the business shown.</span>
  </p>
) : (
  <aside class:list={["disclosure", { "disclosure-compact": compact }]} aria-label="Concept disclosure">
    <span class="disclosure-mark" aria-hidden="true">C</span>
    <p><strong>Independent concept.</strong> Created from public information to demonstrate an idea. It is not commissioned or approved by the business shown.</p>
  </aside>
)}
