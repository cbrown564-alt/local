---
import BrandMark from "./BrandMark.astro";
import Shore from "./Shore.astro";
import { siteDetails } from "../data/site";
---

<Shore class="site-footer-shore" />
<footer class="site-footer">
  <div>
    <a class="site-brand site-brand-footer" href="/" aria-label="Mourne Made home"><BrandMark showPlace={false} variant="inverse" /></a>
    <p>Clear, fast websites for Dundrum and Newcastle.</p>
  </div>
  <div class="footer-links">
    <a href="/about/">Why local</a>
    <a href="/request/">Free before-and-after</a>
    <a href={siteDetails.emailHref}>Email {siteDetails.founderFirstName}</a>
    <a href="/privacy/">Privacy</a>
  </div>
  <p class="footer-note">Dundrum + Newcastle, County Down</p>
</footer>
