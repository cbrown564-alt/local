---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";
import { siteDetails } from "../data/site";
import { OG_IMAGE_SIZE } from "../data/og-images";
import "@fontsource-variable/antonio/wght.css";
import "@fontsource-variable/atkinson-hyperlegible-next/wght.css";
import "../styles/global.css";
import "../styles/refinements.css";
import "../styles/place-identity.css";

interface Props {
  title: string;
  description: string;
  class?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  robots?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: string;
}

const {
  title,
  description,
  class: bodyClass = "",
  hideHeader = false,
  hideFooter = false,
  robots,
  ogImage = "/media/og/studio.jpg",
  ogImageAlt,
  ogImageWidth = OG_IMAGE_SIZE.width,
  ogImageHeight = OG_IMAGE_SIZE.height,
  ogType = "website",
} = Astro.props;

const publicOrigin = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, publicOrigin).href;
const ogImageUrl = new URL(ogImage, publicOrigin).href;
const resolvedOgImageAlt = ogImageAlt ?? description;
const localBusiness = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "ProfessionalService"],
  name: siteDetails.name,
  url: new URL("/", publicOrigin).href,
  email: siteDetails.email,
  founder: {
    "@type": "Person",
    name: siteDetails.founder,
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Dundrum",
    addressRegion: "County Down",
    addressCountry: "GB",
  },
  areaServed: [
    { "@type": "Place", name: "Dundrum, County Down" },
    { "@type": "Place", name: "Newcastle, County Down" },
  ],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteDetails.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    <title>{title}</title>
    <Analytics />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    {!hideHeader && <Header />}
    <main id="main">
      <slot />
    </main>
    {!hideFooter && <Footer />}
  </body>
</html>
