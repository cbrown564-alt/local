---
import OgCaptureShell from "./OgCaptureShell.astro";
import { featuredTransformation, transformations } from "../../site/data/transformations";
---

<OgCaptureShell title="OG card — Mourne Made home">
  <article class="og-card og-card--case og-card--home" aria-label="Mourne Made homepage share card">
    <header>
      <div class="og-case-title">
        <p class="og-eyebrow">Mourne Made · {transformations.length} local examples</p>
        <h1 class="og-case-name">Local websites, made visible.</h1>
      </div>
      <p class="og-wordmark og-wordmark--compact"><span>Mourne</span><span>Made</span><i aria-hidden="true"></i></p>
    </header>
    <div class="og-comparison" aria-hidden="true">
      <figure>
        <figcaption>Before · {featuredTransformation.name}</figcaption>
        <img src={featuredTransformation.before} alt="" width="548" height="360" />
      </figure>
      <figure class="is-after">
        <figcaption>After · concept study</figcaption>
        <img src={featuredTransformation.after} alt="" width="548" height="360" />
      </figure>
    </div>
    <footer>
      <p class="og-summary">Free before-and-after concepts for Dundrum and Newcastle — see what is possible before spending a penny.</p>
      <p class="og-note">mournemade.co.uk</p>
    </footer>
  </article>
</OgCaptureShell>
