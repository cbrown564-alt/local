---
import OgCaptureShell from "./OgCaptureShell.astro";
---

<OgCaptureShell title="OG card — Request a before-and-after">
  <article class="og-card og-card--request" aria-label="Mourne Made request share card">
    <div class="og-panel-copy">
      <p class="og-wordmark"><span>Mourne</span><span>Made</span><i aria-hidden="true"></i></p>
      <p class="og-eyebrow">Free · No obligation</p>
      <h1 class="og-headline">Request a before-and-after.</h1>
      <p class="og-lede">Tell us about your business. We will make one concept so you can see what yours could do.</p>
    </div>
    <div class="og-panel-action">
      <p class="og-eyebrow" style="color: #8eb0c0;">Dundrum + Newcastle</p>
      <p class="og-lede">A clearer route to book, order or get in touch — shown as a respectful, source-backed concept study.</p>
      <p class="og-cta">mournemade.co.uk/request</p>
      <p class="og-note">Independent studio · Not commissioned by the business until they claim it</p>
    </div>
  </article>
</OgCaptureShell>
