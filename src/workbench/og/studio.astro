---
import OgCaptureShell from "./OgCaptureShell.astro";
---

<OgCaptureShell title="OG card — Mourne Made studio">
  <article class="og-card og-card--studio" aria-label="Mourne Made studio share card">
    <div class="og-panel-copy">
      <p class="og-wordmark"><span>Mourne</span><span>Made</span><i aria-hidden="true"></i></p>
      <p class="og-eyebrow">Dundrum + Newcastle, County Down</p>
      <h1 class="og-headline">Local websites, made visible.</h1>
      <p class="og-lede">Free before-and-after concepts for independent businesses — so you can see what is possible before spending a penny.</p>
    </div>
    <div class="og-panel-photo" aria-hidden="true">
      <img src="/media/place/mournes-newcastle.jpg" alt="" width="420" height="630" />
    </div>
  </article>
</OgCaptureShell>
