---
import BaseLayout from "../../site/layouts/BaseLayout.astro";
import { siteDetails } from "../../site/data/site";
import "../../site/styles/onesheet.css";
import { oneSheetUrl } from "../../site/data/onesheets.ts";

const caseStudyUrl = oneSheetUrl("scopers").display;

/* No supper-club date is printed anywhere on this sheet, deliberately. Their
   date has already moved once — 12 August was announced on 3 July and replaced
   by 26 August on 10 July — and on this business the date is the pitch. A
   printed sheet cannot be corrected, so it points at the page that always holds
   the current one instead (research/concepts/scopers/scopers-pitch.md). */
---

<BaseLayout
  title="Scopers one-sheet - Mourne Made"
  description="Internal A4 print artwork for the Scopers concept study."
  class="onesheet-doc"
  hideHeader
  hideFooter
  robots="noindex, nofollow"
>
  <article class="onesheet-page onesheet-face" aria-label="Scopers one-sheet front">
    <header class="onesheet-brand-row">
      <p class="onesheet-wordmark"><span>Mourne</span><span>Made</span><i aria-hidden="true"></i></p>
      <p>Independent concept study<br />Not commissioned by the bar</p>
    </header>

    <div class="onesheet-face-title">
      <p class="onesheet-kicker">Scopers - Dundrum</p>
      <h1>The same kitchen.<br />Findable without an account.</h1>
      <p class="onesheet-lede">Northern Ireland's first zero-waste hot food bar, on a page that opens for someone who has never heard of you.</p>
    </div>

    <div class="onesheet-comparison" aria-label="Before and after concept comparison">
      <figure>
        <figcaption>Before</figcaption>
        <img src="/media/concepts/scopers/scopers-before.jpg" alt="Scopers' current public presence: the Facebook page as it loads without an account" />
      </figure>
      <figure>
        <figcaption>Concept</figcaption>
        <img src="/media/concepts/scopers/scopers-after.jpg" alt="The proposed Scopers concept opening screen" />
      </figure>
    </div>

    <div class="onesheet-face-facts">
      <p><strong>0</strong><span>logins in the way</span></p>
      <p><strong>1</strong><span>tap to the next supper club</span></p>
      <p><strong>0</strong><span>invented dishes</span></p>
    </div>

    <section class="onesheet-face-statement">
      <p class="onesheet-kicker">The useful change</p>
      <p>Your chef. Your dishes. Out from behind the login.</p>
    </section>

    <footer class="onesheet-face-footer">
      <p>Home - Supper club</p>
      <p>Concept and source notes: <span class="onesheet-url">{caseStudyUrl}</span></p>
    </footer>
  </article>

  <article class="onesheet-page onesheet-reverse" aria-label="Scopers one-sheet reverse">
    <header class="onesheet-brand-row onesheet-brand-row-dark">
      <p class="onesheet-wordmark"><span>Mourne</span><span>Made</span><i aria-hidden="true"></i></p>
      <p>Made locally in Dundrum<br />for businesses around the Mournes</p>
    </header>

    <section class="onesheet-change-section">
      <p class="onesheet-kicker">Three practical changes</p>
      <h2>Put the chef out front.</h2>
      <ol class="onesheet-changes">
        <li>
          <span>01</span>
          <div><h3>Take the story out from behind the login</h3><p>Searching for Scopers lands on a page that greets a stranger with a cookie dialog and a login form, with Hot Food Bar by Paul Cunningham greyed out behind them.</p></div>
        </li>
        <li>
          <span>02</span>
          <div><h3>Say the remarkable thing once, plainly</h3><p>A Great British Menu chef, a zero-waste first and the Mourne Larder, told in three opening lines instead of scattered across old posts.</p></div>
        </li>
        <li>
          <span>03</span>
          <div><h3>Keep the supper club visible</h3><p>A card that always holds the next date, booking through the same Instagram inbox the kitchen already answers.</p></div>
        </li>
      </ol>
    </section>

    <section class="onesheet-stays">
      <div>
        <p class="onesheet-kicker">What stays</p>
        <h2>No rip-and-replace pitch.</h2>
      </div>
      <ul>
        <li>Your own badge and your own words</li>
        <li>The Instagram inbox you already answer</li>
        <li>Your social posts, doing what they do well</li>
      </ul>
    </section>

    <section class="onesheet-cta">
      <img src="/media/concepts/scopers/scopers-onesheet-qr.svg" alt={`QR code for ${caseStudyUrl}`} />
      <div>
        {/* The page this QR opens carries an eleven-second after clip, which its
            own aria-label calls a ten-second visit. It said "one-minute film"
            here until 6 August 2026 — a printed promise of something four times
            longer than what exists, on the first thing an owner is handed. */}
        <p class="onesheet-kicker">See the complete concept and the ten-second walk-through</p>
        <h2>Scan to walk through it.</h2>
        <p>{caseStudyUrl}</p>
      </div>
    </section>

    <p class="onesheet-media-note"><strong>The food in the concept is drawn, not photographed.</strong> Every dish shown is AI-generated illustration, labelled as such on the page, and the dish names are quoted from your own posts. Your photographs are yours; none is used.</p>

    <footer class="onesheet-reverse-footer">
      <p><strong>A small next step.</strong> The focused before-and-after is free. Paid work starts only after a fixed written quote; the first scope can be one useful page or improvement.</p>
      <p>{siteDetails.founder}<br />{siteDetails.email}</p>
    </footer>
  </article>
</BaseLayout>
