---
import BaseLayout from "../../site/layouts/BaseLayout.astro";
import { siteDetails } from "../../site/data/site";
import "../../site/styles/onesheet.css";
import { oneSheetUrl } from "../../site/data/onesheets.ts";

const caseStudyUrl = oneSheetUrl("hotel-enniskeen").display;
---

<BaseLayout
  title="Enniskeen flagship one-sheet - Mourne Made"
  description="Internal A4 print artwork for the Enniskeen flagship concept study."
  class="onesheet-doc"
  hideHeader
  hideFooter
  robots="noindex, nofollow"
>
  <article class="onesheet-page onesheet-face" aria-label="Enniskeen one-sheet front">
    <header class="onesheet-brand-row">
      <p class="onesheet-wordmark"><span>Mourne</span><span>Made</span><i aria-hidden="true"></i></p>
      <p>Independent concept study<br />Not commissioned by the hotel</p>
    </header>

    <div class="onesheet-face-title">
      <p class="onesheet-kicker">Hotel Enniskeen - Newcastle</p>
      <h1>The same country house.<br />A clearer route to checking dates.</h1>
      <p class="onesheet-lede">A complete five-page concept using the hotel's own photographs, published story and Bookin1 engine.</p>
    </div>

    <div class="onesheet-comparison" aria-label="Before and after concept comparison">
      <figure>
        <figcaption>Before</figcaption>
        <img src="/media/concepts/hotel-enniskeen/hotel-enniskeen-before.jpg" alt="Enniskeen's current public website opening screen" />
      </figure>
      <figure>
        <figcaption>Concept</figcaption>
        <img src="/media/concepts/hotel-enniskeen/hotel-enniskeen-after.jpg" alt="The proposed Enniskeen concept opening screen" />
      </figure>
    </div>

    <div class="onesheet-face-facts">
      <p><strong>5</strong><span>linked pages</span></p>
      <p><strong>1</strong><span>working booking handoff</span></p>
      <p><strong>0</strong><span>invented services</span></p>
    </div>

    <section class="onesheet-face-statement">
      <p class="onesheet-kicker">The useful change</p>
      <p>Their photographs. Their booking engine. A clearer visit.</p>
    </section>

    <footer class="onesheet-face-footer">
      <p>Home - Stay - Dine - The estate - Things to do</p>
      <p>Concept and source notes: {caseStudyUrl}</p>
    </footer>
  </article>

  <article class="onesheet-page onesheet-reverse" aria-label="Enniskeen one-sheet reverse">
    <header class="onesheet-brand-row onesheet-brand-row-dark">
      <p class="onesheet-wordmark"><span>Mourne</span><span>Made</span><i aria-hidden="true"></i></p>
      <p>Made locally in Dundrum<br />for businesses around the Mournes</p>
    </header>

    <section class="onesheet-change-section">
      <p class="onesheet-kicker">Three practical changes</p>
      <h2>Show the stay before asking for the booking.</h2>
      <ol class="onesheet-changes">
        <li>
          <span>01</span>
          <div><h3>Lead with the place</h3><p>Let the Shimna Valley, the house and the hotel's mountainside-hideaway line make the first impression.</p></div>
        </li>
        <li>
          <span>02</span>
          <div><h3>Start with dates</h3><p>Put arrival and nights on the first screen, then pass them into the Bookin1 results route the hotel already uses.</p></div>
        </li>
        <li>
          <span>03</span>
          <div><h3>Give each reason to stay a page</h3><p>Rooms, dining, the twelve-acre estate and nearby days out become real destinations, linked from every page.</p></div>
        </li>
      </ol>
    </section>

    <section class="onesheet-stays">
      <div>
        <p class="onesheet-kicker">What stays</p>
        <h2>No rip-and-replace pitch.</h2>
      </div>
      <ul>
        <li>The hotel's own photographs</li>
        <li>The existing Bookin1 engine</li>
        <li>The existing voucher shop</li>
      </ul>
    </section>

    <section class="onesheet-cta">
      <img src="/media/concepts/hotel-enniskeen/hotel-enniskeen-onesheet-qr.svg" alt={`QR code for ${caseStudyUrl}`} />
      <div>
        <p class="onesheet-kicker">See the complete concept and one-minute film</p>
        <h2>Scan to walk through it.</h2>
        <p>{caseStudyUrl}</p>
      </div>
    </section>

    <footer class="onesheet-reverse-footer">
      <p><strong>A small next step.</strong> The focused before-and-after is free. Paid work starts only after a fixed written quote; the first scope can be one useful page or improvement.</p>
      <p>{siteDetails.founder}<br />{siteDetails.email}</p>
    </footer>
  </article>
</BaseLayout>
