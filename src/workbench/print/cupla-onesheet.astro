---
import BaseLayout from "../../site/layouts/BaseLayout.astro";
import { siteDetails } from "../../site/data/site";
import "../../site/styles/onesheet.css";
import { oneSheetUrl } from "../../site/data/onesheets.ts";

const caseStudyUrl = oneSheetUrl("cupla").display;
---

<BaseLayout
  title="Cúpla one-sheet - Mourne Made"
  description="Internal A4 print artwork for the Cúpla concept study."
  class="onesheet-doc"
  hideHeader
  hideFooter
  robots="noindex, nofollow"
>
  <article class="onesheet-page onesheet-face" aria-label="Cúpla one-sheet front">
    <header class="onesheet-brand-row">
      <p class="onesheet-wordmark"><span>Mourne</span><span>Made</span><i aria-hidden="true"></i></p>
      <p>Independent concept study<br />Not commissioned by the café</p>
    </header>

    <div class="onesheet-face-title">
      <p class="onesheet-kicker">Cúpla - Dundrum</p>
      <h1>The café named for twins.<br />A page that speaks both languages.</h1>
      <p class="onesheet-lede">Brews, Bakes &amp; Bowls, with the Irish first and the English beside it, on a page that opens without a login.</p>
    </div>

    <div class="onesheet-comparison" aria-label="Before and after concept comparison">
      <figure>
        <figcaption>Before</figcaption>
        <img src="/media/concepts/cupla/cupla-before.jpg" alt="Cúpla's current public presence: the Facebook page as it loads without an account" />
      </figure>
      <figure>
        <figcaption>Concept</figcaption>
        <img src="/media/concepts/cupla/cupla-after.jpg" alt="The proposed Cúpla concept opening screen" />
      </figure>
    </div>

    <div class="onesheet-face-facts">
      <p><strong>2</strong><span>languages, side by side</span></p>
      <p><strong>0</strong><span>logins in the way</span></p>
      <p><strong>0</strong><span>invented menu items</span></p>
    </div>

    <section class="onesheet-face-statement">
      <p class="onesheet-kicker">The useful change</p>
      <p>Fáilte isteach. Come on in.</p>
    </section>

    <footer class="onesheet-face-footer">
      <p>Home - Bilingual menu</p>
      <p>Concept and source notes: <span class="onesheet-url">{caseStudyUrl}</span></p>
    </footer>
  </article>

  <article class="onesheet-page onesheet-reverse" aria-label="Cúpla one-sheet reverse">
    <header class="onesheet-brand-row onesheet-brand-row-dark">
      <p class="onesheet-wordmark"><span>Mourne</span><span>Made</span><i aria-hidden="true"></i></p>
      <p>Made locally in Dundrum<br />for businesses around the Mournes</p>
    </header>

    <section class="onesheet-change-section">
      <p class="onesheet-kicker">Three practical changes</p>
      <h2>Serve both languages.</h2>
      <ol class="onesheet-changes">
        <li>
          <span>01</span>
          <div><h3>Open the door, not a login form</h3><p>Searching for Cúpla lands on a page that greets a stranger with a cookie dialog and a login form, with your name and your Brews, Bakes &amp; Bowls line greyed out behind them.</p></div>
        </li>
        <li>
          <span>02</span>
          <div><h3>Let the name explain the café</h3><p>Twin rings in the mark for the twins who founded it, with Irish first and English beside it, so the bilingual voice is there from the first screen.</p></div>
        </li>
        <li>
          <span>03</span>
          <div><h3>Answer the passer-by's three questions</h3><p>What's on the counter, when you open and where you are — on a page that runs the counter's day in two beats and points at the Instagram you already run, so the feed keeps doing the updating.</p></div>
        </li>
      </ol>
    </section>

    <section class="onesheet-stays">
      <div>
        <p class="onesheet-kicker">What stays</p>
        <h2>No rip-and-replace pitch.</h2>
      </div>
      <ul>
        <li>Your name, and what it means</li>
        <li>The Instagram you already run</li>
        <li>Your own three-word line</li>
      </ul>
    </section>

    <section class="onesheet-cta">
      <img src="/media/concepts/cupla/cupla-onesheet-qr.svg" alt={`QR code for ${caseStudyUrl}`} />
      <div>
        <p class="onesheet-kicker">See the complete concept and bilingual menu</p>
        <h2>Scan to walk through it.</h2>
        <p>{caseStudyUrl}</p>
      </div>
    </section>

    <!-- The shopfront visualisation is derived from a third-party reference
         photograph the studio does not hold a licence to (rights position
         recorded in research/image-provenance.md, 5 August 2026). This sheet
         must not go to the café, or to any other external recipient, until
         either permission is obtained or the image is regenerated from a
         reference the studio owns. -->
    <p class="onesheet-media-note"><strong>The shopfront on the concept screen is an AI-generated visualisation</strong>, faithful to a photograph of your premises taken in August 2024 and captioned as generated wherever it appears. Nothing else is photographed: the rest is type, colour and your own published words, so nothing in it claims to show a room, a dish or a price you have not published.</p>

    <footer class="onesheet-reverse-footer">
      <p><strong>A small next step.</strong> The focused before-and-after is free. Paid work starts only after a fixed written quote; the first scope can be one useful page or improvement.</p>
      <p>{siteDetails.founder}<br />{siteDetails.email}</p>
    </footer>
  </article>
</BaseLayout>
